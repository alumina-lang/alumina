// Simplified Option type for self-hosted compiler bootstrap

struct Option<T> {
    _is_some: bool,
    _inner: T,
}

impl Option<T> {
    fn some(inner: T) -> Option<T> {
        Option::<T> {
            _is_some: true,
            _inner: inner,
        }
    }

    fn none() -> Option<T> {
        std::mem::zeroed::<Option<T>>()
    }

    fn is_some(self: &Option<T>) -> bool {
        self._is_some
    }

    fn is_none(self: &Option<T>) -> bool {
        !self._is_some
    }

    fn unwrap(self: &Option<T>) -> T {
        self._inner
    }

    fn unwrap_or(self: &Option<T>, default: T) -> T {
        if self._is_some { self._inner } else { default }
    }
}
