// Minimal libc bindings for self-hosted compiler bootstrap

type c_char = u8;
type c_void = void;
type c_int = i32;

extern "C" fn malloc(size: usize) -> &mut void;
extern "C" fn realloc(ptr: &mut void, size: usize) -> &mut void;
extern "C" fn free(ptr: &mut void);
extern "C" fn open(path: &c_char, flags: i32) -> i32;
extern "C" fn close(fd: i32) -> i32;
extern "C" fn read(fd: i32, buf: &mut c_void, count: usize) -> isize;
extern "C" fn write(fd: i32, buf: &c_void, count: usize) -> isize;
extern "C" fn lseek(fd: i32, offset: i64, whence: i32) -> i64;
extern "C" fn system(cmd: &c_char) -> i32;
extern "C" fn unlink(path: &c_char) -> i32;
extern "C" fn strtod(str: &c_char, endptr: &mut &mut c_char) -> f64;
extern "C" fn strlen(s: &c_char) -> usize;
extern "C" fn memcmp(a: &c_void, b: &c_void, n: usize) -> c_int;
extern "C" fn memcpy(dest: &mut void, src: &void, n: usize) -> &mut void;
extern "C" fn snprintf(str: &mut c_char, size: usize, fmt: &c_char, ...) -> i32;

extern "C" fn getenv(name: &c_char) -> &mut c_char;

// FILE type (opaque)
struct FILE {}
extern "C" fn fdopen(fd: i32, mode: &c_char) -> &mut FILE;
extern "C" fn fopen(filename: &c_char, mode: &c_char) -> &mut FILE;
extern "C" fn fclose(stream: &mut FILE) -> i32;
extern "C" fn fread(ptr: &mut c_void, size: usize, nmemb: usize, stream: &mut FILE) -> usize;
extern "C" fn fseek(stream: &mut FILE, offset: i64, whence: i32) -> i32;
extern "C" fn ftell(stream: &mut FILE) -> i64;
extern "C" fn fprintf(stream: &mut FILE, fmt: &c_char, ...) -> i32;
extern "C" fn fflush(stream: &mut FILE) -> i32;
