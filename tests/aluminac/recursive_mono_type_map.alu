// ALUMINAC_FLAGS: --sysroot sysroot
// A function that recursively mono's itself with different type-args
// must not pollute the outer mono's `type_map` bindings for the shared
// generic-param ids. Without the snapshot/restore around body lowering,
// the inner mono's `T` setting leaks back to the outer body lowering
// and downstream expressions resolve `T` to the wrong concrete type.
//
// This is the same shape as `Result::unwrap`, where the outer
// `unwrap<i32, i32>` body lowers a chain that transitively mono's
// `unwrap<(), fmt::Error>` (through `?` in `format_integer`).

use std::mem::size_of;

fn nest<T>(depth: i32, val: T) -> usize {
    if depth == 0i32 {
        size_of::<T>()
    } else {
        // Recursive mono with a *different* T. Without the type_map
        // snapshot/restore the recursive mono's T = i32 binding would
        // leak back into the outer body's `size_of::<T>()` below and
        // return 4 instead of the outer's T size.
        let _ = nest::<i32>(0i32, 0i32);
        size_of::<T>()
    }
}

fn main(args: &[&[u8]]) -> i32 {
    // outer T = u64 (8 bytes). After the recursive nest::<i32> call,
    // size_of::<T>() must still return 8, not 4.
    if nest::<u64>(1i32, 0u64) != 8usize { return 1i32; }
    if nest::<u8>(1i32, 0u8) != 1usize { return 2i32; }
    0i32
}
