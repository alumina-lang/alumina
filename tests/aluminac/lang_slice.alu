// Test: #[lang(slice)] method dispatch via sysroot-simple
// ALUMINAC_FLAGS: --sysroot sysroot-simple

fn main() -> i32 {
    let arr: [u8; 4] = [10u8, 20u8, 30u8, 40u8];
    let s: &[u8] = &arr;

    // Test 1: as_ptr via sysroot method
    let p = s.as_ptr();
    if *p != 10u8 { return 1; }

    // Test 2: is_empty via sysroot method
    if s.is_empty() { return 2; }

    // Test 3: empty slice is_empty
    let empty: &[u8] = &[];
    if !empty.is_empty() { return 3; }

    // Test 4: len still works (hardcoded fast path)
    if s.len() != 4usize { return 4; }

    0
}
