// ALUMINAC_FLAGS: --sysroot sysroot-aluminac
use std::typing::*;

struct Foo { x: i32 }
enum Color { Red = 0i32, Green = 1i32, Blue = 2i32 }

fn test_is_same() -> i32 {
    if !is_same::<i32, i32>() { return 1i32; }
    if is_same::<i32, i64>() { return 2i32; }
    if !is_same::<u8, u8>() { return 3i32; }
    if is_same::<u8, i8>() { return 4i32; }
    0i32
}

fn test_matches() -> i32 {
    // matches works for exact types (protocol through generic param is a known limitation)
    if !matches::<i32, i32>() { return 10i32; }
    if matches::<i32, i64>() { return 11i32; }

    // Use direct is_* functions for protocol checks
    if !is_integer::<i32>() { return 12i32; }
    if !is_floating_point::<f64>() { return 13i32; }
    if is_integer::<f64>() { return 14i32; }

    0i32
}

fn test_is_void() -> i32 {
    // Can't easily test is_void without a way to get () type in a generic context
    // but we can test the negatives
    if is_void::<i32>() { return 20i32; }
    if is_void::<bool>() { return 21i32; }
    0i32
}

fn test_is_primitive() -> i32 {
    if !is_primitive::<i32>() { return 30i32; }
    if !is_primitive::<u8>() { return 31i32; }
    if !is_primitive::<bool>() { return 32i32; }
    if !is_primitive::<f64>() { return 33i32; }
    if is_primitive::<Foo>() { return 34i32; }
    0i32
}

fn test_is_numeric() -> i32 {
    if !is_numeric::<i32>() { return 40i32; }
    if !is_numeric::<u64>() { return 41i32; }
    if !is_numeric::<f32>() { return 42i32; }
    if !is_numeric::<f64>() { return 43i32; }
    if is_numeric::<bool>() { return 44i32; }
    0i32
}

fn test_is_integer() -> i32 {
    if !is_integer::<i32>() { return 50i32; }
    if !is_integer::<u8>() { return 51i32; }
    if !is_integer::<usize>() { return 52i32; }
    if is_integer::<f64>() { return 53i32; }
    if is_integer::<bool>() { return 54i32; }
    0i32
}

fn test_is_floating_point() -> i32 {
    if !is_floating_point::<f32>() { return 60i32; }
    if !is_floating_point::<f64>() { return 61i32; }
    if is_floating_point::<i32>() { return 62i32; }
    0i32
}

fn test_is_signed_unsigned() -> i32 {
    if !is_signed::<i32>() { return 70i32; }
    if !is_signed::<i64>() { return 71i32; }
    if is_signed::<u32>() { return 72i32; }

    if !is_unsigned::<u32>() { return 73i32; }
    if !is_unsigned::<usize>() { return 74i32; }
    if is_unsigned::<i32>() { return 75i32; }

    0i32
}

fn test_is_pointer() -> i32 {
    if !is_pointer::<&i32>() { return 80i32; }
    if !is_pointer::<&mut u8>() { return 81i32; }
    if is_pointer::<i32>() { return 82i32; }
    0i32
}

fn test_is_struct_enum() -> i32 {
    if !is_struct::<Foo>() { return 90i32; }
    if is_struct::<i32>() { return 91i32; }

    if !is_enum::<Color>() { return 92i32; }
    if is_enum::<i32>() { return 93i32; }
    if is_enum::<Foo>() { return 94i32; }

    0i32
}

fn test_size_align() -> i32 {
    if size_of::<u8>() != 1usize { return 100i32; }
    if size_of::<u32>() != 4usize { return 101i32; }
    if size_of::<u64>() != 8usize { return 102i32; }

    if align_of::<u8>() != 1usize { return 103i32; }
    if align_of::<u32>() != 4usize { return 104i32; }
    if align_of::<u64>() != 8usize { return 105i32; }

    0i32
}

fn test_type_name() -> i32 {
    let name = name_of::<i32>();
    if name != "i32" { return 110i32; }

    let name2 = name_of::<bool>();
    if name2 != "bool" { return 111i32; }

    0i32
}

fn main(args: &[&[u8]]) -> i32 {
    let r = test_is_same(); if r != 0i32 { return r; }
    let r = test_matches(); if r != 0i32 { return r; }
    let r = test_is_void(); if r != 0i32 { return r; }
    let r = test_is_primitive(); if r != 0i32 { return r; }
    let r = test_is_numeric(); if r != 0i32 { return r; }
    let r = test_is_integer(); if r != 0i32 { return r; }
    let r = test_is_floating_point(); if r != 0i32 { return r; }
    let r = test_is_signed_unsigned(); if r != 0i32 { return r; }
    let r = test_is_pointer(); if r != 0i32 { return r; }
    let r = test_is_struct_enum(); if r != 0i32 { return r; }
    let r = test_size_align(); if r != 0i32 { return r; }
    let r = test_type_name(); if r != 0i32 { return r; }
    0i32
}
