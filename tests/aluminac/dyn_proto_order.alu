// ALUMINAC_FLAGS: --sysroot sysroot
// `&dyn (Foo + Bar)` and `&dyn (Bar + Foo)` on the same impl must
// produce distinct vtables keyed by protocol-tuple order, with the
// per-method dispatch index resolved against the bound's order — not
// some implicit canonicalisation.

protocol Foo<Self> { fn foo_method(self: &Self) -> i32; }
protocol Bar<Self> { fn bar_method(self: &Self) -> i32; }

struct A {}
impl A {
    fn foo_method(self: &A) -> i32 { 1i32 }
    fn bar_method(self: &A) -> i32 { 2i32 }
}

fn use_fb(x: &dyn (Foo<Self> + Bar<Self>)) -> i32 {
    x.foo_method() * 10i32 + x.bar_method()
}

fn use_bf(x: &dyn (Bar<Self> + Foo<Self>)) -> i32 {
    x.foo_method() * 10i32 + x.bar_method()
}

fn main(args: &[&[u8]]) -> i32 {
    let a = A {};
    if use_fb(&a) != 12i32 { return 1i32; }
    if use_bf(&a) != 12i32 { return 2i32; }
    0i32
}
