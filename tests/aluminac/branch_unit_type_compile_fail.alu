// ALUMINAC_FLAGS: --sysroot sysroot
// EXPECTED_ERROR: a `switch` without a default arm (`_ =>`) has type `()`
// A missing default arm is `()` (as in alumina-boot), which a value-producing
// switch cannot unify with; an `if` without `else` likewise.

enum Kind { A, B }

fn main() {
    let k = Kind::A;
    let v = switch k {
        Kind::A => 1,
        Kind::B => 2,
    };
}
