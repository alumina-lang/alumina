// ALUMINAC_FLAGS: --sysroot sysroot
// Regression: if/else arms were not coerced to a common type. An `&[]`
// (pointer to a zero-length array) in the last arm of a chain producing
// `&[T]` was reinterpreted as a slice, reading a garbage length.
fn pick(which: i32, a: &[i32], b: &[i32]) -> &[i32] {
    let result: &[i32] = if which == 0 {
        a
    } else if which == 1 {
        b
    } else {
        &[]
    };
    result
}

fn main() -> i32 {
    let a = [1, 2, 3];
    let b = [4, 5];
    if pick(0, &a, &b).len() != 3 { return 1; }
    if pick(1, &a, &b).len() != 2 { return 2; }
    if pick(2, &a, &b).len() != 0 { return 3; }

    // `&mut T` and `&T` arms unify to `&T`.
    let x = 1;
    let y = 2;
    let r = if a.len() == 3 { &x } else { &y as &i32 };
    if *r != 1 { return 4; }
    0
}
