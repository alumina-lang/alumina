// Defer expressions: execute code at function exit.
// In Alumina, defer runs when the function returns, not at block scope exit.

fn test_basic_defer() -> i32 {
    let x: i32 = 0i32;
    defer { x = 42i32; };

    // x should still be 0 here (defer hasn't run yet)
    if x != 0i32 { return 1i32; }

    0i32
}

fn main(args: &[&[u8]]) -> i32 {
    let result = test_basic_defer();
    if result != 0i32 { return result; }

    0i32
}
