// ALUMINAC_FLAGS: --sysroot sysroot

// module_path<T>() is the absolute path of the module declaring T, spelled
// as alumina-boot spells paths (a file given without `module=` is a module
// named after its stem), and void for types that are not items.

extern "intrinsic" fn module_path<T>() -> &[u8];

mod inner {
    struct Bar {}

    mod nested {
        struct Quux {}
    }

    fn function() {}
}

struct TopLevel {}

fn main(args: &[&[u8]]) -> i32 {
    if module_path::<TopLevel>() != "::module_path_real" { return 1; }
    if module_path::<inner::Bar>() != "::module_path_real::inner" { return 2; }
    if module_path::<inner::nested::Quux>() != "::module_path_real::inner::nested" { return 3; }
    if module_path::<inner::function>() != "::module_path_real::inner" { return 4; }
    if module_path::<std::string::StringBuf>() != "::std::string" { return 5; }

    // Not an item: no module path.
    when module_path::<i32>() is () {
        // ok
    } else {
        return 6;
    }
    0
}
