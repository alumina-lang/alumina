// ALUMINAC_FLAGS: --sysroot sysroot-aluminac

// Verify module_path<T>() returns the actual module path for types
// declared in nested modules, and falls through to void otherwise.

extern "intrinsic" fn module_path<T>() -> &[u8];

mod inner {
    struct Bar {}

    mod nested {
        struct Quux {}
    }
}

struct TopLevel {}

fn main(args: &[&[u8]]) -> i32 {
    // Top-level struct: no enclosing module → void.
    when module_path::<TopLevel>() is () {
        // ok
    } else {
        return 1i32;
    }

    // Struct in `inner` module: path = "inner".
    let p1 = module_path::<inner::Bar>();
    if !(p1 == "inner") { return 2i32; }

    // Struct in `inner::nested`: path = "inner::nested".
    let p2 = module_path::<inner::nested::Quux>();
    if !(p2 == "inner::nested") { return 3i32; }

    // Non-named type (i32): no scope_idx → void.
    when module_path::<i32>() is () {
        // ok
    } else {
        return 4i32;
    }

    0i32
}
