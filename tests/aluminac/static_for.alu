// ALUMINAC_FLAGS: --sysroot sysroot-aluminac
// Static for: compile-time loop unrolling via const-evaluated iterator protocol.
// The loop variable is a compile-time constant, enabling tuple indexing with .(i).

fn sum_tuple(t: (i32, i32, i32)) -> i32 {
    let result = 0i32;
    for const i in 0usize..t.len() {
        result = result + t.(i);
    }
    result
}

fn main(args: &[&[u8]]) -> i32 {
    let t = (10i32, 20i32, 30i32);
    if sum_tuple(t) != 60i32 { return 1i32; }

    // Single-element tuple
    let t2 = (99i32,);
    let s = 0i32;
    for const i in 0usize..t2.len() {
        s = s + t2.(i);
    }
    if s != 99i32 { return 2i32; }

    // Heterogeneous tuple with range-based static for
    let foo = (1, "hello", 3.4, true);
    let count = 0i32;
    for const i in 0usize..foo.len() {
        count = count + 1i32;
    }
    if count != 4i32 { return 3i32; }

    0i32
}
