// Static for: compile-time loop unrolling.
//
// NOTE: Current implementation only supports iterating over tuple elements
// directly (for const elem in tuple { ... }). The full Alumina static_for
// supports arbitrary compile-time iterators (ranges, etc.) with the loop
// variable as a compile-time constant, enabling .(i) tuple indexing and
// when-based compile-time conditionals. That is not yet implemented.

fn sum_tuple(t: (i32, i32, i32)) -> i32 {
    let result = 0i32;
    for const elem in t {
        result = result + elem;
    }
    result
}

fn main(args: &[&[u8]]) -> i32 {
    let t = (10i32, 20i32, 30i32);
    if sum_tuple(t) != 60i32 { return 1i32; }

    // Single-element tuple
    let t2 = (99i32,);
    let s = 0i32;
    for const e in t2 {
        s = s + e;
    }
    if s != 99i32 { return 2i32; }

    0i32
}
