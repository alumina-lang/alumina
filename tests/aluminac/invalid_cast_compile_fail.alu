// ALUMINAC_FLAGS: --sysroot sysroot
// EXPECTED_ERROR: cannot cast `Point` into `&Point`
// Only alumina-boot's casts are allowed (numeric, bool/enum to numeric,
// pointers and usize, ...); a value is not a pointer.

struct Point { x: i32 }

fn main() {
    let p = Point { x: 1 };
    let q = p as &Point;
}
