// ALUMINAC_FLAGS: --sysroot sysroot-aluminac

// fmt::write! against u128 / i128 values: previously these widths had no
// fmt method on their lang impls, so format_args couldn't interpolate them
// and panic messages collapsed precision via `as u64`.

use std::fmt::write;

fn fmt_u128(v: u128) -> std::string::StringBuf {
    let buf: std::string::StringBuf = std::string::StringBuf::new();
    write!(&buf, "{}", v).unwrap();
    buf
}

fn fmt_i128(v: i128) -> std::string::StringBuf {
    let buf: std::string::StringBuf = std::string::StringBuf::new();
    write!(&buf, "{}", v).unwrap();
    buf
}

fn main(args: &[&[u8]]) -> i32 {
    {
        let s = fmt_u128(0u128);
        defer s.free();
        if !(s.as_slice() == "0") { return 1i32; }
    }
    {
        let s = fmt_u128(12345u128);
        defer s.free();
        if !(s.as_slice() == "12345") { return 2i32; }
    }
    {
        // u128 max won't survive the parser yet (literal limited to u64), so
        // construct it by underflow.
        let s = fmt_u128(0u128 - 1u128);
        defer s.free();
        if !(s.as_slice() == "340282366920938463463374607431768211455") { return 3i32; }
    }

    {
        let s = fmt_i128(0i128);
        defer s.free();
        if !(s.as_slice() == "0") { return 10i32; }
    }
    {
        let s = fmt_i128(-12345i128);
        defer s.free();
        if !(s.as_slice() == "-12345") { return 11i32; }
    }
    {
        // i128::MIN via shift (parser can't take the literal directly).
        let min: i128 = 1i128 << 127i128;
        let s = fmt_i128(min);
        defer s.free();
        if !(s.as_slice() == "-170141183460469231731687303715884105728") { return 12i32; }
    }

    0i32
}
