// ALUMINAC_FLAGS: --sysroot sysroot
// Tuple comparisons (`<`, `<=`, `>`, `>=`) used to fall through aluminac's
// operator-overload eligibility check (which only accepted Struct/Slice) and
// emit `icmp ult { i32, i32 }` directly — invalid LLVM IR.
//
// Sysroot's `impl tuple<Tup: Tuple>` mixes in `Comparable<Tup>`, so the right
// dispatch is to call the lang `tuple` struct's `compare` method. Aluminac
// now routes IrTyTag::Tuple through `find_method_in_scope` via the
// `builtin_tuple` lang item and binds `Tup` to the whole tuple type when
// resolving mixin args.
//
// Note: this requires sysroot/ (sysroot-aluminac/'s minimal tuple impl
// doesn't yet include compare).

fn main(args: &[&[u8]]) -> i32 {
    let a = (1i32, 2i32);
    let b = (1i32, 3i32);
    let c = (1i32, 2i32);

    if !(a < b) { return 1i32; }
    if !(b > a) { return 2i32; }
    if !(a <= c) { return 3i32; }
    if !(a >= c) { return 4i32; }
    if a < c { return 5i32; }
    if a > c { return 6i32; }

    0i32
}
