// ALUMINAC_FLAGS: --sysroot sysroot-aluminac

// Per-element tuple operations driven by static_for + tuple-index
// auto-deref:
//   - tuple::equals walks fields and short-circuits on the first
//     mismatch via `return false` from inside the static_for body.
//   - tuple::fmt prints `(a, b, c)`, mediated through the `Formatter::?`
//     chain so any element's fmt error propagates.

fn main(args: &[&[u8]]) -> i32 {
    let a = (1i32, 2i32, 3i32);
    let b = (1i32, 2i32, 3i32);
    let c = (1i32, 9i32, 3i32);

    // equals via the lang impl (called as a method).
    if !a.equals(&b) { return 1i32; }
    if a.equals(&c) { return 2i32; }
    if !a.not_equals(&c) { return 3i32; }
    if a.not_equals(&b) { return 4i32; }

    // The unit type is also covered (length 0 → trivially equal).
    let u: () = ();
    if !u.equals(&()) { return 5i32; }

    // fmt
    let buf: std::string::StringBuf = std::string::StringBuf::new();
    defer buf.free();

    std::fmt::write!(&buf, "{}", a).unwrap();
    if buf.as_slice() != "(1, 2, 3)" { return 10i32; }

    buf.clear();
    std::fmt::write!(&buf, "{}", ()).unwrap();
    if buf.as_slice() != "()" { return 11i32; }

    buf.clear();
    std::fmt::write!(&buf, "{}", (42i32,)).unwrap();
    if buf.as_slice() != "(42)" { return 12i32; }

    0i32
}
