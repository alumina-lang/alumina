// ALUMINAC_FLAGS: --sysroot sysroot
// `Option::unwrap` against the unified sysroot. Routes through
// `panic_impl` → `const_panic_impl` → `dyn Formattable`-based
// formatting. The chain compiles only after dyn dispatch picks up
// multi-type-arg protocols, impl-struct generics in the vtable
// build, single-proto direct-Placeholder unification of
// `&dyn Proto<...>` in expected-return-type inference, expected-
// element-type propagation through array literals (`format_args!`'s
// expansion), and ZST-aware phi skipping in `gen_if` (LLVM 14's
// GlobalISel crashes on `phi {}` nodes that result from `Result<T,
// ()>` flow).

fn main(args: &[&[u8]]) -> i32 {
    let x: Option<i32> = Option::some(42i32);
    let v = x.unwrap();
    if v != 42i32 { return 1i32; }

    // none branch: takes the early-return so we don't actually panic,
    // but the compiler still mono's the panic chain.
    let y: Option<i32> = Option::none();
    if y.is_some() { return 2i32; }

    0i32
}
