// ALUMINAC_FLAGS: --sysroot sysroot
// `Option`'s common API against the unified sysroot. The whole probe
// transitively mono's the panic chain (through `unwrap`'s panic
// branch), which in turn pulls in `panic_impl` →
// `const_panic_impl` → `dyn Formattable`-based formatting. The chain
// compiles only after dyn dispatch picks up multi-type-arg
// protocols, impl-struct generics in the vtable build, single-proto
// direct-Placeholder unification of `&dyn Proto<...>` in expected-
// return-type inference, expected-element-type propagation through
// array literals (`format_args!`'s expansion), and ZST-aware phi
// skipping in `gen_if` (LLVM 14's GlobalISel crashes on `phi {}`
// nodes that result from `Result<T, ()>` flow).

fn main(args: &[&[u8]]) -> i32 {
    let x: Option<i32> = Option::some(42i32);
    let y: Option<i32> = Option::none();

    if !x.is_some() { return 1i32; }
    if x.is_none() { return 2i32; }
    if x.unwrap() != 42i32 { return 3i32; }

    if y.is_some() { return 4i32; }
    if !y.is_none() { return 5i32; }

    if x.unwrap_or(0i32) != 42i32 { return 6i32; }
    if y.unwrap_or(99i32) != 99i32 { return 7i32; }

    // == and != go through `Equatable` (mixin) which itself depends on
    // protocol-method dispatch picking up the right T.
    let x2: Option<i32> = Option::some(42i32);
    if x != x2 { return 8i32; }
    if x == y { return 9i32; }

    0i32
}
