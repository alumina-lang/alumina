// ALUMINAC_FLAGS: --sysroot sysroot
// `let (a, b): T;` declares the elements with T's element types, and a
// type annotation on `let (a, b): T = e;` applies to e (as in alumina-boot).
// aluminac dropped the former entirely and ignored the annotation.

fn main() -> i32 {
    let (a, b): (i32, u8);
    a = 5;
    b = 250;
    if a != 5 || b != 250u8 { return 1; }

    let (c, d): (u64, i8) = (1, -2);
    if c != 1u64 || d != -2i8 { return 2; }

    let (e, f) = (true, "x");
    if !e || f != "x" { return 3; }
    0
}
