// ALUMINAC_FLAGS: --sysroot sysroot
// `{}` formatting for all six range variants — sysroot-aluminac's range types
// have `fmt` impls so panic messages and println!s render them human-readably.

use std::fmt::format;

fn main(args: &[&[u8]]) -> i32 {
    // a..b — Range
    let r = format!("{}", 1..5);
    defer r.unwrap().free();
    if r.unwrap().as_slice() != "1..5" { return 1i32; }

    // a..=b — RangeInclusive
    let ri = format!("{}", 1..=5);
    defer ri.unwrap().free();
    if ri.unwrap().as_slice() != "1..=5" { return 2i32; }

    // a.. — RangeFrom
    let rf = format!("{}", 7i32..);
    defer rf.unwrap().free();
    if rf.unwrap().as_slice() != "7.." { return 3i32; }

    // ..b — RangeTo
    let rt = format!("{}", ..9i32);
    defer rt.unwrap().free();
    if rt.unwrap().as_slice() != "..9" { return 4i32; }

    // ..=b — RangeToInclusive
    let rti = format!("{}", ..=9i32);
    defer rti.unwrap().free();
    if rti.unwrap().as_slice() != "..=9" { return 5i32; }

    // .. — RangeFull. The literal lowers to RangeFull's lang-item constructor
    // and fmt formats it as "..".
    let rfull = format!("{}", ..);
    defer rfull.unwrap().free();
    if rfull.unwrap().as_slice() != ".." { return 6i32; }

    // Format inside a larger string.
    let s = format!("range = {}", 0..3);
    defer s.unwrap().free();
    if s.unwrap().as_slice() != "range = 0..3" { return 7i32; }

    0i32
}
