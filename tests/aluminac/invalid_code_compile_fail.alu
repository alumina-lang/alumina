// ALUMINAC_FLAGS: --sysroot sysroot
// Invalid code aluminac accepted (or reported confusingly), each reported
// once: unknown struct literal fields were ignored, conditions need not be
// `bool`, duplicate enum values were accepted, too many loop variables read
// garbage, a struct containing itself had no finite size, and so on.
// EXPECTED_ERROR_COUNT: 10
// EXPECTED_ERROR: could not resolve field 'b' on type 'S'
// EXPECTED_ERROR: type mismatch: expected 'bool', got 'i32'
// EXPECTED_ERROR: type mismatch: expected 'bool', got '&[u8]'
// EXPECTED_ERROR: duplicate enum value (also of `A`)
// EXPECTED_ERROR: 1 generic parameters expected, 2 found
// EXPECTED_ERROR: too many loop variables (iterator yields `(i32, i32)`)
// EXPECTED_ERROR: type with infinite size (recursive type without indirection)
// EXPECTED_ERROR: `i32` is not a pointer type
// EXPECTED_ERROR: `i32` is not a tuple type
// EXPECTED_ERROR: anonymous functions that bind environment variables cannot be coerced to a function pointer

struct S { a: i32 }
enum E { A = 1, B = 1 }
struct Rec { next: Rec, v: i32 }

fn main() {
    let _ = S { a: 1, b: 2 };
    if 1 { }
    while "x" { }
    let _ = E::B;
    let v: std::collections::Vector<i32, i32> = std::collections::Vector::new();
    v.free();
    for (a, b, c) in [(1, 2)].iter() { let _ = (a, b, c); }
    let r: Rec = std::mem::zeroed();
    let _ = r.v;
    let p: *i32 = 5;
    let t: i32.0 = 5;
    let x = 1;
    let f: fn() -> i32 = |=x| -> i32 { x };
    let _ = (p, t, f);
}
