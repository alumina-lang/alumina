// ALUMINAC_FLAGS: --sysroot sysroot-aluminac
use std::intrinsics::{atomic_load, atomic_store, atomic_rmw, atomic_cmpxchg, atomic_fence};
fn main() -> i32 {
    let x: u64 = 10u64;
    atomic_store::<u64>(&x, 42u64, 5i32);
    let v = atomic_load::<u64>(&x, 5i32);
    libc::printf("load=%llu (want 42)\n".as_ptr() as &libc::c_char, v);
    let old = atomic_rmw::<u64>(1i32, &x, 8u64, 5i32);
    libc::printf("rmw_add old=%llu (want 42) now=%llu (want 50)\n".as_ptr() as &libc::c_char,
        old, atomic_load::<u64>(&x, 5i32));
    let o2 = atomic_rmw::<u64>(0i32, &x, 99u64, 5i32);
    libc::printf("xchg old=%llu (want 50) now=%llu (want 99)\n".as_ptr() as &libc::c_char,
        o2, atomic_load::<u64>(&x, 5i32));
    let ok1 = atomic_cmpxchg::<u64>(&x, 99u64, 7u64, false, 5i32, 0i32);
    let ok2 = atomic_cmpxchg::<u64>(&x, 99u64, 1u64, false, 5i32, 0i32);
    libc::printf("cmpxchg ok1=%d ok2=%d x=%llu (want 1 0 7)\n".as_ptr() as &libc::c_char,
        ok1 as i32, ok2 as i32, atomic_load::<u64>(&x, 5i32));
    atomic_fence(5i32);
    if v == 42 && old == 42 && o2 == 50 && ok1 && !ok2 && atomic_load::<u64>(&x, 5i32) == 7 { 0 } else { 1 }
}
