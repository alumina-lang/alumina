// ALUMINAC_FLAGS: --sysroot sysroot-aluminac
// Regression: `() == ()` and `() != ()` must produce the correct constant
// (true / false respectively), even when reached through a generic context.
// Aluminac collapses empty tuples to IrTyTag::Void (see make_tuple_ty),
// and gen_binary's safety net previously short-circuited any binary
// operation on Void operands to `undef`, including equality — meaning
// `() == ()` would be undef (effectively random, usually false), breaking
// `assert_eq!(some_read_volatile_zst(), ())`.

fn check_eq<T>(lhs: T, rhs: T) -> bool { lhs == rhs }
fn check_ne<T>(lhs: T, rhs: T) -> bool { lhs != rhs }

fn main() -> i32 {
    // Direct, non-generic:
    let a: () = ();
    let b: () = ();
    if !(a == b) { return 1i32; }
    if a != b { return 2i32; }

    // Through a generic function — the call site sees T=Void, lhs/rhs as
    // values of type ():
    if !check_eq::<()>(a, b) { return 3i32; }
    if check_ne::<()>(a, b) { return 4i32; }

    // assert_eq! / assert_ne! on () (exercises the macro path):
    assert_eq!(a, b);
    assert_eq!(a, ());

    0i32
}
