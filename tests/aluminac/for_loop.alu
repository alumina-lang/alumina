// ALUMINAC_FLAGS: --sysroot sysroot-aluminac
// Test for-loop over arrays, slices, and iterators using the iterator protocol.

fn main(args: &[&[u8]]) -> i32 {
    // Test 1: for-loop over an array (goes through slice.iter())
    let a: [i32; 4] = [10i32, 20i32, 30i32, 40i32];
    let sum = 0i32;
    for item in a {
        sum = sum + item;
    }
    if sum != 100i32 { return 1i32; }

    // Test 2: for-loop over a slice
    let s: &[i32] = a[..];
    let sum2 = 0i32;
    for item in s {
        sum2 = sum2 + item;
    }
    if sum2 != 100i32 { return 2i32; }

    // Test 3: for-loop over a range
    let sum3 = 0i32;
    for i in 0i32..5i32 {
        sum3 = sum3 + i;
    }
    if sum3 != 10i32 { return 3i32; }

    // Test 4: nested for-loop
    let sum4 = 0i32;
    let b: [i32; 3] = [1i32, 2i32, 3i32];
    for x in b {
        for y in b {
            sum4 = sum4 + x * y;
        }
    }
    // (1+2+3) * (1+2+3) = 36
    if sum4 != 36i32 { return 4i32; }

    0i32
}
