// ALUMINAC_FLAGS: --sysroot sysroot

use std::string::StringBuf;

fn main() -> i32 {
    let buf = StringBuf::new();
    // No such method on StringBuf. Expected error message: contains
    // 'StringBuf' (the receiver type), not 'type \'\''.
    buf.frobnicate_xyz();
    0i32
}
