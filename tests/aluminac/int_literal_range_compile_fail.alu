// Integer literals must fit their type (as in alumina-boot); a leading `-`
// is part of the literal, so -128i8 fits while 128i8 does not.
// EXPECTED_ERROR: integer literal out of range (128 does not fit into i8)
// EXPECTED_ERROR: integer literal out of range (-129 does not fit into i8)
// EXPECTED_ERROR: integer literal out of range (-1 does not fit into u8)
// EXPECTED_ERROR: integer literal out of range (256 does not fit into u8)
fn main() {
    let a: i8 = 128;
    let b = -129i8;
    let c: u8 = -1;
    let d = 256u8;
}
