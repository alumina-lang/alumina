// ALUMINAC_FLAGS: --sysroot sysroot-aluminac

fn add(a: i32, b: i32) -> i32 { a + b }
fn sub(a: i32, b: i32) -> i32 { a - b }

fn call_fn_ptr(f: fn(i32, i32) -> i32, a: i32, b: i32) -> i32 {
    f(a, b)
}

fn main(args: &[&[u8]]) -> i32 {
    // Fn type: direct call through function item
    let f = add;
    let r1 = f(10i32, 3i32);
    if r1 != 13i32 { return 1i32; }

    // Fn coerces to fn pointer when passed to fn ptr param
    let r2 = call_fn_ptr(add, 10i32, 5i32);
    if r2 != 15i32 { return 2i32; }

    // Non-capturing lambda is also Fn
    let lam = |x: i32, y: i32| -> i32 { x * y };
    let r3 = lam(4i32, 5i32);
    if r3 != 20i32 { return 3i32; }

    // Lambda coerces to fn pointer
    let r4 = call_fn_ptr(|a: i32, b: i32| -> i32 { a + b + 1i32 }, 10i32, 5i32);
    if r4 != 16i32 { return 4i32; }

    // Explicit fn pointer binding still works
    let fp: fn(i32, i32) -> i32 = sub;
    let r5 = fp(10i32, 3i32);
    if r5 != 7i32 { return 5i32; }

    0i32
}
