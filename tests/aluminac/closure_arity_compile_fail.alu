// A closure is called with as many arguments as it has parameters (its
// environment not counted).
// BOOT_DIVERGES: alumina-boot does not check the number of arguments of a closure call
// EXPECTED_ERROR: expected 1 arguments, found 2
// EXPECTED_ERROR_COUNT: 1

fn main() {
    let k = 1;
    let add = |=k, x: i32| -> i32 { x + k };
    let _ = add(1, 2);
}
