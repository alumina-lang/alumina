// Test enum variant values with non-literal constant expressions.

enum Simple {
    A = 0i32,
    B = 1i32,
    C = 2i32,
}

// Binary operations in variant values
enum Flags {
    None   = 0i32,
    Read   = 1i32 << 0i32,   // 1
    Write  = 1i32 << 1i32,   // 2
    Exec   = 1i32 << 2i32,   // 4
    All    = 1i32 | 2i32 | 4i32,  // 7
}

// Arithmetic expressions
enum Offset {
    Base  = 100i32,
    Next  = 100i32 + 1i32,  // 101
    Third = 100i32 + 2i32,  // 102
}

// Cast expressions
enum WithCast {
    A = 0u8 as i32,
    B = 1u8 as i32,
    C = 255u8 as i32,
}

// Auto-increment after explicit value (alumina-boot style:
// non-valued variants get sequential values from 0, skipping taken values)
enum Mixed {
    X = 10i32,
    Y,          // should be 0 (first available from 0)
    Z,          // should be 1
    W = 20i32,
    V,          // should be 2
}

// Negation
enum Signed {
    Neg = 0i32 - 1i32,  // -1
    Zero = 0i32,
    Pos = 1i32,
}

fn main(args: &[&[u8]]) -> i32 {
    // Simple enum
    if Simple::A as i32 != 0i32 { return 1i32; }
    if Simple::B as i32 != 1i32 { return 2i32; }
    if Simple::C as i32 != 2i32 { return 3i32; }

    // Flags with shifts
    if Flags::None as i32 != 0i32 { return 4i32; }
    if Flags::Read as i32 != 1i32 { return 5i32; }
    if Flags::Write as i32 != 2i32 { return 6i32; }
    if Flags::Exec as i32 != 4i32 { return 7i32; }
    if Flags::All as i32 != 7i32 { return 8i32; }

    // Arithmetic
    if Offset::Base as i32 != 100i32 { return 9i32; }
    if Offset::Next as i32 != 101i32 { return 10i32; }
    if Offset::Third as i32 != 102i32 { return 11i32; }

    // Casts
    if WithCast::A as i32 != 0i32 { return 12i32; }
    if WithCast::B as i32 != 1i32 { return 13i32; }
    if WithCast::C as i32 != 255i32 { return 14i32; }

    // Mixed explicit/auto-increment (non-valued variants start from 0)
    if Mixed::X as i32 != 10i32 { return 15i32; }
    if Mixed::Y as i32 != 0i32 { return 16i32; }
    if Mixed::Z as i32 != 1i32 { return 17i32; }
    if Mixed::W as i32 != 20i32 { return 18i32; }
    if Mixed::V as i32 != 2i32 { return 19i32; }

    // Signed values
    if Signed::Zero as i32 != 0i32 { return 20i32; }
    if Signed::Pos as i32 != 1i32 { return 21i32; }

    0i32
}
