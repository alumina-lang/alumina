// ALUMINAC_FLAGS: --sysroot sysroot
// EXPECTED_ERROR: cannot apply `+` to `u32` and `u64`
// Binary operands are typechecked as in alumina-boot: arithmetic needs the
// same builtin type on both sides (only shift amounts may differ).

fn main() {
    let a: u32 = 1;
    let b: u64 = 2;
    let ok = a << b;
    let c = a + b;
}
