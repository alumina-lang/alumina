// Test closures with captures in aluminac

fn test_closures() -> i32 {
    // Test 1: Basic closure by value
    let x = 42i32;
    let f = |=x| -> i32 { x };
    if f() != 42 { return 1i32; }

    // Test 2: Closure by value with params
    let c = 3i32;
    let g = |=c, a: i32, b: i32| -> i32 { a + b + c };
    if g(10, 20) != 33 { return 2i32; }

    // Test 3: Captured by value - mutation inside doesn't affect outside
    let a = 1i32;
    let h = |=a| -> i32 {
        a = a + 10;
        a
    };
    if h() != 11 { return 3i32; }
    if a != 1 { return 4i32; }

    // Test 4: Closure by reference
    let counter = 0i32;
    let inc = |&counter| {
        counter = counter + 1;
    };
    inc();
    inc();
    inc();
    if counter != 3 { return 5i32; }

    // Test 5: Multiple captures
    let p = 10i32;
    let q = 20i32;
    let sum = |=p, =q| -> i32 { p + q };
    if sum() != 30 { return 6i32; }

    // Test 6: Lambda without captures still works
    let add = |x: i32, y: i32| -> i32 { x + y };
    if add(3, 4) != 7 { return 7i32; }

    // Test 7: Closure with mixed captures (by val + by ref + params)
    let base = 100i32;
    let accum = 0i32;
    let compute = |=base, &accum, x: i32| -> i32 {
        let result = base + x;
        accum = accum + result;
        result
    };
    if compute(5) != 105 { return 8i32; }
    if compute(10) != 110 { return 9i32; }
    if accum != 215 { return 10i32; }

    0i32
}

fn main(args: &[&[u8]]) -> i32 {
    test_closures()
}
