// Test UFCS: obj.func(args) calls free function func(obj, args)

fn double(x: i32) -> i32 {
    x * 2
}

fn add(x: &i32, y: i32) -> i32 {
    *x + y
}

fn main(args: &[&[u8]]) -> i32 {
    let x: i32 = 21;

    // UFCS: x.double() -> double(x)
    let r1 = x.double();
    if r1 != 42i32 { return 1i32; }

    // UFCS with ref: x.add(10) -> add(&x, 10)
    let r2 = x.add(10i32);
    if r2 != 31i32 { return 2i32; }

    0i32
}
