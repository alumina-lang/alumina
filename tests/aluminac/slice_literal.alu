// Struct literals of slices (`std::mem::slice<Ptr>`: `_ptr`, `_len`) and of
// qualified generic structs: fields by name, in any order.
// ALUMINAC_FLAGS: --sysroot sysroot
// EXPECTED_QUIET
use std::mem::slice;

fn main() {
    let xs = [1u8, 2, 3];
    let a = slice::<&u8> { _ptr: &xs[0], _len: 3 };
    let b = std::mem::slice::<&u8> { _len: 2, _ptr: &xs[1] };
    let v = std::collections::Vector::<i32> { _data: std::mem::slice::empty(), _length: 0 };
    assert_eq!(a.len(), 3usize);
    assert_eq!(a[2], 3u8);
    assert_eq!(b.len(), 2usize);
    assert_eq!(b[0], 2u8);
    assert_eq!(v.len(), 0usize);
}
