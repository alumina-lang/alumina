// ALUMINAC_FLAGS: --sysroot sysroot-aluminac
// EXPECTED_EXIT: 1
// Test that &&[T] is rejected when assigned to &[T]

fn main(args: &[&[u8]]) -> i32 {
    let a: [i32; 3] = [1i32, 2i32, 3i32];
    // a[..] is already &[i32], so &a[..] would be &&[i32]
    // This should be a compile error
    let s: &[i32] = &a[..];
    0i32
}
