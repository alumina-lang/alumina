// ALUMINAC_FLAGS: --sysroot sysroot-aluminac
// UFCS precedence: a method with `F: Fn(T) -> bool` bound must not eat a
// call whose argument types don't match the Fn shape — that's how
// `self.data.find(self.sep)` against `&[u8]` is expected to route to the
// free function `find(self: &[u8], needle: &[u8])` instead of the iter
// mixin's `find<F: Fn(T) -> bool>`.
//
// Minimal repro: a `find<F: Fn(i32) -> bool>` impl method on a wrapper
// struct, plus a free function `find(self: &Wrapper, needle: i32)` in the
// same module. Calling `wrapper.find(7)` must resolve to the free fn,
// because the i32 arg doesn't satisfy the `Fn` bound.

use std::option::Option;

struct Wrapper {
    _value: i32,
}

impl Wrapper {
    fn new(v: i32) -> Wrapper {
        Wrapper { _value: v }
    }

    // Method that takes a predicate. Without the dispatch-precedence fix,
    // aluminac matches `find(7i32)` to this method, binds F = i32, then
    // chokes when the synthesized body's `fun(*) ` runs against a non-
    // callable F.
    fn find<F: Fn(i32) -> bool>(self: &Wrapper, fun: F) -> Option<i32> {
        if fun(self._value) {
            Option::some(self._value)
        } else {
            Option::none()
        }
    }
}

// Free function with matching `self` parameter and a concrete arg type.
// UFCS should pick this over the Fn-bounded impl method.
fn find(self: &Wrapper, needle: i32) -> Option<i32> {
    if self._value == needle {
        Option::some(self._value)
    } else {
        Option::none()
    }
}

fn main(args: &[&[u8]]) -> i32 {
    let w = Wrapper::new(7i32);

    // Calls free fn — i32 isn't a Fn(i32) -> bool.
    let hit = w.find(7i32);
    if hit.is_none() { return 1i32; }
    if hit.unwrap() != 7i32 { return 2i32; }

    let miss = w.find(8i32);
    if miss.is_some() { return 3i32; }

    // Calls the impl method — closure satisfies the Fn bound.
    let pred = |x: i32| -> bool { x > 5i32 };
    let hit2 = w.find(pred);
    if hit2.is_none() { return 4i32; }
    if hit2.unwrap() != 7i32 { return 5i32; }

    0i32
}
