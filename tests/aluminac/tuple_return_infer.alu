// ALUMINAC_FLAGS: --sysroot sysroot
// Regression: a generic fn whose return type is a tuple of placeholders
// (e.g. `fn make_pair<T>() -> (T, T)`) needs to infer T from the expected
// tuple type when called with no args that could otherwise bind T.
//
// Pre-fix, `infer_type_args` had Generic-vs-Struct and Generic-vs-Tuple
// hint cases (for `slice<Ptr>`-style returns), but no Tuple-vs-Tuple case.
// Calling `make_pair()` in a context where the expected type is `(i32, i32)`
// (e.g. a struct field whose declared type is a tuple) would leave T
// unbound, mono with T=void, and produce a zero-sized result that reads as
// uninitialized memory when coerced to `(i32, i32)`.

fn make_pair<T>() -> (T, T) { (zeroed::<T>(), zeroed::<T>()) }

struct Holder { pair: (i32, i32) }

fn main(args: &[&[u8]]) -> i32 {
    let h = Holder { pair: make_pair() };
    if h.pair.0 != 0 { return 1; }
    if h.pair.1 != 0 { return 2; }
    0
}
