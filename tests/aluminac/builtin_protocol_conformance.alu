// ALUMINAC_FLAGS: --sysroot sysroot
// `t is UserProtocol` for builtin t (i32, u8, ...) needs to look up the
// builtin's lang-item-tagged struct (`#[lang(builtin_i32)] struct i32 {}`) to
// find its method scope. Without that, user protocols whose method-by-name
// dispatch ought to recognise builtin fmt / hash / equals slots fall through
// to "no methods" and the `is`-check returns false.

use std::cmp::Equatable;
use std::fmt::{Formattable, Formatter};

struct DummyFormatter {}
impl DummyFormatter {
    fn write_str(self: &mut DummyFormatter, _s: &[u8]) -> std::fmt::Result {
        std::fmt::Result::ok(())
    }
}

fn check_eq<T>(_v: &T) -> bool {
    when *_v is Equatable<T> { true } else { false }
}

fn check_fmt<T>(_v: &T) -> bool {
    when *_v is Formattable<T, DummyFormatter> { true } else { false }
}

fn main(args: &[&[u8]]) -> i32 {
    let i: i32 = 42i32;
    let u: u64 = 7u64;
    let b: bool = true;
    let f: f32 = 1.5f32;

    if !check_eq(&i) { return 1i32; }
    if !check_eq(&u) { return 2i32; }
    if !check_eq(&b) { return 3i32; }
    if !check_eq(&f) { return 4i32; }

    if !check_fmt(&i) { return 10i32; }
    if !check_fmt(&u) { return 11i32; }

    0i32
}
