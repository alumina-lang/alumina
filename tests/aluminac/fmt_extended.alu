// ALUMINAC_FLAGS: --sysroot sysroot
use std::fmt::*;

fn fmt_to_buf(f: &mut SliceFormatter) -> &[u8] {
    f.get()
}

fn test_format_macro() -> i32 {
    let s = format!("hello {}", 42i32).unwrap();
    defer s.free();
    if s.as_slice() != "hello 42" { return 1i32; }

    let s2 = format!("{} + {} = {}", 1i32, 2i32, 3i32).unwrap();
    defer s2.free();
    if s2.as_slice() != "1 + 2 = 3" { return 2i32; }

    0i32
}

fn test_format_in_macro() -> i32 {
    let buf: [u8; 64];
    let s = format_in!(&buf, "x={}", 99i32).unwrap();
    if s != "x=99" { return 10i32; }

    let buf2: [u8; 64];
    let s2 = format_in!(&buf2, "hello world").unwrap();
    if s2 != "hello world" { return 11i32; }

    0i32
}

fn test_float_format() -> i32 {
    let buf: [u8; 64];
    let f = SliceFormatter::new(&buf);
    internal::format_float::<f64, SliceFormatter>(3.14f64, &f, 15u16).unwrap();
    let s = f.get();
    if s != "3.14" { return 20i32; }

    let buf2: [u8; 64];
    let f2 = SliceFormatter::new(&buf2);
    internal::format_float::<f64, SliceFormatter>(0.0f64, &f2, 15u16).unwrap();
    let s2 = f2.get();
    if s2 != "0.0" { return 21i32; }

    let buf3: [u8; 64];
    let f3 = SliceFormatter::new(&buf3);
    internal::format_float::<f64, SliceFormatter>(-1.5f64, &f3, 15u16).unwrap();
    let s3 = f3.get();
    if s3 != "-1.5" { return 22i32; }

    0i32
}

fn test_float_special() -> i32 {
    let buf: [u8; 64];
    let f = SliceFormatter::new(&buf);
    let nan = 0.0f64 / 0.0f64;
    internal::format_float::<f64, SliceFormatter>(nan, &f, 15u16).unwrap();
    if f.get() != "NaN" { return 30i32; }

    let buf2: [u8; 64];
    let f2 = SliceFormatter::new(&buf2);
    let inf = 1.0f64 / 0.0f64;
    internal::format_float::<f64, SliceFormatter>(inf, &f2, 15u16).unwrap();
    if f2.get() != "inf" { return 31i32; }

    let buf3: [u8; 64];
    let f3 = SliceFormatter::new(&buf3);
    let neg_inf = -1.0f64 / 0.0f64;
    internal::format_float::<f64, SliceFormatter>(neg_inf, &f3, 15u16).unwrap();
    if f3.get() != "-inf" { return 32i32; }

    0i32
}

fn test_bool_format() -> i32 {
    // Sysroot doesn't expose a free-fn format_bool — bool's Formattable impl
    // inlines the write_str call. Use the protocol method directly.
    let buf: [u8; 64];
    let f = SliceFormatter::new(&buf);
    true.fmt::<SliceFormatter>(&f).unwrap();
    if f.get() != "true" { return 40i32; }

    let buf2: [u8; 64];
    let f2 = SliceFormatter::new(&buf2);
    false.fmt::<SliceFormatter>(&f2).unwrap();
    if f2.get() != "false" { return 41i32; }

    0i32
}

fn test_hex() -> i32 {
    let buf: [u8; 64];
    let f = SliceFormatter::new(&buf);
    let h = hex(255u64);
    h.fmt::<SliceFormatter>(&f).unwrap();
    if f.get() != "ff" { return 50i32; }

    let buf2: [u8; 64];
    let f2 = SliceFormatter::new(&buf2);
    let h2 = hex(0u64);
    h2.fmt::<SliceFormatter>(&f2).unwrap();
    if f2.get() != "0" { return 51i32; }

    let buf3: [u8; 64];
    let f3 = SliceFormatter::new(&buf3);
    let h3 = hex(16u64);
    h3.fmt::<SliceFormatter>(&f3).unwrap();
    if f3.get() != "10" { return 52i32; }

    0i32
}

fn test_oct() -> i32 {
    let buf: [u8; 64];
    let f = SliceFormatter::new(&buf);
    let o = oct(8u64);
    o.fmt::<SliceFormatter>(&f).unwrap();
    if f.get() != "10" { return 60i32; }

    0i32
}

fn test_bin() -> i32 {
    let buf: [u8; 64];
    let f = SliceFormatter::new(&buf);
    let b = bin(10u64);
    b.fmt::<SliceFormatter>(&f).unwrap();
    if f.get() != "1010" { return 70i32; }

    0i32
}

fn test_repeat() -> i32 {
    let buf: [u8; 64];
    let f = SliceFormatter::new(&buf);
    let r = repeat("ab", 3usize);
    r.fmt::<SliceFormatter>(&f).unwrap();
    if f.get() != "ababab" { return 80i32; }

    0i32
}

fn test_zero_pad() -> i32 {
    let buf: [u8; 64];
    let f = SliceFormatter::new(&buf);
    let zp = zero_pad(42i64, 5usize);
    zp.fmt::<SliceFormatter>(&f).unwrap();
    if f.get() != "00042" { return 90i32; }

    let buf2: [u8; 64];
    let f2 = SliceFormatter::new(&buf2);
    let zp2 = zero_pad(-7i64, 4usize);
    zp2.fmt::<SliceFormatter>(&f2).unwrap();
    if f2.get() != "-0007" { return 91i32; }

    let buf3: [u8; 64];
    let f3 = SliceFormatter::new(&buf3);
    let zp3 = zero_pad(12345i64, 3usize);
    zp3.fmt::<SliceFormatter>(&f3).unwrap();
    if f3.get() != "12345" { return 92i32; }

    0i32
}

fn test_null_formatter() -> i32 {
    let nf = NullFormatter {};
    let r = write!(&nf, "hello {} {}", 1i32, 2i32);
    if r.is_err() { return 100i32; }

    0i32
}

fn main(args: &[&[u8]]) -> i32 {
    let r = test_format_macro(); if r != 0i32 { return r; }
    let r = test_format_in_macro(); if r != 0i32 { return r; }
    let r = test_float_format(); if r != 0i32 { return r; }
    let r = test_float_special(); if r != 0i32 { return r; }
    let r = test_bool_format(); if r != 0i32 { return r; }
    let r = test_hex(); if r != 0i32 { return r; }
    let r = test_oct(); if r != 0i32 { return r; }
    let r = test_bin(); if r != 0i32 { return r; }
    let r = test_repeat(); if r != 0i32 { return r; }
    let r = test_zero_pad(); if r != 0i32 { return r; }
    let r = test_null_formatter(); if r != 0i32 { return r; }
    0i32
}
