// ALUMINAC_FLAGS: --sysroot sysroot
// Option<T> and Result<T, E> mix in Equatable so they satisfy
// `T: Equatable<T>`-bounded generics (matching sysroot).

use std::cmp::Equatable;

fn check<T: Equatable<T>>(a: &T, b: &T) -> bool {
    a.equals(b)
}

fn check_ne<T: Equatable<T>>(a: &T, b: &T) -> bool {
    a.not_equals(b)
}

fn main(args: &[&[u8]]) -> i32 {
    // Option<T>
    let a = Option::some(1i32);
    let b = Option::some(1i32);
    let c = Option::some(2i32);
    let n: Option<i32> = Option::none();

    if !check(&a, &b) { return 1i32; }
    if check(&a, &c) { return 2i32; }
    if check(&a, &n) { return 3i32; }
    if !check(&n, &n) { return 4i32; }
    if check_ne(&a, &b) { return 5i32; }
    if !check_ne(&a, &c) { return 6i32; }

    // Result<T, E>
    let ok1: Result<i32, i32> = Result::ok(1);
    let ok2: Result<i32, i32> = Result::ok(1);
    let ok3: Result<i32, i32> = Result::ok(2);
    let err1: Result<i32, i32> = Result::err(99);
    let err2: Result<i32, i32> = Result::err(99);
    let err3: Result<i32, i32> = Result::err(100);

    if !check(&ok1, &ok2) { return 7i32; }
    if check(&ok1, &ok3) { return 8i32; }
    if check(&ok1, &err1) { return 9i32; }
    if !check(&err1, &err2) { return 10i32; }
    if check(&err1, &err3) { return 11i32; }
    if check_ne(&ok1, &ok2) { return 12i32; }
    if !check_ne(&ok1, &err1) { return 13i32; }

    0i32
}
