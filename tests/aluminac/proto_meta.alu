// ALUMINAC_FLAGS: --sysroot sysroot
// Verify the `proto_meta` lang protocol (`std::builtins::Protocol`) —
// matches types that are themselves protocols. Aluminac wraps protocols as
// IrTyTag::Protocol after substitution, so the `is`-check just needs to look
// at that tag.
use std::builtins::Protocol;
use std::mem::uninitialized;

protocol MyProto<Self> {
    fn foo(self: &Self);
}

struct NotAProto {}

fn check_proto<T>() -> bool {
    uninitialized::<T>() is Protocol
}

fn main() -> i32 {
    if !check_proto::<MyProto<i32>>() { return 1; }
    if check_proto::<NotAProto>() { return 2; }
    if check_proto::<i32>() { return 3; }
    if check_proto::<&[u8]>() { return 4; }
    0
}
