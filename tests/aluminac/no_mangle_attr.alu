// Test: #[no_mangle] keeps the function's name as-is at the LLVM
// symbol level, like #[export] but without forcing the function to
// be reachable from the link root. Useful for FFI exports.

#[no_mangle]
fn my_special_name() -> i32 { 42 }

fn main() -> i32 {
    if my_special_name() != 42 { return 1; }
    0
}
