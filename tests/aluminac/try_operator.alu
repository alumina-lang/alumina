// Try/? operator: early return on None.

struct Option<T> {
    _is_some: bool,
    _inner: T,
}

impl Option<T> {
    fn some(v: T) -> Option<T> {
        Option::<T> { _is_some: true, _inner: v }
    }
    fn none() -> Option<T> {
        let o: Option<T>;
        o._is_some = false;
        o
    }
    fn is_some(self: &Option<T>) -> bool { self._is_some }
    fn unwrap(self: &Option<T>) -> T { self._inner }
}

fn get_val(flag: bool) -> Option<i32> {
    if flag {
        Option::some(42i32)
    } else {
        Option::none()
    }
}

fn try_it(flag: bool) -> Option<i32> {
    let v = get_val(flag)?;
    Option::some(v + 1i32)
}

fn main(args: &[&[u8]]) -> i32 {
    let r1 = try_it(true);
    if !r1.is_some() { return 1i32; }
    if r1.unwrap() != 43i32 { return 2i32; }

    let r2 = try_it(false);
    if r2.is_some() { return 3i32; }

    0i32
}
