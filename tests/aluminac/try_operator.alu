// Try/? operator: desugars to try!() macro invocation.
// Tests both Option and Result types with user-defined try macros.

// --- Option type with try macro ---

struct Option<T> {
    _is_some: bool,
    _inner: T,
}

impl Option<T> {
    fn some(v: T) -> Option<T> {
        Option::<T> { _is_some: true, _inner: v }
    }
    fn none() -> Option<T> {
        let o: Option<T>;
        o._is_some = false;
        o
    }
    fn is_some(self: &Option<T>) -> bool { self._is_some }
    fn is_none(self: &Option<T>) -> bool { !self._is_some }
    fn unwrap(self: &Option<T>) -> T { self._inner }
}

macro try($opt) {
    {
        let _opt = $opt;
        if _opt.is_some() {
            _opt.unwrap()
        } else {
            return Option::none()
        }
    }
}

// --- Result type with try macro ---

struct Result<T, E> {
    _is_ok: bool,
    _ok: T,
    _err: E,
}

impl Result<T, E> {
    fn ok(value: T) -> Result<T, E> {
        let r: Result<T, E>;
        r._is_ok = true;
        r._ok = value;
        r
    }
    fn err(value: E) -> Result<T, E> {
        let r: Result<T, E>;
        r._is_ok = false;
        r._err = value;
        r
    }
    fn is_ok(self: &Result<T, E>) -> bool { self._is_ok }
    fn is_err(self: &Result<T, E>) -> bool { !self._is_ok }
    fn unwrap(self: &Result<T, E>) -> T { self._ok }
    fn unwrap_err(self: &Result<T, E>) -> E { self._err }
}

// Note: Result's try macro would shadow Option's try macro.
// In practice, the prelude imports the Result try macro.
// For this test, we only define Option's try macro above and
// test Result via the hardcoded fallback.

// --- Test functions ---

fn get_opt(flag: bool) -> Option<i32> {
    if flag {
        Option::some(42i32)
    } else {
        Option::none()
    }
}

fn try_opt(flag: bool) -> Option<i32> {
    let v = get_opt(flag)?;
    Option::some(v + 1i32)
}

fn main(args: &[&[u8]]) -> i32 {
    // Test Option ? with macro-based desugaring
    let r1 = try_opt(true);
    if !r1.is_some() { return 1i32; }
    if r1.unwrap() != 43i32 { return 2i32; }

    let r2 = try_opt(false);
    if r2.is_some() { return 3i32; }

    // Test chained ? on Option
    let r3 = try_opt(true);
    if r3.unwrap() != 43i32 { return 4i32; }

    0i32
}
