// Regression for the Vector-swap segfault diagnosed 2026-05-12:
//
// `process_functions` (and the function loop inside `process_items_from`) used
// to take `let pending = &self.ctx.pending_functions[i]` — a borrow into the
// Vector. `build_function` then parsed the function body, and the body parse
// recursively ran Pass1 for any block-local items, which pushed *to that same*
// `pending_functions` Vector. When the Vector reallocated under that push the
// outer `pending` reference dangled, and subsequent reads of `pending.id` /
// `pending.name` / `pending.attributes` returned whatever happened to be at
// the freed address.
//
// The old `sysroot-aluminac/std/collections/vector.alu` reserved a minimum
// capacity of 4 on first allocation, which masked the bug: by the time any
// realloc would have fired, the small fixed-size pending vectors had already
// stabilised. Swapping to sysroot's vector (no min-4 floor) made the bug
// visible — every `--sysroot sysroot` test that hit a function with a nested
// fn definition (e.g. sysroot's `internal::assert` containing the nested
// `panic_assert`) segfaulted while building the lookup tables.
//
// This test reproduces the shape with a small file's worth of pending
// functions, then defines several outer fns whose bodies contain nested fn
// definitions. Building this file used to corrupt the outer fns' FnDef.id /
// .name / .attributes; the test asserts both:
//   1. The compile succeeds (no segfault during build_lookup_tables).
//   2. The outer fns run with the right behaviour (so their FnDefs survived
//      body parsing — `lang_items` lookup, attribute iteration, etc. all
//      reached the right item).

fn outer1() -> i32 {
    #[inline(never)]
    fn nested1() -> i32 {
        42i32
    }
    nested1()
}

fn outer2() -> i32 {
    fn nested2() -> i32 {
        let inner_local = 7i32;
        inner_local + 1i32
    }
    nested2()
}

#[cold]
fn outer3(x: i32) -> i32 {
    #[cold]
    fn nested3(y: i32) -> i32 {
        y * 3i32
    }
    nested3(x) + 1i32
}

fn outer4() -> i32 {
    fn nested4a() -> i32 { 100i32 }
    fn nested4b() -> i32 { 200i32 }
    nested4a() + nested4b()
}

fn main(args: &[&[u8]]) -> i32 {
    if outer1() != 42i32 { return 1i32; }
    if outer2() != 8i32 { return 2i32; }
    if outer3(5i32) != 16i32 { return 3i32; }
    if outer4() != 300i32 { return 4i32; }
    0i32
}
