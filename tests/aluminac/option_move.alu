// ALUMINAC_FLAGS: --sysroot sysroot-aluminac
// Option::move takes the inner value out, leaving None behind. Used in
// state machines and ownership transfers — matches sysroot's API.

fn main(args: &[&[u8]]) -> i32 {
    let opt = Option::some(42i32);
    let opt_ref = &opt;
    let opt_mut = opt_ref as &mut typeof(opt);
    let taken = opt_mut.move();
    if taken.unwrap() != 42i32 { return 1i32; }
    if !opt.is_none() { return 2i32; }

    // move on already-None returns None and leaves None.
    let n: Option<i32> = Option::none();
    let n_mut = (&n) as &mut typeof(n);
    let taken_n = n_mut.move();
    if !taken_n.is_none() { return 3i32; }
    if !n.is_none() { return 4i32; }

    0i32
}
