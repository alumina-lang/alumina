// Test: the `compile_fail` intrinsic emits a real compile-time error.
// (Previously a no-op — sysroot static-assert patterns silently compiled.)
//
// The runner accepts this file as a compile failure because its filename
// contains "compile_fail".

extern "intrinsic" fn compile_fail(reason: &[u8]) -> !;

fn main() -> i32 {
    compile_fail("intentional compile-time failure");
    0
}
