// ALUMINAC_FLAGS: --sysroot sysroot --debug
// In debug mode, slice indexing goes through the sysroot's bounds-checked
// `slice_index` / `slice_range_index` (as in alumina-boot). aluminac used to
// index slices directly, so out-of-bounds accesses went unchecked.
use std::panicking::catch_panic;

fn main() -> i32 {
    let a = [1, 2, 3, 4, 5].as_slice();
    if a[4] != 5 { return 1; }
    if a[1..3].len() != 2 { return 2; }

    let i = a.len();
    if catch_panic(|=a, =i| -> i32 { a[i] }).is_ok() { return 3; }
    if catch_panic(|=a| -> usize { a[4..3].len() }).is_ok() { return 4; }
    if catch_panic(|=a| -> usize { a[2..9].len() }).is_ok() { return 5; }
    0
}
