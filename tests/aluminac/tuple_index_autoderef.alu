// ALUMINAC_FLAGS: --sysroot sysroot-aluminac

// Auto-deref for tuple field access: `t.0` and `t.(i)` on a `&T` should
// reach into the pointee tuple, matching alumina-boot's behaviour and
// what `FieldAccess` already does for struct fields. Without this, the
// generic-tuple impl pattern from sysroot's std/builtins (`for const i
// in 0..lhs.len() { lhs.(i) }`) silently produces voids and the body
// effectively no-ops.

fn count_eq<T>(t: &T, target: i32) -> i32 {
    let n = 0i32;
    for const i in 0usize..t.len() {
        if t.(i) == target {
            n = n + 1i32;
        }
    }
    n
}

fn first_field<T>(t: &T) -> i32 {
    t.0
}

fn main(args: &[&[u8]]) -> i32 {
    let a = (1i32, 2i32, 3i32);
    if count_eq(&a, 2i32) != 1i32 { return 1i32; }
    if count_eq(&a, 99i32) != 0i32 { return 2i32; }

    let dups = (5i32, 5i32, 5i32, 5i32);
    if count_eq(&dups, 5i32) != 4i32 { return 3i32; }

    if first_field(&a) != 1i32 { return 4i32; }

    0i32
}
