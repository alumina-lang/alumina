// Test: typeop_arguments_of, typeop_return_type_of, typeop_function_pointer_of,
// typeop_pointer_with_mut_of, typeop_array_with_length_of, typeop_generic_args_of.
// (typeop_underlying_type_of works for enums but aluminac doesn't support
// declaring an enum's underlying type from the variant value types yet, so
// it's not exercised here — separate slice.)
// ALUMINAC_FLAGS: --sysroot sysroot
// (It used to redeclare the sysroot's lang items instead of using them.)

use std::builtins::{
    arguments_of, return_type_of, function_pointer_of, pointer_with_mut_of,
    array_with_length_of, generic_args_of, replace_generic_args_of,
};
use std::typing::type_id;

struct Pair<A, B> { a: A, b: B }
struct Empty {}

enum NonGeneric { A = 0i32, B = 1i32 }

fn add(a: i32, b: u32) -> u64 { a as u64 + b as u64 }
fn no_args() -> bool { true }

fn main() -> i32 {
    // arguments_of: tuple of parameter types
    if type_id::<arguments_of<add>>() != type_id::<(i32, u32)>() { return 1; }
    if type_id::<arguments_of<no_args>>() != type_id::<()>() { return 2; }

    // return_type_of: just the return type
    if type_id::<return_type_of<add>>() != type_id::<u64>() { return 3; }
    if type_id::<return_type_of<no_args>>() != type_id::<bool>() { return 4; }

    // FnPointer variant
    let fp: fn(i32, u32) -> u64 = add;
    if type_id::<arguments_of<typeof(fp)>>() != type_id::<(i32, u32)>() { return 5; }
    if type_id::<return_type_of<typeof(fp)>>() != type_id::<u64>() { return 6; }

    // function_pointer_of: build fn pointer from args tuple + return type
    if type_id::<function_pointer_of<(i32, u32), u64>>() != type_id::<fn(i32, u32) -> u64>() { return 7; }
    if type_id::<function_pointer_of<(bool,), i32>>() != type_id::<fn(bool) -> i32>() { return 8; }

    // pointer_with_mut_of: a pointer to T with the mutability of the second arg
    if type_id::<pointer_with_mut_of<u32, &mut u8>>() != type_id::<&mut u32>() { return 9; }
    if type_id::<pointer_with_mut_of<u32, &u8>>() != type_id::<&u32>() { return 10; }
    if type_id::<pointer_with_mut_of<void, &i32>>() != type_id::<&void>() { return 20; }

    // array_with_length_of: take element type and an array, build [Elem; len].
    if type_id::<array_with_length_of<u8, [(); 5]>>() != type_id::<[u8; 5]>() { return 11; }
    if type_id::<array_with_length_of<i64, [bool; 100]>>() != type_id::<[i64; 100]>() { return 12; }

    // generic_args_of: tuple of T's generic arguments.
    if type_id::<generic_args_of<Pair<i32, bool>>>() != type_id::<(i32, bool)>() { return 13; }
    if type_id::<generic_args_of<Empty>>() != type_id::<()>() { return 14; }

    // replace_generic_args_of: re-mono with new type args.
    if type_id::<replace_generic_args_of<Pair<i32, bool>, (u8, u16)>>() != type_id::<Pair<u8, u16>>() { return 15; }
    if type_id::<replace_generic_args_of<Pair<i32, bool>, (i32, bool)>>() != type_id::<Pair<i32, bool>>() { return 16; }

    // arguments_of / return_type_of on a closure (non-capturing lambda).
    let lam = |x: i32, y: u32| -> u64 { x as u64 + y as u64 };
    if type_id::<arguments_of<typeof(lam)>>() != type_id::<(i32, u32)>() { return 17; }
    if type_id::<return_type_of<typeof(lam)>>() != type_id::<u64>() { return 18; }

    // generic_args_of on a non-generic enum.
    if type_id::<generic_args_of<NonGeneric>>() != type_id::<()>() { return 19; }

    0
}
