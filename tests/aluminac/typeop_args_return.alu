// Test: typeop_arguments_of, typeop_return_type_of, typeop_function_pointer_of,
// typeop_pointer_with_mut_of.
// (typeop_underlying_type_of works for enums but aluminac doesn't support
// declaring an enum's underlying type from the variant value types yet, so
// it's not exercised here — separate slice.)
// ALUMINAC_FLAGS: --sysroot sysroot-aluminac

extern "intrinsic" fn type_id<T>() -> usize;

#[lang(typeop_arguments_of)]
type arguments_of<F>;

#[lang(typeop_return_type_of)]
type return_type_of<F>;

#[lang(typeop_function_pointer_of)]
type function_pointer_of<Args, Ret>;

#[lang(typeop_pointer_with_mut_of)]
type pointer_with_mut_of<P, M>;

fn add(a: i32, b: u32) -> u64 { a as u64 + b as u64 }
fn no_args() -> bool { true }

fn main() -> i32 {
    // arguments_of: tuple of parameter types
    if type_id::<arguments_of<add>>() != type_id::<(i32, u32)>() { return 1; }
    if type_id::<arguments_of<no_args>>() != type_id::<()>() { return 2; }

    // return_type_of: just the return type
    if type_id::<return_type_of<add>>() != type_id::<u64>() { return 3; }
    if type_id::<return_type_of<no_args>>() != type_id::<bool>() { return 4; }

    // FnPointer variant
    let fp: fn(i32, u32) -> u64 = add;
    if type_id::<arguments_of<typeof(fp)>>() != type_id::<(i32, u32)>() { return 5; }
    if type_id::<return_type_of<typeof(fp)>>() != type_id::<u64>() { return 6; }

    // function_pointer_of: build fn pointer from args tuple + return type
    if type_id::<function_pointer_of<(i32, u32), u64>>() != type_id::<fn(i32, u32) -> u64>() { return 7; }
    if type_id::<function_pointer_of<(bool,), i32>>() != type_id::<fn(bool) -> i32>() { return 8; }

    // pointer_with_mut_of: take a pointer, get one with the mutability of the second arg
    if type_id::<pointer_with_mut_of<&u32, &mut u8>>() != type_id::<&mut u32>() { return 9; }
    if type_id::<pointer_with_mut_of<&mut u32, &u8>>() != type_id::<&u32>() { return 10; }

    0
}
