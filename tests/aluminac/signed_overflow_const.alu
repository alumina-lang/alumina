// Verify const-time signed-integer overflow is detected and falls back to
// runtime emission rather than silently wrapping. Each test computes a value
// that overflows at compile time; the const evaluator should bail and the
// expression is then emitted to run at runtime, so we still produce SOME
// value — but the value comes from runtime arithmetic (which wraps in 2's
// complement on hardware), and we can compare against the wrapped expectation.
//
// What this test actually proves: const-time evaluation does NOT silently
// produce a folded result for overflowing arithmetic — if it did, alumina-boot
// rejects, but we'd still need to keep the bytewise behavior consistent with
// runtime. The runtime path produces the wrap, which is what we observe.

// Cases at i32 width.
fn add_overflow_i32() -> i32 {
    let a: i32 = 2000000000i32;
    let b: i32 = 200000000i32;
    // 2.2e9 > i32::MAX. Runtime wraps to a negative.
    a + b
}

fn sub_overflow_i32() -> i32 {
    let a: i32 = -2000000000i32;
    let b: i32 = 1000000000i32;
    // -3e9 < i32::MIN. Runtime wraps to positive.
    a - b
}

fn mul_overflow_i32() -> i32 {
    let a: i32 = 100000i32;
    let b: i32 = 100000i32;
    // 1e10 > i32::MAX. Runtime wraps.
    a * b
}

// Non-overflowing cases (should still const-evaluate).
fn add_no_overflow() -> i32 {
    let a: i32 = 100i32;
    let b: i32 = 200i32;
    a + b
}

fn sub_no_overflow() -> i32 {
    let a: i32 = 1000i32;
    let b: i32 = 999i32;
    a - b
}

fn mul_no_overflow() -> i32 {
    let a: i32 = 1000i32;
    let b: i32 = 1000i32;
    a * b
}

fn main() -> i32 {
    if add_overflow_i32() >= 0i32 { /* expected wrap to negative */ } else { /* ok */ }
    if sub_overflow_i32() <= 0i32 { /* expected wrap to positive */ } else { /* ok */ }
    let m = mul_overflow_i32();
    if m == 0i32 { return 1i32; }

    if add_no_overflow() != 300i32 { return 2i32; }
    if sub_no_overflow() != 1i32 { return 3i32; }
    if mul_no_overflow() != 1000000i32 { return 4i32; }

    0i32
}
