// ALUMINAC_FLAGS: --sysroot sysroot
// Each mistake is reported once: what fails to lower is an error value
// (of type `!`) that its uses do not report again. (Unresolved methods and
// fields, invalid operators, dereferences and indexing, and incompatible
// branches gave `()`, so every use of the value was another error, and
// `println!` of it a dozen; an unsatisfied bound of a protocol's own
// parameter was reported three times.)
// EXPECTED_ERROR_COUNT: 10
// EXPECTED_ERROR: could not resolve method 'nrom' on type 'Point'
// EXPECTED_ERROR: could not resolve field 'z' on type 'Point'
// EXPECTED_ERROR: could not resolve method 'frob' on type 'i32'
// EXPECTED_ERROR: branches have incompatible types
// EXPECTED_ERROR: cannot apply `+` to `bool` and `i32`
// EXPECTED_ERROR: cannot dereference non-pointer type
// EXPECTED_ERROR: cannot index into a value of type `i32`
// EXPECTED_ERROR: `i32` is not callable
// EXPECTED_ERROR: type `Opaque` does not match `Equatable<Opaque>`

use std::cmp::Comparable;

struct Point { x: i32, y: i32 }
struct Opaque { v: i32 }

fn frobbed<T>(t: T) -> T { t.frob() }
fn biggest<T: Comparable<T>>(a: T, b: T) -> T { if a > b { a } else { b } }

fn main() {
    let p = Point { x: 1, y: 2 };
    let c = p.nrom();
    let d = c * 2 + p.x;
    let i = p.z;
    let j = frobbed(5);
    let m = if d > 0 { 1 } else { "two" };
    let n = true + 1;
    let o = *p.x;
    let q = p.x[0];
    let r = p.x(3);
    let s = biggest(Opaque { v: 1 }, Opaque { v: 2 });
    let g: i32 = "string";
    println!("{} {} {} {} {} {} {} {} {} {}", c, d, i, j, m, n, o, q, r, s.v);
}
