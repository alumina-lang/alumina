// ALUMINAC_FLAGS: --sysroot sysroot-aluminac
use std::time::Instant;
use std::time::Duration;

fn test_duration_basic() -> i32 {
    let d = Duration::from_secs(5i64);
    if d.secs() != 5i64 { return 1i32; }
    if d.nanos() != 0u32 { return 2i32; }

    let d2 = Duration::from_millis(2500i64);
    if d2.secs() != 2i64 { return 3i32; }
    if d2.total_millis() != 2500i64 { return 4i32; }

    let d3 = Duration::from_micros(1500000i64);
    if d3.secs() != 1i64 { return 5i32; }
    if d3.total_micros() != 1500000i64 { return 6i32; }

    let d4 = Duration::from_nanos(1234567890i64);
    if d4.secs() != 1i64 { return 7i32; }
    0i32
}

fn test_duration_new() -> i32 {
    let d = Duration::new(3i64, 500000000u32);
    if d.secs() != 3i64 { return 10i32; }
    if d.nanos() != 500000000u32 { return 11i32; }
    // total_secs should be ~3.5
    let ts = d.total_secs();
    if ts < 3.4 { return 12i32; }
    if ts > 3.6 { return 13i32; }
    0i32
}

fn test_instant_now() -> i32 {
    let start = Instant::now();

    // Do some work
    let sum = 0i64;
    let i = 0i64;
    while i < 1000000i64 {
        sum = sum + i;
        i = i + 1i64;
    }

    let elapsed = start.since();
    // Should have taken some time (but not too long)
    if elapsed.secs() < 0i64 { return 20i32; }
    // Total should be non-negative
    if elapsed.total_micros() < 0i64 { return 21i32; }
    0i32
}

fn test_instant_elapsed() -> i32 {
    let t1 = Instant::now();
    let t2 = Instant::now();

    let d = t2.elapsed(&t1);
    // t2 >= t1, so duration should be non-negative
    if d.secs() < 0i64 { return 30i32; }
    0i32
}

fn test_duration_fmt() -> i32 {
    let d = Duration::from_millis(1500i64);
    let buf: [u8; 32];
    let f = std::fmt::SliceFormatter::new(&buf);
    d.fmt(&f);
    // Should format as "1.500s"
    if f.get() != "1.500s" { return 40i32; }

    let d2 = Duration::from_millis(42i64);
    let buf2: [u8; 32];
    let f2 = std::fmt::SliceFormatter::new(&buf2);
    d2.fmt(&f2);
    // Should format as "42ms"
    if f2.get() != "42ms" { return 41i32; }
    0i32
}

fn main(args: &[&[u8]]) -> i32 {
    let r = test_duration_basic();
    if r != 0i32 { return r; }

    let r = test_duration_new();
    if r != 0i32 { return r; }

    let r = test_instant_now();
    if r != 0i32 { return r; }

    let r = test_instant_elapsed();
    if r != 0i32 { return r; }

    let r = test_duration_fmt();
    if r != 0i32 { return r; }

    0i32
}
