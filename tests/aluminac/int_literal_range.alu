// Integer literals at the edges of their types' ranges.
fn main() -> i32 {
    let a: i8 = -128;
    let b = -128i8;
    let c: u8 = 255;
    let d = 0xffffffffffffffffffffffffffffffffu128;
    let e = -170141183460469231731687303715884105728i128;
    if a != b || c != 255u8 || d == 0 || e >= 0 { return 1; }
    0
}
