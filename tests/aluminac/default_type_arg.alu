// ALUMINAC_FLAGS: --sysroot sysroot-aluminac
// Generic params with default-type-arg should fall back to the default when
// caller doesn't supply / inference can't bind.

struct A {}
struct B {}
struct Marker<T = A> {}

fn id_marker<T = A>(_x: i32) -> i32 {
    when *(std::mem::zeroed::<T>() as &T) is A { 1i32 } else { 2i32 }
}

fn id_marker_b(_x: i32) -> i32 {
    id_marker::<B>(_x)
}

fn main(args: &[&[u8]]) -> i32 {
    if id_marker(0i32) != 1i32 { return 1i32; }
    if id_marker_b(0i32) != 2i32 { return 2i32; }
    0i32
}
