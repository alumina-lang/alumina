// ALUMINAC_FLAGS: --sysroot sysroot
// An `impl` block may come before the type it is for (aluminac gave it a
// scope of its own, so the methods were not found).
impl Foo {
    fn get(self: &Foo) -> i32 { self.a }
}

struct Foo { a: i32 }

fn main() -> i32 {
    let f = Foo { a: 3 };
    f.get() - 3
}
