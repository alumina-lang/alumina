// ALUMINAC_FLAGS: --sysroot sysroot-aluminac

fn test_for_range() -> i32 {
    // Basic for..in range (uses compiler fast path)
    let sum = 0i32;
    for i in 0i32..5i32 {
        sum = sum + i;
    }
    if sum != 10i32 { return 1i32; }

    // for..in inclusive range
    let sum2 = 0i32;
    for i in 1i32..=5i32 {
        sum2 = sum2 + i;
    }
    if sum2 != 15i32 { return 2i32; }

    // for..in with usize
    let sum3 = 0usize;
    for i in 0usize..10usize {
        sum3 = sum3 + i;
    }
    if sum3 != 45usize { return 3i32; }

    0i32
}

fn test_for_slice() -> i32 {
    let items: [i32; 4] = [10i32, 20i32, 30i32, 40i32];
    let sum = 0i32;
    for item in items[..] {
        sum = sum + item;
    }
    if sum != 100i32 { return 10i32; }
    0i32
}

fn test_for_array() -> i32 {
    let items: [i32; 3] = [1i32, 2i32, 3i32];
    let sum = 0i32;
    for item in items {
        sum = sum + item;
    }
    if sum != 6i32 { return 20i32; }
    0i32
}

fn test_for_iterator() -> i32 {
    // For loop over a struct with .iter()/.next()
    use std::collections::Vector;
    let v: Vector<i32> = Vector::new();
    defer v.free();
    v.push(10i32);
    v.push(20i32);
    v.push(30i32);

    let sum = 0i32;
    for item in v {
        sum = sum + item;
    }
    if sum != 60i32 { return 30i32; }
    0i32
}

fn test_mem_uninitialized() -> i32 {
    // `mem::uninitialized` is undefined behaviour — its value is unspecified
    // and a prior version of this test relied on a lucky 0. We only verify
    // that the call compiles and returns; the value is then overwritten.
    let x: i32 = std::mem::uninitialized::<i32>();
    x = 0i32;
    if x != 0i32 { return 40i32; }
    0i32
}

fn test_mem_alloc_zeroed() -> i32 {
    let buf = std::mem::slice_alloc_zeroed::<i32>(10usize);
    defer std::mem::slice_free::<i32>(buf);

    let i = 0usize;
    while i < 10usize {
        if buf[i] != 0i32 { return 50i32; }
        i = i + 1usize;
    }
    0i32
}

fn test_mem_copy() -> i32 {
    // Test overlapping copy (memmove)
    let buf: [i32; 5] = [1i32, 2i32, 3i32, 4i32, 5i32];
    // Copy [1,2,3] over [2,3,4] (overlapping forward)
    std::mem::copy::<i32>(&buf[0], &buf[1], 3usize);
    if buf[0] != 1i32 { return 60i32; }
    if buf[1] != 1i32 { return 61i32; }
    if buf[2] != 2i32 { return 62i32; }
    if buf[3] != 3i32 { return 63i32; }
    if buf[4] != 5i32 { return 64i32; }
    0i32
}

fn test_cstring_enhanced() -> i32 {
    // Test CString.null()
    let s = std::ffi::CString::null();
    if s.ptr as usize != 0usize { return 70i32; }

    // Test CString clone
    let s1 = std::ffi::CString::from_slice("hello");
    defer s1.free();
    let s2 = s1.clone();
    defer s2.free();
    if s1.len() != 5usize { return 71i32; }
    if s2.len() != 5usize { return 72i32; }
    if s1.as_slice() != s2.as_slice() { return 73i32; }

    // Test CString move
    let s3 = std::ffi::CString::from_slice("world");
    let s4 = s3.move();
    defer s4.free();
    if s3.ptr as usize != 0usize { return 74i32; }
    if s4.len() != 5usize { return 75i32; }

    // Test CString fmt
    let buf: [u8; 32];
    let f = std::fmt::SliceFormatter::new(&buf);
    s4.fmt(&f);
    if f.get() != "world" { return 76i32; }

    0i32
}

fn main(args: &[&[u8]]) -> i32 {
    let r = test_for_range();
    if r != 0i32 { return r; }

    let r = test_for_slice();
    if r != 0i32 { return r; }

    let r = test_for_array();
    if r != 0i32 { return r; }

    let r = test_for_iterator();
    if r != 0i32 { return r; }

    let r = test_mem_uninitialized();
    if r != 0i32 { return r; }

    let r = test_mem_alloc_zeroed();
    if r != 0i32 { return r; }

    let r = test_mem_copy();
    if r != 0i32 { return r; }

    let r = test_cstring_enhanced();
    if r != 0i32 { return r; }

    0i32
}
