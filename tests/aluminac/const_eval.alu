// Test const evaluation: exercises the full const evaluator.

extern "intrinsic" fn size_of<T>() -> usize;
extern "intrinsic" fn align_of<T>() -> usize;
extern "intrinsic" fn const_eval<T>(v: T) -> T;
extern "intrinsic" fn is_const_evaluable<T>(v: T) -> bool;

// === Functions used in const context ===

fn add_one(x: i32) -> i32 {
    x + 1i32
}

fn factorial(n: i32) -> i32 {
    if n <= 1i32 {
        1i32
    } else {
        n * factorial(n - 1i32)
    }
}

fn fib(n: i32) -> i32 {
    if n <= 0i32 { return 0i32; }
    if n == 1i32 { return 1i32; }
    fib(n - 1i32) + fib(n - 2i32)
}

// === Enums with various const expressions ===

enum Sizes {
    Byte = size_of::<u8>() as i32,
    Word = size_of::<u32>() as i32,
    Dword = size_of::<u64>() as i32,
}

enum Computed {
    A = add_one(41i32),  // 42
    B = factorial(5i32), // 120
    C = fib(10i32),      // 55
}

enum BitwiseComplex {
    Mask8  = (1i32 << 8i32) - 1i32,    // 255
    Mask16 = (1i32 << 16i32) - 1i32,   // 65535
}

enum SignedVals {
    NegFive = 0i32 - 5i32,
    NegOne = 0i32 - 1i32,
    Zero = 0i32,
    One = 1i32,
}

// === When expressions ===

fn classify_size<T>() -> i32 {
    when size_of::<T>() == 0usize {
        0i32
    } else when size_of::<T>() <= 1usize {
        1i32
    } else when size_of::<T>() <= 4usize {
        4i32
    } else {
        8i32
    }
}

fn is_small<T>() -> bool {
    when size_of::<T>() <= 4usize {
        true
    } else {
        false
    }
}

fn main(args: &[&[u8]]) -> i32 {
    // --- Basic enum const eval ---
    if Sizes::Byte as i32 != 1i32 { return 1i32; }
    if Sizes::Word as i32 != 4i32 { return 2i32; }
    if Sizes::Dword as i32 != 8i32 { return 3i32; }

    // --- Const function calls in enum values ---
    if Computed::A as i32 != 42i32 { return 10i32; }
    if Computed::B as i32 != 120i32 { return 11i32; }
    if Computed::C as i32 != 55i32 { return 12i32; }

    // --- Complex bitwise ---
    if BitwiseComplex::Mask8 as i32 != 255i32 { return 20i32; }
    if BitwiseComplex::Mask16 as i32 != 65535i32 { return 21i32; }

    // --- When expressions ---
    if classify_size::<()>() != 0i32 { return 30i32; }
    if classify_size::<u8>() != 1i32 { return 31i32; }
    if classify_size::<i32>() != 4i32 { return 32i32; }
    if classify_size::<i64>() != 8i32 { return 33i32; }

    if !is_small::<u8>() { return 40i32; }
    if !is_small::<i32>() { return 41i32; }
    if is_small::<i64>() { return 42i32; }

    // --- Signed enum values ---
    if SignedVals::NegFive as i32 != 0i32 - 5i32 { return 50i32; }
    if SignedVals::NegOne as i32 != 0i32 - 1i32 { return 51i32; }
    if SignedVals::Zero as i32 != 0i32 { return 52i32; }
    if SignedVals::One as i32 != 1i32 { return 53i32; }

    // --- align_of ---
    if align_of::<u8>() != 1usize { return 60i32; }
    if align_of::<u32>() != 4usize { return 61i32; }
    if align_of::<u64>() != 8usize { return 62i32; }

    // --- Array size expressions ---
    let arr1: [u8; size_of::<u32>()];  // should be [u8; 4]
    if size_of::<[u8; size_of::<u32>()]>() != 4usize { return 70i32; }
    if size_of::<[u8; size_of::<u64>()]>() != 8usize { return 71i32; }

    // --- Tuple index expressions ---
    let t = (10i32, 20i32, 30i32);
    if t.(0usize) != 10i32 { return 80i32; }
    if t.(1usize) != 20i32 { return 81i32; }
    if t.(2usize) != 30i32 { return 82i32; }
    if t.(1usize + 1usize) != 30i32 { return 83i32; }

    // --- const_eval intrinsic ---
    let x = const_eval::<i32>(2i32 + 3i32);
    if x != 5i32 { return 90i32; }
    let sz = const_eval::<usize>(size_of::<u64>());
    if sz != 8usize { return 91i32; }

    // --- is_const_evaluable intrinsic ---
    if !is_const_evaluable::<i32>(1i32 + 2i32) { return 92i32; }

    0i32
}
