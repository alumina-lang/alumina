// ALUMINAC_FLAGS: --sysroot sysroot
// `T::method()` where T is a generic param bounded by a protocol like
// `Integer` must dispatch through T's concrete builtin scope at mono time —
// e.g. `T::max_value()` against `T = i32` should find `i32::max_value`'s
// `impl i32 { fn max_value() -> i32 }`.
//
// Before this regression test, `find_method_in_scope` only handled Struct /
// Enum / Slice / Tuple receivers; Builtin (i32, u32, …) fell through with
// scope_idx=0 and the dispatch returned None — the call expression then
// hit lower_call's fallback and emitted "expression is not callable".
//
// Surfaced by sysroot's `parse_integer<T: Integer>` body's `T::max_value()`
// (line 758 of std/string/mod.alu) during the string/mod.alu unification.

fn max_for<T: std::builtins::Integer>() -> T {
    T::max_value()
}

fn main(args: &[&[u8]]) -> i32 {
    if max_for::<u8>() != 255u8 { return 1i32; }
    if max_for::<u16>() != 65535u16 { return 2i32; }
    if max_for::<i32>() != 2147483647i32 { return 3i32; }
    if max_for::<u32>() != 4294967295u32 { return 4i32; }
    0i32
}
