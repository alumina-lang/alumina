// Test eprintln! and eprint! macros
// These write to stderr (fd 2)

fn main(args: &[&[u8]]) -> i32 {
    // Test eprint! (no newline)
    eprint!("hello ");
    eprint!("world");
    eprint!("\n");

    // Test eprintln! (with newline)
    eprintln!("line one");
    eprintln!("x={}", 42);
    eprintln!("a={} b={}", 1, 2);

    // Test with different types
    eprintln!("bool={}", true);
    eprintln!("neg={}", -5);

    0
}

// RUN: aluminac
// EXPECTED STDERR:
// hello world
// line one
// x=42
// a=1 b=2
// bool=true
// neg=-5
