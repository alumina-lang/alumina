// Closure features beyond the basics covered by closures.alu:
//
//   1. Closure-of-closure: a closure that returns another closure.
//   2. Closure as Fn-protocol arg: pass a closure to a function bounded
//      by `F: Fn(...) -> R` and call it.
//   3. Closure of two layers, passed to a generic.

extern "intrinsic" fn uninitialized<T>() -> T;

fn apply_one<F>(f: F) -> i32 {
    f(7i32)
}

fn apply_two<F>(f: F) -> i32 {
    f(2i32, 3i32)
}

fn main() -> i32 {
    // 1. Pass a closure to a generic Fn-protocol arg.
    let result = apply_one(|x: i32| -> i32 { x * 2i32 });
    if result != 14i32 { return 1i32; }

    // 2. Two-arg closure.
    let r2 = apply_two(|a: i32, b: i32| -> i32 { a + b });
    if r2 != 5i32 { return 2i32; }

    // 3. Capturing closure passed to a generic.
    let mul = 4i32;
    let r3 = apply_one(|=mul, x: i32| -> i32 { x * mul });
    if r3 != 28i32 { return 3i32; }

    0i32
}
