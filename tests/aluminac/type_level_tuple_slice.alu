// ALUMINAC_FLAGS: --sysroot sysroot
// In a type, `T.N` and `T.(expr)` index a tuple type and `T.(a..b)` slices
// it (as in alumina-boot); aluminac only knew integer literals.

use std::typing::is_same;

type Tup = (u8, u16, u32, u64);
const I: usize = 2;

fn main() -> i32 {
    if !is_same::<Tup.0, u8>() { return 1; }
    if !is_same::<Tup.(I), u32>() { return 2; }
    if !is_same::<Tup.(1..3), (u16, u32)>() { return 3; }
    if !is_same::<Tup.(2..), (u32, u64)>() { return 4; }
    if !is_same::<Tup.(..=0), (u8,)>() { return 5; }
    0
}
