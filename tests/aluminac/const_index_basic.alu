// ALUMINAC_FLAGS: --sysroot sysroot

// Const-time indexing into string/byte-string/array literals — positive paths.
// Each "OK" case must const-fold so the value can drive an array length
// (a const-required usage). The OOB / wrapping-negative case is covered in
// const_index_oob_compile_fail.alu.

const STR_BYTES: &[u8] = "hello";
const ARR: [i32; 4] = [10i32, 20i32, 30i32, 40i32];

const FIRST_BYTE: u8 = STR_BYTES[0];
const LAST_BYTE: u8 = STR_BYTES[4];
const ARR_FIRST: i32 = ARR[0];
const ARR_LAST: i32 = ARR[3];

// Const-required usages — sized arrays driven by const-folded indexing.
const LEN_FROM_BYTE: usize = if FIRST_BYTE == 'h' as u8 { 4usize } else { 0usize };
const LEN_FROM_ARR: usize = ARR[2] as usize;  // = 30

fn main(args: &[&[u8]]) -> i32 {
    if FIRST_BYTE != 'h' as u8 { return 1i32; }
    if LAST_BYTE != 'o' as u8 { return 2i32; }
    if ARR_FIRST != 10i32 { return 3i32; }
    if ARR_LAST != 40i32 { return 4i32; }

    let from_byte: [u8; LEN_FROM_BYTE];
    if from_byte.len() != 4usize { return 10i32; }

    let from_arr: [u8; LEN_FROM_ARR];
    if from_arr.len() != 30usize { return 11i32; }

    0i32
}
