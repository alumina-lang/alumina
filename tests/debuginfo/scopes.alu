// Locals in their lexical scopes; the compiler's own are hidden.
fn main() {
    let x = 1;
    let total = 0;
    {
        let x = "inner";
        println!("{}", x); // #break
    }
    for i in 0..3 {
        total += i; // #break
    }
    let pairs = [(1, 'a'), (2, 'b')];
    for (n, ch) in pairs {
        total += n; // #break
    }
    println!("{} {}", x, total); // #break
}

