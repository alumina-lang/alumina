// Functions by their names in backtraces: modules, methods, generics.
mod geometry {
    struct Square { side: i32 }

    impl Square {
        fn area(self: &Square) -> i32 {
            report(self.side * self.side)
        }
    }

    fn report<T>(value: T) -> T {
        println!("{}", value); // #break
        value
    }
}

fn main() {
    let s = geometry::Square { side: 3 };
    let a = s.area();
    std::process::exit(a - 9);
}

