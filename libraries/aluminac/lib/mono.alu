// Monomorphization engine for the self-hosted Alumina compiler
//
// Takes polymorphic AST items and produces concrete IR with all generics resolved.
// This is the core of the compiler - where type inference, generic substitution,
// and lowering all happen.

use ast::*;
use scope::*;
use diagnostics::DiagnosticContext;
use arena::Arena;
use std::collections::{HashMap, Vector};
use std::option::Option;

// Key for memoizing monomorphized items
struct MonoKey {
    item_id: Id,
    type_args: &[&IrTy],
}

// Context shared across all monomorphization
struct MonoCtx {
    arena: &mut Arena,
    scopes: &ScopeArena,
    id_gen: &mut IdGen,
    diag: &mut DiagnosticContext,

    // Source items from parsing
    items: &[Item],

    // Lookup tables built from parsed items
    fn_defs: HashMap<usize, &FnDef>,       // id -> FnDef
    struct_defs: HashMap<usize, &StructDef>,
    enum_defs: HashMap<usize, &EnumDef>,
    type_aliases: HashMap<usize, &TypeAlias>,
    protocol_defs: HashMap<usize, &ProtocolDef>,
    static_defs: HashMap<usize, &StaticDef>,

    // Monomorphized output
    ir_functions: Vector<IrFunction>,
    ir_globals: Vector<IrGlobal>,
    ir_structs: Vector<IrStructRef>,
    ir_enums: Vector<IrEnumRef>,

    // Monomorphization cache: maps (item_id, type_args_hash) -> index in output
    fn_cache: HashMap<u64, usize>,
    struct_cache: HashMap<u64, usize>,
    struct_ty_cache: HashMap<u64, &IrTy>,
    enum_cache: HashMap<u64, usize>,

    // Type caching for pointer stability
    ptr_ty_cache: HashMap<usize, &IrTy>,
    array_ty_cache: HashMap<usize, &IrTy>,
    tuple_ty_cache: HashMap<usize, &IrTy>,

    // Name mangling counter
    mangle_counter: usize,

    // Canonical type instances (stable pointers)
    void_ty: &IrTy,
    never_ty: &IrTy,
    bool_ty: &IrTy,
    i8_ty: &IrTy,
    i16_ty: &IrTy,
    i32_ty: &IrTy,
    i64_ty: &IrTy,
    i128_ty: &IrTy,
    u8_ty: &IrTy,
    u16_ty: &IrTy,
    u32_ty: &IrTy,
    u64_ty: &IrTy,
    u128_ty: &IrTy,
    usize_ty: &IrTy,
    isize_ty: &IrTy,
    f32_ty: &IrTy,
    f64_ty: &IrTy,

    // Pointer size
    pointer_size: usize,

    // Lang item IDs for compiler intrinsics
    slice_new_fn_id: usize,      // #[lang(slice_new)] - constructs slice from ptr+len
    lang_items: HashMap<usize, usize>,   // hash(lang_name) -> item_id

    // Protocol method Self substitution: maps method_fn_id -> protocol's Self generic param id
    proto_method_self_id: HashMap<usize, usize>,

    // Debug counter
    unresolved_count: usize,
}

impl MonoCtx {
    fn new(
        arena: &mut Arena,
        scopes: &ScopeArena,
        id_gen: &mut IdGen,
        diag: &mut DiagnosticContext,
        items: &[Item],
    ) -> MonoCtx {
        let void_ty = arena.alloc(IrTy::mk_void());
        let never_ty = arena.alloc(IrTy::mk_never());
        let bool_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::Bool));
        let i8_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::I8));
        let i16_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::I16));
        let i32_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::I32));
        let i64_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::I64));
        let i128_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::I128));
        let u8_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::U8));
        let u16_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::U16));
        let u32_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::U32));
        let u64_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::U64));
        let u128_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::U128));
        let usize_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::USize));
        let isize_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::ISize));
        let f32_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::F32));
        let f64_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::F64));

        let ctx = MonoCtx {
            arena: arena,
            scopes: scopes,
            id_gen: id_gen,
            diag: diag,
            items: items,
            fn_defs: HashMap::new(),
            struct_defs: HashMap::new(),
            enum_defs: HashMap::new(),
            type_aliases: HashMap::new(),
            protocol_defs: HashMap::new(),
            static_defs: HashMap::new(),
            ir_functions: Vector::new(),
            ir_globals: Vector::new(),
            ir_structs: Vector::new(),
            ir_enums: Vector::new(),
            fn_cache: HashMap::new(),
            struct_cache: HashMap::new(),
            struct_ty_cache: HashMap::new(),
            enum_cache: HashMap::new(),
            ptr_ty_cache: HashMap::new(),
            array_ty_cache: HashMap::new(),
            tuple_ty_cache: HashMap::new(),
            mangle_counter: 0,
            void_ty: void_ty,
            never_ty: never_ty,
            bool_ty: bool_ty,
            i8_ty: i8_ty,
            i16_ty: i16_ty,
            i32_ty: i32_ty,
            i64_ty: i64_ty,
            i128_ty: i128_ty,
            u8_ty: u8_ty,
            u16_ty: u16_ty,
            u32_ty: u32_ty,
            u64_ty: u64_ty,
            u128_ty: u128_ty,
            usize_ty: usize_ty,
            isize_ty: isize_ty,
            f32_ty: f32_ty,
            f64_ty: f64_ty,
            pointer_size: 8, // assume 64-bit
            slice_new_fn_id: 0,
            lang_items: HashMap::new(),
            proto_method_self_id: HashMap::new(),
            unresolved_count: 0,
        };

        // Build lookup tables
        ctx.build_lookup_tables();
        ctx
    }

    fn build_lookup_tables(self: &mut MonoCtx) {
        // Use index-based iteration to get stable pointers into the slice
        for i in 0usize..self.items.len() {
            if self.items[i].tag == ITEM_FUNCTION {
                self.fn_defs.insert(self.items[i].fn_def.id._value, &self.items[i].fn_def);
                // Register lang items
                for attr in self.items[i].fn_def.attributes {
                    if attr.tag == ATTR_LANG {
                        let hash = self.hash_lang_name(attr.str_val);
                        self.lang_items.insert(hash, self.items[i].fn_def.id._value);
                        if attr.str_val == "slice_new" {
                            self.slice_new_fn_id = self.items[i].fn_def.id._value;
                        }
                    }
                }
            } else if self.items[i].tag == ITEM_STRUCT {
                self.struct_defs.insert(self.items[i].struct_def.id._value, &self.items[i].struct_def);
                for attr in self.items[i].struct_def.attributes {
                    if attr.tag == ATTR_LANG {
                        let hash = self.hash_lang_name(attr.str_val);
                        self.lang_items.insert(hash, self.items[i].struct_def.id._value);
                    }
                }
            } else if self.items[i].tag == ITEM_ENUM {
                self.enum_defs.insert(self.items[i].enum_def.id._value, &self.items[i].enum_def);
                for attr in self.items[i].enum_def.attributes {
                    if attr.tag == ATTR_LANG {
                        let hash = self.hash_lang_name(attr.str_val);
                        self.lang_items.insert(hash, self.items[i].enum_def.id._value);
                    }
                }
            } else if self.items[i].tag == ITEM_TYPE_ALIAS {
                self.type_aliases.insert(self.items[i].type_alias.id._value, &self.items[i].type_alias);
            } else if self.items[i].tag == ITEM_PROTOCOL {
                self.protocol_defs.insert(self.items[i].protocol_def.id._value, &self.items[i].protocol_def);
                // Also register protocol methods in fn_defs so they can be called
                let proto_def = &self.items[i].protocol_def;
                let self_gp_id: usize = 0usize;
                if proto_def.generic_params.len() > 0 {
                    self_gp_id = proto_def.generic_params[0].id._value;
                }
                for j in 0usize..proto_def.methods.len() {
                    let method = &proto_def.methods[j];
                    self.fn_defs.insert(method.id._value, method);
                    // Record the Self generic param id for this method
                    if self_gp_id != 0usize || proto_def.generic_params.len() > 0 {
                        self.proto_method_self_id.insert(method.id._value, self_gp_id);
                    }
                }
            } else if self.items[i].tag == ITEM_STATIC {
                self.static_defs.insert(self.items[i].static_def.id._value, &self.items[i].static_def);
            }
        }
    }

    fn hash_lang_name(self: &MonoCtx, name: &[u8]) -> usize {
        let h: usize = 5381usize;
        for i in 0usize..name.len() {
            h = h * 33usize + name[i] as usize;
        }
        h
    }

    // Look up a lang item by name. Returns the item ID or 0 if not found.
    // Note: 0 can be a valid ID, so use has_lang_item() to check existence.
    fn get_lang_item(self: &MonoCtx, name: &[u8]) -> Option<usize> {
        let hash = self.hash_lang_name(name);
        let result = self.lang_items.get(&hash);
        if result.is_some() {
            Option::some(result.unwrap())
        } else {
            Option::none()
        }
    }

    fn mangle_name(self: &mut MonoCtx, base: &[u8]) -> &[u8] {
        self.mangle_counter = self.mangle_counter + 1;
        // Create mangled name: _AL<base><counter>
        let counter_str = format_usize(self.mangle_counter, self.arena);
        let total_len = 3usize + base.len() + counter_str.len();
        let buf = self.arena.alloc_slice::<u8>(total_len);
        buf[0] = '_' as u8;
        buf[1] = 'A' as u8;
        buf[2] = 'L' as u8;
        base.copy_to_nonoverlapping(&buf[3]);
        counter_str.copy_to_nonoverlapping(&buf[3 + base.len()]);
        buf
    }

    fn intern_builtin_ty(self: &mut MonoCtx, bt: BuiltinType) -> &IrTy {
        switch bt {
            BuiltinType::Void => self.void_ty,
            BuiltinType::Never => self.never_ty,
            BuiltinType::Bool => self.bool_ty,
            BuiltinType::I8 => self.i8_ty,
            BuiltinType::I16 => self.i16_ty,
            BuiltinType::I32 => self.i32_ty,
            BuiltinType::I64 => self.i64_ty,
            BuiltinType::I128 => self.i128_ty,
            BuiltinType::U8 => self.u8_ty,
            BuiltinType::U16 => self.u16_ty,
            BuiltinType::U32 => self.u32_ty,
            BuiltinType::U64 => self.u64_ty,
            BuiltinType::U128 => self.u128_ty,
            BuiltinType::USize => self.usize_ty,
            BuiltinType::ISize => self.isize_ty,
            BuiltinType::F32 => self.f32_ty,
            BuiltinType::F64 => self.f64_ty,
            _ => self.arena.alloc(IrTy::mk_builtin(bt)),
        }
    }

    fn make_ptr_ty(self: &mut MonoCtx, pointee: &IrTy, is_const: bool) -> &IrTy {
        // Cache pointer types for stability
        let key = (pointee as &void as usize) * 2 + (if is_const { 1usize } else { 0usize });
        let cached = self.ptr_ty_cache.get(&key);
        if cached.is_some() { return cached.unwrap(); }
        let result = self.arena.alloc(IrTy::mk_pointer(pointee, is_const));
        self.ptr_ty_cache.insert(key, result);
        result
    }

    fn make_array_ty(self: &mut MonoCtx, elem: &IrTy, size: usize) -> &IrTy {
        let key = (elem as &void as usize) * 65537 + size;
        let cached = self.array_ty_cache.get(&key);
        if cached.is_some() { return cached.unwrap(); }
        let result = self.arena.alloc(IrTy::mk_array(elem, size));
        self.array_ty_cache.insert(key, result);
        result
    }

    fn make_tuple_ty(self: &mut MonoCtx, elems: &[&IrTy]) -> &IrTy {
        if elems.len() == 0 {
            return self.void_ty;
        }
        // Cache tuple types for pointer stability
        // Hash based on element count and element type pointers
        let key: usize = elems.len() * 31;
        for i in 0usize..elems.len() {
            key = key * 31 + (elems[i] as &void as usize);
        }
        let cached = self.tuple_ty_cache.get(&key);
        if cached.is_some() { return cached.unwrap(); }
        let result = self.arena.alloc(IrTy::mk_tuple(elems));
        self.tuple_ty_cache.insert(key, result);
        result
    }

    fn make_fn_ptr_ty(self: &mut MonoCtx, params: &[&IrTy], ret: &IrTy) -> &IrTy {
        // Cache function pointer types for pointer stability
        let key: usize = (ret as &void as usize) * 31 + params.len();
        for i in 0usize..params.len() {
            key = key * 31 + (params[i] as &void as usize);
        }
        // Different hash space from tuples
        key = key + 0x20000000usize;
        let cached = self.tuple_ty_cache.get(&key);
        if cached.is_some() { return cached.unwrap(); }
        let result = self.arena.alloc(IrTy::mk_fn_pointer(params, ret));
        self.tuple_ty_cache.insert(key, result);
        result
    }

    fn make_slice_ty(self: &mut MonoCtx, elem: &IrTy, is_const: bool) -> &IrTy {
        // Slice types are structurally just tuples (ptr, len), but we cache the
        // IrTy::mk_slice wrapper too for pointer stability
        let key = (elem as &void as usize) * 2 + (if is_const { 1usize } else { 0usize });
        // Use a different hash space from ptr_ty_cache by adding a large offset
        key = key + 0x10000000usize;
        let cached = self.tuple_ty_cache.get(&key);
        if cached.is_some() { return cached.unwrap(); }
        // Build elems = {ptr_ty, usize_ty} so code that assumes tuple representation works
        let ptr_ty = self.make_ptr_ty(elem, is_const);
        let usize_ty = self.intern_builtin_ty(BuiltinType::USize);
        let elems = self.arena.alloc_slice::<&IrTy>(2);
        elems[0] = ptr_ty;
        elems[1] = usize_ty;
        let result = self.arena.alloc(IrTy::mk_slice(elem, is_const));
        result.elems = elems;
        self.tuple_ty_cache.insert(key, result);
        result
    }

    fn free(self: &mut MonoCtx) {
        self.fn_defs.free();
        self.struct_defs.free();
        self.enum_defs.free();
        self.type_aliases.free();
        self.protocol_defs.free();
        self.static_defs.free();
        self.ir_functions.free();
        self.ir_globals.free();
        self.ir_structs.free();
        self.ir_enums.free();
        self.fn_cache.free();
        self.struct_cache.free();
        self.struct_ty_cache.free();
        self.enum_cache.free();
        self.ptr_ty_cache.free();
        self.array_ty_cache.free();
        self.tuple_ty_cache.free();
    }
}

// Per-function monomorphization state
struct Mono {
    ctx: &mut MonoCtx,
    // Generic type parameter substitutions
    type_map: HashMap<usize, &IrTy>,   // placeholder id -> concrete type
    // Local variable types
    local_types: HashMap<usize, &IrTy>,
    // Local variable defs accumulated during lowering
    local_defs: Vector<IrLocalDef>,
    // Return type of the current function
    return_type: &IrTy,
    // Current function name for debugging
    current_fn_name: &[u8],
    // Expected type hint for return type inference (e.g. from if-else sibling branch)
    expected_type: &IrTy,
    // Debug: mono_function nesting depth
    mono_depth: usize,
}

impl Mono {
    fn new(ctx: &mut MonoCtx) -> Mono {
        Mono {
            ctx: ctx,
            type_map: HashMap::new(),
            local_types: HashMap::new(),
            local_defs: Vector::new(),
            return_type: ctx.void_ty,
            current_fn_name: "",
            expected_type: ctx.void_ty,
            mono_depth: 0usize,
        }
    }

    fn with_substitutions(ctx: &mut MonoCtx, type_map: HashMap<usize, &IrTy>) -> Mono {
        Mono {
            ctx: ctx,
            type_map: type_map,
            local_types: HashMap::new(),
            local_defs: Vector::new(),
            return_type: ctx.void_ty,
            current_fn_name: "",
            expected_type: ctx.void_ty,
            mono_depth: 0usize,
        }
    }

    // Resolve an AST type to a concrete IR type
    fn resolve_type(self: &mut Mono, ty: &Ty) -> &IrTy {
        if ty.tag == TY_BUILTIN {
            self.ctx.intern_builtin_ty(ty.builtin)
        } else if ty.tag == TY_PLACEHOLDER {
            let resolved = self.type_map.get(&ty.id._value);
            if resolved.is_some() {
                resolved.unwrap()
            } else {
                // Unresolved placeholder - error
                self.ctx.unresolved_count = self.ctx.unresolved_count + 1;
                self.ctx.void_ty
            }
        } else if ty.tag == TY_POINTER {
            // Special case: &[T] and &mut [T] are fat pointers (not pointer-to-slice)
            if ty.inner.tag == TY_SLICE {
                // &[T] / &mut [T] -> {&T, usize} tuple (the fat pointer itself)
                let elem_ty = self.resolve_type(ty.inner.inner);
                let data_ty = self.ctx.make_ptr_ty(elem_ty, ty.is_const);
                let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
                let fields = self.ctx.arena.alloc_slice::<&IrTy>(2);
                fields[0] = data_ty;
                fields[1] = usize_ty;
                return self.ctx.make_tuple_ty(fields);
            }
            let inner_ty = self.resolve_type(ty.inner);
            self.ctx.make_ptr_ty(inner_ty, ty.is_const)
        } else if ty.tag == TY_SLICE {
            // Slices are fat pointers: (data_ptr, len) as a tuple
            let inner_ty = self.resolve_type(ty.inner);
            let data_ty = self.ctx.make_ptr_ty(inner_ty, ty.is_const);
            let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
            let fields = self.ctx.arena.alloc_slice::<&IrTy>(2);
            fields[0] = data_ty;
            fields[1] = usize_ty;
            self.ctx.make_tuple_ty(fields)
        } else if ty.tag == TY_ARRAY {
            let inner_ty = self.resolve_type(ty.inner);
            self.ctx.make_array_ty(inner_ty, ty.array_size)
        } else if ty.tag == TY_TUPLE {
            let resolved = self.ctx.arena.alloc_slice::<&IrTy>(ty.elems.len());
            for i in 0usize..ty.elems.len() {
                resolved[i] = self.resolve_type(ty.elems[i]);
            }
            self.ctx.make_tuple_ty(resolved)
        } else if ty.tag == TY_FN_POINTER {
            let resolved_params = self.ctx.arena.alloc_slice::<&IrTy>(ty.elems.len());
            for i in 0usize..ty.elems.len() {
                resolved_params[i] = self.resolve_type(ty.elems[i]);
            }
            let resolved_ret = self.resolve_type(ty.ret_ty);
            self.ctx.make_fn_ptr_ty(resolved_params, resolved_ret)
        } else if ty.tag == TY_NAMED {
            let item_ref = ItemRef { id: ty.id };
            self.resolve_named_type(item_ref, &[])
        } else if ty.tag == TY_GENERIC {
            // Resolve the base type with generic arguments
            let resolved_args = self.ctx.arena.alloc_slice::<&IrTy>(ty.elems.len());
            for i in 0usize..ty.elems.len() {
                resolved_args[i] = self.resolve_type(ty.elems[i]);
            }
            if ty.inner.tag == TY_NAMED {
                let item_ref = ItemRef { id: ty.inner.id };
                self.resolve_named_type(item_ref, resolved_args)
            } else {
                self.resolve_type(ty.inner)
            }
        } else if ty.tag == TY_NEVER {
            self.ctx.never_ty
        } else if ty.tag == TY_TYPEOF {
            // typeof(expr) - lower the expression and return its type
            let result = self.lower_expr(ty.typeof_expr);
            result.ty
        } else if ty.tag == TY_WHEN {
            // when cond { TypeA } else { TypeB }
            let cond_ir = self.lower_expr(ty.typeof_expr);
            let cond_val = self.try_const_eval_bool(cond_ir);
            if cond_val.is_some() && cond_val.unwrap() {
                self.resolve_type(ty.inner)
            } else {
                self.resolve_type(ty.ret_ty)
            }
        } else if ty.tag == TY_UNRESOLVED {
            self.ctx.unresolved_count = self.ctx.unresolved_count + 1;
            self.ctx.void_ty
        } else {
            self.ctx.void_ty
        }
    }

    fn resolve_named_type(self: &mut Mono, item_ref: ItemRef, type_args: &[&IrTy]) -> &IrTy {
        // Check if it's a struct
        let struct_def = self.ctx.struct_defs.get(&item_ref.id._value);
        if struct_def.is_some() {
            return self.mono_struct(struct_def.unwrap(), type_args);
        }

        // Check if it's an enum
        let enum_def = self.ctx.enum_defs.get(&item_ref.id._value);
        if enum_def.is_some() {
            return self.mono_enum(enum_def.unwrap(), type_args);
        }

        // Check if it's a type alias
        let ta = self.ctx.type_aliases.get(&item_ref.id._value);
        if ta.is_some() {
            let alias = ta.unwrap();
            // Set up type parameter substitution
            if alias.generic_params.len() > 0 && type_args.len() > 0 {
                for i in 0usize..std::cmp::min(alias.generic_params.len(), type_args.len()) {
                    self.type_map.insert(alias.generic_params[i].id._value, type_args[i]);
                }
            }
            let result = self.resolve_type(alias.target);
            return result;
        }

        self.ctx.void_ty
    }

    fn mono_struct(self: &mut Mono, def: &StructDef, type_args: &[&IrTy]) -> &IrTy {
        // Check cache
        let cache_key = hash_mono_key(def.id, type_args);
        let cached = self.ctx.struct_ty_cache.get(&cache_key);
        if cached.is_some() {
            return cached.unwrap();
        }
        // Also check by id only for non-generic structs
        if type_args.len() == 0 {
            let id_cached = self.ctx.struct_ty_cache.get(&(def.id._value as u64));
            if id_cached.is_some() {
                return id_cached.unwrap();
            }
        }
        let cached2 = self.ctx.struct_cache.get(&cache_key);
        if cached2.is_some() {
            let idx = cached2.unwrap();
            let result = self.ctx.arena.alloc(IrTy::mk_struct(self.ctx.ir_structs[idx]));
            self.ctx.struct_ty_cache.insert(cache_key, result);
            if type_args.len() == 0 {
                self.ctx.struct_ty_cache.insert(def.id._value as u64, result);
            }
            return result;
        }

        // Set up generic substitution
        if def.generic_params.len() > 0 && type_args.len() > 0 {
            for i in 0usize..std::cmp::min(def.generic_params.len(), type_args.len()) {
                self.type_map.insert(def.generic_params[i].id._value, type_args[i]);
            }
        }

        let mangled = self.ctx.mangle_name(def.name);

        // Use scope_idx directly from StructDef
        let scope_idx = def.scope_idx;

        // Forward-declare: register the struct with empty fields BEFORE resolving field types.
        // This prevents infinite recursion for self-referential structs (e.g. Node { next: &mut Node }).
        let placeholder_fields = self.ctx.arena.alloc_slice::<IrField>(0);
        let ir_struct = IrStructRef {
            id: def.id,
            name: def.name,
            fields: placeholder_fields,
            is_union: def.is_union,
            is_zero_sized: def.fields.len() == 0,
            scope_idx: scope_idx,
            type_args: type_args,
        };

        let idx = self.ctx.ir_structs.len();
        self.ctx.ir_structs.push(ir_struct);
        self.ctx.struct_cache.insert(cache_key, idx);

        // Create the IrTy NOW and cache it immediately. This ensures that recursive
        // references to this struct (e.g. Expr.lhs: &Expr) get the SAME IrTy instance.
        // We will update the fields in-place after resolving them.
        let result = self.ctx.arena.alloc(IrTy::mk_struct(ir_struct));
        self.ctx.struct_ty_cache.insert(cache_key, result);
        if type_args.len() == 0 {
            self.ctx.struct_ty_cache.insert(def.id._value as u64, result);
        }

        // Now resolve field types (may recurse back to this struct via pointer fields)
        let fields = self.ctx.arena.alloc_slice::<IrField>(def.fields.len());
        let is_zst = true;
        for i in 0usize..def.fields.len() {
            let field_ty = self.resolve_type(def.fields[i].ty);
            fields[i] = IrField {
                name: def.fields[i].name,
                ty: field_ty,
            };
            if !field_ty.is_zero_sized() {
                is_zst = false;
            }
        }

        if def.fields.len() == 0 {
            is_zst = true;
        }

        // Update both the ir_structs entry AND the cached IrTy in-place
        self.ctx.ir_structs[idx].fields = fields;
        self.ctx.ir_structs[idx].is_zero_sized = is_zst;
        result.struct_ref.fields = fields;
        result.struct_ref.is_zero_sized = is_zst;
        result
    }

    fn mono_enum(self: &mut Mono, def: &EnumDef, type_args: &[&IrTy]) -> &IrTy {
        let cache_key = hash_mono_key(def.id, type_args);
        let cached = self.ctx.enum_cache.get(&cache_key);
        if cached.is_some() {
            let idx = cached.unwrap();
            return self.ctx.arena.alloc(IrTy::mk_enum(self.ctx.ir_enums[idx]));
        }

        // Determine underlying type
        let underlying = if def.underlying_type.is_some() {
            self.resolve_type(def.underlying_type.unwrap())
        } else {
            self.ctx.intern_builtin_ty(BuiltinType::I32)
        };

        // Resolve variant values
        let variants = self.ctx.arena.alloc_slice::<IrEnumVariant>(def.variants.len());
        let next_val: u64 = 0;
        for i in 0usize..def.variants.len() {
            let val = if def.variants[i].value.is_some() {
                // Evaluate const expression (supports integer literals)
                let val_expr = def.variants[i].value.unwrap();
                if val_expr.tag == EXPR_INT_LIT {
                    val_expr.int_val
                } else {
                    next_val
                }
            } else {
                next_val
            };
            variants[i] = IrEnumVariant {
                name: def.variants[i].name,
                value: val,
            };
            next_val = val + 1;
        }

        let mangled = self.ctx.mangle_name(def.name);

        // Use scope_idx directly from EnumDef
        let enum_scope_idx = def.scope_idx;

        let ir_enum = IrEnumRef {
            id: def.id,
            name: def.name,
            underlying: underlying,
            variants: variants,
            scope_idx: enum_scope_idx,
        };

        let idx = self.ctx.ir_enums.len();
        self.ctx.ir_enums.push(ir_enum);
        self.ctx.enum_cache.insert(cache_key, idx);

        self.ctx.arena.alloc(IrTy::mk_enum(self.ctx.ir_enums[idx]))
    }

    fn mono_function(self: &mut Mono, def: &FnDef, type_args: &[&IrTy]) -> usize {
        // Protocol method redirect: if this function has no body, it may be a protocol
        // method declaration. Try to find the concrete implementation on the target type.
        if def.body.is_none() && def.abi.is_none() {
            // First try with explicit type_args
            if type_args.len() > 0 {
                let redirect = self.try_protocol_redirect(def, type_args);
                if redirect.is_some() {
                    return redirect.unwrap();
                }
            }
            // Also try using type_map to find the Self type for protocol methods
            let self_param_id_opt = self.ctx.proto_method_self_id.get(&def.id._value);
            if self_param_id_opt.is_some() {
                let self_ty_opt = self.type_map.get(&self_param_id_opt.unwrap());
                if self_ty_opt.is_some() {
                    let ta = self.ctx.arena.alloc_slice::<&IrTy>(1);
                    ta[0] = self_ty_opt.unwrap();
                    let redirect = self.try_protocol_redirect(def, ta);
                    if redirect.is_some() {
                        return redirect.unwrap();
                    }
                }
            }
        }

        // Skip intrinsic functions - they should be handled inline in lower_intrinsic
        if def.abi.is_some() && def.abi.unwrap() == "intrinsic" {
            // Return a dummy index - intrinsics should never actually be called
            let cache_key = hash_mono_key(def.id, type_args);
            let cached = self.ctx.fn_cache.get(&cache_key);
            if cached.is_some() {
                return cached.unwrap();
            }
            // Intrinsics should be intercepted in lower_call, not reach here
            // But if they do (e.g. as function references), create a dummy
            return 0usize; // Will cause issues if actually used, but shouldn't be
        }

        let prev_fn_name = self.current_fn_name;
        self.current_fn_name = def.name;


        let cache_key = hash_mono_key(def.id, type_args);
        let cached = self.ctx.fn_cache.get(&cache_key);
        if cached.is_some() {
            self.current_fn_name = prev_fn_name;
            return cached.unwrap();
        }

        // Save state for nested mono_function calls
        let prev_return_type = self.return_type;
        let prev_local_types = self.local_types;
        let prev_local_defs = self.local_defs;
        let prev_depth = self.mono_depth;
        self.local_types = HashMap::new();
        self.local_defs = Vector::new();
        self.mono_depth = self.mono_depth + 1usize;

        // Set up generic substitution
        if def.generic_params.len() > 0 && type_args.len() > 0 {
            for i in 0usize..std::cmp::min(def.generic_params.len(), type_args.len()) {
                self.type_map.insert(def.generic_params[i].id._value, type_args[i]);
            }
        }

        // Resolve parameter types
        let params = self.ctx.arena.alloc_slice::<IrParam>(def.params.len());
        for i in 0usize..def.params.len() {
            let param_ty = self.resolve_type(def.params[i].ty);
            params[i] = IrParam {
                id: def.params[i].id,
                ty: param_ty,
                name: def.params[i].name,
            };
            self.local_types.insert(def.params[i].id._value, param_ty);
        }

        // Resolve return type
        self.return_type = self.resolve_type(def.return_type);

        // Determine mangled name
        let mangled = if def.abi.is_some() {
            // Extern functions keep their name
            def.name
        } else {
            // Check for export or main attribute
            let keep_name = false;
            for attr in def.attributes {
                if attr.tag == ATTR_EXPORT {
                    keep_name = true;
                } else if attr.tag == ATTR_MAIN {
                    keep_name = true;
                }
            }
            if keep_name { def.name } else { self.ctx.mangle_name(def.name) }
        };

        // Reserve index and cache it BEFORE lowering the body
        // to handle recursive functions
        let idx = self.ctx.ir_functions.len();
        let placeholder = IrFunction {
            id: def.id,
            name: def.name,
            mangled_name: mangled,
            params: params,
            return_type: self.return_type,
            body: Option::none(),
            local_defs: &[],
            attributes: def.attributes,
            is_variadic: def.is_variadic,
            abi: def.abi,
        };
        self.ctx.ir_functions.push(placeholder);
        self.ctx.fn_cache.insert(cache_key, idx);

        // Lower body (may recursively call mono_function)
        let body: Option<&IrExpr> = if def.body.is_some() {
            let body_ir = self.lower_expr(def.body.unwrap());
            Option::some(body_ir)
        } else {
            Option::none()
        };

        // Collect local defs
        let local_defs_slice = self.ctx.arena.alloc_slice::<IrLocalDef>(self.local_defs.len());
        for i in 0usize..self.local_defs.len() {
            local_defs_slice[i] = self.local_defs[i];
        }

        // Update the placeholder with the actual body and local defs
        self.ctx.ir_functions[idx].body = body;
        self.ctx.ir_functions[idx].local_defs = local_defs_slice;

        // Restore saved state
        self.return_type = prev_return_type;
        self.local_types = prev_local_types;
        self.local_defs = prev_local_defs;
        self.mono_depth = prev_depth;
        self.current_fn_name = prev_fn_name;
        idx
    }

    // Lower an AST expression to IR (dispatcher)
    fn lower_expr(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_INT_LIT || expr.tag == EXPR_FLOAT_LIT || expr.tag == EXPR_BOOL_LIT || expr.tag == EXPR_STRING_LIT || expr.tag == EXPR_NULL_LIT || expr.tag == EXPR_CHAR_LIT {
            self.lower_literal(expr)
        } else if expr.tag == EXPR_LOCAL || expr.tag == EXPR_PARAM || expr.tag == EXPR_FN_REF || expr.tag == EXPR_ENUM_REF || expr.tag == EXPR_STATIC_REF {
            self.lower_variable(expr)
        } else if expr.tag == EXPR_BINARY || expr.tag == EXPR_UNARY || expr.tag == EXPR_ASSIGN {
            self.lower_binop(expr)
        } else if expr.tag == EXPR_WHEN {
            self.lower_when(expr)
        } else if expr.tag == EXPR_IF || expr.tag == EXPR_WHILE || expr.tag == EXPR_LOOP || expr.tag == EXPR_FOR || expr.tag == EXPR_SWITCH || expr.tag == EXPR_BREAK || expr.tag == EXPR_CONTINUE || expr.tag == EXPR_RETURN {
            self.lower_control_flow(expr)
        } else if expr.tag == EXPR_REF || expr.tag == EXPR_DEREF || expr.tag == EXPR_FIELD_ACCESS || expr.tag == EXPR_TUPLE_INDEX || expr.tag == EXPR_INDEX || expr.tag == EXPR_CAST || expr.tag == EXPR_TYPE_CHECK {
            self.lower_memory(expr)
        } else if expr.tag == EXPR_CALL || expr.tag == EXPR_STRUCT_LIT {
            self.lower_call(expr)
        } else if expr.tag == EXPR_BLOCK || expr.tag == EXPR_LET || expr.tag == EXPR_DEFER {
            self.lower_block(expr)
        } else if expr.tag == EXPR_TUPLE_LIT {
            let ir_elems = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len());
            let elem_types = self.ctx.arena.alloc_slice::<&IrTy>(expr.args.len());
            for i in 0usize..expr.args.len() {
                ir_elems[i] = self.lower_expr(expr.args[i]);
                elem_types[i] = ir_elems[i].ty;
            }
            let tuple_ty = self.ctx.make_tuple_ty(elem_types);
            let result = IrExpr::void_expr(tuple_ty);
            result.tag = IR_TUPLE_LIT;
            result.items = ir_elems;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_ARRAY_LIT {
            let ir_elems = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len());
            let elem_ty = self.ctx.void_ty;
            for i in 0usize..expr.args.len() {
                ir_elems[i] = self.lower_expr(expr.args[i]);
                if i == 0 {
                    elem_ty = ir_elems[i].ty;
                }
            }
            let arr_ty = self.ctx.make_array_ty(elem_ty, expr.args.len());
            let result = IrExpr::void_expr(arr_ty);
            result.tag = IR_ARRAY_LIT;
            result.items = ir_elems;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_LAMBDA {
            self.lower_lambda(expr)
        } else if expr.tag == EXPR_BOUND_VALUE {
            self.lower_bound_value(expr)
        } else if expr.tag == EXPR_VOID {
            let result = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_ZEROED {
            if expr.ty as &void as usize == 0usize {
                let result = IrExpr::void_expr(self.ctx.void_ty);
                result.tag = IR_ZEROED;
                self.ctx.arena.alloc(result)
            } else {
                let ir_ty = self.resolve_type(expr.ty);
                let result = IrExpr::void_expr(ir_ty);
                result.tag = IR_ZEROED;
                self.ctx.arena.alloc(result)
            }
        } else if expr.tag == EXPR_TRY {
            self.lower_try(expr)
        } else if expr.tag == EXPR_STATIC_FOR {
            self.lower_static_for(expr)
        } else {
            // Unhandled expression kind
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower an expression with a type hint for unsuffixed literals
    fn lower_expr_coerced(self: &mut Mono, expr: &Expr, expected_ty: &IrTy) -> &IrExpr {
        // For unsuffixed integer literals, use the expected type directly
        if expr.tag == EXPR_INT_LIT && expr.type_suffix.is_none() && expected_ty.tag == IRTY_BUILTIN {
            let result = IrExpr::void_expr(expected_ty);
            result.tag = IR_INT_LIT;
            result.int_val = expr.int_val;
            return self.ctx.arena.alloc(result);
        }
        // For null literals, adopt the expected pointer type
        if expr.tag == EXPR_NULL_LIT && expected_ty.tag == IRTY_POINTER {
            let result = IrExpr::void_expr(expected_ty);
            result.tag = IR_NULL_LIT;
            return self.ctx.arena.alloc(result);
        }
        // Set expected_type hint for type inference in function calls
        let saved_expected = self.expected_type;
        self.expected_type = expected_ty;
        let lowered = self.lower_expr(expr);
        self.expected_type = saved_expected;
        let coerced = self.coerce_int(lowered, expected_ty);
        self.coerce_to_type(coerced, expected_ty)
    }

    // Wrap an IR expression in an implicit cast if types differ
    fn coerce_int(self: &mut Mono, ir: &IrExpr, expected: &IrTy) -> &IrExpr {
        if ir.ty.tag == IRTY_BUILTIN && expected.tag == IRTY_BUILTIN && ir.ty != expected {
            // Both are builtin types but differ - insert an implicit cast
            let cast = IrExpr::void_expr(expected);
            cast.tag = IR_CAST;
            cast.lhs = ir;
            return self.ctx.arena.alloc(cast);
        }
        // Coerce null literal to expected pointer type
        if ir.tag == IR_NULL_LIT && expected.tag == IRTY_POINTER && ir.ty != expected {
            let result = IrExpr::void_expr(expected);
            result.tag = IR_NULL_LIT;
            return self.ctx.arena.alloc(result);
        }
        ir
    }

    // Lower literal expressions: EXPR_INT_LIT, EXPR_FLOAT_LIT, EXPR_BOOL_LIT, EXPR_STRING_LIT, EXPR_NULL_LIT, EXPR_CHAR_LIT
    fn lower_literal(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_INT_LIT {
            let ty = if expr.type_suffix.is_some() {
                self.ctx.intern_builtin_ty(expr.type_suffix.unwrap())
            } else {
                self.ctx.intern_builtin_ty(BuiltinType::I32) // default int type
            };
            let result = IrExpr::void_expr(ty);
            result.tag = IR_INT_LIT;
            result.int_val = expr.int_val;
            let allocated = self.ctx.arena.alloc(result);
            allocated
        } else if expr.tag == EXPR_FLOAT_LIT {
            let ty = if expr.type_suffix.is_some() {
                self.ctx.intern_builtin_ty(expr.type_suffix.unwrap())
            } else {
                self.ctx.intern_builtin_ty(BuiltinType::F64)
            };
            let result = IrExpr::void_expr(ty);
            result.tag = IR_FLOAT_LIT;
            result.float_val = expr.float_val;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_BOOL_LIT {
            let result = IrExpr::void_expr(self.ctx.bool_ty);
            result.tag = IR_BOOL_LIT;
            result.bool_val = expr.bool_val;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_STRING_LIT {
            // String literals are &[u8] - use IRTY_SLICE type
            let u8_ty = self.ctx.intern_builtin_ty(BuiltinType::U8);
            let slice_ty = self.ctx.make_slice_ty(u8_ty, true);
            let result = IrExpr::void_expr(slice_ty);
            result.tag = IR_STRING_LIT;
            result.str_val = expr.str_val;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_NULL_LIT {
            let void_ty = self.ctx.void_ty;
            let ptr_ty = self.ctx.make_ptr_ty(void_ty, false);
            let result = IrExpr::void_expr(ptr_ty);
            result.tag = IR_NULL_LIT;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_CHAR_LIT {
            let result = IrExpr::void_expr(self.ctx.intern_builtin_ty(BuiltinType::U32));
            result.tag = IR_INT_LIT;
            result.int_val = expr.int_val;
            self.ctx.arena.alloc(result)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower variable references: EXPR_LOCAL, EXPR_PARAM, EXPR_FN_REF
    fn lower_variable(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_LOCAL {
            let ty = self.local_types.get(&expr.id._value);
            let local_ty = if ty.is_some() { ty.unwrap() } else {
                // HashMap miss - fall back to scanning local_defs vector
                let fallback_ty = self.ctx.void_ty;
                let found_in_defs = false;
                let scan_i = 0usize;
                while scan_i < self.local_defs.len() {
                    if self.local_defs[scan_i].id._value == expr.id._value {
                        fallback_ty = self.local_defs[scan_i].ty;
                        found_in_defs = true;
                    }
                    scan_i = scan_i + 1usize;
                }
                fallback_ty
            };
            let result = IrExpr::void_expr(local_ty);
            result.tag = IR_LOCAL;
            result.id = expr.id;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_PARAM {
            let ty = self.local_types.get(&expr.id._value);
            let param_ty = if ty.is_some() { ty.unwrap() } else {
                self.ctx.void_ty
            };
            let result = IrExpr::void_expr(param_ty);
            result.tag = IR_LOCAL; // params and locals share namespace in IR
            result.id = expr.id;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_FN_REF {
            // Look up the function and get its type
            let fn_def = self.ctx.fn_defs.get(&expr.id._value);
            if fn_def.is_some() {
                let def = fn_def.unwrap();
                let fn_idx = self.mono_function(def, &[]);
                let ir_fn = &self.ctx.ir_functions[fn_idx];

                // Build function pointer type
                let param_types = self.ctx.arena.alloc_slice::<&IrTy>(ir_fn.params.len());
                for i in 0usize..ir_fn.params.len() {
                    param_types[i] = ir_fn.params[i].ty;
                }
                let fn_ty = self.ctx.make_fn_ptr_ty(param_types, ir_fn.return_type);

                let result = IrExpr::void_expr(fn_ty);
                result.tag = IR_FN_REF;
                result.fn_ref = IrFnRef {
                    id: ir_fn.id,
                    mangled_name: ir_fn.mangled_name,
                };
                self.ctx.arena.alloc(result)
            } else {
                let result = IrExpr::void_expr(self.ctx.void_ty);
                result.tag = IR_NULL_LIT;
                self.ctx.arena.alloc(result)
            }
        } else if expr.tag == EXPR_STATIC_REF {
            // Look up the static/const definition
            let sd = self.ctx.static_defs.get(&expr.id._value);
            if sd.is_some() {
                let def = sd.unwrap();
                if def.is_const && def.init.is_some() {
                    // For consts, inline the initializer expression
                    self.lower_expr(def.init.unwrap())
                } else {
                    // For statics, emit a global reference
                    let ty = if def.ty.is_some() {
                        self.resolve_type(def.ty.unwrap())
                    } else {
                        self.ctx.void_ty
                    };
                    let result = IrExpr::void_expr(ty);
                    result.tag = IR_GLOBAL_REF;
                    result.global_ref = IrGlobalRef {
                        id: def.id,
                        mangled_name: def.name,
                    };
                    self.ctx.arena.alloc(result)
                }
            } else {
                let r = IrExpr::void_expr(self.ctx.void_ty);
                self.ctx.arena.alloc(r)
            }
        } else if expr.tag == EXPR_ENUM_REF {
            // Look up enum and variant
            let enum_def = self.ctx.enum_defs.get(&expr.id._value);
            if enum_def.is_some() {
                let def = enum_def.unwrap();
                let enum_ty = self.mono_enum(def, &[]);
                // Find variant value by matching variant id
                let variant_val: u64 = 0;
                for i in 0usize..def.variants.len() {
                    if def.variants[i].id._value == expr.id2._value {
                        // Use the monomorphized variant value from IrEnumRef
                        variant_val = enum_ty.enum_ref.variants[i].value;
                        break;
                    }
                }
                // Use the underlying type for the literal
                let underlying = enum_ty.enum_ref.underlying;
                let result = IrExpr::void_expr(enum_ty);
                result.tag = IR_INT_LIT;
                result.int_val = variant_val;
                self.ctx.arena.alloc(result)
            } else {
                let r = IrExpr::void_expr(self.ctx.void_ty);
                self.ctx.arena.alloc(r)
            }
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower binary/unary/assignment ops: EXPR_BINARY, EXPR_UNARY, EXPR_ASSIGN, EXPR_COMPOUND_ASSIGN
    fn lower_binop(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_BINARY {
            let ir_lhs = self.lower_expr(expr.lhs);
            let ir_rhs = self.lower_expr_coerced(expr.rhs, ir_lhs.ty);
            let result_ty = switch expr.bin_op {
                BinOp::Eq => self.ctx.bool_ty,
                BinOp::Ne => self.ctx.bool_ty,
                BinOp::Lt => self.ctx.bool_ty,
                BinOp::Le => self.ctx.bool_ty,
                BinOp::Gt => self.ctx.bool_ty,
                BinOp::Ge => self.ctx.bool_ty,
                BinOp::And => self.ctx.bool_ty,
                BinOp::Or => self.ctx.bool_ty,
                _ => ir_lhs.ty,
            };
            let result = IrExpr::void_expr(result_ty);
            result.tag = IR_BINARY;
            result.bin_op = expr.bin_op;
            result.lhs = ir_lhs;
            result.rhs = ir_rhs;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_UNARY {
            let ir_operand = self.lower_expr(expr.lhs);
            let result_ty = switch expr.un_op {
                UnOp::Not => self.ctx.bool_ty,
                _ => ir_operand.ty,
            };
            let result = IrExpr::void_expr(result_ty);
            result.tag = IR_UNARY;
            result.un_op = expr.un_op;
            result.lhs = ir_operand;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_ASSIGN {
            let ir_lhs = self.lower_expr(expr.lhs);
            let ir_rhs = self.lower_expr_coerced(expr.rhs, ir_lhs.ty);
            // For compound assignment, desugar to binary + assign
            if expr.assign_op as i32 != AssignOp::Assign as i32 {
                let bin_op = switch expr.assign_op {
                    AssignOp::AddAssign => BinOp::Add,
                    AssignOp::SubAssign => BinOp::Sub,
                    AssignOp::MulAssign => BinOp::Mul,
                    AssignOp::DivAssign => BinOp::Div,
                    AssignOp::RemAssign => BinOp::Rem,
                    AssignOp::BitAndAssign => BinOp::BitAnd,
                    AssignOp::BitOrAssign => BinOp::BitOr,
                    AssignOp::BitXorAssign => BinOp::BitXor,
                    AssignOp::ShlAssign => BinOp::Shl,
                    AssignOp::ShrAssign => BinOp::Shr,
                    _ => BinOp::Add,
                };
                let binop_result = IrExpr::void_expr(ir_lhs.ty);
                binop_result.tag = IR_BINARY;
                binop_result.bin_op = bin_op;
                binop_result.lhs = ir_lhs;
                binop_result.rhs = ir_rhs;
                let binop_expr = self.ctx.arena.alloc(binop_result);

                let assign_result = IrExpr::void_expr(self.ctx.void_ty);
                assign_result.tag = IR_ASSIGN;
                assign_result.lhs = ir_lhs;
                assign_result.rhs = binop_expr;
                return self.ctx.arena.alloc(assign_result);
            }
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_ASSIGN;
            result.lhs = ir_lhs;
            result.rhs = ir_rhs;
            self.ctx.arena.alloc(result)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower control flow: EXPR_IF, EXPR_WHILE, EXPR_LOOP, EXPR_FOR, EXPR_SWITCH, EXPR_BREAK, EXPR_CONTINUE, EXPR_RETURN
    fn lower_control_flow(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_IF {
            let ir_cond = self.lower_expr(expr.cond);
            let ir_then = self.lower_expr(expr.lhs);
            let ir_else: Option<&IrExpr> = if expr.opt_expr.is_some() {
                // Set expected_type hint from then branch for else branch inference
                let saved_expected = self.expected_type;
                if !ir_then.ty.is_void() && !ir_then.ty.is_never() {
                    self.expected_type = ir_then.ty;
                }
                let else_result = self.lower_expr(expr.opt_expr.unwrap());
                self.expected_type = saved_expected;
                Option::some(else_result)
            } else {
                Option::none()
            };
            // Use the larger/more complete type from the branches
            // (e.g., Option::some(T) is the full type, Option::none() may be smaller)
            let result_ty = if ir_else.is_some() && !ir_else.unwrap().ty.is_void() && !ir_else.unwrap().ty.is_never() {
                // If else branch has a non-void type, prefer the one with more structure
                let then_ty = ir_then.ty;
                let else_ty = ir_else.unwrap().ty;
                if then_ty.is_void() || then_ty.is_never() {
                    else_ty
                } else if then_ty.tag == IRTY_STRUCT && else_ty.tag == IRTY_STRUCT {
                    // Prefer the type with the same or larger struct
                    // Both should be the same generic type, but may differ if
                    // one is a degenerate case (e.g., Option::none() vs Option::some(T))
                    if else_ty.struct_ref.fields.len() >= then_ty.struct_ref.fields.len() {
                        else_ty
                    } else {
                        then_ty
                    }
                } else {
                    then_ty
                }
            } else {
                ir_then.ty
            };
            let result = IrExpr::void_expr(result_ty);
            result.tag = IR_IF;
            result.cond = ir_cond;
            result.lhs = ir_then;
            result.opt_expr = ir_else;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_WHILE {
            let ir_cond = self.lower_expr(expr.cond);
            let ir_body = self.lower_expr(expr.lhs);
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_WHILE;
            result.cond = ir_cond;
            result.lhs = ir_body;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_LOOP {
            let ir_body = self.lower_expr(expr.lhs);
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_LOOP;
            result.lhs = ir_body;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_FOR {
            // Desugar: for i in start..end { body }
            // Into: let i = start; let _end = end; while i < _end { body; i = i + 1; }
            let range_expr = expr.lhs;
            if range_expr.tag != EXPR_RANGE {
                // Iterator-based for loop: for item in iterator { body }
                // Desugar into: let _iter = expr; loop { let _opt = _iter.next(); if _opt.is_none() { break; } let item = _opt.unwrap(); body }
                return self.lower_for_iterator(expr);
            }

            let ir_start = self.lower_expr(range_expr.lhs);
            let ir_end = self.lower_expr(range_expr.rhs);
            let iter_ty = ir_start.ty;

            // Register loop variable type
            let loop_var_id = expr.id;
            self.local_types.insert(loop_var_id._value, iter_ty);
            self.local_defs.push(IrLocalDef {
                id: loop_var_id,
                ty: iter_ty,
                name: "",
            });

            // Register end variable
            let end_var_id = self.ctx.id_gen.next_id();
            self.local_types.insert(end_var_id._value, iter_ty);
            self.local_defs.push(IrLocalDef {
                id: end_var_id,
                ty: iter_ty,
                name: "",
            });

            // let i = start
            let let_start = IrExpr::void_expr(self.ctx.void_ty);
            let_start.tag = IR_LET;
            let_start.id = loop_var_id;
            let_start.ir_ty = iter_ty;
            let_start.opt_expr = Option::some(ir_start);
            let ir_let_start = self.ctx.arena.alloc(let_start) as &IrExpr;

            // let _end = end
            let let_end = IrExpr::void_expr(self.ctx.void_ty);
            let_end.tag = IR_LET;
            let_end.id = end_var_id;
            let_end.ir_ty = iter_ty;
            let_end.opt_expr = Option::some(ir_end);
            let ir_let_end = self.ctx.arena.alloc(let_end) as &IrExpr;

            // i (read)
            let read_i = IrExpr::void_expr(iter_ty);
            read_i.tag = IR_LOCAL;
            read_i.id = loop_var_id;
            let ir_read_i = self.ctx.arena.alloc(read_i) as &IrExpr;

            // _end (read)
            let read_end = IrExpr::void_expr(iter_ty);
            read_end.tag = IR_LOCAL;
            read_end.id = end_var_id;
            let ir_read_end = self.ctx.arena.alloc(read_end) as &IrExpr;

            // i < _end (or i <= _end for inclusive)
            let bool_ty = self.ctx.intern_builtin_ty(BuiltinType::Bool);
            let cond = IrExpr::void_expr(bool_ty);
            cond.tag = IR_BINARY;
            cond.bin_op = if range_expr.flag { BinOp::Le } else { BinOp::Lt };
            cond.lhs = ir_read_i;
            cond.rhs = ir_read_end;
            let ir_cond = self.ctx.arena.alloc(cond) as &IrExpr;

            // Lower body
            let ir_body = self.lower_expr(expr.rhs);

            // i (read again for increment)
            let read_i2 = IrExpr::void_expr(iter_ty);
            read_i2.tag = IR_LOCAL;
            read_i2.id = loop_var_id;
            let ir_read_i2 = self.ctx.arena.alloc(read_i2) as &IrExpr;

            // 1 literal
            let one_lit = IrExpr::void_expr(iter_ty);
            one_lit.tag = IR_INT_LIT;
            one_lit.int_val = 1;
            let ir_one = self.ctx.arena.alloc(one_lit) as &IrExpr;

            // i + 1
            let add_expr = IrExpr::void_expr(iter_ty);
            add_expr.tag = IR_BINARY;
            add_expr.bin_op = BinOp::Add;
            add_expr.lhs = ir_read_i2;
            add_expr.rhs = ir_one;
            let ir_add = self.ctx.arena.alloc(add_expr) as &IrExpr;

            // i = i + 1
            let incr = IrExpr::void_expr(self.ctx.void_ty);
            incr.tag = IR_ASSIGN;
            incr.lhs = ir_read_i2;
            incr.rhs = ir_add;
            let ir_incr = self.ctx.arena.alloc(incr) as &IrExpr;

            // while i < _end { body } with continue -> increment
            let while_expr = IrExpr::void_expr(self.ctx.void_ty);
            while_expr.tag = IR_WHILE;
            while_expr.cond = ir_cond;
            while_expr.lhs = ir_body;
            while_expr.opt_expr = Option::some(ir_incr); // continue target: i = i + 1
            let ir_while = self.ctx.arena.alloc(while_expr) as &IrExpr;

            // Full block: { let i = start; let _end = end; while ... }
            let block_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(3);
            block_stmts[0] = ir_let_start;
            block_stmts[1] = ir_let_end;
            block_stmts[2] = ir_while;
            let block = IrExpr::void_expr(self.ctx.void_ty);
            block.tag = IR_BLOCK;
            block.items = block_stmts;
            self.ctx.arena.alloc(block)
        } else if expr.tag == EXPR_SWITCH {
            let ir_value = self.lower_expr(expr.lhs);
            let ir_arms = self.ctx.arena.alloc_slice::<IrSwitchArm>(expr.switch_arms.len());
            for i in 0usize..expr.switch_arms.len() {
                let values = self.ctx.arena.alloc_slice::<u64>(expr.switch_arms[i].pattern.len());
                for j in 0usize..expr.switch_arms[i].pattern.len() {
                    let pat_expr = self.lower_expr(expr.switch_arms[i].pattern[j]);
                    if pat_expr.tag == IR_INT_LIT {
                        values[j] = pat_expr.int_val;
                    } else if pat_expr.tag == IR_CAST && pat_expr.lhs.tag == IR_INT_LIT {
                        values[j] = pat_expr.lhs.int_val;
                    } else {
                        values[j] = 0;
                    }
                }
                ir_arms[i] = IrSwitchArm {
                    values: values,
                    body: self.lower_expr(expr.switch_arms[i].body),
                    is_default: expr.switch_arms[i].pattern.len() == 0,
                };
            }
            let result_ty = if expr.switch_arms.len() > 0 { ir_arms[0].body.ty } else { self.ctx.void_ty };
            let result = IrExpr::void_expr(result_ty);
            result.tag = IR_SWITCH;
            result.lhs = ir_value;
            result.switch_arms = ir_arms;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_BREAK {
            let ir_val: Option<&IrExpr> = if expr.opt_expr.is_some() {
                Option::some(self.lower_expr(expr.opt_expr.unwrap()))
            } else {
                Option::none()
            };
            let result = IrExpr::void_expr(self.ctx.never_ty);
            result.tag = IR_BREAK;
            result.opt_expr = ir_val;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_CONTINUE {
            let result = IrExpr::void_expr(self.ctx.never_ty);
            result.tag = IR_CONTINUE;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_RETURN {
            if expr.opt_expr.is_some() {
                let ir_val = self.lower_expr_coerced(expr.opt_expr.unwrap(), self.return_type);
                let result = IrExpr::void_expr(self.ctx.never_ty);
                result.tag = IR_RETURN;
                result.opt_expr = Option::some(ir_val);
                self.ctx.arena.alloc(result)
            } else {
                let result = IrExpr::void_expr(self.ctx.never_ty);
                result.tag = IR_RETURN;
                self.ctx.arena.alloc(result)
            }
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower iterator-based for loop:
    //   for item in iterator_expr { body }
    // Desugars to:
    //   { let _iter = iterator_expr;
    //     loop { let _opt = _iter.next();
    //            if _opt.is_none() { break; }
    //            let item = _opt.unwrap();
    //            body } }
    fn lower_for_iterator(self: &mut Mono, expr: &Expr) -> &IrExpr {
        let iter_ir = self.lower_expr(expr.lhs);
        let iter_ty = iter_ir.ty;

        // Check if this is a slice iteration: for item in slice { body }
        // Desugar to: { let _s = slice; let _i = 0; let _end = _s.len; while _i < _end { let item = _s[_i]; body; _i = _i + 1; } }
        if self.is_slice_ty(iter_ty) {
            return self.lower_for_slice(expr, iter_ir, iter_ty);
        }

        // Check if this is a struct with .iter() method (e.g. Vector.iter_mut())
        // If iter_ty is VOID, the method call to get the iterator failed, try .iter() on the original
        if iter_ty.is_void() {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }

        // Create local for the iterator (mutable so .next() works)
        let iter_var_id = self.ctx.id_gen.next_id();
        self.local_types.insert(iter_var_id._value, iter_ty);
        self.local_defs.push(IrLocalDef {
            id: iter_var_id,
            ty: iter_ty,
            name: "_iter",
        });

        // let _iter = iterator_expr
        let let_iter = IrExpr::void_expr(self.ctx.void_ty);
        let_iter.tag = IR_LET;
        let_iter.id = iter_var_id;
        let_iter.ir_ty = iter_ty;
        let_iter.opt_expr = Option::some(iter_ir);
        let ir_let_iter = self.ctx.arena.alloc(let_iter) as &IrExpr;

        // &_iter (for method calls)
        let iter_ref = IrExpr::void_expr(self.ctx.make_ptr_ty(iter_ty, false));
        iter_ref.tag = IR_REF;
        let iter_local = IrExpr::void_expr(iter_ty);
        iter_local.tag = IR_LOCAL;
        iter_local.id = iter_var_id;
        iter_ref.lhs = self.ctx.arena.alloc(iter_local) as &IrExpr;
        let ir_iter_ref = self.ctx.arena.alloc(iter_ref) as &IrExpr;

        // _iter.next() - resolve via method call on the iterator type
        let next_result = self.resolve_method_call_on_type(iter_ty, "next", ir_iter_ref, &[]);

        if next_result.is_none() {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }
        let ir_next_call = next_result.unwrap();
        let opt_ty = ir_next_call.ty; // Option<T>

        // Create local for the option
        let opt_var_id = self.ctx.id_gen.next_id();
        self.local_types.insert(opt_var_id._value, opt_ty);
        self.local_defs.push(IrLocalDef {
            id: opt_var_id,
            ty: opt_ty,
            name: "_opt",
        });

        // let _opt = _iter.next()
        let let_opt = IrExpr::void_expr(self.ctx.void_ty);
        let_opt.tag = IR_LET;
        let_opt.id = opt_var_id;
        let_opt.ir_ty = opt_ty;
        let_opt.opt_expr = Option::some(ir_next_call);
        let ir_let_opt = self.ctx.arena.alloc(let_opt) as &IrExpr;

        // &_opt (for method calls)
        let opt_ref = IrExpr::void_expr(self.ctx.make_ptr_ty(opt_ty, true));
        opt_ref.tag = IR_REF;
        let opt_local = IrExpr::void_expr(opt_ty);
        opt_local.tag = IR_LOCAL;
        opt_local.id = opt_var_id;
        opt_ref.lhs = self.ctx.arena.alloc(opt_local) as &IrExpr;
        let ir_opt_ref = self.ctx.arena.alloc(opt_ref) as &IrExpr;

        // _opt.is_none()
        let is_none_result = self.resolve_method_call_on_type(opt_ty, "is_none", ir_opt_ref, &[]);
        let ir_is_none = if is_none_result.is_some() {
            is_none_result.unwrap()
        } else {
            // Fallback: check _is_some field == false
            let bool_ty = self.ctx.intern_builtin_ty(BuiltinType::Bool);
            let field0 = IrExpr::void_expr(bool_ty);
            field0.tag = IR_FIELD_ACCESS;
            let opt_deref = IrExpr::void_expr(opt_ty);
            opt_deref.tag = IR_LOCAL;
            opt_deref.id = opt_var_id;
            field0.lhs = self.ctx.arena.alloc(opt_deref) as &IrExpr;
            field0.field_idx = 0u32; // _is_some
            let field0_val = self.ctx.arena.alloc(field0) as &IrExpr;
            let not_expr = IrExpr::void_expr(bool_ty);
            not_expr.tag = IR_UNARY;
            not_expr.un_op = UnOp::Not;
            not_expr.lhs = field0_val;
            self.ctx.arena.alloc(not_expr) as &IrExpr
        };

        // break
        let ir_break = IrExpr::void_expr(self.ctx.void_ty);
        ir_break.tag = IR_BREAK;
        let ir_break_val = self.ctx.arena.alloc(ir_break) as &IrExpr;

        // if _opt.is_none() { break; }
        let if_break = IrExpr::void_expr(self.ctx.void_ty);
        if_break.tag = IR_IF;
        if_break.cond = ir_is_none;
        if_break.lhs = ir_break_val;
        let void_else = IrExpr::void_expr(self.ctx.void_ty);
        if_break.rhs = self.ctx.arena.alloc(void_else) as &IrExpr;
        let ir_if_break = self.ctx.arena.alloc(if_break) as &IrExpr;

        // _opt.unwrap() - get the inner value (field 1 of Option)
        // Since Option<T> = { _is_some: bool, _inner: T }, just access field 1
        let elem_ty = if opt_ty.tag == IRTY_STRUCT && opt_ty.struct_ref.fields.len() > 1 {
            opt_ty.struct_ref.fields[1].ty
        } else {
            self.ctx.void_ty
        };
        let unwrap_expr = IrExpr::void_expr(elem_ty);
        unwrap_expr.tag = IR_FIELD_ACCESS;
        let opt_local2 = IrExpr::void_expr(opt_ty);
        opt_local2.tag = IR_LOCAL;
        opt_local2.id = opt_var_id;
        unwrap_expr.lhs = self.ctx.arena.alloc(opt_local2) as &IrExpr;
        unwrap_expr.field_idx = 1u32; // _inner field
        let ir_unwrap = self.ctx.arena.alloc(unwrap_expr) as &IrExpr;

        // let item = _opt.unwrap()
        let loop_var_id = expr.id;
        self.local_types.insert(loop_var_id._value, elem_ty);
        self.local_defs.push(IrLocalDef {
            id: loop_var_id,
            ty: elem_ty,
            name: "",
        });
        let let_item = IrExpr::void_expr(self.ctx.void_ty);
        let_item.tag = IR_LET;
        let_item.id = loop_var_id;
        let_item.ir_ty = elem_ty;
        let_item.opt_expr = Option::some(ir_unwrap);
        let ir_let_item = self.ctx.arena.alloc(let_item) as &IrExpr;

        // Lower the body
        let ir_body = self.lower_expr(expr.rhs);

        // Loop body: { let _opt = _iter.next(); if is_none break; let item = unwrap; body }
        let body_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(4);
        body_stmts[0] = ir_let_opt;
        body_stmts[1] = ir_if_break;
        body_stmts[2] = ir_let_item;
        body_stmts[3] = ir_body;
        let loop_body = IrExpr::void_expr(self.ctx.void_ty);
        loop_body.tag = IR_BLOCK;
        loop_body.items = body_stmts;
        let ir_loop_body = self.ctx.arena.alloc(loop_body) as &IrExpr;

        // loop { ... }
        let loop_expr = IrExpr::void_expr(self.ctx.void_ty);
        loop_expr.tag = IR_LOOP;
        loop_expr.lhs = ir_loop_body;
        let ir_loop = self.ctx.arena.alloc(loop_expr) as &IrExpr;

        // Full block: { let _iter = ...; loop { ... } }
        let block_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(2);
        block_stmts[0] = ir_let_iter;
        block_stmts[1] = ir_loop;
        let block = IrExpr::void_expr(self.ctx.void_ty);
        block.tag = IR_BLOCK;
        block.items = block_stmts;
        self.ctx.arena.alloc(block)
    }

    // ========== Const Evaluator ==========
    // Attempts to evaluate an IR expression to a u64 value at compile time.
    // Returns Option::some(value) if successful, Option::none() if the expression
    // is not const-evaluable. Used for `when` condition evaluation.
    fn try_const_eval_u64(self: &mut Mono, expr: &IrExpr) -> Option<u64> {
        if expr.tag == IR_INT_LIT {
            return Option::some(expr.int_val);
        } else if expr.tag == IR_BOOL_LIT {
            return Option::some(if expr.bool_val { 1u64 } else { 0u64 });
        } else if expr.tag == IR_SIZE_OF {
            // size_of<T>() - compute from type layout
            let sz = self.compute_type_size(expr.ir_ty);
            return Option::some(sz as u64);
        } else if expr.tag == IR_ALIGN_OF {
            let al = self.compute_type_align(expr.ir_ty);
            return Option::some(al as u64);
        } else if expr.tag == IR_CAST {
            // Cast: try to evaluate the inner expression
            return self.try_const_eval_u64(expr.lhs);
        } else if expr.tag == IR_BINARY {
            let lhs_opt = self.try_const_eval_u64(expr.lhs);
            // Short-circuit for && and ||
            if expr.bin_op as i32 == BinOp::And as i32 {
                if lhs_opt.is_some() && lhs_opt.unwrap() == 0u64 {
                    return Option::some(0u64); // false && anything = false
                }
            } else if expr.bin_op as i32 == BinOp::Or as i32 {
                if lhs_opt.is_some() && lhs_opt.unwrap() != 0u64 {
                    return Option::some(1u64); // true || anything = true
                }
            }
            if lhs_opt.is_none() { return Option::none(); }
            let rhs_opt = self.try_const_eval_u64(expr.rhs);
            if rhs_opt.is_none() { return Option::none(); }
            let l = lhs_opt.unwrap();
            let r = rhs_opt.unwrap();
            let result: u64 = switch expr.bin_op {
                BinOp::Add => l + r,
                BinOp::Sub => l - r,
                BinOp::Mul => l * r,
                BinOp::Div => if r != 0u64 { l / r } else { 0u64 },
                BinOp::Rem => if r != 0u64 { l % r } else { 0u64 },
                BinOp::BitAnd => l & r,
                BinOp::BitOr => l | r,
                BinOp::BitXor => l ^ r,
                BinOp::Shl => l << (r as u32),
                BinOp::Shr => l >> (r as u32),
                BinOp::Eq => if l == r { 1u64 } else { 0u64 },
                BinOp::Ne => if l != r { 1u64 } else { 0u64 },
                BinOp::Lt => if l < r { 1u64 } else { 0u64 },
                BinOp::Le => if l <= r { 1u64 } else { 0u64 },
                BinOp::Gt => if l > r { 1u64 } else { 0u64 },
                BinOp::Ge => if l >= r { 1u64 } else { 0u64 },
                BinOp::And => if l != 0u64 && r != 0u64 { 1u64 } else { 0u64 },
                BinOp::Or => if l != 0u64 || r != 0u64 { 1u64 } else { 0u64 },
                _ => { return Option::none(); },
            };
            return Option::some(result);
        } else if expr.tag == IR_UNARY {
            let inner_opt = self.try_const_eval_u64(expr.lhs);
            if inner_opt.is_none() { return Option::none(); }
            let v = inner_opt.unwrap();
            let result: u64 = switch expr.un_op {
                UnOp::Not => if v == 0u64 { 1u64 } else { 0u64 },
                UnOp::Neg => (0u64 - v),
                UnOp::BitNot => ~v,
                _ => { return Option::none(); },
            };
            return Option::some(result);
        } else if expr.tag == IR_BLOCK {
            // Block: evaluate last expression (ignoring side-effecting statements)
            if expr.items.len() > 0 {
                return self.try_const_eval_u64(expr.items[expr.items.len() - 1]);
            }
            return Option::some(0u64);
        } else if expr.tag == IR_VOID {
            return Option::some(0u64);
        } else if expr.tag == IR_CALL {
            // Try to const-evaluate a function call by looking at its monomorphized body
            if expr.call_target.tag == CALL_DIRECT {
                // Find the monomorphized function by mangled name (unique per monomorphization)
                let target_name = expr.call_target.fn_ref.mangled_name;
                for i in 0usize..self.ctx.ir_functions.len() {
                    if self.ctx.ir_functions[i].mangled_name == target_name {
                        if self.ctx.ir_functions[i].body.is_some() {
                            return self.try_const_eval_u64(self.ctx.ir_functions[i].body.unwrap());
                        }
                        break;
                    }
                }
            }
            return Option::none();
        } else if expr.tag == IR_RETURN {
            // return expr - evaluate the inner expression
            return self.try_const_eval_u64(expr.lhs);
        }
        // Not const-evaluable
        Option::none()
    }

    fn try_const_eval_bool(self: &mut Mono, expr: &IrExpr) -> Option<bool> {
        let result = self.try_const_eval_u64(expr);
        if result.is_some() {
            Option::some(result.unwrap() != 0u64)
        } else {
            Option::none()
        }
    }

    // Try to redirect a bodyless protocol method call to the concrete type's impl.
    // For example, when Equatable::not_equals<Point> calls Equatable::equals,
    // we redirect to Point::equals.
    fn try_protocol_redirect(self: &mut Mono, def: &FnDef, type_args: &[&IrTy]) -> Option<usize> {
        // The type args should contain the concrete type (Self parameter of the protocol)
        // Usually the first type arg is the Self type
        if type_args.len() == 0 {
            return Option::none();
        }

        let self_ty = type_args[0];
        let scope_idx: u32 = 0u32;

        // Find the scope for the concrete type
        if self_ty.tag == IRTY_STRUCT {
            scope_idx = self_ty.struct_ref.scope_idx;
        } else if self_ty.tag == IRTY_ENUM {
            scope_idx = self_ty.enum_ref.scope_idx;
        }

        if scope_idx == 0u32 {
            return Option::none();
        }

        // Look up the method name in the concrete type's scope
        let method_item = self.ctx.scopes.get(scope_idx).items.get(&def.name);
        if method_item.is_none() {
            return Option::none();
        }

        let item = method_item.unwrap();
        if item.kind.tag != scope::NIK_FUNCTION && item.kind.tag != scope::NIK_METHOD {
            return Option::none();
        }

        // Found a concrete method - use it instead
        // NIK_METHOD has fn_id in id2, NIK_FUNCTION has it in id
        let fn_id_val = if item.kind.tag == scope::NIK_METHOD {
            item.kind.id2._value
        } else {
            item.kind.id._value
        };
        let concrete_def = self.ctx.fn_defs.get(&fn_id_val);
        if concrete_def.is_none() {
            return Option::none();
        }

        // Don't redirect to ourselves (same function)
        if concrete_def.unwrap().id._value == def.id._value {
            return Option::none();
        }

        // Monomorphize the concrete method
        Option::some(self.mono_function(concrete_def.unwrap(), type_args))
    }

    // Check if a type conforms to a user-defined protocol.
    // A type conforms if it has all the required methods from the protocol.
    fn check_protocol_conformance(self: &mut Mono, ty: &IrTy, proto: &ProtocolDef) -> bool {
        // Get the scope for the type (where its methods live)
        let scope_idx: u32 = 0u32;
        if ty.tag == IRTY_STRUCT {
            scope_idx = ty.struct_ref.scope_idx;
        } else if ty.tag == IRTY_ENUM {
            scope_idx = ty.enum_ref.scope_idx;
        }
        if scope_idx == 0u32 {
            // No scope means no methods - can't conform unless protocol has no methods
            return proto.methods.len() == 0;
        }

        // Check each protocol method exists in the type's scope
        for i in 0usize..proto.methods.len() {
            let method = &proto.methods[i];
            let found = self.ctx.scopes.get(scope_idx).items.get(&method.name);
            if found.is_none() {
                return false;
            }
        }
        true
    }

    // Compute the size of a type in bytes (for const evaluation of size_of)
    fn compute_type_size(self: &mut Mono, ty: &IrTy) -> usize {
        if ty.tag == IRTY_BUILTIN {
            switch ty.builtin {
                BuiltinType::Void => 0usize,
                BuiltinType::Never => 0usize,
                BuiltinType::Bool => 1usize,
                BuiltinType::U8 => 1usize,
                BuiltinType::I8 => 1usize,
                BuiltinType::U16 => 2usize,
                BuiltinType::I16 => 2usize,
                BuiltinType::U32 => 4usize,
                BuiltinType::I32 => 4usize,
                BuiltinType::U64 => 8usize,
                BuiltinType::I64 => 8usize,
                BuiltinType::U128 => 16usize,
                BuiltinType::I128 => 16usize,
                BuiltinType::USize => self.ctx.pointer_size,
                BuiltinType::ISize => self.ctx.pointer_size,
                BuiltinType::F32 => 4usize,
                BuiltinType::F64 => 8usize,
                _ => 0usize,
            }
        } else if ty.tag == IRTY_POINTER {
            self.ctx.pointer_size
        } else if ty.tag == IRTY_FN_POINTER {
            self.ctx.pointer_size
        } else if ty.tag == IRTY_ARRAY {
            let elem_size = self.compute_type_size(ty.inner);
            elem_size * ty.array_size
        } else if ty.tag == IRTY_TUPLE || ty.tag == IRTY_SLICE {
            // Compute struct-like layout
            let size: usize = 0;
            let max_align: usize = 1;
            for i in 0usize..ty.elems.len() {
                let elem_size = self.compute_type_size(ty.elems[i]);
                let elem_align = self.compute_type_align(ty.elems[i]);
                if elem_align > max_align { max_align = elem_align; }
                // Align current offset
                let padding = (elem_align - (size % elem_align)) % elem_align;
                size = size + padding + elem_size;
            }
            // Pad to alignment
            let padding = (max_align - (size % max_align)) % max_align;
            size + padding
        } else if ty.tag == IRTY_STRUCT {
            let size: usize = 0;
            let max_align: usize = 1;
            for i in 0usize..ty.struct_ref.fields.len() {
                let elem_size = self.compute_type_size(ty.struct_ref.fields[i].ty);
                let elem_align = self.compute_type_align(ty.struct_ref.fields[i].ty);
                if elem_align > max_align { max_align = elem_align; }
                let padding = (elem_align - (size % elem_align)) % elem_align;
                size = size + padding + elem_size;
            }
            let padding = (max_align - (size % max_align)) % max_align;
            size + padding
        } else if ty.tag == IRTY_ENUM {
            // Enums are i32-backed in alumina
            4usize
        } else {
            0usize
        }
    }

    // Compute the alignment of a type in bytes
    fn compute_type_align(self: &mut Mono, ty: &IrTy) -> usize {
        if ty.tag == IRTY_BUILTIN {
            let sz = self.compute_type_size(ty);
            if sz > 0usize { sz } else { 1usize }
        } else if ty.tag == IRTY_POINTER || ty.tag == IRTY_FN_POINTER {
            self.ctx.pointer_size
        } else if ty.tag == IRTY_ARRAY {
            self.compute_type_align(ty.inner)
        } else if ty.tag == IRTY_TUPLE || ty.tag == IRTY_SLICE {
            let max_align: usize = 1;
            for i in 0usize..ty.elems.len() {
                let a = self.compute_type_align(ty.elems[i]);
                if a > max_align { max_align = a; }
            }
            max_align
        } else if ty.tag == IRTY_STRUCT {
            let max_align: usize = 1;
            for i in 0usize..ty.struct_ref.fields.len() {
                let a = self.compute_type_align(ty.struct_ref.fields[i].ty);
                if a > max_align { max_align = a; }
            }
            max_align
        } else if ty.tag == IRTY_ENUM {
            4usize
        } else {
            1usize
        }
    }

    // Convert an IR type to a human-readable name string
    fn ir_type_name(self: &mut Mono, ty: &IrTy) -> &[u8] {
        if ty.tag == IRTY_BUILTIN {
            switch ty.builtin {
                BuiltinType::Void => "()",
                BuiltinType::Never => "!",
                BuiltinType::Bool => "bool",
                BuiltinType::U8 => "u8",
                BuiltinType::U16 => "u16",
                BuiltinType::U32 => "u32",
                BuiltinType::U64 => "u64",
                BuiltinType::U128 => "u128",
                BuiltinType::I8 => "i8",
                BuiltinType::I16 => "i16",
                BuiltinType::I32 => "i32",
                BuiltinType::I64 => "i64",
                BuiltinType::I128 => "i128",
                BuiltinType::USize => "usize",
                BuiltinType::ISize => "isize",
                BuiltinType::F32 => "f32",
                BuiltinType::F64 => "f64",
                _ => "<unknown>",
            }
        } else if ty.tag == IRTY_POINTER {
            let inner_name = self.ir_type_name(ty.inner);
            let is_const = ty.is_const;
            let prefix: &[u8] = if is_const { "&" } else { "&mut " };
            let total = prefix.len() + inner_name.len();
            let buf = self.ctx.arena.alloc_slice::<u8>(total);
            prefix.copy_to_nonoverlapping(&buf[0]);
            inner_name.copy_to_nonoverlapping(&buf[prefix.len()]);
            buf as &[u8]
        } else if ty.tag == IRTY_SLICE {
            let elem_ty = if ty.elems.len() > 0 && ty.elems[0].tag == IRTY_POINTER {
                ty.elems[0].inner
            } else { self.ctx.void_ty };
            let inner_name = self.ir_type_name(elem_ty);
            let prefix = "&[";
            let suffix = "]";
            let total = prefix.len() + inner_name.len() + suffix.len();
            let buf = self.ctx.arena.alloc_slice::<u8>(total);
            prefix.copy_to_nonoverlapping(&buf[0]);
            inner_name.copy_to_nonoverlapping(&buf[prefix.len()]);
            suffix.copy_to_nonoverlapping(&buf[prefix.len() + inner_name.len()]);
            buf as &[u8]
        } else if ty.tag == IRTY_ARRAY {
            let inner_name = self.ir_type_name(ty.inner);
            let size_str = format_usize(ty.array_size, self.ctx.arena);
            // "[T; N]"
            let total = 1usize + inner_name.len() + 2usize + size_str.len() + 1usize;
            let buf = self.ctx.arena.alloc_slice::<u8>(total);
            buf[0] = '[' as u8;
            inner_name.copy_to_nonoverlapping(&buf[1]);
            buf[1 + inner_name.len()] = ';' as u8;
            buf[2 + inner_name.len()] = ' ' as u8;
            size_str.copy_to_nonoverlapping(&buf[3 + inner_name.len()]);
            buf[3 + inner_name.len() + size_str.len()] = ']' as u8;
            buf as &[u8]
        } else if ty.tag == IRTY_STRUCT {
            ty.struct_ref.name
        } else if ty.tag == IRTY_ENUM {
            ty.enum_ref.name
        } else if ty.tag == IRTY_TUPLE {
            // Just return "(...)"; full tuple formatting is complex
            "(...)"
        } else if ty.tag == IRTY_FN_POINTER {
            "fn(...)"
        } else if ty.tag == IRTY_VOID {
            "()"
        } else {
            "<unknown>"
        }
    }

    // Lower "when" (static if) expression: evaluate condition at compile time
    fn lower_when(self: &mut Mono, expr: &Expr) -> &IrExpr {
        // Lower the condition expression
        let ir_cond = self.lower_expr(expr.cond);

        // Try to const-evaluate the condition
        let cond_result = self.try_const_eval_bool(ir_cond);
        let cond_val = if cond_result.is_some() {
            cond_result.unwrap()
        } else {
            // Cannot evaluate at compile time - default to false
            false
        };

        if cond_val {
            self.lower_expr(expr.lhs)
        } else {
            if expr.opt_expr.is_some() {
                self.lower_expr(expr.opt_expr.unwrap())
            } else {
                let r = IrExpr::void_expr(self.ctx.void_ty);
                self.ctx.arena.alloc(r)
            }
        }
    }

    // Lower try/? operator: desugar to check + early return
    // For Result<T,E>: { let _r = expr; if _r._is_ok { _r._ok } else { return Result::err(_r._err) } }
    // For Option<T>:   { let _r = expr; if _r._is_some != 0 { _r._inner } else { return Option::none() } }
    fn lower_try(self: &mut Mono, expr: &Expr) -> &IrExpr {
        let inner = self.lower_expr(expr.lhs);
        let inner_ty = inner.ty;

        // Store inner to a local so we only evaluate once
        let tmp_id = self.ctx.id_gen.next_id();
        self.local_types.insert(tmp_id._value, inner_ty);
        self.local_defs.push(IrLocalDef { id: tmp_id, ty: inner_ty, name: "" });

        let ir_let = IrExpr::void_expr(self.ctx.void_ty);
        ir_let.tag = IR_LET;
        ir_let.id = tmp_id;
        ir_let.ir_ty = inner_ty;
        ir_let.opt_expr = Option::some(inner);
        let ir_let_ref = self.ctx.arena.alloc(ir_let);

        // Detect if this is a Result (has _is_ok field) or Option (has _is_some field)
        if inner_ty.tag == IRTY_STRUCT {
            let fields = inner_ty.struct_ref.fields;
            // Check for Result pattern: _is_ok, _ok, _err
            let is_result = false;
            let is_option = false;
            let ok_field_idx: u32 = 0;
            let err_field_idx: u32 = 0;
            let flag_field_idx: u32 = 0;
            let ok_ty = self.ctx.void_ty;
            let err_ty = self.ctx.void_ty;

            for i in 0usize..fields.len() {
                if fields[i].name == "_is_ok" {
                    is_result = true;
                    flag_field_idx = i as u32;
                } else if fields[i].name == "_ok" {
                    ok_field_idx = i as u32;
                    ok_ty = fields[i].ty;
                } else if fields[i].name == "_err" {
                    err_field_idx = i as u32;
                    err_ty = fields[i].ty;
                } else if fields[i].name == "_is_some" {
                    is_option = true;
                    flag_field_idx = i as u32;
                } else if fields[i].name == "_inner" {
                    ok_field_idx = i as u32;
                    ok_ty = fields[i].ty;
                }
            }

            if is_result {
                // Helper: make local ref to tmp
                let tmp_loc1 = IrExpr::void_expr(inner_ty);
                tmp_loc1.tag = IR_LOCAL;
                tmp_loc1.id = tmp_id;
                let tmp_loc2 = IrExpr::void_expr(inner_ty);
                tmp_loc2.tag = IR_LOCAL;
                tmp_loc2.id = tmp_id;
                let tmp_loc3 = IrExpr::void_expr(inner_ty);
                tmp_loc3.tag = IR_LOCAL;
                tmp_loc3.id = tmp_id;

                // condition: tmp._is_ok
                let cond = IrExpr::void_expr(self.ctx.bool_ty);
                cond.tag = IR_FIELD_ACCESS;
                cond.lhs = self.ctx.arena.alloc(tmp_loc1);
                cond.field_idx = flag_field_idx;
                let ir_cond = self.ctx.arena.alloc(cond);

                // then: tmp._ok
                let then_val = IrExpr::void_expr(ok_ty);
                then_val.tag = IR_FIELD_ACCESS;
                then_val.lhs = self.ctx.arena.alloc(tmp_loc2);
                then_val.field_idx = ok_field_idx;
                let ir_then = self.ctx.arena.alloc(then_val);

                // else: return Result::err(tmp._err)
                let err_val = IrExpr::void_expr(err_ty);
                err_val.tag = IR_FIELD_ACCESS;
                err_val.lhs = self.ctx.arena.alloc(tmp_loc3);
                err_val.field_idx = err_field_idx;
                let ir_err_val = self.ctx.arena.alloc(err_val);

                // Build the return Result struct
                let ret_result = self.build_result_err(self.return_type, ir_err_val, err_ty);

                let ir_return = IrExpr::void_expr(self.ctx.never_ty);
                ir_return.tag = IR_RETURN;
                ir_return.opt_expr = Option::some(ret_result);
                let ir_return_ref: &IrExpr = self.ctx.arena.alloc(ir_return) as &IrExpr;

                // Build if expression
                let ir_if = IrExpr::void_expr(ok_ty);
                ir_if.tag = IR_IF;
                ir_if.cond = ir_cond;
                ir_if.lhs = ir_then;
                ir_if.opt_expr = Option::some(ir_return_ref);
                let ir_if_ref = self.ctx.arena.alloc(ir_if);

                // Block: { let _r = expr; if ... }
                let stmts = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                stmts[0] = ir_let_ref;
                stmts[1] = ir_if_ref;
                let block = IrExpr::void_expr(ok_ty);
                block.tag = IR_BLOCK;
                block.items = stmts;
                return self.ctx.arena.alloc(block);
            } else if is_option {
                let tmp_loc1 = IrExpr::void_expr(inner_ty);
                tmp_loc1.tag = IR_LOCAL;
                tmp_loc1.id = tmp_id;
                let tmp_loc2 = IrExpr::void_expr(inner_ty);
                tmp_loc2.tag = IR_LOCAL;
                tmp_loc2.id = tmp_id;

                // condition: tmp._is_some (bool) or tmp._is_some != 0 (integer)
                let flag_ty = fields[flag_field_idx as usize].ty;
                let flag_acc = IrExpr::void_expr(flag_ty);
                flag_acc.tag = IR_FIELD_ACCESS;
                flag_acc.lhs = self.ctx.arena.alloc(tmp_loc1);
                flag_acc.field_idx = flag_field_idx;
                let ir_flag = self.ctx.arena.alloc(flag_acc);

                let ir_cond: &IrExpr = if flag_ty == self.ctx.bool_ty {
                    // Bool field: use directly as condition
                    ir_flag
                } else {
                    // Integer field: compare != 0
                    let zero_lit = IrExpr::void_expr(flag_ty);
                    zero_lit.tag = IR_INT_LIT;
                    zero_lit.int_val = 0u64;
                    let ir_zero = self.ctx.arena.alloc(zero_lit);

                    let cond = IrExpr::void_expr(self.ctx.bool_ty);
                    cond.tag = IR_BINARY;
                    cond.bin_op = BinOp::Ne;
                    cond.lhs = ir_flag;
                    cond.rhs = ir_zero;
                    self.ctx.arena.alloc(cond)
                };

                // then: tmp._inner
                let then_val = IrExpr::void_expr(ok_ty);
                then_val.tag = IR_FIELD_ACCESS;
                then_val.lhs = self.ctx.arena.alloc(tmp_loc2);
                then_val.field_idx = ok_field_idx;
                let ir_then = self.ctx.arena.alloc(then_val);

                // else: return Option::none() (zeroed)
                let ret_none = IrExpr::void_expr(self.return_type);
                ret_none.tag = IR_ZEROED;
                let ir_none: &IrExpr = self.ctx.arena.alloc(ret_none) as &IrExpr;

                let ir_return = IrExpr::void_expr(self.ctx.never_ty);
                ir_return.tag = IR_RETURN;
                ir_return.opt_expr = Option::some(ir_none);
                let ir_return_ref: &IrExpr = self.ctx.arena.alloc(ir_return) as &IrExpr;

                // Build if expression
                let ir_if = IrExpr::void_expr(ok_ty);
                ir_if.tag = IR_IF;
                ir_if.cond = ir_cond;
                ir_if.lhs = ir_then;
                ir_if.opt_expr = Option::some(ir_return_ref);
                let ir_if_ref = self.ctx.arena.alloc(ir_if);

                // Block: { let _r = expr; if ... }
                let stmts = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                stmts[0] = ir_let_ref;
                stmts[1] = ir_if_ref;
                let block = IrExpr::void_expr(ok_ty);
                block.tag = IR_BLOCK;
                block.items = stmts;
                return self.ctx.arena.alloc(block);
            }
        }
        // Fallback: just return inner (shouldn't happen)
        inner
    }

    // Build a Result::err(err_val) struct literal
    fn build_result_err(self: &mut Mono, result_ty: &IrTy, err_val: &IrExpr, err_ty: &IrTy) -> &IrExpr {
        // Build a zeroed struct, then set _is_ok=false and _err=err_val
        if result_ty.tag == IRTY_STRUCT {
            let fields = result_ty.struct_ref.fields;
            let field_vals = self.ctx.arena.alloc_slice::<&IrExpr>(fields.len());
            for i in 0usize..fields.len() {
                if fields[i].name == "_is_ok" {
                    let f = IrExpr::void_expr(fields[i].ty);
                    f.tag = IR_BOOL_LIT;
                    f.bool_val = false;
                    field_vals[i] = self.ctx.arena.alloc(f);
                } else if fields[i].name == "_err" {
                    field_vals[i] = err_val;
                } else {
                    let f = IrExpr::void_expr(fields[i].ty);
                    f.tag = IR_ZEROED;
                    field_vals[i] = self.ctx.arena.alloc(f);
                }
            }
            let lit = IrExpr::void_expr(result_ty);
            lit.tag = IR_STRUCT_LIT;
            lit.items = field_vals;
            self.ctx.arena.alloc(lit)
        } else {
            // Fallback: zeroed
            let z = IrExpr::void_expr(result_ty);
            z.tag = IR_ZEROED;
            self.ctx.arena.alloc(z)
        }
    }

    // Lower static_for: compile-time loop unrolling over tuple elements
    // static for v in tuple { body }
    fn lower_static_for(self: &mut Mono, expr: &Expr) -> &IrExpr {
        let iter_ir = self.lower_expr(expr.lhs);
        let iter_ty = iter_ir.ty;

        // Get element count from tuple/array type
        let count: usize = 0;
        if iter_ty.tag == IRTY_TUPLE {
            count = iter_ty.elems.len();
        } else if iter_ty.tag == IRTY_ARRAY {
            count = iter_ty.array_size;
        }

        if count == 0 {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }

        // Store the iterator value in a temp local
        let iter_id = self.ctx.id_gen.next_id();
        self.local_types.insert(iter_id._value, iter_ty);
        self.local_defs.push(IrLocalDef { id: iter_id, ty: iter_ty, name: "" });

        let ir_let_iter = IrExpr::void_expr(self.ctx.void_ty);
        ir_let_iter.tag = IR_LET;
        ir_let_iter.id = iter_id;
        ir_let_iter.ir_ty = iter_ty;
        ir_let_iter.opt_expr = Option::some(iter_ir);
        let ir_let_ref = self.ctx.arena.alloc(ir_let_iter);

        // Unroll: for each element, bind the loop variable and lower the body
        // +1 for the let statement
        let stmts = self.ctx.arena.alloc_slice::<&IrExpr>(count + 1);
        stmts[0] = ir_let_ref;

        for i in 0usize..count {
            let elem_ty = if iter_ty.tag == IRTY_TUPLE {
                iter_ty.elems[i]
            } else {
                iter_ty.inner // array element type
            };

            // Access element: iter_local.i (tuple index)
            let iter_local = IrExpr::void_expr(iter_ty);
            iter_local.tag = IR_LOCAL;
            iter_local.id = iter_id;
            let ir_iter_local = self.ctx.arena.alloc(iter_local);

            let elem_access = IrExpr::void_expr(elem_ty);
            elem_access.tag = IR_FIELD_ACCESS;
            elem_access.lhs = ir_iter_local;
            elem_access.field_idx = i as u32;
            let ir_elem: &IrExpr = self.ctx.arena.alloc(elem_access) as &IrExpr;

            // Bind loop variable (expr.id) to this element
            let var_id = expr.id;
            self.local_types.insert(var_id._value, elem_ty);
            self.local_defs.push(IrLocalDef { id: var_id, ty: elem_ty, name: "" });

            let ir_let_var = IrExpr::void_expr(self.ctx.void_ty);
            ir_let_var.tag = IR_LET;
            ir_let_var.id = var_id;
            ir_let_var.ir_ty = elem_ty;
            ir_let_var.opt_expr = Option::some(ir_elem);
            let ir_let_var_ref = self.ctx.arena.alloc(ir_let_var);

            // Lower the body with this binding
            let body_ir = self.lower_expr(expr.rhs);

            // Create a block for this iteration: { let v = elem; body }
            let iter_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(2);
            iter_stmts[0] = ir_let_var_ref;
            iter_stmts[1] = body_ir;
            let iter_block = IrExpr::void_expr(self.ctx.void_ty);
            iter_block.tag = IR_BLOCK;
            iter_block.items = iter_stmts;
            stmts[i + 1] = self.ctx.arena.alloc(iter_block);
        }

        let block = IrExpr::void_expr(self.ctx.void_ty);
        block.tag = IR_BLOCK;
        block.items = stmts;
        self.ctx.arena.alloc(block)
    }

    // Lower a for-in loop over a slice: for item in slice { body }
    // Desugar to: { let _s = slice; let _i = 0usize; let _end = _s.len; while _i < _end { let item = _s[_i]; body; _i = _i + 1; } }
    fn lower_for_slice(self: &mut Mono, expr: &Expr, slice_ir: &IrExpr, slice_ty: &IrTy) -> &IrExpr {
        let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
        let bool_ty = self.ctx.intern_builtin_ty(BuiltinType::Bool);

        // Get element type from slice
        let elem_ty = if slice_ty.tag == IRTY_SLICE {
            slice_ty.inner
        } else {
            // TUPLE representation: {&T, usize}
            slice_ty.elems[0].inner
        };

        // let _s = slice
        let slice_var_id = self.ctx.id_gen.next_id();
        self.local_types.insert(slice_var_id._value, slice_ty);
        self.local_defs.push(IrLocalDef { id: slice_var_id, ty: slice_ty, name: "_s" });
        let let_s = IrExpr::void_expr(self.ctx.void_ty);
        let_s.tag = IR_LET;
        let_s.id = slice_var_id;
        let_s.ir_ty = slice_ty;
        let_s.opt_expr = Option::some(slice_ir);
        let ir_let_s = self.ctx.arena.alloc(let_s) as &IrExpr;

        // let _i = 0usize
        let idx_var_id = self.ctx.id_gen.next_id();
        self.local_types.insert(idx_var_id._value, usize_ty);
        self.local_defs.push(IrLocalDef { id: idx_var_id, ty: usize_ty, name: "_i" });
        let zero = IrExpr::void_expr(usize_ty);
        zero.tag = IR_INT_LIT;
        zero.int_val = 0;
        let ir_zero = self.ctx.arena.alloc(zero) as &IrExpr;
        let let_i = IrExpr::void_expr(self.ctx.void_ty);
        let_i.tag = IR_LET;
        let_i.id = idx_var_id;
        let_i.ir_ty = usize_ty;
        let_i.opt_expr = Option::some(ir_zero);
        let ir_let_i = self.ctx.arena.alloc(let_i) as &IrExpr;

        // let _end = _s.len (field 1 of slice)
        let end_var_id = self.ctx.id_gen.next_id();
        self.local_types.insert(end_var_id._value, usize_ty);
        self.local_defs.push(IrLocalDef { id: end_var_id, ty: usize_ty, name: "_end" });
        let slice_local = IrExpr::void_expr(slice_ty);
        slice_local.tag = IR_LOCAL;
        slice_local.id = slice_var_id;
        let len_access = IrExpr::void_expr(usize_ty);
        len_access.tag = IR_FIELD_ACCESS;
        len_access.lhs = self.ctx.arena.alloc(slice_local) as &IrExpr;
        len_access.field_idx = 1u32;
        let ir_len = self.ctx.arena.alloc(len_access) as &IrExpr;
        let let_end = IrExpr::void_expr(self.ctx.void_ty);
        let_end.tag = IR_LET;
        let_end.id = end_var_id;
        let_end.ir_ty = usize_ty;
        let_end.opt_expr = Option::some(ir_len);
        let ir_let_end = self.ctx.arena.alloc(let_end) as &IrExpr;

        // _i < _end
        let read_i = IrExpr::void_expr(usize_ty);
        read_i.tag = IR_LOCAL;
        read_i.id = idx_var_id;
        let ir_read_i = self.ctx.arena.alloc(read_i) as &IrExpr;
        let read_end = IrExpr::void_expr(usize_ty);
        read_end.tag = IR_LOCAL;
        read_end.id = end_var_id;
        let ir_read_end = self.ctx.arena.alloc(read_end) as &IrExpr;
        let cond = IrExpr::void_expr(bool_ty);
        cond.tag = IR_BINARY;
        cond.bin_op = BinOp::Lt;
        cond.lhs = ir_read_i;
        cond.rhs = ir_read_end;
        let ir_cond = self.ctx.arena.alloc(cond) as &IrExpr;

        // _s[_i] - slice indexing: get data pointer (field 0), then index
        let slice_local2 = IrExpr::void_expr(slice_ty);
        slice_local2.tag = IR_LOCAL;
        slice_local2.id = slice_var_id;
        let ptr_ty = self.ctx.make_ptr_ty(elem_ty, slice_ty.is_const);
        let data_ptr = IrExpr::void_expr(ptr_ty);
        data_ptr.tag = IR_FIELD_ACCESS;
        data_ptr.lhs = self.ctx.arena.alloc(slice_local2) as &IrExpr;
        data_ptr.field_idx = 0u32;
        let ir_data_ptr = self.ctx.arena.alloc(data_ptr) as &IrExpr;
        let read_i2 = IrExpr::void_expr(usize_ty);
        read_i2.tag = IR_LOCAL;
        read_i2.id = idx_var_id;
        let ir_read_i2 = self.ctx.arena.alloc(read_i2) as &IrExpr;
        let index_expr = IrExpr::void_expr(elem_ty);
        index_expr.tag = IR_INDEX;
        index_expr.lhs = ir_data_ptr;
        index_expr.rhs = ir_read_i2;
        let ir_index = self.ctx.arena.alloc(index_expr) as &IrExpr;

        // let item = _s[_i]
        let loop_var_id = expr.id;
        self.local_types.insert(loop_var_id._value, elem_ty);
        self.local_defs.push(IrLocalDef { id: loop_var_id, ty: elem_ty, name: "" });
        let let_item = IrExpr::void_expr(self.ctx.void_ty);
        let_item.tag = IR_LET;
        let_item.id = loop_var_id;
        let_item.ir_ty = elem_ty;
        let_item.opt_expr = Option::some(ir_index);
        let ir_let_item = self.ctx.arena.alloc(let_item) as &IrExpr;

        // body
        let ir_body = self.lower_expr(expr.rhs);

        // _i = _i + 1
        let read_i3 = IrExpr::void_expr(usize_ty);
        read_i3.tag = IR_LOCAL;
        read_i3.id = idx_var_id;
        let ir_read_i3 = self.ctx.arena.alloc(read_i3) as &IrExpr;
        let one = IrExpr::void_expr(usize_ty);
        one.tag = IR_INT_LIT;
        one.int_val = 1;
        let ir_one = self.ctx.arena.alloc(one) as &IrExpr;
        let add = IrExpr::void_expr(usize_ty);
        add.tag = IR_BINARY;
        add.bin_op = BinOp::Add;
        add.lhs = ir_read_i3;
        add.rhs = ir_one;
        let ir_add = self.ctx.arena.alloc(add) as &IrExpr;
        let read_i4 = IrExpr::void_expr(usize_ty);
        read_i4.tag = IR_LOCAL;
        read_i4.id = idx_var_id;
        let ir_read_i4 = self.ctx.arena.alloc(read_i4) as &IrExpr;
        let assign_i = IrExpr::void_expr(self.ctx.void_ty);
        assign_i.tag = IR_ASSIGN;
        assign_i.lhs = ir_read_i4;
        assign_i.rhs = ir_add;
        let ir_assign_i = self.ctx.arena.alloc(assign_i) as &IrExpr;

        // while body: { let item = _s[_i]; body; _i = _i + 1; }
        let while_body_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(3);
        while_body_stmts[0] = ir_let_item;
        while_body_stmts[1] = ir_body;
        while_body_stmts[2] = ir_assign_i;
        let while_body = IrExpr::void_expr(self.ctx.void_ty);
        while_body.tag = IR_BLOCK;
        while_body.items = while_body_stmts;
        let ir_while_body = self.ctx.arena.alloc(while_body) as &IrExpr;

        // while _i < _end { ... }
        let while_expr = IrExpr::void_expr(self.ctx.void_ty);
        while_expr.tag = IR_WHILE;
        while_expr.cond = ir_cond;
        while_expr.lhs = ir_while_body;
        let ir_while = self.ctx.arena.alloc(while_expr) as &IrExpr;

        // Full block: { let _s = ...; let _i = 0; let _end = _s.len; while ... }
        let block_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(4);
        block_stmts[0] = ir_let_s;
        block_stmts[1] = ir_let_i;
        block_stmts[2] = ir_let_end;
        block_stmts[3] = ir_while;
        let block = IrExpr::void_expr(self.ctx.void_ty);
        block.tag = IR_BLOCK;
        block.items = block_stmts;
        self.ctx.arena.alloc(block)
    }

    // Resolve a method call on a known IR type, returning the call result
    fn resolve_method_call_on_type(self: &mut Mono, ty: &IrTy, method_name: &[u8], self_arg: &IrExpr, args: &[&IrExpr]) -> Option<&IrExpr> {
        let resolved_ty = ty;
        if resolved_ty.tag == IRTY_POINTER {
            resolved_ty = resolved_ty.inner;
        }
        let scope_idx: u32 = 0u32;
        let method_type_args: &[&IrTy] = &[];
        if resolved_ty.tag == IRTY_STRUCT {
            scope_idx = resolved_ty.struct_ref.scope_idx;
            method_type_args = resolved_ty.struct_ref.type_args;
        } else if resolved_ty.tag == IRTY_ENUM {
            scope_idx = resolved_ty.enum_ref.scope_idx;
        }
        if scope_idx == 0u32 {
            return Option::none();
        }

        let method_item = self.ctx.scopes.get(scope_idx).items.get(&method_name);
        if method_item.is_none() {
            return Option::none();
        }
        let item = method_item.unwrap();

        let fn_id = if item.kind.tag == NIK_FUNCTION {
            item.kind.id
        } else if item.kind.tag == NIK_METHOD {
            item.kind.id2
        } else {
            return Option::none();
        };

        let fn_def = self.ctx.fn_defs.get(&fn_id._value);
        if fn_def.is_none() {
            return Option::none();
        }
        let def = fn_def.unwrap();

        // Merge generic type args from the struct + method
        let all_type_args = method_type_args;

        let fn_idx = self.mono_function(def, all_type_args);
        let ir_fn = &self.ctx.ir_functions[fn_idx];

        // Build call args: self_arg + args
        let call_args = self.ctx.arena.alloc_slice::<&IrExpr>(1 + args.len());
        call_args[0] = self_arg;
        for i in 0usize..args.len() {
            call_args[1 + i] = args[i];
        }

        let fn_ref = IrFnRef {
            id: ir_fn.id,
            mangled_name: ir_fn.mangled_name,
        };
        let result = IrExpr::void_expr(ir_fn.return_type);
        result.tag = IR_CALL;
        result.call_target = IrCallTarget { tag: CALL_DIRECT, fn_ref: fn_ref, callee: std::mem::zeroed::<&IrExpr>() };
        result.items = call_args;
        Option::some(self.ctx.arena.alloc(result) as &IrExpr)
    }

    // Lower memory operations: EXPR_REF, EXPR_DEREF, EXPR_FIELD_ACCESS, EXPR_TUPLE_INDEX, EXPR_INDEX, EXPR_CAST, EXPR_TYPE_CHECK
    fn lower_memory(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_REF {
            let ir_inner = self.lower_expr(expr.lhs);
            let ptr_ty = self.ctx.make_ptr_ty(ir_inner.ty, !expr.flag);
            let result = IrExpr::void_expr(ptr_ty);
            result.tag = IR_REF;
            result.lhs = ir_inner;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_DEREF {
            let ir_inner = self.lower_expr(expr.lhs);
            let pointee_ty = if ir_inner.ty.tag == IRTY_POINTER {
                ir_inner.ty.inner
            } else {
                self.ctx.void_ty
            };
            let result = IrExpr::void_expr(pointee_ty);
            result.tag = IR_DEREF;
            result.lhs = ir_inner;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_FIELD_ACCESS {
            let ir_obj = self.lower_expr(expr.lhs);
            // Auto-deref through pointers for field access
            let actual_obj = ir_obj;
            loop {
                if actual_obj.ty.tag != IRTY_POINTER {
                    break;
                }
                let deref_ty = actual_obj.ty.inner;
                let deref_expr = IrExpr::void_expr(deref_ty);
                deref_expr.tag = IR_DEREF;
                deref_expr.lhs = actual_obj;
                actual_obj = self.ctx.arena.alloc(deref_expr);
            }
            // Find field index on the dereferenced struct type
            let (field_idx, field_ty) = self.resolve_field(actual_obj.ty, expr.str_val);
            let result = IrExpr::void_expr(field_ty);
            result.tag = IR_FIELD_ACCESS;
            result.lhs = actual_obj;
            result.field_idx = field_idx;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_TUPLE_INDEX {
            let ir_obj = self.lower_expr(expr.lhs);
            let elem_ty = if ir_obj.ty.tag == IRTY_TUPLE {
                if expr.index_val < ir_obj.ty.elems.len() { ir_obj.ty.elems[expr.index_val] } else { self.ctx.void_ty }
            } else if ir_obj.ty.tag == IRTY_STRUCT && !ir_obj.ty.struct_ref.is_zero_sized {
                // Tuples of non-trivial types may be lowered as anonymous structs
                if expr.index_val < ir_obj.ty.struct_ref.fields.len() {
                    ir_obj.ty.struct_ref.fields[expr.index_val].ty
                } else {
                    self.ctx.void_ty
                }
            } else {
                self.ctx.void_ty
            };
            let result = IrExpr::void_expr(elem_ty);
            result.tag = IR_FIELD_ACCESS;
            result.lhs = ir_obj;
            result.field_idx = expr.index_val as u32;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_INDEX {
            let ir_base = self.lower_expr(expr.lhs);

            // Check for range indexing (sub-slicing): data[a..b] or data[n..]
            if expr.rhs.tag == EXPR_RANGE {
                return self.lower_subslice(ir_base, expr.rhs);
            }

            let ir_index = self.lower_expr(expr.rhs);

            // Handle slice indexing: extract data pointer, then index
            if self.is_slice_ty(ir_base.ty) {
                let elem_ty = self.slice_elem_ty(ir_base.ty);
                // Extract the data pointer (field 0 of the fat pointer tuple)
                let data_ptr_ty = if ir_base.ty.tag == IRTY_SLICE {
                    // IRTY_SLICE: data pointer is &elem_ty
                    self.ctx.make_ptr_ty(elem_ty, false)
                } else {
                    // IRTY_TUPLE {&T, usize}: element 0 is the pointer
                    ir_base.ty.elems[0]
                };
                let data_ptr = IrExpr::void_expr(data_ptr_ty);
                data_ptr.tag = IR_FIELD_ACCESS;
                data_ptr.lhs = ir_base;
                data_ptr.field_idx = 0u32;
                let data_ptr_ref = self.ctx.arena.alloc(data_ptr);
                // Index into the data pointer
                let result = IrExpr::void_expr(elem_ty);
                result.tag = IR_INDEX;
                result.lhs = data_ptr_ref;
                result.rhs = ir_index;
                return self.ctx.arena.alloc(result);
            }

            // For struct types (e.g. Vector), try to find a slice-typed field
            // and index through it (similar to auto-borrow/slicify in alumina-boot)
            if ir_base.ty.tag == IRTY_STRUCT {
                let sr = ir_base.ty.struct_ref;
                for fi in 0usize..sr.fields.len() {
                    if self.is_slice_ty(sr.fields[fi].ty) {
                        // Extract the slice field
                        let slice_field = IrExpr::void_expr(sr.fields[fi].ty);
                        slice_field.tag = IR_FIELD_ACCESS;
                        slice_field.lhs = ir_base;
                        slice_field.field_idx = fi as u32;
                        let slice_ref = self.ctx.arena.alloc(slice_field);
                        // Index through the slice
                        let sf_elem_ty = self.slice_elem_ty(sr.fields[fi].ty);
                        let sf_data_ptr_ty = if sr.fields[fi].ty.tag == IRTY_SLICE {
                            self.ctx.make_ptr_ty(sf_elem_ty, false)
                        } else {
                            sr.fields[fi].ty.elems[0]
                        };
                        let sf_data_ptr = IrExpr::void_expr(sf_data_ptr_ty);
                        sf_data_ptr.tag = IR_FIELD_ACCESS;
                        sf_data_ptr.lhs = slice_ref;
                        sf_data_ptr.field_idx = 0u32;
                        let sf_data_ptr_ref = self.ctx.arena.alloc(sf_data_ptr);
                        let sf_result = IrExpr::void_expr(sf_elem_ty);
                        sf_result.tag = IR_INDEX;
                        sf_result.lhs = sf_data_ptr_ref;
                        sf_result.rhs = ir_index;
                        return self.ctx.arena.alloc(sf_result);
                    }
                }
            }

            let elem_ty = if ir_base.ty.tag == IRTY_ARRAY {
                ir_base.ty.inner
            } else if ir_base.ty.tag == IRTY_POINTER {
                ir_base.ty.inner
            } else {
                self.ctx.void_ty
            };
            let result = IrExpr::void_expr(elem_ty);
            result.tag = IR_INDEX;
            result.lhs = ir_base;
            result.rhs = ir_index;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_CAST {
            let ir_inner = self.lower_expr(expr.lhs);
            let ir_ty = self.resolve_type(expr.ty);
            let result = IrExpr::void_expr(ir_ty);
            result.tag = IR_CAST;
            result.lhs = ir_inner;
            result.ir_ty = ir_ty;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_TYPE_CHECK {
            // "expr is Protocol" - protocol conformance check
            // Evaluate at compile time when possible
            let ir_val = self.lower_expr(expr.lhs);
            let bool_ty = self.ctx.intern_builtin_ty(BuiltinType::Bool);
            let val_ty = ir_val.ty;

            // Check for ZeroSized protocol: type is ZST if it has no runtime representation
            let check_ty = expr.ty; // The protocol type (TY_NAMED)
            let is_match = false;

            // Resolve the protocol name to check specific protocols
            // Extract protocol ID from TY_NAMED or TY_GENERIC(TY_NAMED)
            let proto_id_value: usize = 0usize;
            let has_proto_id = false;
            if check_ty.tag == TY_NAMED {
                proto_id_value = check_ty.id._value;
                has_proto_id = true;
            } else if check_ty.tag == TY_GENERIC && check_ty.inner.tag == TY_NAMED {
                proto_id_value = check_ty.inner.id._value;
                has_proto_id = true;
            }
            if has_proto_id {
                let protocol = self.ctx.protocol_defs.get(&proto_id_value);
                if protocol.is_some() {
                    let proto = protocol.unwrap();
                    if proto.name == "ZeroSized" {
                        is_match = val_ty.is_zero_sized();
                    } else if proto.name == "Pointer" {
                        is_match = val_ty.tag == IRTY_POINTER;
                    } else if proto.name == "Primitive" {
                        is_match = val_ty.tag == IRTY_BUILTIN;
                    } else if proto.name == "Numeric" || proto.name == "Integer" || proto.name == "FloatingPoint" || proto.name == "Signed" || proto.name == "Unsigned" {
                        if val_ty.tag == IRTY_BUILTIN {
                            if proto.name == "Numeric" {
                                is_match = val_ty.builtin != BuiltinType::Bool && val_ty.builtin != BuiltinType::Void;
                            } else if proto.name == "Integer" {
                                is_match = val_ty.builtin != BuiltinType::Bool && val_ty.builtin != BuiltinType::Void && val_ty.builtin != BuiltinType::F32 && val_ty.builtin != BuiltinType::F64;
                            } else if proto.name == "FloatingPoint" {
                                is_match = val_ty.builtin == BuiltinType::F32 || val_ty.builtin == BuiltinType::F64;
                            } else if proto.name == "Signed" {
                                is_match = val_ty.builtin == BuiltinType::I8 || val_ty.builtin == BuiltinType::I16 || val_ty.builtin == BuiltinType::I32 || val_ty.builtin == BuiltinType::I64 || val_ty.builtin == BuiltinType::I128 || val_ty.builtin == BuiltinType::ISize;
                            } else if proto.name == "Unsigned" {
                                is_match = val_ty.builtin == BuiltinType::U8 || val_ty.builtin == BuiltinType::U16 || val_ty.builtin == BuiltinType::U32 || val_ty.builtin == BuiltinType::U64 || val_ty.builtin == BuiltinType::U128 || val_ty.builtin == BuiltinType::USize;
                            }
                        } else if proto.name == "Numeric" || proto.name == "FloatingPoint" {
                            is_match = false;
                        }
                    } else if proto.name == "Struct" {
                        is_match = val_ty.tag == IRTY_STRUCT;
                    } else if proto.name == "Enum" {
                        is_match = val_ty.tag == IRTY_ENUM;
                    } else if proto.name == "Array" {
                        is_match = val_ty.tag == IRTY_ARRAY;
                    } else {
                        // User-defined protocol: check if type has all required methods
                        is_match = self.check_protocol_conformance(val_ty, proto);
                    }
                } else {
                    // Not a protocol - concrete type comparison
                    let check_ir_ty = self.resolve_type(check_ty);
                    is_match = val_ty as &void == check_ir_ty as &void;
                }
            } else {
                // Non-named type: resolve and compare
                let check_ir_ty = self.resolve_type(check_ty);
                is_match = val_ty as &void == check_ir_ty as &void;
            }

            let result = IrExpr::void_expr(bool_ty);
            result.tag = IR_BOOL_LIT;
            result.bool_val = is_match;
            self.ctx.arena.alloc(result)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Coerce a value to a target type (e.g., pointer-to-array → slice)
    fn coerce_to_type(self: &mut Mono, val: &IrExpr, target_ty: &IrTy) -> &IrExpr {
        // Coerce &[T; N] to &[T] (pointer to array → slice fat pointer)
        if self.is_slice_ty(target_ty) && val.ty.tag == IRTY_POINTER && val.ty.inner.tag == IRTY_ARRAY {
            let array_ty = val.ty.inner;
            let elem_ty = array_ty.inner;
            let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);

            // Data pointer: cast the array pointer to element pointer
            let data_ptr_ty = self.ctx.make_ptr_ty(elem_ty, false);
            let data_ptr = IrExpr::void_expr(data_ptr_ty);
            data_ptr.tag = IR_CAST;
            data_ptr.lhs = val;
            data_ptr.ir_ty = data_ptr_ty;
            let data_ptr_ref = self.ctx.arena.alloc(data_ptr);

            // Length: array size as usize literal
            let len_expr = IrExpr::void_expr(usize_ty);
            len_expr.tag = IR_INT_LIT;
            len_expr.int_val = array_ty.array_size as u64;
            let len_ref = self.ctx.arena.alloc(len_expr);

            // Build tuple {data_ptr, len}
            let items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
            items[0] = data_ptr_ref;
            items[1] = len_ref;
            let tuple_result = IrExpr::void_expr(target_ty);
            tuple_result.tag = IR_TUPLE_LIT;
            tuple_result.items = items;
            return self.ctx.arena.alloc(tuple_result);
        }
        // No coercion needed
        val
    }

    // Check if a type is a slice


    fn is_slice_ty(self: &Mono, ty: &IrTy) -> bool {
        if ty.tag == IRTY_SLICE { return true; }
        // Also detect tuples that look like slices (legacy representation)
        if ty.tag == IRTY_TUPLE && ty.elems.len() == 2 {
            return ty.elems[0].tag == IRTY_POINTER;
        }
        false
    }

    // Get the element type of a slice
    fn slice_elem_ty(self: &Mono, ty: &IrTy) -> &IrTy {
        if ty.tag == IRTY_SLICE {
            // IRTY_SLICE stores element type in inner directly
            ty.inner
        } else {
            // IRTY_TUPLE representation: {&T, usize}, elem type is pointer's inner type
            ty.elems[0].inner
        }
    }

    // Lower sub-slice indexing: data[a..b], data[n..], data[..m]
    // Lower ptr[a..b] on a raw pointer - creates a new slice {ptr+a, b-a}
    fn lower_ptr_subslice(self: &mut Mono, base: &IrExpr, range_expr: &Expr) -> &IrExpr {
        let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
        let elem_ty = base.ty.inner;
        let slice_ty = self.ctx.make_slice_ty(elem_ty, base.ty.is_const);

        // Start offset (default 0)
        let ir_start = if range_expr.lhs as usize != 0 {
            let raw = self.lower_expr(range_expr.lhs);
            if raw.ty.tag != usize_ty.tag || raw.ty.builtin != usize_ty.builtin {
                let cast = IrExpr::void_expr(usize_ty);
                cast.tag = IR_CAST;
                cast.lhs = raw;
                self.ctx.arena.alloc(cast) as &IrExpr
            } else { raw }
        } else {
            let zero = IrExpr::void_expr(usize_ty);
            zero.tag = IR_INT_LIT;
            zero.int_val = 0;
            self.ctx.arena.alloc(zero) as &IrExpr
        };

        // End offset
        let ir_end = if range_expr.rhs as usize != 0 {
            let raw = self.lower_expr(range_expr.rhs);
            if raw.ty.tag != usize_ty.tag || raw.ty.builtin != usize_ty.builtin {
                let cast = IrExpr::void_expr(usize_ty);
                cast.tag = IR_CAST;
                cast.lhs = raw;
                self.ctx.arena.alloc(cast) as &IrExpr
            } else { raw }
        } else {
            // No end bound - this is unusual for ptr slicing, return void
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        };

        // new_ptr = base + start (via index then ref, same pattern as lower_subslice)
        let new_ptr_idx = IrExpr::void_expr(base.ty);
        new_ptr_idx.tag = IR_INDEX;
        new_ptr_idx.lhs = base;
        new_ptr_idx.rhs = ir_start;
        let ir_new_ptr_idx = self.ctx.arena.alloc(new_ptr_idx) as &IrExpr;
        // Take reference to get pointer
        let new_ptr_ref = IrExpr::void_expr(base.ty);
        new_ptr_ref.tag = IR_REF;
        new_ptr_ref.lhs = ir_new_ptr_idx;
        let ir_new_ptr = self.ctx.arena.alloc(new_ptr_ref) as &IrExpr;

        // new_len = end - start
        let new_len = IrExpr::void_expr(usize_ty);
        new_len.tag = IR_BINARY;
        new_len.bin_op = BinOp::Sub;
        new_len.lhs = ir_end;
        new_len.rhs = ir_start;
        let ir_new_len = self.ctx.arena.alloc(new_len) as &IrExpr;

        // Build tuple {ptr, len}
        let items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
        items[0] = ir_new_ptr;
        items[1] = ir_new_len;
        let result = IrExpr::void_expr(slice_ty);
        result.tag = IR_TUPLE_LIT;
        result.items = items;
        self.ctx.arena.alloc(result)
    }

    fn lower_subslice(self: &mut Mono, base: &IrExpr, range_expr: &Expr) -> &IrExpr {
        // Handle raw pointer slicing: ptr[a..b] creates a new slice
        if base.ty.tag == IRTY_POINTER {
            return self.lower_ptr_subslice(base, range_expr);
        }

        if !self.is_slice_ty(base.ty) {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }

        let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);

        // Extract data pointer (field 0) and length (field 1)
        let elem_ty_ = self.slice_elem_ty(base.ty);
        let data_ptr_ty = if base.ty.tag == IRTY_SLICE {
            self.ctx.make_ptr_ty(elem_ty_, false)
        } else {
            base.ty.elems[0]
        };
        let data_ptr = IrExpr::void_expr(data_ptr_ty);
        data_ptr.tag = IR_FIELD_ACCESS;
        data_ptr.lhs = base;
        data_ptr.field_idx = 0u32;
        let ir_data_ptr = self.ctx.arena.alloc(data_ptr) as &IrExpr;

        let base_len = IrExpr::void_expr(usize_ty);
        base_len.tag = IR_FIELD_ACCESS;
        base_len.lhs = base;
        base_len.field_idx = 1u32;
        let ir_base_len = self.ctx.arena.alloc(base_len) as &IrExpr;

        // Start offset (default 0)
        let ir_start_raw = if range_expr.lhs as usize != 0 {
            self.lower_expr(range_expr.lhs)
        } else {
            let zero = IrExpr::void_expr(usize_ty);
            zero.tag = IR_INT_LIT;
            zero.int_val = 0;
            self.ctx.arena.alloc(zero) as &IrExpr
        };

        // End offset (default base.len())
        let ir_end_raw = if range_expr.rhs as usize != 0 {
            self.lower_expr(range_expr.rhs)
        } else {
            ir_base_len
        };

        // Cast start/end to usize if needed (e.g. literal 0 might be i32)
        let ir_start = if ir_start_raw.ty.tag != usize_ty.tag || ir_start_raw.ty.builtin != usize_ty.builtin {
            let cast = IrExpr::void_expr(usize_ty);
            cast.tag = IR_CAST;
            cast.lhs = ir_start_raw;
            self.ctx.arena.alloc(cast) as &IrExpr
        } else {
            ir_start_raw
        };

        let ir_end = if ir_end_raw.ty.tag != usize_ty.tag || ir_end_raw.ty.builtin != usize_ty.builtin {
            let cast = IrExpr::void_expr(usize_ty);
            cast.tag = IR_CAST;
            cast.lhs = ir_end_raw;
            self.ctx.arena.alloc(cast) as &IrExpr
        } else {
            ir_end_raw
        };

        // new_ptr = data_ptr + start (pointer arithmetic via index)
        let new_ptr = IrExpr::void_expr(data_ptr_ty);
        new_ptr.tag = IR_INDEX;
        new_ptr.lhs = ir_data_ptr;
        new_ptr.rhs = ir_start;
        let ir_new_ptr_idx = self.ctx.arena.alloc(new_ptr) as &IrExpr;
        // Take reference to get pointer
        let new_ptr_ref = IrExpr::void_expr(data_ptr_ty);
        new_ptr_ref.tag = IR_REF;
        new_ptr_ref.lhs = ir_new_ptr_idx;
        let ir_new_ptr = self.ctx.arena.alloc(new_ptr_ref) as &IrExpr;

        // new_len = end - start
        let new_len = IrExpr::void_expr(usize_ty);
        new_len.tag = IR_BINARY;
        new_len.bin_op = BinOp::Sub;
        new_len.lhs = ir_end;
        new_len.rhs = ir_start;
        let ir_new_len = self.ctx.arena.alloc(new_len) as &IrExpr;

        // Build tuple {new_ptr, new_len}
        let elems = self.ctx.arena.alloc_slice::<&IrExpr>(2);
        elems[0] = ir_new_ptr;
        elems[1] = ir_new_len;
        let result = IrExpr::void_expr(base.ty);
        result.tag = IR_TUPLE_LIT;
        result.items = elems;
        self.ctx.arena.alloc(result)
    }

    // Get the struct type from an IrTy, auto-dereffing through pointers
    fn get_struct_ty(self: &Mono, ty: &IrTy) -> Option<&IrTy> {
        if ty.tag == IRTY_STRUCT {
            Option::some(ty)
        } else if ty.tag == IRTY_POINTER {
            self.get_struct_ty(ty.inner)
        } else {
            Option::none()
        }
    }

    // Infer type arguments for a generic function call from the argument types.
    // For each generic parameter, if it appears directly as a param type (TY_PLACEHOLDER),
    // use the monomorphized type of the corresponding argument.
    fn infer_type_args(self: &mut Mono, def: &FnDef, args: &[&Expr]) -> &[&IrTy] {
        let num_generics = def.generic_params.len();
        let inferred = self.ctx.arena.alloc_slice::<&IrTy>(num_generics);
        let found = self.ctx.arena.alloc_slice::<bool>(num_generics);
        for i in 0usize..num_generics {
            inferred[i] = self.ctx.void_ty;
            found[i] = false;
        }

        // Match each parameter against the corresponding argument
        let num_params = def.params.len();
        for p in 0usize..num_params {
            if p >= args.len() { break; }
            let param_ty = def.params[p].ty;

            // Direct placeholder match: fn foo<T>(x: T) -> T maps from x's type
            if param_ty.tag == TY_PLACEHOLDER {
                for g in 0usize..num_generics {
                    if def.generic_params[g].id._value == param_ty.id._value {
                        let direct_arg_ty = self.lower_expr(args[p]).ty;
                        inferred[g] = direct_arg_ty;
                        found[g] = true;
                        break;
                    }
                }
            }
            // Pointer to placeholder: fn foo<T>(x: &T)
            if param_ty.tag == TY_POINTER && param_ty.inner.tag == TY_PLACEHOLDER {
                for g in 0usize..num_generics {
                    if def.generic_params[g].id._value == param_ty.inner.id._value {
                        let ptr_arg_ty = self.lower_expr(args[p]).ty;
                        // Unwrap pointer
                        if ptr_arg_ty.tag == IRTY_POINTER {
                            inferred[g] = ptr_arg_ty.inner;
                            found[g] = true;
                        }
                        break;
                    }
                }
            }
            // Slice of placeholder: fn foo<T>(x: &[T])
            if param_ty.tag == TY_SLICE && param_ty.inner.tag == TY_PLACEHOLDER {
                for g in 0usize..num_generics {
                    if def.generic_params[g].id._value == param_ty.inner.id._value {
                        let slice_arg_ty = self.lower_expr(args[p]).ty;
                        // Unwrap slice (tuple of ptr + len)
                        if slice_arg_ty.tag == IRTY_TUPLE && slice_arg_ty.elems.len() == 2 && slice_arg_ty.elems[0].tag == IRTY_POINTER {
                            inferred[g] = slice_arg_ty.elems[0].inner;
                            found[g] = true;
                        } else if slice_arg_ty.tag == IRTY_SLICE {
                            inferred[g] = slice_arg_ty.inner;
                            found[g] = true;
                        }
                        break;
                    }
                }
            }
        }

        // If we haven't inferred all generics from args, try return type inference.
        // If the function's return type is a named type with generic placeholders,
        // and we have an expected_type or return_type that's a concrete struct,
        // try to match placeholders against the struct's type args.
        let all_found = true;
        for i in 0usize..num_generics {
            if !found[i] { all_found = false; }
        }
        if !all_found {
            // Try inferring from return type context
            let ret_ty_ast = def.return_type;
            let hint_ty = if !self.expected_type.is_void() {
                self.expected_type
            } else {
                self.return_type
            };
            // Match: fn returns GenericType<T> (TY_GENERIC) and hint is a struct with type_args
            if ret_ty_ast.tag == TY_GENERIC && hint_ty.tag == IRTY_STRUCT && hint_ty.struct_ref.type_args.len() > 0 {
                // TY_GENERIC has inner (base type) and elems (type args as AST types)
                let ret_type_args = ret_ty_ast.elems;
                let hint_type_args = hint_ty.struct_ref.type_args;
                let min_len = if ret_type_args.len() < hint_type_args.len() { ret_type_args.len() } else { hint_type_args.len() };
                for ta in 0usize..min_len {
                    if ret_type_args[ta].tag == TY_PLACEHOLDER {
                        for g in 0usize..num_generics {
                            if !found[g] && def.generic_params[g].id._value == ret_type_args[ta].id._value {
                                inferred[g] = hint_type_args[ta];
                                found[g] = true;
                                break;
                            }
                        }
                    }
                }
            }
            // Match: fn returns GenericType<T> (TY_GENERIC) and hint is a tuple
            // This handles cases like slice<Ptr> where slice is a struct but the hint
            // is the tuple representation {Ptr, usize}
            if ret_ty_ast.tag == TY_GENERIC && hint_ty.tag == IRTY_TUPLE && hint_ty.elems.len() > 0 {
                let ret_type_args = ret_ty_ast.elems;
                let min_len = if ret_type_args.len() < hint_ty.elems.len() { ret_type_args.len() } else { hint_ty.elems.len() };
                for ta in 0usize..min_len {
                    if ret_type_args[ta].tag == TY_PLACEHOLDER {
                        for g in 0usize..num_generics {
                            if !found[g] && def.generic_params[g].id._value == ret_type_args[ta].id._value {
                                inferred[g] = hint_ty.elems[ta];
                                found[g] = true;
                                break;
                            }
                        }
                    }
                }
            }
            // Direct placeholder in return type: fn foo<T>() -> T
            if ret_ty_ast.tag == TY_PLACEHOLDER && !hint_ty.is_void() {
                for g in 0usize..num_generics {
                    if !found[g] && def.generic_params[g].id._value == ret_ty_ast.id._value {
                        inferred[g] = hint_ty;
                        found[g] = true;
                        break;
                    }
                }
            }
        }

        // Check if at least one generic was inferred (enough to differentiate)
        let any_found = false;
        for i in 0usize..num_generics {
            if found[i] {
                any_found = true;
            }
        }

        if any_found {
            inferred as &[&IrTy]
        } else {
            // Return empty - couldn't infer any types
            // Note: use alloc_slice(0) instead of &[] because &[] in an if-else branch
            // generates a broken bitcast that reads garbage for the slice length
            self.ctx.arena.alloc_slice::<&IrTy>(0usize)
        }
    }

    // Try to resolve a method call: obj.method(args) -> Type::method(&obj, args)
    fn try_lower_method_call(self: &mut Mono, expr: &Expr) -> Option<&IrExpr> {
        // expr is EXPR_CALL, expr.lhs is EXPR_FIELD_ACCESS
        let field_expr = expr.lhs;
        let ir_obj = self.lower_expr(field_expr.lhs);
        let method_name = field_expr.str_val;

        // Handle slice built-in methods
        let slice_ty = ir_obj.ty;
        let is_ptr_to_slice = false;
        if slice_ty.tag == IRTY_POINTER && self.is_slice_ty(slice_ty.inner) {
            slice_ty = slice_ty.inner;
            is_ptr_to_slice = true;
        }
        if self.is_slice_ty(slice_ty) {
            if method_name == "len" {
                // slice.len() -> extract field 1 (the length)
                let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
                // If we have a pointer to slice, deref first
                let slice_val = if is_ptr_to_slice {
                    let deref_expr = IrExpr::void_expr(slice_ty);
                    deref_expr.tag = IR_DEREF;
                    deref_expr.lhs = ir_obj;
                    self.ctx.arena.alloc(deref_expr) as &IrExpr
                } else {
                    ir_obj
                };
                let result = IrExpr::void_expr(usize_ty);
                result.tag = IR_FIELD_ACCESS;
                result.lhs = slice_val;
                result.field_idx = 1u32;
                let allocated: &IrExpr = self.ctx.arena.alloc(result) as &IrExpr;
                return Option::some(allocated);
            } else if method_name == "copy_to_nonoverlapping" || method_name == "copy_to" {
                // slice.copy_to_nonoverlapping(&dest) -> memcpy
                // First arg to method is the destination pointer
                if expr.args.len() >= 1 {
                    let dest_arg = self.lower_expr(expr.args[0]);
                    let slice_val = if is_ptr_to_slice {
                        let deref_expr = IrExpr::void_expr(slice_ty);
                        deref_expr.tag = IR_DEREF;
                        deref_expr.lhs = ir_obj;
                        self.ctx.arena.alloc(deref_expr) as &IrExpr
                    } else {
                        ir_obj
                    };
                    // Build memcpy call: memcpy(dest, src_ptr, len * elem_size)
                    let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
                    // Get the element type from the slice's data pointer (field 0)
                    let elem_ty = self.slice_elem_ty(slice_ty);
                    // Extract src ptr (field 0)
                    let data_ptr_ty = if slice_ty.tag == IRTY_SLICE {
                        self.ctx.make_ptr_ty(elem_ty, false)
                    } else {
                        slice_ty.elems[0]
                    };
                    let src_ptr_expr = IrExpr::void_expr(data_ptr_ty);
                    src_ptr_expr.tag = IR_FIELD_ACCESS;
                    src_ptr_expr.lhs = slice_val;
                    src_ptr_expr.field_idx = 0u32;
                    let src_ptr = self.ctx.arena.alloc(src_ptr_expr);
                    // Extract len (field 1)
                    let len_expr = IrExpr::void_expr(usize_ty);
                    len_expr.tag = IR_FIELD_ACCESS;
                    len_expr.lhs = slice_val;
                    len_expr.field_idx = 1u32;
                    let len_val = self.ctx.arena.alloc(len_expr);
                    // Build IR_MEMCPY
                    let void_ty = self.ctx.void_ty;
                    let result = IrExpr::void_expr(void_ty);
                    result.tag = IR_MEMCPY;
                    result.lhs = dest_arg;       // dest ptr
                    result.rhs = src_ptr;        // src ptr
                    result.cond = len_val;       // length in elements
                    result.ir_ty = elem_ty;      // elem type for size calc
                    return Option::some(self.ctx.arena.alloc(result) as &IrExpr);
                }
            } else if method_name == "is_empty" {
                let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
                let slice_val = if is_ptr_to_slice {
                    let deref_expr = IrExpr::void_expr(slice_ty);
                    deref_expr.tag = IR_DEREF;
                    deref_expr.lhs = ir_obj;
                    self.ctx.arena.alloc(deref_expr) as &IrExpr
                } else {
                    ir_obj
                };
                // len == 0
                let len_expr = IrExpr::void_expr(usize_ty);
                len_expr.tag = IR_FIELD_ACCESS;
                len_expr.lhs = slice_val;
                len_expr.field_idx = 1u32;
                let len_val = self.ctx.arena.alloc(len_expr);
                let zero = IrExpr::void_expr(usize_ty);
                zero.tag = IR_INT_LIT;
                zero.int_val = 0u64;
                let zero_val = self.ctx.arena.alloc(zero);
                let result = IrExpr::void_expr(self.ctx.bool_ty);
                result.tag = IR_BINARY;
                result.bin_op = BinOp::Eq;
                result.lhs = len_val;
                result.rhs = zero_val;
                return Option::some(self.ctx.arena.alloc(result) as &IrExpr);
            }
            if method_name == "realloc" && expr.args.len() >= 1 {
                // slice.realloc(new_len) -> new slice
                // Equivalent to: from_raw(libc::realloc(ptr, size_of<T>() * new_len), new_len)
                let elem_ty = self.slice_elem_ty(slice_ty);
                let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
                let ptr_ty = self.ctx.make_ptr_ty(elem_ty, false); // &mut T
                let void_ptr_ty = self.ctx.make_ptr_ty(self.ctx.intern_builtin_ty(BuiltinType::Void), false);

                let slice_val = if is_ptr_to_slice {
                    let deref_expr = IrExpr::void_expr(slice_ty);
                    deref_expr.tag = IR_DEREF;
                    deref_expr.lhs = ir_obj;
                    self.ctx.arena.alloc(deref_expr) as &IrExpr
                } else {
                    ir_obj
                };

                // Extract current ptr (field 0)
                let old_ptr_expr = IrExpr::void_expr(ptr_ty);
                old_ptr_expr.tag = IR_FIELD_ACCESS;
                old_ptr_expr.lhs = slice_val;
                old_ptr_expr.field_idx = 0u32;
                let old_ptr = self.ctx.arena.alloc(old_ptr_expr);

                // Cast to &mut void for realloc
                let cast_ptr = IrExpr::void_expr(void_ptr_ty);
                cast_ptr.tag = IR_CAST;
                cast_ptr.lhs = old_ptr;
                let cast_ptr_val = self.ctx.arena.alloc(cast_ptr);

                // Compute new_len arg
                let new_len = self.lower_expr(expr.args[0]);

                // Compute byte size: size_of<T>() * new_len
                let size_of_elem = IrExpr::void_expr(usize_ty);
                size_of_elem.tag = IR_SIZE_OF;
                size_of_elem.ir_ty = elem_ty;
                let size_of_val = self.ctx.arena.alloc(size_of_elem);

                let byte_size = IrExpr::void_expr(usize_ty);
                byte_size.tag = IR_BINARY;
                byte_size.bin_op = BinOp::Mul;
                byte_size.lhs = size_of_val;
                byte_size.rhs = new_len;
                let byte_size_val = self.ctx.arena.alloc(byte_size);

                // Call libc::realloc(ptr, byte_size) -> &mut void
                let call_args = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                call_args[0] = cast_ptr_val;
                call_args[1] = byte_size_val;

                let fn_ref = IrFnRef { id: Id { _value: 0usize }, mangled_name: "realloc" };
                let call_result = IrExpr::void_expr(void_ptr_ty);
                call_result.tag = IR_CALL;
                call_result.call_target = IrCallTarget { tag: CALL_DIRECT, fn_ref: fn_ref, callee: std::mem::zeroed::<&IrExpr>() };
                call_result.items = call_args;
                let new_ptr_void = self.ctx.arena.alloc(call_result);

                // Cast back to &mut T
                let cast_back = IrExpr::void_expr(ptr_ty);
                cast_back.tag = IR_CAST;
                cast_back.lhs = new_ptr_void;
                let new_ptr = self.ctx.arena.alloc(cast_back);

                // Build new slice
                let items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                items[0] = new_ptr;
                items[1] = new_len;
                let new_slice = IrExpr::void_expr(slice_ty);
                new_slice.tag = IR_TUPLE_LIT;
                new_slice.items = items;
                return Option::some(self.ctx.arena.alloc(new_slice) as &IrExpr);
            } else if method_name == "free" {
                // slice.free() -> libc::free(ptr)
                let elem_ty = self.slice_elem_ty(slice_ty);
                let void_ptr_ty = self.ctx.make_ptr_ty(self.ctx.intern_builtin_ty(BuiltinType::Void), false);
                let ptr_ty = self.ctx.make_ptr_ty(elem_ty, false);

                let slice_val = if is_ptr_to_slice {
                    let deref_expr = IrExpr::void_expr(slice_ty);
                    deref_expr.tag = IR_DEREF;
                    deref_expr.lhs = ir_obj;
                    self.ctx.arena.alloc(deref_expr) as &IrExpr
                } else {
                    ir_obj
                };

                // Extract ptr (field 0)
                let ptr_expr = IrExpr::void_expr(ptr_ty);
                ptr_expr.tag = IR_FIELD_ACCESS;
                ptr_expr.lhs = slice_val;
                ptr_expr.field_idx = 0u32;
                let ptr_val = self.ctx.arena.alloc(ptr_expr);

                // Cast to &mut void
                let cast_ptr = IrExpr::void_expr(void_ptr_ty);
                cast_ptr.tag = IR_CAST;
                cast_ptr.lhs = ptr_val;
                let cast_ptr_val = self.ctx.arena.alloc(cast_ptr);

                // Call libc::free(ptr)
                let call_args = self.ctx.arena.alloc_slice::<&IrExpr>(1);
                call_args[0] = cast_ptr_val;

                let fn_ref = IrFnRef { id: Id { _value: 0usize }, mangled_name: "free" };
                let void_ty = self.ctx.void_ty;
                let call_result = IrExpr::void_expr(void_ty);
                call_result.tag = IR_CALL;
                call_result.call_target = IrCallTarget { tag: CALL_DIRECT, fn_ref: fn_ref, callee: std::mem::zeroed::<&IrExpr>() };
                call_result.items = call_args;
                return Option::some(self.ctx.arena.alloc(call_result) as &IrExpr);
            } else if method_name == "_ptr" || method_name == "as_ptr" {
                // slice._ptr / slice.as_ptr() -> field 0 (the data pointer)
                let ptr_ty = if slice_ty.tag == IRTY_SLICE {
                    self.ctx.make_ptr_ty(self.slice_elem_ty(slice_ty), false)
                } else {
                    slice_ty.elems[0]
                };
                let slice_val = if is_ptr_to_slice {
                    let deref_expr = IrExpr::void_expr(slice_ty);
                    deref_expr.tag = IR_DEREF;
                    deref_expr.lhs = ir_obj;
                    self.ctx.arena.alloc(deref_expr) as &IrExpr
                } else {
                    ir_obj
                };
                let result = IrExpr::void_expr(ptr_ty);
                result.tag = IR_FIELD_ACCESS;
                result.lhs = slice_val;
                result.field_idx = 0u32;
                return Option::some(self.ctx.arena.alloc(result) as &IrExpr);
            }
            // Other slice methods could go here
            return Option::none();
        }

        // Get the struct or enum type (auto-deref)
        let scope_idx: u32 = 0u32;
        let method_type_args: &[&IrTy] = &[];
        let resolved_ty = ir_obj.ty;
        if resolved_ty.tag == IRTY_POINTER {
            resolved_ty = resolved_ty.inner;
        }
        if resolved_ty.tag == IRTY_STRUCT {
            scope_idx = resolved_ty.struct_ref.scope_idx;
            method_type_args = resolved_ty.struct_ref.type_args;
        } else if resolved_ty.tag == IRTY_ENUM {
            scope_idx = resolved_ty.enum_ref.scope_idx;
        } else {
            return Option::none();
        }
        if scope_idx == 0 {
            return Option::none();
        }

        // Look up method in type's scope
        let method_item = self.ctx.scopes.get(scope_idx).items.get(&method_name);
        if method_item.is_none() {
            return Option::none();
        }
        let item = method_item.unwrap();

        // Get the function id
        let fn_id = if item.kind.tag == NIK_FUNCTION {
            item.kind.id
        } else if item.kind.tag == NIK_METHOD {
            item.kind.id2
        } else {
            return Option::none();
        };

        // Look up the FnDef
        let fn_def = self.ctx.fn_defs.get(&fn_id._value);
        if fn_def.is_none() {
            return Option::none();
        }
        let def = fn_def.unwrap();

        // Combine struct type args with method turbofish type args
        // e.g. for Container<i32>.transform::<String>(), struct args=[i32], turbofish=[String]
        // The function's generic_params are [K, V], so combined = [i32, String]
        let combined_type_args = method_type_args;
        if expr.type_args.len() > 0 {
            let resolved_turbofish = self.ctx.arena.alloc_slice::<&IrTy>(expr.type_args.len());
            let i = 0usize;
            while i < expr.type_args.len() {
                resolved_turbofish[i] = self.resolve_type(expr.type_args[i]);
                i = i + 1usize;
            }
            if method_type_args.len() > 0 {
                // Combine: struct type args first, then turbofish type args
                let total = method_type_args.len() + expr.type_args.len();
                let merged = self.ctx.arena.alloc_slice::<&IrTy>(total);
                let j = 0usize;
                while j < method_type_args.len() {
                    merged[j] = method_type_args[j];
                    j = j + 1usize;
                }
                let k = 0usize;
                while k < expr.type_args.len() {
                    merged[method_type_args.len() + k] = resolved_turbofish[k];
                    k = k + 1usize;
                }
                combined_type_args = merged;
            } else {
                combined_type_args = resolved_turbofish;
            }
        }

        // If the method has generic params but no type args were provided,
        // infer the type args from the actual call arguments.
        // Note: def.params[0] is self, but expr.args does NOT include self,
        // so we offset by 1 when matching params to args.
        if combined_type_args.len() == 0 && def.generic_params.len() > 0 {
            let num_generics = def.generic_params.len();
            let inferred = self.ctx.arena.alloc_slice::<&IrTy>(num_generics);
            let found_count = 0usize;
            for i in 0usize..num_generics {
                inferred[i] = self.ctx.void_ty;
            }
            // Match params (starting from index 1, skipping self) against args
            let num_explicit_params = if def.params.len() > 0 { def.params.len() - 1 } else { 0usize };
            for p in 0usize..num_explicit_params {
                if p >= expr.args.len() { break; }
                let param_ty = def.params[p + 1].ty;  // +1 to skip self
                // Direct placeholder match: fn foo<T>(value: T)
                if param_ty.tag == TY_PLACEHOLDER {
                    for g in 0usize..num_generics {
                        if def.generic_params[g].id._value == param_ty.id._value {
                            let m_direct_arg_ty = self.lower_expr(expr.args[p]).ty;
                            inferred[g] = m_direct_arg_ty;
                            found_count = found_count + 1usize;
                            break;
                        }
                    }
                }
                // Pointer to placeholder: fn foo<T>(x: &T)
                if param_ty.tag == TY_POINTER && param_ty.inner.tag == TY_PLACEHOLDER {
                    for g in 0usize..num_generics {
                        if def.generic_params[g].id._value == param_ty.inner.id._value {
                            let m_ptr_arg_ty = self.lower_expr(expr.args[p]).ty;
                            if m_ptr_arg_ty.tag == IRTY_POINTER {
                                inferred[g] = m_ptr_arg_ty.inner;
                                found_count = found_count + 1usize;
                            }
                            break;
                        }
                    }
                }
                // Slice of placeholder: fn foo<T>(x: &[T])
                if param_ty.tag == TY_SLICE && param_ty.inner.tag == TY_PLACEHOLDER {
                    for g in 0usize..num_generics {
                        if def.generic_params[g].id._value == param_ty.inner.id._value {
                            let m_slice_arg_ty = self.lower_expr(expr.args[p]).ty;
                            if m_slice_arg_ty.tag == IRTY_SLICE {
                                inferred[g] = m_slice_arg_ty.inner;
                                found_count = found_count + 1usize;
                            } else if m_slice_arg_ty.tag == IRTY_TUPLE && m_slice_arg_ty.elems.len() == 2 && m_slice_arg_ty.elems[0].tag == IRTY_POINTER {
                                inferred[g] = m_slice_arg_ty.elems[0].inner;
                                found_count = found_count + 1usize;
                            }
                            break;
                        }
                    }
                }
            }
            if found_count > 0 {
                combined_type_args = inferred;
            }
        }

        // For protocol methods (from mixins), set up Self type substitution
        let self_id_opt = self.ctx.proto_method_self_id.get(&fn_id._value);
        if self_id_opt.is_some() {
            self.type_map.insert(self_id_opt.unwrap(), resolved_ty);
        }

        // Monomorphize the method with type args (for generic impls + turbofish)
        let fn_idx = self.mono_function(def, combined_type_args);
        let ir_fn = &self.ctx.ir_functions[fn_idx];

        // Build args: &obj as first arg, then the call args
        let total_args = 1usize + expr.args.len();
        let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(total_args);

        // First arg is &obj (take reference if obj is not already a pointer)
        if ir_obj.ty.tag == IRTY_POINTER {
            ir_args[0] = ir_obj;
        } else {
            let ref_ty = self.ctx.arena.alloc(IrTy::mk_pointer(ir_obj.ty, false));
            let ref_expr = IrExpr::void_expr(ref_ty);
            ref_expr.tag = IR_REF;
            ref_expr.lhs = ir_obj;
            ir_args[0] = self.ctx.arena.alloc(ref_expr);
        }

        // Rest of the args
        for i in 0usize..expr.args.len() {
            ir_args[1 + i] = self.lower_expr(expr.args[i]);
            // Coerce args (e.g. &[T; N] to &[T]), +1 for self param
            if (1usize + i) < ir_fn.params.len() {
                ir_args[1usize + i] = self.coerce_to_type(ir_args[1usize + i], ir_fn.params[1usize + i].ty);
            }
        }

        // Build direct call
        let ret_ty = ir_fn.return_type;
        let result = IrExpr::void_expr(ret_ty);
        result.tag = IR_CALL;
        result.call_target = IrCallTarget {
            tag: CALL_DIRECT,
            fn_ref: IrFnRef { id: ir_fn.id, mangled_name: ir_fn.mangled_name },
            callee: std::mem::zeroed::<&IrExpr>(),
        };
        result.items = ir_args;
        let allocated: &IrExpr = self.ctx.arena.alloc(result) as &IrExpr;
        Option::some(allocated)
    }

    // Lower call expressions: EXPR_CALL, EXPR_STRUCT_LIT
    fn lower_lambda(self: &mut Mono, expr: &Expr) -> &IrExpr {
        let has_captures = expr.closure_bindings.len() > 0;

        // Create an anonymous function for the lambda
        let lambda_id = self.ctx.id_gen.next_id();
        let mangled = self.ctx.mangle_name(if has_captures { "closure" } else { "lambda" });

        // First, lower the captured values (before switching to lambda's local scope)
        let bound_values = self.ctx.arena.alloc_slice::<&IrExpr>(expr.closure_bindings.len());
        for i in 0usize..expr.closure_bindings.len() {
            let binding = &expr.closure_bindings[i];
            let val = self.lower_expr(binding.value);
            if binding.bound_type == BOUND_BY_VALUE {
                bound_values[i] = val;
            } else {
                // By reference: take a reference to the original variable
                let ref_ty = self.ctx.make_ptr_ty(val.ty, false);
                let ref_expr = IrExpr::void_expr(ref_ty);
                ref_expr.tag = IR_REF;
                ref_expr.lhs = val;
                bound_values[i] = self.ctx.arena.alloc(ref_expr);
            }
        }

        // Build closure struct fields from captured values
        let closure_fields = self.ctx.arena.alloc_slice::<IrField>(expr.closure_bindings.len());
        let is_closure_zst = true;
        for i in 0usize..expr.closure_bindings.len() {
            closure_fields[i] = IrField {
                name: expr.closure_bindings[i].name,
                ty: bound_values[i].ty,
            };
            if !bound_values[i].ty.is_zero_sized() {
                is_closure_zst = false;
            }
        }

        // Create the closure struct type
        let closure_struct_ref = IrStructRef {
            id: lambda_id,
            name: mangled,
            fields: closure_fields,
            is_union: false,
            is_zero_sized: is_closure_zst,
            scope_idx: 0,
            type_args: &[],
        };
        let closure_fn_ref = IrFnRef { id: lambda_id, mangled_name: mangled };

        // Resolve parameter types - for closures, add self param at index 0
        let total_params = if has_captures { expr.lambda_params.len() + 1usize } else { expr.lambda_params.len() };
        let params = self.ctx.arena.alloc_slice::<IrParam>(total_params);
        let param_types = self.ctx.arena.alloc_slice::<&IrTy>(expr.lambda_params.len());

        // Save current mono state
        let saved_local_types = self.local_types;
        let saved_local_defs = self.local_defs;
        let saved_return_type = self.return_type;
        self.local_types = HashMap::new();
        self.local_defs = Vector::new();

        let closure_ty: &IrTy = self.ctx.void_ty;
        if has_captures {
            // Create closure type and self parameter
            closure_ty = self.ctx.arena.alloc(IrTy::mk_closure(closure_struct_ref, closure_fn_ref));
            let self_ptr_ty = self.ctx.make_ptr_ty(closure_ty, false);
            let self_param_id = expr.id; // stored by parser
            params[0] = IrParam {
                id: self_param_id,
                ty: self_ptr_ty,
                name: "__self",
            };
            self.local_types.insert(self_param_id._value, self_ptr_ty);
        }

        let param_offset = if has_captures { 1usize } else { 0usize };
        for i in 0usize..expr.lambda_params.len() {
            let lp = &expr.lambda_params[i];
            let param_ty = if lp.ty.is_some() {
                self.resolve_type(lp.ty.unwrap())
            } else {
                self.ctx.void_ty
            };
            params[i + param_offset] = IrParam {
                id: lp.id,
                ty: param_ty,
                name: lp.name,
            };
            param_types[i] = param_ty;
            self.local_types.insert(lp.id._value, param_ty);
        }

        // Resolve return type
        let ret_ty = if expr.opt_ty.is_some() {
            self.resolve_type(expr.opt_ty.unwrap())
        } else {
            self.ctx.void_ty
        };
        self.return_type = ret_ty;

        // Reserve index
        let idx = self.ctx.ir_functions.len();
        let placeholder = IrFunction {
            id: lambda_id,
            name: if has_captures { "closure" } else { "lambda" },
            mangled_name: mangled,
            params: params,
            return_type: ret_ty,
            body: Option::none(),
            local_defs: &[],
            attributes: &[],
            is_variadic: false,
            abi: Option::none(),
        };
        self.ctx.ir_functions.push(placeholder);

        // Lower body
        let body = self.lower_expr(expr.lhs);

        // Collect local defs
        let local_defs_slice = self.ctx.arena.alloc_slice::<IrLocalDef>(self.local_defs.len());
        for i in 0usize..self.local_defs.len() {
            local_defs_slice[i] = self.local_defs[i];
        }

        self.ctx.ir_functions[idx].body = Option::some(body);
        self.ctx.ir_functions[idx].local_defs = local_defs_slice;

        // Restore mono state
        self.local_types.free();
        self.local_defs.free();
        self.local_types = saved_local_types;
        self.local_defs = saved_local_defs;
        self.return_type = saved_return_type;

        if has_captures {
            // Build a struct literal with the captured values
            let items = self.ctx.arena.alloc_slice::<&IrExpr>(expr.closure_bindings.len());
            for i in 0usize..expr.closure_bindings.len() {
                items[i] = bound_values[i];
            }
            let result = IrExpr::void_expr(closure_ty);
            result.tag = IR_STRUCT_LIT;
            result.ir_ty = closure_ty;
            result.items = items;
            self.ctx.arena.alloc(result)
        } else {
            // No captures: return function pointer as before
            let fn_ty = self.ctx.make_fn_ptr_ty(param_types, ret_ty);
            let result = IrExpr::void_expr(fn_ty);
            result.tag = IR_FN_REF;
            result.fn_ref = IrFnRef {
                id: lambda_id,
                mangled_name: mangled,
            };
            self.ctx.arena.alloc(result)
        }
    }

    fn lower_bound_value(self: &mut Mono, expr: &Expr) -> &IrExpr {
        // Access a captured variable in a closure body.
        // expr.id = binding id (used for name matching)
        // expr.id2 = self_param id (the closure struct pointer)
        // expr.str_val = binding name
        // expr.flag = is by_reference
        let self_param_id = expr.id2;

        // Get the self param type (should be &ClosureStruct)
        let self_ty_opt = self.local_types.get(&self_param_id._value);
        if !self_ty_opt.is_some() {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }
        let self_ptr_ty = self_ty_opt.unwrap();

        // Dereference: self_ptr_ty is &ClosureStruct, get the struct type
        let closure_ty = if self_ptr_ty.tag == IRTY_POINTER {
            self_ptr_ty.inner
        } else {
            self_ptr_ty
        };

        if closure_ty.tag != IRTY_CLOSURE {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }

        // Find the field by name
        let fields = closure_ty.struct_ref.fields;
        let field_idx = 0u32;
        let field_ty = self.ctx.void_ty;
        let found = false;
        for i in 0usize..fields.len() {
            if fields[i].name == expr.str_val {
                field_idx = i as u32;
                field_ty = fields[i].ty;
                found = true;
            }
        }

        if !found {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }

        // Build: (*self_param).field[field_idx]
        let self_local = IrExpr::void_expr(self_ptr_ty);
        self_local.tag = IR_LOCAL;
        self_local.id = self_param_id;
        let self_local = self.ctx.arena.alloc(self_local);

        // Deref the pointer
        let deref_expr = IrExpr::void_expr(closure_ty);
        deref_expr.tag = IR_DEREF;
        deref_expr.lhs = self_local;
        let deref_expr = self.ctx.arena.alloc(deref_expr);

        // Field access
        let field_expr = IrExpr::void_expr(field_ty);
        field_expr.tag = IR_FIELD_ACCESS;
        field_expr.lhs = deref_expr;
        field_expr.field_idx = field_idx;
        let field_expr = self.ctx.arena.alloc(field_expr);

        if expr.flag {
            // By reference: the field is a pointer, dereference it
            let inner_ty = if field_ty.tag == IRTY_POINTER {
                field_ty.inner
            } else {
                field_ty
            };
            let deref_field = IrExpr::void_expr(inner_ty);
            deref_field.tag = IR_DEREF;
            deref_field.lhs = field_expr;
            self.ctx.arena.alloc(deref_field)
        } else {
            // By value: return the field directly
            field_expr
        }
    }

    fn lower_intrinsic(self: &mut Mono, name: &[u8], type_args: &[&Ty], ir_type_args: &[&IrTy], expr: &Expr) -> &IrExpr {
        if name == "in_const_context" || name == "is_const_evaluable" {
            // Always false at runtime
            let result = IrExpr::void_expr(self.ctx.intern_builtin_ty(BuiltinType::Bool));
            result.tag = IR_BOOL_LIT;
            result.bool_val = false;
            return self.ctx.arena.alloc(result);
        } else if name == "size_of" {
            // size_of<T>() -> usize
            let measured_ty = if ir_type_args.len() > 0 {
                ir_type_args[0]
            } else {
                self.ctx.void_ty
            };
            let result = IrExpr::void_expr(self.ctx.intern_builtin_ty(BuiltinType::USize));
            result.tag = IR_SIZE_OF;
            result.ir_ty = measured_ty;
            return self.ctx.arena.alloc(result);
        } else if name == "align_of" {
            let measured_ty = if ir_type_args.len() > 0 {
                ir_type_args[0]
            } else {
                self.ctx.void_ty
            };
            let result = IrExpr::void_expr(self.ctx.intern_builtin_ty(BuiltinType::USize));
            result.tag = IR_ALIGN_OF;
            result.ir_ty = measured_ty;
            return self.ctx.arena.alloc(result);
        } else if name == "unreachable" {
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_UNREACHABLE;
            return self.ctx.arena.alloc(result);
        } else if name == "trap" {
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_TRAP;
            return self.ctx.arena.alloc(result);
        } else if name == "uninitialized" {
            // uninitialized<T>() -> T  (undef)
            let ret_ty = if ir_type_args.len() > 0 {
                ir_type_args[0]
            } else {
                self.ctx.void_ty
            };
            let result = IrExpr::void_expr(ret_ty);
            result.tag = IR_UNDEF;
            return self.ctx.arena.alloc(result);
        } else if name == "zeroed" {
            let ret_ty = if ir_type_args.len() > 0 {
                ir_type_args[0]
            } else {
                self.ctx.void_ty
            };
            let result = IrExpr::void_expr(ret_ty);
            result.tag = IR_ZEROED;
            return self.ctx.arena.alloc(result);
        } else if name == "dangling" {
            // dangling<Ptr>() -> Ptr  (returns alignment as integer cast to pointer)
            let ret_ty = if ir_type_args.len() > 0 {
                ir_type_args[0]
            } else {
                self.ctx.void_ty
            };
            // Use align_of on the pointee type, then cast to pointer
            // For now, use alignment 8 as a reasonable default for 64-bit
            let align_val = IrExpr::void_expr(self.ctx.intern_builtin_ty(BuiltinType::USize));
            align_val.tag = IR_INT_LIT;
            if ret_ty.tag == IRTY_POINTER {
                align_val.int_val = 8u64; // TODO: proper alignment from pointee type
                // Actually, emit align_of on pointee
                align_val.tag = IR_ALIGN_OF;
                align_val.ir_ty = ret_ty.inner;
            } else {
                align_val.int_val = 1u64;
            }
            let ir_align = self.ctx.arena.alloc(align_val);
            // Cast alignment to pointer type
            let result = IrExpr::void_expr(ret_ty);
            result.tag = IR_CAST;
            result.lhs = ir_align;
            return self.ctx.arena.alloc(result);
        } else if name == "transmute" {
            // transmute<T1, T2>(val) -> T2
            let ret_ty = if ir_type_args.len() > 1 {
                ir_type_args[1]
            } else {
                self.ctx.void_ty
            };
            let ir_val: &IrExpr = if expr.args.len() > 0 {
                self.lower_expr(expr.args[0])
            } else {
                let v = IrExpr::void_expr(self.ctx.void_ty);
                v.tag = IR_UNDEF;
                self.ctx.arena.alloc(v) as &IrExpr
            };
            let result = IrExpr::void_expr(ret_ty);
            result.tag = IR_TRANSMUTE;
            result.lhs = ir_val;
            return self.ctx.arena.alloc(result);
        } else if name == "codegen_func" {
            // codegen_func<RetTy>(name, args...) -> RetTy
            // The first arg is a string literal with the function name
            // Remaining args are the actual function arguments
            let ret_ty = if ir_type_args.len() > 0 {
                ir_type_args[0]
            } else {
                self.ctx.void_ty
            };
            // Extract function name from first argument (should be a string literal)
            let fn_name: &[u8] = "";
            if expr.args.len() > 0 && expr.args[0].tag == EXPR_STRING_LIT {
                fn_name = expr.args[0].str_val;
            }
            // Lower remaining args
            let arg_count = if expr.args.len() > 1 { expr.args.len() - 1 } else { 0usize };
            let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(arg_count);
            for i in 0usize..arg_count {
                ir_args[i] = self.lower_expr(expr.args[i + 1]);
            }
            let result = IrExpr::void_expr(ret_ty);
            result.tag = IR_CODEGEN_FUNC;
            result.str_val = fn_name;
            result.items = ir_args;
            return self.ctx.arena.alloc(result);
        } else if name == "const_alloc" || name == "const_free" || name == "const_panic"
                || name == "const_note" || name == "const_warning" || name == "const_bake" {
            // These should only be reached in const context.
            // At runtime, emit unreachable.
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_UNREACHABLE;
            return self.ctx.arena.alloc(result);
        } else if name == "compile_fail" || name == "compile_warn" || name == "compile_note" {
            // Compile-time diagnostics, no-op at runtime
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_VOID;
            return self.ctx.arena.alloc(result);
        } else if name == "volatile" {
            // volatile<Ptr>(ptr) -> Ptr - identity for now
            if expr.args.len() > 0 {
                return self.lower_expr(expr.args[0]);
            }
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_UNDEF;
            return self.ctx.arena.alloc(result);
        } else if name == "type_id" {
            // type_id<T>() -> usize - unique ID per type
            // Use pointer to type as ID (stable within compilation)
            let ret_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
            let measured_ty = if ir_type_args.len() > 0 { ir_type_args[0] } else { self.ctx.void_ty };
            let result = IrExpr::void_expr(ret_ty);
            result.tag = IR_INT_LIT;
            result.int_val = (measured_ty as &void as usize) as u64;
            return self.ctx.arena.alloc(result);
        } else if name == "type_name" || name == "named_type_name" {
            let u8_ty = self.ctx.intern_builtin_ty(BuiltinType::U8);
            let slice_ty = self.ctx.make_slice_ty(u8_ty, true);
            let measured_ty = if ir_type_args.len() > 0 { ir_type_args[0] } else { self.ctx.void_ty };
            let type_str: &[u8] = "";
            if name == "named_type_name" {
                // Return the short name for named types, void for anonymous
                if measured_ty.tag == IRTY_STRUCT {
                    type_str = measured_ty.struct_ref.name;
                } else if measured_ty.tag == IRTY_ENUM {
                    type_str = measured_ty.enum_ref.name;
                }
                // For non-named types, return void instead of empty string
                if type_str.len() == 0 {
                    let result = IrExpr::void_expr(self.ctx.void_ty);
                    result.tag = IR_VOID;
                    return self.ctx.arena.alloc(result);
                }
            } else {
                // type_name: return the full type name
                type_str = self.ir_type_name(measured_ty);
            }
            let result = IrExpr::void_expr(slice_ty);
            result.tag = IR_STRING_LIT;
            result.str_val = type_str;
            return self.ctx.arena.alloc(result);
        } else if name == "length_of" {
            // length_of<T>() -> usize - array/tuple length
            let ret_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
            let measured_ty = if ir_type_args.len() > 0 { ir_type_args[0] } else { self.ctx.void_ty };
            let length: u64 = 0;
            if measured_ty.tag == IRTY_ARRAY {
                length = measured_ty.array_size as u64;
            } else if measured_ty.tag == IRTY_TUPLE {
                length = measured_ty.elems.len() as u64;
            }
            let result = IrExpr::void_expr(ret_ty);
            result.tag = IR_INT_LIT;
            result.int_val = length;
            return self.ctx.arena.alloc(result);
        } else if name == "asm" {
            // Inline assembly - lower the string argument
            // For now, just emit as a codegen_func with asm constraint
            if expr.args.len() > 0 && expr.args[0].tag == EXPR_STRING_LIT {
                let result = IrExpr::void_expr(self.ctx.void_ty);
                result.tag = IR_CODEGEN_FUNC;
                result.str_val = expr.args[0].str_val;
                result.items = &[];
                return self.ctx.arena.alloc(result);
            }
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_VOID;
            return self.ctx.arena.alloc(result);
        } else if name == "tag" {
            // tag(tag, expr) - identity, just lower the expression
            if expr.args.len() > 1 {
                return self.lower_expr(expr.args[1]);
            }
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_VOID;
            return self.ctx.arena.alloc(result);
        }
        // Unknown intrinsic - emit void
        let result = IrExpr::void_expr(self.ctx.void_ty);
        result.tag = IR_VOID;
        self.ctx.arena.alloc(result)
    }

    fn lower_call(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_CALL {
            // Check for intrinsic calls first
            if expr.lhs.tag == EXPR_FN_REF {
                let fn_def = self.ctx.fn_defs.get(&expr.lhs.id._value);
                if fn_def.is_some() {
                    let def = fn_def.unwrap();
                    if def.abi.is_some() && def.abi.unwrap() == "intrinsic" {
                        // Resolve type args for intrinsics
                        let ir_type_args = self.ctx.arena.alloc_slice::<&IrTy>(expr.type_args.len());
                        for i in 0usize..expr.type_args.len() {
                            ir_type_args[i] = self.resolve_type(expr.type_args[i]);
                        }
                        return self.lower_intrinsic(def.name, expr.type_args, ir_type_args, expr);
                    }
                }
            }

            // Check for method call: obj.method(args)
            if expr.lhs.tag == EXPR_FIELD_ACCESS {
                let method_result = self.try_lower_method_call(expr);
                if method_result.is_some() {
                    return method_result.unwrap();
                }
                // Fall through to normal field access (function pointer in struct field)
            }

            // Check for turbofish generic calls: func::<T>(args)
            if expr.type_args.len() > 0 && expr.lhs.tag == EXPR_FN_REF {
                // Resolve type args
                let resolved_type_args = self.ctx.arena.alloc_slice::<&IrTy>(expr.type_args.len());
                for i in 0usize..expr.type_args.len() {
                    resolved_type_args[i] = self.resolve_type(expr.type_args[i]);
                }

                // Look up the function definition
                let fn_def = self.ctx.fn_defs.get(&expr.lhs.id._value);
                if fn_def.is_some() {
                    let def = fn_def.unwrap();

                    // Check for #[lang(slice_new)] intrinsic
                    let is_slice_new = false;
                    for attr in def.attributes {
                        if attr.tag == ATTR_LANG && attr.str_val == "slice_new" {
                            is_slice_new = true;
                        }
                    }

                    if is_slice_new && expr.args.len() == 2 {
                        // #[lang(slice_new)] intrinsic: construct slice from (ptr, len)
                        let ir_ptr = self.lower_expr(expr.args[0]);
                        let ir_len = self.lower_expr(expr.args[1]);

                        // Build proper IRTY_SLICE type from the pointer's element type
                        let elem_ty = if ir_ptr.ty.tag == IRTY_POINTER {
                            ir_ptr.ty.inner
                        } else {
                            self.ctx.intern_builtin_ty(BuiltinType::U8)
                        };
                        let is_const = ir_ptr.ty.is_const;
                        let slice_ty = self.ctx.make_slice_ty(elem_ty, is_const);

                        let items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                        items[0] = ir_ptr;
                        items[1] = ir_len;

                        let result = IrExpr::void_expr(slice_ty);
                        result.tag = IR_TUPLE_LIT;
                        result.items = items;
                        return self.ctx.arena.alloc(result);
                    }

                    // Monomorphize the function with type args
                    let fn_idx = self.mono_function(def, resolved_type_args);
                    let ir_fn = &self.ctx.ir_functions[fn_idx];

                    // Lower arguments
                    let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len());
                    for i in 0usize..expr.args.len() {
                        if i < ir_fn.params.len() {
                            ir_args[i] = self.lower_expr_coerced(expr.args[i], ir_fn.params[i].ty);
                        } else {
                            ir_args[i] = self.lower_expr(expr.args[i]);
                        }
                    }

                    let fn_ref = IrFnRef {
                        id: ir_fn.id,
                        mangled_name: ir_fn.mangled_name,
                    };

                    let result = IrExpr::void_expr(ir_fn.return_type);
                    result.tag = IR_CALL;
                    result.call_target = IrCallTarget { tag: CALL_DIRECT, fn_ref: fn_ref, callee: std::mem::zeroed::<&IrExpr>() };
                    result.items = ir_args;
                    return self.ctx.arena.alloc(result);
                }
            }

            // Handle function calls by name (EXPR_FN_REF)
            if expr.type_args.len() == 0 && expr.lhs.tag == EXPR_FN_REF {
                let fn_def = self.ctx.fn_defs.get(&expr.lhs.id._value);
                if fn_def.is_some() {
                    let def = fn_def.unwrap();
                    if def.generic_params.len() > 0 {
                        // Check for #[lang(slice_new)] intrinsic (inferred type args path)
                        let is_slice_new = false;
                        for attr in def.attributes {
                            if attr.tag == ATTR_LANG && attr.str_val == "slice_new" {
                                is_slice_new = true;
                            }
                        }
                        if is_slice_new && expr.args.len() == 2 {
                            let ir_ptr = self.lower_expr(expr.args[0]);
                            let ir_len = self.lower_expr(expr.args[1]);
                            let elem_ty = if ir_ptr.ty.tag == IRTY_POINTER {
                                ir_ptr.ty.inner
                            } else {
                                self.ctx.intern_builtin_ty(BuiltinType::U8)
                            };
                            let is_const = ir_ptr.ty.is_const;
                            let slice_ty = self.ctx.make_slice_ty(elem_ty, is_const);
                            let items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                            items[0] = ir_ptr;
                            items[1] = ir_len;
                            let result = IrExpr::void_expr(slice_ty);
                            result.tag = IR_TUPLE_LIT;
                            result.items = items;
                            return self.ctx.arena.alloc(result);
                        }

                        // Infer type args from argument types
                        let inferred = self.infer_type_args(def, expr.args);
                        // If inference from args failed (e.g. Option::none() with no args),
                        // try to infer from expected return type context
                        let call_ta = inferred;
                        if call_ta.len() == 0usize && self.expected_type != self.ctx.void_ty {
                            // Try to extract type args from expected_type (e.g. Option<usize>)
                            if self.expected_type.tag == IRTY_STRUCT && self.expected_type.struct_ref.type_args.len() == def.generic_params.len() {
                                call_ta = self.expected_type.struct_ref.type_args;
                            } else if self.expected_type.tag == IRTY_STRUCT && def.generic_params.len() == 1usize {
                                // For single-generic functions returning a wrapper struct,
                                // the expected type's first type arg is probably the generic param
                                if self.expected_type.struct_ref.type_args.len() > 0usize {
                                    let ctx_ta = self.ctx.arena.alloc_slice::<&IrTy>(1usize);
                                    ctx_ta[0] = self.expected_type.struct_ref.type_args[0];
                                    call_ta = ctx_ta;
                                }
                            }
                        }
                        if call_ta.len() > 0usize {
                            let fn_idx = self.mono_function(def, call_ta);
                            let ir_fn = &self.ctx.ir_functions[fn_idx];

                            let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len());
                            for i in 0usize..expr.args.len() {
                                if i < ir_fn.params.len() {
                                    ir_args[i] = self.lower_expr_coerced(expr.args[i], ir_fn.params[i].ty);
                                } else {
                                    ir_args[i] = self.lower_expr(expr.args[i]);
                                }
                            }

                            let fn_ref = IrFnRef {
                                id: ir_fn.id,
                                mangled_name: ir_fn.mangled_name,
                            };
                            let inferred_result = IrExpr::void_expr(ir_fn.return_type);
                            inferred_result.tag = IR_CALL;
                            inferred_result.call_target = IrCallTarget { tag: CALL_DIRECT, fn_ref: fn_ref, callee: std::mem::zeroed::<&IrExpr>() };
                            inferred_result.items = ir_args;
                            return self.ctx.arena.alloc(inferred_result);
                        }
                    } else {
                        // Non-generic function call: emit as CALL_DIRECT
                        // For protocol methods, set up Self type from first argument
                        let self_param_opt = self.ctx.proto_method_self_id.get(&def.id._value);
                        if self_param_opt.is_some() && expr.args.len() > 0 {
                            let first_arg_ir = self.lower_expr(expr.args[0]);
                            let self_ty = if first_arg_ir.ty.tag == IRTY_POINTER {
                                first_arg_ir.ty.inner
                            } else {
                                first_arg_ir.ty
                            };
                            self.type_map.insert(self_param_opt.unwrap(), self_ty);
                        }
                        let fn_idx = self.mono_function(def, &[]);
                        let ir_fn = &self.ctx.ir_functions[fn_idx];

                        let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len());
                        for i in 0usize..expr.args.len() {
                            if i < ir_fn.params.len() {
                                ir_args[i] = self.lower_expr_coerced(expr.args[i], ir_fn.params[i].ty);
                            } else {
                                ir_args[i] = self.lower_expr(expr.args[i]);
                            }
                        }

                        let fn_ref = IrFnRef {
                            id: ir_fn.id,
                            mangled_name: ir_fn.mangled_name,
                        };
                        let result = IrExpr::void_expr(ir_fn.return_type);
                        result.tag = IR_CALL;
                        result.call_target = IrCallTarget { tag: CALL_DIRECT, fn_ref: fn_ref, callee: std::mem::zeroed::<&IrExpr>() };
                        result.items = ir_args;
                        return self.ctx.arena.alloc(result);
                    }
                }
            }

            let ir_callee = self.lower_expr(expr.lhs);
            let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len());
            for i in 0usize..expr.args.len() {
                ir_args[i] = self.lower_expr(expr.args[i]);
            }

            // Determine return type from callee
            if ir_callee.ty.tag == IRTY_FN_POINTER {
                // Indirect call through function pointer
                let ret_ty = ir_callee.ty.ret_ty;
                let result = IrExpr::void_expr(ret_ty);
                result.tag = IR_CALL;
                result.call_target = IrCallTarget { tag: CALL_INDIRECT, fn_ref: IrFnRef::empty(), callee: ir_callee };
                result.items = ir_args;
                self.ctx.arena.alloc(result)
            } else if ir_callee.ty.tag == IRTY_CLOSURE {
                // Closure call: take &callee, get fn from closure type, prepend self arg
                let closure_ty = ir_callee.ty;
                let fn_ref = closure_ty.closure_fn;

                // Look up the function to get its return type
                let ret_ty = self.ctx.void_ty;
                for i in 0usize..self.ctx.ir_functions.len() {
                    if self.ctx.ir_functions[i].id._value == fn_ref.id._value {
                        ret_ty = self.ctx.ir_functions[i].return_type;
                    }
                }

                // Take a reference to the closure struct
                let ref_ty = self.ctx.make_ptr_ty(closure_ty, false);
                let ref_expr = IrExpr::void_expr(ref_ty);
                ref_expr.tag = IR_REF;
                ref_expr.lhs = ir_callee;
                let ref_expr = self.ctx.arena.alloc(ref_expr);

                // Build args: [&closure, arg0, arg1, ...]
                let all_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len() + 1usize);
                all_args[0] = ref_expr;
                for i in 0usize..expr.args.len() {
                    all_args[i + 1usize] = ir_args[i];
                }

                let result = IrExpr::void_expr(ret_ty);
                result.tag = IR_CALL;
                result.call_target = IrCallTarget { tag: CALL_DIRECT, fn_ref: fn_ref, callee: std::mem::zeroed::<&IrExpr>() };
                result.items = all_args;
                self.ctx.arena.alloc(result)
            } else {
                // Not a function pointer or closure - method resolution failed, emit void
                let r = IrExpr::void_expr(self.ctx.void_ty);
                self.ctx.arena.alloc(r)
            }
        } else if expr.tag == EXPR_STRUCT_LIT {
            let ir_ty = self.resolve_type(expr.ty);
            // Reorder field_inits to match struct definition order
            let num_fields = if ir_ty.tag == IRTY_STRUCT { ir_ty.struct_ref.fields.len() } else { expr.field_inits.len() };
            let ir_fields = self.ctx.arena.alloc_slice::<&IrExpr>(num_fields);
            for i in 0usize..num_fields {
                if ir_ty.tag == IRTY_STRUCT {
                    // Find the field_init matching this struct field by name
                    let def_name = ir_ty.struct_ref.fields[i].name;
                    let field_ty = ir_ty.struct_ref.fields[i].ty;
                    let found = false;
                    for j in 0usize..expr.field_inits.len() {
                        if expr.field_inits[j].name == def_name {
                            ir_fields[i] = self.lower_expr_coerced(expr.field_inits[j].value, field_ty);
                            found = true;
                            break;
                        }
                    }
                    if !found {
                        ir_fields[i] = self.lower_expr_coerced(expr.field_inits[i].value, field_ty);
                    }
                } else {
                    ir_fields[i] = self.lower_expr(expr.field_inits[i].value);
                }
            }
            let result = IrExpr::void_expr(ir_ty);
            result.tag = IR_STRUCT_LIT;
            result.ir_ty = ir_ty;
            result.items = ir_fields;
            self.ctx.arena.alloc(result)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower block-like expressions: EXPR_BLOCK, EXPR_LET, EXPR_DEFER
    fn lower_block(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_BLOCK {
            let ir_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len());
            let result_ty = self.ctx.void_ty;
            for i in 0usize..expr.args.len() {
                ir_stmts[i] = self.lower_expr(expr.args[i]);
                if i == expr.args.len() - 1 {
                    result_ty = ir_stmts[i].ty;
                }
            }
            let result = IrExpr::void_expr(result_ty);
            result.tag = IR_BLOCK;
            result.items = ir_stmts;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_LET {
            let var_ty = if expr.opt_ty.is_some() {
                let resolved = self.resolve_type(expr.opt_ty.unwrap());
                resolved
            } else if expr.opt_expr.is_some() {
                let ir_init = self.lower_expr(expr.opt_expr.unwrap());
                let inferred = ir_init.ty;
                self.local_types.insert(expr.id._value, inferred);
                self.local_defs.push(IrLocalDef {
                    id: expr.id,
                    ty: inferred,
                    name: "",
                });
                let result = IrExpr::void_expr(self.ctx.void_ty);
                result.tag = IR_LET;
                result.id = expr.id;
                result.ir_ty = inferred;
                result.opt_expr = Option::some(ir_init);
                return self.ctx.arena.alloc(result);
            } else {
                self.ctx.void_ty
            };

            self.local_types.insert(expr.id._value, var_ty);
            self.local_defs.push(IrLocalDef {
                id: expr.id,
                ty: var_ty,
                name: "",
            });

            let ir_init: Option<&IrExpr> = if expr.opt_expr.is_some() {
                let init_val = self.lower_expr_coerced(expr.opt_expr.unwrap(), var_ty);
                // Coerce pointer-to-array to slice if needed
                Option::some(self.coerce_to_type(init_val, var_ty))
            } else {
                Option::none()
            };

            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_LET;
            result.id = expr.id;
            result.ir_ty = var_ty;
            result.opt_expr = ir_init;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_DEFER {
            let ir_inner = self.lower_expr(expr.lhs);
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_DEFER;
            result.lhs = ir_inner;
            self.ctx.arena.alloc(result)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    fn resolve_field(self: &mut Mono, ty: &IrTy, field_name: &[u8]) -> (u32, &IrTy) {
        if ty.tag == IRTY_STRUCT {
            let nf = ty.struct_ref.fields.len();
            let i = 0usize;
            while i < nf {
                let fname = ty.struct_ref.fields[i].name;
                if fname.len() == field_name.len() {
                    if fname.len() == 0usize || libc::memcmp(&fname[0] as &libc::c_void, &field_name[0] as &libc::c_void, fname.len()) == 0i32 {
                        return (i as u32, ty.struct_ref.fields[i].ty);
                    }
                }
                i = i + 1usize;
            }
            (0u32, self.ctx.void_ty)
        } else if ty.tag == IRTY_POINTER {
            // Auto-deref
            self.resolve_field(ty.inner, field_name)
        } else {
            (0u32, self.ctx.void_ty)
        }
    }

    fn free(self: &mut Mono) {
        self.type_map.free();
        self.local_types.free();
        self.local_defs.free();
    }
}

// ============================================================
// Top-level monomorphization entry point
// ============================================================

fn monomorphize(
    arena: &mut Arena,
    scopes: &ScopeArena,
    id_gen: &mut IdGen,
    diag: &mut DiagnosticContext,
    items: &[Item],
    test_mode: bool,
) -> CompilationUnit {
    let ctx = MonoCtx::new(arena, scopes, id_gen, diag, items);

    // Find all root items (exported functions, main, statics)
    // In test mode, also include #[test] functions
    for ii in 0usize..items.len() {
        let item = &items[ii];
        if item.tag == ITEM_FUNCTION {
            let fn_def = &item.fn_def;
            let is_root = false;
            for attr in fn_def.attributes {
                if attr.tag == ATTR_EXPORT {
                    is_root = true;
                } else if attr.tag == ATTR_MAIN && !test_mode {
                    is_root = true;
                } else if attr.tag == ATTR_TEST && test_mode {
                    is_root = true;
                }
            }
            if is_root {
                let mono = Mono::new(&ctx);
                mono.mono_function(fn_def, &[]);
                mono.free();
            }
        } else if item.tag == ITEM_STATIC {
            // Process statics - only process extern statics eagerly
            // Other statics will be processed on demand when referenced
            let sd = &item.static_def;
            let is_extern = false;
            for attr in sd.attributes {
                if attr.tag == ATTR_EXTERN {
                    is_extern = true;
                }
            }
            if !is_extern {
                continue;
            }
            let mono = Mono::new(&ctx);
            let ty = if sd.ty.is_some() {
                mono.resolve_type(sd.ty.unwrap())
            } else {
                ctx.void_ty
            };

            let init: Option<&IrExpr> = if sd.init.is_some() {
                Option::some(mono.lower_expr(sd.init.unwrap()))
            } else {
                Option::none()
            };

            let is_extern = false;
            for attr in sd.attributes {
                if attr.tag == ATTR_EXTERN {
                    is_extern = true;
                }
            }

            ctx.ir_globals.push(IrGlobal {
                id: sd.id,
                name: sd.name,
                mangled_name: sd.name,
                ty: ty,
                init: init,
                is_const: sd.is_const,
                is_extern: is_extern,
                attributes: sd.attributes,
            });
            mono.free();
        }
    }

    // Build compilation unit
    let fns = arena.alloc_slice::<IrFunction>(ctx.ir_functions.len());
    for i in 0usize..ctx.ir_functions.len() {
        fns[i] = ctx.ir_functions[i];
    }
    let globals = arena.alloc_slice::<IrGlobal>(ctx.ir_globals.len());
    for i in 0usize..ctx.ir_globals.len() {
        globals[i] = ctx.ir_globals[i];
    }
    let structs = arena.alloc_slice::<IrStructRef>(ctx.ir_structs.len());
    for i in 0usize..ctx.ir_structs.len() {
        structs[i] = ctx.ir_structs[i];
    }
    let enums = arena.alloc_slice::<IrEnumRef>(ctx.ir_enums.len());
    for i in 0usize..ctx.ir_enums.len() {
        enums[i] = ctx.ir_enums[i];
    }

    ctx.free();

    CompilationUnit {
        functions: fns,
        globals: globals,
        structs: structs,
        enums: enums,
    }
}

// ============================================================
// Helper functions
// ============================================================

fn hash_mono_key(id: Id, type_args: &[&IrTy]) -> u64 {
    // FNV-1a hash for robust collision resistance.
    // The old h*31+ptr hash had collisions when pointer differences
    // happened to equal 31*(id_difference), causing wrong mono cache hits.
    let h: u64 = 14695981039346656037u64; // FNV offset basis
    h = h ^ (id._value as u64);
    h = h * 1099511628211u64; // FNV prime
    h = h ^ (type_args.len() as u64);
    h = h * 1099511628211u64;
    for arg in type_args {
        h = h ^ ((arg as &void as usize) as u64);
        h = h * 1099511628211u64;
    }
    h
}

fn format_usize(n: usize, arena: &mut Arena) -> &[u8] {
    if n == 0 {
        let buf = arena.alloc_slice::<u8>(1);
        buf[0] = '0' as u8;
        return buf;
    }

    // Count digits
    let temp = n;
    let digits: usize = 0;
    while temp > 0 {
        digits = digits + 1;
        temp = temp / 10;
    }

    let buf = arena.alloc_slice::<u8>(digits);
    temp = n;
    let i = digits;
    while temp > 0 {
        i = i - 1;
        buf[i] = ('0' as u8) + (temp % 10) as u8;
        temp = temp / 10;
    }
    buf
}
