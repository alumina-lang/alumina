// Monomorphization engine for the self-hosted Alumina compiler
//
// Takes polymorphic AST items and produces concrete IR with all generics resolved.
// This is the core of the compiler - where type inference, generic substitution,
// and lowering all happen.

use ast::*;
use scope::*;
use diagnostics::DiagnosticContext;
use arena::Arena;
use std::collections::{HashMap, Vector};
use std::option::Option;

// Key for memoizing monomorphized items
struct MonoKey {
    item_id: Id,
    type_args: &[&IrTy],
}

// Context shared across all monomorphization
struct MonoCtx {
    arena: &mut Arena,
    scopes: &ScopeArena,
    id_gen: &mut IdGen,
    diag: &mut DiagnosticContext,

    // Source items from parsing
    items: &[Item],

    // Lookup tables built from parsed items
    fn_defs: HashMap<usize, &FnDef>,       // id -> FnDef
    struct_defs: HashMap<usize, &StructDef>,
    enum_defs: HashMap<usize, &EnumDef>,
    type_aliases: HashMap<usize, &TypeAlias>,
    protocol_defs: HashMap<usize, &ProtocolDef>,
    static_defs: HashMap<usize, &StaticDef>,

    // Monomorphized output
    ir_functions: Vector<IrFunction>,
    ir_globals: Vector<IrGlobal>,
    ir_structs: Vector<IrStructRef>,
    ir_enums: Vector<IrEnumRef>,

    // Monomorphization cache: maps (item_id, type_args_hash) -> index in output
    fn_cache: HashMap<u64, usize>,
    struct_cache: HashMap<u64, usize>,
    enum_cache: HashMap<u64, usize>,

    // Name mangling counter
    mangle_counter: usize,

    // Void and never types (canonical instances)
    void_ty: &IrTy,
    never_ty: &IrTy,
    bool_ty: &IrTy,

    // Pointer size
    pointer_size: usize,

    // Lang item IDs for compiler intrinsics
    slice_new_fn_id: usize,      // #[lang(slice_new)] - constructs slice from ptr+len
}

impl MonoCtx {
    fn new(
        arena: &mut Arena,
        scopes: &ScopeArena,
        id_gen: &mut IdGen,
        diag: &mut DiagnosticContext,
        items: &[Item],
    ) -> MonoCtx {
        let void_ty = arena.alloc(IrTy::mk_void());
        let never_ty = arena.alloc(IrTy::mk_never());
        let bool_ty = arena.alloc(IrTy::mk_builtin(BuiltinType::Bool));

        let ctx = MonoCtx {
            arena: arena,
            scopes: scopes,
            id_gen: id_gen,
            diag: diag,
            items: items,
            fn_defs: HashMap::new(),
            struct_defs: HashMap::new(),
            enum_defs: HashMap::new(),
            type_aliases: HashMap::new(),
            protocol_defs: HashMap::new(),
            static_defs: HashMap::new(),
            ir_functions: Vector::new(),
            ir_globals: Vector::new(),
            ir_structs: Vector::new(),
            ir_enums: Vector::new(),
            fn_cache: HashMap::new(),
            struct_cache: HashMap::new(),
            enum_cache: HashMap::new(),
            mangle_counter: 0,
            void_ty: void_ty,
            never_ty: never_ty,
            bool_ty: bool_ty,
            pointer_size: 8, // assume 64-bit
            slice_new_fn_id: 0,
        };

        // Build lookup tables
        ctx.build_lookup_tables();
        ctx
    }

    fn build_lookup_tables(self: &mut MonoCtx) {
        // Use index-based iteration to get stable pointers into the slice
        for i in 0usize..self.items.len() {
            if self.items[i].tag == ITEM_FUNCTION {
                self.fn_defs.insert(self.items[i].fn_def.id._value, &self.items[i].fn_def);
                // Detect lang items
                for attr in self.items[i].fn_def.attributes {
                    if attr.tag == ATTR_LANG && attr.str_val == "slice_new" {
                        self.slice_new_fn_id = self.items[i].fn_def.id._value;
                    }
                }
            } else if self.items[i].tag == ITEM_STRUCT {
                self.struct_defs.insert(self.items[i].struct_def.id._value, &self.items[i].struct_def);
            } else if self.items[i].tag == ITEM_ENUM {
                self.enum_defs.insert(self.items[i].enum_def.id._value, &self.items[i].enum_def);
            } else if self.items[i].tag == ITEM_TYPE_ALIAS {
                self.type_aliases.insert(self.items[i].type_alias.id._value, &self.items[i].type_alias);
            } else if self.items[i].tag == ITEM_PROTOCOL {
                self.protocol_defs.insert(self.items[i].protocol_def.id._value, &self.items[i].protocol_def);
            } else if self.items[i].tag == ITEM_STATIC {
                self.static_defs.insert(self.items[i].static_def.id._value, &self.items[i].static_def);
            }
        }
    }

    fn mangle_name(self: &mut MonoCtx, base: &[u8]) -> &[u8] {
        self.mangle_counter = self.mangle_counter + 1;
        // Create mangled name: _AL<base><counter>
        let counter_str = format_usize(self.mangle_counter, self.arena);
        let total_len = 3usize + base.len() + counter_str.len();
        let buf = self.arena.alloc_slice::<u8>(total_len);
        buf[0] = '_' as u8;
        buf[1] = 'A' as u8;
        buf[2] = 'L' as u8;
        base.copy_to_nonoverlapping(&buf[3]);
        counter_str.copy_to_nonoverlapping(&buf[3 + base.len()]);
        buf
    }

    fn intern_builtin_ty(self: &mut MonoCtx, bt: BuiltinType) -> &IrTy {
        switch bt {
            BuiltinType::Void => self.void_ty,
            BuiltinType::Never => self.never_ty,
            BuiltinType::Bool => self.bool_ty,
            _ => self.arena.alloc(IrTy::mk_builtin(bt)),
        }
    }

    fn make_ptr_ty(self: &mut MonoCtx, pointee: &IrTy, is_const: bool) -> &IrTy {
        self.arena.alloc(IrTy::mk_pointer(pointee, is_const))
    }

    fn make_array_ty(self: &mut MonoCtx, elem: &IrTy, size: usize) -> &IrTy {
        self.arena.alloc(IrTy::mk_array(elem, size))
    }

    fn make_tuple_ty(self: &mut MonoCtx, elems: &[&IrTy]) -> &IrTy {
        if elems.len() == 0 {
            return self.void_ty;
        }
        self.arena.alloc(IrTy::mk_tuple(elems))
    }

    fn make_fn_ptr_ty(self: &mut MonoCtx, params: &[&IrTy], ret: &IrTy) -> &IrTy {
        self.arena.alloc(IrTy::mk_fn_pointer(params, ret))
    }

    fn make_slice_ty(self: &mut MonoCtx, elem: &IrTy, is_const: bool) -> &IrTy {
        self.arena.alloc(IrTy::mk_slice(elem, is_const))
    }

    fn free(self: &mut MonoCtx) {
        self.fn_defs.free();
        self.struct_defs.free();
        self.enum_defs.free();
        self.type_aliases.free();
        self.protocol_defs.free();
        self.static_defs.free();
        self.ir_functions.free();
        self.ir_globals.free();
        self.ir_structs.free();
        self.ir_enums.free();
        self.fn_cache.free();
        self.struct_cache.free();
        self.enum_cache.free();
    }
}

// Per-function monomorphization state
struct Mono {
    ctx: &mut MonoCtx,
    // Generic type parameter substitutions
    type_map: HashMap<usize, &IrTy>,   // placeholder id -> concrete type
    // Local variable types
    local_types: HashMap<usize, &IrTy>,
    // Local variable defs accumulated during lowering
    local_defs: Vector<IrLocalDef>,
    // Return type of the current function
    return_type: &IrTy,
    // Current function name for debugging
    current_fn_name: &[u8],
}

impl Mono {
    fn new(ctx: &mut MonoCtx) -> Mono {
        Mono {
            ctx: ctx,
            type_map: HashMap::new(),
            local_types: HashMap::new(),
            local_defs: Vector::new(),
            return_type: ctx.void_ty,
            current_fn_name: "",
        }
    }

    fn with_substitutions(ctx: &mut MonoCtx, type_map: HashMap<usize, &IrTy>) -> Mono {
        Mono {
            ctx: ctx,
            type_map: type_map,
            local_types: HashMap::new(),
            local_defs: Vector::new(),
            return_type: ctx.void_ty,
            current_fn_name: "",
        }
    }

    // Resolve an AST type to a concrete IR type
    fn resolve_type(self: &mut Mono, ty: &Ty) -> &IrTy {
        if ty.tag == TY_BUILTIN {
            self.ctx.intern_builtin_ty(ty.builtin)
        } else if ty.tag == TY_PLACEHOLDER {
            let resolved = self.type_map.get(&ty.id._value);
            if resolved.is_some() {
                resolved.unwrap()
            } else {
                // Unresolved placeholder - error
                self.ctx.diag.error(Span::empty(), "unresolved generic type parameter");
                self.ctx.void_ty
            }
        } else if ty.tag == TY_POINTER {
            let inner_ty = self.resolve_type(ty.inner);
            self.ctx.make_ptr_ty(inner_ty, ty.is_const)
        } else if ty.tag == TY_SLICE {
            // Slices are fat pointers: (data_ptr, len) as a tuple
            let inner_ty = self.resolve_type(ty.inner);
            let data_ty = self.ctx.make_ptr_ty(inner_ty, ty.is_const);
            let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
            let fields = self.ctx.arena.alloc_slice::<&IrTy>(2);
            fields[0] = data_ty;
            fields[1] = usize_ty;
            self.ctx.make_tuple_ty(fields)
        } else if ty.tag == TY_ARRAY {
            let inner_ty = self.resolve_type(ty.inner);
            self.ctx.make_array_ty(inner_ty, ty.array_size)
        } else if ty.tag == TY_TUPLE {
            let resolved = self.ctx.arena.alloc_slice::<&IrTy>(ty.elems.len());
            for i in 0usize..ty.elems.len() {
                resolved[i] = self.resolve_type(ty.elems[i]);
            }
            self.ctx.make_tuple_ty(resolved)
        } else if ty.tag == TY_FN_POINTER {
            let resolved_params = self.ctx.arena.alloc_slice::<&IrTy>(ty.elems.len());
            for i in 0usize..ty.elems.len() {
                resolved_params[i] = self.resolve_type(ty.elems[i]);
            }
            let resolved_ret = self.resolve_type(ty.ret_ty);
            self.ctx.make_fn_ptr_ty(resolved_params, resolved_ret)
        } else if ty.tag == TY_NAMED {
            let item_ref = ItemRef { id: ty.id };
            self.resolve_named_type(item_ref, &[])
        } else if ty.tag == TY_GENERIC {
            // Resolve the base type with generic arguments
            let resolved_args = self.ctx.arena.alloc_slice::<&IrTy>(ty.elems.len());
            for i in 0usize..ty.elems.len() {
                resolved_args[i] = self.resolve_type(ty.elems[i]);
            }
            if ty.inner.tag == TY_NAMED {
                let item_ref = ItemRef { id: ty.inner.id };
                self.resolve_named_type(item_ref, resolved_args)
            } else {
                let base_ty = self.resolve_type(ty.inner);
                base_ty
            }
        } else if ty.tag == TY_NEVER {
            self.ctx.never_ty
        } else if ty.tag == TY_UNRESOLVED {
            self.ctx.diag.error(Span::empty(), "unresolved type");
            self.ctx.void_ty
        } else {
            self.ctx.void_ty
        }
    }

    fn resolve_named_type(self: &mut Mono, item_ref: ItemRef, type_args: &[&IrTy]) -> &IrTy {
        // Check if it's a struct
        let struct_def = self.ctx.struct_defs.get(&item_ref.id._value);
        if struct_def.is_some() {
            return self.mono_struct(struct_def.unwrap(), type_args);
        }

        // Check if it's an enum
        let enum_def = self.ctx.enum_defs.get(&item_ref.id._value);
        if enum_def.is_some() {
            return self.mono_enum(enum_def.unwrap(), type_args);
        }

        // Check if it's a type alias
        let ta = self.ctx.type_aliases.get(&item_ref.id._value);
        if ta.is_some() {
            let alias = ta.unwrap();
            // Set up type parameter substitution
            if alias.generic_params.len() > 0 && type_args.len() > 0 {
                for i in 0usize..std::cmp::min(alias.generic_params.len(), type_args.len()) {
                    self.type_map.insert(alias.generic_params[i].id._value, type_args[i]);
                }
            }
            return self.resolve_type(alias.target);
        }

        self.ctx.void_ty
    }

    fn mono_struct(self: &mut Mono, def: &StructDef, type_args: &[&IrTy]) -> &IrTy {
        // Check cache
        let cache_key = hash_mono_key(def.id, type_args);
        let cached = self.ctx.struct_cache.get(&cache_key);
        if cached.is_some() {
            let idx = cached.unwrap();
            return self.ctx.arena.alloc(IrTy::mk_struct(self.ctx.ir_structs[idx]));
        }

        // Set up generic substitution
        if def.generic_params.len() > 0 && type_args.len() > 0 {
            for i in 0usize..std::cmp::min(def.generic_params.len(), type_args.len()) {
                self.type_map.insert(def.generic_params[i].id._value, type_args[i]);
            }
        }

        // Resolve field types
        let fields = self.ctx.arena.alloc_slice::<IrField>(def.fields.len());
        let is_zst = true;
        for i in 0usize..def.fields.len() {
            let field_ty = self.resolve_type(def.fields[i].ty);
            fields[i] = IrField {
                name: def.fields[i].name,
                ty: field_ty,
            };
            if !field_ty.is_zero_sized() {
                is_zst = false;
            }
        }

        if def.fields.len() == 0 {
            is_zst = true;
        }

        let mangled = self.ctx.mangle_name(def.name);

        // Use scope_idx directly from StructDef
        let scope_idx = def.scope_idx;

        let ir_struct = IrStructRef {
            id: def.id,
            name: def.name,
            fields: fields,
            is_union: def.is_union,
            is_zero_sized: is_zst,
            scope_idx: scope_idx,
            type_args: type_args,
        };

        let idx = self.ctx.ir_structs.len();
        self.ctx.ir_structs.push(ir_struct);
        self.ctx.struct_cache.insert(cache_key, idx);

        self.ctx.arena.alloc(IrTy::mk_struct(self.ctx.ir_structs[idx]))
    }

    fn mono_enum(self: &mut Mono, def: &EnumDef, type_args: &[&IrTy]) -> &IrTy {
        let cache_key = hash_mono_key(def.id, type_args);
        let cached = self.ctx.enum_cache.get(&cache_key);
        if cached.is_some() {
            let idx = cached.unwrap();
            return self.ctx.arena.alloc(IrTy::mk_enum(self.ctx.ir_enums[idx]));
        }

        // Determine underlying type
        let underlying = if def.underlying_type.is_some() {
            self.resolve_type(def.underlying_type.unwrap())
        } else {
            self.ctx.intern_builtin_ty(BuiltinType::I32)
        };

        // Resolve variant values
        let variants = self.ctx.arena.alloc_slice::<IrEnumVariant>(def.variants.len());
        let next_val: u64 = 0;
        for i in 0usize..def.variants.len() {
            let val = if def.variants[i].value.is_some() {
                // TODO: evaluate const expression
                next_val
            } else {
                next_val
            };
            variants[i] = IrEnumVariant {
                name: def.variants[i].name,
                value: val,
            };
            next_val = val + 1;
        }

        let mangled = self.ctx.mangle_name(def.name);

        // Use scope_idx directly from EnumDef
        let enum_scope_idx = def.scope_idx;

        let ir_enum = IrEnumRef {
            id: def.id,
            name: def.name,
            underlying: underlying,
            variants: variants,
            scope_idx: enum_scope_idx,
        };

        let idx = self.ctx.ir_enums.len();
        self.ctx.ir_enums.push(ir_enum);
        self.ctx.enum_cache.insert(cache_key, idx);

        self.ctx.arena.alloc(IrTy::mk_enum(self.ctx.ir_enums[idx]))
    }

    fn mono_function(self: &mut Mono, def: &FnDef, type_args: &[&IrTy]) -> usize {
        let prev_fn_name = self.current_fn_name;
        self.current_fn_name = def.name;

        let cache_key = hash_mono_key(def.id, type_args);
        let cached = self.ctx.fn_cache.get(&cache_key);
        if cached.is_some() {
            self.current_fn_name = prev_fn_name;
            return cached.unwrap();
        }

        // Set up generic substitution
        if def.generic_params.len() > 0 && type_args.len() > 0 {
            for i in 0usize..std::cmp::min(def.generic_params.len(), type_args.len()) {
                self.type_map.insert(def.generic_params[i].id._value, type_args[i]);
            }
        }

        // Resolve parameter types
        let params = self.ctx.arena.alloc_slice::<IrParam>(def.params.len());
        for i in 0usize..def.params.len() {
            let param_ty = self.resolve_type(def.params[i].ty);
            params[i] = IrParam {
                id: def.params[i].id,
                ty: param_ty,
                name: def.params[i].name,
            };
            self.local_types.insert(def.params[i].id._value, param_ty);
        }

        // Resolve return type
        self.return_type = self.resolve_type(def.return_type);

        // Determine mangled name
        let mangled = if def.abi.is_some() {
            // Extern functions keep their name
            def.name
        } else {
            // Check for export or main attribute
            let keep_name = false;
            for attr in def.attributes {
                if attr.tag == ATTR_EXPORT {
                    keep_name = true;
                } else if attr.tag == ATTR_MAIN {
                    keep_name = true;
                }
            }
            if keep_name { def.name } else { self.ctx.mangle_name(def.name) }
        };

        // Reserve index and cache it BEFORE lowering the body
        // to handle recursive functions
        let idx = self.ctx.ir_functions.len();
        let placeholder = IrFunction {
            id: def.id,
            name: def.name,
            mangled_name: mangled,
            params: params,
            return_type: self.return_type,
            body: Option::none(),
            local_defs: &[],
            attributes: def.attributes,
            is_variadic: def.is_variadic,
            abi: def.abi,
        };
        self.ctx.ir_functions.push(placeholder);
        self.ctx.fn_cache.insert(cache_key, idx);

        // Lower body (may recursively call mono_function)
        let body: Option<&IrExpr> = if def.body.is_some() {
            Option::some(self.lower_expr(def.body.unwrap()))
        } else {
            Option::none()
        };

        // Collect local defs
        let local_defs_slice = self.ctx.arena.alloc_slice::<IrLocalDef>(self.local_defs.len());
        for i in 0usize..self.local_defs.len() {
            local_defs_slice[i] = self.local_defs[i];
        }

        // Update the placeholder with the actual body and local defs
        self.ctx.ir_functions[idx].body = body;
        self.ctx.ir_functions[idx].local_defs = local_defs_slice;

        self.current_fn_name = prev_fn_name;
        idx
    }

    // Lower an AST expression to IR (dispatcher)
    fn lower_expr(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_INT_LIT || expr.tag == EXPR_FLOAT_LIT || expr.tag == EXPR_BOOL_LIT || expr.tag == EXPR_STRING_LIT || expr.tag == EXPR_NULL_LIT || expr.tag == EXPR_CHAR_LIT {
            self.lower_literal(expr)
        } else if expr.tag == EXPR_LOCAL || expr.tag == EXPR_PARAM || expr.tag == EXPR_FN_REF || expr.tag == EXPR_ENUM_REF || expr.tag == EXPR_STATIC_REF {
            self.lower_variable(expr)
        } else if expr.tag == EXPR_BINARY || expr.tag == EXPR_UNARY || expr.tag == EXPR_ASSIGN {
            self.lower_binop(expr)
        } else if expr.tag == EXPR_IF || expr.tag == EXPR_WHILE || expr.tag == EXPR_LOOP || expr.tag == EXPR_FOR || expr.tag == EXPR_SWITCH || expr.tag == EXPR_BREAK || expr.tag == EXPR_CONTINUE || expr.tag == EXPR_RETURN {
            self.lower_control_flow(expr)
        } else if expr.tag == EXPR_REF || expr.tag == EXPR_DEREF || expr.tag == EXPR_FIELD_ACCESS || expr.tag == EXPR_TUPLE_INDEX || expr.tag == EXPR_INDEX || expr.tag == EXPR_CAST || expr.tag == EXPR_TYPE_CHECK {
            self.lower_memory(expr)
        } else if expr.tag == EXPR_CALL || expr.tag == EXPR_STRUCT_LIT {
            self.lower_call(expr)
        } else if expr.tag == EXPR_BLOCK || expr.tag == EXPR_LET || expr.tag == EXPR_DEFER {
            self.lower_block(expr)
        } else if expr.tag == EXPR_TUPLE_LIT {
            let ir_elems = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len());
            let elem_types = self.ctx.arena.alloc_slice::<&IrTy>(expr.args.len());
            for i in 0usize..expr.args.len() {
                ir_elems[i] = self.lower_expr(expr.args[i]);
                elem_types[i] = ir_elems[i].ty;
            }
            let tuple_ty = self.ctx.make_tuple_ty(elem_types);
            let result = IrExpr::void_expr(tuple_ty);
            result.tag = IR_TUPLE_LIT;
            result.items = ir_elems;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_ARRAY_LIT {
            let ir_elems = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len());
            let elem_ty = self.ctx.void_ty;
            for i in 0usize..expr.args.len() {
                ir_elems[i] = self.lower_expr(expr.args[i]);
                if i == 0 {
                    elem_ty = ir_elems[i].ty;
                }
            }
            let arr_ty = self.ctx.make_array_ty(elem_ty, expr.args.len());
            let result = IrExpr::void_expr(arr_ty);
            result.tag = IR_ARRAY_LIT;
            result.items = ir_elems;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_LAMBDA {
            self.lower_lambda(expr)
        } else if expr.tag == EXPR_VOID {
            let result = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_ZEROED {
            let ir_ty = self.resolve_type(expr.ty);
            let result = IrExpr::void_expr(ir_ty);
            result.tag = IR_ZEROED;
            self.ctx.arena.alloc(result)
        } else {
            // Unhandled expression kind
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower an expression with a type hint for unsuffixed literals
    fn lower_expr_coerced(self: &mut Mono, expr: &Expr, expected_ty: &IrTy) -> &IrExpr {
        // For unsuffixed integer literals, use the expected type directly
        if expr.tag == EXPR_INT_LIT && expr.type_suffix.is_none() && expected_ty.tag == IRTY_BUILTIN {
            let result = IrExpr::void_expr(expected_ty);
            result.tag = IR_INT_LIT;
            result.int_val = expr.int_val;
            return self.ctx.arena.alloc(result);
        }
        let lowered = self.lower_expr(expr);
        self.coerce_int(lowered, expected_ty)
    }

    // Wrap an IR expression in an implicit cast if integer types differ
    fn coerce_int(self: &mut Mono, ir: &IrExpr, expected: &IrTy) -> &IrExpr {
        if ir.ty.tag == IRTY_BUILTIN && expected.tag == IRTY_BUILTIN && ir.ty != expected {
            // Both are builtin types but differ - insert an implicit cast
            let cast = IrExpr::void_expr(expected);
            cast.tag = IR_CAST;
            cast.lhs = ir;
            return self.ctx.arena.alloc(cast);
        }
        ir
    }

    // Lower literal expressions: EXPR_INT_LIT, EXPR_FLOAT_LIT, EXPR_BOOL_LIT, EXPR_STRING_LIT, EXPR_NULL_LIT, EXPR_CHAR_LIT
    fn lower_literal(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_INT_LIT {
            let ty = if expr.type_suffix.is_some() {
                self.ctx.intern_builtin_ty(expr.type_suffix.unwrap())
            } else {
                self.ctx.intern_builtin_ty(BuiltinType::I32) // default int type
            };
            let result = IrExpr::void_expr(ty);
            result.tag = IR_INT_LIT;
            result.int_val = expr.int_val;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_FLOAT_LIT {
            let ty = if expr.type_suffix.is_some() {
                self.ctx.intern_builtin_ty(expr.type_suffix.unwrap())
            } else {
                self.ctx.intern_builtin_ty(BuiltinType::F64)
            };
            let result = IrExpr::void_expr(ty);
            result.tag = IR_FLOAT_LIT;
            result.float_val = expr.float_val;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_BOOL_LIT {
            let result = IrExpr::void_expr(self.ctx.bool_ty);
            result.tag = IR_BOOL_LIT;
            result.bool_val = expr.bool_val;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_STRING_LIT {
            // String literals are &[u8] - pointer + length
            let u8_ty = self.ctx.intern_builtin_ty(BuiltinType::U8);
            let slice_ty = self.ctx.make_ptr_ty(u8_ty, true);
            let result = IrExpr::void_expr(slice_ty);
            result.tag = IR_STRING_LIT;
            result.str_val = expr.str_val;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_NULL_LIT {
            let void_ty = self.ctx.void_ty;
            let ptr_ty = self.ctx.make_ptr_ty(void_ty, false);
            let result = IrExpr::void_expr(ptr_ty);
            result.tag = IR_NULL_LIT;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_CHAR_LIT {
            let result = IrExpr::void_expr(self.ctx.intern_builtin_ty(BuiltinType::U32));
            result.tag = IR_INT_LIT;
            result.int_val = expr.int_val;
            self.ctx.arena.alloc(result)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower variable references: EXPR_LOCAL, EXPR_PARAM, EXPR_FN_REF
    fn lower_variable(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_LOCAL {
            let ty = self.local_types.get(&expr.id._value);
            let local_ty = if ty.is_some() { ty.unwrap() } else { self.ctx.void_ty };
            let result = IrExpr::void_expr(local_ty);
            result.tag = IR_LOCAL;
            result.id = expr.id;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_PARAM {
            let ty = self.local_types.get(&expr.id._value);
            let param_ty = if ty.is_some() { ty.unwrap() } else { self.ctx.void_ty };
            let result = IrExpr::void_expr(param_ty);
            result.tag = IR_LOCAL; // params and locals share namespace in IR
            result.id = expr.id;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_FN_REF {
            // Look up the function and get its type
            let fn_def = self.ctx.fn_defs.get(&expr.id._value);
            if fn_def.is_some() {
                let def = fn_def.unwrap();
                let fn_idx = self.mono_function(def, &[]);
                let ir_fn = &self.ctx.ir_functions[fn_idx];

                // Build function pointer type
                let param_types = self.ctx.arena.alloc_slice::<&IrTy>(ir_fn.params.len());
                for i in 0usize..ir_fn.params.len() {
                    param_types[i] = ir_fn.params[i].ty;
                }
                let fn_ty = self.ctx.make_fn_ptr_ty(param_types, ir_fn.return_type);

                let result = IrExpr::void_expr(fn_ty);
                result.tag = IR_FN_REF;
                result.fn_ref = IrFnRef {
                    id: ir_fn.id,
                    mangled_name: ir_fn.mangled_name,
                };
                self.ctx.arena.alloc(result)
            } else {
                let result = IrExpr::void_expr(self.ctx.void_ty);
                result.tag = IR_NULL_LIT;
                self.ctx.arena.alloc(result)
            }
        } else if expr.tag == EXPR_STATIC_REF {
            // Look up the static/const definition
            let sd = self.ctx.static_defs.get(&expr.id._value);
            if sd.is_some() {
                let def = sd.unwrap();
                if def.is_const && def.init.is_some() {
                    // For consts, inline the initializer expression
                    self.lower_expr(def.init.unwrap())
                } else {
                    // For statics, emit a global reference
                    let ty = if def.ty.is_some() {
                        self.resolve_type(def.ty.unwrap())
                    } else {
                        self.ctx.void_ty
                    };
                    let result = IrExpr::void_expr(ty);
                    result.tag = IR_GLOBAL_REF;
                    result.global_ref = IrGlobalRef {
                        id: def.id,
                        mangled_name: def.name,
                    };
                    self.ctx.arena.alloc(result)
                }
            } else {
                let r = IrExpr::void_expr(self.ctx.void_ty);
                self.ctx.arena.alloc(r)
            }
        } else if expr.tag == EXPR_ENUM_REF {
            // Look up enum and variant
            let enum_def = self.ctx.enum_defs.get(&expr.id._value);
            if enum_def.is_some() {
                let def = enum_def.unwrap();
                let enum_ty = self.mono_enum(def, &[]);
                // Find variant value by matching variant id
                let variant_val: u64 = 0;
                for i in 0usize..def.variants.len() {
                    if def.variants[i].id._value == expr.id2._value {
                        // Use the monomorphized variant value from IrEnumRef
                        variant_val = enum_ty.enum_ref.variants[i].value;
                        break;
                    }
                }
                // Use the underlying type for the literal
                let underlying = enum_ty.enum_ref.underlying;
                let result = IrExpr::void_expr(enum_ty);
                result.tag = IR_INT_LIT;
                result.int_val = variant_val;
                self.ctx.arena.alloc(result)
            } else {
                let r = IrExpr::void_expr(self.ctx.void_ty);
                self.ctx.arena.alloc(r)
            }
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower binary/unary/assignment ops: EXPR_BINARY, EXPR_UNARY, EXPR_ASSIGN, EXPR_COMPOUND_ASSIGN
    fn lower_binop(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_BINARY {
            let ir_lhs = self.lower_expr(expr.lhs);
            let ir_rhs = self.lower_expr_coerced(expr.rhs, ir_lhs.ty);
            let result_ty = switch expr.bin_op {
                BinOp::Eq => self.ctx.bool_ty,
                BinOp::Ne => self.ctx.bool_ty,
                BinOp::Lt => self.ctx.bool_ty,
                BinOp::Le => self.ctx.bool_ty,
                BinOp::Gt => self.ctx.bool_ty,
                BinOp::Ge => self.ctx.bool_ty,
                BinOp::And => self.ctx.bool_ty,
                BinOp::Or => self.ctx.bool_ty,
                _ => ir_lhs.ty,
            };
            let result = IrExpr::void_expr(result_ty);
            result.tag = IR_BINARY;
            result.bin_op = expr.bin_op;
            result.lhs = ir_lhs;
            result.rhs = ir_rhs;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_UNARY {
            let ir_operand = self.lower_expr(expr.lhs);
            let result_ty = switch expr.un_op {
                UnOp::Not => self.ctx.bool_ty,
                _ => ir_operand.ty,
            };
            let result = IrExpr::void_expr(result_ty);
            result.tag = IR_UNARY;
            result.un_op = expr.un_op;
            result.lhs = ir_operand;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_ASSIGN {
            let ir_lhs = self.lower_expr(expr.lhs);
            let ir_rhs = self.lower_expr_coerced(expr.rhs, ir_lhs.ty);
            // For compound assignment, desugar to binary + assign
            if expr.assign_op as i32 != AssignOp::Assign as i32 {
                let bin_op = switch expr.assign_op {
                    AssignOp::AddAssign => BinOp::Add,
                    AssignOp::SubAssign => BinOp::Sub,
                    AssignOp::MulAssign => BinOp::Mul,
                    AssignOp::DivAssign => BinOp::Div,
                    AssignOp::RemAssign => BinOp::Rem,
                    AssignOp::BitAndAssign => BinOp::BitAnd,
                    AssignOp::BitOrAssign => BinOp::BitOr,
                    AssignOp::BitXorAssign => BinOp::BitXor,
                    AssignOp::ShlAssign => BinOp::Shl,
                    AssignOp::ShrAssign => BinOp::Shr,
                    _ => BinOp::Add,
                };
                let binop_result = IrExpr::void_expr(ir_lhs.ty);
                binop_result.tag = IR_BINARY;
                binop_result.bin_op = bin_op;
                binop_result.lhs = ir_lhs;
                binop_result.rhs = ir_rhs;
                let binop_expr = self.ctx.arena.alloc(binop_result);

                let assign_result = IrExpr::void_expr(self.ctx.void_ty);
                assign_result.tag = IR_ASSIGN;
                assign_result.lhs = ir_lhs;
                assign_result.rhs = binop_expr;
                return self.ctx.arena.alloc(assign_result);
            }
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_ASSIGN;
            result.lhs = ir_lhs;
            result.rhs = ir_rhs;
            self.ctx.arena.alloc(result)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower control flow: EXPR_IF, EXPR_WHILE, EXPR_LOOP, EXPR_FOR, EXPR_SWITCH, EXPR_BREAK, EXPR_CONTINUE, EXPR_RETURN
    fn lower_control_flow(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_IF {
            let ir_cond = self.lower_expr(expr.cond);
            let ir_then = self.lower_expr(expr.lhs);
            let ir_else: Option<&IrExpr> = if expr.opt_expr.is_some() {
                Option::some(self.lower_expr(expr.opt_expr.unwrap()))
            } else {
                Option::none()
            };
            let result_ty = ir_then.ty;
            let result = IrExpr::void_expr(result_ty);
            result.tag = IR_IF;
            result.cond = ir_cond;
            result.lhs = ir_then;
            result.opt_expr = ir_else;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_WHILE {
            let ir_cond = self.lower_expr(expr.cond);
            let ir_body = self.lower_expr(expr.lhs);
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_WHILE;
            result.cond = ir_cond;
            result.lhs = ir_body;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_LOOP {
            let ir_body = self.lower_expr(expr.lhs);
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_LOOP;
            result.lhs = ir_body;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_FOR {
            // Desugar: for i in start..end { body }
            // Into: let i = start; let _end = end; while i < _end { body; i = i + 1; }
            let range_expr = expr.lhs;
            if range_expr.tag != EXPR_RANGE {
                // Only range-based for loops supported for now
                let r = IrExpr::void_expr(self.ctx.void_ty);
                return self.ctx.arena.alloc(r);
            }

            let ir_start = self.lower_expr(range_expr.lhs);
            let ir_end = self.lower_expr(range_expr.rhs);
            let iter_ty = ir_start.ty;

            // Register loop variable type
            let loop_var_id = expr.id;
            self.local_types.insert(loop_var_id._value, iter_ty);
            self.local_defs.push(IrLocalDef {
                id: loop_var_id,
                ty: iter_ty,
                name: "",
            });

            // Register end variable
            let end_var_id = self.ctx.id_gen.next_id();
            self.local_types.insert(end_var_id._value, iter_ty);
            self.local_defs.push(IrLocalDef {
                id: end_var_id,
                ty: iter_ty,
                name: "",
            });

            // let i = start
            let let_start = IrExpr::void_expr(self.ctx.void_ty);
            let_start.tag = IR_LET;
            let_start.id = loop_var_id;
            let_start.ir_ty = iter_ty;
            let_start.opt_expr = Option::some(ir_start);
            let ir_let_start = self.ctx.arena.alloc(let_start) as &IrExpr;

            // let _end = end
            let let_end = IrExpr::void_expr(self.ctx.void_ty);
            let_end.tag = IR_LET;
            let_end.id = end_var_id;
            let_end.ir_ty = iter_ty;
            let_end.opt_expr = Option::some(ir_end);
            let ir_let_end = self.ctx.arena.alloc(let_end) as &IrExpr;

            // i (read)
            let read_i = IrExpr::void_expr(iter_ty);
            read_i.tag = IR_LOCAL;
            read_i.id = loop_var_id;
            let ir_read_i = self.ctx.arena.alloc(read_i) as &IrExpr;

            // _end (read)
            let read_end = IrExpr::void_expr(iter_ty);
            read_end.tag = IR_LOCAL;
            read_end.id = end_var_id;
            let ir_read_end = self.ctx.arena.alloc(read_end) as &IrExpr;

            // i < _end (or i <= _end for inclusive)
            let bool_ty = self.ctx.intern_builtin_ty(BuiltinType::Bool);
            let cond = IrExpr::void_expr(bool_ty);
            cond.tag = IR_BINARY;
            cond.bin_op = if range_expr.flag { BinOp::Le } else { BinOp::Lt };
            cond.lhs = ir_read_i;
            cond.rhs = ir_read_end;
            let ir_cond = self.ctx.arena.alloc(cond) as &IrExpr;

            // Lower body
            let ir_body = self.lower_expr(expr.rhs);

            // i (read again for increment)
            let read_i2 = IrExpr::void_expr(iter_ty);
            read_i2.tag = IR_LOCAL;
            read_i2.id = loop_var_id;
            let ir_read_i2 = self.ctx.arena.alloc(read_i2) as &IrExpr;

            // 1 literal
            let one_lit = IrExpr::void_expr(iter_ty);
            one_lit.tag = IR_INT_LIT;
            one_lit.int_val = 1;
            let ir_one = self.ctx.arena.alloc(one_lit) as &IrExpr;

            // i + 1
            let add_expr = IrExpr::void_expr(iter_ty);
            add_expr.tag = IR_BINARY;
            add_expr.bin_op = BinOp::Add;
            add_expr.lhs = ir_read_i2;
            add_expr.rhs = ir_one;
            let ir_add = self.ctx.arena.alloc(add_expr) as &IrExpr;

            // i = i + 1
            let incr = IrExpr::void_expr(self.ctx.void_ty);
            incr.tag = IR_ASSIGN;
            incr.lhs = ir_read_i2;
            incr.rhs = ir_add;
            let ir_incr = self.ctx.arena.alloc(incr) as &IrExpr;

            // while body block: { body; i = i + 1; }
            let body_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(2);
            body_stmts[0] = ir_body;
            body_stmts[1] = ir_incr;
            let body_block = IrExpr::void_expr(self.ctx.void_ty);
            body_block.tag = IR_BLOCK;
            body_block.items = body_stmts;
            let ir_body_block = self.ctx.arena.alloc(body_block) as &IrExpr;

            // while i < _end { body; i = i + 1; }
            let while_expr = IrExpr::void_expr(self.ctx.void_ty);
            while_expr.tag = IR_WHILE;
            while_expr.cond = ir_cond;
            while_expr.lhs = ir_body_block;
            let ir_while = self.ctx.arena.alloc(while_expr) as &IrExpr;

            // Full block: { let i = start; let _end = end; while ... }
            let block_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(3);
            block_stmts[0] = ir_let_start;
            block_stmts[1] = ir_let_end;
            block_stmts[2] = ir_while;
            let block = IrExpr::void_expr(self.ctx.void_ty);
            block.tag = IR_BLOCK;
            block.items = block_stmts;
            self.ctx.arena.alloc(block)
        } else if expr.tag == EXPR_SWITCH {
            let ir_value = self.lower_expr(expr.lhs);
            let ir_arms = self.ctx.arena.alloc_slice::<IrSwitchArm>(expr.switch_arms.len());
            for i in 0usize..expr.switch_arms.len() {
                let values = self.ctx.arena.alloc_slice::<u64>(expr.switch_arms[i].pattern.len());
                for j in 0usize..expr.switch_arms[i].pattern.len() {
                    let pat_expr = self.lower_expr(expr.switch_arms[i].pattern[j]);
                    if pat_expr.tag == IR_INT_LIT {
                        values[j] = pat_expr.int_val;
                    } else {
                        values[j] = 0;
                    }
                }
                ir_arms[i] = IrSwitchArm {
                    values: values,
                    body: self.lower_expr(expr.switch_arms[i].body),
                    is_default: expr.switch_arms[i].pattern.len() == 0,
                };
            }
            let result_ty = if expr.switch_arms.len() > 0 { ir_arms[0].body.ty } else { self.ctx.void_ty };
            let result = IrExpr::void_expr(result_ty);
            result.tag = IR_SWITCH;
            result.lhs = ir_value;
            result.switch_arms = ir_arms;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_BREAK {
            let ir_val: Option<&IrExpr> = if expr.opt_expr.is_some() {
                Option::some(self.lower_expr(expr.opt_expr.unwrap()))
            } else {
                Option::none()
            };
            let result = IrExpr::void_expr(self.ctx.never_ty);
            result.tag = IR_BREAK;
            result.opt_expr = ir_val;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_CONTINUE {
            let result = IrExpr::void_expr(self.ctx.never_ty);
            result.tag = IR_CONTINUE;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_RETURN {
            if expr.opt_expr.is_some() {
                let ir_val = self.lower_expr_coerced(expr.opt_expr.unwrap(), self.return_type);
                let result = IrExpr::void_expr(self.ctx.never_ty);
                result.tag = IR_RETURN;
                result.opt_expr = Option::some(ir_val);
                self.ctx.arena.alloc(result)
            } else {
                let result = IrExpr::void_expr(self.ctx.never_ty);
                result.tag = IR_RETURN;
                self.ctx.arena.alloc(result)
            }
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower memory operations: EXPR_REF, EXPR_DEREF, EXPR_FIELD_ACCESS, EXPR_TUPLE_INDEX, EXPR_INDEX, EXPR_CAST, EXPR_TYPE_CHECK
    fn lower_memory(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_REF {
            let ir_inner = self.lower_expr(expr.lhs);
            let ptr_ty = self.ctx.make_ptr_ty(ir_inner.ty, !expr.flag);
            let result = IrExpr::void_expr(ptr_ty);
            result.tag = IR_REF;
            result.lhs = ir_inner;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_DEREF {
            let ir_inner = self.lower_expr(expr.lhs);
            let pointee_ty = if ir_inner.ty.tag == IRTY_POINTER {
                ir_inner.ty.inner
            } else {
                self.ctx.void_ty
            };
            let result = IrExpr::void_expr(pointee_ty);
            result.tag = IR_DEREF;
            result.lhs = ir_inner;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_FIELD_ACCESS {
            let ir_obj = self.lower_expr(expr.lhs);
            // Auto-deref through pointers for field access
            let actual_obj = ir_obj;
            loop {
                if actual_obj.ty.tag != IRTY_POINTER {
                    break;
                }
                let deref_ty = actual_obj.ty.inner;
                let deref_expr = IrExpr::void_expr(deref_ty);
                deref_expr.tag = IR_DEREF;
                deref_expr.lhs = actual_obj;
                actual_obj = self.ctx.arena.alloc(deref_expr);
            }
            // Find field index on the dereferenced struct type
            let (field_idx, field_ty) = self.resolve_field(actual_obj.ty, expr.str_val);
            let result = IrExpr::void_expr(field_ty);
            result.tag = IR_FIELD_ACCESS;
            result.lhs = actual_obj;
            result.field_idx = field_idx;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_TUPLE_INDEX {
            let ir_obj = self.lower_expr(expr.lhs);
            let elem_ty = if ir_obj.ty.tag == IRTY_TUPLE {
                if expr.index_val < ir_obj.ty.elems.len() { ir_obj.ty.elems[expr.index_val] } else { self.ctx.void_ty }
            } else {
                self.ctx.void_ty
            };
            let result = IrExpr::void_expr(elem_ty);
            result.tag = IR_FIELD_ACCESS;
            result.lhs = ir_obj;
            result.field_idx = expr.index_val as u32;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_INDEX {
            let ir_base = self.lower_expr(expr.lhs);

            // Check for range indexing (sub-slicing): data[a..b] or data[n..]
            if expr.rhs.tag == EXPR_RANGE {
                return self.lower_subslice(ir_base, expr.rhs);
            }

            let ir_index = self.lower_expr(expr.rhs);

            // Handle slice indexing: extract data pointer, then index
            if self.is_slice_ty(ir_base.ty) {
                let elem_ty = self.slice_elem_ty(ir_base.ty);
                // Extract the data pointer (field 0 of the fat pointer tuple)
                let data_ptr_ty = ir_base.ty.elems[0];
                let data_ptr = IrExpr::void_expr(data_ptr_ty);
                data_ptr.tag = IR_FIELD_ACCESS;
                data_ptr.lhs = ir_base;
                data_ptr.field_idx = 0u32;
                let data_ptr_ref = self.ctx.arena.alloc(data_ptr);
                // Index into the data pointer
                let result = IrExpr::void_expr(elem_ty);
                result.tag = IR_INDEX;
                result.lhs = data_ptr_ref;
                result.rhs = ir_index;
                return self.ctx.arena.alloc(result);
            }

            let elem_ty = if ir_base.ty.tag == IRTY_ARRAY {
                ir_base.ty.inner
            } else if ir_base.ty.tag == IRTY_POINTER {
                ir_base.ty.inner
            } else {
                self.ctx.void_ty
            };
            let result = IrExpr::void_expr(elem_ty);
            result.tag = IR_INDEX;
            result.lhs = ir_base;
            result.rhs = ir_index;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_CAST {
            let ir_inner = self.lower_expr(expr.lhs);
            let ir_ty = self.resolve_type(expr.ty);
            let result = IrExpr::void_expr(ir_ty);
            result.tag = IR_CAST;
            result.lhs = ir_inner;
            result.ir_ty = ir_ty;
            self.ctx.arena.alloc(result)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Coerce a value to a target type (e.g., pointer-to-array → slice)
    fn coerce_to_type(self: &mut Mono, val: &IrExpr, target_ty: &IrTy) -> &IrExpr {
        // Coerce &[T; N] to &[T] (pointer to array → slice fat pointer)
        if self.is_slice_ty(target_ty) && val.ty.tag == IRTY_POINTER && val.ty.inner.tag == IRTY_ARRAY {
            let array_ty = val.ty.inner;
            let elem_ty = array_ty.inner;
            let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);

            // Data pointer: cast the array pointer to element pointer
            let data_ptr_ty = self.ctx.make_ptr_ty(elem_ty, false);
            let data_ptr = IrExpr::void_expr(data_ptr_ty);
            data_ptr.tag = IR_CAST;
            data_ptr.lhs = val;
            data_ptr.ir_ty = data_ptr_ty;
            let data_ptr_ref = self.ctx.arena.alloc(data_ptr);

            // Length: array size as usize literal
            let len_expr = IrExpr::void_expr(usize_ty);
            len_expr.tag = IR_INT_LIT;
            len_expr.int_val = array_ty.array_size as u64;
            let len_ref = self.ctx.arena.alloc(len_expr);

            // Build tuple {data_ptr, len}
            let items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
            items[0] = data_ptr_ref;
            items[1] = len_ref;
            let tuple_result = IrExpr::void_expr(target_ty);
            tuple_result.tag = IR_TUPLE_LIT;
            tuple_result.items = items;
            return self.ctx.arena.alloc(tuple_result);
        }
        // No coercion needed
        val
    }

    // Check if a type is a slice
    fn is_slice_ty(self: &Mono, ty: &IrTy) -> bool {
        if ty.tag == IRTY_SLICE { return true; }
        // Also detect tuples that look like slices (legacy representation)
        if ty.tag == IRTY_TUPLE && ty.elems.len() == 2 {
            return ty.elems[0].tag == IRTY_POINTER;
        }
        false
    }

    // Get the element type of a slice
    fn slice_elem_ty(self: &Mono, ty: &IrTy) -> &IrTy {
        // Slice is {&T, usize}, so elem type is the pointer's inner type
        ty.elems[0].inner
    }

    // Lower sub-slice indexing: data[a..b], data[n..], data[..m]
    fn lower_subslice(self: &mut Mono, base: &IrExpr, range_expr: &Expr) -> &IrExpr {
        if !self.is_slice_ty(base.ty) {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }

        let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);

        // Extract data pointer (field 0) and length (field 1)
        let data_ptr_ty = base.ty.elems[0];
        let data_ptr = IrExpr::void_expr(data_ptr_ty);
        data_ptr.tag = IR_FIELD_ACCESS;
        data_ptr.lhs = base;
        data_ptr.field_idx = 0u32;
        let ir_data_ptr = self.ctx.arena.alloc(data_ptr) as &IrExpr;

        let base_len = IrExpr::void_expr(usize_ty);
        base_len.tag = IR_FIELD_ACCESS;
        base_len.lhs = base;
        base_len.field_idx = 1u32;
        let ir_base_len = self.ctx.arena.alloc(base_len) as &IrExpr;

        // Start offset (default 0)
        let ir_start = if range_expr.lhs as usize != 0 {
            self.lower_expr(range_expr.lhs)
        } else {
            let zero = IrExpr::void_expr(usize_ty);
            zero.tag = IR_INT_LIT;
            zero.int_val = 0;
            self.ctx.arena.alloc(zero) as &IrExpr
        };

        // End offset (default base.len())
        let ir_end = if range_expr.rhs as usize != 0 {
            self.lower_expr(range_expr.rhs)
        } else {
            ir_base_len
        };

        // new_ptr = data_ptr + start (pointer arithmetic via index)
        let new_ptr = IrExpr::void_expr(data_ptr_ty);
        new_ptr.tag = IR_INDEX;
        new_ptr.lhs = ir_data_ptr;
        new_ptr.rhs = ir_start;
        let ir_new_ptr_idx = self.ctx.arena.alloc(new_ptr) as &IrExpr;
        // Take reference to get pointer
        let new_ptr_ref = IrExpr::void_expr(data_ptr_ty);
        new_ptr_ref.tag = IR_REF;
        new_ptr_ref.lhs = ir_new_ptr_idx;
        let ir_new_ptr = self.ctx.arena.alloc(new_ptr_ref) as &IrExpr;

        // new_len = end - start
        let new_len = IrExpr::void_expr(usize_ty);
        new_len.tag = IR_BINARY;
        new_len.bin_op = BinOp::Sub;
        new_len.lhs = ir_end;
        new_len.rhs = ir_start;
        let ir_new_len = self.ctx.arena.alloc(new_len) as &IrExpr;

        // Build tuple {new_ptr, new_len}
        let elems = self.ctx.arena.alloc_slice::<&IrExpr>(2);
        elems[0] = ir_new_ptr;
        elems[1] = ir_new_len;
        let result = IrExpr::void_expr(base.ty);
        result.tag = IR_TUPLE_LIT;
        result.items = elems;
        self.ctx.arena.alloc(result)
    }

    // Get the struct type from an IrTy, auto-dereffing through pointers
    fn get_struct_ty(self: &Mono, ty: &IrTy) -> Option<&IrTy> {
        if ty.tag == IRTY_STRUCT {
            Option::some(ty)
        } else if ty.tag == IRTY_POINTER {
            self.get_struct_ty(ty.inner)
        } else {
            Option::none()
        }
    }

    // Try to resolve a method call: obj.method(args) -> Type::method(&obj, args)
    fn try_lower_method_call(self: &mut Mono, expr: &Expr) -> Option<&IrExpr> {
        // expr is EXPR_CALL, expr.lhs is EXPR_FIELD_ACCESS
        let field_expr = expr.lhs;
        let ir_obj = self.lower_expr(field_expr.lhs);
        let method_name = field_expr.str_val;

        // Handle slice built-in methods
        let slice_ty = ir_obj.ty;
        let is_ptr_to_slice = false;
        if slice_ty.tag == IRTY_POINTER && self.is_slice_ty(slice_ty.inner) {
            slice_ty = slice_ty.inner;
            is_ptr_to_slice = true;
        }
        if self.is_slice_ty(slice_ty) {
            if method_name == "len" {
                // slice.len() -> extract field 1 (the length)
                let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
                // If we have a pointer to slice, deref first
                let slice_val = if is_ptr_to_slice {
                    let deref_expr = IrExpr::void_expr(slice_ty);
                    deref_expr.tag = IR_DEREF;
                    deref_expr.lhs = ir_obj;
                    self.ctx.arena.alloc(deref_expr) as &IrExpr
                } else {
                    ir_obj
                };
                let result = IrExpr::void_expr(usize_ty);
                result.tag = IR_FIELD_ACCESS;
                result.lhs = slice_val;
                result.field_idx = 1u32;
                let allocated: &IrExpr = self.ctx.arena.alloc(result) as &IrExpr;
                return Option::some(allocated);
            } else if method_name == "copy_to_nonoverlapping" || method_name == "copy_to" {
                // slice.copy_to_nonoverlapping(&dest) -> memcpy
                // First arg to method is the destination pointer
                if expr.args.len() >= 1 {
                    let dest_arg = self.lower_expr(expr.args[0]);
                    let slice_val = if is_ptr_to_slice {
                        let deref_expr = IrExpr::void_expr(slice_ty);
                        deref_expr.tag = IR_DEREF;
                        deref_expr.lhs = ir_obj;
                        self.ctx.arena.alloc(deref_expr) as &IrExpr
                    } else {
                        ir_obj
                    };
                    // Build memcpy call: memcpy(dest, src_ptr, len * elem_size)
                    let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
                    // Extract src ptr (field 0)
                    let ptr_ty = self.ctx.make_ptr_ty(slice_ty.inner, slice_ty.is_const);
                    let src_ptr_expr = IrExpr::void_expr(ptr_ty);
                    src_ptr_expr.tag = IR_FIELD_ACCESS;
                    src_ptr_expr.lhs = slice_val;
                    src_ptr_expr.field_idx = 0u32;
                    let src_ptr = self.ctx.arena.alloc(src_ptr_expr);
                    // Extract len (field 1)
                    let len_expr = IrExpr::void_expr(usize_ty);
                    len_expr.tag = IR_FIELD_ACCESS;
                    len_expr.lhs = slice_val;
                    len_expr.field_idx = 1u32;
                    let len_val = self.ctx.arena.alloc(len_expr);
                    // Build IR_MEMCPY
                    let void_ty = self.ctx.void_ty;
                    let result = IrExpr::void_expr(void_ty);
                    result.tag = IR_MEMCPY;
                    result.lhs = dest_arg;       // dest ptr
                    result.rhs = src_ptr;        // src ptr
                    result.cond = len_val;       // length in elements
                    result.ir_ty = slice_ty.inner; // elem type for size calc
                    return Option::some(self.ctx.arena.alloc(result) as &IrExpr);
                }
            } else if method_name == "is_empty" {
                let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
                let slice_val = if is_ptr_to_slice {
                    let deref_expr = IrExpr::void_expr(slice_ty);
                    deref_expr.tag = IR_DEREF;
                    deref_expr.lhs = ir_obj;
                    self.ctx.arena.alloc(deref_expr) as &IrExpr
                } else {
                    ir_obj
                };
                // len == 0
                let len_expr = IrExpr::void_expr(usize_ty);
                len_expr.tag = IR_FIELD_ACCESS;
                len_expr.lhs = slice_val;
                len_expr.field_idx = 1u32;
                let len_val = self.ctx.arena.alloc(len_expr);
                let zero = IrExpr::void_expr(usize_ty);
                zero.tag = IR_INT_LIT;
                zero.int_val = 0u64;
                let zero_val = self.ctx.arena.alloc(zero);
                let result = IrExpr::void_expr(self.ctx.bool_ty);
                result.tag = IR_BINARY;
                result.bin_op = BinOp::Eq;
                result.lhs = len_val;
                result.rhs = zero_val;
                return Option::some(self.ctx.arena.alloc(result) as &IrExpr);
            }
            // Other slice methods could go here
            return Option::none();
        }

        // Get the struct or enum type (auto-deref)
        let scope_idx: u32 = 0u32;
        let method_type_args: &[&IrTy] = &[];
        let resolved_ty = ir_obj.ty;
        if resolved_ty.tag == IRTY_POINTER {
            resolved_ty = resolved_ty.inner;
        }
        if resolved_ty.tag == IRTY_STRUCT {
            scope_idx = resolved_ty.struct_ref.scope_idx;
            method_type_args = resolved_ty.struct_ref.type_args;
        } else if resolved_ty.tag == IRTY_ENUM {
            scope_idx = resolved_ty.enum_ref.scope_idx;
        } else {
            return Option::none();
        }
        if scope_idx == 0 {
            return Option::none();
        }

        // Look up method in type's scope
        let method_item = self.ctx.scopes.get(scope_idx).items.get(&method_name);
        if method_item.is_none() {
            return Option::none();
        }
        let item = method_item.unwrap();

        // Get the function id
        let fn_id = if item.kind.tag == NIK_FUNCTION {
            item.kind.id
        } else if item.kind.tag == NIK_METHOD {
            item.kind.id2
        } else {
            return Option::none();
        };

        // Look up the FnDef
        let fn_def = self.ctx.fn_defs.get(&fn_id._value);
        if fn_def.is_none() {
            return Option::none();
        }
        let def = fn_def.unwrap();

        // Monomorphize the method with type args (for generic impls)
        let fn_idx = self.mono_function(def, method_type_args);
        let ir_fn = &self.ctx.ir_functions[fn_idx];

        // Build args: &obj as first arg, then the call args
        let total_args = 1usize + expr.args.len();
        let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(total_args);

        // First arg is &obj (take reference if obj is not already a pointer)
        if ir_obj.ty.tag == IRTY_POINTER {
            ir_args[0] = ir_obj;
        } else {
            let ref_ty = self.ctx.arena.alloc(IrTy::mk_pointer(ir_obj.ty, false));
            let ref_expr = IrExpr::void_expr(ref_ty);
            ref_expr.tag = IR_REF;
            ref_expr.lhs = ir_obj;
            ir_args[0] = self.ctx.arena.alloc(ref_expr);
        }

        // Rest of the args
        for i in 0usize..expr.args.len() {
            ir_args[1 + i] = self.lower_expr(expr.args[i]);
        }

        // Build direct call
        let ret_ty = ir_fn.return_type;
        let result = IrExpr::void_expr(ret_ty);
        result.tag = IR_CALL;
        result.call_target = IrCallTarget {
            tag: CALL_DIRECT,
            fn_ref: IrFnRef { id: ir_fn.id, mangled_name: ir_fn.mangled_name },
            callee: std::mem::zeroed::<&IrExpr>(),
        };
        result.items = ir_args;
        let allocated: &IrExpr = self.ctx.arena.alloc(result) as &IrExpr;
        Option::some(allocated)
    }

    // Lower call expressions: EXPR_CALL, EXPR_STRUCT_LIT
    fn lower_lambda(self: &mut Mono, expr: &Expr) -> &IrExpr {
        // Create an anonymous function for the lambda
        let lambda_id = self.ctx.id_gen.next_id();
        let mangled = self.ctx.mangle_name("lambda");

        // Resolve parameter types
        let params = self.ctx.arena.alloc_slice::<IrParam>(expr.lambda_params.len());
        let param_types = self.ctx.arena.alloc_slice::<&IrTy>(expr.lambda_params.len());

        // Save current mono state
        let saved_local_types = self.local_types;
        let saved_local_defs = self.local_defs;
        let saved_return_type = self.return_type;
        self.local_types = HashMap::new();
        self.local_defs = Vector::new();

        for i in 0usize..expr.lambda_params.len() {
            let lp = &expr.lambda_params[i];
            let param_ty = if lp.ty.is_some() {
                self.resolve_type(lp.ty.unwrap())
            } else {
                self.ctx.void_ty
            };
            params[i] = IrParam {
                id: lp.id,
                ty: param_ty,
                name: lp.name,
            };
            param_types[i] = param_ty;
            self.local_types.insert(lp.id._value, param_ty);
        }

        // Resolve return type
        let ret_ty = if expr.opt_ty.is_some() {
            self.resolve_type(expr.opt_ty.unwrap())
        } else {
            self.ctx.void_ty
        };
        self.return_type = ret_ty;

        // Reserve index
        let idx = self.ctx.ir_functions.len();
        let placeholder = IrFunction {
            id: lambda_id,
            name: "lambda",
            mangled_name: mangled,
            params: params,
            return_type: ret_ty,
            body: Option::none(),
            local_defs: &[],
            attributes: &[],
            is_variadic: false,
            abi: Option::none(),
        };
        self.ctx.ir_functions.push(placeholder);

        // Lower body
        let body = self.lower_expr(expr.lhs);

        // Collect local defs
        let local_defs_slice = self.ctx.arena.alloc_slice::<IrLocalDef>(self.local_defs.len());
        for i in 0usize..self.local_defs.len() {
            local_defs_slice[i] = self.local_defs[i];
        }

        self.ctx.ir_functions[idx].body = Option::some(body);
        self.ctx.ir_functions[idx].local_defs = local_defs_slice;

        // Restore mono state
        self.local_types.free();
        self.local_defs.free();
        self.local_types = saved_local_types;
        self.local_defs = saved_local_defs;
        self.return_type = saved_return_type;

        // Build function pointer type and return reference
        let fn_ty = self.ctx.make_fn_ptr_ty(param_types, ret_ty);
        let result = IrExpr::void_expr(fn_ty);
        result.tag = IR_FN_REF;
        result.fn_ref = IrFnRef {
            id: lambda_id,
            mangled_name: mangled,
        };
        self.ctx.arena.alloc(result)
    }

    fn lower_call(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_CALL {
            // Check for method call: obj.method(args)
            if expr.lhs.tag == EXPR_FIELD_ACCESS {
                let method_result = self.try_lower_method_call(expr);
                if method_result.is_some() {
                    return method_result.unwrap();
                }
                // Fall through to normal field access (function pointer in struct field)
            }

            // Check for turbofish generic calls: func::<T>(args)
            if expr.type_args.len() > 0 && expr.lhs.tag == EXPR_FN_REF {
                // Resolve type args
                let resolved_type_args = self.ctx.arena.alloc_slice::<&IrTy>(expr.type_args.len());
                for i in 0usize..expr.type_args.len() {
                    resolved_type_args[i] = self.resolve_type(expr.type_args[i]);
                }

                // Look up the function definition
                let fn_def = self.ctx.fn_defs.get(&expr.lhs.id._value);
                if fn_def.is_some() {
                    let def = fn_def.unwrap();

                    // Check for #[lang(slice_new)] intrinsic
                    let is_slice_new = false;
                    for attr in def.attributes {
                        if attr.tag == ATTR_LANG && attr.str_val == "slice_new" {
                            is_slice_new = true;
                        }
                    }

                    if is_slice_new && expr.args.len() == 2 {
                        // #[lang(slice_new)] intrinsic: construct slice from (ptr, len)
                        let ir_ptr = self.lower_expr(expr.args[0]);
                        let ir_len = self.lower_expr(expr.args[1]);

                        // Build proper IRTY_SLICE type from the pointer's element type
                        let elem_ty = if ir_ptr.ty.tag == IRTY_POINTER {
                            ir_ptr.ty.inner
                        } else {
                            self.ctx.intern_builtin_ty(BuiltinType::U8)
                        };
                        let is_const = ir_ptr.ty.is_const;
                        let slice_ty = self.ctx.make_slice_ty(elem_ty, is_const);

                        let items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                        items[0] = ir_ptr;
                        items[1] = ir_len;

                        let result = IrExpr::void_expr(slice_ty);
                        result.tag = IR_TUPLE_LIT;
                        result.items = items;
                        return self.ctx.arena.alloc(result);
                    }

                    // Monomorphize the function with type args
                    let fn_idx = self.mono_function(def, resolved_type_args);
                    let ir_fn = &self.ctx.ir_functions[fn_idx];

                    // Lower arguments
                    let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len());
                    for i in 0usize..expr.args.len() {
                        ir_args[i] = self.lower_expr(expr.args[i]);
                    }

                    let fn_ref = IrFnRef {
                        id: ir_fn.id,
                        mangled_name: ir_fn.mangled_name,
                    };

                    let result = IrExpr::void_expr(ir_fn.return_type);
                    result.tag = IR_CALL;
                    result.call_target = IrCallTarget { tag: CALL_DIRECT, fn_ref: fn_ref, callee: std::mem::zeroed::<&IrExpr>() };
                    result.items = ir_args;
                    return self.ctx.arena.alloc(result);
                }
            }

            let ir_callee = self.lower_expr(expr.lhs);
            let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len());
            for i in 0usize..expr.args.len() {
                ir_args[i] = self.lower_expr(expr.args[i]);
            }

            // Determine return type from callee
            let ret_ty = if ir_callee.ty.tag == IRTY_FN_POINTER {
                ir_callee.ty.ret_ty
            } else {
                self.ctx.void_ty
            };

            let result = IrExpr::void_expr(ret_ty);
            result.tag = IR_CALL;
            result.call_target = IrCallTarget { tag: CALL_INDIRECT, fn_ref: IrFnRef::empty(), callee: ir_callee };
            result.items = ir_args;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_STRUCT_LIT {
            let ir_ty = self.resolve_type(expr.ty);
            let ir_fields = self.ctx.arena.alloc_slice::<&IrExpr>(expr.field_inits.len());
            for i in 0usize..expr.field_inits.len() {
                // Get the expected field type for implicit coercion
                let field_ty = if ir_ty.tag == IRTY_STRUCT && i < ir_ty.struct_ref.fields.len() {
                    ir_ty.struct_ref.fields[i].ty
                } else {
                    self.ctx.void_ty
                };
                ir_fields[i] = self.lower_expr_coerced(expr.field_inits[i].value, field_ty);
            }
            let result = IrExpr::void_expr(ir_ty);
            result.tag = IR_STRUCT_LIT;
            result.ir_ty = ir_ty;
            result.items = ir_fields;
            self.ctx.arena.alloc(result)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower block-like expressions: EXPR_BLOCK, EXPR_LET, EXPR_DEFER
    fn lower_block(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == EXPR_BLOCK {
            let ir_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args.len());
            let result_ty = self.ctx.void_ty;
            for i in 0usize..expr.args.len() {
                ir_stmts[i] = self.lower_expr(expr.args[i]);
                if i == expr.args.len() - 1 {
                    result_ty = ir_stmts[i].ty;
                }
            }
            let result = IrExpr::void_expr(result_ty);
            result.tag = IR_BLOCK;
            result.items = ir_stmts;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_LET {
            let var_ty = if expr.opt_ty.is_some() {
                self.resolve_type(expr.opt_ty.unwrap())
            } else if expr.opt_expr.is_some() {
                let ir_init = self.lower_expr(expr.opt_expr.unwrap());
                let inferred = ir_init.ty;
                self.local_types.insert(expr.id._value, inferred);
                self.local_defs.push(IrLocalDef {
                    id: expr.id,
                    ty: inferred,
                    name: "",
                });
                let result = IrExpr::void_expr(self.ctx.void_ty);
                result.tag = IR_LET;
                result.id = expr.id;
                result.ir_ty = inferred;
                result.opt_expr = Option::some(ir_init);
                return self.ctx.arena.alloc(result);
            } else {
                self.ctx.void_ty
            };

            self.local_types.insert(expr.id._value, var_ty);
            self.local_defs.push(IrLocalDef {
                id: expr.id,
                ty: var_ty,
                name: "",
            });

            let ir_init: Option<&IrExpr> = if expr.opt_expr.is_some() {
                let init_val = self.lower_expr_coerced(expr.opt_expr.unwrap(), var_ty);
                // Coerce pointer-to-array to slice if needed
                Option::some(self.coerce_to_type(init_val, var_ty))
            } else {
                Option::none()
            };

            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_LET;
            result.id = expr.id;
            result.ir_ty = var_ty;
            result.opt_expr = ir_init;
            self.ctx.arena.alloc(result)
        } else if expr.tag == EXPR_DEFER {
            let ir_inner = self.lower_expr(expr.lhs);
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IR_DEFER;
            result.lhs = ir_inner;
            self.ctx.arena.alloc(result)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    fn resolve_field(self: &mut Mono, ty: &IrTy, field_name: &[u8]) -> (u32, &IrTy) {
        if ty.tag == IRTY_STRUCT {
            for i in 0usize..ty.struct_ref.fields.len() {
                if ty.struct_ref.fields[i].name == field_name {
                    return (i as u32, ty.struct_ref.fields[i].ty);
                }
            }
            (0u32, self.ctx.void_ty)
        } else if ty.tag == IRTY_POINTER {
            // Auto-deref
            self.resolve_field(ty.inner, field_name)
        } else {
            (0u32, self.ctx.void_ty)
        }
    }

    fn free(self: &mut Mono) {
        self.type_map.free();
        self.local_types.free();
        self.local_defs.free();
    }
}

// ============================================================
// Top-level monomorphization entry point
// ============================================================

fn monomorphize(
    arena: &mut Arena,
    scopes: &ScopeArena,
    id_gen: &mut IdGen,
    diag: &mut DiagnosticContext,
    items: &[Item],
) -> CompilationUnit {
    let ctx = MonoCtx::new(arena, scopes, id_gen, diag, items);

    // Find all root items (exported functions, main, statics)
    for ii in 0usize..items.len() {
        let item = &items[ii];
        if item.tag == ITEM_FUNCTION {
            let fn_def = &item.fn_def;
            let is_root = false;
            for attr in fn_def.attributes {
                if attr.tag == ATTR_EXPORT {
                    is_root = true;
                } else if attr.tag == ATTR_MAIN {
                    is_root = true;
                } else if attr.tag == ATTR_TEST {
                    is_root = true;
                }
            }
            if is_root {
                let mono = Mono::new(&ctx);
                mono.mono_function(fn_def, &[]);
                mono.free();
            }
        } else if item.tag == ITEM_STATIC {
            // Process statics - only process extern statics eagerly
            // Other statics will be processed on demand when referenced
            let sd = &item.static_def;
            let is_extern = false;
            for attr in sd.attributes {
                if attr.tag == ATTR_EXTERN {
                    is_extern = true;
                }
            }
            if !is_extern {
                continue;
            }
            let mono = Mono::new(&ctx);
            let ty = if sd.ty.is_some() {
                mono.resolve_type(sd.ty.unwrap())
            } else {
                ctx.void_ty
            };

            let init: Option<&IrExpr> = if sd.init.is_some() {
                Option::some(mono.lower_expr(sd.init.unwrap()))
            } else {
                Option::none()
            };

            let is_extern = false;
            for attr in sd.attributes {
                if attr.tag == ATTR_EXTERN {
                    is_extern = true;
                }
            }

            ctx.ir_globals.push(IrGlobal {
                id: sd.id,
                name: sd.name,
                mangled_name: sd.name,
                ty: ty,
                init: init,
                is_const: sd.is_const,
                is_extern: is_extern,
                attributes: sd.attributes,
            });
            mono.free();
        }
    }

    // Build compilation unit
    let fns = arena.alloc_slice::<IrFunction>(ctx.ir_functions.len());
    for i in 0usize..ctx.ir_functions.len() {
        fns[i] = ctx.ir_functions[i];
    }
    let globals = arena.alloc_slice::<IrGlobal>(ctx.ir_globals.len());
    for i in 0usize..ctx.ir_globals.len() {
        globals[i] = ctx.ir_globals[i];
    }
    let structs = arena.alloc_slice::<IrStructRef>(ctx.ir_structs.len());
    for i in 0usize..ctx.ir_structs.len() {
        structs[i] = ctx.ir_structs[i];
    }
    let enums = arena.alloc_slice::<IrEnumRef>(ctx.ir_enums.len());
    for i in 0usize..ctx.ir_enums.len() {
        enums[i] = ctx.ir_enums[i];
    }

    ctx.free();

    CompilationUnit {
        functions: fns,
        globals: globals,
        structs: structs,
        enums: enums,
    }
}

// ============================================================
// Helper functions
// ============================================================

fn hash_mono_key(id: Id, type_args: &[&IrTy]) -> u64 {
    let h: u64 = id._value as u64;
    for arg in type_args {
        h = h * 31 + (arg as &void as usize) as u64;
    }
    h
}

fn format_usize(n: usize, arena: &mut Arena) -> &[u8] {
    if n == 0 {
        let buf = arena.alloc_slice::<u8>(1);
        buf[0] = '0' as u8;
        return buf;
    }

    // Count digits
    let temp = n;
    let digits: usize = 0;
    while temp > 0 {
        digits = digits + 1;
        temp = temp / 10;
    }

    let buf = arena.alloc_slice::<u8>(digits);
    temp = n;
    let i = digits;
    while temp > 0 {
        i = i - 1;
        buf[i] = ('0' as u8) + (temp % 10) as u8;
        temp = temp / 10;
    }
    buf
}
