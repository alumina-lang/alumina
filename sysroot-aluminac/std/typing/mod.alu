// Type reflection utilities

type TypeId = usize;

fn type_id<T>() -> TypeId {
    std::intrinsics::type_id::<T>() as TypeId
}

fn type_name<T>() -> &[u8] {
    std::intrinsics::type_name::<T>()
}

fn size_of<T>() -> usize {
    std::intrinsics::size_of::<T>()
}

fn align_of<T>() -> usize {
    std::intrinsics::align_of::<T>()
}

/// Returns true if T1 matches bound T2.
///
/// T2 can be a protocol or a type (in which case the result indicates
/// whether T1 and T2 refer to the same type).
///
/// Note: due to limitations in the current compiler, this only works
/// when T2 is a concrete type, not a protocol passed through a generic
/// parameter. Use the specific is_* functions for protocol checks.
fn matches<T1, T2>() -> bool {
    std::intrinsics::uninitialized::<T1>() is T2
}

/// Returns true if T1 and T2 are the same type.
fn is_same<T1, T2>() -> bool {
    type_id::<T1>() == type_id::<T2>()
}

/// Returns the name of a type as a string slice.
fn name_of<T>() -> &[u8] {
    type_name::<T>()
}

/// Returns `true` if T is void `()`.
fn is_void<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is ()
}

/// Returns `true` if T is zero sized.
fn is_zero_sized<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::ZeroSized
}

/// Returns `true` if T is a primitive type.
fn is_primitive<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Primitive
}

/// Returns `true` if T is numeric (integer or floating point).
fn is_numeric<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Numeric
}

/// Returns `true` if T is an integer type.
fn is_integer<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Integer
}

/// Returns `true` if T is a floating point type.
fn is_floating_point<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::FloatingPoint
}

/// Returns `true` if T is a signed type.
fn is_signed<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Signed
}

/// Returns `true` if T is an unsigned type.
fn is_unsigned<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Unsigned
}

/// Returns `true` if T is a pointer type.
fn is_pointer<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Pointer
}

/// Returns `true` if T is an array type.
fn is_array<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Array
}

/// Returns `true` if T is a tuple type.
fn is_tuple<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Tuple
}

/// Returns `true` if T is a struct type.
fn is_struct<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Struct
}

/// Returns `true` if T is an enum type.
fn is_enum<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Enum
}

/// Returns `true` if T is a union type.
fn is_union<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Union
}

/// Returns `true` if T is a closure type.
fn is_closure<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Closure
}

/// Returns `true` if T is a range type.
fn is_range<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Range
}

/// Returns `true` if T is a named function type.
fn is_named_function<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::NamedFunction
}

/// Returns `true` if T is a function pointer type.
fn is_function_pointer<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::FunctionPointer
}

/// Returns `true` if T is a protocol type.
fn is_protocol<T>() -> bool {
    std::intrinsics::uninitialized::<T>() is std::builtins::Protocol
}

/// Compile-time type descriptor (a zero-sized stub the compiler hangs
/// reflection methods off). `Type::new::<T>()` is the typical way to
/// obtain one. Mirrors sysroot's `std::typing::Type<T>`.
struct Type<T> {}

impl Type<T> {
    /// Creates a new type descriptor.
    #[lang(type_descriptor_new)]
    fn new() -> Type<T> {
        Type {}
    }

    /// Returns the name of the type.
    fn debug_name(self: Type<T>) -> &[u8] {
        type_name::<T>()
    }

    /// Returns the (compile-time) tuple of field descriptors for `T`.
    fn fields(self: Type<T>) -> typeof(std::intrinsics::fields::<T>()) {
        std::intrinsics::fields::<T>()
    }

    /// Returns the (compile-time) array of variant descriptors for `T`.
    fn variants(self: Type<T>) -> typeof(std::intrinsics::enum_variants::<T>()) {
        std::intrinsics::enum_variants::<T>()
    }

    fn is_void(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is () }
    fn is_zero_sized(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::ZeroSized }
    fn is_primitive(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Primitive }
    fn is_numeric(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Numeric }
    fn is_integer(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Integer }
    fn is_floating_point(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::FloatingPoint }
    fn is_signed(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Signed }
    fn is_unsigned(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Unsigned }
    fn is_pointer(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Pointer }
    fn is_array(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Array }
    fn is_tuple(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Tuple }
    fn is_struct(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Struct }
    fn is_union(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Union }
    fn is_enum(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Enum }
    fn is_closure(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Closure }
    fn is_range(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Range }
    fn is_named_function(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::NamedFunction }
    fn is_function_pointer(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::FunctionPointer }
    fn is_protocol(self: Type<T>) -> bool { std::intrinsics::uninitialized::<T>() is std::builtins::Protocol }

    /// Convert a named-function or closure `T` to a regular function pointer
    /// with matching argument and return types. Mirrors sysroot's
    /// `Type<T>::as_fn` so test runners can read fn pointers out of an
    /// `attributed`-produced tuple of Type<F> descriptors.
    fn as_fn(self: Type<T>) -> std::builtins::function_pointer_of<
        std::builtins::arguments_of<T>,
        std::builtins::return_type_of<T>
    > {
        std::util::unit::<T>()
    }

    /// Returns the type's module path or None for unnamed types.
    fn module_path(self: Type<T>) -> Option<&[u8]> {
        let p = std::intrinsics::module_path::<T>();
        when typeof(p) is () {
            Option::none()
        } else {
            Option::some(p)
        }
    }
}

/// Compile-time descriptor for an enum variant.
///
/// Returned in arrays by `intrinsics::enum_variants::<E>()`. The compiler
/// constructs each entry by calling the `enum_variant_new` lang item below
/// with the variant's name string and discriminant value.
struct EnumVariant<T> {
    _name: &[u8],
    _value: T,
}

impl EnumVariant<T> {
    /// The name of the enum variant.
    fn name(self: &EnumVariant<T>) -> &[u8] {
        self._name
    }

    /// The value (discriminant) of the enum variant.
    fn value(self: &EnumVariant<T>) -> T {
        self._value
    }
}

/// Compile-time descriptor for a struct/union field.
///
/// Returned (as the elements of a tuple) by `intrinsics::fields::<S>()`.
/// Each element is heterogeneous (`Field<S, T_i>` for the i-th field's type),
/// so the result is a tuple, not an array.
struct Field<StructT, FieldT> {
    _name: Option<&[u8]>,
    _offset: usize,
}

impl Field<StructT, FieldT> {
    /// The field's name. Returns `Option::none()` for tuple-positional fields.
    fn name(self: &Field<StructT, FieldT>) -> Option<&[u8]> {
        self._name
    }

    /// Byte offset of the field within the parent struct/union.
    fn offset(self: &Field<StructT, FieldT>) -> usize {
        self._offset
    }

    /// Returns the type descriptor for the field's type.
    fn type(self: &Field<StructT, FieldT>) -> Type<FieldT> {
        Type {}
    }

    /// Returns a pointer to the field within `inst` (the parent struct).
    fn as_ptr(self: &Field<StructT, FieldT>, inst: &StructT) -> &FieldT {
        ((inst as &u8) + self._offset) as &FieldT
    }

    /// Returns a mutable pointer to the field within `inst`.
    fn as_mut_ptr(self: &Field<StructT, FieldT>, inst: &mut StructT) -> &mut FieldT {
        ((inst as &mut u8) + self._offset) as &mut FieldT
    }
}

#[docs(no_index)]
mod internal {
    /// Lang-item constructor for an `EnumVariant<T>`. The compiler emits
    /// calls to this function from the `enum_variants` intrinsic, building
    /// up the array of variants for an enum type.
    #[lang(enum_variant_new)]
    #[inline(ir)]
    fn make_enum_variant<E>(name: &[u8], value: E) -> EnumVariant<E> {
        EnumVariant {
            _name: name,
            _value: value,
        }
    }

    /// Lang-item constructor for a named `Field<StructT, FieldT>`.
    #[lang(field_descriptor_new)]
    #[inline(ir)]
    fn make_field_desc<StructT, FieldT>(name: &[u8], offset: usize) -> Field<StructT, FieldT> {
        Field {
            _name: Option::some(name),
            _offset: offset,
        }
    }

    /// Lang-item constructor for an unnamed (positional) `Field<StructT, FieldT>`.
    #[lang(field_descriptor_new_unnamed)]
    #[inline(ir)]
    fn make_field_desc_unnamed<StructT, FieldT>(offset: usize) -> Field<StructT, FieldT> {
        Field {
            _name: Option::none(),
            _offset: offset,
        }
    }
}
