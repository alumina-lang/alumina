//! Optional values
//!
//! The `?` operator on Option types desugars to the `try` macro below.
//! To use `?` on Option values, add `use std::option::try;` to shadow
//! the default Result try macro from the prelude.

/// Try macro for Option: desugars `expr?` to early-return on none.
macro try($opt) {
    {
        let _opt = $opt;
        if _opt._is_some {
            _opt._inner
        } else {
            return Option::none()
        }
    }
}

/// Optional value
///
/// Optional values can either contain a value or they can be empty.
struct Option<T> {
    _is_some: bool,
    _inner: T,
}

impl Option<T> {
    /// Create a populated `Option` value
    fn some(inner: T) -> Option<T> {
        Option::<T> {
            _is_some: true,
            _inner: inner,
        }
    }

    /// Create an empty `Option` value
    fn none() -> Option<T> {
        std::mem::zeroed::<Option<T>>()
    }

    /// Returns `true` if the option is populated, `false` otherwise.
    fn is_some(self: &Option<T>) -> bool {
        self._is_some
    }

    /// Returns `true` if the option is empty, `false` otherwise.
    fn is_none(self: &Option<T>) -> bool {
        !self._is_some
    }

    /// Returns a value, if present, aborts otherwise.
    fn unwrap(self: Option<T>) -> T {
        if !self._is_some {
            libc::abort();
        }
        self._inner
    }

    /// Returns a value, if present, otherwise return a default value.
    fn unwrap_or(self: Option<T>, val: T) -> T {
        if self._is_some {
            self._inner
        } else {
            val
        }
    }

    /// Returns a value, if present, otherwise invoke func to get the default.
    fn unwrap_or_else<F: Fn() -> T>(self: Option<T>, func: F) -> T {
        if self._is_some {
            self._inner
        } else {
            func()
        }
    }

    /// Transform the value inside the `Option` by calling the provided function.
    fn map<Tm, F: Fn(T) -> Tm>(self: Option<T>, func: F) -> Option<Tm> {
        if self._is_some {
            Option::some(func(self._inner))
        } else {
            Option::none()
        }
    }

    /// If `self` is none, return none, otherwise return `other`
    fn and<Tm>(self: Option<T>, other: Option<Tm>) -> Option<Tm> {
        if self._is_some {
            other
        } else {
            Option::none()
        }
    }

    /// If `self` is none, return none, otherwise return the result of calling `func`.
    fn and_then<Tm, F: Fn(T) -> Option<Tm>>(self: Option<T>, func: F) -> Option<Tm> {
        if self._is_some {
            func(self._inner)
        } else {
            Option::none()
        }
    }

    /// Return `self` if it is populated, otherwise return `other`.
    fn or(self: Option<T>, other: Option<T>) -> Option<T> {
        if self._is_some {
            self
        } else {
            other
        }
    }

    /// Return `self` if it is populated, otherwise return the result of calling `func`.
    fn or_else<F: Fn() -> Option<T>>(self: Option<T>, func: F) -> Option<T> {
        if self._is_some {
            self
        } else {
            func()
        }
    }

    /// Replaces the value in the option, returning the old value if present.
    fn replace(self: &mut Option<T>, val: T) -> Option<T> {
        let old = *self;
        *self = Option::some(val);
        old
    }

    /// Returns pointer to inner or a null pointer if not present.
    fn as_nullable_ptr(self: &Option<T>) -> &T {
        if self._is_some {
            &self._inner
        } else {
            null as &T
        }
    }

    /// Transform a pointer to `Option` to an `Option` of pointer.
    fn as_ptr(self: &Option<T>) -> Option<&T> {
        if self._is_some {
            Option::some(&self._inner)
        } else {
            Option::none()
        }
    }

    /// Transform a mutable pointer to `Option` to an `Option` of mutable pointer.
    fn as_mut_ptr(self: &mut Option<T>) -> Option<&mut T> {
        if self._is_some {
            Option::some(&self._inner)
        } else {
            Option::none()
        }
    }

    /// Flattens a nested `Option` into a single `Option`.
    fn flatten(self: Option<Option<T>>) -> Option<T> {
        if self._is_some {
            self._inner
        } else {
            Option::none()
        }
    }

    /// Merges two `Option`s into an `Option` of a tuple.
    fn zip<O>(self: Option<T>, other: Option<O>) -> Option<(T, O)> {
        if self._is_some && other._is_some {
            Option::some((self._inner, other._inner))
        } else {
            Option::none()
        }
    }

    /// Convert the option into a Result. If empty, use `err` for the error variant.
    fn ok_or<E>(self: Option<T>, err: E) -> std::result::Result<T, E> {
        if self._is_some {
            std::result::Result::ok(self._inner)
        } else {
            std::result::Result::err(err)
        }
    }

    /// Convert the option into a Result. If empty, call `f` for the error variant.
    fn ok_or_else<E, F: Fn() -> E>(self: Option<T>, f: F) -> std::result::Result<T, E> {
        if self._is_some {
            std::result::Result::ok(self._inner)
        } else {
            std::result::Result::err(f())
        }
    }

    fn fmt<F: std::fmt::Formatter<F>>(self: &Option<T>, f: &mut F) -> std::fmt::Result {
        if self._is_some {
            f.write_str("some(...)")
        } else {
            f.write_str("none")
        }
    }

    /// Returns a single-element iterator if Some, an empty iterator if None.
    ///
    /// Lets options participate in for-loops and iterator chains.
    fn iter(self: &Option<T>) -> std::iter::OnceIterator<T> {
        std::iter::OnceIterator { _value: *self }
    }

    /// Take the value out, leaving None behind.
    fn move(self: &mut Option<T>) -> Option<T> {
        std::mem::replace(self, Option::none())
    }
}

impl Option {
    /// Convert `Option<Result<T, E>>` to `Result<Option<T>, E>`.
    fn transpose<T, E>(self: Option<std::result::Result<T, E>>) -> std::result::Result<Option<T>, E> {
        if self.is_some() {
            let inner = self.unwrap();
            if inner.is_ok() {
                let v: T = inner.unwrap();
                let opt: Option<T> = Option::some(v);
                std::result::Result::ok(opt)
            } else {
                let e: E = inner.unwrap_err();
                std::result::Result::err(e)
            }
        } else {
            let none_val: Option<T> = Option::none();
            std::result::Result::ok(none_val)
        }
    }

    /// Compare two options for equality.
    fn equals<T: Equatable<T>>(lhs: &Option<T>, rhs: &Option<T>) -> bool {
        if lhs._is_some && rhs._is_some {
            lhs._inner.equals(&rhs._inner)
        } else {
            lhs._is_some == rhs._is_some
        }
    }

    /// Compare two options for inequality.
    fn not_equals<T: Equatable<T>>(lhs: &Option<T>, rhs: &Option<T>) -> bool {
        !Option::equals::<T>(lhs, rhs)
    }

    /// Compare two options. None < Some, and Some<a> compares to Some<b>
    /// via the inner type's compare.
    fn compare<T: std::cmp::Comparable<T>>(lhs: &Option<T>, rhs: &Option<T>) -> std::cmp::Ordering {
        if lhs._is_some && rhs._is_some {
            lhs._inner.compare(&rhs._inner)
        } else if !lhs._is_some && !rhs._is_some {
            std::cmp::Ordering::Equal
        } else if lhs._is_some {
            std::cmp::Ordering::Greater
        } else {
            std::cmp::Ordering::Less
        }
    }

    mixin<T: Equatable<T>> std::cmp::Equatable<Option<T>>;
    mixin<T: std::cmp::Comparable<T>> std::cmp::Comparable<Option<T>>;
}

#[cfg(all(test, test_std))]
mod tests {
    #[test]
    fn option_some() {
        let opt = Option::some(42);
        assert!(opt.is_some());
        assert!(!opt.is_none());
        assert_eq!(opt.unwrap(), 42);
    }

    #[test]
    fn option_none() {
        let opt = Option::none::<i32>();
        assert!(opt.is_none());
        assert!(!opt.is_some());
    }

    #[test]
    fn option_unwrap_or() {
        assert_eq!(Option::some(42).unwrap_or(0), 42);
        assert_eq!(Option::none::<i32>().unwrap_or(99), 99);
    }

    #[test]
    fn option_map() {
        let opt = Option::some(21);
        let doubled = opt.map(|x: i32| -> i32 { x * 2 });
        assert_eq!(doubled.unwrap(), 42);

        let none = Option::none::<i32>();
        let mapped = none.map(|x: i32| -> i32 { x * 2 });
        assert!(mapped.is_none());
    }

    #[test]
    fn option_equals() {
        assert!(Option::some(42) == Option::some(42));
        assert!(Option::some(42) != Option::some(43));
        assert!(Option::none::<i32>() == Option::none::<i32>());
        assert!(Option::some(1) != Option::none::<i32>());
    }

    #[test]
    fn option_ok_or() {
        let ok = Option::some(42).ok_or(-1);
        assert!(ok.is_ok());
        assert_eq!(ok.unwrap(), 42);

        let err = Option::none::<i32>().ok_or(-1);
        assert!(err.is_err());
        assert_eq!(err.unwrap_err(), -1);
    }
}
