// Memory operations for self-hosted compiler

extern "C" fn malloc(size: usize) -> &mut void;
extern "C" fn realloc(ptr: &mut void, size: usize) -> &mut void;
extern "C" fn free(ptr: &mut void);
extern "C" fn memcpy(dest: &mut void, src: &void, n: usize) -> &mut void;
extern "C" fn memcmp(a: &void, b: &void, n: usize) -> i32;

/// Types that own heap-allocated memory.
protocol Freeable<Self> {
    /// Frees the memory backing the object.
    fn free(self: &mut Self);
}

/// Types that implement move semantics.
///
/// If a type allocates memory, it is a good idea to implement move function, so that instances
/// can be passed around by value, leaving inert instances behind. This is chiefly used so that
/// `defer` expressions are more ergonomic.
protocol Movable<Self> {
    /// Creates a copy of the object, leaving an inert object behind.
    fn move(self: &mut Self) -> Self;
}

/// Types that can be copied non-trivially (usually types containing a heap allocation).
protocol Clonable<Self> {
    /// Returns a copy of the object.
    fn clone(self: &Self) -> Self;
}

/// Types that can be viewed as a const slice.
protocol AsSlice<Self, T> {
    fn as_slice(self: &Self) -> &[T];
}

/// Types that can be viewed as a mutable slice.
protocol AsSliceMut<Self: AsSlice<Self, T>, T> {
    fn as_mut_slice(self: &mut Self) -> &mut [T];
}

/// Types that can provide a borrowed view.
protocol Borrowable<Self, C> {
    fn borrow(self: &Self) -> C;
}

/// Types that can provide a mutable borrowed view.
protocol BorrowableMut<Self, M> {
    fn borrow_mut(self: &mut Self) -> M;
}

/// Return a zero-initialized value of type T.
fn zeroed<T>() -> T {
    let val: T;
    val
}

/// Same as zeroed - for compatibility with alumina-boot's mem::uninitialized.
fn uninitialized<T>() -> T {
    let val: T;
    val
}

/// Memory size of a given type in bytes.
fn size_of<T>() -> usize {
    std::intrinsics::size_of::<T>()
}

/// Minimum alignment for a given type in bytes.
fn align_of<T>() -> usize {
    std::intrinsics::align_of::<T>()
}

// Slice construction from raw parts
// #[lang(slice_new)] tells the compiler to treat this as an intrinsic
#[lang(slice_new)]
fn slice_from_raw<T>(ptr: &mut T, len: usize) -> &mut [T] {
    // This is handled by the compiler as an intrinsic
    // It constructs a fat pointer (ptr, len)
    zeroed::<&mut [T]>()
}

#[lang(slice_new)]
fn slice_from_raw_const<T>(ptr: &T, len: usize) -> &[T] {
    zeroed::<&[T]>()
}

fn slice_empty<T>() -> &mut [T] {
    slice_from_raw::<T>(zeroed::<&mut T>(), 0usize)
}

fn slice_alloc<T>(len: usize) -> &mut [T] {
    let ptr = malloc(len * size_of::<T>()) as &mut T;
    slice_from_raw::<T>(ptr, len)
}

fn slice_realloc<T>(data: &mut [T], new_len: usize) -> &mut [T] {
    let old_ptr = &data[0] as &mut void;
    let new_ptr = realloc(old_ptr, new_len * size_of::<T>()) as &mut T;
    slice_from_raw::<T>(new_ptr, new_len)
}

fn slice_free<T>(data: &mut [T]) {
    if data.len() > 0usize {
        free(&data[0] as &mut void);
    }
}

/// Allocate a zero-initialized slice.
fn slice_alloc_zeroed<T>(len: usize) -> &mut [T] {
    let ptr = libc::calloc(len, size_of::<T>()) as &mut T;
    slice_from_raw::<T>(ptr, len)
}

/// Allocates a single object on the heap.
///
/// The value is not initialized.
fn alloc<T>() -> &mut T {
    malloc(size_of::<T>()) as &mut T
}

/// Allocates a single object on the heap, zero-initialized.
fn alloc_zeroed<T>() -> &mut T {
    libc::calloc(1usize, size_of::<T>()) as &mut T
}

/// Frees a heap-allocated object.
fn free_obj<T>(a: &mut T) {
    free(a as &mut void);
}

/// Copies a region of memory from `src` to `dst`.
///
/// The memory ranges must not overlap. Use [copy] if they may be overlapping.
fn copy_nonoverlapping<T>(src: &T, dst: &mut T, count: usize) {
    memcpy(dst as &mut void, src as &void, count * size_of::<T>());
}

/// Copies a region of memory from `src` to `dst`.
///
/// The ranges may overlap.
fn copy<T>(src: &T, dst: &mut T, count: usize) {
    libc::memmove(dst as &mut void, src as &void, count * size_of::<T>());
}

/// Performs an unaligned read from a memory location.
fn read_unaligned<T>(ptr: &T) -> T {
    let ret: T;
    memcpy(&ret as &mut void, ptr as &void, size_of::<T>());
    ret
}

/// Performs an unaligned write to a memory location.
fn write_unaligned<T>(ptr: &mut T, val: T) {
    memcpy(ptr as &mut void, &val as &void, size_of::<T>());
}

/// Swap the values at two mutable references.
fn swap<T>(a: &mut T, b: &mut T) {
    let tmp = *a;
    *a = *b;
    *b = tmp;
}

/// Replace a value at a mutable reference, returning the old value.
fn replace<T>(ptr: &mut T, val: T) -> T {
    let old = *ptr;
    *ptr = val;
    old
}

// Slice type: &[T] is syntactic sugar for slice<&T>, &mut [T] for slice<&mut T>
#[lang(slice)]
struct slice<Ptr> {
    _ptr: Ptr,
    _len: usize,
}

impl slice {
    #[lang(slice_new)]
    fn from_raw<Ptr>(ptr: Ptr, len: usize) -> slice<Ptr> {
        slice::<Ptr> { _ptr: ptr, _len: len }
    }

    fn len<Ptr>(self: slice<Ptr>) -> usize {
        self._len
    }

    fn as_ptr<Ptr>(self: slice<Ptr>) -> Ptr {
        self._ptr
    }

    fn is_empty<Ptr>(self: slice<Ptr>) -> bool {
        self._len == 0usize
    }

    /// Returns the element at the given index, or `Option::none()` if out of bounds.
    fn get<T>(self: &[T], index: usize) -> std::option::Option<T> {
        if index < self.len() {
            std::option::Option::some(self[index])
        } else {
            std::option::Option::none()
        }
    }

    /// Copies elements from `src` slice to `dst` pointer. Regions must not overlap.
    fn copy_to_nonoverlapping<T>(src: &[T], dst: &mut T) {
        copy_nonoverlapping(&src[0], dst, src.len());
    }

    /// Copies elements from `src` slice to `dst` pointer. Regions may overlap.
    fn copy_to<T>(src: &[T], dst: &mut T) {
        copy(&src[0], dst, src.len());
    }

    /// Fill a mutable slice with a value.
    fn fill<T>(s: &mut [T], value: T) {
        for i in 0usize..s.len() {
            s[i] = value;
        }
    }

    /// Element-wise equality comparison for slices.
    fn equals<Ptr>(lhs: &slice<Ptr>, rhs: &slice<Ptr>) -> bool {
        if lhs._len != rhs._len { return false; }
        for i in 0usize..lhs._len {
            if lhs._ptr[i] != rhs._ptr[i] { return false; }
        }
        true
    }

    /// Lexicographic comparison for slices.
    fn compare<Ptr>(lhs: &slice<Ptr>, rhs: &slice<Ptr>) -> std::cmp::Ordering {
        let len = lhs._len;
        if rhs._len < len { len = rhs._len; }
        for i in 0usize..len {
            if lhs._ptr[i] < rhs._ptr[i] { return std::cmp::Ordering::Less; }
            if lhs._ptr[i] > rhs._ptr[i] { return std::cmp::Ordering::Greater; }
        }
        if lhs._len < rhs._len { std::cmp::Ordering::Less }
        else if lhs._len > rhs._len { std::cmp::Ordering::Greater }
        else { std::cmp::Ordering::Equal }
    }

    /// Hash a slice by hashing each element.
    fn hash<T, H: std::hash::Hasher<H>>(self: &[T], hasher: &mut H) {
        // For byte slices, hash directly
        hasher.write(*self);
    }

    /// Write byte slice as string. Used by format_args! for string literal pieces.
    fn fmt<Ptr, F: std::fmt::Formatter<F>>(self: &slice<Ptr>, f: &mut F) -> std::fmt::Result {
        f.write_str(*self)
    }

    /// Allocate a heap-allocated slice.
    fn alloc<T>(len: usize) -> &mut [T] {
        slice_alloc::<T>(len)
    }

    /// Allocate a zero-initialized heap slice.
    fn alloc_zeroed<T>(len: usize) -> &mut [T] {
        slice_alloc_zeroed::<T>(len)
    }

    /// Resize a heap-allocated slice.
    fn realloc<T>(data: &mut [T], new_len: usize) -> &mut [T] {
        slice_realloc::<T>(data, new_len)
    }

    /// Free a heap-allocated slice.
    fn free<T>(data: &mut [T]) {
        slice_free::<T>(data);
    }

}
