// Memory operations for self-hosted compiler

extern "C" fn malloc(size: usize) -> &mut void;
extern "C" fn realloc(ptr: &mut void, size: usize) -> &mut void;
extern "C" fn free(ptr: &mut void);
extern "C" fn memcpy(dest: &mut void, src: &void, n: usize) -> &mut void;
extern "C" fn memcmp(a: &void, b: &void, n: usize) -> i32;

/// Types that own heap-allocated memory.
protocol Freeable<Self> {
    /// Frees the memory backing the object.
    fn free(self: &mut Self);
}

/// Types that implement move semantics.
///
/// If a type allocates memory, it is a good idea to implement move function, so that instances
/// can be passed around by value, leaving inert instances behind. This is chiefly used so that
/// `defer` expressions are more ergonomic.
protocol Movable<Self> {
    /// Creates a copy of the object, leaving an inert object behind.
    fn move(self: &mut Self) -> Self;
}

/// Types that can be copied non-trivially (usually types containing a heap allocation).
protocol Clonable<Self> {
    /// Returns a copy of the object.
    fn clone(self: &Self) -> Self;
}

/// Types that can be viewed as a const slice.
protocol AsSlice<Self, T> {
    fn as_slice(self: &Self) -> &[T];
}

/// Types that can be viewed as a mutable slice.
protocol AsSliceMut<Self: AsSlice<Self, T>, T> {
    fn as_mut_slice(self: &mut Self) -> &mut [T];
}

/// Return a zero-initialized value of type T.
fn zeroed<T>() -> T {
    let val: T;
    val
}

/// Same as zeroed - for compatibility with alumina-boot's mem::uninitialized.
fn uninitialized<T>() -> T {
    let val: T;
    val
}

fn size_of<T>() -> usize {
    std::intrinsics::size_of::<T>()
}

fn align_of<T>() -> usize {
    std::intrinsics::align_of::<T>()
}

// Slice construction from raw parts
// #[lang(slice_new)] tells the compiler to treat this as an intrinsic
#[lang(slice_new)]
fn slice_from_raw<T>(ptr: &mut T, len: usize) -> &mut [T] {
    // This is handled by the compiler as an intrinsic
    // It constructs a fat pointer (ptr, len)
    zeroed::<&mut [T]>()
}

#[lang(slice_new)]
fn slice_from_raw_const<T>(ptr: &T, len: usize) -> &[T] {
    zeroed::<&[T]>()
}

fn slice_empty<T>() -> &mut [T] {
    slice_from_raw::<T>(zeroed::<&mut T>(), 0usize)
}

fn slice_alloc<T>(len: usize) -> &mut [T] {
    let ptr = malloc(len * size_of::<T>()) as &mut T;
    slice_from_raw::<T>(ptr, len)
}

fn slice_realloc<T>(data: &mut [T], new_len: usize) -> &mut [T] {
    let old_ptr = &data[0] as &mut void;
    let new_ptr = realloc(old_ptr, new_len * size_of::<T>()) as &mut T;
    slice_from_raw::<T>(new_ptr, new_len)
}

fn slice_free<T>(data: &mut [T]) {
    if data.len() > 0usize {
        free(&data[0] as &mut void);
    }
}

extern "C" fn calloc(nmemb: usize, size: usize) -> &mut void;

/// Allocate a zero-initialized slice.
fn slice_alloc_zeroed<T>(len: usize) -> &mut [T] {
    let ptr = calloc(len, size_of::<T>()) as &mut T;
    slice_from_raw::<T>(ptr, len)
}

/// Copy memory with potential overlap (uses memmove).
fn copy<T>(src: &T, dst: &mut T, count: usize) {
    libc::memmove(dst as &mut void, src as &void, count * size_of::<T>());
}

/// Swap the values at two mutable references.
fn swap<T>(a: &mut T, b: &mut T) {
    let tmp = *a;
    *a = *b;
    *b = tmp;
}

/// Replace a value at a mutable reference, returning the old value.
fn replace<T>(ptr: &mut T, val: T) -> T {
    let old = *ptr;
    *ptr = val;
    old
}

// Slice type: &[T] is syntactic sugar for slice<&T>, &mut [T] for slice<&mut T>
#[lang(slice)]
struct slice<Ptr> {
    _ptr: Ptr,
    _len: usize,
}

impl slice {
    #[lang(slice_new)]
    fn from_raw<Ptr>(ptr: Ptr, len: usize) -> slice<Ptr> {
        slice::<Ptr> { _ptr: ptr, _len: len }
    }

    fn len<Ptr>(self: slice<Ptr>) -> usize {
        self._len
    }

    fn as_ptr<Ptr>(self: slice<Ptr>) -> Ptr {
        self._ptr
    }

    fn is_empty<Ptr>(self: slice<Ptr>) -> bool {
        self._len == 0usize
    }

    /// Element-wise equality comparison for slices of primitive types.
    fn equals<Ptr>(lhs: &slice<Ptr>, rhs: &slice<Ptr>) -> bool {
        if lhs._len != rhs._len { return false; }
        for i in 0usize..lhs._len {
            if lhs._ptr[i] != rhs._ptr[i] { return false; }
        }
        true
    }

    /// Write byte slice as string. Used by format_args! for string literal pieces.
    fn fmt<Ptr, F: std::fmt::Formatter<F>>(self: &slice<Ptr>, f: &mut F) -> std::fmt::Result {
        f.write_str(*self)
    }
}
