// Macro utilities for bootstrap sysroot

/// Create a macro "closure" - partial application of macro arguments
#[builtin] macro bind($mac, $arg...) {}

/// Left-associative fold over arguments
#[builtin] macro reduce($mac, $base, $arg...) {}

/// Concatenate string literals at compile time
#[builtin] macro concat($parts...) {}

/// Parse format string and call wrapper macro with interleaved pieces
#[builtin] macro format_args($fmt, $args...) {}

// Returns a tuple of all discovered test cases
#[builtin] macro test_cases() {}

/// Count the number of arguments
macro count($arg...) {
    reduce!(internal::count_reducer, 0usize, $arg$...)
}

mod internal {
    macro count_reducer($acc, $_) {
        $acc + 1usize
    }
}
