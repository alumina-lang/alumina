    }
}

#[lang(builtin_u64)]
struct u64 {}
impl u64 {
    fn min_value() -> u64 { 0u64 }
    fn max_value() -> u64 { 18446744073709551615u64 }
    fn count_ones(self: u64) -> u32 {
        std::intrinsics::llvm::<u64>("llvm.ctpop", self) as u32
    }
    fn count_zeros(self: u64) -> u32 {
        (~self).count_ones()
    }
    fn leading_zeros(self: u64) -> u32 {
        std::intrinsics::llvm::<u64>("llvm.ctlz", self, false) as u32
    }
    fn trailing_zeros(self: u64) -> u32 {
        std::intrinsics::llvm::<u64>("llvm.cttz", self, false) as u32
    }
    fn swap_bytes(self: u64) -> u64 {
        std::intrinsics::llvm::<u64>("llvm.bswap", self)
    }
    fn checked_add(lhs: u64, rhs: u64) -> Option<u64> {
        let r = lhs + rhs; // wraps in LLVM IR
        if r < lhs { Option::none() } else { Option::some(r) }
    }
    fn checked_sub(lhs: u64, rhs: u64) -> Option<u64> {
        if rhs > lhs { Option::none() } else { Option::some(lhs - rhs) }
    }
    fn checked_mul(lhs: u64, rhs: u64) -> Option<u64> {
        if lhs == 0u64 { return Option::some(0u64); }
        let r = lhs * rhs; // wraps in LLVM IR
        if r / lhs != rhs { Option::none() } else { Option::some(r) }
    }
    fn equals(lhs: &u64, rhs: &u64) -> bool { *lhs == *rhs }
    fn not_equals(lhs: &u64, rhs: &u64) -> bool { *lhs != *rhs }
    fn compare(lhs: &u64, rhs: &u64) -> std::cmp::Ordering {
        if *lhs < *rhs { std::cmp::Ordering::Less }
        else if *lhs == *rhs { std::cmp::Ordering::Equal }
        else { std::cmp::Ordering::Greater }
    }
    fn less_than(lhs: &u64, rhs: &u64) -> bool { *lhs < *rhs }
    fn less_than_or_equal(lhs: &u64, rhs: &u64) -> bool { *lhs <= *rhs }
    fn greater_than(lhs: &u64, rhs: &u64) -> bool { *lhs > *rhs }
    fn greater_than_or_equal(lhs: &u64, rhs: &u64) -> bool { *lhs >= *rhs }
    fn fmt<F: std::fmt::Formatter<F>>(self: &u64, f: &mut F) -> std::fmt::Result {
        std::fmt::internal::format_integer_unsigned::<F>(*self, f)
    }
    /// Rotate bits left by n positions.
    fn rotate_left(self: &u64, n: usize) -> u64 {
        if n == 0usize { return *self; }
        (*self << n) | (*self >> (64usize - n))
    }
    /// Rotate bits right by n positions.
    fn rotate_right(self: &u64, n: usize) -> u64 {
        if n == 0usize { return *self; }
        (*self >> n) | (*self << (64usize - n))
    }
    fn hash<H: std::hash::Hasher<H>>(self: &u64, hasher: &mut H) {
        hasher.write(std::mem::slice_from_raw_const::<u8>(self as &u8, 8usize));
    }
}

