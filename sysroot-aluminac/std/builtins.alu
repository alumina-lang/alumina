    fn swap_bytes(self: u128) -> u128 {
        std::intrinsics::llvm::<u128>("llvm.bswap", self)
    }
    fn equals(lhs: &u128, rhs: &u128) -> bool { *lhs == *rhs }
    fn not_equals(lhs: &u128, rhs: &u128) -> bool { *lhs != *rhs }
    fn compare(lhs: &u128, rhs: &u128) -> std::cmp::Ordering {
