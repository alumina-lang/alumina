#[lang(builtin_isize)]
struct isize {}
impl isize {
    fn min_value() -> isize { -9223372036854775808isize }
    fn max_value() -> isize { 9223372036854775807isize }
    fn abs(self: &isize) -> isize { if *self < 0isize { -*self } else { *self } }
    fn count_ones(self: isize) -> u32 {
        std::intrinsics::llvm::<isize>("llvm.ctpop", self) as u32
    }
    fn count_zeros(self: isize) -> u32 {
        (~self).count_ones()
    }
    fn leading_zeros(self: isize) -> u32 {
        std::intrinsics::llvm::<isize>("llvm.ctlz", self, false) as u32
    }
    fn trailing_zeros(self: isize) -> u32 {
        std::intrinsics::llvm::<isize>("llvm.cttz", self, false) as u32
    }
    fn swap_bytes(self: isize) -> isize {
        std::intrinsics::llvm::<isize>("llvm.bswap", self)
    }
    fn checked_add(lhs: isize, rhs: isize) -> Option<isize> {
        let r = (lhs as u64 + rhs as u64) as isize;
        if rhs >= 0isize {
            if r < lhs { return Option::none(); }
        } else {
            if r > lhs { return Option::none(); }
        }
        Option::some(r)
    }
    fn checked_sub(lhs: isize, rhs: isize) -> Option<isize> {
        let r = (lhs as u64 - rhs as u64) as isize;
        if rhs >= 0isize {
            if r > lhs { return Option::none(); }
        } else {
            if r < lhs { return Option::none(); }
        }
        Option::some(r)
    }
    fn checked_mul(lhs: isize, rhs: isize) -> Option<isize> {
        if lhs == 0isize || rhs == 0isize { return Option::some(0isize); }
        if lhs == isize::min_value() && rhs == -1isize { return Option::none(); }
        if rhs == isize::min_value() && lhs == -1isize { return Option::none(); }
        let r = lhs * rhs;
        if r / lhs != rhs { Option::none() } else { Option::some(r) }
    }
    fn equals(lhs: &isize, rhs: &isize) -> bool { *lhs == *rhs }
    fn not_equals(lhs: &isize, rhs: &isize) -> bool { *lhs != *rhs }
    fn compare(lhs: &isize, rhs: &isize) -> std::cmp::Ordering {
        if *lhs < *rhs { std::cmp::Ordering::Less }
        else if *lhs == *rhs { std::cmp::Ordering::Equal }
        else { std::cmp::Ordering::Greater }
    }
    fn less_than(lhs: &isize, rhs: &isize) -> bool { *lhs < *rhs }
    fn less_than_or_equal(lhs: &isize, rhs: &isize) -> bool { *lhs <= *rhs }
    fn greater_than(lhs: &isize, rhs: &isize) -> bool { *lhs > *rhs }
    fn greater_than_or_equal(lhs: &isize, rhs: &isize) -> bool { *lhs >= *rhs }
    fn fmt<F: std::fmt::Formatter<F>>(self: &isize, f: &mut F) -> std::fmt::Result {
        std::fmt::internal::format_integer_signed::<F>(*self as i64, f)
    }
    fn hash<H: std::hash::Hasher<H>>(self: &isize, hasher: &mut H) {
        hasher.write(std::mem::slice_from_raw_const::<u8>(self as &u8, std::mem::size_of::<isize>()));
    }
}

#[lang(builtin_f32)]
struct f32 {}
impl f32 {
    fn nan() -> f32 { 0.0f32 / 0.0f32 }
    fn infinity() -> f32 { 1.0f32 / 0.0f32 }
    fn neg_infinity() -> f32 { -1.0f32 / 0.0f32 }
    fn min_value() -> f32 { -3.40282347e+38f32 }
    fn max_value() -> f32 { 3.40282347e+38f32 }
    fn epsilon() -> f32 { 1.1920929e-7f32 }
    fn is_nan(self: &f32) -> bool { *self != *self }
    fn is_infinite(self: &f32) -> bool { *self == f32::infinity() || *self == f32::neg_infinity() }
    fn is_finite(self: &f32) -> bool { !self.is_nan() && !self.is_infinite() }
    fn abs(self: &f32) -> f32 { libc::fabsf(*self) }
    fn sqrt(self: &f32) -> f32 { libc::sqrtf(*self) }
    fn ceil(self: &f32) -> f32 { libc::ceilf(*self) }
    fn floor(self: &f32) -> f32 { libc::floorf(*self) }
    fn round(self: &f32) -> f32 { libc::roundf(*self) }
    fn sin(self: &f32) -> f32 { libc::sinf(*self) }
    fn cos(self: &f32) -> f32 { libc::cosf(*self) }
    fn tan(self: &f32) -> f32 { libc::tanf(*self) }
    fn atan2(self: &f32, x: f32) -> f32 { libc::atan2f(*self, x) }
    fn pow(self: &f32, n: f32) -> f32 { libc::powf(*self, n) }
    fn log(self: &f32) -> f32 { libc::logf(*self) }
    fn log2(self: &f32) -> f32 { libc::log2f(*self) }
    fn log10(self: &f32) -> f32 { libc::log10f(*self) }
    fn exp(self: &f32) -> f32 { libc::expf(*self) }
    fn min(self: &f32, other: f32) -> f32 { libc::fminf(*self, other) }
    fn max(self: &f32, other: f32) -> f32 { libc::fmaxf(*self, other) }
    fn equals(lhs: &f32, rhs: &f32) -> bool { *lhs == *rhs }
    fn not_equals(lhs: &f32, rhs: &f32) -> bool { *lhs != *rhs }
    fn compare(lhs: &f32, rhs: &f32) -> std::cmp::Ordering {
        if *lhs < *rhs { std::cmp::Ordering::Less }
        else if *lhs == *rhs { std::cmp::Ordering::Equal }
        else { std::cmp::Ordering::Greater }
    }
    fn less_than(lhs: &f32, rhs: &f32) -> bool { *lhs < *rhs }
    fn less_than_or_equal(lhs: &f32, rhs: &f32) -> bool { *lhs <= *rhs }
    fn greater_than(lhs: &f32, rhs: &f32) -> bool { *lhs > *rhs }
    fn greater_than_or_equal(lhs: &f32, rhs: &f32) -> bool { *lhs >= *rhs }
    fn fmt<F: std::fmt::Formatter<F>>(self: &f32, f: &mut F) -> std::fmt::Result {
        // Simple float formatting: convert to f64 and format
        let v = *self as f64;
        let buf: [u8; 32];
        let len = libc::snprintf(&buf[0] as &mut libc::c_char, 32usize, &"%.6g\0"[0] as &libc::c_char, v);
        if len > 0i32 && len < 32i32 {
            f.write_str(buf[0usize..len as usize])
        } else {
            f.write_str("NaN")
        }
    }
    fn hash<H: std::hash::Hasher<H>>(self: &f32, hasher: &mut H) {
        hasher.write(std::mem::slice_from_raw_const::<u8>(self as &u8, 4usize));
    }
}

