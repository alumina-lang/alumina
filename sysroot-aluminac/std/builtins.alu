        else if *lhs == *rhs { std::cmp::Ordering::Equal }
        else { std::cmp::Ordering::Greater }
    }
    fn less_than(lhs: &usize, rhs: &usize) -> bool { *lhs < *rhs }
    fn less_than_or_equal(lhs: &usize, rhs: &usize) -> bool { *lhs <= *rhs }
    fn greater_than(lhs: &usize, rhs: &usize) -> bool { *lhs > *rhs }
    fn greater_than_or_equal(lhs: &usize, rhs: &usize) -> bool { *lhs >= *rhs }
    fn fmt<F: std::fmt::Formatter<F>>(self: &usize, f: &mut F) -> std::fmt::Result {
        std::fmt::internal::format_integer_unsigned::<F>(*self as u64, f)
    }
    fn hash<H: std::hash::Hasher<H>>(self: &usize, hasher: &mut H) {
        hasher.write(std::mem::slice_from_raw_const::<u8>(self as &u8, std::mem::size_of::<usize>()));
    }
}

