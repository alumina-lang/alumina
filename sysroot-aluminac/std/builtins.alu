        let r = lhs as u64 + rhs as u64;
        if r > 4294967295u64 { Option::none() } else { Option::some(r as u32) }
    }
    fn checked_sub(lhs: u32, rhs: u32) -> Option<u32> {
        if rhs > lhs { Option::none() } else { Option::some(lhs - rhs) }
    }
    fn checked_mul(lhs: u32, rhs: u32) -> Option<u32> {
        let r = lhs as u64 * rhs as u64;
        if r > 4294967295u64 { Option::none() } else { Option::some(r as u32) }
    }
    fn equals(lhs: &u32, rhs: &u32) -> bool { *lhs == *rhs }
    fn not_equals(lhs: &u32, rhs: &u32) -> bool { *lhs != *rhs }
    fn compare(lhs: &u32, rhs: &u32) -> std::cmp::Ordering {
        if *lhs < *rhs { std::cmp::Ordering::Less }
        else if *lhs == *rhs { std::cmp::Ordering::Equal }
        else { std::cmp::Ordering::Greater }
    }
    fn less_than(lhs: &u32, rhs: &u32) -> bool { *lhs < *rhs }
    fn less_than_or_equal(lhs: &u32, rhs: &u32) -> bool { *lhs <= *rhs }
    fn greater_than(lhs: &u32, rhs: &u32) -> bool { *lhs > *rhs }
    fn greater_than_or_equal(lhs: &u32, rhs: &u32) -> bool { *lhs >= *rhs }
    fn fmt<F: std::fmt::Formatter<F>>(self: &u32, f: &mut F) -> std::fmt::Result {
