        std::intrinsics::llvm::<i16>("llvm.cttz", self, false) as u32
    }
    fn swap_bytes(self: i16) -> i16 {
        std::intrinsics::llvm::<i16>("llvm.bswap", self)
    }
    fn checked_add(lhs: i16, rhs: i16) -> Option<i16> {
        let r = lhs as i32 + rhs as i32;
        if r < -32768i32 || r > 32767i32 { Option::none() } else { Option::some(r as i16) }
    }
    fn checked_sub(lhs: i16, rhs: i16) -> Option<i16> {
        let r = lhs as i32 - rhs as i32;
        if r < -32768i32 || r > 32767i32 { Option::none() } else { Option::some(r as i16) }
    }
    fn checked_mul(lhs: i16, rhs: i16) -> Option<i16> {
        let r = lhs as i32 * rhs as i32;
        if r < -32768i32 || r > 32767i32 { Option::none() } else { Option::some(r as i16) }
    }
    fn equals(lhs: &i16, rhs: &i16) -> bool { *lhs == *rhs }
    fn not_equals(lhs: &i16, rhs: &i16) -> bool { *lhs != *rhs }
    fn compare(lhs: &i16, rhs: &i16) -> std::cmp::Ordering {
        if *lhs < *rhs { std::cmp::Ordering::Less }
        else if *lhs == *rhs { std::cmp::Ordering::Equal }
        else { std::cmp::Ordering::Greater }
    }
    fn less_than(lhs: &i16, rhs: &i16) -> bool { *lhs < *rhs }
    fn less_than_or_equal(lhs: &i16, rhs: &i16) -> bool { *lhs <= *rhs }
    fn greater_than(lhs: &i16, rhs: &i16) -> bool { *lhs > *rhs }
    fn greater_than_or_equal(lhs: &i16, rhs: &i16) -> bool { *lhs >= *rhs }
    fn fmt<F: std::fmt::Formatter<F>>(self: &i16, f: &mut F) -> std::fmt::Result {
        std::fmt::internal::format_integer_signed::<F>(*self as i64, f)
    }
    fn hash<H: std::hash::Hasher<H>>(self: &i16, hasher: &mut H) {
        hasher.write(std::mem::slice_from_raw_const::<u8>(self as &u8, 2usize));
    }
}

