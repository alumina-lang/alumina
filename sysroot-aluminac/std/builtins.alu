}

#[lang(builtin_usize)]
struct usize {}
impl usize {
    fn min_value() -> usize { 0usize }
    fn max_value() -> usize { 18446744073709551615usize }
    fn count_ones(self: usize) -> u32 {
        std::intrinsics::llvm::<usize>("llvm.ctpop", self) as u32
    }
