    }
    fn swap_bytes(self: usize) -> usize {
        std::intrinsics::llvm::<usize>("llvm.bswap", self)
    }
    fn checked_add(lhs: usize, rhs: usize) -> Option<usize> {
        let r = lhs + rhs;
        if r < lhs { Option::none() } else { Option::some(r) }
    }
    fn checked_sub(lhs: usize, rhs: usize) -> Option<usize> {
        if rhs > lhs { Option::none() } else { Option::some(lhs - rhs) }
    }
    fn checked_mul(lhs: usize, rhs: usize) -> Option<usize> {
        if lhs == 0usize { return Option::some(0usize); }
        let r = lhs * rhs;
        if r / lhs != rhs { Option::none() } else { Option::some(r) }
    }
    fn equals(lhs: &usize, rhs: &usize) -> bool { *lhs == *rhs }
    fn not_equals(lhs: &usize, rhs: &usize) -> bool { *lhs != *rhs }
    fn compare(lhs: &usize, rhs: &usize) -> std::cmp::Ordering {
        if *lhs < *rhs { std::cmp::Ordering::Less }
        else if *lhs == *rhs { std::cmp::Ordering::Equal }
        else { std::cmp::Ordering::Greater }
    }
    fn less_than(lhs: &usize, rhs: &usize) -> bool { *lhs < *rhs }
    fn less_than_or_equal(lhs: &usize, rhs: &usize) -> bool { *lhs <= *rhs }
    fn greater_than(lhs: &usize, rhs: &usize) -> bool { *lhs > *rhs }
    fn greater_than_or_equal(lhs: &usize, rhs: &usize) -> bool { *lhs >= *rhs }
    fn fmt<F: std::fmt::Formatter<F>>(self: &usize, f: &mut F) -> std::fmt::Result {
        std::fmt::internal::format_integer_unsigned::<F>(*self as u64, f)
    }
    fn hash<H: std::hash::Hasher<H>>(self: &usize, hasher: &mut H) {
        hasher.write(std::mem::slice_from_raw_const::<u8>(self as &u8, std::mem::size_of::<usize>()));
    }
}

#[lang(builtin_i8)]
struct i8 {}
impl i8 {
    fn min_value() -> i8 { -128i8 }
    fn max_value() -> i8 { 127i8 }
    fn abs(self: &i8) -> i8 { if *self < 0i8 { -*self } else { *self } }
    fn count_ones(self: i8) -> u32 {
        std::intrinsics::llvm::<i8>("llvm.ctpop", self) as u32
    }
    fn count_zeros(self: i8) -> u32 {
        (~self).count_ones()
    }
    fn leading_zeros(self: i8) -> u32 {
        std::intrinsics::llvm::<i8>("llvm.ctlz", self, false) as u32
    }
    fn trailing_zeros(self: i8) -> u32 {
        std::intrinsics::llvm::<i8>("llvm.cttz", self, false) as u32
    }
    /// Single-byte swap_bytes is identity.
    fn swap_bytes(self: i8) -> i8 { self }
    fn checked_add(lhs: i8, rhs: i8) -> Option<i8> {
        let r = lhs as i16 + rhs as i16;
        if r < -128i16 || r > 127i16 { Option::none() } else { Option::some(r as i8) }
    }
    fn checked_sub(lhs: i8, rhs: i8) -> Option<i8> {
        let r = lhs as i16 - rhs as i16;
        if r < -128i16 || r > 127i16 { Option::none() } else { Option::some(r as i8) }
    }
    fn checked_mul(lhs: i8, rhs: i8) -> Option<i8> {
        let r = lhs as i16 * rhs as i16;
        if r < -128i16 || r > 127i16 { Option::none() } else { Option::some(r as i8) }
    }
    fn equals(lhs: &i8, rhs: &i8) -> bool { *lhs == *rhs }
    fn not_equals(lhs: &i8, rhs: &i8) -> bool { *lhs != *rhs }
    fn compare(lhs: &i8, rhs: &i8) -> std::cmp::Ordering {
        if *lhs < *rhs { std::cmp::Ordering::Less }
        else if *lhs == *rhs { std::cmp::Ordering::Equal }
        else { std::cmp::Ordering::Greater }
    }
    fn less_than(lhs: &i8, rhs: &i8) -> bool { *lhs < *rhs }
    fn less_than_or_equal(lhs: &i8, rhs: &i8) -> bool { *lhs <= *rhs }
    fn greater_than(lhs: &i8, rhs: &i8) -> bool { *lhs > *rhs }
    fn greater_than_or_equal(lhs: &i8, rhs: &i8) -> bool { *lhs >= *rhs }
    fn fmt<F: std::fmt::Formatter<F>>(self: &i8, f: &mut F) -> std::fmt::Result {
        std::fmt::internal::format_integer_signed::<F>(*self as i64, f)
    }
    fn hash<H: std::hash::Hasher<H>>(self: &i8, hasher: &mut H) {
        hasher.write(std::mem::slice_from_raw_const::<u8>(self as &u8, 1usize));
    }
}

