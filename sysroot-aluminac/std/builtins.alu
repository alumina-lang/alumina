#[lang(builtin_i8)]
struct i8 {}
impl i8 {
    fn min_value() -> i8 { -128i8 }
    fn max_value() -> i8 { 127i8 }
    fn abs(self: &i8) -> i8 { if *self < 0i8 { -*self } else { *self } }
    fn equals(lhs: &i8, rhs: &i8) -> bool { *lhs == *rhs }
    fn not_equals(lhs: &i8, rhs: &i8) -> bool { *lhs != *rhs }
    fn compare(lhs: &i8, rhs: &i8) -> std::cmp::Ordering {
        if *lhs < *rhs { std::cmp::Ordering::Less }
        else if *lhs == *rhs { std::cmp::Ordering::Equal }
        else { std::cmp::Ordering::Greater }
    }
    fn less_than(lhs: &i8, rhs: &i8) -> bool { *lhs < *rhs }
    fn less_than_or_equal(lhs: &i8, rhs: &i8) -> bool { *lhs <= *rhs }
    fn greater_than(lhs: &i8, rhs: &i8) -> bool { *lhs > *rhs }
    fn greater_than_or_equal(lhs: &i8, rhs: &i8) -> bool { *lhs >= *rhs }
    fn fmt<F: std::fmt::Formatter<F>>(self: &i8, f: &mut F) -> std::fmt::Result {
        std::fmt::internal::format_integer_signed::<F>(*self as i64, f)
    }
    fn hash<H: std::hash::Hasher<H>>(self: &i8, hasher: &mut H) {
        hasher.write(std::mem::slice_from_raw_const::<u8>(self as &u8, 1usize));
    }
}

