#[lang(builtin_i64)]
struct i64 {}
impl i64 {
    fn min_value() -> i64 { -9223372036854775808i64 }
    fn max_value() -> i64 { 9223372036854775807i64 }
    fn abs(self: &i64) -> i64 { if *self < 0i64 { -*self } else { *self } }
    fn count_ones(self: i64) -> u32 {
        std::intrinsics::llvm::<i64>("llvm.ctpop", self) as u32
    }
    fn count_zeros(self: i64) -> u32 {
        (~self).count_ones()
    }
    fn leading_zeros(self: i64) -> u32 {
        std::intrinsics::llvm::<i64>("llvm.ctlz", self, false) as u32
    }
    fn trailing_zeros(self: i64) -> u32 {
        std::intrinsics::llvm::<i64>("llvm.cttz", self, false) as u32
    }
    fn swap_bytes(self: i64) -> i64 {
        std::intrinsics::llvm::<i64>("llvm.bswap", self)
    }
    fn checked_add(lhs: i64, rhs: i64) -> Option<i64> {
        // Use unsigned arithmetic to avoid UB
        let ua = lhs as u64;
        let ub = rhs as u64;
        let ur = ua + ub;
        let r = ur as i64;
        // Overflow if signs of inputs are same but result sign differs
        if rhs >= 0i64 {
            if r < lhs { return Option::none(); }
        } else {
            if r > lhs { return Option::none(); }
        }
        Option::some(r)
    }
    fn checked_sub(lhs: i64, rhs: i64) -> Option<i64> {
        let ua = lhs as u64;
        let ub = rhs as u64;
        let ur = ua - ub;
        let r = ur as i64;
        if rhs >= 0i64 {
            if r > lhs { return Option::none(); }
        } else {
            if r < lhs { return Option::none(); }
        }
        Option::some(r)
    }
    fn checked_mul(lhs: i64, rhs: i64) -> Option<i64> {
        if lhs == 0i64 || rhs == 0i64 { return Option::some(0i64); }
        // Check for MIN * -1 overflow
        if lhs == i64::min_value() && rhs == -1i64 { return Option::none(); }
        if rhs == i64::min_value() && lhs == -1i64 { return Option::none(); }
        let r = lhs * rhs;
        if r / lhs != rhs { Option::none() } else { Option::some(r) }
    }
    fn equals(lhs: &i64, rhs: &i64) -> bool { *lhs == *rhs }
    fn not_equals(lhs: &i64, rhs: &i64) -> bool { *lhs != *rhs }
    fn compare(lhs: &i64, rhs: &i64) -> std::cmp::Ordering {
        if *lhs < *rhs { std::cmp::Ordering::Less }
        else if *lhs == *rhs { std::cmp::Ordering::Equal }
        else { std::cmp::Ordering::Greater }
    }
    fn less_than(lhs: &i64, rhs: &i64) -> bool { *lhs < *rhs }
    fn less_than_or_equal(lhs: &i64, rhs: &i64) -> bool { *lhs <= *rhs }
    fn greater_than(lhs: &i64, rhs: &i64) -> bool { *lhs > *rhs }
    fn greater_than_or_equal(lhs: &i64, rhs: &i64) -> bool { *lhs >= *rhs }
    fn fmt<F: std::fmt::Formatter<F>>(self: &i64, f: &mut F) -> std::fmt::Result {
        std::fmt::internal::format_integer_signed::<F>(*self, f)
    }
    fn hash<H: std::hash::Hasher<H>>(self: &i64, hasher: &mut H) {
        hasher.write(std::mem::slice_from_raw_const::<u8>(self as &u8, 8usize));
    }
}

