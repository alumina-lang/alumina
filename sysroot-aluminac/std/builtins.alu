// Built-in protocol declarations for the type system.
// These are recognized by #[lang] attributes in the compiler for "expr is Protocol" checks.

#[lang(proto_zero_sized)]
protocol ZeroSized {}
#[lang(proto_primitive)]
protocol Primitive {}
#[lang(proto_numeric)]
protocol Numeric {}
#[lang(proto_integer)]
protocol Integer {}
#[lang(proto_floating_point)]
protocol FloatingPoint {}
#[lang(proto_signed)]
protocol Signed {}
#[lang(proto_unsigned)]
protocol Unsigned {}
#[lang(proto_pointer)]
protocol Pointer {}
#[lang(proto_array)]
protocol Array {}
#[lang(proto_tuple)]
protocol Tuple {}
#[lang(proto_struct)]
protocol Struct {}
#[lang(proto_union)]
protocol Union {}
#[lang(proto_enum)]
protocol Enum {}
#[lang(proto_range)]
protocol Range {}
#[lang(proto_named_function)]
protocol NamedFunction {}
#[lang(proto_function_pointer)]
protocol FunctionPointer {}
#[lang(proto_closure)]
protocol Closure {}
#[lang(proto_callable)]
protocol Callable {}
#[lang(proto_any)]
protocol Any {}
#[lang(proto_none)]
protocol None {}

// Item-kind bounds. Currently treated as trivially-satisfied at the type
// level by aluminac (item-vs-type bound semantics needs a separate
// machinery — tracked in PORTING_STATUS.md).
#[lang(proto_const)]
protocol Const {}
#[lang(proto_static)]
protocol Static {}

// Type-level metadata.
#[lang(proto_meta)]
protocol Protocol {}

// Inference-guide bounds with a type argument. Real semantics for
// proto_array_of / proto_pointer_of / proto_same_layout_as are wired in
// mono/lower.alu; proto_range_of / proto_same_base_as are still
// trivially satisfied.
#[lang(proto_array_of)]
protocol ArrayOf<T> {}
#[lang(proto_pointer_of)]
protocol PointerOf<T> {}
#[lang(proto_range_of)]
protocol RangeOf<T> {}
#[lang(proto_same_layout_as)]
protocol SameLayoutAs<T> {}
#[lang(proto_same_base_as)]
protocol SameBaseAs<T> {}

// Lang item structs for composite type methods.

#[lang(builtin_array)]
struct array {}

type element_of<T> = typeof({ let t: T; t[0] });

impl array<Arr> {
    fn as_slice(self: &Arr) -> &[element_of<Arr>] {
        self
    }

    fn len(self: &Arr) -> usize {
        std::intrinsics::length_of::<Arr>()
    }

    fn iter(self: &Arr) -> std::iter::SliceIterator<element_of<Arr>> {
        self.as_slice().iter()
    }
}

#[lang(builtin_tuple)]
struct tuple {}

impl tuple {
    fn len<T>(self: &T) -> usize {
        std::intrinsics::length_of::<T>()
    }
    /// Element-wise equality via static_for + tuple-index auto-deref.
    fn equals<T>(lhs: &T, rhs: &T) -> bool {
        for const i in 0usize..lhs.len() {
            if lhs.(i) != rhs.(i) {
                return false;
            }
        }
        true
    }
    fn not_equals<T>(lhs: &T, rhs: &T) -> bool {
        !tuple::equals::<T>(lhs, rhs)
    }
    /// Format `(a, b, c)` by writing each element separated with ", ".
    /// Empty tuple renders as `()`.
    fn fmt<T, F: std::fmt::Formatter<F>>(self: &T, f: &mut F) -> std::fmt::Result {
        f.write_byte('(' as u8)?;
        for const i in 0usize..std::intrinsics::length_of::<T>() {
            when i > 0usize {
                f.write_str(", ")?;
            }
            self.(i).fmt(f)?;
        }
        f.write_byte(')' as u8)
    }
}

#[lang(builtin_callable)]
struct callable {}

// Lang item structs for builtin type methods.
// These map to the corresponding builtin types and provide methods on them.

#[lang(builtin_never)]
struct never {}

#[lang(builtin_bool)]
struct bool {}
impl bool {
    fn equals(lhs: &bool, rhs: &bool) -> bool { *lhs == *rhs }
    fn not_equals(lhs: &bool, rhs: &bool) -> bool { *lhs != *rhs }
    fn fmt<F: std::fmt::Formatter<F>>(self: &bool, f: &mut F) -> std::fmt::Result {
        f.write_str(if *self { "true" } else { "false" })
    }
    fn hash<H: std::hash::Hasher<H>>(self: &bool, hasher: &mut H) {
        hasher.write(std::mem::slice_from_raw_const::<u8>(self as &u8, 1usize));
    }
}

#[lang(builtin_u8)]
struct u8 {}
impl u8 {
    fn min_value() -> u8 { 0u8 }
    fn max_value() -> u8 { 255u8 }
    fn count_ones(self: u8) -> u32 {
        std::intrinsics::llvm::<u8>("llvm.ctpop", self) as u32
    }
    fn count_zeros(self: u8) -> u32 {
        (~self).count_ones()
    }
    fn leading_zeros(self: u8) -> u32 {
        std::intrinsics::llvm::<u8>("llvm.ctlz", self, false) as u32
    }
    fn trailing_zeros(self: u8) -> u32 {
        std::intrinsics::llvm::<u8>("llvm.cttz", self, false) as u32
    }
    /// Single-byte swap_bytes is identity (LLVM bswap requires width >= 16).
    fn swap_bytes(self: u8) -> u8 { self }
    /// Add with overflow check.
    fn checked_add(lhs: u8, rhs: u8) -> Option<u8> {
        let r = lhs as u16 + rhs as u16;
        if r > 255u16 { Option::none() } else { Option::some(r as u8) }
    }
    /// Subtract with overflow check.
    fn checked_sub(lhs: u8, rhs: u8) -> Option<u8> {
        if rhs > lhs { Option::none() } else { Option::some(lhs - rhs) }
    }
    /// Multiply with overflow check.
    fn checked_mul(lhs: u8, rhs: u8) -> Option<u8> {
        let r = lhs as u16 * rhs as u16;
        if r > 255u16 { Option::none() } else { Option::some(r as u8) }
    }
    fn equals(lhs: &u8, rhs: &u8) -> bool { *lhs == *rhs }
    fn not_equals(lhs: &u8, rhs: &u8) -> bool { *lhs != *rhs }
    fn compare(lhs: &u8, rhs: &u8) -> std::cmp::Ordering {
        if *lhs < *rhs { std::cmp::Ordering::Less }
        else if *lhs == *rhs { std::cmp::Ordering::Equal }
        else { std::cmp::Ordering::Greater }
    }
    fn less_than(lhs: &u8, rhs: &u8) -> bool { *lhs < *rhs }
    fn less_than_or_equal(lhs: &u8, rhs: &u8) -> bool { *lhs <= *rhs }
    fn greater_than(lhs: &u8, rhs: &u8) -> bool { *lhs > *rhs }
    fn greater_than_or_equal(lhs: &u8, rhs: &u8) -> bool { *lhs >= *rhs }
    fn fmt<F: std::fmt::Formatter<F>>(self: &u8, f: &mut F) -> std::fmt::Result {
        std::fmt::internal::format_integer_unsigned::<F>(*self as u64, f)
    }
    fn hash<H: std::hash::Hasher<H>>(self: &u8, hasher: &mut H) {
        hasher.write(std::mem::slice_from_raw_const::<u8>(self as &u8, 1usize));
    }
}

