//! Type for operations that can fail.
//!
//! The `?` operator on Result types desugars to the `try` macro below.

/// Try macro for Result: desugars `expr?` to early-return on error.
macro try($result) {
    {
        let _result = $result;
        if _result._is_ok {
            _result._ok
        } else {
            return Result::err(_result._err)
        }
    }
}

/// Either a success value or an error value.
struct Result<T, E> {
    _is_ok: bool,
    _ok: T,
    _err: E,
}

impl Result<T, E> {
    /// Create a success variant
    fn ok(value: T) -> Result<T, E> {
        let r: Result<T, E> = std::mem::zeroed::<Result<T, E>>();
        r._is_ok = true;
        r._ok = value;
        r
    }

    /// Create an error variant
    fn err(value: E) -> Result<T, E> {
        let r: Result<T, E> = std::mem::zeroed::<Result<T, E>>();
        r._is_ok = false;
        r._err = value;
        r
    }

    /// Returns `true` if the result contains an OK variant
    fn is_ok(self: &Result<T, E>) -> bool {
        self._is_ok
    }

    /// Returns `true` if the result contains an error variant
    fn is_err(self: &Result<T, E>) -> bool {
        !self._is_ok
    }

    /// Return the success value, aborting if error value is present
    fn unwrap(self: Result<T, E>) -> T {
        if !self._is_ok {
            libc::abort();
        }
        self._ok
    }

    /// Return the error value, aborting if success value is present
    fn unwrap_err(self: Result<T, E>) -> E {
        if self._is_ok {
            libc::abort();
        }
        self._err
    }

    /// Return the success value or a default value
    fn unwrap_or(self: Result<T, E>, val: T) -> T {
        if self._is_ok {
            self._ok
        } else {
            val
        }
    }

    /// Return the success value or a default value provided by a callback
    fn unwrap_or_else<F: Fn(E) -> T>(self: Result<T, E>, func: F) -> T {
        if self._is_ok {
            self._ok
        } else {
            func(self._err)
        }
    }

    /// Converts from `Result<T, E>` to `Option<T>`.
    fn get(self: Result<T, E>) -> Option<T> {
        if self._is_ok {
            Option::some(self._ok)
        } else {
            Option::none()
        }
    }

    /// Converts from `Result<T, E>` to `Option<E>`.
    fn get_err(self: Result<T, E>) -> Option<E> {
        if self._is_ok {
            Option::none()
        } else {
            Option::some(self._err)
        }
    }

    /// Transform the success value by calling the provided function.
    fn map<Tm, F: Fn(T) -> Tm>(self: Result<T, E>, func: F) -> Result<Tm, E> {
        if self._is_ok {
            Result::ok(func(self._ok))
        } else {
            Result::err(self._err)
        }
    }

    /// Transform the error value by calling the provided function.
    fn map_err<Em, F: Fn(E) -> Em>(self: Result<T, E>, func: F) -> Result<T, Em> {
        if self._is_ok {
            Result::ok(self._ok)
        } else {
            Result::err(func(self._err))
        }
    }

    /// Transform the value by calling the provided function, which returns a Result.
    fn and_then<Tm, F: Fn(T) -> Result<Tm, E>>(self: Result<T, E>, func: F) -> Result<Tm, E> {
        if self._is_ok {
            func(self._ok)
        } else {
            Result::err(self._err)
        }
    }

    /// Return the result if ok, otherwise call `func` with the error.
    fn or_else<Em, F: Fn(E) -> Result<T, Em>>(self: Result<T, E>, func: F) -> Result<T, Em> {
        if self._is_ok {
            Result::ok(self._ok)
        } else {
            func(self._err)
        }
    }

    fn fmt<F: std::fmt::Formatter<F>>(self: &Result<T, E>, f: &mut F) -> std::fmt::Result {
        if self._is_ok {
            f.write_str("ok(...)")
        } else {
            f.write_str("err(...)")
        }
    }
}

impl Result {
    /// Convert `Result<Option<T>, E>` to `Option<Result<T, E>>`.
    fn transpose<T, E>(self: Result<Option<T>, E>) -> Option<Result<T, E>> {
        if self.is_ok() {
            let opt: Option<T> = self.unwrap();
            if opt.is_some() {
                let v: T = opt.unwrap();
                let r: Result<T, E> = Result::ok(v);
                Option::some(r)
            } else {
                let none_val: Option<Result<T, E>> = Option::none();
                none_val
            }
        } else {
            let e: E = self.unwrap_err();
            let r: Result<T, E> = Result::err(e);
            Option::some(r)
        }
    }

    /// Compare two results for equality.
    fn equals<T: Equatable<T>, E: Equatable<E>>(lhs: &Result<T, E>, rhs: &Result<T, E>) -> bool {
        if lhs._is_ok && rhs._is_ok {
            lhs._ok.equals(&rhs._ok)
        } else if !lhs._is_ok && !rhs._is_ok {
            lhs._err.equals(&rhs._err)
        } else {
            false
        }
    }

    /// Compare two results for inequality.
    fn not_equals<T: Equatable<T>, E: Equatable<E>>(lhs: &Result<T, E>, rhs: &Result<T, E>) -> bool {
        !Result::equals::<T, E>(lhs, rhs)
    }
}
