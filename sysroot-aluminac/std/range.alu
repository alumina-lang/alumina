/// An unbounded range (`..`)
#[lang(range_full)]
struct RangeFull<T: std::builtins::Integer> {
}

impl RangeFull<T: std::builtins::Integer> {
    #[lang(range_full_new)]
    fn new() -> RangeFull<T> {
        RangeFull {}
    }

    fn equals(self: &RangeFull<T>, _other: &RangeFull<T>) -> bool {
        true
    }

    fn fmt<F: std::fmt::Formatter<F>>(self: &RangeFull<T>, f: &mut F) -> std::fmt::Result {
        std::fmt::write!(f, "..")
    }

    fn hash<H: std::hash::Hasher<H>>(self: &RangeFull<T>, _h: &mut H) {
    }

    mixin std::cmp::Equatable<RangeFull<T>>;
    mixin<H: std::hash::Hasher<H>> std::hash::Hashable<RangeFull<T>, H>;
}

/// A range with only a lower bound (`a..`)
#[lang(range_from)]
struct RangeFrom<T: std::builtins::Integer> {
    lower: T,
}

impl RangeFrom<T: std::builtins::Integer> {
    #[lang(range_from_new)]
    fn new(lower: T) -> RangeFrom<T> {
        RangeFrom { lower: lower }
    }

    /// Returns true if value is within the range [lower, ∞).
    fn contains(self: &RangeFrom<T>, value: T) -> bool {
        value >= self.lower
    }

    fn equals(self: &RangeFrom<T>, other: &RangeFrom<T>) -> bool {
        self.lower == other.lower
    }

    /// Returns the iterator (self copy) for use in for loops.
    fn iter(self: &RangeFrom<T>) -> RangeFrom<T> {
        *self
    }

    /// Returns the next value in the range. Always Some — RangeFrom is infinite.
    fn next(self: &mut RangeFrom<T>) -> Option<T> {
        let lower = self.lower;
        self.lower += 1;
        Option::some(lower)
    }

    fn fmt<F: std::fmt::Formatter<F>>(self: &RangeFrom<T>, f: &mut F) -> std::fmt::Result {
        std::fmt::write!(f, "{}..", self.lower)
    }

    fn hash<H: std::hash::Hasher<H>>(self: &RangeFrom<T>, h: &mut H) {
        self.lower.hash::<H>(h);
    }

    mixin std::cmp::Equatable<RangeFrom<T>>;
    mixin std::iter::Iterator<RangeFrom<T>, T>;
    mixin std::iter::IteratorExt<RangeFrom<T>, T>;
    mixin<H: std::hash::Hasher<H>> std::hash::Hashable<RangeFrom<T>, H>;
}

/// A range with only an upper bound (`..b`)
#[lang(range_to)]
struct RangeTo<T: std::builtins::Integer> {
    upper: T,
}

impl RangeTo<T: std::builtins::Integer> {
    #[lang(range_to_new)]
    fn new(upper: T) -> RangeTo<T> {
        RangeTo { upper: upper }
    }

    /// Returns true if value is within the range (-∞, upper).
    fn contains(self: &RangeTo<T>, value: T) -> bool {
        value < self.upper
    }

    fn equals(self: &RangeTo<T>, other: &RangeTo<T>) -> bool {
        self.upper == other.upper
    }

    fn fmt<F: std::fmt::Formatter<F>>(self: &RangeTo<T>, f: &mut F) -> std::fmt::Result {
        std::fmt::write!(f, "..{}", self.upper)
    }

    fn hash<H: std::hash::Hasher<H>>(self: &RangeTo<T>, h: &mut H) {
        self.upper.hash::<H>(h);
    }

    mixin std::cmp::Equatable<RangeTo<T>>;
    mixin<H: std::hash::Hasher<H>> std::hash::Hashable<RangeTo<T>, H>;
}

/// A range with only an inclusive upper bound (`..=b`)
#[lang(range_to_inclusive)]
struct RangeToInclusive<T: std::builtins::Integer> {
    upper: T,
}

impl RangeToInclusive<T: std::builtins::Integer> {
    #[lang(range_to_inclusive_new)]
    fn new(upper: T) -> RangeToInclusive<T> {
        RangeToInclusive { upper: upper }
    }

    /// Returns true if value is within the range (-∞, upper].
    fn contains(self: &RangeToInclusive<T>, value: T) -> bool {
        value <= self.upper
    }

    fn equals(self: &RangeToInclusive<T>, other: &RangeToInclusive<T>) -> bool {
        self.upper == other.upper
    }

    fn fmt<F: std::fmt::Formatter<F>>(self: &RangeToInclusive<T>, f: &mut F) -> std::fmt::Result {
        std::fmt::write!(f, "..={}", self.upper)
    }

    fn hash<H: std::hash::Hasher<H>>(self: &RangeToInclusive<T>, h: &mut H) {
        self.upper.hash::<H>(h);
    }

    mixin std::cmp::Equatable<RangeToInclusive<T>>;
    mixin<H: std::hash::Hasher<H>> std::hash::Hashable<RangeToInclusive<T>, H>;
}

/// A range with both lower and upper bounds (a..b)
#[lang(range)]
struct Range<T: std::builtins::Integer> {
    lower: T,
    upper: T,
}

impl Range<T: std::builtins::Integer> {
    #[lang(range_new)]
    fn new(lower: T, upper: T) -> Range<T> {
        Range { lower: lower, upper: upper }
    }

    /// Returns true if value is within the range [lower, upper).
    fn contains(self: &Range<T>, value: T) -> bool {
        value >= self.lower && value < self.upper
    }

    /// Returns true if the range is empty (lower >= upper).
    fn is_empty(self: &Range<T>) -> bool {
        self.lower >= self.upper
    }

    /// Returns the iterator (self copy) for use in for loops.
    fn iter(self: &Range<T>) -> Range<T> {
        *self
    }

    /// Returns the next value in the range, or none if exhausted.
    fn next(self: &mut Range<T>) -> Option<T> {
        if self.lower < self.upper {
            let lower = self.lower;
            self.lower += 1;
            Option::some(lower)
        } else {
            Option::none()
        }
    }

    /// Returns the next value from the back, or none if exhausted.
    fn next_back(self: &mut Range<T>) -> Option<T> {
        if self.lower < self.upper {
            self.upper -= 1;
            Option::some(self.upper)
        } else {
            Option::none()
        }
    }

    /// Returns the number of remaining elements.
    fn size_hint(self: &Range<T>) -> Option<usize> {
        if self.lower < self.upper {
            Option::some(self.upper as usize - self.lower as usize)
        } else {
            Option::some(0usize)
        }
    }

    fn equals(self: &Range<T>, other: &Range<T>) -> bool {
        self.lower == other.lower && self.upper == other.upper
    }

    fn fmt<F: std::fmt::Formatter<F>>(self: &Range<T>, f: &mut F) -> std::fmt::Result {
        std::fmt::write!(f, "{}..{}", self.lower, self.upper)
    }

    fn hash<H: std::hash::Hasher<H>>(self: &Range<T>, h: &mut H) {
        self.lower.hash::<H>(h);
        self.upper.hash::<H>(h);
    }

    mixin std::cmp::Equatable<Range<T>>;
    mixin std::iter::Iterator<Range<T>, T>;
    mixin std::iter::IteratorExt<Range<T>, T>;
    mixin std::iter::DoubleEndedIterator<Range<T>, T>;
    mixin std::iter::DoubleEndedIteratorExt<Range<T>, T>;
    mixin<H: std::hash::Hasher<H>> std::hash::Hashable<Range<T>, H>;
}

/// An inclusive range with both lower and upper bounds (a..=b)
#[lang(range_inclusive)]
struct RangeInclusive<T: std::builtins::Integer> {
    lower: T,
    upper: T,
    _exhausted: bool,
}

impl RangeInclusive<T: std::builtins::Integer> {
    #[lang(range_inclusive_new)]
    fn new(lower: T, upper: T) -> RangeInclusive<T> {
        RangeInclusive { lower: lower, upper: upper, _exhausted: false }
    }

    /// Returns true if value is within the range [lower, upper].
    fn contains(self: &RangeInclusive<T>, value: T) -> bool {
        value >= self.lower && value <= self.upper
    }

    /// Returns true if the range is empty.
    fn is_empty(self: &RangeInclusive<T>) -> bool {
        self.lower > self.upper || self._exhausted
    }

    /// Returns the iterator (self copy) for use in for loops.
    fn iter(self: &RangeInclusive<T>) -> RangeInclusive<T> {
        *self
    }

    /// Returns the next value in the range, or none if exhausted.
    fn next(self: &mut RangeInclusive<T>) -> Option<T> {
        if self.lower <= self.upper && !self._exhausted {
            let lower = self.lower;
            if self.lower == self.upper {
                self._exhausted = true;
            } else {
                self.lower += 1;
            }
            Option::some(lower)
        } else {
            Option::none()
        }
    }

    /// Returns the next value from the back, or none if exhausted.
    fn next_back(self: &mut RangeInclusive<T>) -> Option<T> {
        if self.lower <= self.upper && !self._exhausted {
            let upper = self.upper;
            if self.lower == self.upper {
                self._exhausted = true;
            } else {
                self.upper -= 1;
            }
            Option::some(upper)
        } else {
            Option::none()
        }
    }

    /// Returns the number of remaining elements.
    fn size_hint(self: &RangeInclusive<T>) -> Option<usize> {
        if self.lower <= self.upper && !self._exhausted {
            Option::some(self.upper as usize - self.lower as usize + 1)
        } else {
            Option::some(0usize)
        }
    }

    fn equals(self: &RangeInclusive<T>, other: &RangeInclusive<T>) -> bool {
        self.lower == other.lower && self.upper == other.upper
    }

    fn fmt<F: std::fmt::Formatter<F>>(self: &RangeInclusive<T>, f: &mut F) -> std::fmt::Result {
        std::fmt::write!(f, "{}..={}", self.lower, self.upper)
    }

    fn hash<H: std::hash::Hasher<H>>(self: &RangeInclusive<T>, h: &mut H) {
        self.lower.hash::<H>(h);
        self.upper.hash::<H>(h);
    }

    mixin std::cmp::Equatable<RangeInclusive<T>>;
    mixin std::iter::Iterator<RangeInclusive<T>, T>;
    mixin std::iter::IteratorExt<RangeInclusive<T>, T>;
    mixin std::iter::DoubleEndedIterator<RangeInclusive<T>, T>;
    mixin std::iter::DoubleEndedIteratorExt<RangeInclusive<T>, T>;
    mixin<H: std::hash::Hasher<H>> std::hash::Hashable<RangeInclusive<T>, H>;
}
