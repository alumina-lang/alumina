// Simplified standard library for self-hosted compiler bootstrap.
// Modules are auto-loaded from directory structure by the sysroot loader.
//
// The `panic!` macro is provided by `std::panicking` (and brought in via the
// prelude). The assert family below mirrors sysroot's `internal::assert` /
// `internal::assert_eq` / `internal::assert_ne` shape so that future
// unification of `std/mod.alu` is mechanical.

// Builtin macros (handled by the compiler).
#[builtin] macro line() {}
#[builtin] macro column() {}
#[builtin] macro file() {}
#[builtin] macro env($s) {}
#[builtin] macro cfg($s) {}
#[builtin] macro include_bytes($file) {}
#[builtin] macro stringify($expr) {}

macro assert($cond) {
    if !$cond {
        internal::panic_assert(file!(), line!(), column!());
    }
}

macro assert_eq($lhs, $rhs) {
    internal::assert_eq(file!(), line!(), column!(), $lhs, $rhs);
}

macro assert_ne($lhs, $rhs) {
    internal::assert_ne(file!(), line!(), column!(), $lhs, $rhs);
}

macro debug_assert($cond) {
    // no-op in release mode
}

macro unreachable() {
    panic!("entered unreachable code")
}

macro todo() {
    panic!("not yet implemented")
}

mod internal {
    use panicking::internal::panic_impl;

    #[cold]
    #[inline(never)]
    fn panic_assert(file: &[u8], line: i32, column: i32) -> ! {
        panic_impl(
            file, line, column,
            &fmt::format_args!(
                fmt::internal::dyn_format_args,
                "assertion failed"
            )
        )
    }

    #[inline(always)]
    fn assert_eq<T>(file: &[u8], line: i32, column: i32, lhs: T, rhs: T) {
        #[cold]
        #[inline(never)]
        fn panic_assert_eq(file: &[u8], line: i32, column: i32, lhs: T, rhs: T) -> ! {
            use std::fmt::debug;
            panic_impl(
                file, line, column,
                &fmt::format_args!(
                    fmt::internal::dyn_format_args,
                    "assertion failed ({} != {})",
                    lhs.debug(),
                    rhs.debug()
                )
            )
        }

        if !(lhs == rhs) {
            panic_assert_eq(file, line, column, lhs, rhs);
        }
    }

    #[inline(always)]
    fn assert_ne<T>(file: &[u8], line: i32, column: i32, lhs: T, rhs: T) {
        #[cold]
        #[inline(never)]
        fn panic_assert_ne(file: &[u8], line: i32, column: i32, lhs: T, rhs: T) -> ! {
            use std::fmt::debug;
            panic_impl(
                file, line, column,
                &fmt::format_args!(
                    fmt::internal::dyn_format_args,
                    "assertion failed ({} == {})",
                    lhs.debug(),
                    rhs.debug()
                )
            )
        }

        if lhs == rhs {
            panic_assert_ne(file, line, column, lhs, rhs);
        }
    }
}
