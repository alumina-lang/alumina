// Simplified standard library for self-hosted compiler bootstrap
// Modules are auto-loaded from directory structure by the sysroot loader.

macro panic($reason, $args...) {
    {
        let _file: &[u8] = file!();
        let _line: i32 = line!();
        let _col: i32 = column!();
        eprint!("panic at {}:{}:{}: ", _file, _line, _col);
        eprintln!($reason, $args$...);
        panicking::internal::panic_with_hook(_file, _line, _col);
    }
}

macro assert($cond) {
    if !$cond {
        let _file: &[u8] = file!();
        let _line: i32 = line!();
        let _col: i32 = column!();
        eprint!("panic at {}:{}:{}: ", _file, _line, _col);
        eprintln!("assertion failed");
        panicking::internal::panic_with_hook(_file, _line, _col);
    }
}

macro assert_eq($a, $b) {
    {
        let _a = $a;
        let _b = $b;
        if _a != _b {
            let _file: &[u8] = file!();
            let _line: i32 = line!();
            let _col: i32 = column!();
            eprint!("panic at {}:{}:{}: ", _file, _line, _col);
            eprintln!("assertion failed: {} != {}", _a, _b);
            panicking::internal::panic_with_hook(_file, _line, _col);
        }
    }
}

macro assert_ne($a, $b) {
    {
        let _a = $a;
        let _b = $b;
        if _a == _b {
            let _file: &[u8] = file!();
            let _line: i32 = line!();
            let _col: i32 = column!();
            eprint!("panic at {}:{}:{}: ", _file, _line, _col);
            eprintln!("assertion failed: {} == {}", _a, _b);
            panicking::internal::panic_with_hook(_file, _line, _col);
        }
    }
}

macro debug_assert($cond) {
    // no-op in release mode
}

macro unreachable() {
    panic!("entered unreachable code")
}

macro todo() {
    panic!("not yet implemented")
}
