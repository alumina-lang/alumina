// HashSet backed by HashMap

struct HashSet<K> {
    _inner: std::collections::hashmap::HashMap<K, bool>,
}

impl HashSet<K> {
    /// Create an empty hash set.
    fn new() -> HashSet<K> {
        HashSet::<K> {
            _inner: std::collections::hashmap::HashMap::new(),
        }
    }

    /// Create a hash set with pre-allocated capacity.
    fn with_capacity(capacity: usize) -> HashSet<K> {
        HashSet::<K> {
            _inner: std::collections::hashmap::HashMap::with_capacity(capacity),
        }
    }

    /// Return the number of elements in the set.
    fn len(self: &HashSet<K>) -> usize {
        self._inner.len()
    }

    /// Returns `true` if the set contains no elements.
    fn is_empty(self: &HashSet<K>) -> bool {
        self._inner.is_empty()
    }

    /// Insert a key into the set. Returns `true` if the key was newly inserted.
    fn insert(self: &mut HashSet<K>, key: K) -> bool {
        self._inner.insert(key, true).is_none()
    }

    /// Returns `true` if the set contains the given key.
    fn contains(self: &HashSet<K>, key: &K) -> bool {
        self._inner.contains_key(key)
    }

    /// Remove a key from the set. Returns `true` if the key was present.
    fn remove(self: &mut HashSet<K>, key: &K) -> bool {
        self._inner.remove(key).is_some()
    }

    /// Remove all elements from the set.
    fn clear(self: &mut HashSet<K>) {
        self._inner.clear();
    }

    /// Reserve capacity for at least `additional` more elements.
    fn reserve(self: &mut HashSet<K>, additional: usize) {
        self._inner.reserve(additional);
    }

    /// Iterate over the keys in the set.
    fn iter(self: &HashSet<K>) -> HashSetIterator<K> {
        HashSetIterator::<K> {
            _it: self._inner.keys(),
        }
    }

    /// Extend the set with elements from a slice.
    fn extend_from_slice(self: &mut HashSet<K>, slice: &[K]) {
        for i in 0usize..slice.len() {
            self.insert(slice[i]);
        }
    }

    /// Free the set's underlying storage.
    fn free(self: &mut HashSet<K>) {
        self._inner.free();
    }
}

/// Iterator over keys in a HashSet.
struct HashSetIterator<K> {
    _it: std::collections::hashmap::HashMapKeyIterator<K, bool>,
}

impl HashSetIterator<K> {
    fn next(self: &mut HashSetIterator<K>) -> Option<K> {
        self._it.next()
    }
    mixin std::iter::Iterator<HashSetIterator<K>, K>;
}

impl HashSet {
    /// Create a hash set from a slice.
    fn from_slice<K>(slice: &[K]) -> HashSet<K> {
        let s: HashSet<K> = HashSet::with_capacity(slice.len());
        for i in 0usize..slice.len() {
            s.insert(slice[i]);
        }
        s
    }

}
