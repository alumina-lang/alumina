// Open-addressing hash map with linear probing
// Hashes raw bytes of keys using FNV-1a
// Correctness relies on == for key comparison; hash is for bucket selection only

struct HashMap<K, V> {
    _keys: &mut [K],
    _values: &mut [V],
    _states: &mut [u8],  // 0=vacant, 1=occupied, 2=tombstone
    _length: usize,
    _capacity: usize,
}

impl HashMap<K, V> {
    /// Create an empty hash map.
    fn new() -> HashMap<K, V> {
        HashMap::<K, V> {
            _keys: std::mem::slice_empty::<K>(),
            _values: std::mem::slice_empty::<V>(),
            _states: std::mem::slice_empty::<u8>(),
            _length: 0usize,
            _capacity: 0usize,
        }
    }

    /// Create a hash map with pre-allocated capacity for at least `capacity` elements.
    fn with_capacity(capacity: usize) -> HashMap<K, V> {
        if capacity == 0usize {
            return HashMap::new::<K, V>();
        }
        // Allocate enough buckets so load factor stays below 0.75
        let buckets = capacity * 4usize / 3usize + 1usize;
        if buckets < 16usize {
            buckets = 16usize;
        }
        let map = HashMap::<K, V> {
            _keys: std::mem::slice_alloc::<K>(buckets),
            _values: std::mem::slice_alloc::<V>(buckets),
            _states: std::mem::slice_alloc::<u8>(buckets),
            _length: 0usize,
            _capacity: buckets,
        };
        let i = 0usize;
        while i < buckets {
            map._states[i] = 0u8;
            i = i + 1usize;
        }
        map
    }

    /// Return the number of elements in the map.
    fn len(self: &HashMap<K, V>) -> usize {
        self._length
    }

    /// Return the number of buckets in the underlying storage.
    fn capacity(self: &HashMap<K, V>) -> usize {
        self._capacity
    }

    /// Returns `true` if the map contains no elements.
    fn is_empty(self: &HashMap<K, V>) -> bool {
        self._length == 0usize
    }

    fn _keys_equal(a: &K, b: &K) -> bool {
        when *a is &[u8] {
            // Slice key (&[u8]): compare pointed-to content bytes
            let raw_a = a as &K as &usize;
            let ptr_a = *(&raw_a[0]) as &u8;
            let len_a = *(&raw_a[1]);
            let raw_b = b as &K as &usize;
            let ptr_b = *(&raw_b[0]) as &u8;
            let len_b = *(&raw_b[1]);
            if len_a != len_b {
                return false;
            }
            let i = 0usize;
            while i < len_a {
                if *(&ptr_a[i]) != *(&ptr_b[i]) {
                    return false;
                }
                i = i + 1usize;
            }
            return true;
        } else {
            return *a == *b;
        }
    }

    fn _hash_key(key: &K) -> usize {
        let h = 14695981039346656037usize; // FNV offset basis

        when *key is &[u8] {
            // Slice key (&[u8]): hash the pointed-to content bytes
            // Fat pointer layout is {ptr: &u8, len: usize}
            let raw = key as &K as &usize;
            let ptr = *(&raw[0]) as &u8;
            let len = *(&raw[1]);
            let i = 0usize;
            while i < len {
                let b = *(&ptr[i]) as usize;
                h = h ^ b;
                h = h * 1099511628211usize;
                i = i + 1usize;
            }
        } else {
            // Scalar type (usize, u64, etc.): hash raw bytes of value
            let bytes = key as &K as &u8;
            let key_size = std::mem::size_of::<K>();
            let i = 0usize;
            while i < key_size {
                let b = *(&bytes[i]) as usize;
                h = h ^ b;
                h = h * 1099511628211usize;
                i = i + 1usize;
            }
        }

        h
    }

    fn _find_slot(self: &HashMap<K, V>, key: &K) -> usize {
        let h = HashMap::<K, V>::_hash_key(key);
        let idx = h % self._capacity;
        let i = 0usize;
        while i < self._capacity {
            let slot = (idx + i) % self._capacity;
            if self._states[slot] == 0u8 {
                return slot;
            }
            if self._states[slot] == 1u8 && HashMap::<K, V>::_keys_equal(&self._keys[slot], key) {
                return slot;
            }
            // state==2 (tombstone) or occupied with different key: continue probing
            i = i + 1usize;
        }
        // Should never reach here if load factor < 1
        idx
    }

    fn _find_slot_for_insert(self: &HashMap<K, V>, key: &K) -> usize {
        let h = HashMap::<K, V>::_hash_key(key);
        let idx = h % self._capacity;
        let first_tombstone = self._capacity; // sentinel: not found
        let i = 0usize;
        while i < self._capacity {
            let slot = (idx + i) % self._capacity;
            if self._states[slot] == 0u8 {
                // Empty slot: key doesn't exist. Use tombstone if we found one.
                if first_tombstone < self._capacity {
                    return first_tombstone;
                }
                return slot;
            }
            if self._states[slot] == 2u8 && first_tombstone == self._capacity {
                first_tombstone = slot;
            }
            if self._states[slot] == 1u8 && HashMap::<K, V>::_keys_equal(&self._keys[slot], key) {
                return slot; // Key exists, return its slot for overwrite
            }
            i = i + 1usize;
        }
        if first_tombstone < self._capacity {
            return first_tombstone;
        }
        idx
    }

    fn _grow(self: &mut HashMap<K, V>) {
        let new_cap = if self._capacity == 0usize { 16usize } else { self._capacity * 2usize };
        self._rehash(new_cap);
    }

    fn _rehash(self: &mut HashMap<K, V>, new_cap: usize) {
        let old_keys = self._keys;
        let old_values = self._values;
        let old_states = self._states;
        let old_cap = self._capacity;

        self._keys = std::mem::slice_alloc::<K>(new_cap);
        self._values = std::mem::slice_alloc::<V>(new_cap);
        self._states = std::mem::slice_alloc::<u8>(new_cap);
        self._capacity = new_cap;
        self._length = 0usize;

        // Zero new states
        let i = 0usize;
        while i < new_cap {
            self._states[i] = 0u8;
            i = i + 1usize;
        }

        // Re-insert existing entries
        let j = 0usize;
        while j < old_cap {
            if old_states[j] == 1u8 {
                self.insert(old_keys[j], old_values[j]);
            }
            j = j + 1usize;
        }

        if old_cap > 0usize {
            std::mem::slice_free::<K>(old_keys);
            std::mem::slice_free::<V>(old_values);
            std::mem::slice_free::<u8>(old_states);
        }
    }

    /// Reserve capacity for at least `additional` more elements.
    fn reserve(self: &mut HashMap<K, V>, additional: usize) {
        let needed = self._length + additional;
        // Keep load factor below 0.75
        if needed * 4usize > self._capacity * 3usize {
            let new_cap = std::cmp::max(self._capacity * 2usize, needed * 4usize / 3usize + 1usize);
            if new_cap < 16usize {
                new_cap = 16usize;
            }
            self._rehash(new_cap);
        }
    }

    /// Insert a key-value pair. If the key already exists, the value is updated
    /// and the old value is returned.
    fn insert(self: &mut HashMap<K, V>, key: K, value: V) -> Option<V> {
        // Grow if load factor > 0.75
        if self._capacity == 0usize || (self._length + 1usize) * 4usize > self._capacity * 3usize {
            self._grow();
        }

        let slot = self._find_slot_for_insert(&key);
        if self._states[slot] == 1u8 {
            // Key exists, replace value
            let old = self._values[slot];
            self._values[slot] = value;
            return Option::some(old);
        }
        self._length = self._length + 1usize;
        self._keys[slot] = key;
        self._values[slot] = value;
        self._states[slot] = 1u8;
        Option::none()
    }

    /// Get a copy of the value associated with the key.
    fn get(self: &HashMap<K, V>, key: &K) -> Option<V> {
        if self._capacity == 0usize {
            return Option::none();
        }
        let h = HashMap::<K, V>::_hash_key(key);
        let idx = h % self._capacity;
        let i = 0usize;
        while i < self._capacity {
            let slot = (idx + i) % self._capacity;
            if self._states[slot] == 0u8 {
                return Option::none();
            }
            if self._states[slot] == 1u8 && HashMap::<K, V>::_keys_equal(&self._keys[slot], key) {
                return Option::some(self._values[slot]);
            }
            i = i + 1usize;
        }
        Option::none()
    }

    /// Get a reference to the value associated with the key.
    fn get_ref(self: &HashMap<K, V>, key: &K) -> Option<&V> {
        if self._capacity == 0usize {
            return Option::none();
        }
        let h = HashMap::<K, V>::_hash_key(key);
        let idx = h % self._capacity;
        let i = 0usize;
        while i < self._capacity {
            let slot = (idx + i) % self._capacity;
            if self._states[slot] == 0u8 {
                return Option::none();
            }
            if self._states[slot] == 1u8 && HashMap::<K, V>::_keys_equal(&self._keys[slot], key) {
                return Option::some(&self._values[slot]);
            }
            i = i + 1usize;
        }
        Option::none()
    }

    /// Get a mutable reference to the value associated with the key.
    fn get_mut(self: &mut HashMap<K, V>, key: &K) -> Option<&mut V> {
        if self._capacity == 0usize {
            return Option::none();
        }
        let h = HashMap::<K, V>::_hash_key(key);
        let idx = h % self._capacity;
        let i = 0usize;
        while i < self._capacity {
            let slot = (idx + i) % self._capacity;
            if self._states[slot] == 0u8 {
                return Option::none();
            }
            if self._states[slot] == 1u8 && HashMap::<K, V>::_keys_equal(&self._keys[slot], key) {
                return Option::some(&self._values[slot]);
            }
            i = i + 1usize;
        }
        Option::none()
    }

    /// Returns true if the map contains the given key.
    fn contains_key(self: &HashMap<K, V>, key: &K) -> bool {
        if self._capacity == 0usize {
            return false;
        }
        let h = HashMap::<K, V>::_hash_key(key);
        let idx = h % self._capacity;
        let i = 0usize;
        while i < self._capacity {
            let slot = (idx + i) % self._capacity;
            if self._states[slot] == 0u8 {
                return false;
            }
            if self._states[slot] == 1u8 && HashMap::<K, V>::_keys_equal(&self._keys[slot], key) {
                return true;
            }
            i = i + 1usize;
        }
        false
    }

    /// Remove the entry with the given key, returning the value if it existed.
    fn remove(self: &mut HashMap<K, V>, key: &K) -> Option<V> {
        if self._capacity == 0usize {
            return Option::none();
        }
        let h = HashMap::<K, V>::_hash_key(key);
        let idx = h % self._capacity;
        let i = 0usize;
        while i < self._capacity {
            let slot = (idx + i) % self._capacity;
            if self._states[slot] == 0u8 {
                return Option::none();
            }
            if self._states[slot] == 1u8 && HashMap::<K, V>::_keys_equal(&self._keys[slot], key) {
                self._states[slot] = 2u8; // tombstone
                self._length = self._length - 1usize;
                return Option::some(self._values[slot]);
            }
            i = i + 1usize;
        }
        Option::none()
    }

    /// Remove all entries from the map without releasing memory.
    fn clear(self: &mut HashMap<K, V>) {
        let i = 0usize;
        while i < self._capacity {
            self._states[i] = 0u8;
            i = i + 1usize;
        }
        self._length = 0usize;
    }

    /// Remove entries that don't match the predicate.
    fn retain<F: Fn(&K, &V) -> bool>(self: &mut HashMap<K, V>, func: F) {
        let deleted = 0usize;
        let i = 0usize;
        while i < self._capacity {
            if self._states[i] == 1u8 {
                if !func(&self._keys[i], &self._values[i]) {
                    self._states[i] = 2u8;
                    deleted = deleted + 1usize;
                }
            }
            i = i + 1usize;
        }
        self._length = self._length - deleted;
    }

    /// Return an iterator over the map's key-value pairs.
    fn iter(self: &HashMap<K, V>) -> HashMapIterator<K, V> {
        HashMapIterator::<K, V> {
            _map: self,
            _index: 0usize,
        }
    }

    /// Return an iterator over the map's keys.
    fn keys(self: &HashMap<K, V>) -> HashMapKeyIterator<K, V> {
        HashMapKeyIterator::<K, V> {
            _map: self,
            _index: 0usize,
        }
    }

    /// Return an iterator over the map's values.
    fn values(self: &HashMap<K, V>) -> HashMapValueIterator<K, V> {
        HashMapValueIterator::<K, V> {
            _map: self,
            _index: 0usize,
        }
    }

    /// Get the value for a key, inserting a default value if the key doesn't exist.
    fn get_or_insert(self: &mut HashMap<K, V>, key: K, default: V) -> &mut V {
        // Grow if needed
        if self._capacity == 0usize || (self._length + 1usize) * 4usize > self._capacity * 3usize {
            self._grow();
        }

        let slot = self._find_slot_for_insert(&key);
        if self._states[slot] != 1u8 {
            self._keys[slot] = key;
            self._values[slot] = default;
            self._states[slot] = 1u8;
            self._length = self._length + 1usize;
        }
        &self._values[slot]
    }

    /// Move the map's contents, leaving `self` empty.
    fn move(self: &mut HashMap<K, V>) -> HashMap<K, V> {
        let ret = *self;
        self._keys = std::mem::slice_empty::<K>();
        self._values = std::mem::slice_empty::<V>();
        self._states = std::mem::slice_empty::<u8>();
        self._length = 0usize;
        self._capacity = 0usize;
        ret
    }

    /// Clone the map, copying all entries.
    fn clone(self: &HashMap<K, V>) -> HashMap<K, V> {
        let map = HashMap::with_capacity::<K, V>(self._length);
        let i = 0usize;
        while i < self._capacity {
            if self._states[i] == 1u8 {
                map.insert(self._keys[i], self._values[i]);
            }
            i = i + 1usize;
        }
        map
    }

    /// Free the map's underlying storage.
    fn free(self: &mut HashMap<K, V>) {
        if self._capacity > 0usize {
            std::mem::slice_free::<K>(self._keys);
            std::mem::slice_free::<V>(self._values);
            std::mem::slice_free::<u8>(self._states);
        }
        self._keys = std::mem::slice_empty::<K>();
        self._values = std::mem::slice_empty::<V>();
        self._states = std::mem::slice_empty::<u8>();
        self._length = 0usize;
        self._capacity = 0usize;
    }
}

struct HashMapIterator<K, V> {
    _map: &HashMap<K, V>,
    _index: usize,
}

impl HashMapIterator<K, V> {
    fn next(self: &mut HashMapIterator<K, V>) -> Option<(K, V)> {
        while self._index < self._map._capacity {
            if self._map._states[self._index] == 1u8 {
                let k = self._map._keys[self._index];
                let v = self._map._values[self._index];
                self._index = self._index + 1usize;
                return Option::some((k, v));
            }
            self._index = self._index + 1usize;
        }
        Option::none()
    }
}

struct HashMapKeyIterator<K, V> {
    _map: &HashMap<K, V>,
    _index: usize,
}

impl HashMapKeyIterator<K, V> {
    fn next(self: &mut HashMapKeyIterator<K, V>) -> Option<K> {
        while self._index < self._map._capacity {
            if self._map._states[self._index] == 1u8 {
                let k = self._map._keys[self._index];
                self._index = self._index + 1usize;
                return Option::some(k);
            }
            self._index = self._index + 1usize;
        }
        Option::none()
    }
}

struct HashMapValueIterator<K, V> {
    _map: &HashMap<K, V>,
    _index: usize,
}

impl HashMapValueIterator<K, V> {
    fn next(self: &mut HashMapValueIterator<K, V>) -> Option<V> {
        while self._index < self._map._capacity {
            if self._map._states[self._index] == 1u8 {
                let v = self._map._values[self._index];
                self._index = self._index + 1usize;
                return Option::some(v);
            }
            self._index = self._index + 1usize;
        }
        Option::none()
    }
}
