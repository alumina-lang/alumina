/// A heap-allocated string buffer.
struct StringBuf {
    _data: &mut [u8],
    _length: usize,
}

impl StringBuf {
    /// Create an empty string buffer.
    fn new() -> StringBuf {
        StringBuf {
            _data: std::mem::slice_empty::<u8>(),
            _length: 0usize,
        }
    }

    /// Create a string buffer from a slice, copying the bytes.
    fn from_slice(s: &[u8]) -> StringBuf {
        let buf = StringBuf::with_capacity(s.len());
        if s.len() > 0usize {
            std::mem::memcpy(&buf._data[0] as &mut void, &s[0] as &void, s.len());
        }
        buf._length = s.len();
        buf
    }

    /// Create a string buffer from a raw slice and a length.
    ///
    /// The slice must be allocated with `std::mem::slice_alloc` and its length must be
    /// greater than or equal to `length`.
    fn from_raw(data: &mut [u8], length: usize) -> StringBuf {
        StringBuf {
            _data: data,
            _length: length,
        }
    }

    /// Create a string buffer with pre-allocated capacity.
    fn with_capacity(cap: usize) -> StringBuf {
        if cap == 0usize {
            return StringBuf::new();
        }
        StringBuf {
            _data: std::mem::slice_alloc::<u8>(cap),
            _length: 0usize,
        }
    }

    /// Return the length of the string.
    fn len(self: &StringBuf) -> usize {
        self._length
    }

    /// Return the capacity of the underlying buffer.
    fn capacity(self: &StringBuf) -> usize {
        self._data.len()
    }

    /// Returns `true` if the string is empty.
    fn is_empty(self: &StringBuf) -> bool {
        self._length == 0usize
    }

    /// Get the byte at the given index.
    ///
    /// Returns `Option::none()` if the index is out of bounds.
    fn get(self: &StringBuf, index: usize) -> Option<u8> {
        if index < self._length {
            Option::some(self._data[index])
        } else {
            Option::none()
        }
    }

    /// Return a slice of the string's contents.
    fn as_slice(self: &StringBuf) -> &[u8] {
        self._data[0usize..self._length]
    }

    /// Return a mutable slice of the string's contents.
    fn as_slice_mut(self: &mut StringBuf) -> &mut [u8] {
        self._data[0usize..self._length]
    }

    /// Reserve capacity for at least `additional` more bytes.
    fn reserve(self: &mut StringBuf, additional: usize) {
        let needed = self._length + additional;
        if needed > self._data.len() {
            self._grow(needed);
        }
    }

    /// Push a byte to the end of the string.
    fn push(self: &mut StringBuf, b: u8) {
        if self._length >= self._data.len() {
            self._grow(self._length + 1usize);
        }
        self._data[self._length] = b;
        self._length = self._length + 1usize;
    }

    /// Pop a byte from the end of the string.
    fn pop(self: &mut StringBuf) -> Option<u8> {
        if self._length == 0usize {
            return Option::none();
        }
        self._length = self._length - 1usize;
        Option::some(self._data[self._length])
    }

    /// Extend the string with the bytes from a slice.
    fn extend_from_slice(self: &mut StringBuf, s: &[u8]) {
        if s.len() == 0usize {
            return;
        }
        let needed = self._length + s.len();
        if needed > self._data.len() {
            self._grow(needed);
        }
        std::mem::memcpy(&self._data[self._length] as &mut void, &s[0] as &void, s.len());
        self._length = self._length + s.len();
    }

    /// Insert a byte at the given index, shifting all bytes after it.
    fn insert(self: &mut StringBuf, index: usize, value: u8) {
        if self._length >= self._data.len() {
            self._grow(self._length + 1usize);
        }
        if index < self._length {
            libc::memmove(
                &self._data[index + 1usize] as &mut void,
                &self._data[index] as &void,
                self._length - index
            );
        }
        self._data[index] = value;
        self._length = self._length + 1usize;
    }

    /// Set the string length. Can shrink or extend up to capacity.
    fn truncate(self: &mut StringBuf, len: usize) {
        if len <= self._data.len() {
            self._length = len;
        }
    }

    /// Return a mutable slice of the spare capacity (between len and capacity).
    fn spare_capacity(self: &mut StringBuf) -> &mut [u8] {
        self._data[self._length..]
    }

    /// Clear the string, removing all bytes.
    fn clear(self: &mut StringBuf) {
        self._length = 0usize;
    }

    /// Move the string's contents, leaving `self` empty.
    fn move(self: &mut StringBuf) -> StringBuf {
        let ret = *self;
        self._data = std::mem::slice_empty::<u8>();
        self._length = 0usize;
        ret
    }

    /// Clone the string, copying all bytes.
    fn clone(self: &StringBuf) -> StringBuf {
        StringBuf::from_slice(self._data[0usize..self._length])
    }

    /// Write a string slice to this buffer (for use as a fmt::Formatter sink).
    fn write_str(self: &mut StringBuf, buf: &[u8]) -> Result<(), std::fmt::Error> {
        self.extend_from_slice(buf);
        Result::ok(())
    }

    /// Write a byte to this buffer (for use as a fmt::Formatter sink).
    fn write_byte(self: &mut StringBuf, c: u8) -> Result<(), std::fmt::Error> {
        self.push(c);
        Result::ok(())
    }

    /// Format this string buffer.
    fn fmt<F: std::fmt::Formatter<F>>(self: &StringBuf, f: &mut F) -> std::fmt::Result {
        f.write_str(self._data[0usize..self._length])
    }

    fn _grow(self: &mut StringBuf, min_cap: usize) {
        let old_cap = self._data.len();
        let new_cap = old_cap * 2usize;
        if new_cap < min_cap {
            new_cap = min_cap;
        }
        if new_cap < 8usize {
            new_cap = 8usize;
        }
        let new_data = std::mem::slice_alloc::<u8>(new_cap);
        if self._length > 0usize {
            std::mem::memcpy(&new_data[0] as &mut void, &self._data[0] as &void, self._length);
        }
        if old_cap > 0usize {
            std::mem::slice_free::<u8>(self._data);
        }
        self._data = new_data;
    }

    /// Free the string's underlying buffer.
    fn free(self: &mut StringBuf) {
        if self._data.len() > 0usize {
            std::mem::slice_free::<u8>(self._data);
        }
        self._data = std::mem::slice_empty::<u8>();
        self._length = 0usize;
    }

    /// Shrink the underlying buffer to the length of the string.
    fn shrink_to_fit(self: &mut StringBuf) {
        if self._data.len() > self._length {
            if self._length == 0usize {
                if self._data.len() > 0usize {
                    std::mem::slice_free::<u8>(self._data);
                }
                self._data = std::mem::slice_empty::<u8>();
            } else {
                let new_data = std::mem::slice_alloc::<u8>(self._length);
                std::mem::memcpy(&new_data[0] as &mut void, &self._data[0] as &void, self._length);
                std::mem::slice_free::<u8>(self._data);
                self._data = new_data;
            }
        }
    }

    /// Compare two string buffers for equality.
    fn equals(self: &StringBuf, other: &StringBuf) -> bool {
        self._data[0usize..self._length] == other._data[0usize..other._length]
    }

    /// Compare two string buffers lexicographically.
    fn compare(self: &StringBuf, other: &StringBuf) -> std::cmp::Ordering {
        let min_len = self._length;
        if other._length < min_len {
            min_len = other._length;
        }
        if min_len > 0usize {
            let c = libc::memcmp(
                &self._data[0] as &void,
                &other._data[0] as &void,
                min_len,
            );
            if c < 0i32 {
                return std::cmp::Ordering::Less;
            }
            if c > 0i32 {
                return std::cmp::Ordering::Greater;
            }
        }
        if self._length < other._length {
            std::cmp::Ordering::Less
        } else if self._length > other._length {
            std::cmp::Ordering::Greater
        } else {
            std::cmp::Ordering::Equal
        }
    }

    /// Hash the string buffer's contents.
    fn hash<H: std::hash::Hasher<H>>(self: &StringBuf, hasher: &mut H) {
        if self._length > 0usize {
            hasher.write(self._data[0usize..self._length]);
        }
    }

    mixin std::cmp::Equatable<StringBuf>;
    mixin std::cmp::Comparable<StringBuf>;
}

// === String utility functions (on &[u8] slices) ===

/// Returns `true` if character is ASCII whitespace.
fn is_whitespace(c: u8) -> bool {
    c == 0x20u8 || c == 0x85u8 || c == 0xa0u8 || (c >= 0x09u8 && c <= 0x0Du8)
}

/// Returns `true` if character is a decimal digit.
fn is_digit(c: u8) -> bool {
    c >= '0' && c <= '9'
}

/// Convert character to lower case.
fn to_lower(c: u8) -> u8 {
    if c >= 'A' && c <= 'Z' {
        c + 0x20u8
    } else {
        c
    }
}

/// Convert character to upper case.
fn to_upper(c: u8) -> u8 {
    if c >= 'a' && c <= 'z' {
        c - 0x20u8
    } else {
        c
    }
}

/// Returns `true` if string starts with the given prefix.
fn starts_with(s: &[u8], prefix: &[u8]) -> bool {
    if s.len() < prefix.len() {
        return false;
    }
    s[0usize..prefix.len()] == prefix
}

/// Returns `true` if string ends with the given suffix.
fn ends_with(s: &[u8], suffix: &[u8]) -> bool {
    if s.len() < suffix.len() {
        return false;
    }
    s[s.len() - suffix.len()..] == suffix
}

/// Return string without the given prefix.
fn trim_prefix(s: &[u8], prefix: &[u8]) -> &[u8] {
    if starts_with(s, prefix) {
        s[prefix.len()..]
    } else {
        s
    }
}

/// Return string without the given suffix.
fn trim_suffix(s: &[u8], suffix: &[u8]) -> &[u8] {
    if ends_with(s, suffix) {
        s[0usize..s.len() - suffix.len()]
    } else {
        s
    }
}

/// Find the first occurrence of `needle` in `haystack`.
fn find(haystack: &[u8], needle: &[u8]) -> Option<usize> {
    if needle.len() == 0usize {
        return Option::some(0usize);
    }
    if haystack.len() == 0usize {
        return Option::none();
    }

    let ret = libc::memmem(
        &haystack[0] as &void,
        haystack.len(),
        &needle[0] as &void,
        needle.len()
    );

    if ret as usize == 0usize {
        Option::none()
    } else {
        Option::some((ret as usize) - (&haystack[0] as usize))
    }
}

/// Find the first occurrence of a byte in a string.
fn find_char(s: &[u8], needle: u8) -> Option<usize> {
    if s.len() == 0usize {
        return Option::none();
    }

    let p = libc::memchr(
        &s[0] as &void,
        needle as libc::c_int,
        s.len(),
    );

    if p as usize == 0usize {
        Option::none()
    } else {
        Option::some((p as usize) - (&s[0] as usize))
    }
}

/// Returns `true` if `needle` is a substring of `haystack`.
fn contains(haystack: &[u8], needle: &[u8]) -> bool {
    find(haystack, needle).is_some()
}

/// Trim ASCII whitespace from the start of the string.
fn trim_start(s: &[u8]) -> &[u8] {
    let i = 0usize;
    while i < s.len() && is_whitespace(s[i]) {
        i = i + 1usize;
    }
    s[i..]
}

/// Trim ASCII whitespace from the end of the string.
fn trim_end(s: &[u8]) -> &[u8] {
    let i = s.len();
    while i > 0usize && is_whitespace(s[i - 1usize]) {
        i = i - 1usize;
    }
    s[0usize..i]
}

/// Trim ASCII whitespace from both ends of the string.
fn trim(s: &[u8]) -> &[u8] {
    trim_end(trim_start(s))
}

/// Iterator over parts of a string split by a delimiter.
struct SplitIterator {
    _data: &[u8],
    _sep: &[u8],
    _done: bool,
}

impl SplitIterator {
    fn next(self: &mut SplitIterator) -> Option<&[u8]> {
        if self._done {
            return Option::none();
        }

        let pos = find(self._data, self._sep);
        if pos.is_none() {
            self._done = true;
            return Option::some(self._data);
        }

        let p = pos.unwrap();
        let ret = self._data[0usize..p];
        self._data = self._data[p + self._sep.len()..];

        Option::some(ret)
    }
    mixin std::iter::Iterator<SplitIterator, &[u8]>;

    /// Return self, enabling for-loop compatibility.
    fn iter(self: &mut SplitIterator) -> &mut SplitIterator {
        self
    }
}

/// Split a string by a delimiter, returning an iterator.
fn split(s: &[u8], sep: &[u8]) -> SplitIterator {
    SplitIterator {
        _data: s,
        _sep: sep,
        _done: false,
    }
}

/// Join a slice of strings with a separator.
fn join(parts: &[&[u8]], sep: &[u8]) -> StringBuf {
    let result = StringBuf::new();
    for i in 0usize..parts.len() {
        if i > 0usize {
            result.extend_from_slice(sep);
        }
        result.extend_from_slice(parts[i]);
    }
    result
}

/// Replace all occurrences of `from` with `to` in `s`.
fn replace(s: &[u8], from: &[u8], to: &[u8]) -> StringBuf {
    let ret = StringBuf::new();
    replace_fmt(s, from, to).fmt(&ret).unwrap();
    ret
}

/// Non-allocating formattable object that replaces all occurrences of `needle` with `replacement`.
struct ReplaceAdapter {
    _inner: &[u8],
    _needle: &[u8],
    _replacement: &[u8],
}

impl ReplaceAdapter {
    fn fmt<F: std::fmt::Formatter<F>>(self: &ReplaceAdapter, f: &mut F) -> std::fmt::Result {
        if self._needle.len() == 0usize {
            return f.write_str(self._inner);
        }
        let remaining = self._inner;
        loop {
            let pos = find(remaining, self._needle);
            if pos.is_none() {
                return f.write_str(remaining);
            }
            let p = pos.unwrap();
            let r = f.write_str(remaining[0usize..p]);
            if r.is_err() { return r; }
            let r = f.write_str(self._replacement);
            if r.is_err() { return r; }
            remaining = remaining[p + self._needle.len()..];
        }
    }
}

/// Returns an object that formats to the string with all `needle` occurrences replaced with
/// `replacement`.
fn replace_fmt(s: &[u8], needle: &[u8], replacement: &[u8]) -> ReplaceAdapter {
    ReplaceAdapter { _inner: s, _needle: needle, _replacement: replacement }
}

// === Integer parsing functions ===

/// Lookup table for character-to-digit conversion (supports up to base 36).
const _RADIX_LOOKUP: [u8; 256] = [
    0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0x00u8, 0x01u8, 0x02u8, 0x03u8, 0x04u8, 0x05u8, 0x06u8, 0x07u8, 0x08u8, 0x09u8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0xFFu8, 0x0Au8, 0x0Bu8, 0x0Cu8, 0x0Du8, 0x0Eu8, 0x0Fu8, 0x10u8, 0x11u8, 0x12u8, 0x13u8, 0x14u8, 0x15u8, 0x16u8, 0x17u8, 0x18u8,
    0x19u8, 0x1Au8, 0x1Bu8, 0x1Cu8, 0x1Du8, 0x1Eu8, 0x1Fu8, 0x20u8, 0x21u8, 0x22u8, 0x23u8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0xFFu8, 0x0Au8, 0x0Bu8, 0x0Cu8, 0x0Du8, 0x0Eu8, 0x0Fu8, 0x10u8, 0x11u8, 0x12u8, 0x13u8, 0x14u8, 0x15u8, 0x16u8, 0x17u8, 0x18u8,
    0x19u8, 0x1Au8, 0x1Bu8, 0x1Cu8, 0x1Du8, 0x1Eu8, 0x1Fu8, 0x20u8, 0x21u8, 0x22u8, 0x23u8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
    0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8, 0xFFu8,
];

/// Parse an i64 from a string in the given base.
fn parse_i64(s: &[u8], radix: u32) -> Option<i64> {
    if s.len() == 0usize { return Option::none(); }

    let negative = false;
    let start = 0usize;
    if s[0] == '-' as u8 {
        negative = true;
        start = 1usize;
    } else if s[0] == '+' as u8 {
        start = 1usize;
    }

    if start >= s.len() { return Option::none(); }

    let result: u64 = 0u64;
    let radix64 = radix as u64;
    let i = start;
    while i < s.len() {
        let digit = _RADIX_LOOKUP[s[i] as usize];
        if digit >= radix as u8 {
            return Option::none();
        }
        // Check for overflow
        let prev = result;
        result = result * radix64 + digit as u64;
        if result / radix64 != prev {
            return Option::none(); // overflow
        }
        i = i + 1usize;
    }

    if negative {
        Option::some(-(result as i64))
    } else {
        Option::some(result as i64)
    }
}

/// Parse an i32 from a string in the given base.
fn parse_i32(s: &[u8], radix: u32) -> Option<i32> {
    let r = parse_i64(s, radix);
    if r.is_none() { return Option::none(); }
    let v = r.unwrap();
    if v < -2147483648i64 || v > 2147483647i64 { return Option::none(); }
    Option::some(v as i32)
}

/// Parse a usize from a string in the given base.
fn parse_usize(s: &[u8], radix: u32) -> Option<usize> {
    if s.len() == 0usize { return Option::none(); }

    let result: u64 = 0u64;
    let radix64 = radix as u64;
    let i = 0usize;
    while i < s.len() {
        let digit = _RADIX_LOOKUP[s[i] as usize];
        if digit >= radix as u8 {
            return Option::none();
        }
        let prev = result;
        result = result * radix64 + digit as u64;
        if result / radix64 != prev {
            return Option::none();
        }
        i = i + 1usize;
    }
    Option::some(result as usize)
}

/// Generic integer parser supporting all integer types and radix 2-36.
///
/// Handles signed/unsigned dispatch at compile time using `when` expressions.
/// Overflow is detected using checked arithmetic.
fn parse_integer<T: std::builtins::Integer>(s: &[u8], radix: u16) -> Option<T> {
    if s.len() == 0usize { return Option::none(); }

    let input = s;
    let negative = when std::typing::is_signed::<T>() {
        if input[0] == '-' as u8 {
            input = input[1usize..];
            true
        } else {
            false
        }
    } else {
        false
    };

    if input.len() == 0usize { return Option::none(); }

    let result: std::builtins::unsigned_of<T> = 0;
    let radix_val = radix as std::builtins::unsigned_of<T>;
    let i = 0usize;
    while i < input.len() {
        let digit = _RADIX_LOOKUP[input[i] as usize];
        if digit as u16 >= radix {
            return Option::none();
        }
        let mul = result.checked_mul(radix_val);
        if mul.is_none() { return Option::none(); }
        let add = mul.unwrap().checked_add(digit as std::builtins::unsigned_of<T>);
        if add.is_none() { return Option::none(); }
        result = add.unwrap();
        i = i + 1usize;
    }

    when std::typing::is_signed::<T>() {
        // For signed types, compute max positive value as unsigned:
        // max_value of signed T is (2^(bits-1) - 1), so as unsigned_of<T>
        // we can get it by casting max signed value.
        // But we can't call T::max_value() on generic T.
        // Instead: shift right by 1 from all-ones unsigned = max signed as unsigned.
        let all_ones: std::builtins::unsigned_of<T> = 0;
        all_ones = ~all_ones; // all bits set
        let max_positive = all_ones >> 1; // max signed value as unsigned
        if negative {
            if result > max_positive + 1 {
                Option::none()
            } else {
                Option::some(-(result as T))
            }
        } else {
            if result > max_positive {
                Option::none()
            } else {
                Option::some(result as T)
            }
        }
    } else {
        Option::some(result)
    }
}

/// Parse a floating-point number from a string.
///
/// Uses libc's strtod for parsing. Returns None for invalid input.
fn parse_float(s: &[u8]) -> Option<f64> {
    if s.len() == 0usize { return Option::none(); }

    // Reject leading whitespace (strtod accepts it but we don't want that)
    if s[0] == ' ' as u8 || s[0] == '\t' as u8 || s[0] == '\n' as u8 || s[0] == '\r' as u8 {
        return Option::none();
    }

    // Special cases
    if s == "inf" || s == "Inf" || s == "INF" {
        return Option::some(1.0f64 / 0.0f64);
    }
    if s == "-inf" || s == "-Inf" || s == "-INF" {
        return Option::some(-1.0f64 / 0.0f64);
    }
    if s == "nan" || s == "NaN" || s == "NAN" {
        return Option::some(0.0f64 / 0.0f64);
    }

    // Copy to null-terminated buffer for strtod
    let buf: [u8; 128];
    if s.len() >= 127usize { return Option::none(); }
    s.copy_to_nonoverlapping(&buf[0]);
    buf[s.len()] = 0u8;

    let endptr: &mut libc::c_char = null;
    let result = libc::strtod(&buf[0] as &libc::c_char, &endptr);

    // Check that the entire string was consumed
    let consumed = (endptr as usize) - (&buf[0] as &libc::c_char as usize);
    if consumed != s.len() {
        return Option::none();
    }

    Option::some(result)
}
