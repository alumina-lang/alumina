extern "C" fn LLVMBuildInBoundsGEP2(b: LLVMBuilderRef, ty: LLVMTypeRef, ptr: LLVMValueRef, indices: &LLVMValueRef, num_indices: u32, name: &c_char) -> LLVMValueRef;
extern "C" fn LLVMBuildStructGEP2(b: LLVMBuilderRef, ty: LLVMTypeRef, ptr: LLVMValueRef, idx: u32, name: &c_char) -> LLVMValueRef;
