// --- Debug Info ---
struct LLVMOpaqueDIBuilder {}
struct LLVMOpaqueMetadata {}
type LLVMDIBuilderRef = &mut LLVMOpaqueDIBuilder;
type LLVMMetadataRef = &mut LLVMOpaqueMetadata;

enum LLVMDWARFEmissionKind {
    None = 0i32,
    Full = 1i32,
    LineTablesOnly = 2i32,
}

extern "C" fn LLVMCreateDIBuilder(m: LLVMModuleRef) -> LLVMDIBuilderRef;
extern "C" fn LLVMDisposeDIBuilder(builder: LLVMDIBuilderRef);
extern "C" fn LLVMDIBuilderFinalize(builder: LLVMDIBuilderRef);

extern "C" fn LLVMDIBuilderCreateCompileUnit(
    builder: LLVMDIBuilderRef,
    lang: u32,               // LLVMDWARFSourceLanguage (DW_LANG_C = 0x0002)
    file_ref: LLVMMetadataRef,
    producer: &c_char,
    producer_len: usize,
    is_optimized: LLVMBool,
    flags: &c_char,
    flags_len: usize,
    runtime_ver: u32,
    split_name: &c_char,
    split_name_len: usize,
    kind: LLVMDWARFEmissionKind,
    dwo_id: u32,
    split_debug_inlining: LLVMBool,
    debug_info_for_profiling: LLVMBool,
    sys_root: &c_char,
    sys_root_len: usize,
    sdk: &c_char,
    sdk_len: usize,
) -> LLVMMetadataRef;

extern "C" fn LLVMDIBuilderCreateFile(
    builder: LLVMDIBuilderRef,
    filename: &c_char,
    filename_len: usize,
    directory: &c_char,
    directory_len: usize,
) -> LLVMMetadataRef;

extern "C" fn LLVMDIBuilderCreateFunction(
    builder: LLVMDIBuilderRef,
    scope: LLVMMetadataRef,
    name: &c_char,
    name_len: usize,
    linkage_name: &c_char,
    linkage_name_len: usize,
    file: LLVMMetadataRef,
    line_no: u32,
    ty: LLVMMetadataRef,
    is_local_to_unit: LLVMBool,
    is_definition: LLVMBool,
    scope_line: u32,
    flags: u32,             // DIFlags
    is_optimized: LLVMBool,
) -> LLVMMetadataRef;

extern "C" fn LLVMDIBuilderCreateSubroutineType(
    builder: LLVMDIBuilderRef,
    file: LLVMMetadataRef,
    param_types: &LLVMMetadataRef,
    num_param_types: u32,
    flags: u32,
) -> LLVMMetadataRef;

extern "C" fn LLVMDIBuilderCreateDebugLocation(
    ctx: LLVMContextRef,
    line: u32,
    column: u32,
    scope: LLVMMetadataRef,
    inlined_at: LLVMMetadataRef,
) -> LLVMMetadataRef;

extern "C" fn LLVMSetSubprogram(func: LLVMValueRef, sp: LLVMMetadataRef);
extern "C" fn LLVMSetCurrentDebugLocation2(builder: LLVMBuilderRef, loc: LLVMMetadataRef);

extern "C" fn LLVMDIBuilderCreateBasicType(
    builder: LLVMDIBuilderRef,
