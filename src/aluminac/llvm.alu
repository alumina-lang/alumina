extern "C" fn LLVMBuildMemCpy(b: LLVMBuilderRef, dst: LLVMValueRef, dst_align: u32, src: LLVMValueRef, src_align: u32, size: LLVMValueRef) -> LLVMValueRef;

// --- Builder: Casts ---
extern "C" fn LLVMBuildTrunc(b: LLVMBuilderRef, val: LLVMValueRef, ty: LLVMTypeRef, name: &c_char) -> LLVMValueRef;
extern "C" fn LLVMBuildZExt(b: LLVMBuilderRef, val: LLVMValueRef, ty: LLVMTypeRef, name: &c_char) -> LLVMValueRef;
