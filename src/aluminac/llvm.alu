extern "C" fn LLVMBuildAlloca(b: LLVMBuilderRef, ty: LLVMTypeRef, name: &c_char) -> LLVMValueRef;
extern "C" fn LLVMBuildArrayAlloca(b: LLVMBuilderRef, ty: LLVMTypeRef, count: LLVMValueRef, name: &c_char) -> LLVMValueRef;
