// AST and IR data structures for the self-hosted Alumina compiler
//
// Since Alumina enums don't support data payloads (like Rust enums),
// we use a tag + data pointer pattern for discriminated unions.
// The tag is an integer constant, data is a &void pointer cast as needed.

use aluminac_common::arena::Arena;
use std::collections::{HashMap, HashSet};

// Unique identifier for AST/IR items
struct Id {
    _value: usize,
}

impl Id {
    fn equals(self: &Id, other: &Id) -> bool {
        self._value == other._value
    }
    fn hash(self: &Id) -> u64 {
        self._value as u64
    }
}

struct IdGen {
    next: usize,
}

impl IdGen {
    fn new() -> IdGen {
        IdGen { next: 0 }
    }
    fn next_id(self: &mut IdGen) -> Id {
        let id = Id { _value: self.next };
        self.next = self.next + 1;
        id
    }
}

// === Builtin types ===
enum BuiltinType {
    Void = 0i32,
    Bool = 1i32,
    U8 = 2i32,
    U16 = 3i32,
    U32 = 4i32,
    U64 = 5i32,
    U128 = 6i32,
    USize = 7i32,
    I8 = 8i32,
    I16 = 9i32,
    I32 = 10i32,
    I64 = 11i32,
    I128 = 12i32,
    ISize = 13i32,
    F32 = 14i32,
    F64 = 15i32,
    Never = 16i32,
}

impl BuiltinType {
    fn is_integer(self: &BuiltinType) -> bool {
        let v = *self as i32;
        (v >= 2i32 && v <= 13i32) // U8..ISize
    }

    fn is_signed(self: &BuiltinType) -> bool {
        let v = *self as i32;
        (v >= 8i32 && v <= 13i32) // I8..ISize
    }

    fn is_float(self: &BuiltinType) -> bool {
        let v = *self as i32;
        v == 14i32 || v == 15i32 // F32, F64
    }

    fn is_numeric(self: &BuiltinType) -> bool {
        self.is_integer() || self.is_float()
    }

    fn bit_width(self: &BuiltinType) -> u32 {
        switch *self {
            BuiltinType::Bool => 1,
            BuiltinType::U8 => 8,
            BuiltinType::I8 => 8,
            BuiltinType::U16 => 16,
            BuiltinType::I16 => 16,
            BuiltinType::U32 => 32,
            BuiltinType::I32 => 32,
            BuiltinType::F32 => 32,
            BuiltinType::U64 => 64,
            BuiltinType::I64 => 64,
            BuiltinType::F64 => 64,
            BuiltinType::U128 => 128,
            BuiltinType::I128 => 128,
            BuiltinType::USize => 64,
            BuiltinType::ISize => 64,
            _ => 0,
        }
    }
}

fn parse_builtin_type(name: &[u8]) -> Option<BuiltinType> {
    use std::option::Option;
    if name == "void" { Option::some(BuiltinType::Void) }
    else if name == "bool" { Option::some(BuiltinType::Bool) }
    else if name == "u8" { Option::some(BuiltinType::U8) }
    else if name == "u16" { Option::some(BuiltinType::U16) }
    else if name == "u32" { Option::some(BuiltinType::U32) }
    else if name == "u64" { Option::some(BuiltinType::U64) }
    else if name == "u128" { Option::some(BuiltinType::U128) }
    else if name == "usize" { Option::some(BuiltinType::USize) }
    else if name == "i8" { Option::some(BuiltinType::I8) }
    else if name == "i16" { Option::some(BuiltinType::I16) }
    else if name == "i32" { Option::some(BuiltinType::I32) }
    else if name == "i64" { Option::some(BuiltinType::I64) }
    else if name == "i128" { Option::some(BuiltinType::I128) }
    else if name == "isize" { Option::some(BuiltinType::ISize) }
    else if name == "f32" { Option::some(BuiltinType::F32) }
    else if name == "f64" { Option::some(BuiltinType::F64) }
    else { Option::none() }
}

// === AST-level types ===
// Discriminated union using tag + struct

// Ty tags
enum TyTag {
    Placeholder = 0i32,
    Named = 1i32,
    Builtin = 2i32,
    Pointer = 3i32,
    Slice = 4i32,
    Array = 5i32,
    Tuple = 6i32,
    FnPointer = 7i32,
    Generic = 8i32,
    Typeof = 9i32,
    Never = 10i32,
    Unresolved = 11i32,
    When = 12i32,
}

struct Ty {
    tag: TyTag,
    // Data fields reused depending on tag:
    builtin: BuiltinType,      // TyTag::Builtin
    id: Id,                     // TyTag::Placeholder, TyTag::Named
    inner: &Ty,                 // TyTag::Pointer, TyTag::Slice, TyTag::Array, TyTag::Generic base
    is_const: bool,             // TyTag::Pointer, TyTag::Slice
    array_size: usize,          // TyTag::Array
    elems: &[&Ty],              // TyTag::Tuple, TyTag::FnPointer params, TyTag::Generic args
    ret_ty: &Ty,                // TyTag::FnPointer return type
    typeof_expr: &Expr,         // TyTag::Typeof
}

impl Ty {
    /// Returns a zeroed Ty with empty slices. Callers set tag + relevant fields.
    fn default() -> Ty {
        let ty: Ty = std::mem::zeroed::<Ty>();
        ty.elems = &[];
        ty
    }

    fn placeholder(id: Id) -> Ty {
        let ty = Ty::default(); ty.tag = TyTag::Placeholder; ty.id = id; ty
    }
    fn named(id: Id) -> Ty {
        let ty = Ty::default(); ty.tag = TyTag::Named; ty.id = id; ty
    }
    fn builtin_ty(bt: BuiltinType) -> Ty {
        let ty = Ty::default(); ty.tag = TyTag::Builtin; ty.builtin = bt; ty
    }
    fn pointer_ty(pointee: &Ty, is_const: bool) -> Ty {
        let ty = Ty::default(); ty.tag = TyTag::Pointer; ty.inner = pointee; ty.is_const = is_const; ty
    }
    fn slice_ty(elem: &Ty, is_const: bool) -> Ty {
        let ty = Ty::default(); ty.tag = TyTag::Slice; ty.inner = elem; ty.is_const = is_const; ty
    }
    fn array_ty(elem: &Ty, size: usize) -> Ty {
        let ty = Ty::default(); ty.tag = TyTag::Array; ty.inner = elem; ty.array_size = size; ty
    }
    fn tuple_ty(elems: &[&Ty]) -> Ty {
        let ty = Ty::default(); ty.tag = TyTag::Tuple; ty.elems = elems; ty
    }
    fn fn_pointer_ty(params: &[&Ty], ret: &Ty) -> Ty {
        let ty = Ty::default(); ty.tag = TyTag::FnPointer; ty.elems = params; ty.ret_ty = ret; ty
    }
    fn generic_ty(base: &Ty, args: &[&Ty]) -> Ty {
        let ty = Ty::default(); ty.tag = TyTag::Generic; ty.inner = base; ty.elems = args; ty
    }
    fn never_ty() -> Ty {
        let ty = Ty::default(); ty.tag = TyTag::Never; ty.builtin = BuiltinType::Never; ty
    }
    // TyTag::When: condition in typeof_expr, consequence in inner, alternative in ret_ty
    fn when_ty(condition: &Expr, consequence: &Ty, alternative: &Ty) -> Ty {
        let ty = Ty::default(); ty.tag = TyTag::When; ty.inner = consequence; ty.ret_ty = alternative; ty.typeof_expr = condition; ty
    }
    fn unresolved() -> Ty {
        let ty = Ty::default(); ty.tag = TyTag::Unresolved; ty
    }
    fn void_ty() -> Ty {
        Ty::builtin_ty(BuiltinType::Void)
    }
}

// Reference to an item (function, struct, enum, etc.)
struct ItemRef {
    id: Id,
}

// === AST Expressions ===

enum BinOp {
    Add = 0i32,
    Sub = 1i32,
    Mul = 2i32,
    Div = 3i32,
    Rem = 4i32,
    BitAnd = 5i32,
    BitOr = 6i32,
    BitXor = 7i32,
    Shl = 8i32,
    Shr = 9i32,
    Eq = 10i32,
    Ne = 11i32,
    Lt = 12i32,
    Le = 13i32,
    Gt = 14i32,
    Ge = 15i32,
    And = 16i32,
    Or = 17i32,
}

enum UnOp {
    Neg = 0i32,
    Not = 1i32,
    BitNot = 2i32,
}

enum AssignOp {
    Assign = 0i32,
    AddAssign = 1i32,
    SubAssign = 2i32,
    MulAssign = 3i32,
    DivAssign = 4i32,
    RemAssign = 5i32,
    BitAndAssign = 6i32,
    BitOrAssign = 7i32,
    BitXorAssign = 8i32,
    ShlAssign = 9i32,
    ShrAssign = 10i32,
}

struct FieldInit {
    name: &[u8],
    value: &Expr,
}

struct SwitchArm {
    pattern: &[&Expr],
    body: &Expr,
}

// Expression tags
enum ExprTag {
    IntLit = 0i32,
    FloatLit = 1i32,
    BoolLit = 2i32,
    StringLit = 3i32,
    CharLit = 4i32,
    NullLit = 5i32,
    Local = 6i32,
    Param = 7i32,
    StaticRef = 8i32,
    FnRef = 9i32,
    EnumRef = 10i32,
    Block = 11i32,
    Binary = 12i32,
    Unary = 13i32,
    Assign = 14i32,
    Call = 15i32,
    MethodCall = 16i32,
    FieldAccess = 17i32,
    TupleIndex = 18i32,
    Index = 19i32,
    Ref = 20i32,
    Deref = 21i32,
    Cast = 22i32,
    TypeCheck = 23i32,
    If = 24i32,
    When = 25i32,
    Switch = 26i32,
    While = 27i32,
    For = 28i32,
    Loop = 29i32,
    Break = 30i32,
    Continue = 31i32,
    Return = 32i32,
    Let = 33i32,
    StructLit = 34i32,
    TupleLit = 35i32,
    ArrayLit = 36i32,
    Lambda = 37i32,
    Defer = 38i32,
    Try = 39i32,
    Range = 40i32,
    Void = 41i32,
    Zeroed = 42i32,
    StaticFor = 43i32,
    EtCetera = 44i32,
    MacroInvocation = 45i32,
    BoundValue = 46i32,     // Access a captured variable in a closure body
    MacroParam = 47i32,     // $param reference in pre-parsed macro body (int_val=index, flag=is_variadic)
}

// Expression struct - flat with multiple fields reused per tag
struct Expr {
    tag: ExprTag,
    span: Span,
    // Numeric data
    int_val: u64,
    float_val: f64,
    bool_val: bool,
    // String data
    str_val: &[u8],
    // Id data
    id: Id,
    id2: Id,  // secondary id (e.g. enum variant id)
    // Operator
    bin_op: BinOp,
    un_op: UnOp,
    assign_op: AssignOp,
    // Type data
    ty: &Ty,
    // Optional type suffix for literals
    type_suffix: Option<BuiltinType>,
    // Sub-expressions
    lhs: &Expr,
    rhs: &Expr,
    cond: &Expr,
    // Expression lists
    args: &[&Expr],
    // Field inits (struct lit)
    field_inits: &[FieldInit],
    // Switch arms
    switch_arms: &[SwitchArm],
    // Type args for method calls
    type_args: &[&Ty],
    // Bool flag (is_mut for Ref, inclusive for Range)
    flag: bool,
    // Optional expression (else branch, break value, etc)
    opt_expr: Option<&Expr>,
    // Optional type
    opt_ty: Option<&Ty>,
    // Tuple index
    index_val: usize,
    // Lambda params
    lambda_params: &[LambdaParam],
    // Closure bindings (captures)
    closure_bindings: &[ClosureBinding],
}

impl Expr {
    fn void_expr() -> Expr {
        Expr {
            tag: ExprTag::Void, span: Span::empty(),
            int_val: 0, float_val: 0.0, bool_val: false, str_val: "",
            id: Id { _value: 0 }, id2: Id { _value: 0 },
            bin_op: BinOp::Add, un_op: UnOp::Neg, assign_op: AssignOp::Assign,
            ty: std::mem::zeroed::<&Ty>(), type_suffix: Option::none(),
            lhs: std::mem::zeroed::<&Expr>(), rhs: std::mem::zeroed::<&Expr>(),
            cond: std::mem::zeroed::<&Expr>(),
            args: &[], field_inits: &[], switch_arms: &[], type_args: &[],
            flag: false, opt_expr: Option::none(), opt_ty: Option::none(),
            index_val: 0, lambda_params: &[], closure_bindings: &[],
        }
    }
}

// Bound type for closure captures
enum BoundType {
    ByValue = 0i32,
    ByReference = 1i32,
}

struct ClosureBinding {
    id: Id,          // New id for the binding inside the closure
    name: &[u8],     // Variable name
    value: &Expr,    // Original expression being captured (usually ExprTag::Local or ExprTag::Param)
    bound_type: BoundType,
}

struct LambdaParam {
    id: Id,
    name: &[u8],
    ty: Option<&Ty>,
}

struct Span {
    file_id: u32,
    start: u32,
    end: u32,
}

impl Span {
    fn empty() -> Span {
        Span { file_id: 0, start: 0, end: 0 }
    }
}

// === AST Items ===

struct FnParam {
    id: Id,
    name: &[u8],
    ty: &Ty,
}

struct GenericParam {
    id: Id,
    name: &[u8],
    bounds: &[&Ty],
    default_ty: Option<&Ty>,
}

// Attribute tags
enum AttrTag {
    Export = 0i32,
    Inline = 1i32,
    AlwaysInline = 2i32,
    Cold = 3i32,
    Align = 4i32,
    Extern = 5i32,
    Cfg = 6i32,
    NoReturn = 7i32,
    ThreadLocal = 8i32,
    Test = 9i32,
    Main = 10i32,
    StaticCtor = 11i32,
    Lang = 12i32,
    InlineIr = 13i32,
    Builtin = 14i32,
}

struct Attribute {
    tag: AttrTag,
    str_val: &[u8],     // for AttrTag::Extern, AttrTag::Cfg, AttrTag::Lang
    int_val: usize,     // for AttrTag::Align
}

impl Attribute {
    fn export() -> Attribute { Attribute { tag: AttrTag::Export, str_val: "", int_val: 0 } }
    fn inline_attr() -> Attribute { Attribute { tag: AttrTag::Inline, str_val: "", int_val: 0 } }
    fn always_inline() -> Attribute { Attribute { tag: AttrTag::AlwaysInline, str_val: "", int_val: 0 } }
    fn cold() -> Attribute { Attribute { tag: AttrTag::Cold, str_val: "", int_val: 0 } }
    fn align(n: usize) -> Attribute { Attribute { tag: AttrTag::Align, str_val: "", int_val: n } }
    fn extern_attr(abi: &[u8]) -> Attribute { Attribute { tag: AttrTag::Extern, str_val: abi, int_val: 0 } }
    fn cfg(val: &[u8]) -> Attribute { Attribute { tag: AttrTag::Cfg, str_val: val, int_val: 0 } }
    fn no_return() -> Attribute { Attribute { tag: AttrTag::NoReturn, str_val: "", int_val: 0 } }
    fn thread_local() -> Attribute { Attribute { tag: AttrTag::ThreadLocal, str_val: "", int_val: 0 } }
    fn test() -> Attribute { Attribute { tag: AttrTag::Test, str_val: "", int_val: 0 } }
    fn main_attr() -> Attribute { Attribute { tag: AttrTag::Main, str_val: "", int_val: 0 } }
    fn static_ctor() -> Attribute { Attribute { tag: AttrTag::StaticCtor, str_val: "", int_val: 0 } }
    fn lang(name: &[u8]) -> Attribute { Attribute { tag: AttrTag::Lang, str_val: name, int_val: 0 } }
    fn inline_ir() -> Attribute { Attribute { tag: AttrTag::InlineIr, str_val: "", int_val: 0 } }
    fn builtin() -> Attribute { Attribute { tag: AttrTag::Builtin, str_val: "", int_val: 0 } }
}

struct FnDef {
    id: Id,
    name: &[u8],
    generic_params: &[GenericParam],
    params: &[FnParam],
    return_type: &Ty,
    body: Option<&Expr>,
    attributes: &[Attribute],
    is_variadic: bool,
    abi: Option<&[u8]>,
}

struct StructField {
    id: Id,
    name: &[u8],
    ty: &Ty,
}

struct StructDef {
    id: Id,
    name: &[u8],
    generic_params: &[GenericParam],
    fields: &[StructField],
    attributes: &[Attribute],
    is_union: bool,
    scope_idx: u32,
}

struct EnumVariant {
    id: Id,
    name: &[u8],
    value: Option<&Expr>,
}

struct EnumDef {
    id: Id,
    name: &[u8],
    underlying_type: Option<&Ty>,
    variants: &[EnumVariant],
    attributes: &[Attribute],
    scope_idx: u32,
}

struct TypeAlias {
    id: Id,
    name: &[u8],
    generic_params: &[GenericParam],
    target: &Ty,
}

struct ProtocolDef {
    id: Id,
    name: &[u8],
    generic_params: &[GenericParam],
    methods: &[FnDef],
    mixins: &[&Ty],
    scope_idx: u32,
}

struct ImplDef {
    target_type: &Ty,
    methods: &[FnDef],
    generic_params: &[GenericParam],
}

struct StaticDef {
    id: Id,
    name: &[u8],
    ty: Option<&Ty>,
    init: Option<&Expr>,
    attributes: &[Attribute],
    is_const: bool,
}

struct MacroDef {
    id: Id,
    name: &[u8],
    params: &[&[u8]],
    is_variadic: bool,
}

struct UseDef {
    path: &[&[u8]],
    alias: Option<&[u8]>,
    is_wildcard: bool,
}

struct ModuleDef {
    name: &[u8],
    items: &[Item],
}

// Item tags
enum ItemTag {
    Function = 0i32,
    Struct = 1i32,
    Enum = 2i32,
    TypeAlias = 3i32,
    Protocol = 4i32,
    Impl = 5i32,
    Static = 6i32,
    Macro = 7i32,
    Use = 8i32,
    Module = 9i32,
}

struct Item {
    tag: ItemTag,
    span: Span,
    fn_def: FnDef,
    struct_def: StructDef,
    enum_def: EnumDef,
    type_alias: TypeAlias,
    protocol_def: ProtocolDef,
    impl_def: ImplDef,
    static_def: StaticDef,
    macro_def: MacroDef,
    use_def: UseDef,
    module_def: ModuleDef,
}

// === IR (Monomorphized) types ===

// IrTy tags
enum IrTyTag {
    Builtin = 0i32,
    Pointer = 1i32,
    Array = 2i32,
    Tuple = 3i32,
    FnPointer = 4i32,
    Struct = 5i32,
    Enum = 6i32,
    Void = 7i32,
    Never = 8i32,
    Slice = 9i32,       // fat pointer: (data_ptr, len) - tracks element type
    Closure = 10i32,    // closure: struct of captures + associated function
}

// Slice struct field indices (fat pointer layout: {data_ptr, len})
const SLICE_DATA_FIELD: u32 = 0u32;
const SLICE_LEN_FIELD: u32 = 1u32;

struct IrTy {
    tag: IrTyTag,
    builtin: BuiltinType,
    inner: &IrTy,              // pointer pointee, array elem
    is_const: bool,             // pointer
    array_size: usize,          // array
    elems: &[&IrTy],           // tuple, fn pointer params
    ret_ty: &IrTy,             // fn pointer return
    struct_ref: IrStructRef,    // struct, also used for closure data layout
    enum_ref: IrEnumRef,        // enum
    closure_fn: IrFnRef,        // closure: the associated function
}

impl IrTy {
    /// Returns a zeroed IrTy with empty slices and refs. Callers set tag + relevant fields.
    fn default() -> IrTy {
        let ty: IrTy = std::mem::zeroed::<IrTy>();
        ty.elems = &[];
        ty.struct_ref = IrStructRef::empty();
        ty.enum_ref = IrEnumRef::empty();
        ty.closure_fn = IrFnRef::empty();
        ty
    }

    fn mk_builtin(bt: BuiltinType) -> IrTy {
        let ty = IrTy::default(); ty.tag = IrTyTag::Builtin; ty.builtin = bt; ty
    }
    fn mk_pointer(pointee: &IrTy, is_const: bool) -> IrTy {
        let ty = IrTy::default(); ty.tag = IrTyTag::Pointer; ty.inner = pointee; ty.is_const = is_const; ty
    }
    fn mk_array(elem: &IrTy, size: usize) -> IrTy {
        let ty = IrTy::default(); ty.tag = IrTyTag::Array; ty.inner = elem; ty.array_size = size; ty
    }
    fn mk_tuple(elems: &[&IrTy]) -> IrTy {
        let ty = IrTy::default(); ty.tag = IrTyTag::Tuple; ty.elems = elems; ty
    }
    fn mk_fn_pointer(params: &[&IrTy], ret: &IrTy) -> IrTy {
        let ty = IrTy::default(); ty.tag = IrTyTag::FnPointer; ty.elems = params; ty.ret_ty = ret; ty
    }
    fn mk_struct(s: IrStructRef) -> IrTy {
        let ty = IrTy::default(); ty.tag = IrTyTag::Struct; ty.struct_ref = s; ty
    }
    fn mk_closure(s: IrStructRef, fn_ref: IrFnRef) -> IrTy {
        let ty = IrTy::default(); ty.tag = IrTyTag::Closure; ty.struct_ref = s; ty.closure_fn = fn_ref; ty
    }
    fn mk_enum(e: IrEnumRef) -> IrTy {
        let ty = IrTy::default(); ty.tag = IrTyTag::Enum; ty.enum_ref = e; ty
    }
    fn mk_void() -> IrTy {
        let ty = IrTy::default(); ty.tag = IrTyTag::Void; ty
    }
    fn mk_never() -> IrTy {
        let ty = IrTy::default(); ty.tag = IrTyTag::Never; ty.builtin = BuiltinType::Never; ty
    }
    fn mk_slice(elem: &IrTy, is_const: bool) -> IrTy {
        let ty = IrTy::default(); ty.tag = IrTyTag::Slice; ty.inner = elem; ty.is_const = is_const; ty
    }

    fn is_void(self: &IrTy) -> bool {
        self.tag == IrTyTag::Void || (self.tag == IrTyTag::Builtin && self.builtin as i32 == BuiltinType::Void as i32)
    }
    fn is_never(self: &IrTy) -> bool {
        self.tag == IrTyTag::Never || (self.tag == IrTyTag::Builtin && self.builtin as i32 == BuiltinType::Never as i32)
    }
    fn is_zero_sized(self: &IrTy) -> bool {
        if self.tag == IrTyTag::Void { return true; }
        if self.tag == IrTyTag::Builtin && self.builtin as i32 == BuiltinType::Void as i32 { return true; }
        if self.tag == IrTyTag::Tuple {
            for i in 0usize..self.elems.len() {
                if !self.elems[i].is_zero_sized() { return false; }
            }
            return true;
        }
        if self.tag == IrTyTag::Array {
            return self.array_size == 0 || self.inner.is_zero_sized();
        }
        if self.tag == IrTyTag::Struct {
            return self.struct_ref.is_zero_sized;
        }
        if self.tag == IrTyTag::Closure {
            return self.struct_ref.is_zero_sized;
        }
        false
    }
}

struct IrStructRef {
    id: Id,
    name: &[u8],
    fields: &[IrField],
    is_union: bool,
    is_zero_sized: bool,
    scope_idx: u32,  // scope index for method resolution (0 = no methods)
    type_args: &[&IrTy],  // type args used to instantiate this struct (for method dispatch)
}

impl IrStructRef {
    fn empty() -> IrStructRef {
        IrStructRef { id: Id { _value: 0 }, name: "", fields: &[],
                       is_union: false, is_zero_sized: true, scope_idx: 0, type_args: &[] }
    }
}

struct IrField {
    name: &[u8],
    ty: &IrTy,
}

struct IrEnumRef {
    id: Id,
    name: &[u8],
    underlying: &IrTy,
    variants: &[IrEnumVariant],
    scope_idx: u32,
}

impl IrEnumRef {
    fn empty() -> IrEnumRef {
        IrEnumRef { id: Id { _value: 0 }, name: "",
                     underlying: std::mem::zeroed::<&IrTy>(), variants: &[], scope_idx: 0 }
    }
}

struct IrEnumVariant {
    name: &[u8],
    value: u64,
}

// === IR Expressions ===

// IrExpr tags
enum IrTag {
    IntLit = 0i32,
    FloatLit = 1i32,
    BoolLit = 2i32,
    StringLit = 3i32,
    NullLit = 4i32,
    Local = 5i32,
    Param = 6i32,
    FnRef = 7i32,
    GlobalRef = 8i32,
    Block = 9i32,
    Binary = 10i32,
    Unary = 11i32,
    Assign = 12i32,
    Call = 13i32,
    FieldAccess = 14i32,
    Index = 15i32,
    Ref = 16i32,
    Deref = 17i32,
    Cast = 18i32,
    If = 19i32,
    Switch = 20i32,
    While = 21i32,
    Loop = 22i32,
    Break = 23i32,
    Continue = 24i32,
    Return = 25i32,
    Let = 26i32,
    StructLit = 27i32,
    TupleLit = 28i32,
    ArrayLit = 29i32,
    Defer = 30i32,
    Void = 31i32,
    Zeroed = 32i32,
    Memcpy = 33i32,
    Unreachable = 34i32,
    Undef = 35i32,
    SizeOf = 36i32,       // size_of intrinsic; ty field holds the type to measure
    AlignOf = 37i32,      // align_of intrinsic; ty field holds the type to measure
    CodegenFunc = 38i32,  // codegen_func intrinsic; str_val holds function name, items holds args
    Transmute = 39i32,    // transmute intrinsic; lhs holds the value, ty holds target type
    Trap = 40i32,
}

// Call target tags
enum CallKind {
    Direct = 0i32,
    Indirect = 1i32,
}

struct IrCallTarget {
    tag: CallKind,
    fn_ref: IrFnRef,       // for CallKind::Direct
    callee: &IrExpr,        // for CallKind::Indirect
}

struct IrSwitchArm {
    values: &[u64],
    body: &IrExpr,
    is_default: bool,
}

struct IrExpr {
    tag: IrTag,
    ty: &IrTy,
    // Numeric data
    int_val: u64,
    float_val: f64,
    bool_val: bool,
    str_val: &[u8],
    // Id
    id: Id,
    // Operator
    bin_op: BinOp,
    un_op: UnOp,
    // Sub-expressions
    lhs: &IrExpr,
    rhs: &IrExpr,
    cond: &IrExpr,
    // Expression array
    items: &[&IrExpr],
    // Call target
    call_target: IrCallTarget,
    // Field index
    field_idx: u32,
    // IR type for casts and lets
    ir_ty: &IrTy,
    // Optional expression
    opt_expr: Option<&IrExpr>,
    // Switch arms
    switch_arms: &[IrSwitchArm],
    // Param index
    param_idx: u32,
    // Fn/Global ref
    fn_ref: IrFnRef,
    global_ref: IrGlobalRef,
}

impl IrExpr {
    fn void_expr(void_ty: &IrTy) -> IrExpr {
        IrExpr {
            tag: IrTag::Void, ty: void_ty,
            int_val: 0, float_val: 0.0, bool_val: false, str_val: "",
            id: Id { _value: 0 },
            bin_op: BinOp::Add, un_op: UnOp::Neg,
            lhs: std::mem::zeroed::<&IrExpr>(), rhs: std::mem::zeroed::<&IrExpr>(),
            cond: std::mem::zeroed::<&IrExpr>(),
            items: &[], call_target: IrCallTarget { tag: CallKind::Direct, fn_ref: IrFnRef::empty(), callee: std::mem::zeroed::<&IrExpr>() },
            field_idx: 0, ir_ty: void_ty, opt_expr: Option::none(),
            switch_arms: &[], param_idx: 0,
            fn_ref: IrFnRef::empty(), global_ref: IrGlobalRef::empty(),
        }
    }
}

struct IrFnRef {
    id: Id,
    mangled_name: &[u8],
}

impl IrFnRef {
    fn empty() -> IrFnRef {
        IrFnRef { id: Id { _value: 0 }, mangled_name: "" }
    }
}

struct IrGlobalRef {
    id: Id,
    mangled_name: &[u8],
}

impl IrGlobalRef {
    fn empty() -> IrGlobalRef {
        IrGlobalRef { id: Id { _value: 0 }, mangled_name: "" }
    }
}

struct IrLocalDef {
    id: Id,
    ty: &IrTy,
    name: &[u8],
}

struct IrFunction {
    id: Id,
    name: &[u8],
    mangled_name: &[u8],
    params: &[IrParam],
    return_type: &IrTy,
    body: Option<&IrExpr>,
    local_defs: &[IrLocalDef],
    attributes: &[Attribute],
    is_variadic: bool,
    abi: Option<&[u8]>,
}

struct IrParam {
    id: Id,
    ty: &IrTy,
    name: &[u8],
}

struct IrGlobal {
    id: Id,
    name: &[u8],
    mangled_name: &[u8],
    ty: &IrTy,
    init: Option<&IrExpr>,
    is_const: bool,
    is_extern: bool,
    attributes: &[Attribute],
}

// === Const evaluation value types ===

// ConstValue tags
enum CValTag {
    Void = 0i32,
    Bool = 1i32,
    Int = 2i32,         // integer value (u64 storage, BuiltinType for width)
    Float = 3i32,       // float value (f64 storage, BuiltinType for width)
    Bytes = 4i32,       // string/byte slice data
    Tuple = 5i32,
    Array = 6i32,
    Struct = 7i32,
    FnPtr = 8i32,
    Pointer = 9i32,
    Lvalue = 10i32,
    Uninitialized = 11i32,
}

// ConstLValue tags
enum CLVTag {
    Variable = 0i32,
    Alloc = 1i32,
    Field = 2i32,
    Index = 3i32,
    TupleIndex = 4i32,
    ConstItem = 5i32,
}

struct ConstLValue {
    tag: CLVTag,
    id: Id,                  // for CLVTag::Variable, CLVTag::Alloc, CLVTag::ConstItem
    inner: &ConstLValue,     // for CLVTag::Field, CLVTag::Index, CLVTag::TupleIndex
    field_idx: u32,          // for CLVTag::Field
    index: usize,            // for CLVTag::Index, CLVTag::TupleIndex
}

struct ConstField {
    field_idx: u32,
    value: ConstValue,
}

struct ConstValue {
    tag: CValTag,
    builtin_type: BuiltinType,  // precise type for CValTag::Int, CValTag::Float
    int_val: u64,               // CValTag::Int (two's complement for signed), CValTag::Bool (0/1)
    float_val: f64,             // CValTag::Float
    bytes: &[u8],               // CValTag::Bytes
    bytes_offset: usize,        // CValTag::Bytes offset
    elems: &[ConstValue],       // CValTag::Tuple, CValTag::Array
    fields: &[ConstField],      // CValTag::Struct
    fn_ref: IrFnRef,            // CValTag::FnPtr
    lvalue: &ConstLValue,       // CValTag::Pointer, CValTag::Lvalue
    pointee_ty: &IrTy,          // CValTag::Pointer
}

impl ConstValue {
    fn make_void() -> ConstValue {
        ConstValue {
            tag: CValTag::Void, builtin_type: BuiltinType::Void,
            int_val: 0, float_val: 0.0, bytes: "", bytes_offset: 0,
            elems: &[], fields: &[],
            fn_ref: IrFnRef::empty(),
            lvalue: std::mem::zeroed::<&ConstLValue>(),
            pointee_ty: std::mem::zeroed::<&IrTy>(),
        }
    }

    fn make_bool(v: bool) -> ConstValue {
        let r = ConstValue::make_void();
        r.tag = CValTag::Bool;
        r.builtin_type = BuiltinType::Bool;
        r.int_val = if v { 1u64 } else { 0u64 };
        r
    }

    fn make_int(v: u64, bt: BuiltinType) -> ConstValue {
        let r = ConstValue::make_void();
        r.tag = CValTag::Int;
        r.builtin_type = bt;
        r.int_val = v;
        r
    }

    fn make_float(v: f64, bt: BuiltinType) -> ConstValue {
        let r = ConstValue::make_void();
        r.tag = CValTag::Float;
        r.builtin_type = bt;
        r.float_val = v;
        r
    }

    fn make_bytes(data: &[u8], offset: usize) -> ConstValue {
        let r = ConstValue::make_void();
        r.tag = CValTag::Bytes;
        r.bytes = data;
        r.bytes_offset = offset;
        r
    }

    fn make_tuple(elems: &[ConstValue]) -> ConstValue {
        let r = ConstValue::make_void();
        r.tag = CValTag::Tuple;
        r.elems = elems;
        r
    }

    fn make_array(elems: &[ConstValue]) -> ConstValue {
        let r = ConstValue::make_void();
        r.tag = CValTag::Array;
        r.elems = elems;
        r
    }

    fn make_struct(fields: &[ConstField]) -> ConstValue {
        let r = ConstValue::make_void();
        r.tag = CValTag::Struct;
        r.fields = fields;
        r
    }

    fn make_fn_ptr(fr: IrFnRef) -> ConstValue {
        let r = ConstValue::make_void();
        r.tag = CValTag::FnPtr;
        r.fn_ref = fr;
        r
    }

    fn make_pointer(lv: &ConstLValue, ty: &IrTy) -> ConstValue {
        let r = ConstValue::make_void();
        r.tag = CValTag::Pointer;
        r.lvalue = lv;
        r.pointee_ty = ty;
        r
    }

    fn make_lvalue(lv: &ConstLValue) -> ConstValue {
        let r = ConstValue::make_void();
        r.tag = CValTag::Lvalue;
        r.lvalue = lv;
        r
    }

    fn make_uninitialized() -> ConstValue {
        let r = ConstValue::make_void();
        r.tag = CValTag::Uninitialized;
        r
    }

    fn is_truthy(self: &ConstValue) -> bool {
        if self.tag == CValTag::Bool { return self.int_val != 0u64; }
        if self.tag == CValTag::Int { return self.int_val != 0u64; }
        false
    }

    /// Extract a u64 value (for enum variants, array sizes, etc.)
    fn as_u64(self: &ConstValue) -> Option<u64> {
        if self.tag == CValTag::Int || self.tag == CValTag::Bool {
            Option::some(self.int_val)
        } else {
            Option::none()
        }
    }

    /// Extract a bool value
    fn as_bool(self: &ConstValue) -> Option<bool> {
        if self.tag == CValTag::Bool {
            Option::some(self.int_val != 0u64)
        } else if self.tag == CValTag::Int {
            Option::some(self.int_val != 0u64)
        } else {
            Option::none()
        }
    }

    /// Extract a usize value
    fn as_usize(self: &ConstValue) -> Option<usize> {
        if self.tag == CValTag::Int || self.tag == CValTag::Bool {
            Option::some(self.int_val as usize)
        } else {
            Option::none()
        }
    }
}

// === Compilation unit ===

struct CompilationUnit {
    functions: &mut [IrFunction],
    globals: &mut [IrGlobal],
    structs: &mut [IrStructRef],
    enums: &mut [IrEnumRef],
}
