// The syntax tree the parser produces (see `ir` for what monomorphization
// makes of it).
//
// Since Alumina enums don't support data payloads (like Rust enums),
// we use a tag + data pointer pattern for discriminated unions.
// The tag is an integer constant, data is a &void pointer cast as needed.

use aluminac_common::arena::Arena;
use std::collections::{HashMap, HashSet};
use std::fmt::write;

// Unique identifier for AST/IR items
struct Id {
    _value: usize,
}

impl Id {
    fn equals(self: &Id, other: &Id) -> bool {
        self._value == other._value
    }
    fn hash(self: &Id) -> u64 {
        self._value as u64
    }
}

struct IdGen {
    next: usize,
}

impl IdGen {
    fn new() -> IdGen {
        IdGen { next: 0 }
    }
    fn next_id(self: &mut IdGen) -> Id {
        let id = Id { _value: self.next };
        self.next = self.next + 1;
        id
    }
}

// === Builtin types ===
enum BuiltinType {
    Void = 0i32,
    Bool = 1i32,
    U8 = 2i32,
    U16 = 3i32,
    U32 = 4i32,
    U64 = 5i32,
    U128 = 6i32,
    USize = 7i32,
    I8 = 8i32,
    I16 = 9i32,
    I32 = 10i32,
    I64 = 11i32,
    I128 = 12i32,
    ISize = 13i32,
    F32 = 14i32,
    F64 = 15i32,
    Never = 16i32,
}

/// The lang items (`#[lang(builtin_u8)]` etc.) of the builtin types' methods.
const BUILTIN_LANG_ITEMS: [(BuiltinType, &[u8]); 16] = [
    (BuiltinType::Bool, "builtin_bool"), (BuiltinType::U8, "builtin_u8"), (BuiltinType::U16, "builtin_u16"),
    (BuiltinType::U32, "builtin_u32"), (BuiltinType::U64, "builtin_u64"), (BuiltinType::U128, "builtin_u128"),
    (BuiltinType::USize, "builtin_usize"), (BuiltinType::I8, "builtin_i8"), (BuiltinType::I16, "builtin_i16"),
    (BuiltinType::I32, "builtin_i32"), (BuiltinType::I64, "builtin_i64"), (BuiltinType::I128, "builtin_i128"),
    (BuiltinType::ISize, "builtin_isize"), (BuiltinType::F32, "builtin_f32"), (BuiltinType::F64, "builtin_f64"),
    (BuiltinType::Never, "builtin_never"),
];

impl BuiltinType {
    /// The lang item of the type's methods ("" for `()`).
    fn lang_name(self: &BuiltinType) -> &[u8] {
        BUILTIN_LANG_ITEMS.as_slice().iter()
            .find(|=self, item: (BuiltinType, &[u8])| -> bool { item.0 == *self })
            .map(|item: (BuiltinType, &[u8])| -> &[u8] { item.1 })
            .unwrap_or("")
    }

    /// The type whose methods a lang item is for, if it is one of them.
    fn from_lang_name(name: &[u8]) -> Option<BuiltinType> {
        BUILTIN_LANG_ITEMS.as_slice().iter()
            .find(|=name, item: (BuiltinType, &[u8])| -> bool { item.1 == name })
            .map(|item: (BuiltinType, &[u8])| -> BuiltinType { item.0 })
    }

    /// The type's name in source code (`()` for void).
    fn name(self: &BuiltinType) -> &[u8] {
        switch *self {
            BuiltinType::Void => "()",
            BuiltinType::Never => "!",
            BuiltinType::Bool => "bool",
            BuiltinType::U8 => "u8",
            BuiltinType::U16 => "u16",
            BuiltinType::U32 => "u32",
            BuiltinType::U64 => "u64",
            BuiltinType::U128 => "u128",
            BuiltinType::I8 => "i8",
            BuiltinType::I16 => "i16",
            BuiltinType::I32 => "i32",
            BuiltinType::I64 => "i64",
            BuiltinType::I128 => "i128",
            BuiltinType::USize => "usize",
            BuiltinType::ISize => "isize",
            BuiltinType::F32 => "f32",
            BuiltinType::F64 => "f64",
            _ => "<unknown>",
        }
    }

    fn is_integer(self: &BuiltinType) -> bool {
        let v = *self as i32;
        (v >= 2i32 && v <= 13i32) // U8..ISize
    }

    fn is_signed(self: &BuiltinType) -> bool {
        let v = *self as i32;
        (v >= 8i32 && v <= 13i32) // I8..ISize
    }

    fn is_float(self: &BuiltinType) -> bool {
        let v = *self as i32;
        v == 14i32 || v == 15i32 // F32, F64
    }

    fn is_numeric(self: &BuiltinType) -> bool {
        self.is_integer() || self.is_float()
    }

    fn bit_width(self: &BuiltinType) -> u32 {
        switch *self {
            BuiltinType::Bool => 1,
            BuiltinType::U8 => 8,
            BuiltinType::I8 => 8,
            BuiltinType::U16 => 16,
            BuiltinType::I16 => 16,
            BuiltinType::U32 => 32,
            BuiltinType::I32 => 32,
            BuiltinType::F32 => 32,
            BuiltinType::U64 => 64,
            BuiltinType::I64 => 64,
            BuiltinType::F64 => 64,
            BuiltinType::U128 => 128,
            BuiltinType::I128 => 128,
            BuiltinType::USize => 64,
            BuiltinType::ISize => 64,
            _ => 0,
        }
    }
}

fn parse_builtin_type(name: &[u8]) -> Option<BuiltinType> {
    use std::option::Option;
    if name == "void" { Option::some(BuiltinType::Void) }
    else if name == "bool" { Option::some(BuiltinType::Bool) }
    else if name == "u8" { Option::some(BuiltinType::U8) }
    else if name == "u16" { Option::some(BuiltinType::U16) }
    else if name == "u32" { Option::some(BuiltinType::U32) }
    else if name == "u64" { Option::some(BuiltinType::U64) }
    else if name == "u128" { Option::some(BuiltinType::U128) }
    else if name == "usize" { Option::some(BuiltinType::USize) }
    else if name == "i8" { Option::some(BuiltinType::I8) }
    else if name == "i16" { Option::some(BuiltinType::I16) }
    else if name == "i32" { Option::some(BuiltinType::I32) }
    else if name == "i64" { Option::some(BuiltinType::I64) }
    else if name == "i128" { Option::some(BuiltinType::I128) }
    else if name == "isize" { Option::some(BuiltinType::ISize) }
    else if name == "f32" { Option::some(BuiltinType::F32) }
    else if name == "f64" { Option::some(BuiltinType::F64) }
    else if name == "never" { Option::some(BuiltinType::Never) }
    else { Option::none() }
}

// === AST-level types ===
// Discriminated union using tag + struct

// Ty tags
enum TyTag {
    Placeholder = 0i32,
    Named = 1i32,
    Builtin = 2i32,
    Pointer = 3i32,
    Slice = 4i32,
    Array = 5i32,
    Tuple = 6i32,
    FnPointer = 7i32,
    Generic = 8i32,
    Typeof = 9i32,
    Never = 10i32,
    Unresolved = 11i32,
    When = 12i32,
    DerefOf = 13i32,    // *T in type position — pointee of T
    Dyn = 14i32,        // &dyn Proto — fat pointer with vtable; resolves to lang(dyn) struct
    TupleIndexOf = 15i32, // T.N in type position — Nth element of tuple type T
    EtCetera = 16i32,   // T... in a tuple or parameter list — the elements of tuple T
    Defered = 17i32,    // T::name in type position — the type of T's associated function `name`
}

struct _TyPointerData { inner: &Ty, is_const: bool }
struct _TyArrayData { inner: &Ty, array_size: usize }
struct _TyFnPtrData { elems: &[&Ty], ret_ty: &Ty, is_protocol: bool }
struct _TyDeferedData { inner: &Ty, name: &[u8] }
struct _TyGenericData { inner: &Ty, elems: &[&Ty] }
struct _TyWhenData { inner: &Ty, ret_ty: &Ty, typeof_expr: &Expr }

union _TyData {
    builtin: BuiltinType,        // Builtin, Never
    id: Id,                       // Placeholder, Named
    pointer: _TyPointerData,     // Pointer, Slice
    array: _TyArrayData,         // Array
    elems: &[&Ty],              // Tuple
    fn_ptr: _TyFnPtrData,       // FnPointer
    generic: _TyGenericData,     // Generic
    typeof_expr: &Expr,          // Typeof
    when: _TyWhenData,           // When
    defered: _TyDeferedData,     // Defered
}

struct Ty {
    tag: TyTag,
    _data: _TyData,
}

impl Ty {
    /// Whether it or a type it is made of satisfies `pred`.
    fn any_part<F: Fn(&Ty) -> bool>(self: &Ty, pred: F) -> bool {
        if pred(self) {
            return true;
        }
        switch self.tag {
            TyTag::Pointer, TyTag::Slice, TyTag::Array, TyTag::EtCetera, TyTag::DerefOf, TyTag::Dyn,
            TyTag::Defered => self.inner().any_part(pred),
            TyTag::Tuple => self.elems().iter().any(|=pred, t: &Ty| -> bool { t.any_part(pred) }),
            TyTag::FnPointer => self.ret_ty().any_part(pred)
                || self.elems().iter().any(|=pred, t: &Ty| -> bool { t.any_part(pred) }),
            TyTag::Generic => self.inner().any_part(pred)
                || self.elems().iter().any(|=pred, t: &Ty| -> bool { t.any_part(pred) }),
            _ => false,
        }
    }

    /// Whether it mentions the generic parameter `id`.
    fn mentions(self: &Ty, id: Id) -> bool {
        self.any_part(|=id, t: &Ty| -> bool { t.tag == TyTag::Placeholder && t.id()._value == id._value })
    }

    /// Whether it is the same type wherever it is written: built from
    /// builtin types only (slices are instances of a generic type, as in
    /// alumina-boot).
    fn is_concrete(self: &Ty) -> bool {
        switch self.tag {
            TyTag::Builtin => true,
            TyTag::Pointer, TyTag::Array => self.inner().is_concrete(),
            TyTag::Tuple => self.elems().iter().all(|t: &Ty| -> bool { t.is_concrete() }),
            _ => false,
        }
    }

    // Accessors
    fn builtin(self: &Ty) -> BuiltinType { self._data.builtin }
    fn id(self: &Ty) -> Id { self._data.id }
    fn inner(self: &Ty) -> &Ty {
        if self.tag == TyTag::Pointer || self.tag == TyTag::Slice || self.tag == TyTag::DerefOf
            || self.tag == TyTag::Dyn || self.tag == TyTag::EtCetera { self._data.pointer.inner }
        else if self.tag == TyTag::Array || self.tag == TyTag::TupleIndexOf { self._data.array.inner }
        else if self.tag == TyTag::Generic { self._data.generic.inner }
        else if self.tag == TyTag::Defered { self._data.defered.inner }
        else { self._data.when.inner } // When
    }
    fn is_const(self: &Ty) -> bool { self._data.pointer.is_const }
    fn array_size(self: &Ty) -> usize { self._data.array.array_size }
    fn elems(self: &Ty) -> &[&Ty] {
        if self.tag == TyTag::Tuple { self._data.elems }
        else if self.tag == TyTag::FnPointer { self._data.fn_ptr.elems }
        else { self._data.generic.elems } // Generic
    }
    fn ret_ty(self: &Ty) -> &Ty {
        if self.tag == TyTag::FnPointer { self._data.fn_ptr.ret_ty }
        else { self._data.when.ret_ty } // When
    }
    /// Whether a function type is the `Fn(...) -> R` protocol (else a
    /// `fn(...) -> R` pointer).
    fn is_fn_protocol(self: &Ty) -> bool { self._data.fn_ptr.is_protocol }
    /// The name of the associated function a `Defered` type is of.
    fn defered_name(self: &Ty) -> &[u8] { self._data.defered.name }
    fn typeof_expr(self: &Ty) -> &Expr {
        if self.tag == TyTag::Typeof { self._data.typeof_expr }
        else { self._data.when.typeof_expr } // When, Array (size expr via array_ty_with_expr)
    }

    // Constructors
    fn placeholder(id: Id) -> Ty {
        Ty { tag: TyTag::Placeholder, _data: _TyData { id: id } }
    }
    fn named(id: Id) -> Ty {
        Ty { tag: TyTag::Named, _data: _TyData { id: id } }
    }
    fn builtin_ty(bt: BuiltinType) -> Ty {
        Ty { tag: TyTag::Builtin, _data: _TyData { builtin: bt } }
    }
    fn pointer_ty(pointee: &Ty, is_const: bool) -> Ty {
        Ty { tag: TyTag::Pointer, _data: _TyData { pointer: _TyPointerData { inner: pointee, is_const: is_const } } }
    }
    fn slice_ty(elem: &Ty, is_const: bool) -> Ty {
        Ty { tag: TyTag::Slice, _data: _TyData { pointer: _TyPointerData { inner: elem, is_const: is_const } } }
    }
    fn array_ty(elem: &Ty, size: usize) -> Ty {
        Ty { tag: TyTag::Array, _data: _TyData { array: _TyArrayData { inner: elem, array_size: size } } }
    }
    fn array_ty_with_expr(elem: &Ty, size_expr: &Expr) -> Ty {
        Ty { tag: TyTag::Array, _data: _TyData { when: _TyWhenData { inner: elem, ret_ty: null, typeof_expr: size_expr } } }
    }
    /// `T...`: the elements of the tuple `T`, spliced into a tuple type or
    /// a parameter list.
    fn et_cetera_ty(inner: &Ty) -> Ty {
        Ty { tag: TyTag::EtCetera, _data: _TyData { pointer: _TyPointerData { inner: inner, is_const: false } } }
    }
    fn tuple_ty(elems: &[&Ty]) -> Ty {
        Ty { tag: TyTag::Tuple, _data: _TyData { elems: elems } }
    }
    // `T.N` in type position: the Nth element of the tuple type `inner`
    // (reuses the array data slot — inner + a usize). Resolved in
    // mono/lower.alu's resolve_type.
    /// `T.N` / `T.(expr)`: the element (or, for a range, the sub-tuple) of
    /// the tuple type `T`; the index is `typeof_expr()`.
    fn tuple_index_of_ty(inner: &Ty, index: &Expr) -> Ty {
        Ty { tag: TyTag::TupleIndexOf, _data: _TyData { when: _TyWhenData { inner: inner, ret_ty: null, typeof_expr: index } } }
    }
    fn fn_pointer_ty(params: &[&Ty], ret: &Ty) -> Ty {
        Ty { tag: TyTag::FnPointer, _data: _TyData { fn_ptr: _TyFnPtrData { elems: params, ret_ty: ret, is_protocol: false } } }
    }
    fn fn_protocol_ty(params: &[&Ty], ret: &Ty) -> Ty {
        Ty { tag: TyTag::FnPointer, _data: _TyData { fn_ptr: _TyFnPtrData { elems: params, ret_ty: ret, is_protocol: true } } }
    }
    /// `T::name`, where `T` is a generic parameter.
    fn defered_ty(inner: &Ty, name: &[u8]) -> Ty {
        Ty { tag: TyTag::Defered, _data: _TyData { defered: _TyDeferedData { inner: inner, name: name } } }
    }
    fn generic_ty(base: &Ty, args: &[&Ty]) -> Ty {
        Ty { tag: TyTag::Generic, _data: _TyData { generic: _TyGenericData { inner: base, elems: args } } }
    }
    fn never_ty() -> Ty {
        Ty { tag: TyTag::Never, _data: _TyData { builtin: BuiltinType::Never } }
    }
    fn when_ty(condition: &Expr, consequence: &Ty, alternative: &Ty) -> Ty {
        Ty { tag: TyTag::When, _data: _TyData { when: _TyWhenData { inner: consequence, ret_ty: alternative, typeof_expr: condition } } }
    }
    fn typeof_ty(expr: &Expr) -> Ty {
        Ty { tag: TyTag::Typeof, _data: _TyData { typeof_expr: expr } }
    }
    fn deref_of_ty(inner: &Ty) -> Ty {
        // `*T` in type position — pointee of T. When T is a pointer with
        // pointee P, resolves to P. When T is a placeholder, resolves
        // after substitution.
        Ty { tag: TyTag::DerefOf, _data: _TyData { pointer: _TyPointerData { inner: inner, is_const: false } } }
    }
    fn dyn_ty(inner: &Ty, is_const: bool) -> Ty {
        // `&dyn Foo` — fat pointer with vtable. Resolves to the lang(dyn)
        // struct; inner is the protocol type.
        Ty { tag: TyTag::Dyn, _data: _TyData { pointer: _TyPointerData { inner: inner, is_const: is_const } } }
    }
    fn unresolved() -> Ty {
        Ty { tag: TyTag::Unresolved, _data: _TyData { builtin: BuiltinType::Void } }
    }
    fn void_ty() -> Ty {
        Ty::builtin_ty(BuiltinType::Void)
    }
}

// Reference to an item (function, struct, enum, etc.)
struct ItemRef {
    id: Id,
}

// === AST Expressions ===

enum BinOp {
    Add = 0i32,
    Sub = 1i32,
    Mul = 2i32,
    Div = 3i32,
    Rem = 4i32,
    BitAnd = 5i32,
    BitOr = 6i32,
    BitXor = 7i32,
    Shl = 8i32,
    Shr = 9i32,
    Eq = 10i32,
    Ne = 11i32,
    Lt = 12i32,
    Le = 13i32,
    Gt = 14i32,
    Ge = 15i32,
    And = 16i32,
    Or = 17i32,
}

enum UnOp {
    Neg = 0i32,
    Not = 1i32,
    BitNot = 2i32,
}

impl BinOp {
    /// The method a comparison operator calls on types that overload it
    /// (those of `Equatable` and `Comparable`), "" for other operators.
    fn method_name(self: &BinOp) -> &[u8] {
        switch *self {
            BinOp::Eq => "equals",
            BinOp::Ne => "not_equals",
            BinOp::Lt => "less_than",
            BinOp::Le => "less_than_or_equal",
            BinOp::Gt => "greater_than",
            BinOp::Ge => "greater_than_or_equal",
            _ => "",
        }
    }

    fn symbol(self: &BinOp) -> &[u8] {
        switch *self {
            BinOp::Add => "+",
            BinOp::Sub => "-",
            BinOp::Mul => "*",
            BinOp::Div => "/",
            BinOp::Rem => "%",
            BinOp::BitAnd => "&",
            BinOp::BitOr => "|",
            BinOp::BitXor => "^",
            BinOp::Shl => "<<",
            BinOp::Shr => ">>",
            BinOp::Eq => "==",
            BinOp::Ne => "!=",
            BinOp::Lt => "<",
            BinOp::Le => "<=",
            BinOp::Gt => ">",
            BinOp::Ge => ">=",
            BinOp::And => "&&",
            BinOp::Or => "||",
            _ => unreachable!(),
        }
    }

    fn is_comparison(self: &BinOp) -> bool {
        switch *self {
            BinOp::Eq, BinOp::Ne, BinOp::Lt, BinOp::Le, BinOp::Gt, BinOp::Ge => true,
            _ => false,
        }
    }

    fn is_equality(self: &BinOp) -> bool {
        *self == BinOp::Eq || *self == BinOp::Ne
    }

    fn is_shift(self: &BinOp) -> bool {
        *self == BinOp::Shl || *self == BinOp::Shr
    }

    fn is_logical(self: &BinOp) -> bool {
        *self == BinOp::And || *self == BinOp::Or
    }
}

impl UnOp {
    fn symbol(self: &UnOp) -> &[u8] {
        switch *self {
            UnOp::Neg => "-",
            UnOp::Not => "!",
            UnOp::BitNot => "~",
            _ => unreachable!(),
        }
    }
}

enum AssignOp {
    Assign = 0i32,
    AddAssign = 1i32,
    SubAssign = 2i32,
    MulAssign = 3i32,
    DivAssign = 4i32,
    RemAssign = 5i32,
    BitAndAssign = 6i32,
    BitOrAssign = 7i32,
    BitXorAssign = 8i32,
    ShlAssign = 9i32,
    ShrAssign = 10i32,
}

impl AssignOp {
    /// The operator of a compound assignment (`+` for `+=`, ...).
    fn bin_op(self: &AssignOp) -> Option<BinOp> {
        switch *self {
            AssignOp::AddAssign => Option::some(BinOp::Add),
            AssignOp::SubAssign => Option::some(BinOp::Sub),
            AssignOp::MulAssign => Option::some(BinOp::Mul),
            AssignOp::DivAssign => Option::some(BinOp::Div),
            AssignOp::RemAssign => Option::some(BinOp::Rem),
            AssignOp::BitAndAssign => Option::some(BinOp::BitAnd),
            AssignOp::BitOrAssign => Option::some(BinOp::BitOr),
            AssignOp::BitXorAssign => Option::some(BinOp::BitXor),
            AssignOp::ShlAssign => Option::some(BinOp::Shl),
            AssignOp::ShrAssign => Option::some(BinOp::Shr),
            _ => Option::none(),
        }
    }
}

struct FieldInit {
    name: &[u8],
    value: &Expr,
}

struct SwitchArm {
    pattern: &[&Expr],
    body: &Expr,
}

// Expression tags
enum ExprTag {
    IntLit = 0i32,
    FloatLit = 1i32,
    BoolLit = 2i32,
    StringLit = 3i32,
    NullLit = 5i32,
    Local = 6i32,
    Param = 7i32,
    StaticRef = 8i32,
    FnRef = 9i32,
    EnumRef = 10i32,
    Block = 11i32,
    Binary = 12i32,
    Unary = 13i32,
    Assign = 14i32,
    Call = 15i32,
    MethodCall = 16i32,
    FieldAccess = 17i32,
    TupleIndex = 18i32,
    Index = 19i32,
    Ref = 20i32,
    Deref = 21i32,
    Cast = 22i32,
    TypeCheck = 23i32,
    If = 24i32,
    When = 25i32,
    Switch = 26i32,
    While = 27i32,
    For = 28i32,
    Loop = 29i32,
    Break = 30i32,
    Continue = 31i32,
    Return = 32i32,
    Let = 33i32,
    StructLit = 34i32,
    TupleLit = 35i32,
    ArrayLit = 36i32,
    Lambda = 37i32,
    Defer = 38i32,
    Try = 39i32,
    Range = 40i32,
    Void = 41i32,
    Zeroed = 42i32,
    StaticFor = 43i32,
    EtCetera = 44i32,
    MacroInvocation = 45i32,
    BoundValue = 46i32,     // Access a captured variable in a closure body
    MacroParam = 47i32,     // $param reference in pre-parsed macro body (int_val=index, flag=is_variadic)
    TurbofishValue = 48i32, // func::<T> used as a value (fn pointer), not a call
    Defered = 49i32,        // T::method() where T is a generic type param - deferred until mono
                            // id = generic param id, str_val = method name
    Yield = 50i32,          // `yield value` in a coroutine (opt_expr)
    MacroEtCetera = 51i32,  // `expr$...` in a macro body: `expr` once per `...` argument (lhs)
}

// Expression sub-structs for union variants
// For an integer literal, int_val/int_val_hi hold the value's two's
// complement bits and `negative` whether it was written with a `-`.
struct _ExprLitData { int_val: u64, int_val_hi: u64, float_val: f64, bool_val: bool, str_val: &[u8], type_suffix: Option<BuiltinType>, negative: bool }
struct _ExprIdData { id: Id, id2: Id, str_val: &[u8], flag: bool, int_val: u64 }
struct _ExprUnaryData { un_op: UnOp, lhs: &Expr }
struct _ExprBinaryData { bin_op: BinOp, lhs: &Expr, rhs: &Expr }
struct _ExprAssignData { assign_op: AssignOp, lhs: &Expr, rhs: &Expr }
struct _ExprCallData { lhs: &Expr, args: &[&Expr], type_args: &[&Ty] }
struct _ExprFieldData { lhs: &Expr, str_val: &[u8], id2: Id }
struct _ExprIndexData { lhs: &Expr, rhs: &Expr, index_val: usize, opt_expr: Option<&Expr> }
struct _ExprTypedData { lhs: &Expr, ty: &Ty, flag: bool }
struct _ExprCondData { cond: &Expr, lhs: &Expr, opt_expr: Option<&Expr> }
struct _ExprSwitchData { lhs: &Expr, switch_arms: &[SwitchArm] }
struct _ExprLoopData { cond: &Expr, lhs: &Expr }
struct _ExprForData { id: Id, lhs: &Expr, rhs: &Expr, args: &[&Expr] }
struct _ExprJumpData { opt_expr: Option<&Expr> }
struct _ExprLetData { id: Id, str_val: &[u8], opt_ty: Option<&Ty>, opt_expr: Option<&Expr> }
struct _ExprStructLitData { ty: &Ty, field_inits: &[FieldInit] }
struct _ExprListData { args: &[&Expr] }
struct _ExprLambdaData { id: Id, lambda_params: &[LambdaParam], closure_bindings: &[ClosureBinding], opt_ty: Option<&Ty>, lhs: &Expr }
// `macro_id` is the macro an invocation inside a macro body resolved to at
// its definition site (0 if unresolved there, e.g. a `$m!` parameter).
struct _ExprMacroData { str_val: &[u8], args: &[&Expr], flag: bool, is_param_subst: bool, param_idx: i32, macro_id: usize }
struct _ExprRangeData { lhs: &Expr, rhs: &Expr, flag: bool }
struct _ExprDeferData { lhs: &Expr }

union _ExprData {
    lit: _ExprLitData,
    id_ref: _ExprIdData,
    unary: _ExprUnaryData,
    binary: _ExprBinaryData,
    assign: _ExprAssignData,
    call: _ExprCallData,
    field: _ExprFieldData,
    index: _ExprIndexData,
    typed: _ExprTypedData,
    cond: _ExprCondData,
    switch_expr: _ExprSwitchData,
    loop_expr: _ExprLoopData,
    for_expr: _ExprForData,
    jump: _ExprJumpData,
    let_expr: _ExprLetData,
    struct_lit: _ExprStructLitData,
    list: _ExprListData,
    lambda: _ExprLambdaData,
    macro_expr: _ExprMacroData,
    range: _ExprRangeData,
    defer: _ExprDeferData,
}

struct Expr {
    tag: ExprTag,
    span: Span,
    _data: _ExprData,
}

impl Expr {
    fn void_expr() -> Expr {
        let e = std::mem::zeroed::<Expr>();
        e.tag = ExprTag::Void;
        e.span = Span::empty();
        e
    }

    // --- Getter accessors ---

    fn int_val(self: &Expr) -> u64 {
        if self.tag == ExprTag::IntLit || self.tag == ExprTag::FloatLit || self.tag == ExprTag::BoolLit || self.tag == ExprTag::StringLit || self.tag == ExprTag::NullLit {
            self._data.lit.int_val
        } else {
            self._data.id_ref.int_val  // MacroParam, etc.
        }
    }

    // High 64 bits of a 128-bit integer literal (0 for ≤64-bit). The
    // common `int_val()` stays the low word so the many small-value
    // consumers (array sizes, tuple indices, …) are untouched.
    fn int_val_hi(self: &Expr) -> u64 {
        if self.tag == ExprTag::IntLit { self._data.lit.int_val_hi } else { 0u64 }
    }
    fn int_val_u128(self: &Expr) -> u128 {
        ((self.int_val_hi() as u128) << 64) | (self.int_val() as u128)
    }

    /// Whether an integer literal was written negative (`-5`).
    fn is_negative(self: &Expr) -> bool {
        self._data.lit.negative
    }

    /// The absolute value of an integer literal.
    fn int_magnitude(self: &Expr) -> u128 {
        let v = self.int_val_u128();
        if self.is_negative() && v != 0 { ~v + 1 } else { v }
    }

    fn float_val(self: &Expr) -> f64 { self._data.lit.float_val }
    fn bool_val(self: &Expr) -> bool { self._data.lit.bool_val }

    fn str_val(self: &Expr) -> &[u8] {
        switch self.tag {
            ExprTag::IntLit, ExprTag::FloatLit, ExprTag::BoolLit, ExprTag::StringLit, ExprTag::NullLit => {
                self._data.lit.str_val
            }
            ExprTag::FieldAccess => self._data.field.str_val,
            ExprTag::Let => self._data.let_expr.str_val,
            ExprTag::MacroInvocation, ExprTag::EtCetera => self._data.macro_expr.str_val,
            _ => self._data.id_ref.str_val  // Local, Param, StaticRef, FnRef, EnumRef, BoundValue, Defered, MacroParam,
        }
    }

    fn id(self: &Expr) -> Id {
        switch self.tag {
            ExprTag::For, ExprTag::StaticFor => self._data.for_expr.id,
            ExprTag::Let => self._data.let_expr.id,
            ExprTag::Lambda => self._data.lambda.id,
            _ => self._data.id_ref.id  // Local, Param, StaticRef, FnRef, EnumRef, BoundValue, Defered, MacroParam,
        }
    }

    fn id2(self: &Expr) -> Id {
        if self.tag == ExprTag::FieldAccess {
            self._data.field.id2
        } else {
            self._data.id_ref.id2
        }
    }

    fn bin_op(self: &Expr) -> BinOp { self._data.binary.bin_op }
    fn un_op(self: &Expr) -> UnOp { self._data.unary.un_op }
    fn assign_op(self: &Expr) -> AssignOp { self._data.assign.assign_op }

    fn ty(self: &Expr) -> &Ty {
        if self.tag == ExprTag::StructLit {
            self._data.struct_lit.ty
        } else {
            self._data.typed.ty  // Ref, Deref, Cast, TypeCheck, Zeroed
        }
    }

    fn type_suffix(self: &Expr) -> Option<BuiltinType> { self._data.lit.type_suffix }

    fn lhs(self: &Expr) -> &Expr {
        if self.tag == ExprTag::Binary { self._data.binary.lhs }
        else if self.tag == ExprTag::Unary { self._data.unary.lhs }
        else if self.tag == ExprTag::Assign { self._data.assign.lhs }
        else if self.tag == ExprTag::Call || self.tag == ExprTag::TurbofishValue { self._data.call.lhs }
        else if self.tag == ExprTag::FieldAccess { self._data.field.lhs }
        else if self.tag == ExprTag::Index || self.tag == ExprTag::TupleIndex { self._data.index.lhs }
        else if self.tag == ExprTag::Ref || self.tag == ExprTag::Deref || self.tag == ExprTag::Cast || self.tag == ExprTag::TypeCheck { self._data.typed.lhs }
        else if self.tag == ExprTag::If || self.tag == ExprTag::When { self._data.cond.lhs }
        else if self.tag == ExprTag::Switch { self._data.switch_expr.lhs }
        else if self.tag == ExprTag::While || self.tag == ExprTag::Loop { self._data.loop_expr.lhs }
        else if self.tag == ExprTag::For || self.tag == ExprTag::StaticFor { self._data.for_expr.lhs }
        else if self.tag == ExprTag::Lambda { self._data.lambda.lhs }
        else if self.tag == ExprTag::Range { self._data.range.lhs }
        else if self.tag == ExprTag::Defer || self.tag == ExprTag::EtCetera || self.tag == ExprTag::MacroEtCetera { self._data.defer.lhs }
        else { null }
    }

    fn rhs(self: &Expr) -> &Expr {
        if self.tag == ExprTag::Binary { self._data.binary.rhs }
        else if self.tag == ExprTag::Assign { self._data.assign.rhs }
        else if self.tag == ExprTag::Index || self.tag == ExprTag::TupleIndex { self._data.index.rhs }
        else if self.tag == ExprTag::For || self.tag == ExprTag::StaticFor { self._data.for_expr.rhs }
        else if self.tag == ExprTag::Range { self._data.range.rhs }
        else { null }
    }

    fn cond(self: &Expr) -> &Expr {
        if self.tag == ExprTag::If || self.tag == ExprTag::When { self._data.cond.cond }
        else if self.tag == ExprTag::While || self.tag == ExprTag::Loop { self._data.loop_expr.cond }
        else { null }
    }

    fn args(self: &Expr) -> &[&Expr] {
        if self.tag == ExprTag::Call || self.tag == ExprTag::TurbofishValue { self._data.call.args }
        else if self.tag == ExprTag::For || self.tag == ExprTag::StaticFor { self._data.for_expr.args }
        else if self.tag == ExprTag::TupleLit || self.tag == ExprTag::ArrayLit || self.tag == ExprTag::Block { self._data.list.args }
        else if self.tag == ExprTag::MacroInvocation { self._data.macro_expr.args }
        else { &[] }
    }

    fn field_inits(self: &Expr) -> &[FieldInit] {
        if self.tag == ExprTag::StructLit { self._data.struct_lit.field_inits }
        else { &[] }
    }

    fn switch_arms(self: &Expr) -> &[SwitchArm] {
        if self.tag == ExprTag::Switch { self._data.switch_expr.switch_arms }
        else { &[] }
    }

    fn type_args(self: &Expr) -> &[&Ty] {
        if self.tag == ExprTag::Call || self.tag == ExprTag::TurbofishValue { self._data.call.type_args }
        else { &[] }
    }

    fn flag(self: &Expr) -> bool {
        if self.tag == ExprTag::Ref || self.tag == ExprTag::Deref || self.tag == ExprTag::Cast || self.tag == ExprTag::TypeCheck { self._data.typed.flag }
        else if self.tag == ExprTag::Range { self._data.range.flag }
        else if self.tag == ExprTag::MacroInvocation || self.tag == ExprTag::EtCetera { self._data.macro_expr.flag }
        else if self.tag == ExprTag::Local || self.tag == ExprTag::Param || self.tag == ExprTag::StaticRef || self.tag == ExprTag::FnRef || self.tag == ExprTag::EnumRef || self.tag == ExprTag::BoundValue || self.tag == ExprTag::Defered || self.tag == ExprTag::MacroParam {
            self._data.id_ref.flag
        }
        else { false }
    }

    fn opt_expr(self: &Expr) -> Option<&Expr> {
        if self.tag == ExprTag::Index || self.tag == ExprTag::TupleIndex { self._data.index.opt_expr }
        else if self.tag == ExprTag::If || self.tag == ExprTag::When { self._data.cond.opt_expr }
        else if self.tag == ExprTag::Break || self.tag == ExprTag::Return || self.tag == ExprTag::Continue
            || self.tag == ExprTag::Yield { self._data.jump.opt_expr }
        else if self.tag == ExprTag::Let { self._data.let_expr.opt_expr }
        else { Option::none() }
    }

    fn opt_ty(self: &Expr) -> Option<&Ty> {
        if self.tag == ExprTag::Let { self._data.let_expr.opt_ty }
        else if self.tag == ExprTag::Lambda { self._data.lambda.opt_ty }
        else { Option::none() }
    }

    fn index_val(self: &Expr) -> usize { self._data.index.index_val }
    fn lambda_params(self: &Expr) -> &[LambdaParam] { self._data.lambda.lambda_params }
    fn closure_bindings(self: &Expr) -> &[ClosureBinding] { self._data.lambda.closure_bindings }

    // --- Setter methods for expand_macro_expr ---

    fn set_lhs(self: &mut Expr, val: &Expr) {
        if self.tag == ExprTag::Binary { self._data.binary.lhs = val; }
        else if self.tag == ExprTag::Unary { self._data.unary.lhs = val; }
        else if self.tag == ExprTag::Assign { self._data.assign.lhs = val; }
        else if self.tag == ExprTag::Call || self.tag == ExprTag::TurbofishValue { self._data.call.lhs = val; }
        else if self.tag == ExprTag::FieldAccess { self._data.field.lhs = val; }
        else if self.tag == ExprTag::Index || self.tag == ExprTag::TupleIndex { self._data.index.lhs = val; }
        else if self.tag == ExprTag::Ref || self.tag == ExprTag::Deref || self.tag == ExprTag::Cast || self.tag == ExprTag::TypeCheck { self._data.typed.lhs = val; }
        else if self.tag == ExprTag::If || self.tag == ExprTag::When { self._data.cond.lhs = val; }
        else if self.tag == ExprTag::Switch { self._data.switch_expr.lhs = val; }
        else if self.tag == ExprTag::While || self.tag == ExprTag::Loop { self._data.loop_expr.lhs = val; }
        else if self.tag == ExprTag::For || self.tag == ExprTag::StaticFor { self._data.for_expr.lhs = val; }
        else if self.tag == ExprTag::Lambda { self._data.lambda.lhs = val; }
        else if self.tag == ExprTag::Range { self._data.range.lhs = val; }
        else if self.tag == ExprTag::Defer || self.tag == ExprTag::EtCetera || self.tag == ExprTag::MacroEtCetera { self._data.defer.lhs = val; }
    }

    fn set_rhs(self: &mut Expr, val: &Expr) {
        if self.tag == ExprTag::Binary { self._data.binary.rhs = val; }
        else if self.tag == ExprTag::Assign { self._data.assign.rhs = val; }
        else if self.tag == ExprTag::Index || self.tag == ExprTag::TupleIndex { self._data.index.rhs = val; }
        else if self.tag == ExprTag::For || self.tag == ExprTag::StaticFor { self._data.for_expr.rhs = val; }
        else if self.tag == ExprTag::Range { self._data.range.rhs = val; }
    }

    fn set_cond(self: &mut Expr, val: &Expr) {
        if self.tag == ExprTag::If || self.tag == ExprTag::When { self._data.cond.cond = val; }
        else if self.tag == ExprTag::While || self.tag == ExprTag::Loop { self._data.loop_expr.cond = val; }
    }

    fn set_args(self: &mut Expr, val: &[&Expr]) {
        if self.tag == ExprTag::Call || self.tag == ExprTag::TurbofishValue { self._data.call.args = val; }
        else if self.tag == ExprTag::For || self.tag == ExprTag::StaticFor { self._data.for_expr.args = val; }
        else if self.tag == ExprTag::TupleLit || self.tag == ExprTag::ArrayLit || self.tag == ExprTag::Block { self._data.list.args = val; }
        else if self.tag == ExprTag::MacroInvocation { self._data.macro_expr.args = val; }
    }

    fn set_opt_expr(self: &mut Expr, val: Option<&Expr>) {
        if self.tag == ExprTag::Index || self.tag == ExprTag::TupleIndex { self._data.index.opt_expr = val; }
        else if self.tag == ExprTag::If || self.tag == ExprTag::When { self._data.cond.opt_expr = val; }
        else if self.tag == ExprTag::Break || self.tag == ExprTag::Return || self.tag == ExprTag::Continue
            || self.tag == ExprTag::Yield { self._data.jump.opt_expr = val; }
        else if self.tag == ExprTag::Let { self._data.let_expr.opt_expr = val; }
    }

    fn set_switch_arms(self: &mut Expr, val: &[SwitchArm]) {
        if self.tag == ExprTag::Switch { self._data.switch_expr.switch_arms = val; }
    }

    fn set_field_inits(self: &mut Expr, val: &[FieldInit]) {
        if self.tag == ExprTag::StructLit { self._data.struct_lit.field_inits = val; }
    }

    fn set_id(self: &mut Expr, val: Id) {
        if self.tag == ExprTag::For || self.tag == ExprTag::StaticFor { self._data.for_expr.id = val; }
        else if self.tag == ExprTag::Let { self._data.let_expr.id = val; }
        else if self.tag == ExprTag::Lambda { self._data.lambda.id = val; }
        else { self._data.id_ref.id = val; }
    }
}

// Bound type for closure captures
enum BoundType {
    ByValue = 0i32,
    ByReference = 1i32,
}

struct ClosureBinding {
    id: Id,          // New id for the binding inside the closure
    name: &[u8],     // Variable name
    value: &Expr,    // Original expression being captured (usually ExprTag::Local or ExprTag::Param)
    bound_type: BoundType,
}

struct LambdaParam {
    id: Id,
    name: &[u8],
    ty: Option<&Ty>,
}

struct Span {
    file_id: u32,
    start: u32,
    end: u32,
    /// The macro expansion the code comes from (1-based, in the diagnostic
    /// context's `expansions`), or 0 for code as written.
    expansion: u32,
}

impl Span {
    fn empty() -> Span {
        Span { file_id: 0, start: 0, end: 0, expansion: 0 }
    }

    /// Whether this is the placeholder span of synthesized code.
    fn is_empty(self: &Span) -> bool {
        self.start == 0 && self.end == 0
    }
}

// === AST Items ===

struct FnParam {
    id: Id,
    name: &[u8],
    ty: &Ty,
}

struct GenericParam {
    id: Id,
    name: &[u8],
    /// Protocol bounds the argument must satisfy (`T: A + B`), or of which
    /// it must satisfy at least one when `any_bounds` (`T: A | B`).
    bounds: &[&Ty],
    /// Negated bounds (`T: !ZeroSized`), which the argument must not satisfy.
    negative_bounds: &[&Ty],
    any_bounds: bool,
    default_ty: Option<&Ty>,
}

impl GenericParam {
    /// A parameter without bounds or default.
    fn plain(id: Id, name: &[u8]) -> GenericParam {
        GenericParam { id: id, name: name, bounds: &[], negative_bounds: &[], any_bounds: false, default_ty: Option::none() }
    }
}

// Attribute tags
enum AttrTag {
    Export = 0i32,
    Inline = 1i32,
    AlwaysInline = 2i32,
    Cold = 3i32,
    Align = 4i32,
    Extern = 5i32,
    Cfg = 6i32,
    NoReturn = 7i32,
    ThreadLocal = 8i32,
    Test = 9i32,
    Main = 10i32,
    StaticCtor = 11i32,
    Lang = 12i32,
    InlineIr = 13i32,
    Builtin = 14i32,
    ReturnsTwice = 15i32,
    TestMain = 16i32,
    LinkName = 17i32,
    NeverInline = 18i32,
    Transparent = 19i32,
    Packed = 20i32,
    MustUse = 21i32,
    NoMangle = 22i32,
    ConstOnly = 23i32,
    NoConst = 24i32,
    TupleArgs = 25i32,     // #[tuple_args]: the single tuple parameter is passed as separate arguments
    Custom = 26i32,        // unrecognized #[name(...)]; str_val = name
    Coroutine = 27i32,     // `fn*`: a coroutine
}

union _AttributeData {
    str_val: &[u8],     // for AttrTag::Extern, AttrTag::Cfg, AttrTag::Lang
    int_val: usize,     // for AttrTag::Align
}

struct Attribute {
    tag: AttrTag,
    _data: _AttributeData,
}

impl Attribute {
    fn str_val(self: &Attribute) -> &[u8] { self._data.str_val }
    fn int_val(self: &Attribute) -> usize { self._data.int_val }

    fn _no_data() -> _AttributeData { _AttributeData { str_val: "" } }

    fn export() -> Attribute { Attribute { tag: AttrTag::Export, _data: Attribute::_no_data() } }
    fn inline_attr() -> Attribute { Attribute { tag: AttrTag::Inline, _data: Attribute::_no_data() } }
    fn always_inline() -> Attribute { Attribute { tag: AttrTag::AlwaysInline, _data: Attribute::_no_data() } }
    fn cold() -> Attribute { Attribute { tag: AttrTag::Cold, _data: Attribute::_no_data() } }
    fn align(n: usize) -> Attribute { Attribute { tag: AttrTag::Align, _data: _AttributeData { int_val: n } } }
    fn extern_attr(abi: &[u8]) -> Attribute { Attribute { tag: AttrTag::Extern, _data: _AttributeData { str_val: abi } } }
    fn cfg(val: &[u8]) -> Attribute { Attribute { tag: AttrTag::Cfg, _data: _AttributeData { str_val: val } } }
    fn no_return() -> Attribute { Attribute { tag: AttrTag::NoReturn, _data: Attribute::_no_data() } }
    fn thread_local() -> Attribute { Attribute { tag: AttrTag::ThreadLocal, _data: Attribute::_no_data() } }
    fn test() -> Attribute { Attribute { tag: AttrTag::Test, _data: Attribute::_no_data() } }
    fn main_attr() -> Attribute { Attribute { tag: AttrTag::Main, _data: Attribute::_no_data() } }
    fn static_ctor() -> Attribute { Attribute { tag: AttrTag::StaticCtor, _data: Attribute::_no_data() } }
    fn lang(name: &[u8]) -> Attribute { Attribute { tag: AttrTag::Lang, _data: _AttributeData { str_val: name } } }
    fn inline_ir() -> Attribute { Attribute { tag: AttrTag::InlineIr, _data: Attribute::_no_data() } }
    fn builtin() -> Attribute { Attribute { tag: AttrTag::Builtin, _data: Attribute::_no_data() } }
    fn returns_twice() -> Attribute { Attribute { tag: AttrTag::ReturnsTwice, _data: Attribute::_no_data() } }
    fn test_main() -> Attribute { Attribute { tag: AttrTag::TestMain, _data: Attribute::_no_data() } }
    fn link_name(name: &[u8]) -> Attribute { Attribute { tag: AttrTag::LinkName, _data: _AttributeData { str_val: name } } }
    fn never_inline() -> Attribute { Attribute { tag: AttrTag::NeverInline, _data: Attribute::_no_data() } }
    fn transparent() -> Attribute { Attribute { tag: AttrTag::Transparent, _data: Attribute::_no_data() } }
    fn packed(n: usize) -> Attribute { Attribute { tag: AttrTag::Packed, _data: _AttributeData { int_val: n } } }
    fn must_use() -> Attribute { Attribute { tag: AttrTag::MustUse, _data: Attribute::_no_data() } }
    fn no_mangle() -> Attribute { Attribute { tag: AttrTag::NoMangle, _data: Attribute::_no_data() } }
    fn const_only() -> Attribute { Attribute { tag: AttrTag::ConstOnly, _data: Attribute::_no_data() } }
    fn no_const() -> Attribute { Attribute { tag: AttrTag::NoConst, _data: Attribute::_no_data() } }
    fn coroutine() -> Attribute { Attribute { tag: AttrTag::Coroutine, _data: Attribute::_no_data() } }
    fn tuple_args() -> Attribute { Attribute { tag: AttrTag::TupleArgs, _data: Attribute::_no_data() } }
    fn custom(name: &[u8]) -> Attribute { Attribute { tag: AttrTag::Custom, _data: _AttributeData { str_val: name } } }
}

struct FnDef {
    id: Id,
    name: &[u8],
    generic_params: &[GenericParam],
    params: &[FnParam],
    return_type: &Ty,
    body: Option<&Expr>,
    attributes: &[Attribute],
    is_variadic: bool,
    abi: Option<&[u8]>,
    span: Span,
}

struct StructField {
    id: Id,
    name: &[u8],
    ty: &Ty,
    span: Span,
}

struct StructDef {
    id: Id,
    name: &[u8],
    generic_params: &[GenericParam],
    fields: &[StructField],
    attributes: &[Attribute],
    is_union: bool,
    scope_idx: u32,
    span: Span,
}

struct EnumVariant {
    id: Id,
    name: &[u8],
    value: Option<&Expr>,
    span: Span,
}

struct EnumDef {
    id: Id,
    name: &[u8],
    underlying_type: Option<&Ty>,
    variants: &[EnumVariant],
    attributes: &[Attribute],
    scope_idx: u32,
}

struct TypeAlias {
    id: Id,
    name: &[u8],
    generic_params: &[GenericParam],
    target: &Ty,
    /// Declared without a target (`type Foo;`), as the type operators are.
    opaque: bool,
    attributes: &[Attribute],
    span: Span,
}

struct ProtocolDef {
    id: Id,
    name: &[u8],
    generic_params: &[GenericParam],
    methods: &[FnDef],
    mixins: &[&Ty],
    scope_idx: u32,
    attributes: &[Attribute],
    span: Span,
}

struct StaticDef {
    id: Id,
    name: &[u8],
    ty: Option<&Ty>,
    init: Option<&Expr>,
    attributes: &[Attribute],
    is_const: bool,
    generic_params: &[GenericParam],
}


// Item tags
enum ItemTag {
    Function = 0i32,
    Struct = 1i32,
    Enum = 2i32,
    TypeAlias = 3i32,
    Protocol = 4i32,
    Static = 6i32,
}

union _ItemData {
    fn_def: FnDef,             // Function
    struct_def: StructDef,     // Struct
    enum_def: EnumDef,         // Enum
    type_alias: TypeAlias,     // TypeAlias
    protocol_def: ProtocolDef, // Protocol
    static_def: StaticDef,     // Static
}

struct Item {
    tag: ItemTag,
    span: Span,
    _data: _ItemData,
}

impl Item {
    fn fn_def(self: &Item) -> &FnDef { &self._data.fn_def }
    fn struct_def(self: &Item) -> &StructDef { &self._data.struct_def }
    fn enum_def(self: &Item) -> &EnumDef { &self._data.enum_def }
    fn type_alias(self: &Item) -> &TypeAlias { &self._data.type_alias }
    fn protocol_def(self: &Item) -> &ProtocolDef { &self._data.protocol_def }
    fn static_def(self: &Item) -> &StaticDef { &self._data.static_def }
}

#[cfg(test)]
mod tests {
    #[test]
    fn test_builtin_lang_names() {
        for (bt, name) in BUILTIN_LANG_ITEMS.as_slice().iter() {
            assert_eq!(bt.lang_name(), name);
            assert!(BuiltinType::from_lang_name(name).unwrap() == bt);
        }
        assert!(BuiltinType::from_lang_name("no_such_type").is_none());
    }

    #[test]
    fn test_ty_mentions() {
        let t = Ty::placeholder(Id { _value: 7 });
        let u8_ = Ty::builtin_ty(BuiltinType::U8);
        let ptr = Ty::pointer_ty(&t, true);
        let tuple = Ty::tuple_ty(&[&u8_, &ptr]);
        assert!(tuple.mentions(Id { _value: 7 }));
        assert!(!tuple.mentions(Id { _value: 8 }));
        assert!(!tuple.is_concrete());
        assert!(Ty::tuple_ty(&[&u8_, &u8_]).is_concrete());
    }
}
