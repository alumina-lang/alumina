// Parser: converts tree-sitter parse tree to AST
//
// Two-pass approach:
// Pass 1: Walk the tree to build scopes and register all named items
// Pass 2: Walk again to fill in function bodies, type definitions, etc.

use ast::*;
use scope::*;
use diagnostics::DiagnosticContext;
use aluminac::cfg::CfgSet;
use aluminac_common::arena::Arena;
use aluminac_common::node_kinds::{NodeKind, FieldKind, NODE_KINDS, NodeVisitor};
use aluminac_common::common::{child_by, children_by, NodeVisitorExt};
use tree_sitter::{Node, TSFieldId, TSTreeCursor};

use std::collections::{HashMap, Vector};
use std::option::{Option, try};
use std::result::Result;
use std::string::{starts_with, split};

struct ParseError {
    message: &[u8],
    span: Span,
}

// Sentinel value for "no variadic parameter" / "not in et cetera expansion"
const NO_VARIADIC: i32 = -1i32;

struct MacroEntry {
    params: &[&[u8]],
    body: &Expr,              // Pre-parsed AST body (parsed in definition-site scope)
    source: &[u8],            // Source text for error reporting
    is_builtin: bool,
    variadic_param_idx: i32,  // NO_VARIADIC if no variadic param, otherwise index into params
    scope_idx: u32,           // Definition-site scope for nested macro resolution
}

struct ParseContext {
    arena: &mut Arena,
    scopes: &mut ScopeArena,
    id_gen: &mut IdGen,
    diag: &mut DiagnosticContext,
    source: &[u8],
    file_id: u32,
    cfg: &CfgSet,

    // Items collected during pass 1, processed in pass 2
    pending_functions: Vector<PendingFunction>,
    pending_structs: Vector<PendingStruct>,
    pending_enums: Vector<PendingEnum>,
    pending_protocols: Vector<PendingProtocol>,
    pending_type_aliases: Vector<PendingTypeAlias>,
    pending_statics: Vector<PendingStatic>,
    pending_impls: Vector<PendingImpl>,
    pending_mixins: Vector<PendingMixin>,
    pending_macros: Vector<PendingMacro>,

    // Macro definitions: item_id -> MacroEntry
    macro_defs: HashMap<usize, MacroEntry>,
    // Reverse map: name -> item_id (for builtins and fallback)
    macro_name_to_id: HashMap<&[u8], usize>,

    // Current macro expansion arguments (for $param substitution in old code paths)
    macro_args: HashMap<&[u8], &Expr>,

    // Variadic (et cetera) macro expansion state
    macro_variadic_name: &[u8],       // name of the variadic param (empty if none)
    macro_variadic_args: &[&Expr],    // the variadic arguments
    macro_et_cetera_idx: i32,         // -1 if not in et cetera expansion, otherwise current index

    // Macro body pre-parsing state
    in_macro_body: bool,              // true when pre-parsing a macro body
    macro_param_names: &[&[u8]],      // param names for current macro being pre-parsed
    macro_variadic_param_idx: i32,    // variadic param index during pre-parse

    // Outermost macro call site span — propagated through nested macro
    // expansions so that `file!()` / `line!()` / `column!()` / `stringify!()`
    // inside a macro body resolve to the user's call site rather than to
    // wherever the builtin invocation appears inside the macro body itself.
    // Set at the top-level do_expand_macro call (where prev was None) and
    // restored on exit; nested do_expand_macro calls do not overwrite it.
    macro_outer_span: Option<Span>,

    // Items ready for compilation
    items: Vector<Item>,
}

struct PendingFunction {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    attributes: &[Attribute],
    is_method: bool,
    impl_generic_param_ids: &[Id],
    // Names parallel to impl_generic_param_ids. Captured at pass1 visit time
    // so pass2's build_function can re-register each impl's K/V/H in the
    // method's function scope before parsing types. Without this, a later
    // impl block of the same struct (which overwrites K in the struct's
    // shared scope) would steer this method's `K` reference to the WRONG id.
    impl_generic_param_names: &[&[u8]],
    // Byte range of the enclosing `impl Foo<...>` block (0/0 if none).
    // Lets pass2 re-parse the impl's generic params *with bounds* — the
    // ids/names lists above don't carry bounds, so impl-level bounds like
    // `Rg: RangeOf<T>` would otherwise be lost when the impl generics are
    // prepended to a method's generic_params.
    impl_decl_start: u32,
    impl_decl_end: u32,
}

struct PendingStruct {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    attributes: &[Attribute],
    is_union: bool,
}

struct PendingEnum {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    attributes: &[Attribute],
}

struct PendingProtocol {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    attributes: &[Attribute],
}

struct PendingTypeAlias {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    attributes: &[Attribute],
}

struct PendingStatic {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    attributes: &[Attribute],
    is_const: bool,
    has_generic_params: bool,
}

struct PendingMixin {
    node_start: u32,
    node_end: u32,
    impl_scope_idx: u32,     // the impl block's scope
    type_scope_idx: u32,     // the scope for resolving the protocol type ref
    impl_generic_param_ids: &[Id],  // generic param IDs from the enclosing impl
}

struct PendingImpl {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    target_type_scope: u32,
}

struct PendingMacro {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    is_builtin: bool,
}

impl ParseContext {
    fn new(
        arena: &mut Arena,
        scopes: &mut ScopeArena,
        id_gen: &mut IdGen,
        diag: &mut DiagnosticContext,
        source: &[u8],
        file_id: u32,
        cfg: &CfgSet,
    ) -> ParseContext {
        ParseContext {
            arena: arena,
            scopes: scopes,
            id_gen: id_gen,
            diag: diag,
            source: source,
            file_id: file_id,
            cfg: cfg,
            pending_functions: Vector::new(),
            pending_structs: Vector::new(),
            pending_enums: Vector::new(),
            pending_protocols: Vector::new(),
            pending_type_aliases: Vector::new(),
            pending_statics: Vector::new(),
            pending_impls: Vector::new(),
            pending_mixins: Vector::new(),
            pending_macros: Vector::new(),
            macro_defs: HashMap::new(),
            macro_name_to_id: HashMap::new(),
            macro_args: HashMap::new(),
            macro_variadic_name: "",
            macro_variadic_args: &[],
            macro_et_cetera_idx: NO_VARIADIC,
            in_macro_body: false,
            macro_param_names: &[],
            macro_variadic_param_idx: NO_VARIADIC,
            macro_outer_span: Option::none(),
            items: Vector::new(),
        }
    }

    fn node_text(self: &ParseContext, node: Node) -> &[u8] {
        self.source[node.start_byte()..node.end_byte()]
    }

    fn make_span(self: &ParseContext, node: Node) -> Span {
        Span {
            file_id: self.file_id,
            start: node.start_byte() as u32,
            end: node.end_byte() as u32,
        }
    }

    fn next_id(self: &mut ParseContext) -> Id {
        self.id_gen.next_id()
    }

    fn alloc_ty(self: &mut ParseContext, ty: Ty) -> &Ty {
        self.arena.alloc(ty) as &Ty
    }

    /// Resolve a macro by name or path (`name`, `a::b::name`, `::a::name`)
    /// through the scope system, as any other item.
    fn resolve_macro(self: &mut ParseContext, scope_idx: u32, name: &[u8]) -> Option<MacroEntry> {
        let segments: Vector<&[u8]> = Vector::new();
        defer segments.free();
        for segment in name.split("::") {
            if !segment.is_empty() {
                segments.push(segment);
            }
        }
        let item = self.scopes.resolve_path(scope_idx, segments.as_slice())?;
        if item.kind.tag != scope::NamedItemTag::Macro {
            return Option::none();
        }
        self.macro_defs.get(&item.kind.id()._value)
    }

    // Resolve a macro by item ID directly
    fn resolve_macro_by_id(self: &mut ParseContext, id: usize) -> Option<MacroEntry> {
        self.macro_defs.get(&id)
    }

    fn alloc_expr(self: &mut ParseContext, e: Expr) -> &Expr {
        self.arena.alloc(e) as &Expr
    }

    fn intern_str(self: &mut ParseContext, s: &[u8]) -> &[u8] {
        let buf = self.arena.alloc_slice::<u8>(s.len());
        s.copy_to_nonoverlapping(&buf[0]);
        buf
    }

    /// The arguments of a meta item (`name(arg, ...)`), or none if the meta
    /// item has no argument list.
    fn meta_args(self: &mut ParseContext, meta: Node) -> Option<&[Node]> {
        let args = child_by!(meta, FieldKind::Arguments)?;
        let cursor = args.walk();
        defer cursor.free();

        let nodes: Vector<Node> = Vector::new();
        defer nodes.free();
        for child in children_by!(args, FieldKind::Argument, &cursor) {
            nodes.push(child);
        }
        Option::some(self.arena.alloc_slice_copy(nodes.as_slice()) as &[Node])
    }

    /// Evaluate the condition of a `#[cfg(predicate)]` attribute, given the
    /// `cfg(...)` meta item itself.
    fn eval_cfg_attribute(self: &mut ParseContext, meta: Node) -> bool {
        let args = self.meta_args(meta);
        if args.is_none() || args.unwrap().len() != 1 {
            self.error(meta, "`cfg` expects exactly one predicate");
            return false;
        }
        self.eval_cfg(args.unwrap()[0])
    }

    /// Evaluate a cfg predicate: `key`, `key = "value"`, or a combination
    /// with `all(...)`, `any(...)` and `not(...)`. Malformed predicates are
    /// reported and evaluate to false.
    fn eval_cfg(self: &mut ParseContext, node: Node) -> bool {
        if NODE_KINDS[node.symbol() as usize] != NodeKind::MetaItem {
            self.error(node, "expected a cfg predicate");
            return false;
        }
        let name = self.node_text(child_by!(node, FieldKind::Name).unwrap());
        let args = self.meta_args(node);
        if args.is_none() {
            let value_node = child_by!(node, FieldKind::Value);
            let expected: Option<&[u8]> = if value_node.is_some() {
                let text = self.node_text(value_node.unwrap());
                if NODE_KINDS[value_node.unwrap().symbol() as usize] == NodeKind::StringLiteral {
                    Option::some(unescape_string(text[1..text.len() - 1], self.arena) as &[u8])
                } else {
                    Option::some(text)
                }
            } else {
                Option::none()
            };
            return self.cfg.matches(name, expected);
        }

        let args = args.unwrap();
        switch name {
            "all" => args.iter().all(|&self, arg: Node| -> bool { self.eval_cfg(arg) }),
            "any" => args.iter().any(|&self, arg: Node| -> bool { self.eval_cfg(arg) }),
            "not" => {
                if args.len() != 1 {
                    self.error(node, "`not` expects exactly one predicate");
                    return false;
                }
                !self.eval_cfg(args[0])
            },
            _ => {
                self.error(node, "unknown cfg predicate (expected `all`, `any` or `not`)");
                false
            },
        }
    }

    /// Whether the attributes on a statement contain a `#[cfg(...)]` that
    /// excludes the statement.
    fn stmt_cfg_suppresses(self: &mut ParseContext, attrs_node: Node) -> bool {
        let cursor = attrs_node.walk();
        defer cursor.free();
        for attr in attrs_node.children(&cursor) {
            if NODE_KINDS[attr.symbol() as usize] != NodeKind::AttributeItem {
                continue;
            }
            let meta = child_by!(attr, FieldKind::Inner);
            if meta.is_none() {
                continue;
            }
            let name_node = child_by!(meta.unwrap(), FieldKind::Name);
            if name_node.is_some() && self.node_text(name_node.unwrap()) == "cfg"
                && !self.eval_cfg_attribute(meta.unwrap()) {
                return true;
            }
        }
        false
    }

    fn error(self: &mut ParseContext, node: Node, message: &[u8]) {
        self.diag.emit(diagnostics::CodeDiagnostic::generic_error(self.make_span(node), message));
    }

    fn free(self: &mut ParseContext) {
        self.pending_functions.free();
        self.pending_structs.free();
        self.pending_enums.free();
        self.pending_protocols.free();
        self.pending_type_aliases.free();
        self.pending_statics.free();
        self.pending_impls.free();
        self.pending_mixins.free();
        self.pending_macros.free();
        self.macro_defs.free();
        self.macro_name_to_id.free();
        self.macro_args.free();
        self.items.free();
    }
    fn collect_macro_entries(self: &mut ParseContext, ids: &mut Vector<usize>, entries: &mut Vector<MacroEntry>) {
        for pair in self.macro_defs {
            ids.push(pair.0);
            entries.push(pair.1);
        }
    }
}

// ============================================================
// Utility functions
// ============================================================

fn parse_usize(text: &[u8]) -> usize {
    let result: usize = 0;
    for i in 0usize..text.len() {
        let c = text[i];
        if c >= '0' && c <= '9' {
            result = result * 10 + (c - '0') as usize;
        } else if c == '_' {
            // Skip underscores in numeric literals
        } else {
            break;
        }
    }
    result
}

// Returns the full 128-bit value so i128/u128 literals (and
// `0x7fff…ffffu128 as i128` style max_value defs) survive. Callers
// that only care about <2^64 just use the low word (`as u64`).
/// Parse an integer literal: (value as two's complement bits, whether it is
/// negative, type suffix).
fn parse_int_with_suffix(text: &[u8]) -> (u128, bool, Option<BuiltinType>) {
    let value: u128 = 0;
    let base: u128 = 10;
    let i: usize = 0;
    let negative: bool = false;

    // Check for leading negative sign
    if !text.is_empty() && text[0] == '-' {
        negative = true;
        i = 1;
    }

    // Check for hex/octal/binary prefix
    if text.len() >= i + 2 && text[i] == '0' {
        if text[i + 1] == 'x' || text[i + 1] == 'X' {
            base = 16;
            i += 2;
        } else if text[i + 1] == 'o' || text[i + 1] == 'O' {
            base = 8;
            i += 2;
        } else if text[i + 1] == 'b' || text[i + 1] == 'B' {
            base = 2;
            i += 2;
        }
    }

    let suffix_start: usize = text.len();
    while i < text.len() {
        let c = text[i];
        if c == '_' {
            i += 1;
        } else if base == 16 && ((c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')) {
            let digit: u128 = if c >= 'a' { (c - 'a' + 10) as u128 } else { (c - 'A' + 10) as u128 };
            value = value * base + digit;
            i += 1;
        } else if c >= '0' && c <= '9' {
            value = value * base + (c - '0') as u128;
            i += 1;
        } else {
            suffix_start = i;
            break;
        }
    }

    let suffix = if suffix_start < text.len() {
        let suffix_text = text[suffix_start..];
        parse_builtin_type(suffix_text)
    } else {
        Option::none()
    };

    if negative && value != 0 {
        value = ~value + 1;
    }

    (value, negative, suffix)
}

fn parse_float_with_suffix(text: &[u8]) -> (f64, Option<BuiltinType>) {
    // Float literals are decimal-only (grammar), so the number part contains no
    // 'f' — the first 'f' marks the f32/f64 suffix. Parse the numeric part with
    // the stdlib's correctly-rounded, deterministic decimal parser rather than
    // the platform libc's strtod.
    let consumed = std::string::find_char(text, 'f').unwrap_or(text.len());
    let value = std::string::parse_float::<f64>(text[..consumed]).unwrap_or(0.0);

    let suffix = if consumed < text.len() {
        parse_builtin_type(text[consumed..])
    } else {
        Option::none()
    };

    (value, suffix)
}

// Re-parse a float literal directly as f32 to avoid double-rounding: parsing as
// f64 then casting to f32 can land on the wrong f32 (e.g. "7.038531e-26"). The
// stdlib's parse_float<f32> rounds straight to f32. Used at parse time for
// suffixed f32 literals AND at lower time when an unsuffixed literal is
// implicitly cast to f32.
fn parse_float_as_f32(text: &[u8]) -> f32 {
    let consumed = std::string::find_char(text, 'f').unwrap_or(text.len());
    std::string::parse_float::<f32>(text[..consumed]).unwrap_or(0.0f32)
}

fn parse_binop(text: &[u8]) -> BinOp {
    switch text {
        "+" => BinOp::Add,
        "-" => BinOp::Sub,
        "*" => BinOp::Mul,
        "/" => BinOp::Div,
        "%" => BinOp::Rem,
        "&" => BinOp::BitAnd,
        "|" => BinOp::BitOr,
        "^" => BinOp::BitXor,
        "<<" => BinOp::Shl,
        ">>" => BinOp::Shr,
        "==" => BinOp::Eq,
        "!=" => BinOp::Ne,
        "<" => BinOp::Lt,
        "<=" => BinOp::Le,
        ">" => BinOp::Gt,
        ">=" => BinOp::Ge,
        "&&" => BinOp::And,
        "||" => BinOp::Or,
        _ => BinOp::Add,
    }
}

fn parse_assign_op(text: &[u8]) -> AssignOp {
    switch text {
        "+=" => AssignOp::AddAssign,
        "-=" => AssignOp::SubAssign,
        "*=" => AssignOp::MulAssign,
        "/=" => AssignOp::DivAssign,
        "%=" => AssignOp::RemAssign,
        "&=" => AssignOp::BitAndAssign,
        "|=" => AssignOp::BitOrAssign,
        "^=" => AssignOp::BitXorAssign,
        "<<=" => AssignOp::ShlAssign,
        ">>=" => AssignOp::ShrAssign,
        _ => AssignOp::Assign,
    }
}

fn unescape_string(text: &[u8], arena: &mut Arena) -> &[u8] {
    // Count output length first
    let out_len: usize = 0;
    let i: usize = 0;
    while i < text.len() {
        if text[i] == '\\' && i + 1 < text.len() {
            i += 2;
            if text[i - 1] == 'x' && i + 1 < text.len() {
                i += 2;  // \xNN
            }
        } else {
            i += 1;
        }
        out_len += 1;
    }

    let buf = arena.alloc_slice::<u8>(out_len);
    let j: usize = 0;
    i = 0;
    while i < text.len() {
        if text[i] == '\\' && i + 1 < text.len() {
            switch text[i + 1] {
                'n' => { buf[j] = '\n'; },
                'r' => { buf[j] = '\r'; },
                't' => { buf[j] = '\t'; },
                '\\' => { buf[j] = '\\'; },
                '"' => { buf[j] = '"'; },
                '\'' => { buf[j] = '\''; },
                '0' => { buf[j] = 0u8; },
                'x' => {
                    if i + 3 < text.len() {
                        let hi = hex_digit(text[i + 2]);
                        let lo = hex_digit(text[i + 3]);
                        buf[j] = (hi << 4) | lo;
                        i += 2;
                    }
                },
                _ => { buf[j] = text[i + 1]; },
            }
            i += 2;
        } else {
            buf[j] = text[i];
            i += 1;
        }
        j += 1;
    }

    buf[0..j]
}

fn hex_digit(c: u8) -> u8 {
    if c >= '0' && c <= '9' { c - '0' }
    else if c >= 'a' && c <= 'f' { c - 'a' + 10 }
    else if c >= 'A' && c <= 'F' { c - 'A' + 10 }
    else { 0u8 }
}

// ============================================================
// Main entry points for parsing
// ============================================================

// Two-phase parsing: run all Pass1s across all files first to register all names
// in scopes, then run all Pass2s to parse bodies (which may reference any name).
// This fixes cross-module references where file B references a name defined in file A
// but file A hasn't been parsed yet.

fn parse_file_pass1(
    root: Node,
    source: &[u8],
    file_id: u32,
    arena: &mut Arena,
    scopes: &mut ScopeArena,
    id_gen: &mut IdGen,
    diag: &mut DiagnosticContext,
    root_scope: u32,
    cfg: &CfgSet,
) -> ParseContext {
    let ctx = ParseContext::new(arena, scopes, id_gen, diag, source, file_id, cfg);

    // Pass 1: build scopes and register all names
    let pass1 = pass1::Pass1::new(&ctx, root_scope);
    pass1.run(root);

    ctx
}

fn collect_macros(ctx: &mut ParseContext, root: Node) {
    let p2 = pass2::Pass2::new(ctx);
    p2.process_macros(root);
}

fn share_macros(contexts: &mut [ParseContext]) {
    // Collect all macro ids+entries from all contexts
    let all_ids: Vector<usize> = Vector::new();
    let all_entries: Vector<MacroEntry> = Vector::new();
    defer all_ids.free();
    defer all_entries.free();

    // Also collect name->id mappings for fallback
    let all_names: Vector<&[u8]> = Vector::new();
    let all_name_ids: Vector<usize> = Vector::new();
    defer all_names.free();
    defer all_name_ids.free();

    for i in 0usize..contexts.len() {
        contexts[i].collect_macro_entries(&all_ids, &all_entries);
        for pair in contexts[i].macro_name_to_id {
            all_names.push(pair.0);
            all_name_ids.push(pair.1);
        }
    }

    // Inject all macros into every context
    for i in 0usize..contexts.len() {
        for j in 0usize..all_ids.len() {
            if contexts[i].macro_defs.get(&all_ids[j]).is_none() {
                contexts[i].macro_defs.insert(all_ids[j], all_entries[j]);
            }
        }
        for j in 0usize..all_names.len() {
            if contexts[i].macro_name_to_id.get(&all_names[j]).is_none() {
                contexts[i].macro_name_to_id.insert(all_names[j], all_name_ids[j]);
            }
        }
    }
}

fn check_syntax_errors(
    root: Node,
    source: &[u8],
    file_id: u32,
    diag: &mut DiagnosticContext,
) {
    if !root.has_error() {
        return;
    }

    // Pre-order walk using tree-sitter cursor
    let cursor = root.walk();
    defer cursor.free();

    let done = false;
    while !done {
        let node = cursor.node();
        if node.is_error() {
            let text = node.text(source);
            let show = if text.len() > 40usize { text[0usize..40usize] } else { text };
            let span = Span { file_id: file_id, start: node.start_byte() as u32, end: node.end_byte() as u32 };
            diag.emit(diagnostics::CodeDiagnostic::syntax_error(span, show));
        } else if node.is_missing() {
            let span = Span { file_id: file_id, start: node.start_byte() as u32, end: node.end_byte() as u32 };
            diag.emit(diagnostics::CodeDiagnostic::syntax_missing(span, node.kind_name()));
        }

        // Pre-order DFS: try child, then sibling, then uncle
        if cursor.goto_first_child() {
            // descended
        } else if cursor.goto_next_sibling() {
            // moved to sibling
        } else {
            // backtrack until we can go to a sibling
            loop {
                if !cursor.goto_parent() {
                    done = true;
                    break;
                }
                if cursor.goto_next_sibling() {
                    break;
                }
            }
        }
    }
}

fn parse_file_pass2(
    ctx: &mut ParseContext,
    root: Node,
) -> &[Item] {
    // Pass 2: construct AST (all names are now registered across all files)
    let p2 = pass2::Pass2::new(ctx);
    p2.run(root);

    ctx.arena.alloc_slice_copy::<Item>(ctx.items.as_slice())
}

/// After phase 1, link #[lang(builtin_X)] struct scopes to the root scope's
/// BuiltinType entries so that `u8::max_value()` style calls can resolve.
fn link_builtin_lang_items(contexts: &[ParseContext], scopes: &mut ScopeArena, root_scope: u32) {
    for i in 0usize..contexts.len() {
        let ctx = &contexts[i];
        for j in 0usize..ctx.pending_structs.len() {
            let pending = &ctx.pending_structs[j];
            for k in 0usize..pending.attributes.len() {
                let attr = &pending.attributes[k];
                if attr.tag == AttrTag::Lang && attr.str_val().starts_with("builtin_") {
                    // Extract the type name from "builtin_u8" -> "u8"
                    let type_name = attr.str_val()[8..];
                    scopes.set_builtin_scope(root_scope, type_name, pending.scope_idx);
                }
            }
        }
    }
}
