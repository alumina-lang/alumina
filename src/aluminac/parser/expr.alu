// Expression parser
//
// Parses expressions from tree-sitter nodes into AST Expr nodes.
// Also handles macro invocation and expansion.

use parser::*;
use parser::pass1::Pass1;
use parser::pass2::Pass2;

use ast::*;
use ir::*;
use scope::*;
use diagnostics::DiagnosticContext;
use aluminac_common::arena::Arena;
use aluminac_common::node_kinds::{NodeKind, FieldKind, NODE_KINDS, NodeVisitor};
use aluminac_common::common::{child_by, children_by, NodeVisitorExt};
use tree_sitter::{Node, TSFieldId, TSTreeCursor};

use std::collections::{HashMap, Vector};
use std::option::{Option, try};

struct ExprParser {
    ctx: &mut ParseContext,
    scope_idx: u32,
}

struct _AnchorWalk {
    item: scope::NamedItem,
    is_terminal: bool,
}

impl ExprParser {
    fn new(ctx: &mut ParseContext, scope_idx: u32) -> ExprParser {
        ExprParser { ctx: ctx, scope_idx: scope_idx }
    }

    fn make_expr(self: &ExprParser, tag: ExprTag, span: Span) -> Expr {
        let e = Expr::void_expr();
        e.tag = tag;
        e.span = span;
        e
    }

    fn alloc_void(self: &ExprParser, span: Span) -> &Expr {
        let e = Expr::void_expr();
        e.span = span;
        self.ctx.alloc_expr(e)
    }

    fn parse_expr(self: &ExprParser, node: Node) -> &Expr {
        let kind = NODE_KINDS[node.symbol() as usize];
        let span = self.ctx.make_span(node);

        switch kind {
            NodeKind::Block => self.parse_block(node, span),
            NodeKind::IntegerLiteral => self.parse_int_literal(node, span),
            NodeKind::FloatLiteral => self.parse_float_literal(node, span),
            NodeKind::BooleanLiteral => self.parse_bool_literal(node, span),
            NodeKind::StringLiteral => self.parse_string_literal(node, span),
            NodeKind::CharLiteral => self.parse_char_literal(node, span),
            NodeKind::PtrLiteral => {
                let e = self.make_expr(ExprTag::NullLit, span);
                self.ctx.alloc_expr(e)
            },
            NodeKind::Identifier => self.parse_identifier(node, span),
            NodeKind::ScopedIdentifier => self.parse_scoped_identifier(node, span),
            NodeKind::BinaryExpression => self.parse_binary(node, span),
            NodeKind::UnaryExpression => self.parse_unary(node, span),
            NodeKind::AssignmentExpression => self.parse_assignment(node, span),
            NodeKind::CompoundAssignmentExpr => self.parse_compound_assignment(node, span),
            NodeKind::CallExpression => self.parse_call(node, span),
            NodeKind::FieldExpression => self.parse_field(node, span),
            NodeKind::TupleIndexExpression => self.parse_tuple_index(node, span),
            NodeKind::IndexExpression => self.parse_index(node, span),
            NodeKind::ReferenceExpression => self.parse_ref(node, span),
            NodeKind::DereferenceExpression => self.parse_deref(node, span),
            NodeKind::TypeCastExpression => self.parse_cast(node, span),
            NodeKind::TypeCheckExpression => self.parse_type_check(node, span),
            NodeKind::IfExpression => self.parse_if(node, span),
            NodeKind::SwitchExpression => self.parse_switch(node, span),
            NodeKind::WhileExpression => self.parse_while(node, span),
            NodeKind::ForExpression => self.parse_for(node, span),
            NodeKind::LoopExpression => self.parse_loop(node, span),
            NodeKind::BreakExpression => self.parse_break(node, span),
            NodeKind::ContinueExpression => {
                let e = self.make_expr(ExprTag::Continue, span);
                self.ctx.alloc_expr(e)
            },
            NodeKind::ReturnExpression => self.parse_return(node, span),
            NodeKind::YieldExpression => self.parse_yield(node, span),
            NodeKind::LetDeclaration => self.parse_let(node, span),
            NodeKind::StructExpression => self.parse_struct_lit(node, span),
            NodeKind::TupleExpression => self.parse_tuple_lit(node, span),
            NodeKind::ArrayExpression => self.parse_array_lit(node, span),
            NodeKind::LambdaExpression => self.parse_lambda(node, span),
            NodeKind::DeferExpression => self.parse_defer(node, span),
            NodeKind::TryExpression => self.parse_try(node, span),
            NodeKind::RangeExpression => self.parse_range(node, span),
            NodeKind::ParenthesizedExpression => {
                let inner = child_by!(node, FieldKind::Inner);
                if inner.is_some() {
                    return self.parse_expr(inner.unwrap());
                }
                self.alloc_void(span)
            },
            NodeKind::ExpressionStatement => {
                // The grammar gives expression_statement an optional
                // `attributes` field before the `inner` expression.
                // Walking children unconditionally would return the
                // attributes node first (it's named), and aluminac has
                // no expression-level attribute handling — so the actual
                // expression would be silently dropped. Use FieldKind::Inner
                // to skip past the attributes node directly.
                //
                // Also honour `#[cfg(...)]` on expression statements: if
                // the condition is false, drop the statement (return void)
                // so the inner expression isn't lowered. Other expression-
                // level attributes (`#[allow(...)]`, `#[docs(...)]`, etc.)
                // are diagnostics-only and don't affect lowering.
                let attrs_node = child_by!(node, FieldKind::Attributes);
                if attrs_node.is_some() {
                    if self.ctx.stmt_cfg_suppresses(attrs_node.unwrap(), node) {
                        return self.alloc_void(span);
                    }
                }
                let inner = child_by!(node, FieldKind::Inner);
                if inner.is_some() {
                    return self.parse_expr(inner.unwrap());
                }
                self.alloc_void(span)
            },
            NodeKind::Statement => {
                let inner = child_by!(node, FieldKind::Inner);
                if inner.is_some() {
                    return self.parse_expr(inner.unwrap());
                }
                self.alloc_void(span)
            },
            NodeKind::MacroInvocation => self.parse_macro_invocation(node, span),
            NodeKind::UniversalMacroInvocation => self.parse_universal_macro(node, span),
            NodeKind::MacroIdentifier => {
                // $param reference
                let text = self.ctx.node_text(node);
                let name = if !text.is_empty() && text[0] == '$' {
                    self.ctx.intern_str(text[1..])
                } else {
                    self.ctx.intern_str(text)
                };

                // When pre-parsing a macro body, produce ExprTag::MacroParam
                if self.ctx.in_macro_body {
                    // Find param index
                    let param_idx = self.ctx.macro_param_names.iter().find_index(|=name, e: &[u8]| -> bool { e == name });
                    if param_idx.is_some() {
                        let pidx = param_idx.unwrap();
                        let e = self.make_expr(ExprTag::MacroParam, span);
                        e._data.id_ref.str_val = name;
                        e._data.id_ref.int_val = pidx as u64;
                        e._data.id_ref.flag = ((pidx as i32) == self.ctx.macro_variadic_param_idx);
                        return self.ctx.alloc_expr(e);
                    }
                    return self.alloc_void(span);
                }

                // Normal expansion: look up in macro_args
                let arg = self.ctx.macro_args.get(&name);
                if arg.is_some() {
                    return arg.unwrap();
                }
                // Check if this is the variadic param being expanded
                if !self.ctx.macro_variadic_name.is_empty() && name == self.ctx.macro_variadic_name {
                    if self.ctx.macro_et_cetera_idx != NO_VARIADIC {
                        let idx = self.ctx.macro_et_cetera_idx as usize;
                        if idx < self.ctx.macro_variadic_args.len() {
                            return self.ctx.macro_variadic_args[idx];
                        }
                    }
                }
                self.alloc_void(span)
            },
            NodeKind::Turbofish, NodeKind::GenericTypeWithTurbofish => {
                // Turbofish as standalone expression: func::<T> used as a value (e.g. fn pointer)
                self.parse_turbofish_value(node, span)
            },
            NodeKind::StaticForExpression => self.parse_static_for(node, span),
            NodeKind::EtCeteraExpression => self.parse_et_cetera(node, span),
            NodeKind::EmptyStatement => self.alloc_void(span),
            NodeKind::LineComment => self.alloc_void(span),
            NodeKind::BlockComment => self.alloc_void(span),
            NodeKind::DocComment => self.alloc_void(span),
            _ => {
                // For unhandled nodes, try to parse children
                self.alloc_void(span)
            },
        }
    }

    fn parse_block(self: &ExprParser, node: Node, span: Span) -> &Expr {
        // Create a child scope for this block to properly handle variable shadowing.
        // Inner `let` declarations will be in the child scope and won't overwrite
        // outer variables in the parent scope.
        let block_scope = self.ctx.scopes.create_scope(ScopeKind::Block, Option::some(self.scope_idx));
        // The scopes of the block's segments (see below), by the offset of
        // the statement each starts at.
        let segment_scope = block_scope;
        let segments: Vector<(usize, u32)> = Vector::new();
        defer segments.free();

        // Pre-pass: run Pass 1 + Pass 2 on any item definitions (struct, enum,
        // impl, etc.) inside this block so their scopes, names, fields, and methods
        // are fully registered before we parse expressions. Without this, nested
        // structs/impls would never get registered and trait dispatch (e.g. .fmt())
        // would fail.
        {
            // Capture current pending lengths so we can process only newly added items
            let structs_start = self.ctx.pending_structs.len();
            let enums_start = self.ctx.pending_enums.len();
            let protocols_start = self.ctx.pending_protocols.len();
            let mixins_start = self.ctx.pending_mixins.len();
            let functions_start = self.ctx.pending_functions.len();
            let type_aliases_start = self.ctx.pending_type_aliases.len();
            let statics_start = self.ctx.pending_statics.len();
            let macros_start = self.ctx.pending_macros.len();

            let pre_cursor = node.walk();
            defer pre_cursor.free();
            for stmt in children_by!(node, FieldKind::Statements, &pre_cursor) {
                if !stmt.is_named() {
                    continue;
                }
                // statement -> inner: (_declaration_statement | expression_statement)
                // _declaration_statement is hidden, so the inner field points directly
                // to struct_definition, impl_block, etc.
                let inner_opt = child_by!(stmt, FieldKind::Inner);
                if inner_opt.is_none() {
                    continue;
                }
                let inner = inner_opt.unwrap();
                let inner_kind = NODE_KINDS[inner.symbol() as usize];
                if self.ctx.in_macro_body && switch inner_kind {
                    NodeKind::ImplBlock, NodeKind::StructDefinition, NodeKind::EnumDefinition,
                    NodeKind::ProtocolDefinition, NodeKind::TypeDefinition, NodeKind::FunctionDefinition,
                    NodeKind::StaticDeclaration, NodeKind::ConstDeclaration, NodeKind::MacroDefinition => true,
                    _ => false,
                } {
                    // (`use` is fine.)
                    self.ctx.error(inner, "cannot define new items in a macro body (yet)");
                }
                switch inner_kind {
                    // An impl block goes with the type declared before it.
                    NodeKind::ImplBlock => {
                        let pass1 = Pass1::new(self.ctx, segment_scope);
                        pass1.run(inner);
                    },
                    // Items are visible from their declaration on and shadow
                    // earlier items of the same name (as in alumina-boot's
                    // linear block scopes): each starts a new scope that the
                    // rest of the block is parsed in.
                    NodeKind::StructDefinition,
                    NodeKind::EnumDefinition,
                    NodeKind::ProtocolDefinition,
                    NodeKind::TypeDefinition,
                    NodeKind::FunctionDefinition,
                    NodeKind::UseDeclaration,
                    NodeKind::StaticDeclaration,
                    NodeKind::ConstDeclaration,
                    NodeKind::MacroDefinition => {
                        segment_scope = self.ctx.scopes.create_scope(ScopeKind::Block, Option::some(segment_scope));
                        segments.push((stmt.start_byte(), segment_scope));
                        let pass1 = Pass1::new(self.ctx, segment_scope);
                        pass1.run(inner);
                    },
                    _ => {},
                }
            }

            // Now run Pass 2 on any newly added pending items so their fields,
            // methods, variants, etc. are fully built.
            let pass2 = Pass2::new(self.ctx);
            pass2.process_items_from(
                structs_start,
                enums_start,
                protocols_start,
                mixins_start,
                functions_start,
                type_aliases_start,
                statics_start,
            );
            // Inner-block macros also need their bodies pre-parsed before
            // the rest of the block's statements are walked, otherwise their
            // invocations resolve to a name with no body and silently no-op.
            pass2.process_macros_from(macros_start);
        }

        // Two-pass collection: first gather raw statement nodes (filtering
        // cfg-suppressed ones), then decide which one is the block's *value*
        // following alumina-boot's rule (see make_return_expression in
        // src/alumina-boot/src/ast/expressions.rs:240):
        //
        //   - If the last non-suppressed statement is an `expression_statement`
        //     whose inner kind is one of the block-ending expressions
        //     (Block, If, Switch, While, Loop, For, StaticFor) AND has no
        //     trailing `;`, that statement's *expression* is the block's value.
        //   - Otherwise the block's value is `()` (Void).
        //
        // The tree-sitter grammar puts trailing block-ending expressions
        // into the same Statements field as `expr;` statements (see grammar
        // rule expression_statement) — they are distinguished only by the
        // presence of `;`. parse_block previously flattened the whole list
        // and let `mk_block` use the last statement's type, which made
        // `{ memcpy(...); }` get `&mut c_void` instead of `()`.
        let raw_stmts: Vector<Node> = Vector::new();
        defer raw_stmts.free();
        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Statements, &cursor) {
            if !child.is_named() { continue; }
            let inner_opt = child_by!(child, FieldKind::Inner);
            if inner_opt.is_some() {
                let inner_node = inner_opt.unwrap();
                let inner_kind = NODE_KINDS[inner_node.symbol() as usize];
                if inner_kind == NodeKind::ExpressionStatement {
                    let attrs_node = child_by!(inner_node, FieldKind::Attributes);
                    if attrs_node.is_some() && self.ctx.stmt_cfg_suppresses(attrs_node.unwrap(), inner_node) {
                        continue;
                    }
                }
            }
            raw_stmts.push(child);
        }

        let stmts: Vector<&Expr> = Vector::new();
        defer stmts.free();

        // Promote a trailing expression_ending_with_block to the block's
        // result. If found, lower it via parse_expr (which unwraps the
        // expression_statement to its inner expression — the value-producing
        // form). Statements with explicit `;` keep their expression but get
        // a synthesized Void appended at the end so the block's value is `()`.
        let has_result_value = false;
        if !raw_stmts.is_empty() {
            let last = raw_stmts[raw_stmts.len() - 1];
            let last_inner_opt = child_by!(last, FieldKind::Inner);
            if last_inner_opt.is_some() {
                let last_inner = last_inner_opt.unwrap();
                let last_inner_kind = NODE_KINDS[last_inner.symbol() as usize];
                if last_inner_kind == NodeKind::ExpressionStatement {
                    let stmt_inner_opt = child_by!(last_inner, FieldKind::Inner);
                    if stmt_inner_opt.is_some() {
                        let stmt_inner = stmt_inner_opt.unwrap();
                        let stmt_inner_kind = NODE_KINDS[stmt_inner.symbol() as usize];
                        let is_block_ending = stmt_inner_kind == NodeKind::Block
                            || stmt_inner_kind == NodeKind::IfExpression
                            || stmt_inner_kind == NodeKind::SwitchExpression
                            || stmt_inner_kind == NodeKind::WhileExpression
                            || stmt_inner_kind == NodeKind::LoopExpression
                            || stmt_inner_kind == NodeKind::ForExpression
                            || stmt_inner_kind == NodeKind::StaticForExpression;
                        if is_block_ending {
                            // Check that the statement has no trailing `;` —
                            // if it does, the value is still discarded.
                            if last_inner.end_byte() == stmt_inner.end_byte() {
                                has_result_value = true;
                            }
                        }
                    }
                }
            }
        }

        // Each statement is parsed in the scope of the segment it is in.
        let block_parser = ExprParser::new(self.ctx, block_scope);
        let next_segment = 0usize;
        for raw_stmt in raw_stmts.iter() {
            while next_segment < segments.len() && segments[next_segment].0 <= raw_stmt.start_byte() {
                block_parser = ExprParser::new(self.ctx, segments[next_segment].1);
                next_segment += 1;
            }
            let expr = block_parser.parse_expr(raw_stmt);
            stmts.push(expr);
        }
        while next_segment < segments.len() {
            block_parser = ExprParser::new(self.ctx, segments[next_segment].1);
            next_segment += 1;
        }

        // Also handle the FieldKind::Result child, which the tree-sitter
        // grammar uses when a block has a trailing non-`;` expression that
        // isn't a block-ending form (e.g. `{ x + 1 }`). When present, this
        // child is the block's result.
        let result_node = child_by!(node, FieldKind::Result);
        if result_node.is_some() {
            let result = result_node.unwrap();
            let result_kind = NODE_KINDS[result.symbol() as usize];
            let suppressed = false;
            if result_kind == NodeKind::ExpressionStatement {
                let attrs_node = child_by!(result, FieldKind::Attributes);
                if attrs_node.is_some() && self.ctx.stmt_cfg_suppresses(attrs_node.unwrap(), result) {
                    suppressed = true;
                }
            }
            if !suppressed {
                stmts.push(block_parser.parse_expr(result));
                has_result_value = true;
            }
        }

        // If no expression produces a value, the block's value is `()`.
        if !has_result_value {
            stmts.push(self.alloc_void(span));
        }

        let result = self.ctx.arena.alloc_slice_copy::<&Expr>(stmts.as_slice());

        let e = self.make_expr(ExprTag::Block, span);
        e._data.list.args = result;
        self.ctx.alloc_expr(e)
    }

    fn parse_int_literal(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let text = self.ctx.node_text(node);
        let (value, negative, suffix) = parse_int_with_suffix(text);
        let e = self.make_expr(ExprTag::IntLit, span);
        e._data.lit.int_val = value as u64;
        e._data.lit.int_val_hi = (value >> 64) as u64;
        e._data.lit.negative = negative;
        e._data.lit.type_suffix = suffix;
        self.ctx.alloc_expr(e)
    }

    fn parse_float_literal(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let text = self.ctx.node_text(node);
        let (value, suffix) = parse_float_with_suffix(text);
        let e = self.make_expr(ExprTag::FloatLit, span);
        e._data.lit.float_val = value;
        e._data.lit.type_suffix = suffix;
        // Stash the raw text on the lit so lower-time f32 coercion can re-parse
        // via strtof and avoid double-rounding. FloatLit doesn't otherwise use
        // str_val, so the slot is free.
        e._data.lit.str_val = text;
        self.ctx.alloc_expr(e)
    }

    fn parse_bool_literal(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let text = self.ctx.node_text(node);
        let e = self.make_expr(ExprTag::BoolLit, span);
        e._data.lit.bool_val = text == "true";
        self.ctx.alloc_expr(e)
    }

    fn parse_string_literal(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let text = self.ctx.node_text(node);
        // Strip quotes and handle escape sequences
        let content = unescape(text[1..text.len() - 1], self.ctx.arena).unwrap_or_else(|=self, =node| -> &[u8] {
            self.ctx.error(node, "invalid escape sequence");
            ""
        });
        let e = self.make_expr(ExprTag::StringLit, span);
        e._data.lit.str_val = content;
        self.ctx.alloc_expr(e)
    }

    /// A character literal is a `u8` literal (as in alumina-boot): it must
    /// denote exactly one byte.
    fn parse_char_literal(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let text = self.ctx.node_text(node);
        let unescaped = unescape(text[1..text.len() - 1], self.ctx.arena);
        if unescaped.is_none() {
            self.ctx.error(node, "invalid escape sequence");
        }
        let bytes = unescaped.unwrap_or("x");
        if bytes.len() != 1 {
            self.ctx.error(node, "invalid character literal (must be a single byte)");
        }
        let e = self.make_expr(ExprTag::IntLit, span);
        e._data.lit.int_val = if bytes.len() == 1 { bytes[0] as u64 } else { 0 };
        e._data.lit.type_suffix = Option::some(BuiltinType::U8);
        self.ctx.alloc_expr(e)
    }

    fn parse_identifier(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let name = self.ctx.node_text(node);
        let resolved = self.ctx.scopes.resolve(self.scope_idx, name);
        if resolved.is_some() {
            let item = resolved.unwrap();
            if item.kind.tag == scope::NamedItemTag::Local {
                let id = item.kind.id();
                let e = self.make_expr(ExprTag::Local, span);
                e._data.id_ref.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Param {
                let id = item.kind.id();
                let e = self.make_expr(ExprTag::Param, span);
                e._data.id_ref.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Function {
                let id = item.kind.id();
                let e = self.make_expr(ExprTag::FnRef, span);
                e._data.id_ref.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Method {
                let fn_id = item.kind.id2();
                let e = self.make_expr(ExprTag::FnRef, span);
                e._data.id_ref.id = fn_id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Static {
                let id = item.kind.id();
                let e = self.make_expr(ExprTag::StaticRef, span);
                e._data.id_ref.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Const {
                let id = item.kind.id();
                let e = self.make_expr(ExprTag::StaticRef, span);
                e._data.id_ref.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::BoundValue {
                let e = self.make_expr(ExprTag::BoundValue, span);
                e._data.id_ref.id = item.kind.id();       // binding id
                e._data.id_ref.id2 = item.kind.id2();     // self_param id
                e._data.id_ref.str_val = item.name;     // binding name (for field lookup)
                e._data.id_ref.flag = item.kind.scope_idx == BoundType::ByReference as u32;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::EnumVariant {
                let enum_id = item.kind.id();
                let variant_id = item.kind.id2();
                let e = self.make_expr(ExprTag::EnumRef, span);
                e._data.id_ref.id = enum_id;
                e._data.id_ref.id2 = variant_id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Macro {
                // Macro used in expression context (e.g. as argument to bind!)
                let e = self.make_expr(ExprTag::MacroInvocation, span);
                e._data.macro_expr.str_val = self.ctx.intern_str(name);
                e._data.macro_expr.args = &[];
                e._data.macro_expr.macro_id = item.kind.id()._value;
                return self.ctx.alloc_expr(e);
            } else {
                return self.not_a_value(span, name);
            }
        } else {
            // Unresolved at parse time. When parsing a macro body, the
            // reference may bind to a local in the caller's scope —
            // store the source name so expand_macro_expr can re-resolve
            // at the call site (e.g. test_fmt's `macro chk(...) { ... &buf
            // ... }` where `buf` is declared in test_fmt's body, BEFORE
            // the macro definition textually but BEFORE the macro body
            // is pre-parsed in source order).
            if !self.ctx.in_macro_body {
                return self.unresolved_path(span, name);
            }
            let e = self.make_expr(ExprTag::Local, span);
            e._data.id_ref.id = Id { _value: 0 };
            e._data.id_ref.str_val = self.ctx.intern_str(name);
            self.ctx.alloc_expr(e)
        }
    }

    /// Report a path that resolves to nothing (as alumina-boot words it).
    fn unresolved_path(self: &ExprParser, span: Span, path: &[u8]) -> &Expr {
        // (Through an import that does not resolve, which is reported.)
        let first = path[0..std::string::find_char(path, ':').unwrap_or(path.len())];
        let item = self.ctx.scopes.resolve_raw(self.scope_idx, first);
        if item.is_some() && item.unwrap().kind.tag == scope::NamedItemTag::UseAlias
            && self.ctx.scopes.follow_use_alias(item.unwrap()).is_none() {
            return self.alloc_void(span);
        }
        // (In a nested function, it may be a variable of the function around
        // it, which it cannot use.)
        let functions = 0usize;
        let scope = Option::some(self.scope_idx);
        while scope.is_some() {
            if self.ctx.scopes.get(scope.unwrap()).kind == scope::ScopeKind::Function {
                functions += 1;
            }
            scope = self.ctx.scopes.get(scope.unwrap()).parent;
        }
        let message = if functions > 1 && std::string::find_char(path, ':').is_none() {
            std::fmt::format!("could not resolve the path `{}` (a nested function cannot use the variables of the one around it)", path)
        } else {
            std::fmt::format!("could not resolve the path `{}`", path)
        };
        self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(span, message.unwrap().as_slice()));
        self.alloc_void(span)
    }

    /// Report a path to an item that cannot be used as a value (a type,
    /// module, protocol, ...).
    fn not_a_value(self: &ExprParser, span: Span, path: &[u8]) -> &Expr {
        self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(
            span,
            std::fmt::format!("`{}` cannot be used as a value", path).unwrap().as_slice(),
        ));
        self.alloc_void(span)
    }

    // Walk `segments` looking for a TypeAlias / GenericParam anchor that the
    // strict resolve_path can't return (it filters those out). The walk is
    // tolerant of mid-path TypeAliases (`fmt::Result::ok` where `Result` is
    // an alias) and of local-scope GenericParams that share a name with a
    // sibling struct (`Self::equals` inside a protocol where some `#[lang]`
    // struct also named `Self` is visible up the chain). Walks the parent
    // chain at segment 0, descending into modules/struct-scopes only when
    // the match is scope-bearing (Module/Struct/Enum/Protocol/BuiltinType).
    // At each level a GenericParam / TypeAlias entry short-circuits as the
    // anchor when only one trailing method segment remains.
    fn find_typealias_or_generic_anchor(self: &ExprParser, segments: &[&[u8]]) -> Option<scope::NamedItem> {
        if segments.len() < 2 { return Option::none(); }
        let cur_scope = self.scope_idx;
        let parent_chain = true;
        let i: usize = 0;
        loop {
            if i + 1 >= segments.len() { return Option::none(); }
            let anchor = if parent_chain {
                self.find_anchor_in_parent_chain(cur_scope, segments[i])
            } else {
                self.lookup_in_module(cur_scope, segments[i])
            };
            let res = anchor?;
            if res.is_terminal {
                if i + 2 == segments.len() {
                    return Option::some(res.item);
                }
                return Option::none();
            }
            cur_scope = res.item.kind.scope_idx;
            parent_chain = false;
            i += 1;
        }
    }

    fn find_anchor_in_parent_chain(self: &ExprParser, scope_idx: u32, name: &[u8]) -> Option<_AnchorWalk> {
        let cur = scope_idx;
        loop {
            let scope = self.ctx.scopes.get(cur);
            let found = scope.items.get(&name);
            if found.is_some() {
                let res = self.classify_anchor_item(found.unwrap());
                if res.is_some() { return res; }
                // Found something but it's not a usable anchor or descend
                // target at this level (e.g. Method, Local). Keep walking up.
            }
            // Star imports use module-style lookup (no parent walk needed).
            for import_idx in scope.star_imports {
                let imp_found = self.ctx.scopes.get(import_idx).items.get(&name);
                if imp_found.is_some() {
                    let res = self.classify_anchor_item(imp_found.unwrap());
                    if res.is_some() { return res; }
                }
            }
            cur = scope.parent?;
        }
    }

    fn lookup_in_module(self: &ExprParser, scope_idx: u32, name: &[u8]) -> Option<_AnchorWalk> {
        let scope = self.ctx.scopes.get(scope_idx);
        let found = scope.items.get(&name);
        if found.is_some() {
            let r = self.classify_anchor_item(found.unwrap());
            if r.is_some() { return r; }
        }
        for import_idx in scope.star_imports {
            let imp_found = self.ctx.scopes.get(import_idx).items.get(&name);
            if imp_found.is_some() {
                let r = self.classify_anchor_item(imp_found.unwrap());
                if r.is_some() { return r; }
            }
        }
        Option::none()
    }

    fn classify_anchor_item(self: &ExprParser, item_in: scope::NamedItem) -> Option<_AnchorWalk> {
        let item = item_in;
        // Follow use-aliases: `use io::Result;` makes `Result` an alias to
        // the underlying io::Result type alias / struct. Resolving through
        // the use lets us treat it like the target item for descend / anchor
        // classification.
        if item.kind.tag == scope::NamedItemTag::UseAlias {
            let followed = self.ctx.scopes.resolve_path(item.kind.scope_idx, item.kind.path_segments());
            if followed.is_some() {
                item = followed.unwrap();
            } else {
                // resolve_path returns None for TypeAlias targets — retry
                // through resolve_in_module which preserves the terminal
                // TypeAlias / GenericParam.
                let segs = item.kind.path_segments();
                if segs.is_empty() { return Option::none(); }
                let inner = self.lookup_in_chain_through_use(item.kind.scope_idx, segs);
                item = inner?;
            }
        }
        let tag = item.kind.tag;
        if tag == scope::NamedItemTag::GenericParam || tag == scope::NamedItemTag::TypeAlias {
            return Option::some(_AnchorWalk { item: item, is_terminal: true });
        }
        let descendable = (tag == scope::NamedItemTag::Module
            || tag == scope::NamedItemTag::Struct
            || tag == scope::NamedItemTag::Enum
            || tag == scope::NamedItemTag::Protocol
            || tag == scope::NamedItemTag::BuiltinType)
            && item.kind.scope_idx != 0u32;
        if descendable {
            return Option::some(_AnchorWalk { item: item, is_terminal: false });
        }
        Option::none()
    }

    fn lookup_in_chain_through_use(self: &ExprParser, scope_idx: u32, segments: &[&[u8]]) -> Option<scope::NamedItem> {
        // Walk a use-alias's path, descending into module/struct scopes and
        // tolerating TypeAlias / GenericParam at the terminal. Mirrors what
        // resolve_path would do but without filtering out TypeAlias.
        if segments.is_empty() { return Option::none(); }
        let cur_scope = scope_idx;
        let i: usize = 0;
        loop {
            let scope = self.ctx.scopes.get(cur_scope);
            let found = scope.items.get(&segments[i]);
            if found.is_none() {
                // Try star imports
                let imp_found_opt: Option<scope::NamedItem> = Option::none();
                for import_idx in scope.star_imports {
                    let imp_found = self.ctx.scopes.get(import_idx).items.get(&segments[i]);
                    if imp_found.is_some() {
                        imp_found_opt = imp_found;
                        break;
                    }
                }
                if imp_found_opt.is_none() {
                    // Walk parent (only for first segment)
                    if i == 0 && scope.parent.is_some() {
                        cur_scope = scope.parent.unwrap();
                        continue;
                    }
                    return Option::none();
                }
                found = imp_found_opt;
            }
            let item = found.unwrap();
            if i + 1 == segments.len() {
                if item.kind.tag == scope::NamedItemTag::UseAlias {
                    return self.lookup_in_chain_through_use(item.kind.scope_idx, item.kind.path_segments());
                }
                return Option::some(item);
            }
            if item.kind.tag == scope::NamedItemTag::UseAlias {
                let target = self.lookup_in_chain_through_use(item.kind.scope_idx, item.kind.path_segments());
                item = target?;
            }
            // Descend through module/struct/etc only
            let descendable = (item.kind.tag == scope::NamedItemTag::Module
                || item.kind.tag == scope::NamedItemTag::Struct
                || item.kind.tag == scope::NamedItemTag::Enum
                || item.kind.tag == scope::NamedItemTag::Protocol
                || item.kind.tag == scope::NamedItemTag::BuiltinType)
                && item.kind.scope_idx != 0u32;
            if !descendable { return Option::none(); }
            cur_scope = item.kind.scope_idx;
            i += 1;
        }
    }

    fn parse_scoped_identifier(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let pass2 = Pass2 { ctx: self.ctx };
        let segments = pass2.collect_type_path_segments(node);
        let resolved = self.ctx.scopes.resolve_path(self.scope_idx, segments);
        if resolved.is_some() {
            let item = resolved.unwrap();
            if item.kind.tag == scope::NamedItemTag::Function {
                let id = item.kind.id();
                let e = self.make_expr(ExprTag::FnRef, span);
                e._data.id_ref.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Method {
                let fn_id = item.kind.id2();
                let e = self.make_expr(ExprTag::FnRef, span);
                e._data.id_ref.id = fn_id;
                // Carry the impl_scope_idx (set in process_mixins). Mono uses
                // it to look up the mixin's type-args via get_mixin_type_args
                // and bind the protocol's generics (Self + others) for static
                // calls like `f64::nan()` — without a receiver or first arg
                // to infer Self from, the binding source is the path's
                // containing impl scope.
                e._data.id_ref.id2 = Id { _value: item.kind.scope_idx as usize };
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Static {
                let id = item.kind.id();
                let e = self.make_expr(ExprTag::StaticRef, span);
                e._data.id_ref.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Const {
                let id = item.kind.id();
                let e = self.make_expr(ExprTag::StaticRef, span);
                e._data.id_ref.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::EnumVariant {
                let enum_id = item.kind.id();
                let variant_id = item.kind.id2();
                let e = self.make_expr(ExprTag::EnumRef, span);
                e._data.id_ref.id = enum_id;
                e._data.id_ref.id2 = variant_id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Macro {
                // Macro used in expression context (e.g. as argument to bind!)
                let e = self.make_expr(ExprTag::MacroInvocation, span);
                e._data.macro_expr.str_val = item.name;
                e._data.macro_expr.args = &[];
                e._data.macro_expr.macro_id = item.kind.id()._value;
                return self.ctx.alloc_expr(e);
            } else {
                return self.not_a_value(span, self.ctx.node_text(node));
            }
        } else {
            // Resolve through TypeAlias / GenericParam anchors that occur
            // anywhere in the path (not just segment 0). Walk segments one at
            // a time descending into module/struct/enum/protocol scopes; on
            // hitting a TypeAlias / GenericParam mid-path, build a Defered so
            // mono dispatches via lower_defered_call. Without this, paths like
            // `fmt::Result::ok(())` (Result is a type alias) bottom out as
            // "expression is not callable" at the call site.
            if segments.len() >= 2 {
                let anchor_item = self.find_typealias_or_generic_anchor(segments);
                if anchor_item.is_some() {
                    let item = anchor_item.unwrap();
                    let e = self.make_expr(ExprTag::Defered, span);
                    e._data.id_ref.id = item.kind.id();
                    e._data.id_ref.str_val = segments[segments.len() - 1];
                    return self.ctx.alloc_expr(e);
                }
            }
            self.unresolved_path(span, self.ctx.node_text(node))
        }
    }

    fn parse_binary(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let left = child_by!(node, FieldKind::Left);
        let right = child_by!(node, FieldKind::Right);
        let op_node = child_by!(node, FieldKind::Operator);

        if left.is_none() || right.is_none() || op_node.is_none() {
            return self.alloc_void(span);
        }

        let op_text = self.ctx.node_text(op_node.unwrap());
        let op = parse_binop(op_text);

        let lhs = self.parse_expr(left.unwrap());
        let rhs = self.parse_expr(right.unwrap());

        let e = self.make_expr(ExprTag::Binary, span);
        e._data.binary.bin_op = op;
        e._data.binary.lhs = lhs;
        e._data.binary.rhs = rhs;
        self.ctx.alloc_expr(e)
    }

    fn parse_unary(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let operand_node = child_by!(node, FieldKind::Value);
        let op_node = child_by!(node, FieldKind::Operator);

        if operand_node.is_none() || op_node.is_none() {
            return self.alloc_void(span);
        }

        let op_text = self.ctx.node_text(op_node.unwrap());
        let op = if op_text == "-" { UnOp::Neg }
                 else if op_text == "!" { UnOp::Not }
                 else if op_text == "~" { UnOp::BitNot }
                 else { UnOp::Neg };

        let operand = self.parse_expr(operand_node.unwrap());

        let e = self.make_expr(ExprTag::Unary, span);
        e._data.unary.un_op = op;
        e._data.unary.lhs = operand;
        self.ctx.alloc_expr(e)
    }

    fn parse_assignment(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let left = child_by!(node, FieldKind::Left);
        let right = child_by!(node, FieldKind::Right);
        if left.is_none() || right.is_none() {
            return self.alloc_void(span);
        }
        let lhs = self.parse_expr(left.unwrap());
        let rhs = self.parse_expr(right.unwrap());

        let e = self.make_expr(ExprTag::Assign, span);
        e._data.assign.assign_op = AssignOp::Assign;
        e._data.assign.lhs = lhs;
        e._data.assign.rhs = rhs;
        self.ctx.alloc_expr(e)
    }

    fn parse_compound_assignment(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let left = child_by!(node, FieldKind::Left);
        let right = child_by!(node, FieldKind::Right);
        let op_node = child_by!(node, FieldKind::Operator);
        if left.is_none() || right.is_none() || op_node.is_none() {
            return self.alloc_void(span);
        }

        let op_text = self.ctx.node_text(op_node.unwrap());
        let op = parse_assign_op(op_text);

        let lhs = self.parse_expr(left.unwrap());
        let rhs = self.parse_expr(right.unwrap());

        let e = self.make_expr(ExprTag::Assign, span);
        e._data.assign.assign_op = op;
        e._data.assign.lhs = lhs;
        e._data.assign.rhs = rhs;
        self.ctx.alloc_expr(e)
    }

    fn parse_call(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let func = child_by!(node, FieldKind::Function);
        let args_node = child_by!(node, FieldKind::Arguments);

        if func.is_none() {
            return self.alloc_void(span);
        }

        // Check for turbofish calls like zeroed::<T>() or identity::<i32>()
        let func_node = func.unwrap();
        let func_kind = NODE_KINDS[func_node.symbol() as usize];
        if func_kind == NodeKind::Turbofish || func_kind == NodeKind::GenericTypeWithTurbofish {
            let turbofish_result = self.parse_turbofish_call(node, func_node, span);
            if turbofish_result.tag != ExprTag::Void {
                return self.ctx.alloc_expr(turbofish_result);
            }
        }

        // Generic arguments go on the function (`Wrapper::new::<i32>(..)`),
        // not on a type in the path (`Wrapper::<i32>::new(..)`), as in
        // alumina-boot.
        if func_kind == NodeKind::ScopedIdentifier {
            let path_child = child_by!(func_node, FieldKind::Path);
            if path_child.is_some() {
                let path_kind = NODE_KINDS[path_child.unwrap().symbol() as usize];
                if path_kind == NodeKind::GenericTypeWithTurbofish || path_kind == NodeKind::Turbofish
                    || path_kind == NodeKind::GenericType {
                    self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(
                        span,
                        "generic type parameters cannot be used in this context (did you mean to call a function?)",
                    ));
                    return self.alloc_void(span);
                }
            }
        }

        let callee = self.parse_expr(func_node);
        let args = if args_node.is_some() {
            self.parse_arg_list(args_node.unwrap())
        } else {
            let empty: &[&Expr] = &[];
            empty
        };

        let e = self.make_expr(ExprTag::Call, span);
        e._data.call.lhs = callee;
        e._data.call.args = args;
        self.ctx.alloc_expr(e)
    }

    fn parse_turbofish_value(self: &ExprParser, node: Node, span: Span) -> &Expr {
        // Handle func::<T> as a standalone value (function pointer reference)
        // We emit this as a Call expression with 0 args but with type_args set,
        // so that lower_call handles the turbofish resolution.
        let path_node = child_by!(node, FieldKind::Function);
        let path_node2 = if path_node.is_none() { child_by!(node, FieldKind::Type) } else { path_node };
        let type_args_node = child_by!(node, FieldKind::TypeArguments);

        if path_node2.is_none() {
            return self.alloc_void(span);
        }

        // Resolve the function
        let callee = self.parse_expr(path_node2.unwrap());

        // Parse type arguments
        let pass2 = Pass2 { ctx: self.ctx };
        let type_args = if type_args_node.is_some() {
            pass2.parse_type_args(type_args_node.unwrap(), self.scope_idx)
        } else {
            let empty: &[&Ty] = &[];
            empty
        };

        // Use TurbofishValue tag to distinguish from a real Call with 0 args.
        let e = self.make_expr(ExprTag::TurbofishValue, span);
        e._data.call.lhs = callee;
        e._data.call.args = &[];
        e._data.call.type_args = type_args;
        self.ctx.alloc_expr(e)
    }

    fn parse_turbofish_call(self: &ExprParser, call_node: Node, func_node: Node, span: Span) -> Expr {
        // Parse the function path from the turbofish
        let path_node = child_by!(func_node, FieldKind::Function);
        let path_node2 = if path_node.is_none() { child_by!(func_node, FieldKind::Type) } else { path_node };
        let type_args_node = child_by!(func_node, FieldKind::TypeArguments);

        if path_node2.is_none() {
            return Expr::void_expr();
        }

        // Resolve the function
        let callee = self.parse_expr(path_node2.unwrap());

        // Parse type arguments
        let pass2 = Pass2 { ctx: self.ctx };
        let type_args = if type_args_node.is_some() {
            pass2.parse_type_args(type_args_node.unwrap(), self.scope_idx)
        } else {
            let empty: &[&Ty] = &[];
            empty
        };

        // Parse call arguments from the outer call node
        let args_node = child_by!(call_node, FieldKind::Arguments);
        let args = if args_node.is_some() {
            self.parse_arg_list(args_node.unwrap())
        } else {
            let empty: &[&Expr] = &[];
            empty
        };

        let e = self.make_expr(ExprTag::Call, span);
        e._data.call.lhs = callee;
        e._data.call.args = args;
        e._data.call.type_args = type_args;
        e
    }

    fn parse_arg_list(self: &ExprParser, node: Node) -> &[&Expr] {
        let args: Vector<&Expr> = Vector::new();
        defer args.free();

        let cursor = node.walk();
        defer cursor.free();
        for child in node.children(&cursor) {
            if child.is_named() {
                let kind = NODE_KINDS[child.symbol() as usize];
                if kind != NodeKind::LineComment && kind != NodeKind::BlockComment {
                    args.push(self.parse_expr(child));
                }
            }
        }

        self.ctx.arena.alloc_slice_copy::<&Expr>(args.as_slice())
    }

    fn parse_field(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let obj = child_by!(node, FieldKind::Value);
        let field = child_by!(node, FieldKind::Field);
        if obj.is_none() || field.is_none() {
            return self.alloc_void(span);
        }

        // Check if the field child is a tuple_index_expression (e.g. t.0 or t.(expr))
        let field_node = field.unwrap();
        let field_kind = NODE_KINDS[field_node.symbol() as usize];
        if field_kind == NodeKind::TupleIndexExpression {
            let obj_expr = self.parse_expr(obj.unwrap());
            // TupleIndexExpression has a single "field" child containing the index
            let idx_node = child_by!(field_node, FieldKind::Field);
            if idx_node.is_some() {
                let idx_inner = idx_node.unwrap();
                let idx_kind = NODE_KINDS[idx_inner.symbol() as usize];
                if idx_kind == NodeKind::IntegerLiteral {
                    // Simple literal index: t.0, t.1, etc.
                    let idx = parse_usize(self.ctx.node_text(idx_inner));
                    let e = self.make_expr(ExprTag::TupleIndex, span);
                    e._data.index.lhs = obj_expr;
                    e._data.index.index_val = idx;
                    return self.ctx.alloc_expr(e);
                }
                // Expression index: t.(expr) - parse and const-eval later
                let idx_expr = self.parse_expr(idx_inner);
                let e = self.make_expr(ExprTag::TupleIndex, span);
                e._data.index.lhs = obj_expr;
                e._data.index.opt_expr = Option::some(idx_expr);
                return self.ctx.alloc_expr(e);
            }
            // Fallback: try parsing the whole text as a number
            let idx = parse_usize(self.ctx.node_text(field_node));
            let e = self.make_expr(ExprTag::TupleIndex, span);
            e._data.index.lhs = obj_expr;
            e._data.index.index_val = idx;
            return self.ctx.alloc_expr(e);
        }

        let obj_expr = self.parse_expr(obj.unwrap());
        let field_name = self.ctx.intern_str(self.ctx.node_text(field_node));

        let e = self.make_expr(ExprTag::FieldAccess, span);
        e._data.field.lhs = obj_expr;
        e._data.field.str_val = field_name;

        // UFCS hint: try to resolve field_name as a free function in scope.
        // If found, store its ID+1 in id2 so mono can try UFCS fallback.
        // We store id+1 because id=0 is valid; id2._value==0 means "no hint".
        //
        // Previously gated under !in_macro_body, which suppressed macro
        // hygiene's ability to bind `use`-introduced names: a body like
        // `macro foo($a) { use std::fmt::debug; $a.debug() }` would parse
        // the `.debug()` without a UFCS hint and fail at mono time. Allow
        // the hint inside macro bodies too — names introduced by uses
        // inside the body resolve at definition time, which matches user
        // intent for macros that pull in helpers. The hygiene caveat is
        // that the hint pre-binds to whatever was in scope at definition,
        // not the expansion site.
        // Walk the scope chain looking specifically for a free FUNCTION named
        // `field_name`. Plain `scopes.resolve` returns the first match — which
        // for a name like `find` inside `impl SplitIterator { fn next() { … } }`
        // is the mixin'd `IteratorExt::find` (now Method-tagged per pass2's
        // mixin registration), shadowing the local module's free fn. The UFCS
        // hint should only fire for honest free functions, so skip past any
        // non-Function and keep walking up.
        let fn_item = self.ctx.scopes.resolve_function_for_ufcs(self.scope_idx, field_name);
        if fn_item.is_some() {
            e._data.field.id2 = Id { _value: fn_item.unwrap()._value + 1usize };
        }

        self.ctx.alloc_expr(e)
    }

    fn parse_tuple_index(self: &ExprParser, node: Node, span: Span) -> &Expr {
        // TupleIndexExpression as top-level (shouldn't normally happen,
        // as it's typically inside FieldExpression, but handle gracefully)
        let field = child_by!(node, FieldKind::Field);
        if field.is_some() {
            return self.parse_expr(field.unwrap());
        }
        self.alloc_void(span)
    }

    fn parse_index(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let obj = child_by!(node, FieldKind::Value);
        let index = child_by!(node, FieldKind::Index);
        if obj.is_none() || index.is_none() {
            return self.alloc_void(span);
        }
        let obj_expr = self.parse_expr(obj.unwrap());
        let idx_expr = self.parse_expr(index.unwrap());

        let e = self.make_expr(ExprTag::Index, span);
        e._data.index.lhs = obj_expr;
        e._data.index.rhs = idx_expr;
        self.ctx.alloc_expr(e)
    }

    fn parse_ref(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let inner = child_by!(node, FieldKind::Value);
        let is_mut = child_by!(node, FieldKind::Mut).is_some();
        if inner.is_none() {
            return self.alloc_void(span);
        }

        let e = self.make_expr(ExprTag::Ref, span);
        e._data.typed.lhs = self.parse_expr(inner.unwrap());
        e._data.typed.flag = is_mut;
        self.ctx.alloc_expr(e)
    }

    fn parse_deref(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let inner = child_by!(node, FieldKind::Value);
        if inner.is_none() {
            return self.alloc_void(span);
        }

        let e = self.make_expr(ExprTag::Deref, span);
        e._data.typed.lhs = self.parse_expr(inner.unwrap());
        self.ctx.alloc_expr(e)
    }

    fn parse_cast(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let value = child_by!(node, FieldKind::Value);
        let type_node = child_by!(node, FieldKind::Type);
        if value.is_none() || type_node.is_none() {
            return self.alloc_void(span);
        }

        let pass2 = Pass2 { ctx: self.ctx };
        let ty = pass2.parse_type(type_node.unwrap(), self.scope_idx);

        let e = self.make_expr(ExprTag::Cast, span);
        e._data.typed.lhs = self.parse_expr(value.unwrap());
        e._data.typed.ty = ty;
        self.ctx.alloc_expr(e)
    }

    fn parse_type_check(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let value = child_by!(node, FieldKind::Value);
        let type_node = child_by!(node, FieldKind::Type);
        if value.is_none() || type_node.is_none() {
            return self.alloc_void(span);
        }

        let pass2 = Pass2 { ctx: self.ctx };
        let ty = pass2.parse_type(type_node.unwrap(), self.scope_idx);

        let e = self.make_expr(ExprTag::TypeCheck, span);
        e._data.typed.lhs = self.parse_expr(value.unwrap());
        e._data.typed.ty = ty;
        self.ctx.alloc_expr(e)
    }

    fn parse_if(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let cond = child_by!(node, FieldKind::Condition);
        let then_node = child_by!(node, FieldKind::Consequence);
        let else_node = child_by!(node, FieldKind::Alternative);

        if cond.is_none() || then_node.is_none() {
            return self.alloc_void(span);
        }

        let cond_expr = self.parse_expr(cond.unwrap());
        let then_expr = self.parse_expr(then_node.unwrap());
        let else_expr: Option<&Expr> = if else_node.is_some() {
            // Else clause wraps its content
            let inner = child_by!(else_node.unwrap(), FieldKind::Inner);
            if inner.is_some() {
                Option::some(self.parse_expr(inner.unwrap()))
            } else {
                // Direct else body
                Option::some(self.parse_expr(else_node.unwrap()))
            }
        } else {
            Option::none()
        };

        // Check if this is "when" (static if) vs "if"
        let kind_node = child_by!(node, FieldKind::Kind);
        let is_when = if kind_node.is_some() {
            self.ctx.node_text(kind_node.unwrap()) == "when"
        } else {
            false
        };

        let tag = if is_when { ExprTag::When } else { ExprTag::If };
        let e = self.make_expr(tag, span);
        e._data.cond.cond = cond_expr;
        e._data.cond.lhs = then_expr;
        e._data.cond.opt_expr = else_expr;
        self.ctx.alloc_expr(e)
    }

    fn parse_switch(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let value = child_by!(node, FieldKind::Value);
        if value.is_none() {
            return self.alloc_void(span);
        }

        let value_expr = self.parse_expr(value.unwrap());
        let arms: Vector<SwitchArm> = Vector::new();
        defer arms.free();

        let body = child_by!(node, FieldKind::Body);
        if body.is_some() {
            let body_node = body.unwrap();
            let cursor = body_node.walk();
            defer cursor.free();
            let has_default = false;
            for child in children_by!(body_node, FieldKind::Arm, &cursor) {
                let kind = NODE_KINDS[child.symbol() as usize];
                if kind == NodeKind::SwitchArm {
                    if has_default {
                        self.ctx.error(child, "default case must be last in a switch expression");
                    }
                    let pattern_node = child_by!(child, FieldKind::Pattern);
                    let body_node = child_by!(child, FieldKind::Value);

                    let patterns: Vector<&Expr> = Vector::new();
                    #[allow(defer_in_a_loop)]
                    defer patterns.free();

                    if pattern_node.is_some() {
                        let pat_node = pattern_node.unwrap();
                        // Check for wildcard/default pattern "_"
                        let pat_text = self.ctx.node_text(pat_node);
                        let is_wildcard = pat_text.len() == 1 && pat_text[0] == '_';
                        has_default = has_default || is_wildcard;
                        if !is_wildcard {
                            // Parse pattern values
                            let cursor2 = pat_node.walk();
                            #[allow(defer_in_a_loop)]
                            defer cursor2.free();
                            for pat_child in pat_node.children(&cursor2) {
                                if pat_child.is_named() {
                                    patterns.push(self.parse_expr(pat_child));
                                }
                            }
                            // If pattern node itself is a value
                            if patterns.is_empty() {
                                patterns.push(self.parse_expr(pat_node));
                            }
                        }
                    }

                    let body_expr = if body_node.is_some() {
                        self.parse_expr(body_node.unwrap())
                    } else {
                        self.alloc_void(Span::empty())
                    };

                    arms.push(SwitchArm {
                        pattern: self.ctx.arena.alloc_slice_copy::<&Expr>(patterns.as_slice()),
                        body: body_expr,
                    });
                }
            }
        }

        let e = self.make_expr(ExprTag::Switch, span);
        e._data.switch_expr.lhs = value_expr;
        e._data.switch_expr.switch_arms = self.ctx.arena.alloc_slice_copy::<SwitchArm>(arms.as_slice());
        self.ctx.alloc_expr(e)
    }

    fn parse_while(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let cond = child_by!(node, FieldKind::Condition);
        let body = child_by!(node, FieldKind::Body);
        if cond.is_none() || body.is_none() {
            return self.alloc_void(span);
        }

        let e = self.make_expr(ExprTag::While, span);
        e._data.loop_expr.cond = self.parse_expr(cond.unwrap());
        e._data.loop_expr.lhs = self.parse_expr(body.unwrap());
        self.ctx.alloc_expr(e)
    }

    fn parse_for(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let name_node = child_by!(node, FieldKind::Name);
        let iter_node = child_by!(node, FieldKind::Value);
        let body = child_by!(node, FieldKind::Body);

        if iter_node.is_none() || body.is_none() {
            return self.alloc_void(span);
        }

        // Create a child scope for the loop so the loop variable doesn't pollute the parent scope
        let loop_scope = self.ctx.scopes.create_scope(ScopeKind::Block, Option::some(self.scope_idx));
        let loop_parser = ExprParser::new(self.ctx, loop_scope);

        let e = self.make_expr(ExprTag::For, span);

        if name_node.is_some() {
            // Simple case: for item in iterable { body }
            let name_node_val = name_node.unwrap();
            let var_id = self.ctx.next_id();
            let var_name = self.ctx.intern_str(self.ctx.node_text(name_node_val));

            self.ctx.scopes.add_item(loop_scope, NamedItem {
                name: var_name,
                kind: NamedItemKind::local(var_id),
                span: self.ctx.make_span(name_node_val),
            });

            e._data.for_expr.id = var_id;
            e._data.for_expr.args = &[];
        } else {
            // Tuple unpacking: for (a, b, ...) in iterable { body }
            // Collect element names from tree-sitter Element children
            let cursor = node.walk();
            defer cursor.free();

            let elem_exprs: Vector<&Expr> = Vector::new();
            defer elem_exprs.free();
            for elem_node in children_by!(node, FieldKind::Element, &cursor) {
                let elem_id = self.ctx.next_id();
                let elem_name = self.ctx.intern_str(self.ctx.node_text(elem_node));

                self.ctx.scopes.add_item(loop_scope, NamedItem {
                    name: elem_name,
                    kind: NamedItemKind::local(elem_id),
                    span: self.ctx.make_span(elem_node),
                });

                // Store element ID and name in an ExprTag::Local node
                let elem_expr = self.make_expr(ExprTag::Local, self.ctx.make_span(elem_node));
                elem_expr._data.id_ref.id = elem_id;
                elem_expr._data.id_ref.str_val = elem_name;
                elem_exprs.push(self.ctx.alloc_expr(elem_expr));
            }

            // Use a hidden temporary for the whole tuple value
            let var_id = self.ctx.next_id();
            e._data.for_expr.id = var_id;
            e._data.for_expr.args = self.ctx.arena.alloc_slice_copy::<&Expr>(elem_exprs.as_slice());
        }

        e._data.for_expr.lhs = self.parse_expr(iter_node.unwrap()); // iter parsed in parent scope
        e._data.for_expr.rhs = loop_parser.parse_expr(body.unwrap()); // body parsed in child scope
        self.ctx.alloc_expr(e)
    }

    fn parse_loop(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let body = child_by!(node, FieldKind::Body);
        if body.is_none() {
            return self.alloc_void(span);
        }

        let e = self.make_expr(ExprTag::Loop, span);
        e._data.loop_expr.lhs = self.parse_expr(body.unwrap());
        self.ctx.alloc_expr(e)
    }

    fn parse_break(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let value = child_by!(node, FieldKind::Inner);
        let e = self.make_expr(ExprTag::Break, span);
        if value.is_some() {
            e._data.jump.opt_expr = Option::some(self.parse_expr(value.unwrap()));
        }
        self.ctx.alloc_expr(e)
    }

    fn parse_return(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let value = child_by!(node, FieldKind::Inner);
        let e = self.make_expr(ExprTag::Return, span);
        if value.is_some() {
            e._data.jump.opt_expr = Option::some(self.parse_expr(value.unwrap()));
        }
        self.ctx.alloc_expr(e)
    }

    fn parse_yield(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let value = child_by!(node, FieldKind::Inner);
        let e = self.make_expr(ExprTag::Yield, span);
        if value.is_some() {
            e._data.jump.opt_expr = Option::some(self.parse_expr(value.unwrap()));
        }
        self.ctx.alloc_expr(e)
    }

    fn parse_let(self: &ExprParser, node: Node, span: Span) -> &Expr {
        // Honour `#[cfg(...)]` on let declarations: if the condition is false,
        // drop the let entirely (no scope binding, no initializer side-effect).
        // Without this, two cfg-paired `let x = ...` lines (the readdir /
        // readdir64 split in `std/fs/unix.alu`) both parse, both run, and the
        // second shadows the first — silently consuming directory entries.
        let attrs_node = child_by!(node, FieldKind::Attributes);
        if attrs_node.is_some() && self.ctx.stmt_cfg_suppresses(attrs_node.unwrap(), node) {
            return self.alloc_void(span);
        }

        let name_node = child_by!(node, FieldKind::Name);
        let type_node = child_by!(node, FieldKind::Type);
        let value_node = child_by!(node, FieldKind::Value);

        if name_node.is_some() {
            // Simple let: let x = expr;
            let name_node_val = name_node.unwrap();
            let var_id = self.ctx.next_id();
            let var_name = self.ctx.intern_str(self.ctx.node_text(name_node_val));

            let pass2 = Pass2 { ctx: self.ctx };
            let ty: Option<&Ty> = if type_node.is_some() {
                Option::some(pass2.parse_type(type_node.unwrap(), self.scope_idx))
            } else {
                Option::none()
            };

            let init: Option<&Expr> = if value_node.is_some() {
                Option::some(self.parse_expr(value_node.unwrap()))
            } else {
                Option::none()
            };

            // Register in scope AFTER parsing the initializer
            // This ensures the initializer can reference shadowed variables
            // (e.g., `let x = x.method()` where x in the initializer refers
            // to the previously defined x, not the one being defined)
            self.ctx.scopes.add_item(self.scope_idx, NamedItem {
                name: var_name,
                kind: NamedItemKind::local(var_id),
                span: self.ctx.make_span(name_node_val),
            });

            let e = self.make_expr(ExprTag::Let, span);
            e._data.let_expr.id = var_id;
            e._data.let_expr.str_val = var_name;
            e._data.let_expr.opt_ty = ty;
            e._data.let_expr.opt_expr = init;
            return self.ctx.alloc_expr(e);
        }

        // Tuple destructuring: let (a, b) = expr;
        let elements: Vector<Node> = Vector::new();
        defer elements.free();
        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Element, &cursor) {
            elements.push(child);
        }

        if elements.is_empty() {
            return self.alloc_void(span);
        }
        let pass2 = Pass2 { ctx: self.ctx };
        let ty: Option<&Ty> = type_node.map(|&pass2, &self, n: Node| -> &Ty { pass2.parse_type(n, self.scope_idx) });
        if value_node.is_none() && ty.is_none() {
            self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(span, "type hint required"));
            return self.alloc_void(span);
        }

        // Desugar `let (a, b): T = expr;` into
        //     { let _tmp: T = expr; let a = _tmp.0; let b = _tmp.1; }
        // and `let (a, b): T;` into `{ let a: T.0; let b: T.1; }`.
        let stmts: Vector<&Expr> = Vector::new();
        defer stmts.free();
        let tmp_id = self.ctx.next_id();
        if value_node.is_some() {
            let tmp_let = self.make_expr(ExprTag::Let, span);
            tmp_let._data.let_expr.id = tmp_id;
            tmp_let._data.let_expr.opt_ty = ty;
            tmp_let._data.let_expr.opt_expr = Option::some(self.parse_expr(value_node.unwrap()));
            stmts.push(self.ctx.alloc_expr(tmp_let));
        }

        for (i, elem_node) in elements.iter().enumerate() {
            let elem_name = self.ctx.intern_str(self.ctx.node_text(elem_node));
            let elem_id = self.ctx.next_id();
            let elem_let = self.make_expr(ExprTag::Let, span);
            elem_let._data.let_expr.id = elem_id;
            elem_let._data.let_expr.str_val = elem_name;
            if value_node.is_some() {
                // _tmp.i
                let tmp_ref = self.make_expr(ExprTag::Local, span);
                tmp_ref._data.id_ref.id = tmp_id;
                let idx_expr = self.make_expr(ExprTag::TupleIndex, span);
                idx_expr._data.index.lhs = self.ctx.alloc_expr(tmp_ref);
                idx_expr._data.index.index_val = i;
                elem_let._data.let_expr.opt_expr = Option::some(self.ctx.alloc_expr(idx_expr));
            } else {
                // T.i
                let index = self.make_expr(ExprTag::IntLit, span);
                index._data.lit.int_val = i as u64;
                elem_let._data.let_expr.opt_ty = Option::some(
                    self.ctx.alloc_ty(Ty::tuple_index_of_ty(ty.unwrap(), self.ctx.alloc_expr(index))));
            }
            stmts.push(self.ctx.alloc_expr(elem_let));

            self.ctx.scopes.add_item(self.scope_idx, NamedItem {
                name: elem_name,
                kind: NamedItemKind::local(elem_id),
                span: self.ctx.make_span(elem_node),
            });
        }

        let block = self.make_expr(ExprTag::Block, span);
        block._data.list.args = self.ctx.arena.alloc_slice_copy::<&Expr>(stmts.as_slice());
        self.ctx.alloc_expr(block)
    }

    fn parse_struct_lit(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let type_node = child_by!(node, FieldKind::Name);
        let init_node = child_by!(node, FieldKind::Arguments);

        if type_node.is_none() {
            return self.alloc_void(span);
        }

        let pass2 = Pass2 { ctx: self.ctx };
        let ty = pass2.parse_type(type_node.unwrap(), self.scope_idx);

        let fields: Vector<FieldInit> = Vector::new();
        defer fields.free();

        if init_node.is_some() {
            let init = init_node.unwrap();
            let cursor = init.walk();
            defer cursor.free();
            for child in init.children(&cursor) {
                let kind = NODE_KINDS[child.symbol() as usize];
                if kind == NodeKind::StructInitializerItem {
                    let name_node = child_by!(child, FieldKind::Field);
                    let value_node = child_by!(child, FieldKind::Value);
                    if name_node.is_some() && value_node.is_some() {
                        let name = self.ctx.intern_str(self.ctx.node_text(name_node.unwrap()));
                        if fields.iter().any(|=name, f: FieldInit| -> bool { f.name == name }) {
                            self.ctx.error(child, std::fmt::format!("duplicate field `{}` in struct initializer", name).unwrap().as_slice());
                        }
                        fields.push(FieldInit {
                            name: name,
                            value: self.parse_expr(value_node.unwrap()),
                        });
                    }
                }
            }
        }

        let e = self.make_expr(ExprTag::StructLit, span);
        e._data.struct_lit.ty = ty;
        e._data.struct_lit.field_inits = self.ctx.arena.alloc_slice_copy::<FieldInit>(fields.as_slice());
        self.ctx.alloc_expr(e)
    }

    fn parse_tuple_lit(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let elems: Vector<&Expr> = Vector::new();
        defer elems.free();

        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Element, &cursor) {
            elems.push(self.parse_expr(child));
        }

        let e = self.make_expr(ExprTag::TupleLit, span);
        e._data.list.args = self.ctx.arena.alloc_slice_copy::<&Expr>(elems.as_slice());
        self.ctx.alloc_expr(e)
    }

    fn parse_array_lit(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let elems: Vector<&Expr> = Vector::new();
        defer elems.free();

        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Element, &cursor) {
            elems.push(self.parse_expr(child));
        }

        let e = self.make_expr(ExprTag::ArrayLit, span);
        e._data.list.args = self.ctx.arena.alloc_slice_copy::<&Expr>(elems.as_slice());
        self.ctx.alloc_expr(e)
    }

    fn parse_lambda(self: &ExprParser, node: Node, span: Span) -> &Expr {
        if self.ctx.in_macro_body {
            self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(span,
                "anonymous functions are not supported in a macro body (yet)"));
            return self.alloc_void(span);
        }
        let params_node = child_by!(node, FieldKind::Parameters);
        let body_node = child_by!(node, FieldKind::Body);

        if body_node.is_none() {
            return self.alloc_void(span);
        }

        // Create a child scope for the lambda (captures and params live here)
        let lambda_scope = self.ctx.scopes.create_scope(scope::ScopeKind::Block, Option::some(self.scope_idx));

        let params: Vector<LambdaParam> = Vector::new();
        defer params.free();

        let bindings: Vector<ClosureBinding> = Vector::new();
        defer bindings.free();

        // Generate a self_param id for closure struct access (only used if there are captures)
        let self_param_id = self.ctx.next_id();

        if params_node.is_some() {
            let params_n = params_node.unwrap();
            let cursor = params_n.walk();
            defer cursor.free();
            let pass2 = Pass2 { ctx: self.ctx };
            for child in params_n.children(&cursor) {
                if child.is_named() {
                    let kind = NODE_KINDS[child.symbol() as usize];
                    let id = self.ctx.next_id();

                    if kind == NodeKind::BoundIdentifier {
                        // Closure capture: =name (by value) or &name (by reference)
                        let name_node = child_by!(child, FieldKind::Name);
                        let name = self.ctx.intern_str(self.ctx.node_text(name_node.unwrap()));

                        let by_ref_node = child_by!(child, FieldKind::ByReference);
                        let bound_type = if by_ref_node.is_some() {
                            BoundType::ByReference
                        } else {
                            BoundType::ByValue
                        };

                        // Resolve the original variable in the parent scope (self.scope_idx)
                        let value_expr: &Expr = {
                            let resolved = self.ctx.scopes.resolve(self.scope_idx, name);
                            if resolved.is_some() {
                                let item = resolved.unwrap();
                                if item.kind.tag == scope::NamedItemTag::Local {
                                    let ve = self.make_expr(ExprTag::Local, span);
                                    ve._data.id_ref.id = item.kind.id();
                                    self.ctx.alloc_expr(ve)
                                } else if item.kind.tag == scope::NamedItemTag::Param {
                                    let ve = self.make_expr(ExprTag::Param, span);
                                    ve._data.id_ref.id = item.kind.id();
                                    self.ctx.alloc_expr(ve)
                                } else if item.kind.tag == scope::NamedItemTag::BoundValue {
                                    // Nested closure: capture from enclosing closure
                                    let ve = self.make_expr(ExprTag::BoundValue, span);
                                    ve._data.id_ref.id = item.kind.id();
                                    ve._data.id_ref.id2 = item.kind.id2();
                                    ve._data.id_ref.str_val = item.name;
                                    ve._data.id_ref.flag = item.kind.scope_idx == BoundType::ByReference as u32;
                                    self.ctx.alloc_expr(ve)
                                } else {
                                    self.ctx.error(child, "can only bind local variables");
                                    self.alloc_void(span)
                                }
                            } else {
                                self.ctx.error(child, std::fmt::format!("could not resolve the path `{}`", name).unwrap().as_slice());
                                self.alloc_void(span)
                            }
                        };

                        // Register the bound value in the lambda scope
                        self.ctx.scopes.add_item(lambda_scope, NamedItem {
                            name: name,
                            kind: NamedItemKind::bound_value(id, self_param_id, bound_type),
                            span: self.ctx.make_span(child),
                        });

                        bindings.push(ClosureBinding {
                            id: id,
                            name: name,
                            value: value_expr,
                            bound_type: bound_type,
                        });
                    } else {
                        // Regular parameter
                        let name: &[u8] = "";
                        let ty: Option<&Ty> = Option::none();

                        if kind == NodeKind::Parameter {
                            let name_node = child_by!(child, FieldKind::Name);
                            let type_node = child_by!(child, FieldKind::Type);
                            if name_node.is_some() {
                                name = self.ctx.intern_str(self.ctx.node_text(name_node.unwrap()));
                            }
                            if type_node.is_some() {
                                ty = Option::some(pass2.parse_type(type_node.unwrap(), lambda_scope));
                            }
                        } else {
                            name = self.ctx.intern_str(self.ctx.node_text(child));
                        }

                        // Register lambda param in the lambda scope
                        self.ctx.scopes.add_item(lambda_scope, NamedItem {
                            name: name,
                            kind: NamedItemKind::local(id),
                            span: self.ctx.make_span(child),
                        });

                        params.push(LambdaParam {
                            id: id,
                            name: name,
                            ty: ty,
                        });
                    }
                }
            }
        }

        let pass2 = Pass2 { ctx: self.ctx };
        let ret_node = child_by!(node, FieldKind::ReturnType);
        let ret_ty: Option<&Ty> = if ret_node.is_some() {
            Option::some(pass2.parse_type(ret_node.unwrap(), lambda_scope))
        } else {
            Option::none()
        };

        // Parse body in the lambda scope
        let lambda_parser = ExprParser::new(self.ctx, lambda_scope);
        let body = lambda_parser.parse_expr(body_node.unwrap());

        let e = self.make_expr(ExprTag::Lambda, span);
        e._data.lambda.lambda_params = self.ctx.arena.alloc_slice_copy::<LambdaParam>(params.as_slice());
        e._data.lambda.closure_bindings = self.ctx.arena.alloc_slice_copy::<ClosureBinding>(bindings.as_slice());
        e._data.lambda.opt_ty = ret_ty;
        e._data.lambda.lhs = body;
        // Store the self_param_id for use in mono
        e._data.lambda.id = self_param_id;
        self.ctx.alloc_expr(e)
    }

    fn parse_defer(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let inner = child_by!(node, FieldKind::Inner);
        if inner.is_none() {
            return self.alloc_void(span);
        }

        let e = self.make_expr(ExprTag::Defer, span);
        e._data.defer.lhs = self.parse_expr(inner.unwrap());
        self.ctx.alloc_expr(e)
    }

    fn parse_try(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let inner = child_by!(node, FieldKind::Inner);
        if inner.is_none() {
            return self.alloc_void(span);
        }

        let inner_expr = self.parse_expr(inner.unwrap());

        // Desugar expr? to try!(expr) macro invocation, matching alumina-boot.
        // Look up the "try" macro via scope resolution (respects use aliases and shadowing).
        let name = self.ctx.intern_str("try");
        // In a macro body, record the invocation (resolved here, at the
        // definition site) to be expanded with the macro.
        if self.ctx.in_macro_body {
            let resolved = self.ctx.scopes.resolve(self.scope_idx, name);
            if resolved.is_none() || resolved.unwrap().kind.tag != scope::NamedItemTag::Macro {
                self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(span, "no `try` macro in scope for `?` operator (import std::result::try or std::option::try)"));
                return self.alloc_void(span);
            }
            let try_args = self.ctx.arena.alloc_slice::<&Expr>(1usize);
            try_args[0] = inner_expr;
            let e = self.make_expr(ExprTag::MacroInvocation, span);
            e._data.macro_expr.macro_id = resolved.unwrap().kind.id()._value;
            e._data.macro_expr.str_val = name;
            e._data.macro_expr.args = try_args;
            e._data.macro_expr.flag = true;
            return self.ctx.alloc_expr(e);
        }
        let macro_entry = self.ctx.resolve_macro(self.scope_idx, name);
        if macro_entry.is_some() {
            let entry = macro_entry.unwrap();

            let try_args = self.ctx.arena.alloc_slice::<&Expr>(1usize);
            try_args[0] = inner_expr;
            return self.do_expand_macro(entry, try_args, span);
        }

        // No try macro found - emit error
        self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(span, "no `try` macro in scope for `?` operator (import std::result::try or std::option::try)"));
        self.alloc_void(span)
    }

    fn parse_range(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let lower = child_by!(node, FieldKind::Lower);
        let upper = child_by!(node, FieldKind::Upper);
        let inclusive_node = child_by!(node, FieldKind::Inclusive);

        let e = self.make_expr(ExprTag::Range, span);
        e._data.range.flag = if inclusive_node.is_some() {
            let text = self.ctx.node_text(inclusive_node.unwrap());
            text.len() == 3  // "..=" is 3 bytes, ".." is 2 bytes
        } else {
            false
        };

        if lower.is_some() {
            e._data.range.lhs = self.parse_expr(lower.unwrap());
        }
        if upper.is_some() {
            e._data.range.rhs = self.parse_expr(upper.unwrap());
        }
        self.ctx.alloc_expr(e)
    }

    // ============================================================
    // Macro handling
    // ============================================================

    /// The macro a macro reference or stored invocation (a
    /// `MacroInvocation` expression) denotes: the one it resolved to where
    /// it was written, else the one its name resolves to here.
    fn resolve_macro_ref(self: &ExprParser, e: &Expr) -> Option<MacroEntry> {
        if e._data.macro_expr.macro_id != 0 {
            self.ctx.resolve_macro_by_id(e._data.macro_expr.macro_id)
        } else {
            self.ctx.resolve_macro(self.scope_idx, e.str_val())
        }
    }

    fn parse_macro_invocation(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let name_node = child_by!(node, FieldKind::Macro);
        let args_node = child_by!(node, FieldKind::Arguments);

        if name_node.is_none() {
            return self.alloc_void(span);
        }

        let macro_node = name_node.unwrap();
        let macro_node_kind = NODE_KINDS[macro_node.symbol() as usize];

        // Resolve macro name - handle both simple identifiers and scoped paths
        let name = self.ctx.intern_str(self.ctx.node_text(macro_node));
        let macro_item_id: usize = 0;

        // $m!(...) inside a macro body — the macro name itself is a macro
        // parameter. Record the param idx so expand_macro_expr can substitute
        // the actual macro reference at expansion time.
        let name_param_idx: Option<usize> = Option::none();
        if self.ctx.in_macro_body && macro_node_kind == NodeKind::MacroIdentifier {
            let raw = self.ctx.node_text(macro_node);
            let stripped = if !raw.is_empty() && raw[0] == '$' { raw[1..] } else { raw };
            let pname = self.ctx.intern_str(stripped);
            name_param_idx = self.ctx.macro_param_names.iter().find_index(|=pname, e: &[u8]| -> bool { e == pname });
        }

        // For scoped identifiers (e.g. std::io::errno_try), resolve through scope system
        if macro_node_kind == NodeKind::ScopedIdentifier {
            let pass2 = Pass2 { ctx: self.ctx };
            let segments = pass2.collect_type_path_segments(macro_node);
            let resolved = self.ctx.scopes.resolve_path(self.scope_idx, segments);
            if resolved.is_some() {
                let item = resolved.unwrap();
                if item.kind.tag == scope::NamedItemTag::Macro {
                    macro_item_id = item.kind.id()._value;
                    name = item.name;
                }
            }
        }

        let args = if args_node.is_some() {
            self.parse_arg_list(args_node.unwrap())
        } else {
            let empty: &[&Expr] = &[];
            empty
        };

        // When pre-parsing a macro body, store as ExprTag::MacroInvocation
        // without expanding. The invoked macro is resolved here, in the
        // macro's definition scope (macros are hygienic): at expansion time
        // the name would be looked up from the call site instead.
        if self.ctx.in_macro_body {
            if macro_item_id == 0 && name_param_idx.is_none() {
                let resolved = self.ctx.scopes.resolve(self.scope_idx, name);
                if resolved.is_some() && resolved.unwrap().kind.tag == scope::NamedItemTag::Macro {
                    macro_item_id = resolved.unwrap().kind.id()._value;
                }
            }
            let defining = self.ctx.defining_macro;
            if defining.is_some() && macro_item_id != 0 && macro_item_id == defining.unwrap().0 {
                self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(defining.unwrap().1,
                    "recursive macro calls are not allowed"));
                return self.alloc_void(span);
            }
            let e = self.make_expr(ExprTag::MacroInvocation, span);
            e._data.macro_expr.macro_id = macro_item_id;
            e._data.macro_expr.str_val = name;
            e._data.macro_expr.args = args;
            e._data.macro_expr.flag = true;  // Mark as actual invocation (not bare macro reference)
            if name_param_idx.is_some() {
                e._data.macro_expr.is_param_subst = true;
                e._data.macro_expr.param_idx = name_param_idx.unwrap() as i32;
            }
            return self.ctx.alloc_expr(e);
        }

        // Try to expand the macro - use scope-resolved ID if available, otherwise resolve by name
        let macro_entry: Option<MacroEntry> = if macro_item_id != 0 {
            self.ctx.resolve_macro_by_id(macro_item_id)
        } else {
            self.ctx.resolve_macro(self.scope_idx, name)
        };
        if macro_entry.is_some() {
            let entry = macro_entry.unwrap();

            // Handle builtin macros with special compiler logic
            if entry.is_builtin {
                return self.expand_builtin_macro(name, args, span);
            }

            // Expand using pre-parsed body
            return self.do_expand_macro(entry, args, span);
        }

        // Name resolution does not depend on which `when` branch survives
        // monomorphization, so an unresolved macro is an error right away
        // (as in alumina-boot). It used to be silently dropped.
        self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(
            span,
            std::fmt::format!("could not resolve the path `{}`", name).unwrap().as_slice(),
        ));
        self.alloc_void(span)
    }

    // Expand a builtin macro (one with the #[builtin] attribute).
    // Dispatches to specialized logic based on macro name.
    fn expand_builtin_macro(self: &ExprParser, name: &[u8], args: &[&Expr], span: Span) -> &Expr {
        // For source-location builtins, prefer the outermost macro call's
        // span over the (potentially body-internal) `span` we were called
        // with. Matches alumina-boot's "outermost macro invocation" rule.
        let span = if (name == "file" || name == "line" || name == "column" || name == "stringify")
            && self.ctx.macro_outer_span.is_some() {
            self.ctx.macro_outer_span.unwrap()
        } else {
            span
        };
        switch name {
        "cfg" => {
            // cfg!("key") -> whether the cfg key is set (with any value)
            let e = self.make_expr(ExprTag::BoolLit, span);
            if args.len() == 1 && args[0].tag == ExprTag::StringLit {
                e._data.lit.bool_val = self.ctx.cfg.has(args[0].str_val());
            } else {
                self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(span, "`cfg!` expects a single string literal"));
                e._data.lit.bool_val = false;
            }
            self.ctx.alloc_expr(e)
        }
        "line" => {
            let line: u64 = 0;
            if span.file_id < self.ctx.diag.files.len() as u32 {
                let file = &self.ctx.diag.files[span.file_id as usize];
                let (l, _c) = file.line_col(span.start);
                line = l as u64;
                let loc = self.ctx.location_override;
                if loc.is_some() && loc.unwrap().file_id == span.file_id {
                    line = (loc.unwrap().line + (l as usize - loc.unwrap().from_line)) as u64;
                }
            }
            let e = self.make_expr(ExprTag::IntLit, span);
            e._data.lit.int_val = line;
            self.ctx.alloc_expr(e)
        }
        "column" => {
            let col: u64 = 0;
            if span.file_id < self.ctx.diag.files.len() as u32 {
                let file = &self.ctx.diag.files[span.file_id as usize];
                let (_l, c) = file.line_col(span.start);
                col = c as u64;
                // (Discarded with an overridden location.)
                if self.ctx.location_override.is_some() {
                    col = 0;
                }
            }
            let e = self.make_expr(ExprTag::IntLit, span);
            e._data.lit.int_val = col;
            self.ctx.alloc_expr(e)
        }
        "file" => {
            let path: &[u8] = "";
            if span.file_id < self.ctx.diag.files.len() as u32 {
                let file = &self.ctx.diag.files[span.file_id as usize];
                path = file.path;
                if self.ctx.location_override.is_some() {
                    path = self.ctx.location_override.unwrap().file;
                }
            }
            let e = self.make_expr(ExprTag::StringLit, span);
            e._data.lit.str_val = path;
            self.ctx.alloc_expr(e)
        }
        "stringify" => {
            // (The code as alumina-boot prints it, see parser::pretty.)
            let e = self.make_expr(ExprTag::StringLit, span);
            e._data.lit.str_val = if args.is_empty() { "" } else { parser::pretty::pretty_print(self.ctx, self.scope_idx, args[0]) };
            self.ctx.alloc_expr(e)
        }
        "env" => {
            let value: &[u8] = "";
            if !args.is_empty() && args[0].tag == ExprTag::StringLit {
                let var_name = args[0].str_val();
                let result = std::process::env().get(var_name);
                if result.is_some() {
                    value = self.ctx.arena.alloc_slice_copy::<u8>(result.unwrap());
                }
            }
            let e = self.make_expr(ExprTag::StringLit, span);
            e._data.lit.str_val = value;
            self.ctx.alloc_expr(e)
        }
        "concat" => {
            let total_len: usize = 0;
            for arg in args.iter() {
                if arg.tag == ExprTag::StringLit {
                    total_len += arg.str_val().len();
                } else {
                    return self.constant_string_expected(span);
                }
            }
            let buf = self.ctx.arena.alloc_slice::<u8>(total_len);
            let offset: usize = 0;
            for arg in args.iter() {
                if arg.tag == ExprTag::StringLit {
                    let s = arg.str_val();
                    for j in 0usize..s.len() {
                        buf[offset + j] = s[j];
                    }
                    offset += s.len();
                }
            }
            let e = self.make_expr(ExprTag::StringLit, span);
            e._data.lit.str_val = buf;
            self.ctx.alloc_expr(e)
        }
        "include_bytes" => {
            if !args.is_empty() && args[0].tag == ExprTag::StringLit {
                let path = args[0].str_val();
                let result = std::fs::File::read_to_string(std::fs::Path::new(path));
                if result.is_ok() {
                    let data = result.unwrap();
                    defer data.free();
                    let e = self.make_expr(ExprTag::StringLit, span);
                    e._data.lit.str_val = self.ctx.arena.alloc_slice_copy::<u8>(data.as_slice());
                    return self.ctx.alloc_expr(e);
                }
                self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(
                    span, std::fmt::format!("cannot read file `{}`", path).unwrap().as_slice()));
                return self.alloc_void(span);
            }
            self.constant_string_expected(span)
        }
        "format_args" => self.expand_format_args(args, span),
        "bind" => {
            if args.is_empty() {
                return self.alloc_void(span);
            }
            let macro_ref = args[0];
            let macro_name: &[u8] = "";
            let prev_bound: &[&Expr] = &[];
            if macro_ref.tag == ExprTag::MacroInvocation {
                macro_name = macro_ref.str_val();
                prev_bound = macro_ref.args();
            }
            let new_bound_count = prev_bound.len() + args.len() - 1;
            let bound_args = self.ctx.arena.alloc_slice::<&Expr>(new_bound_count);
            for i in 0usize..prev_bound.len() {
                bound_args[i] = prev_bound[i];
            }
            for i in 1usize..args.len() {
                bound_args[prev_bound.len() + i - 1] = args[i];
            }
            let e = self.make_expr(ExprTag::MacroInvocation, span);
            e._data.macro_expr.str_val = macro_name;
            e._data.macro_expr.args = bound_args;
            if macro_ref.tag == ExprTag::MacroInvocation {
                e._data.macro_expr.macro_id = macro_ref._data.macro_expr.macro_id;
            }
            self.ctx.alloc_expr(e)
        }
        "reduce" => {
            if args.len() < 2usize {
                return self.alloc_void(span);
            }
            let macro_ref = args[0];
            let macro_name: &[u8] = "";
            let prev_bound: &[&Expr] = &[];
            if macro_ref.tag == ExprTag::MacroInvocation {
                macro_name = macro_ref.str_val();
                prev_bound = macro_ref.args();
            }
            let accumulator: &Expr = args[1];
            for i in 2usize..args.len() {
                let total = prev_bound.len() + 2;
                let call_args = self.ctx.arena.alloc_slice::<&Expr>(total);
                for j in 0usize..prev_bound.len() {
                    call_args[j] = prev_bound[j];
                }
                call_args[prev_bound.len()] = accumulator;
                call_args[prev_bound.len() + 1] = args[i];
                let macro_entry = self.resolve_macro_ref(macro_ref);
                if macro_entry.is_some() {
                    let entry = macro_entry.unwrap();
                    accumulator = self.do_expand_macro(entry, call_args, span);
                }
            }
            accumulator
        }
        "count" => {
            let e = self.make_expr(ExprTag::IntLit, span);
            e._data.lit.int_val = args.len() as u64;
            self.ctx.alloc_expr(e)
        }
        _ => self.alloc_void(span),
        }
    }

    // Expand format_args!(wrapper_macro, fmt_string, args...)
    // Parses the format string, generates interleaved string pieces and argument
    // references, then calls the wrapper macro with all pieces.
    fn expand_format_args(self: &ExprParser, args: &[&Expr], span: Span) -> &Expr {
        if args.len() < 2usize {
            return self.alloc_void(span);
        }

        // First arg should be a macro reference (ExprTag::MacroInvocation with no args,
        // or a bound macro). We need to find the macro name.
        let wrapper_expr = args[0];
        let fmt_str_expr = args[1];

        // Format string must be a string literal
        if fmt_str_expr.tag != ExprTag::StringLit {
            return self.constant_string_expected(span);
        }
        let fmt_str = fmt_str_expr.str_val();

        // Parse the format string into pieces
        let pieces: Vector<&Expr> = Vector::new();
        defer pieces.free();

        // Collect bound args from wrapper (if it's a bound macro / ExprTag::MacroInvocation)
        // In practice, wrapper is passed as a macro parameter ($fmt) which is just an Expr.
        // We need to figure out the wrapper macro name and any bound args.
        // For now, collect interleaved pieces.

        // (As alumina-boot: `{}` is the next argument, `{N}` argument N,
        // `{{` and `}}` are braces; every argument must be used.)
        let num_format_args = args.len() - 2;
        let used: Vector<bool> = Vector::from_slice(self.ctx.arena.alloc_slice::<bool>(num_format_args));
        defer used.free();
        for j in 0usize..num_format_args { used[j] = false; }
        let string_part: Vector<u8> = Vector::new();
        defer string_part.free();
        let next_arg_idx: usize = 0;
        let error: Option<&[u8]> = Option::none();

        let i: usize = 0;
        while i < fmt_str.len() && error.is_none() {
            let ch = fmt_str[i];
            i += 1;
            if ch == '}' {
                if i < fmt_str.len() && fmt_str[i] == '}' {
                    string_part.push('}');
                    i += 1;
                } else {
                    error = Option::some(if i < fmt_str.len() { "unexpected character" } else { "unexpected end of format string" });
                }
                continue;
            }
            if ch != '{' {
                string_part.push(ch);
                continue;
            }
            if i < fmt_str.len() && fmt_str[i] == '{' {
                string_part.push('{');
                i += 1;
                continue;
            }
            // `{}` or `{N}`
            let has_index = false;
            let index: usize = 0;
            while i < fmt_str.len() && fmt_str[i] >= '0' && fmt_str[i] <= '9' {
                has_index = true;
                index = index * 10 + (fmt_str[i] - '0') as usize;
                i += 1;
            }
            if i >= fmt_str.len() {
                error = Option::some("unexpected end of format string");
                continue;
            }
            if fmt_str[i] != '}' {
                error = Option::some("unexpected character");
                continue;
            }
            i += 1;
            if !has_index {
                index = next_arg_idx;
                next_arg_idx += 1;
            }
            if index >= num_format_args {
                error = Option::some("not enough arguments");
                continue;
            }
            if !string_part.is_empty() {
                let e = self.make_expr(ExprTag::StringLit, span);
                e._data.lit.str_val = self.ctx.arena.alloc_slice_copy::<u8>(string_part.as_slice());
                pieces.push(self.ctx.alloc_expr(e));
                string_part.clear();
            }
            used[index] = true;
            pieces.push(args[index + 2]);
        }
        if error.is_none() && used.iter().any(|u: bool| -> bool { !u }) {
            error = Option::some("unused arguments");
        }
        if error.is_some() {
            self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(span,
                std::fmt::format!("invalid format string ({})", error.unwrap()).unwrap().as_slice()));
            return self.alloc_void(span);
        }

        // Flush remaining string part
        if !string_part.is_empty() {
            let e = self.make_expr(ExprTag::StringLit, span);
            e._data.lit.str_val = self.ctx.arena.alloc_slice_copy::<u8>(string_part.as_slice());
            pieces.push(self.ctx.alloc_expr(e));
        }

        // Now invoke the wrapper macro with the pieces.
        // The wrapper is args[0], which should be a macro reference.
        // We need to expand: wrapper_macro(pieces...)
        // The wrapper is typically passed as bind!(static_format_args, fmt),
        // which means args[0] is an ExprTag::MacroInvocation.
        //
        // However, in aluminac's macro system, bound macros are tricky since
        // we don't have first-class macro values. The wrapper is passed as a $param
        // which is whatever expression was substituted.
        //
        // For now, if wrapper is an ExprTag::MacroInvocation, invoke that macro with
        // the collected pieces as args.
        if wrapper_expr.tag == ExprTag::MacroInvocation {
            // Combine wrapper's existing args with format pieces
            let wrapper_args = wrapper_expr.args();
            let total_args = wrapper_args.len() + pieces.len();
            let all_args = self.ctx.arena.alloc_slice::<&Expr>(total_args);
            for j in 0usize..wrapper_args.len() {
                all_args[j] = wrapper_args[j];
            }
            for j in 0usize..pieces.len() {
                all_args[wrapper_args.len() + j] = pieces[j];
            }

            // Look up and expand the macro using pre-parsed body
            let macro_entry = self.resolve_macro_ref(wrapper_expr);
            if macro_entry.is_some() {
                let entry = macro_entry.unwrap();
                return self.do_expand_macro(entry, all_args, span);
            }
        }

        // Fallback: return void
        self.alloc_void(span)
    }

    fn parse_universal_macro(self: &ExprParser, node: Node, span: Span) -> &Expr {
        // obj.macro!(args)
        let value = child_by!(node, FieldKind::Value);
        let macro_node = child_by!(node, FieldKind::Macro);
        let args_node = child_by!(node, FieldKind::Arguments);

        if value.is_none() || macro_node.is_none() {
            return self.alloc_void(span);
        }

        let obj = self.parse_expr(value.unwrap());
        let name = self.ctx.intern_str(self.ctx.node_text(macro_node.unwrap()));

        let all_args: Vector<&Expr> = Vector::new();
        defer all_args.free();
        all_args.push(obj);

        if args_node.is_some() {
            let extra_args = self.parse_arg_list(args_node.unwrap());
            for extra_arg in extra_args.iter() {
                all_args.push(extra_arg);
            }
        }

        let args_slice = self.ctx.arena.alloc_slice_copy::<&Expr>(all_args.as_slice());

        // Try to expand the macro
        let macro_entry = self.ctx.resolve_macro(self.scope_idx, name);
        if macro_entry.is_some() {
            let entry = macro_entry.unwrap();

            if entry.is_builtin {
                return self.expand_builtin_macro(name, args_slice, span);
            }

            return self.do_expand_macro(entry, args_slice, span);
        }

        let e = self.make_expr(ExprTag::MacroInvocation, span);
        e._data.macro_expr.str_val = name;
        e._data.macro_expr.args = args_slice;
        self.ctx.alloc_expr(e)
    }

    fn parse_static_for(self: &ExprParser, node: Node, span: Span) -> &Expr {
        // Grammar: for const name in value { body }
        // Fields: name (identifier), value (expression), body (block)
        let name_node = child_by!(node, FieldKind::Name);
        let iter_node = child_by!(node, FieldKind::Value);
        let body = child_by!(node, FieldKind::Body);

        if name_node.is_none() || iter_node.is_none() || body.is_none() {
            return self.alloc_void(span);
        }

        let name_node_val = name_node.unwrap();
        let var_id = self.ctx.next_id();
        let var_name = self.ctx.intern_str(self.ctx.node_text(name_node_val));

        // Create a child scope for the loop so the loop variable is accessible in the body
        let loop_scope = self.ctx.scopes.create_scope(ScopeKind::Block, Option::some(self.scope_idx));
        let loop_parser = ExprParser::new(self.ctx, loop_scope);

        // Register the loop variable in the child scope
        self.ctx.scopes.add_item(loop_scope, NamedItem {
            name: var_name,
            kind: NamedItemKind::local(var_id),
            span: self.ctx.make_span(name_node_val),
        });

        let e = self.make_expr(ExprTag::StaticFor, span);
        e._data.for_expr.id = var_id;
        e._data.for_expr.lhs = self.parse_expr(iter_node.unwrap()); // iter parsed in parent scope
        e._data.for_expr.rhs = loop_parser.parse_expr(body.unwrap()); // body parsed in child scope
        self.ctx.alloc_expr(e)
    }

    /// `expr...` (a tuple's elements spliced into a tuple) or, in a macro
    /// body, `expr$...` (`expr` for each of the macro's `...` arguments).
    fn parse_et_cetera(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let inner = child_by!(node, FieldKind::Inner);
        if inner.is_none() {
            return self.alloc_void(span);
        }
        let is_macro = child_by!(node, FieldKind::Macro).is_some();
        if is_macro {
            let message: &[u8] = if !self.ctx.in_macro_body {
                "`$...` expressions can only be used in macros"
            } else if self.ctx.macro_variadic_param_idx == NO_VARIADIC {
                "this macro does not have any `...` arguments"
            } else if self.ctx.in_macro_et_cetera {
                "nested `$...` expansions are not supported (yet)"
            } else {
                ""
            };
            if !message.is_empty() {
                self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(span, message));
                return self.alloc_void(span);
            }
        }

        let e = self.make_expr(if is_macro { ExprTag::MacroEtCetera } else { ExprTag::EtCetera }, span);
        let prev = self.ctx.in_macro_et_cetera;
        self.ctx.in_macro_et_cetera = is_macro;
        e._data.defer.lhs = self.parse_expr(inner.unwrap());
        self.ctx.in_macro_et_cetera = prev;
        self.ctx.alloc_expr(e)
    }

    // === AST-based macro expansion ===

    // Entry point: expand a macro with pre-parsed body.
    // Sets up param_args and variadic_args, then calls expand_macro_expr.
    fn do_expand_macro(self: &ExprParser, entry: MacroEntry, call_args: &[&Expr], span: Span) -> &Expr {
        // Track the OUTERMOST macro call's span so that builtin location
        // macros (file!/line!/column!/stringify!) inside the body resolve
        // to the user's call site rather than to the macro body's position.
        // Only the outermost expansion sets the span; nested expansions
        // inherit it.
        let prev_outer = self.ctx.macro_outer_span;
        if prev_outer.is_none() {
            self.ctx.macro_outer_span = Option::some(span);
        }
        // The code the macro's body gives comes from this expansion (for
        // diagnostics' backtraces).
        let call_site = span;
        if call_site.expansion == 0 {
            call_site.expansion = self.ctx.current_expansion;
        }
        let prev_expansion = self.ctx.current_expansion;
        self.ctx.current_expansion = self.ctx.diag.add_expansion(call_site, entry.name);
        let result = if self.ctx.expansion_depth >= 128 {
            // (Macros calling each other.)
            self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(span, "recursive macro calls are not allowed"));
            self.alloc_void(span)
        } else if !self.check_macro_args(entry, call_args, span) {
            self.alloc_void(span)
        } else {
            self.ctx.expansion_depth += 1;
            let expanded = self.do_expand_macro_inner(entry, call_args, span);
            self.ctx.expansion_depth -= 1;
            expanded
        };
        self.ctx.current_expansion = prev_expansion;
        self.ctx.macro_outer_span = prev_outer;
        result
    }

    /// A builtin macro's argument that must be a string literal is not.
    fn constant_string_expected(self: &ExprParser, span: Span) -> &Expr {
        self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(span, "constant string expected"));
        self.alloc_void(span)
    }

    /// Whether a macro is given as many arguments as it takes (as in
    /// alumina-boot); reported if not.
    fn check_macro_args(self: &ExprParser, entry: MacroEntry, call_args: &[&Expr], span: Span) -> bool {
        let params = entry.params.len();
        let message = if entry.variadic_param_idx != NO_VARIADIC {
            if call_args.len() + 1 >= params { return true; }
            std::fmt::format!("not enough macro arguments, at least {} expected", params - 1).unwrap()
        } else {
            if call_args.len() == params { return true; }
            std::fmt::format!("expected {} arguments, found {}", params, call_args.len()).unwrap()
        };
        defer message.free();
        self.ctx.diag.emit(diagnostics::CodeDiagnostic::generic_error(span, self.ctx.intern_str(message.as_slice())));
        false
    }

    /// `expr` (of the body being expanded) as code of the current expansion.
    fn in_expansion(self: &ExprParser, expr: &Expr) -> &Expr {
        if expr.span.expansion != 0 || self.ctx.current_expansion == 0 {
            return expr;
        }
        let e = *expr;
        e.span.expansion = self.ctx.current_expansion;
        self.ctx.alloc_expr(e)
    }

    fn do_expand_macro_inner(self: &ExprParser, entry: MacroEntry, call_args: &[&Expr], span: Span) -> &Expr {
        let param_count = entry.params.len();
        let param_args = self.ctx.arena.alloc_slice::<&Expr>(param_count);
        let variadic_args: &[&Expr] = &[];

        if entry.variadic_param_idx != NO_VARIADIC {
            let vi = entry.variadic_param_idx as usize;
            // Non-variadic params before variadic
            for i in 0usize..vi {
                if i < call_args.len() {
                    param_args[i] = call_args[i];
                } else {
                    param_args[i] = self.alloc_void(span);
                }
            }
            // Variadic args: everything between non-variadic params
            let non_variadic_count = param_count - 1; // exclude the variadic param itself
            let etc_count = if call_args.len() > non_variadic_count {
                call_args.len() - non_variadic_count
            } else {
                0usize
            };
            let etc_args = self.ctx.arena.alloc_slice::<&Expr>(etc_count);
            for i in 0usize..etc_count {
                etc_args[i] = call_args[vi + i];
            }
            variadic_args = etc_args;
            // Placeholder for variadic param slot
            param_args[vi] = self.alloc_void(span);
            // Non-variadic params after variadic
            for i in vi + 1..param_count {
                let arg_idx = i + etc_count - 1;
                if arg_idx < call_args.len() {
                    param_args[i] = call_args[arg_idx];
                } else {
                    param_args[i] = self.alloc_void(span);
                }
            }
        } else {
            for i in 0usize..param_count {
                if i < call_args.len() {
                    param_args[i] = call_args[i];
                } else {
                    param_args[i] = self.alloc_void(span);
                }
            }
        }

        // Create ID replacement map for hygiene
        let id_map: HashMap<usize, Id> = HashMap::new();
        defer id_map.free();

        let result = self.expand_macro_expr(
            entry.body,
            param_args,
            variadic_args,
            entry.variadic_param_idx,
            NO_VARIADIC,  // not in et cetera
            &id_map,
        );
        result
    }

    // Recursively expand a pre-parsed macro body expression.
    // Substitutes ExprTag::MacroParam with args, expands ExprTag::EtCetera,
    // and recursively expands nested ExprTag::MacroInvocation.
    fn expand_macro_expr(
        self: &ExprParser,
        expr: &Expr,
        param_args: &[&Expr],
        variadic_args: &[&Expr],
        variadic_param_idx: i32,
        et_cetera_idx: i32,
        id_map: &mut HashMap<usize, Id>,
    ) -> &Expr {
        // Substitute macro parameter
        if expr.tag == ExprTag::MacroParam {
            let idx = expr.int_val() as i32;
            if expr.flag() && et_cetera_idx != NO_VARIADIC {
                // Variadic param in et cetera context
                let vi = et_cetera_idx as usize;
                if vi < variadic_args.len() {
                    return variadic_args[vi];
                }
                return self.alloc_void(expr.span);
            }
            if idx >= 0i32 && (idx as usize) < param_args.len() {
                return param_args[idx as usize];
            }
            return self.alloc_void(expr.span);
        }

        // Expand nested macro invocation (only actual invocations, not bare references)
        if expr.tag == ExprTag::MacroInvocation && expr.flag() {
            let call_span = expr.span;
            if call_span.expansion == 0 {
                call_span.expansion = self.ctx.current_expansion;
            }
            // First expand the args
            let expanded_args = self.expand_macro_args_list(
                expr.args(), param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map
            );

            // $m!(...) — the macro name itself is a macro parameter. Substitute
            // it with the actual macro reference (a MacroInvocation, possibly
            // bound), prepend its bound args to the current args, and expand
            // the resolved macro.
            if expr._data.macro_expr.is_param_subst {
                let pidx = expr._data.macro_expr.param_idx;
                if pidx >= 0i32 && (pidx as usize) < param_args.len() {
                    let macro_ref = param_args[pidx as usize];
                    if macro_ref.tag == ExprTag::MacroInvocation {
                        let real_name = macro_ref.str_val();
                        let prev_bound = macro_ref.args();
                        let total = prev_bound.len() + expanded_args.len();
                        let combined = self.ctx.arena.alloc_slice::<&Expr>(total);
                        for i in 0usize..prev_bound.len() {
                            combined[i] = prev_bound[i];
                        }
                        for i in 0usize..expanded_args.len() {
                            combined[prev_bound.len() + i] = expanded_args[i];
                        }
                        let macro_entry = self.resolve_macro_ref(macro_ref);
                        if macro_entry.is_some() {
                            let entry = macro_entry.unwrap();
                            if entry.is_builtin {
                                return self.expand_builtin_macro(real_name, combined, call_span);
                            }
                            return self.do_expand_macro(entry, combined, call_span);
                        }
                        // Unresolved underlying macro — keep as MacroInvocation with the resolved name
                        let e = *expr;
                        e._data.macro_expr.is_param_subst = false;
                        e._data.macro_expr.param_idx = -1i32;
                        e._data.macro_expr.str_val = real_name;
                        e.set_args(combined);
                        return self.ctx.alloc_expr(e);
                    }
                }
                // Substitution failed — fall through to void
                return self.alloc_void(expr.span);
            }

            // The macro resolved at its definition site (see
            // parse_macro_invocation), else by name.
            let macro_entry = self.resolve_macro_ref(expr);
            if macro_entry.is_some() {
                let entry = macro_entry.unwrap();
                if entry.is_builtin {
                    return self.expand_builtin_macro(expr.str_val(), expanded_args, call_span);
                }
                return self.do_expand_macro(entry, expanded_args, call_span);
            }
            // Unresolved macro - keep with expanded args
            let e = *expr;
            e.set_args(expanded_args);
            return self.ctx.alloc_expr(e);
        }

        // Leaf expressions that don't need expansion
        if expr.tag == ExprTag::IntLit || expr.tag == ExprTag::FloatLit ||
           expr.tag == ExprTag::BoolLit || expr.tag == ExprTag::StringLit ||
           expr.tag == ExprTag::NullLit ||
           expr.tag == ExprTag::Void || expr.tag == ExprTag::Zeroed {
            return self.in_expansion(expr);
        }

        // For non-macro identifiers (resolved at pre-parse time), just return as-is
        if expr.tag == ExprTag::Local || expr.tag == ExprTag::Param ||
           expr.tag == ExprTag::StaticRef || expr.tag == ExprTag::FnRef ||
           expr.tag == ExprTag::EnumRef || expr.tag == ExprTag::BoundValue {
            // Check if this local needs ID remapping (hygiene)
            if expr.tag == ExprTag::Local {
                // Unresolved at macro-body-pre-parse time: parse_identifier
                // stashed the source name on the Local's str_val. Re-resolve
                // against the call-site scope (e.g. `&buf` where buf is a
                // function-local in the macro's caller).
                if expr.id()._value == 0usize && !expr.str_val().is_empty() {
                    let resolved = self.ctx.scopes.resolve(self.scope_idx, expr.str_val());
                    if resolved.is_some() {
                        let item = resolved.unwrap();
                        if item.kind.tag == scope::NamedItemTag::Local {
                            let e = self.make_expr(ExprTag::Local, expr.span);
                            e._data.id_ref.id = item.kind.id();
                            return self.ctx.alloc_expr(e);
                        } else if item.kind.tag == scope::NamedItemTag::Param {
                            let e = self.make_expr(ExprTag::Param, expr.span);
                            e._data.id_ref.id = item.kind.id();
                            return self.ctx.alloc_expr(e);
                        } else if item.kind.tag == scope::NamedItemTag::Static {
                            let e = self.make_expr(ExprTag::StaticRef, expr.span);
                            e._data.id_ref.id = item.kind.id();
                            return self.ctx.alloc_expr(e);
                        } else if item.kind.tag == scope::NamedItemTag::Const {
                            let e = self.make_expr(ExprTag::StaticRef, expr.span);
                            e._data.id_ref.id = item.kind.id();
                            return self.ctx.alloc_expr(e);
                        } else if item.kind.tag == scope::NamedItemTag::Function {
                            let e = self.make_expr(ExprTag::FnRef, expr.span);
                            e._data.id_ref.id = item.kind.id();
                            return self.ctx.alloc_expr(e);
                        }
                        return self.not_a_value(expr.span, expr.str_val());
                    }
                    return self.unresolved_path(expr.span, expr.str_val());
                }
                let mapped = id_map.get(&expr.id()._value);
                if mapped.is_some() {
                    let e = *expr;
                    e.set_id(mapped.unwrap());
                    return self.in_expansion(self.ctx.alloc_expr(e));
                }
            }
            return self.in_expansion(expr);
        }

        // Clone the expression and recursively expand children
        let e = *expr;
        if e.span.expansion == 0 {
            e.span.expansion = self.ctx.current_expansion;
        }

        // Generate fresh ID for let bindings (hygiene)
        if e.tag == ExprTag::Let {
            let new_id = self.ctx.next_id();
            id_map.insert(e._data.let_expr.id._value, new_id);
            e._data.let_expr.id = new_id;
            // Don't register the new local in the caller's scope — that
            // would shadow the caller's same-named binding via the by-name
            // HashMap and break hygiene. References inside the macro body
            // already carry the macro-defined id (resolved during pre-parse
            // of the body), and the id_map remapping above takes them to
            // the fresh id. mono later registers the local in local_defs
            // when it lowers the Let, which is sufficient for codegen.
        }

        // Use a tag-dispatched approach for expand to avoid accessor/setter overhead
        // and ensure correct union variant access
        switch e.tag {
            ExprTag::Binary => {
                e._data.binary.lhs = self.expand_macro_expr(e._data.binary.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                e._data.binary.rhs = self.expand_macro_expr(e._data.binary.rhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
            }
            ExprTag::Unary => {
                e._data.unary.lhs = self.expand_macro_expr(e._data.unary.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
            }
            ExprTag::Assign => {
                e._data.assign.lhs = self.expand_macro_expr(e._data.assign.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                e._data.assign.rhs = self.expand_macro_expr(e._data.assign.rhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
            }
            ExprTag::Call, ExprTag::TurbofishValue => {
                if e._data.call.lhs as &void as usize != 0usize {
                    e._data.call.lhs = self.expand_macro_expr(e._data.call.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                }
                if !e._data.call.args.is_empty() {
                    e._data.call.args = self.expand_macro_args_list(e._data.call.args, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                }
            }
            ExprTag::FieldAccess => {
                e._data.field.lhs = self.expand_macro_expr(e._data.field.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
            }
            ExprTag::Index, ExprTag::TupleIndex => {
                if e._data.index.lhs as &void as usize != 0usize {
                    e._data.index.lhs = self.expand_macro_expr(e._data.index.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                }
                if e._data.index.rhs as &void as usize != 0usize {
                    e._data.index.rhs = self.expand_macro_expr(e._data.index.rhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                }
                if e._data.index.opt_expr.is_some() {
                    e._data.index.opt_expr = Option::some(self.expand_macro_expr(e._data.index.opt_expr.unwrap(), param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map));
                }
            }
            ExprTag::Ref, ExprTag::Deref, ExprTag::Cast, ExprTag::TypeCheck => {
                e._data.typed.lhs = self.expand_macro_expr(e._data.typed.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
            }
            ExprTag::If, ExprTag::When => {
                e._data.cond.cond = self.expand_macro_expr(e._data.cond.cond, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                e._data.cond.lhs = self.expand_macro_expr(e._data.cond.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                if e._data.cond.opt_expr.is_some() {
                    e._data.cond.opt_expr = Option::some(self.expand_macro_expr(e._data.cond.opt_expr.unwrap(), param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map));
                }
            }
            ExprTag::Switch => {
                e._data.switch_expr.lhs = self.expand_macro_expr(e._data.switch_expr.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                if !e._data.switch_expr.switch_arms.is_empty() {
                    let new_arms = self.ctx.arena.alloc_slice::<SwitchArm>(e._data.switch_expr.switch_arms.len());
                    for i in 0usize..e._data.switch_expr.switch_arms.len() {
                        let arm = e._data.switch_expr.switch_arms[i];
                        let new_patterns = self.ctx.arena.alloc_slice::<&Expr>(arm.pattern.len());
                        for j in 0usize..arm.pattern.len() {
                            new_patterns[j] = self.expand_macro_expr(arm.pattern[j], param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                        }
                        new_arms[i] = SwitchArm {
                            pattern: new_patterns,
                            body: self.expand_macro_expr(arm.body, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map),
                        };
                    }
                    e._data.switch_expr.switch_arms = new_arms;
                }
            }
            ExprTag::While, ExprTag::Loop => {
                if e._data.loop_expr.cond as &void as usize != 0usize {
                    e._data.loop_expr.cond = self.expand_macro_expr(e._data.loop_expr.cond, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                }
                e._data.loop_expr.lhs = self.expand_macro_expr(e._data.loop_expr.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
            }
            ExprTag::For, ExprTag::StaticFor => {
                e._data.for_expr.lhs = self.expand_macro_expr(e._data.for_expr.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                e._data.for_expr.rhs = self.expand_macro_expr(e._data.for_expr.rhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                if !e._data.for_expr.args.is_empty() {
                    e._data.for_expr.args = self.expand_macro_args_list(e._data.for_expr.args, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                }
            }
            ExprTag::Break, ExprTag::Return, ExprTag::Yield => {
                if e._data.jump.opt_expr.is_some() {
                    e._data.jump.opt_expr = Option::some(self.expand_macro_expr(e._data.jump.opt_expr.unwrap(), param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map));
                }
            }
            ExprTag::Let => {
                if e._data.let_expr.opt_expr.is_some() {
                    e._data.let_expr.opt_expr = Option::some(self.expand_macro_expr(e._data.let_expr.opt_expr.unwrap(), param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map));
                }
            }
            ExprTag::StructLit => {
                if !e._data.struct_lit.field_inits.is_empty() {
                    let new_inits = self.ctx.arena.alloc_slice::<FieldInit>(e._data.struct_lit.field_inits.len());
                    for i in 0usize..e._data.struct_lit.field_inits.len() {
                        new_inits[i] = FieldInit {
                            name: e._data.struct_lit.field_inits[i].name,
                            value: self.expand_macro_expr(e._data.struct_lit.field_inits[i].value, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map),
                        };
                    }
                    e._data.struct_lit.field_inits = new_inits;
                }
            }
            ExprTag::TupleLit, ExprTag::ArrayLit, ExprTag::Block => {
                if !e._data.list.args.is_empty() {
                    e._data.list.args = self.expand_macro_args_list(e._data.list.args, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                }
            }
            ExprTag::Lambda => {
                e._data.lambda.lhs = self.expand_macro_expr(e._data.lambda.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
            }
            ExprTag::Range => {
                if e._data.range.lhs as &void as usize != 0usize {
                    e._data.range.lhs = self.expand_macro_expr(e._data.range.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                }
                if e._data.range.rhs as &void as usize != 0usize {
                    e._data.range.rhs = self.expand_macro_expr(e._data.range.rhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                }
            }
            ExprTag::Defer, ExprTag::EtCetera, ExprTag::MacroEtCetera => {
                e._data.defer.lhs = self.expand_macro_expr(e._data.defer.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
            }
            _ => {}
        }

        // Expand lambda params (their types use Ty, not Expr - skip for now)
        // Lambda bodies are in lhs, already handled above

        self.ctx.alloc_expr(e)
    }

    // Expand an argument list, handling ExprTag::EtCetera by unrolling variadic args.
    fn expand_macro_args_list(
        self: &ExprParser,
        args: &[&Expr],
        param_args: &[&Expr],
        variadic_args: &[&Expr],
        variadic_param_idx: i32,
        et_cetera_idx: i32,
        id_map: &mut HashMap<usize, Id>,
    ) -> &[&Expr] {
        let result: Vector<&Expr> = Vector::new();
        defer result.free();

        for arg in args.iter() {
            if arg.tag == ExprTag::MacroEtCetera {
                // Expand inner expression for each variadic arg
                let inner = arg.lhs();
                for vi in 0usize..variadic_args.len() {
                    result.push(self.expand_macro_expr(
                        inner, param_args, variadic_args, variadic_param_idx, vi as i32, id_map
                    ));
                }
            } else {
                result.push(self.expand_macro_expr(
                    arg, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map
                ));
            }
        }

        self.ctx.arena.alloc_slice_copy::<&Expr>(result.as_slice())
    }
}
