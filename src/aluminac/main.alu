// Compiler pipeline for the self-hosted Alumina compiler
//
// Orchestrates the full compilation pipeline:
// 1. Parse source files using tree-sitter
// 2. Build scopes and resolve names
// 3. Monomorphize generic code
// 4. Generate LLVM IR and emit object/executable

use aluminac_common::arena::Arena;
use aluminac::ast::*;
use aluminac::scope::*;
use aluminac::diagnostics::DiagnosticContext;
use tree_sitter::{Parser, Tree, TSLanguage};
use std::collections::Vector;
use std::option::Option;
use std::string::{StringBuf, starts_with, ends_with, contains};
use std::fs::{Path, PathBuf, FileType, read_directory};

extern "C" fn tree_sitter_alumina() -> &TSLanguage;

extern "C" fn exit(code: i32) -> !;

enum OutputFormat {
    Object,
    Assembly,
    LlvmIr,
    Bitcode,
    Executable,
}

enum OptLevel {
    O0 = 0i32,
    O1 = 1i32,
    O2 = 2i32,
    O3 = 3i32,
    Os = 4i32,
}

struct CompilerOptions {
    output_file: &[u8],
    output_format: OutputFormat,
    optimize: OptLevel,
    dump_ir: bool,
    verify_ir: bool,
    test_mode: bool,
    debug_info: bool,
    sysroot: &[u8],
    cfg_flags: Vector<&[u8]>,
    extra_link_args: &[u8],
}

impl CompilerOptions {
    fn default() -> CompilerOptions {
        CompilerOptions {
            output_file: "a.out",
            output_format: OutputFormat::Executable,
            optimize: OptLevel::O0,
            dump_ir: false,
            verify_ir: true,
            test_mode: false,
            debug_info: false,
            sysroot: "",
            cfg_flags: Vector::new(),
            extra_link_args: "",
        }
    }
}

struct Compiler {
    arena: Arena,
    id_gen: IdGen,
    diag: DiagnosticContext,
    scopes: ScopeArena,
    options: CompilerOptions,
    source_files: Vector<SourceEntry>,
    all_items: Vector<Item>,
}

struct SourceEntry {
    path: &[u8],
    contents: &[u8],
    module_path: &[u8], // e.g. "aluminac::ast" or "" for root
}

impl Compiler {
    fn new(options: CompilerOptions) -> Compiler {
        Compiler {
            arena: Arena::new(),
            id_gen: IdGen::new(),
            diag: DiagnosticContext::new(),
            scopes: ScopeArena::new(),
            options: options,
            source_files: Vector::new(),
            all_items: Vector::new(),
        }
    }

    fn add_source(self: &mut Compiler, path: &[u8], contents: &[u8], module_path: &[u8]) {
        // Register with diagnostics
        self.diag.add_file(path, contents, &self.arena);

        self.source_files.push(SourceEntry {
            path: path,
            contents: contents,
            module_path: module_path,
        });
    }

    fn add_source_file(self: &mut Compiler, path: &[u8], module_path: &[u8]) -> bool {
        let result = std::fs::File::read_to_string(Path::new(path));
        if result.is_err() {
            eprintln!("error: cannot open file");
            return false;
        }
        let source = result.unwrap();
        defer source.free();

        // Empty files register no items; skip them (preserves prior behavior).
        if source.as_slice().is_empty() {
            return true;
        }

        // Source text must outlive the StringBuf, so copy it into the arena.
        let contents = self.arena.alloc_slice_copy::<u8>(source.as_slice());
        self.add_source(path, contents, module_path);
        true
    }

    /// Load all .alu files from the sysroot directory recursively.
    /// Each file gets a module path derived from its relative path within sysroot.
    /// e.g. sysroot/std/mem.alu -> "std::mem", sysroot/std/mod.alu -> "std"
    fn load_sysroot(self: &mut Compiler) -> bool {
        let sysroot = self.options.sysroot;
        if sysroot.is_empty() {
            return true;
        }

        // Use a stack for iterative directory traversal
        // Each entry is (directory_path, module_prefix)
        // module_prefix is like "" for root, "std" for std/, "std::collections" etc.
        let dir_stack: Vector<(PathBuf, StringBuf)> = Vector::new();
        defer dir_stack.free();

        let root_path = PathBuf::from_str(sysroot);
        let root_prefix = StringBuf::new();
        dir_stack.push((root_path, root_prefix));

        while !dir_stack.is_empty() {
            let entry_pair = dir_stack.pop().unwrap();
            let dir_path = entry_pair.0;
            let mod_prefix = entry_pair.1;

            let dir_iter_result = read_directory(dir_path.as_path());
            if dir_iter_result.is_err() {
                eprintln!("error: cannot open sysroot directory");
                dir_path.free();
                mod_prefix.free();
                return false;
            }
            let dir_iter = dir_iter_result.unwrap();

            loop {
                let entry_opt = dir_iter.next();
                if entry_opt.is_none() {
                    break;
                }
                let entry_result = entry_opt.unwrap();
                if entry_result.is_err() {
                    continue;
                }
                let entry = entry_result.unwrap();
                let name = entry.name();

                // Skip . and ..
                // Use character-level comparison to avoid potential slice == issues
                let skip = false;
                if name.len() == 1 && name[0] == '.' {
                    skip = true;
                }
                if name.len() == 2 && name[0] == '.' && name[1] == '.' {
                    skip = true;
                }
                if skip {
                    continue;
                }

                if entry.file_type() == FileType::Directory {
                    // Build child path and module prefix
                    let child_path = PathBuf::from_path(dir_path.as_path());
                    child_path.push(Path::new(name));

                    let child_prefix = StringBuf::new();
                    if !mod_prefix.is_empty() {
                        child_prefix.extend_from_slice(mod_prefix.as_slice());
                        child_prefix.extend_from_slice("::");
                    }
                    child_prefix.extend_from_slice(name);

                    dir_stack.push((child_path, child_prefix));
                } else if name.ends_with(".alu") {
                    // Skip test.alu in the sysroot root unless in test mode
                    if name == "test.alu" && mod_prefix.is_empty() && !self.options.test_mode {
                        continue;
                    }

                    // Build full file path
                    let file_path = PathBuf::from_path(dir_path.as_path());
                    file_path.push(Path::new(name));

                    // Build module path: strip .alu suffix, handle "mod" specially
                    let stem = name[0..name.len() - 4]; // strip ".alu"
                    let module_path = StringBuf::new();

                    if stem == "mod" {
                        // mod.alu -> just the directory's module prefix
                        if !mod_prefix.is_empty() {
                            module_path.extend_from_slice(mod_prefix.as_slice());
                        }
                        // root mod.alu has empty module_path (maps to root scope)
                    } else {
                        if !mod_prefix.is_empty() {
                            module_path.extend_from_slice(mod_prefix.as_slice());
                            module_path.extend_from_slice("::");
                        }
                        module_path.extend_from_slice(stem);
                    }

                    // Read the file using std::fs
                    let file_path_slice = file_path.inner.as_slice();
                    let read_result = std::fs::File::read_to_string(file_path.as_path());
                    if read_result.is_err() {
                        eprintln!("error: cannot read sysroot file");
                        file_path.free();
                        module_path.free();
                        continue;
                    }
                    let file_contents = read_result.unwrap();

                    // Copy path and contents into arena for lifetime management
                    let path_copy: &[u8] = if !file_path_slice.is_empty() {
                        let p = self.arena.alloc_slice::<u8>(file_path_slice.len());
                        file_path_slice.copy_to_nonoverlapping(&p[0]);
                        p as &[u8]
                    } else {
                        ""
                    };

                    let contents_copy: &[u8] = if !file_contents.is_empty() {
                        let c = self.arena.alloc_slice::<u8>(file_contents.len());
                        file_contents.as_slice().copy_to_nonoverlapping(&c[0]);
                        c as &[u8]
                    } else {
                        ""
                    };

                    let mod_path_copy: &[u8] = if !module_path.is_empty() {
                        let m = self.arena.alloc_slice::<u8>(module_path.len());
                        module_path.as_slice().copy_to_nonoverlapping(&m[0]);
                        m as &[u8]
                    } else {
                        ""
                    };

                    self.add_source(
                        path_copy as &[u8],
                        contents_copy as &[u8],
                        mod_path_copy as &[u8],
                    );

                    file_path.free();
                    file_contents.free();
                    module_path.free();
                }
            }

            let _ = dir_iter.close();
            dir_path.free();
            mod_prefix.free();
        }

        true
    }

    fn compile(self: &mut Compiler) -> bool {
        if self.source_files.is_empty() {
            eprintln!("error: no source files");
            return false;
        }

        // Create root scope
        let root_scope = self.scopes.create_scope(ScopeKind::Root, Option::none());

        // Register builtin types in root scope
        self.register_builtins(root_scope);

        // Parse all source files
        let parser = Parser::new();
        let _ = parser.set_language(tree_sitter_alumina());

        // Build cfg flags slice from options
        let cfg_flags = self.arena.alloc_slice_copy::<&[u8]>(self.options.cfg_flags.as_slice());

        // Two-phase parsing: first register all names across all files (Pass 1),
        // then parse all function bodies (Pass 2). This ensures cross-module
        // references resolve correctly regardless of file processing order.
        let trees: Vector<Tree> = Vector::new();
        let contexts: Vector<aluminac::parser::ParseContext> = Vector::new();
        defer trees.free();
        defer contexts.free();

        // Phase 0: Create all module scopes first so use imports can resolve across files
        let file_scopes: Vector<u32> = Vector::new();
        defer file_scopes.free();
        for i in 0usize..self.source_files.len() {
            let entry = &self.source_files[i];
            let file_scope = if entry.module_path.is_empty() || entry.module_path == "main" {
                root_scope
            } else {
                self.resolve_or_create_module_scope(root_scope, entry.module_path)
            };
            file_scopes.push(file_scope);
        }

        // Phase 1: Parse all files, run Pass 1 to register names in scopes
        for i in 0usize..self.source_files.len() {
            let entry = &self.source_files[i];
            let file_scope = file_scopes[i];

            let tree = parser.parse_string(entry.contents);
            let raw_node = tree_sitter::ts_tree_root_node(tree.inner);
            let root = tree_sitter::Node { inner: raw_node };

            // Check for syntax errors before proceeding
            aluminac::parser::check_syntax_errors(root, entry.contents, i as u32, &self.diag);

            let ctx = aluminac::parser::parse_file_pass1(
                root,
                entry.contents,
                i as u32,
                &self.arena,
                &self.scopes,
                &self.id_gen,
                &self.diag,
                file_scope,
                cfg_flags,
            );

            trees.push(tree);
            contexts.push(ctx);
        }

        // Phase 1.5a: Link #[lang(builtin_X)] struct scopes to root BuiltinType entries
        aluminac::parser::link_builtin_lang_items(contexts.as_slice(), &self.scopes, root_scope);

        // Phase 1.5b: Collect macro definitions from all files
        for i in 0usize..trees.len() {
            let raw = tree_sitter::ts_tree_root_node(trees[i].inner);
            let root = tree_sitter::Node { inner: raw };
            aluminac::parser::collect_macros(&contexts.as_slice_mut()[i], root);
        }
        // Share macros across all contexts
        aluminac::parser::share_macros(contexts.as_slice_mut());

        // Phase 2: Parse all function bodies (all names are now registered)
        for i in 0usize..trees.len() {
            let raw = tree_sitter::ts_tree_root_node(trees[i].inner);
            let root = tree_sitter::Node { inner: raw };
            let items = aluminac::parser::parse_file_pass2(&contexts.as_slice_mut()[i], root);

            for j in 0usize..items.len() {
                self.all_items.push(items[j]);
            }
        }

        // Cleanup
        for i in 0usize..trees.len() {
            trees[i].free();
            contexts.as_slice_mut()[i].free();
        }
        parser.free();

        if self.diag.has_errors {
            self.diag.emit_all();
            return false;
        }

        // Convert items to a slice for mono
        let items_slice = self.arena.alloc_slice_copy::<Item>(self.all_items.as_slice());
        // Monomorphize
        let unit = aluminac::mono::monomorphize(
            &self.arena,
            &self.scopes,
            &self.id_gen,
            &self.diag,
            items_slice,
            self.options.test_mode,
        );

        if self.diag.has_errors {
            self.diag.emit_all();
            return false;
        }


        // Code generation
        let ctx = aluminac::codegen::generate(
            &self.arena,
            &self.diag,
            &unit,
            "alumina_module",
            self.options.test_mode,
            self.options.debug_info,
            self.options.optimize,
        );
        if self.diag.has_errors {
            self.diag.emit_all();
            ctx.free();
            return false;
        }

        // Flush warnings on success too — they don't fail compilation but
        // should still surface (notably #[must_use] dropped-result warnings).
        if self.diag.has_warnings {
            self.diag.emit_all();
        }

        if self.options.dump_ir {
            ctx.dump();
        }

        if self.options.verify_ir {
            if !ctx.verify() {
                eprintln!("error: LLVM IR verification failed");
                if !self.options.dump_ir {
                    ctx.dump();
                }
                ctx.free();
                return false;
            }
        }

        // Run optimization passes if requested
        if self.options.optimize != OptLevel::O0 {
            if !ctx.optimize() {
                eprintln!("error: LLVM optimization passes failed");
                ctx.free();
                return false;
            }
        }

        // Emit output
        let success = switch self.options.output_format {
            OutputFormat::Object => {
                ctx.emit_to_object(self.options.output_file)
            },
            OutputFormat::Assembly => {
                ctx.emit_to_assembly(self.options.output_file)
            },
            OutputFormat::LlvmIr => {
                ctx.print_ir(self.options.output_file)
            },
            OutputFormat::Bitcode => {
                ctx.write_bitcode(self.options.output_file)
            },
            OutputFormat::Executable => {
                // Emit object file, then link
                let obj_name = std::string::StringBuf::from_slice(self.options.output_file);
                defer obj_name.free();
                obj_name.extend_from_slice(".o");
                let obj_file = obj_name.as_slice();
                if !ctx.emit_to_object(obj_file) {
                    eprintln!("error: failed to emit object file");
                    ctx.free();
                    return false;
                }
                ctx.free();
                return self.link(obj_file, self.options.output_file);
            },
            _ => false,
        };

        if !success {
            eprintln!("error: failed to write output file");
        }

        ctx.free();
        success
    }

    fn link(self: &mut Compiler, obj_file: &[u8], output: &[u8]) -> bool {
        // Use cc to link
        // Build command: cc [-g] -o <output> <obj_file> -lm [extra_link_args]
        let extra = self.options.extra_link_args;
        let debug_extra = if self.options.debug_info { 3usize } else { 0usize }; // " -g"
        let cmd_len = 6usize + output.len() + 1usize + obj_file.len() + 4usize + 1usize + extra.len() + debug_extra;
        let cmd = self.arena.alloc_slice::<u8>(cmd_len + 1usize);
        let pos: usize = 0;

        let prefix = "cc -o ";
        prefix.copy_to_nonoverlapping(&cmd[pos]);
        pos += prefix.len();

        output.copy_to_nonoverlapping(&cmd[pos]);
        pos += output.len();

        cmd[pos] = ' ';
        pos += 1;

        obj_file.copy_to_nonoverlapping(&cmd[pos]);
        pos += obj_file.len();

        let suffix = " -lm";
        suffix.copy_to_nonoverlapping(&cmd[pos]);
        pos += suffix.len();

        if self.options.debug_info {
            let dbg_flag = " -g";
            dbg_flag.copy_to_nonoverlapping(&cmd[pos]);
            pos += dbg_flag.len();
        }

        if !extra.is_empty() {
            cmd[pos] = ' ';
            pos += 1;
            extra.copy_to_nonoverlapping(&cmd[pos]);
            pos += extra.len();
        }

        cmd[pos] = 0u8;

        let result = libc::system(&cmd[0] as &libc::c_char);

        // Clean up temp file
        let _ = std::fs::remove_file(Path::new(obj_file));

        result == 0i32
    }

    /// Given a module path like "aluminac::ast", resolve or create
    /// the nested module scope hierarchy, returning the innermost scope.
    fn resolve_or_create_module_scope(self: &mut Compiler, root_scope: u32, module_path: &[u8]) -> u32 {
        let current = root_scope;
        let iter = std::string::split(module_path, "::");
        loop {
            let seg = iter.next();
            if seg.is_none() { break; }
            let s = seg.unwrap();
            if !s.is_empty() {
                current = self.ensure_module_scope(current, s);
            }
        }
        current
    }

    /// Ensure a child module scope exists under parent, or create one.
    fn ensure_module_scope(self: &mut Compiler, parent: u32, name: &[u8]) -> u32 {
        // Try to resolve existing module
        let existing = self.scopes.resolve(parent, name);
        if existing.is_some() {
            let item = existing.unwrap();
            if item.kind.tag == NamedItemTag::Module {
                return item.kind.scope_idx;
            }
        }

        // Create new module scope
        let child = self.scopes.create_scope(ScopeKind::Module, Option::some(parent));
        self.scopes.add_item(parent, NamedItem {
            name: self.intern_name(name),
            kind: NamedItemKind::module(child),
            span: Span::empty(),
        });
        child
    }

    fn intern_name(self: &mut Compiler, s: &[u8]) -> &[u8] {
        let buf = self.arena.alloc_slice::<u8>(s.len());
        s.copy_to_nonoverlapping(&buf[0]);
        buf
    }

    fn register_builtins(self: &mut Compiler, scope_idx: u32) {
        // Register builtin types
        let builtins: [(&[u8], BuiltinType); 17] = [
            ("void", BuiltinType::Void),
            ("bool", BuiltinType::Bool),
            ("u8", BuiltinType::U8),
            ("u16", BuiltinType::U16),
            ("u32", BuiltinType::U32),
            ("u64", BuiltinType::U64),
            ("u128", BuiltinType::U128),
            ("usize", BuiltinType::USize),
            ("i8", BuiltinType::I8),
            ("i16", BuiltinType::I16),
            ("i32", BuiltinType::I32),
            ("i64", BuiltinType::I64),
            ("i128", BuiltinType::I128),
            ("isize", BuiltinType::ISize),
            ("f32", BuiltinType::F32),
            ("f64", BuiltinType::F64),
            ("never", BuiltinType::Never),
        ];

        for i in 0usize..17 {
            let (name, bt) = builtins[i];
            self.scopes.add_item(scope_idx, NamedItem {
                name: name,
                kind: NamedItemKind::builtin_type(bt),
                span: Span::empty(),
            });
        }
    }

    fn free(self: &mut Compiler) {
        self.options.cfg_flags.free();
        self.scopes.free();
        self.diag.free();
        self.source_files.free();
        self.all_items.free();
        self.arena.free();
    }
}

// ============================================================
// CLI entry point
// ============================================================

struct SourceArg {
    module_path: &[u8],
    file_path: &[u8],
}

fn parse_args(args: &[&[u8]]) -> (CompilerOptions, Vector<SourceArg>) {
    let options = CompilerOptions::default();
    let files: Vector<SourceArg> = Vector::new();

    let i: usize = 1; // skip program name
    while i < args.len() {
        let arg = args[i];

        if arg == "-o" {
            i += 1;
            if i < args.len() {
                options.output_file = args[i];
            }
        } else if arg == "-S" {
            options.output_format = OutputFormat::Assembly;
        } else if arg == "-c" {
            options.output_format = OutputFormat::Object;
        } else if arg == "--emit-llvm" {
            options.output_format = OutputFormat::LlvmIr;
        } else if arg == "--emit-bc" {
            options.output_format = OutputFormat::Bitcode;
        } else if arg == "-O0" {
            options.optimize = OptLevel::O0;
        } else if arg == "-O" || arg == "-O1" {
            options.optimize = OptLevel::O1;
        } else if arg == "-O2" {
            options.optimize = OptLevel::O2;
        } else if arg == "-O3" {
            options.optimize = OptLevel::O3;
        } else if arg == "-Os" {
            options.optimize = OptLevel::Os;
        } else if arg == "-g" {
            options.debug_info = true;
        } else if arg == "--dump-ir" {
            options.dump_ir = true;
        } else if arg == "--no-verify" {
            options.verify_ir = false;
        } else if arg == "--link-args" {
            i += 1;
            if i < args.len() {
                options.extra_link_args = args[i];
            }
        } else if arg == "--sysroot" {
            i += 1;
            if i < args.len() {
                options.sysroot = args[i];
            }
        } else if arg == "--cfg" {
            i += 1;
            if i < args.len() {
                options.cfg_flags.push(args[i]);
            }
        } else if arg == "--test" {
            options.test_mode = true;
            // `--test` implies `--cfg test` so source-level
            // `#[cfg(all(test, ...))]` gates evaluate correctly.
            // Mirrors alumina-boot which auto-adds the same flag.
            let has_test = options.cfg_flags.iter().any(|e: &[u8]| -> bool { e == "test" });
            if !has_test {
                options.cfg_flags.push("test");
            }
        } else if arg == "--help" || arg == "-h" {
            print_usage();
            exit(0i32);
        } else if !arg.is_empty() && arg[0] != '-' {
            // Check for module::path=file.alu format
            let eq_pos = arg.iter().find_index(|e: u8| -> bool { e == '=' });
            if eq_pos.is_some() {
                let idx = eq_pos.unwrap();
                files.push(SourceArg {
                    module_path: arg[0..idx],
                    file_path: arg[idx + 1..arg.len()],
                });
            } else {
                files.push(SourceArg {
                    module_path: "",
                    file_path: arg,
                });
            }
        } else {
            eprintln!("unknown option");
        }

        i += 1;
    }

    (options, files)
}

fn print_usage() {
    eprintln!("Usage: aluminac [options] <source-files...>\nOptions:\n  -o <file>     Output file (default: a.out)\n  -S            Emit assembly\n  -c            Emit object file\n  -g            Emit DWARF debug info (line tables)\n  --emit-llvm   Emit LLVM IR\n  --emit-bc     Emit LLVM bitcode\n  --dump-ir     Dump LLVM IR to stderr\n  --sysroot     Path to sysroot\n  -O/-O1/-O2/-O3/-Os  Enable optimizations\n  --help, -h    Show this help");
}

/// Auto-populate ABI-derived cfg flags so that `#[cfg(target_arch = "...")]`
/// in source files (notably src/aluminac/llvm.alu) evaluates correctly when
/// aluminac is the compiler. alumina-boot sets these from the host
/// environment automatically; aluminac historically relied on the user
/// passing `--cfg`, which bricks the bootstrap on aarch64 because the
/// target-specific LLVM initializer is gated on this cfg.
fn populate_host_cfgs(options: &mut CompilerOptions) {
    let triple_raw = aluminac::llvm::LLVMGetDefaultTargetTriple();
    let triple = std::ffi::CString::from_raw(triple_raw).as_slice();

    let arch: &[u8] = "";
    if triple.starts_with("x86_64") {
        arch = "target_arch=x86_64";
    } else if triple.starts_with("aarch64") {
        arch = "target_arch=aarch64";
    }
    if !arch.is_empty() && !already_has_key(&options.cfg_flags, "target_arch") {
        options.cfg_flags.push(arch);
    }

    // Pick target_os out of the triple — typically of form arch-vendor-os-env.
    // We only need to recognize the OSes sysroot/libc/mod.alu cares about.
    let os: &[u8] = "";
    if triple.contains("linux") {
        os = "target_os=linux";
    } else if triple.contains("darwin") {
        os = "target_os=macos";
    } else if triple.contains("android") {
        os = "target_os=android";
    } else if triple.contains("freebsd") {
        os = "target_os=freebsd";
    } else if triple.contains("netbsd") {
        os = "target_os=netbsd";
    } else if triple.contains("openbsd") {
        os = "target_os=openbsd";
    } else if triple.contains("windows") {
        os = "target_os=windows";
    }
    if !os.is_empty() && !already_has_key(&options.cfg_flags, "target_os") {
        options.cfg_flags.push(os);
    }

    // target_pointer_width — needed by sysroot's `count_ones`/etc. when-arms
    // that branch on `usize`. Default to 64 on the supported architectures.
    // Stored unquoted; eval_cfg_meta_item strips quotes from source values.
    let ptr_width: &[u8] = "";
    if triple.starts_with("x86_64") || triple.starts_with("aarch64") {
        ptr_width = "target_pointer_width=64";
    } else if triple.starts_with("i686") || triple.starts_with("i386") {
        ptr_width = "target_pointer_width=32";
    }

    // target_env — sysroot/libc/bindings.alu's c_char and friends branch on
    // `target_env = "gnu"` / `"musl"`. Without this, those typedefs fail to
    // resolve and downstream uses silently become void.
    let env: &[u8] = "";
    if triple.contains("gnu") {
        env = "target_env=gnu";
    } else if triple.contains("musl") {
        env = "target_env=musl";
    } else if triple.contains("android") {
        env = "target_env=";
    } else if triple.contains("darwin") || triple.contains("macos") {
        // Apple platforms have no separate target_env; sysroot's cfgs
        // for macos don't gate on target_env so leave it unset.
        env = "";
    }
    if !env.is_empty() && !already_has_key(&options.cfg_flags, "target_env") {
        options.cfg_flags.push(env);
    }

    // target_endian — sysroot's `to_le` / `to_be` / etc. branch on this. Both
    // x86_64 and aarch64 (Linux) are little-endian; aarch64-be exists but is
    // not a target we currently support. Note the value is stored unquoted
    // here — eval_cfg_meta_item strips the quotes from source-level
    // `target_endian = "little"` before matching.
    let endian: &[u8] = "target_endian=little";
    if !endian.is_empty() && !already_has_key(&options.cfg_flags, "target_endian") {
        options.cfg_flags.push(endian);
    }
    if !ptr_width.is_empty() && !already_has_key(&options.cfg_flags, "target_pointer_width") {
        options.cfg_flags.push(ptr_width);
    }

    aluminac::llvm::LLVMDisposeMessage(triple_raw);
}

fn already_has_key(flags: &Vector<&[u8]>, key: &[u8]) -> bool {
    for i in 0usize..flags.len() {
        let f = flags[i];
        if f.len() > key.len() && f[key.len()] == '=' {
            let same = true;
            for j in 0usize..key.len() {
                if f[j] != key[j] { same = false; break; }
            }
            if same { return true; }
        }
    }
    false
}

fn main(args: &[&[u8]]) -> i32 {
    let (options, files) = parse_args(args);
    populate_host_cfgs(&options);

    let compiler = Compiler::new(options);

    // Load sysroot files first (they go into module scopes like "std::mem", etc.)
    if !compiler.load_sysroot() {
        files.free();
        compiler.free();
        return 1i32;
    }

    for i in 0usize..files.len() {
        if !compiler.add_source_file(files[i].file_path, files[i].module_path) {
            files.free();
            compiler.free();
            return 1i32;
        }
    }

    let success = compiler.compile();
    files.free();
    compiler.free();

    if success { 0i32 } else { 1i32 }
}
