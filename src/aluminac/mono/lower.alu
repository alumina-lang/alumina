// Monomorphization lowering engine
//
// Contains the Mono struct and all its methods: type resolution, expression lowering,
// method dispatch, operator overloads, protocol conformance, type inference, and intrinsics.

use mono::*;
use ast::*;
use scope::*;
use diagnostics::DiagnosticContext;
use aluminac_common::arena::Arena;
use std::collections::{HashMap, HashSet, Vector};
use std::option::Option;

struct Mono {
    ctx: &mut MonoCtx,
    // Generic type parameter substitutions
    type_map: HashMap<usize, &IrTy>,   // placeholder id -> concrete type
    // Local variable types
    local_types: HashMap<usize, &IrTy>,
    // Local variable defs accumulated during lowering
    local_defs: Vector<IrLocalDef>,
    // Return type of the current function
    return_type: &IrTy,
    // Current function name for debugging
    current_fn_name: &[u8],
    // Expected type hint for return type inference (e.g. from if-else sibling branch)
    expected_type: &IrTy,
    // Suppress field errors when lowering call target (method error takes priority)
    suppress_field_error: bool,
    // Compile-time constant replacements for static for loop variables.
    // When a local ID is in this map, lower_variable produces a literal instead of a Local ref.
    const_replacements: HashMap<usize, ConstValue>,
    // Mono cache_key of the function whose body we are currently lowering.
    // Nested fns (`fn` declared inside another fn's body) mix this into their
    // own cache key so that each outer instantiation produces its own mono of
    // the nested fn — necessary because the nested fn's body resolves outer
    // placeholders through type_map, and a single shared mono would lock in
    // whichever outer's types arrived first.
    current_mono_key: u64,
    // Recursion depth counter for `check_method_bounds_satisfied`. Capped to
    // prevent unbounded chains on pathologically nested types
    // (e.g. Option<Option<Option<...>>>).
    bound_check_depth: usize,
    // Stack of active `loop { ... }` contexts. Pushed on entry to a loop,
    // popped on exit. Each entry tracks the slot the `break value;` paths
    // assign into and the resolved break-value type — set on the first
    // break with a value, then re-used by subsequent breaks in the same
    // loop. Empty stack means no enclosing loop (or a `break` outside a
    // loop, which is rejected upstream).
    loop_contexts: Vector<LoopContext>,
    // True while walking args inside `infer_type_args` (recursively).
    // Guards the direct-Placeholder return-type-from-hint branch from
    // picking up the OUTER caller's expected_type / return_type — see
    // the comment in `infer_type_args` for context.
    inside_arg_inference: bool,
}

struct LoopContext {
    // Fresh local id for the result slot. Only registered in local_defs if
    // a break-with-value lowered through this context (`has_value` flips
    // to true and the type is committed).
    result_slot_id: Id,
    // Unified break-value type. Starts as Void; on the first break with a
    // value, set to the value's IR type. Subsequent breaks should produce
    // the same type — aluminac's inference is too weak to unify divergent
    // shapes here, so the first break wins.
    break_value_ty: &IrTy,
    has_value: bool,
}

impl Mono {
    fn new(ctx: &mut MonoCtx) -> Mono {
        Mono {
            ctx: ctx,
            type_map: HashMap::new(),
            local_types: HashMap::new(),
            local_defs: Vector::new(),
            return_type: ctx.void_ty,
            current_fn_name: "",
            expected_type: ctx.void_ty,
            suppress_field_error: false,
            const_replacements: HashMap::new(),
            current_mono_key: 0u64,
            bound_check_depth: 0usize,
            loop_contexts: Vector::new(),
            inside_arg_inference: false,
        }
    }

    fn with_substitutions(ctx: &mut MonoCtx, type_map: HashMap<usize, &IrTy>) -> Mono {
        Mono {
            ctx: ctx,
            type_map: type_map,
            local_types: HashMap::new(),
            local_defs: Vector::new(),
            return_type: ctx.void_ty,
            current_fn_name: "",
            expected_type: ctx.void_ty,
            suppress_field_error: false,
            current_mono_key: 0u64,
            bound_check_depth: 0usize,
            loop_contexts: Vector::new(),
            inside_arg_inference: false,
        }
    }

    // ---- IR node construction helpers ----
    // These reduce the 3-4 line boilerplate for constructing common IR nodes.

    // Emit a CodeDiagnostic. The actual error always goes through —
    // multiple cascading failures from the same root cause used to be
    // hidden behind a !has_errors guard, which masked second-order
    // problems. Dedup in emit_all suppresses adjacent duplicate spans.
    // Mono stack notes still fire only for the FIRST error per
    // compilation so deep instantiation chains don't repeat on every
    // cascading error.
    fn emit_diag(self: &mut Mono, diag: diagnostics::CodeDiagnostic) {
        let first_error = !self.ctx.diag.has_errors;
        self.ctx.diag.emit(diag);
        if first_error {
            self.ctx.emit_mono_stack_notes();
        }
    }

    fn mk_int_lit(self: &mut Mono, ty: &IrTy, val: u64) -> &IrExpr {
        let e = IrExpr::void_expr(ty);
        e.tag = IrTag::IntLit;
        e._data.lit.int_val = val;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_bool_lit(self: &mut Mono, val: bool) -> &IrExpr {
        let e = IrExpr::void_expr(self.ctx.bool_ty);
        e.tag = IrTag::BoolLit;
        e._data.lit.bool_val = val;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_local(self: &mut Mono, id: Id, ty: &IrTy) -> &IrExpr {
        let e = IrExpr::void_expr(ty);
        e.tag = IrTag::Local;
        e._data.var.id = id;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_field(self: &mut Mono, obj: &IrExpr, idx: u32, ty: &IrTy) -> &IrExpr {
        let e = IrExpr::void_expr(ty);
        e.tag = IrTag::FieldAccess;
        e._data.field.lhs = obj;
        e._data.field.field_idx = idx;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_let(self: &mut Mono, id: Id, ty: &IrTy, init: &IrExpr) -> &IrExpr {
        let e = IrExpr::void_expr(self.ctx.void_ty);
        e.tag = IrTag::Let;
        e._data.let_data.id = id;
        e._data.let_data.ir_ty = ty;
        e._data.let_data.opt_expr = Option::some(init);
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_let_uninit(self: &mut Mono, id: Id, ty: &IrTy) -> &IrExpr {
        let e = IrExpr::void_expr(self.ctx.void_ty);
        e.tag = IrTag::Let;
        e._data.let_data.id = id;
        e._data.let_data.ir_ty = ty;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_block(self: &mut Mono, stmts: &[&IrExpr]) -> &IrExpr {
        // alumina-boot's fill_block (src/alumina-boot/src/ir/builder.rs)
        // treats a diverging statement as the block's *return* — anything
        // after it is dead code that the IR drops entirely. parse_block
        // appends a synthetic Void when the trailing statement has `;`, so a
        // block like `{ unwrap_panic(); }` (else-arm in a Result::unwrap-style
        // helper) lands here as [unwrap_panic_call (!), Void (())]. Without
        // this trim, the synthetic Void becomes the block's value and the
        // surrounding if-expression sees `()` instead of `!`, breaking
        // unification with a value-producing then-arm.
        let n = stmts.len();
        let effective_stmts = stmts;
        if n >= 2usize && stmts[n - 1usize].tag == IrTag::Void && stmts[n - 2usize].ty.is_never() {
            effective_stmts = stmts[..n - 1usize];
        }
        let m = effective_stmts.len();
        let ty = if m == 0usize { self.ctx.void_ty } else { effective_stmts[m - 1usize].ty };
        let e = IrExpr::void_expr(ty);
        e.tag = IrTag::Block;
        e._data.block.items = effective_stmts;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_block_void(self: &mut Mono, stmts: &[&IrExpr]) -> &IrExpr {
        let e = IrExpr::void_expr(self.ctx.void_ty);
        e.tag = IrTag::Block;
        e._data.block.items = stmts;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_ref(self: &mut Mono, inner: &IrExpr, is_const: bool) -> &IrExpr {
        let ptr_ty = self.ctx.make_ptr_ty(inner.ty, is_const);
        let e = IrExpr::void_expr(ptr_ty);
        e.tag = IrTag::Ref;
        e._data.single.lhs = inner;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_deref(self: &mut Mono, ptr: &IrExpr, ty: &IrTy) -> &IrExpr {
        let e = IrExpr::void_expr(ty);
        e.tag = IrTag::Deref;
        e._data.single.lhs = ptr;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_assign(self: &mut Mono, lhs: &IrExpr, rhs: &IrExpr) -> &IrExpr {
        let e = IrExpr::void_expr(self.ctx.void_ty);
        e.tag = IrTag::Assign;
        e._data.assign.lhs = lhs;
        e._data.assign.rhs = rhs;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_binary(self: &mut Mono, op: BinOp, lhs: &IrExpr, rhs: &IrExpr, ty: &IrTy) -> &IrExpr {
        let e = IrExpr::void_expr(ty);
        e.tag = IrTag::Binary;
        e._data.bin.bin_op = op;
        e._data.bin.lhs = lhs;
        e._data.bin.rhs = rhs;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_cast(self: &mut Mono, expr: &IrExpr, ty: &IrTy) -> &IrExpr {
        let e = IrExpr::void_expr(ty);
        e.tag = IrTag::Cast;
        e._data.cast.lhs = expr;
        e._data.cast.ir_ty = ty;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_call(self: &mut Mono, fn_ref: IrFnRef, args: &[&IrExpr], ret_ty: &IrTy) -> &IrExpr {
        let e = IrExpr::void_expr(ret_ty);
        e.tag = IrTag::Call;
        e._data.call.call_target = IrCallTarget { tag: CallKind::Direct, fn_ref: fn_ref, callee: null };
        e._data.call.items = args;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_if(self: &mut Mono, cond: &IrExpr, then_br: &IrExpr, else_br: Option<&IrExpr>) -> &IrExpr {
        let e = IrExpr::void_expr(then_br.ty);
        e.tag = IrTag::If;
        e._data.if_data.cond = cond;
        e._data.if_data.lhs = then_br;
        e._data.if_data.opt_expr = else_br;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    fn mk_index(self: &mut Mono, base: &IrExpr, idx: &IrExpr, ty: &IrTy) -> &IrExpr {
        let e = IrExpr::void_expr(ty);
        e.tag = IrTag::Index;
        e._data.idx.lhs = base;
        e._data.idx.rhs = idx;
        self.ctx.arena.alloc(e) as &IrExpr
    }

    // Resolve an AST type to a concrete IR type
    fn resolve_type(self: &mut Mono, ty: &Ty) -> &IrTy {
        switch ty.tag {
            TyTag::Builtin => self.ctx.intern_builtin_ty(ty.builtin()),
            TyTag::Placeholder => {
                let resolved = self.type_map.get(&ty.id()._value);
                if resolved.is_some() {
                    resolved.unwrap()
                } else {
                    self.ctx.void_ty
                }
            }
            TyTag::Pointer => {
                // Special case: &[T] and &mut [T] are fat pointers (slice type)
                if ty.inner().tag == TyTag::Slice {
                    let elem_ty = self.resolve_type(ty.inner().inner());
                    return self.ctx.make_slice_ty(elem_ty, ty.is_const());
                }
                let inner_ty = self.resolve_type(ty.inner());
                self.ctx.make_ptr_ty(inner_ty, ty.is_const())
            }
            TyTag::Slice => {
                let inner_ty = self.resolve_type(ty.inner());
                self.ctx.make_slice_ty(inner_ty, ty.is_const())
            }
            TyTag::Array => {
                let inner_ty = self.resolve_type(ty.inner());
                let size: usize = if ty.typeof_expr() as &void as usize != 0 {
                    let ir_size = self.lower_expr(ty.typeof_expr());
                    let val = self.try_const_eval_u64(ir_size);
                    if val.is_some() {
                        val.unwrap() as usize
                    } else {
                        ty.array_size()
                    }
                } else {
                    ty.array_size()
                };
                self.ctx.make_array_ty(inner_ty, size)
            }
            TyTag::Tuple => {
                let resolved = self.ctx.arena.alloc_slice::<&IrTy>(ty.elems().len());
                for i in 0usize..ty.elems().len() {
                    resolved[i] = self.resolve_type(ty.elems()[i]);
                }
                self.ctx.make_tuple_ty(resolved)
            }
            TyTag::FnPointer => {
                let resolved_params = self.ctx.arena.alloc_slice::<&IrTy>(ty.elems().len());
                for i in 0usize..ty.elems().len() {
                    resolved_params[i] = self.resolve_type(ty.elems()[i]);
                }
                let resolved_ret = self.resolve_type(ty.ret_ty());
                self.ctx.make_fn_ptr_ty(resolved_params, resolved_ret)
            }
            TyTag::Named => {
                let item_ref = ItemRef { id: ty.id() };
                self.resolve_named_type(item_ref, &[])
            }
            TyTag::Generic => {
                let resolved_args = self.ctx.arena.alloc_slice::<&IrTy>(ty.elems().len());
                for i in 0usize..ty.elems().len() {
                    resolved_args[i] = self.resolve_type(ty.elems()[i]);
                }
                if ty.inner().tag == TyTag::Named {
                    let item_ref = ItemRef { id: ty.inner().id() };
                    self.resolve_named_type(item_ref, resolved_args)
                } else {
                    self.resolve_type(ty.inner())
                }
            }
            TyTag::Never => self.ctx.never_ty,
            TyTag::DerefOf => {
                // `*T` in type position resolves to T's pointee. After
                // placeholder substitution, T is a concrete pointer type.
                let inner_ir = self.resolve_type(ty.inner());
                if inner_ir.tag == IrTyTag::Pointer {
                    inner_ir.inner()
                } else {
                    self.ctx.void_ty
                }
            }
            TyTag::Dyn => {
                // `&dyn Proto` (or `&dyn (A + B + ...)`) — resolve to the
                // lang(dyn) struct from sysroot (`struct dyn<Protos, Ptr>`).
                // The Ptr type-arg is `&void` (or `&mut void` depending on
                // mutability) since dyn erases the underlying pointee type.
                // Multi-protocol bounds: parser passes a Tuple Ty whose
                // elements are the individual protocols; we unwrap to build
                // a Protos tuple.
                let dyn_lang_id = self.ctx.get_lang_item("dyn");
                if dyn_lang_id.is_none() {
                    return self.ctx.void_ty;
                }
                let sd = self.ctx.struct_defs.get(&dyn_lang_id.unwrap());
                if sd.is_none() {
                    return self.ctx.void_ty;
                }
                let inner_ast = ty.inner();
                let void_ty = self.ctx.void_ty;
                let ptr_ty = self.ctx.make_ptr_ty(void_ty, ty.is_const());
                let protos_tuple: &IrTy;
                if inner_ast.tag == TyTag::Tuple {
                    let n = inner_ast.elems().len();
                    let protos = self.ctx.arena.alloc_slice::<&IrTy>(n);
                    for pi in 0usize..n {
                        protos[pi] = self.resolve_type(inner_ast.elems()[pi]);
                    }
                    protos_tuple = self.ctx.make_tuple_ty(protos);
                } else {
                    let inner_ir = self.resolve_type(inner_ast);
                    let protos = self.ctx.arena.alloc_slice::<&IrTy>(1);
                    protos[0] = inner_ir;
                    protos_tuple = self.ctx.make_tuple_ty(protos);
                }
                let dyn_args = self.ctx.arena.alloc_slice::<&IrTy>(2);
                dyn_args[0] = protos_tuple;
                dyn_args[1] = ptr_ty;
                self.mono_struct(sd.unwrap(), dyn_args)
            }
            TyTag::Typeof => {
                let result = self.lower_expr(ty.typeof_expr());
                result.ty
            }
            TyTag::When => {
                let cond_ir = self.lower_expr(ty.typeof_expr());
                let cond_val = self.try_const_eval_bool(cond_ir);
                if cond_val.is_some() && cond_val.unwrap() {
                    self.resolve_type(ty.inner())
                } else {
                    self.resolve_type(ty.ret_ty())
                }
            }
            TyTag::Unresolved => self.ctx.void_ty,
            _ => self.ctx.void_ty,
        }
    }

    /// Resolve the type of a struct literal, using type hints when explicit type args are absent.
    /// When a generic struct is referenced without type args (e.g. `TakeIterator { ... }`),
    /// uses the function's return type as a hint, matching alumina-boot's type_hint mechanism.
    fn resolve_struct_lit_type(self: &mut Mono, expr: &Expr) -> &IrTy {
        let ir_ty = self.resolve_type(expr.ty());

        // Only apply hints when the type is a struct with generic params but no type args
        if ir_ty.tag != IrTyTag::Struct || ir_ty.struct_ref().type_args.len() > 0 {
            return ir_ty;
        }
        let sd = self.ctx.struct_defs.get(&ir_ty.struct_ref().id._value);
        if sd.is_none() || sd.unwrap().generic_params.len() == 0 {
            return ir_ty;
        }

        // Hint 0: caller-supplied expected_type matches the same struct.
        // Set by lower_expr_coerced when the struct lit appears in a
        // typed context — e.g. an outer struct literal's field value
        // where the outer field's declared type pins the inner struct's
        // type-args. Without this, field-based inference (hint 2) can
        // bind only those generics that appear directly in field types,
        // and "phantom" generics like FusedIterator's T (no field has
        // type T) silently collapse to void. That mis-mono'd
        // FusedIterator<…, void> miscompiles `chain` (the second leg
        // reads from a void-typed Option slot instead of Option<T>).
        if self.expected_type.tag == IrTyTag::Struct
            && self.expected_type.struct_ref().id._value == ir_ty.struct_ref().id._value
            && self.expected_type.struct_ref().type_args.len() > 0 {
            return self.expected_type;
        }

        // Hint 1: function return type matches the same struct
        if self.return_type.tag == IrTyTag::Struct {
            if self.return_type.struct_ref().id._value == ir_ty.struct_ref().id._value
                && self.return_type.struct_ref().type_args.len() > 0 {
                return self.return_type;
            }
        }

        // Hint 2: field-based type inference from the struct literal's field values
        let struct_def = sd.unwrap();
        let inferred = self.ctx.arena.alloc_slice::<&IrTy>(struct_def.generic_params.len());
        let inferred_count = 0usize;
        for i in 0usize..struct_def.generic_params.len() {
            inferred[i] = self.ctx.void_ty;
        }

        for fi in 0usize..expr.field_inits().len() {
            let field_name = expr.field_inits()[fi].name;
            // Find matching field in struct definition
            for di in 0usize..struct_def.fields.len() {
                if struct_def.fields[di].name == field_name {
                    let field_ast_ty = struct_def.fields[di].ty;
                    let value_ir = self.lower_expr(expr.field_inits()[fi].value);
                    let value_ty = value_ir.ty;
                    // Try to match field type against value type to infer generic params
                    // Handle &mut T pattern: field is Pointer(Placeholder), value is Pointer(concrete)
                    if field_ast_ty.tag == TyTag::Pointer && field_ast_ty.inner().tag == TyTag::Placeholder {
                        let target_ty = if value_ty.tag == IrTyTag::Pointer { value_ty.inner() } else { value_ty };
                        for gi in 0usize..struct_def.generic_params.len() {
                            if struct_def.generic_params[gi].id._value == field_ast_ty.inner().id()._value {
                                inferred[gi] = target_ty;
                                inferred_count = inferred_count + 1usize;
                                break;
                            }
                        }
                    }
                    // Handle direct Placeholder: field is Placeholder, value is concrete
                    if field_ast_ty.tag == TyTag::Placeholder {
                        for gi in 0usize..struct_def.generic_params.len() {
                            if struct_def.generic_params[gi].id._value == field_ast_ty.id()._value {
                                inferred[gi] = value_ty;
                                inferred_count = inferred_count + 1usize;
                                break;
                            }
                        }
                    }
                    break;
                }
            }
        }

        if inferred_count > 0 {
            return self.mono_struct(struct_def, inferred);
        }

        ir_ty
    }

    fn resolve_named_type(self: &mut Mono, item_ref: ItemRef, type_args: &[&IrTy]) -> &IrTy {
        // Check if it's a struct
        let struct_def = self.ctx.struct_defs.get(&item_ref.id._value);
        if struct_def.is_some() {
            let sd = struct_def.unwrap();
            // Check for lang item structs that represent builtin types
            for attr in sd.attributes {
                if attr.tag == AttrTag::Lang {
                    let lang = attr.str_val();
                    let bt = Mono::lang_name_to_builtin(lang);
                    if bt as i32 != BuiltinType::Void as i32 {
                        return self.ctx.intern_builtin_ty(bt);
                    }
                    // #[lang(slice)] with type arg Ptr: slice<&T> → IrTyTag::Slice
                    if lang == "slice" && type_args.len() == 1 {
                        let ptr_ty = type_args[0];
                        if ptr_ty.tag == IrTyTag::Pointer {
                            return self.ctx.make_slice_ty(ptr_ty.inner(), ptr_ty.is_const());
                        }
                    }
                }
            }
            return self.mono_struct(sd, type_args);
        }

        // Check if it's an enum
        let enum_def = self.ctx.enum_defs.get(&item_ref.id._value);
        if enum_def.is_some() {
            return self.mono_enum(enum_def.unwrap(), type_args);
        }

        // Check if it's a type alias
        let ta = self.ctx.type_aliases.get(&item_ref.id._value);
        if ta.is_some() {
            let alias = ta.unwrap();
            // Set up type parameter substitution
            if alias.generic_params.len() > 0 && type_args.len() > 0 {
                for i in 0usize..std::cmp::min(alias.generic_params.len(), type_args.len()) {
                    self.type_map.insert(alias.generic_params[i].id._value, type_args[i]);
                }
            }

            // Compiler-evaluated typeop type aliases (e.g. arguments_of<F>,
            // return_type_of<F>) have an opaque target — recognize them by
            // their #[lang(typeop_…)] attribute and dispatch.
            for attr in alias.attributes {
                if attr.tag == AttrTag::Lang {
                    let lang = attr.str_val();
                    if lang == "typeop_arguments_of" && type_args.len() >= 1 {
                        let f = type_args[0];
                        let fn_id_for_args: usize = 0;
                        let have_fn = false;
                        if f.tag == IrTyTag::Fn {
                            fn_id_for_args = f.fn_item_ref().id._value;
                            have_fn = true;
                        } else if f.tag == IrTyTag::Closure {
                            // Closure's first IR-fn parameter is the env pointer; the
                            // user-visible argument tuple skips it.
                            fn_id_for_args = f.closure_fn().id._value;
                            have_fn = true;
                        }
                        if have_fn {
                            // Match on (id, mangled_name) — multiple monos of
                            // the same source function share `id`, so we need
                            // the mangled_name to pick the specific one the
                            // type-arg `f` actually points at.
                            let target_mangled = if f.tag == IrTyTag::Closure {
                                f.closure_fn().mangled_name
                            } else {
                                f.fn_item_ref().mangled_name
                            };
                            for i in 0usize..self.ctx.ir_functions.len() {
                                if self.ctx.ir_functions[i].id._value == fn_id_for_args
                                    && self.ctx.ir_functions[i].mangled_name == target_mangled {
                                    let params = self.ctx.ir_functions[i].params;
                                    let skip: usize = if f.tag == IrTyTag::Closure { 1 } else { 0 };
                                    let n = if params.len() >= skip { params.len() - skip } else { 0 };
                                    let elems = self.ctx.arena.alloc_slice::<&IrTy>(n);
                                    for j in 0usize..n {
                                        elems[j] = params[j + skip].ty;
                                    }
                                    return self.ctx.make_tuple_ty(elems);
                                }
                            }
                        } else if f.tag == IrTyTag::FnPointer {
                            // FnPointer stores params in elems and return type separately.
                            let params = f.elems();
                            let elems = self.ctx.arena.alloc_slice::<&IrTy>(params.len());
                            for j in 0usize..params.len() {
                                elems[j] = params[j];
                            }
                            return self.ctx.make_tuple_ty(elems);
                        }
                    } else if lang == "typeop_return_type_of" && type_args.len() >= 1 {
                        let f = type_args[0];
                        let fn_id_for_ret: usize = 0;
                        let have_fn = false;
                        if f.tag == IrTyTag::Fn {
                            fn_id_for_ret = f.fn_item_ref().id._value;
                            have_fn = true;
                        } else if f.tag == IrTyTag::Closure {
                            fn_id_for_ret = f.closure_fn().id._value;
                            have_fn = true;
                        }
                        if have_fn {
                            // Same (id, mangled_name) rule as typeop_arguments_of —
                            // see comment there.
                            let target_mangled = if f.tag == IrTyTag::Closure {
                                f.closure_fn().mangled_name
                            } else {
                                f.fn_item_ref().mangled_name
                            };
                            for i in 0usize..self.ctx.ir_functions.len() {
                                if self.ctx.ir_functions[i].id._value == fn_id_for_ret
                                    && self.ctx.ir_functions[i].mangled_name == target_mangled {
                                    return self.ctx.ir_functions[i].return_type;
                                }
                            }
                        } else if f.tag == IrTyTag::FnPointer {
                            return f.ret_ty();
                        }
                    } else if lang == "typeop_function_pointer_of" && type_args.len() >= 1 {
                        // function_pointer_of<Args: Tuple, Ret = ()>: produce fn(Args...) -> Ret.
                        let args_ty = type_args[0];
                        let ret_ty = if type_args.len() >= 2 { type_args[1] } else { self.ctx.void_ty };
                        if args_ty.tag == IrTyTag::Tuple {
                            return self.ctx.make_fn_ptr_ty(args_ty.elems(), ret_ty);
                        }
                        // `()` (the unit tuple) collapses to void_ty in
                        // make_tuple_ty, so a zero-arg `function_pointer_of<(), Ret>`
                        // arrives here with args_ty.tag == Void. Treat as zero-args.
                        if args_ty.is_void() {
                            return self.ctx.make_fn_ptr_ty(&[], ret_ty);
                        }
                    } else if lang == "typeop_underlying_type_of" && type_args.len() >= 1 {
                        let t = type_args[0];
                        if t.tag == IrTyTag::Enum {
                            return t.enum_ref().underlying;
                        }
                        if t.tag == IrTyTag::Closure {
                            // Closure's underlying type is the Fn ZST it carries.
                            let fn_ref = t.closure_fn();
                            return self.ctx.make_fn_ty(fn_ref);
                        }
                        if t.tag == IrTyTag::ItemRef {
                            // const/static item-arg: recover the declared type.
                            let sd_opt = self.ctx.static_defs.get(&t.item_ref_id());
                            if sd_opt.is_some() {
                                let sd = sd_opt.unwrap();
                                if sd.ty.is_some() {
                                    return self.resolve_type(sd.ty.unwrap());
                                }
                                // No declared type — must be inferred from the
                                // initializer. Fall back to lowering the init
                                // expression's type.
                                if sd.init.is_some() {
                                    let init_ir = self.lower_expr(sd.init.unwrap());
                                    return init_ir.ty;
                                }
                            }
                        }
                    } else if lang == "typeop_pointer_with_mut_of" && type_args.len() >= 2 {
                        // pointer_with_mut_of<Ptr, RefForMutability>: produce a pointer to
                        // Ptr's pointee with the mutability of the second arg.
                        let p = type_args[0];
                        let m = type_args[1];
                        if p.tag == IrTyTag::Pointer && m.tag == IrTyTag::Pointer {
                            return self.ctx.make_ptr_ty(p.inner(), m.is_const());
                        }
                    } else if lang == "typeop_array_with_length_of" && type_args.len() >= 2 {
                        // array_with_length_of<T, Arr: Array>: produce [T; len(Arr)].
                        let elem = type_args[0];
                        let len_holder = type_args[1];
                        if len_holder.tag == IrTyTag::Array {
                            return self.ctx.make_array_ty(elem, len_holder.array_size());
                        }
                    } else if lang == "typeop_generic_args_of" && type_args.len() >= 1 {
                        // generic_args_of<T>: tuple of T's generic args.
                        // Aluminac's grammar doesn't (yet) allow generic enums, so the
                        // only kind that carries type-args is Struct.
                        let t = type_args[0];
                        if t.tag == IrTyTag::Struct {
                            return self.ctx.make_tuple_ty(t.struct_ref().type_args);
                        }
                        return self.ctx.make_tuple_ty(&[]);
                    } else if lang == "typeop_underlying_function_of" && type_args.len() >= 1 {
                        // underlying_function_of<T: Closure>: the closure's underlying Fn.
                        let t = type_args[0];
                        if t.tag == IrTyTag::Closure {
                            let fn_ref = t.closure_fn();
                            return self.ctx.arena.alloc(IrTy::mk_fn(fn_ref));
                        }
                    } else if lang == "typeop_replace_generic_args_of" && type_args.len() >= 2 {
                        // replace_generic_args_of<T, Args>: re-mono T with Args' tuple components
                        // as the new type-args.
                        let t = type_args[0];
                        let args_ty = type_args[1];
                        if args_ty.tag == IrTyTag::Tuple {
                            if t.tag == IrTyTag::Struct {
                                let id_val = t.struct_ref().id._value;
                                let sd = self.ctx.struct_defs.get(&id_val);
                                if sd.is_some() {
                                    return self.mono_struct(sd.unwrap(), args_ty.elems());
                                }
                            } else if t.tag == IrTyTag::Enum {
                                let id_val = t.enum_ref().id._value;
                                let ed = self.ctx.enum_defs.get(&id_val);
                                if ed.is_some() {
                                    return self.mono_enum(ed.unwrap(), args_ty.elems());
                                }
                            }
                        }
                    }
                }
            }

            let result = self.resolve_type(alias.target);
            return result;
        }

        // Check if it's a function — a Named type whose item is a fn produces a
        // zero-sized Fn type (so the function can be passed as a generic arg
        // and called via the resulting Fn-typed value, e.g. unit::<F>()).
        let fn_def = self.ctx.fn_defs.get(&item_ref.id._value);
        if fn_def.is_some() {
            let def = fn_def.unwrap();
            let fn_idx = self.mono_function(def, type_args);
            let ir_fn = &self.ctx.ir_functions[fn_idx];
            let fn_ref = IrFnRef { id: ir_fn.id, mangled_name: ir_fn.mangled_name };
            return self.ctx.arena.alloc(IrTy::mk_fn(fn_ref));
        }

        // Protocols don't have a runtime representation, but their identity
        // (and type-args) matter for `is`-checks (e.g. `x is Integer`) and
        // for the dyn-vtable builder, which needs the protocol's non-Self
        // type-args to mono each impl-method. Capture the def-id and the
        // resolved type-args so the TypeCheck path and the vtable builder
        // can recover them after substitution.
        let proto_def = self.ctx.protocol_defs.get(&item_ref.id._value);
        if proto_def.is_some() {
            return self.ctx.arena.alloc(IrTy::mk_protocol_with_args(item_ref.id._value, type_args));
        }

        // Const/static items used as type-args (`underlying_type_of<MY_CONST>`,
        // `value_of::<MY_CONST>`). Both kinds live in static_defs; the
        // `is_const` flag distinguishes them. The resulting IrTy::ItemRef
        // is consumed by typeop_underlying_type_of (to recover the declared
        // type) and intrinsics::value_of (to emit a load/StaticRef).
        let static_def = self.ctx.static_defs.get(&item_ref.id._value);
        if static_def.is_some() {
            let sd = static_def.unwrap();
            return self.ctx.arena.alloc(IrTy::mk_item_ref(item_ref.id._value, sd.is_const));
        }

        self.ctx.void_ty
    }

    fn mono_struct(self: &mut Mono, def: &StructDef, type_args: &[&IrTy]) -> &IrTy {
        // Check cache
        let cache_key = hash_mono_key(def.id, type_args);
        let cached = self.ctx.struct_ty_cache.get(&cache_key);
        if cached.is_some() {
            return cached.unwrap();
        }
        // Also check by id only for non-generic structs
        if type_args.len() == 0 {
            let id_cached = self.ctx.struct_ty_cache.get(&(def.id._value as u64));
            if id_cached.is_some() {
                return id_cached.unwrap();
            }
        }
        let cached2 = self.ctx.struct_cache.get(&cache_key);
        if cached2.is_some() {
            let idx = cached2.unwrap();
            let result = self.ctx.arena.alloc(IrTy::mk_struct(self.ctx.ir_structs[idx]));
            self.ctx.struct_ty_cache.insert(cache_key, result);
            if type_args.len() == 0 {
                self.ctx.struct_ty_cache.insert(def.id._value as u64, result);
            }
            return result;
        }

        // Set up generic substitution
        if def.generic_params.len() > 0 && type_args.len() > 0 {
            for i in 0usize..std::cmp::min(def.generic_params.len(), type_args.len()) {
                self.type_map.insert(def.generic_params[i].id._value, type_args[i]);
            }
        }

        // Use scope_idx directly from StructDef
        let scope_idx = def.scope_idx;

        // Forward-declare: register the struct with empty fields BEFORE resolving field types.
        // This prevents infinite recursion for self-referential structs (e.g. Node { next: &mut Node }).
        let placeholder_fields = self.ctx.arena.alloc_slice::<IrField>(0);
        let is_packed = false;
        for j in 0usize..def.attributes.len() {
            if def.attributes[j].tag == AttrTag::Packed {
                is_packed = true;
            }
        }
        let ir_struct = IrStructRef {
            id: def.id,
            name: def.name,
            fields: placeholder_fields,
            is_union: def.is_union,
            is_zero_sized: def.fields.len() == 0,
            scope_idx: scope_idx,
            type_args: type_args,
            is_packed: is_packed,
            attributes: def.attributes,
        };

        let idx = self.ctx.ir_structs.len();
        self.ctx.ir_structs.push(ir_struct);
        self.ctx.struct_cache.insert(cache_key, idx);

        // Create the IrTy NOW and cache it immediately. This ensures that recursive
        // references to this struct (e.g. Expr.lhs: &Expr) get the SAME IrTy instance.
        // We will update the fields in-place after resolving them.
        let result = self.ctx.arena.alloc(IrTy::mk_struct(ir_struct));
        self.ctx.struct_ty_cache.insert(cache_key, result);
        if type_args.len() == 0 {
            self.ctx.struct_ty_cache.insert(def.id._value as u64, result);
        }

        // Now resolve field types (may recurse back to this struct via pointer fields)
        let fields = self.ctx.arena.alloc_slice::<IrField>(def.fields.len());
        let is_zst = true;
        for i in 0usize..def.fields.len() {
            let field_ty = self.resolve_type(def.fields[i].ty);
            fields[i] = IrField {
                name: def.fields[i].name,
                ty: field_ty,
            };
            if !field_ty.is_zero_sized() {
                is_zst = false;
            }
        }

        if def.fields.len() == 0 {
            is_zst = true;
        }

        // Update both the ir_structs entry AND the cached IrTy in-place
        self.ctx.ir_structs[idx].fields = fields;
        self.ctx.ir_structs[idx].is_zero_sized = is_zst;
        result._data.struct_ref.fields = fields;
        result._data.struct_ref.is_zero_sized = is_zst;
        result
    }

    fn mono_enum(self: &mut Mono, def: &EnumDef, type_args: &[&IrTy]) -> &IrTy {
        let cache_key = hash_mono_key(def.id, type_args);
        let cached = self.ctx.enum_cache.get(&cache_key);
        if cached.is_some() {
            let idx = cached.unwrap();
            return self.ctx.arena.alloc(IrTy::mk_enum(self.ctx.ir_enums[idx]));
        }

        // Determine underlying type
        let underlying = if def.underlying_type.is_some() {
            self.resolve_type(def.underlying_type.unwrap())
        } else {
            self.ctx.intern_builtin_ty(BuiltinType::I32)
        };

        // Two-pass approach matching alumina-boot:
        // 1) Process variants with explicit values first
        // 2) Auto-increment non-valued variants from 0, skipping taken values
        let variants = self.ctx.arena.alloc_slice::<IrEnumVariant>(def.variants.len());
        let taken_values: HashSet<u64> = HashSet::new();

        // Pass 1: evaluate all explicit values
        for i in 0usize..def.variants.len() {
            if def.variants[i].value.is_some() {
                let val_expr = def.variants[i].value.unwrap();
                let ir_expr = self.lower_expr(val_expr);
                let const_val = self.try_const_eval_u64(ir_expr);
                if const_val.is_some() {
                    let v = const_val.unwrap();
                    taken_values.insert(v);
                    variants[i] = IrEnumVariant {
                        name: def.variants[i].name,
                        value: v,
                    };
                } else {
                    // Fallback: treat as 0 if const eval fails
                    variants[i] = IrEnumVariant {
                        name: def.variants[i].name,
                        value: 0u64,
                    };
                }
            }
        }

        // Pass 2: assign auto-increment values to non-valued variants
        let counter: u64 = 0;
        for i in 0usize..def.variants.len() {
            if !def.variants[i].value.is_some() {
                // Find next value not already taken
                while taken_values.contains(&counter) {
                    counter = counter + 1;
                }
                taken_values.insert(counter);
                variants[i] = IrEnumVariant {
                    name: def.variants[i].name,
                    value: counter,
                };
                counter = counter + 1;
            }
        }

        // Use scope_idx directly from EnumDef
        let enum_scope_idx = def.scope_idx;

        let ir_enum = IrEnumRef {
            id: def.id,
            name: def.name,
            underlying: underlying,
            variants: variants,
            scope_idx: enum_scope_idx,
            attributes: def.attributes,
        };

        let idx = self.ctx.ir_enums.len();
        self.ctx.ir_enums.push(ir_enum);
        self.ctx.enum_cache.insert(cache_key, idx);

        self.ctx.arena.alloc(IrTy::mk_enum(self.ctx.ir_enums[idx]))
    }

    fn mono_function(self: &mut Mono, def: &FnDef, type_args: &[&IrTy]) -> usize {
        // Protocol method redirect: if this function has no body, it may be a protocol
        // method declaration. Try to find the concrete implementation on the target type.
        if def.body.is_none() && def.abi.is_none() {
            // First try with explicit type_args
            if type_args.len() > 0 {
                let redirect = self.try_protocol_redirect(def, type_args);
                if redirect.is_some() {
                    return redirect.unwrap();
                }
            }
            // Also try using type_map to find the Self type for protocol methods
            let self_param_id_opt = self.ctx.proto_method_self_id.get(&def.id._value);
            if self_param_id_opt.is_some() {
                let self_ty_opt = self.type_map.get(&self_param_id_opt.unwrap());
                if self_ty_opt.is_some() {
                    let ta = self.ctx.arena.alloc_slice::<&IrTy>(1);
                    ta[0] = self_ty_opt.unwrap();
                    let redirect = self.try_protocol_redirect(def, ta);
                    if redirect.is_some() {
                        return redirect.unwrap();
                    }
                }
            }
        }

        // Skip intrinsic functions - they should be handled inline in lower_intrinsic
        if def.abi.is_some() && def.abi.unwrap() == "intrinsic" {
            // Return a dummy index - intrinsics should never actually be called
            let cache_key = hash_mono_key(def.id, type_args);
            let cached = self.ctx.fn_cache.get(&cache_key);
            if cached.is_some() {
                return cached.unwrap();
            }
            // Intrinsics should be intercepted in lower_call, not reach here
            // But if they do (e.g. as function references), create a dummy
            return 0usize; // Will cause issues if actually used, but shouldn't be
        }

        let prev_fn_name = self.current_fn_name;
        self.current_fn_name = def.name;


        let cache_key = hash_mono_key(def.id, type_args);
        // Nested fns (declared inside another fn's body) inherit the outer
        // fn's generic context lexically. Mix the outer mono's cache_key
        // into the nested fn's so that each outer instantiation produces
        // its own copy — otherwise the first mono of the nested fn locks
        // in whichever placeholders the outer happened to bind first.
        if self.ctx.local_fn_ids.get(&def.id._value).is_some() {
            cache_key = cache_key ^ self.current_mono_key;
            cache_key = cache_key * 1099511628211u64;
        }
        // Mix in the protocol-generic bindings (Self + protocol's other
        // generics) for protocol-derived methods. After the FnDef-shape
        // refactor, those generics are no longer in `def.generic_params`
        // and so don't appear in `type_args` — but they DO change the
        // mono'd body. Without mixing them in, two distinct instantiations
        // (e.g. `sum<SliceIterator<i32>, i32>` and `sum<SliceIterator<usize>,
        // usize>`) collapse onto the same cache_key and the first one's
        // body wins.
        let proto_gp_ids_opt = self.ctx.proto_method_proto_gp_ids.get(&def.id._value);
        if proto_gp_ids_opt.is_some() {
            let pgp_ids = proto_gp_ids_opt.unwrap();
            for k in 0usize..pgp_ids.len() {
                let bound_opt = self.type_map.get(&pgp_ids[k]);
                if bound_opt.is_some() {
                    let p_addr = bound_opt.unwrap() as &void as usize as u64;
                    cache_key = cache_key ^ (p_addr * 0x9e3779b97f4a7c15u64);
                    cache_key = cache_key * 1099511628211u64;
                }
            }
        }
        let cached = self.ctx.fn_cache.get(&cache_key);
        if cached.is_some() {
            self.current_fn_name = prev_fn_name;
            return cached.unwrap();
        }

        // Push mono stack frame and check depth
        self.ctx.push_mono_frame(def.name, def.span);
        if self.ctx.check_mono_depth(def.span) {
            self.ctx.pop_mono_frame();
            self.current_fn_name = prev_fn_name;
            return 0usize;
        }

        // Save state for nested mono_function calls
        let prev_return_type = self.return_type;
        let prev_local_types = self.local_types;
        let prev_local_defs = self.local_defs;
        self.local_types = HashMap::new();
        self.local_defs = Vector::new();

        // Snapshot any *prior* type_map bindings for this fn's generic
        // params. After body lowering we restore the entries that were
        // bound before so a recursive mono with different type_args
        // doesn't leave the outer context's bindings overwritten.
        let saved_gp = self.ctx.arena.alloc_slice::<&IrTy>(def.generic_params.len());
        let had_gp = self.ctx.arena.alloc_slice::<bool>(def.generic_params.len());
        for gi in 0usize..def.generic_params.len() {
            let gp_id = def.generic_params[gi].id._value;
            let old = self.type_map.get(&gp_id);
            if old.is_some() {
                saved_gp[gi] = old.unwrap();
                had_gp[gi] = true;
            } else {
                had_gp[gi] = false;
            }
        }
        let proto_ids: &[usize] = &[];
        let proto_save_vals = self.ctx.arena.alloc_slice::<&IrTy>(0);
        let proto_save_had = self.ctx.arena.alloc_slice::<bool>(0);
        let proto_gp_snap = self.ctx.proto_method_proto_gp_ids.get(&def.id._value);
        if proto_gp_snap.is_some() {
            proto_ids = proto_gp_snap.unwrap();
            proto_save_vals = self.ctx.arena.alloc_slice::<&IrTy>(proto_ids.len());
            proto_save_had = self.ctx.arena.alloc_slice::<bool>(proto_ids.len());
            for k in 0usize..proto_ids.len() {
                let prev = self.type_map.get(&proto_ids[k]);
                if prev.is_some() {
                    proto_save_vals[k] = prev.unwrap();
                    proto_save_had[k] = true;
                } else {
                    proto_save_had[k] = false;
                }
            }
        }
        let self_id_v: usize = 0usize;
        let self_id_have = false;
        let self_id_val: &IrTy = self.ctx.void_ty;
        let self_id_had = false;
        let self_id_snap = self.ctx.proto_method_self_id.get(&def.id._value);
        if self_id_snap.is_some() {
            self_id_v = self_id_snap.unwrap();
            self_id_have = true;
            let prev_self = self.type_map.get(&self_id_v);
            if prev_self.is_some() {
                self_id_val = prev_self.unwrap();
                self_id_had = true;
            }
        }

        // Set up generic substitution
        if def.generic_params.len() > 0 && type_args.len() > 0 {
            for i in 0usize..std::cmp::min(def.generic_params.len(), type_args.len()) {
                self.type_map.insert(def.generic_params[i].id._value, type_args[i]);
            }
        }
        // Fill in defaults for any generic param whose type-arg slot is missing
        // (caller supplied fewer than declared) or void (inference couldn't bind
        // it). Required for sysroot signatures like
        // `fn hash_of<T, H = DefaultHash>(val: &T)` — H is never an explicit arg
        // and has no inference path from the value's type.
        for i in 0usize..def.generic_params.len() {
            let needs_default = if i >= type_args.len() {
                true
            } else {
                type_args[i].is_void()
            };
            if needs_default && def.generic_params[i].default_ty.is_some() {
                let default_ir = self.resolve_type(def.generic_params[i].default_ty.unwrap());
                if !default_ir.is_void() {
                    self.type_map.insert(def.generic_params[i].id._value, default_ir);
                }
            }
        }

        // Resolve parameter types
        let params = self.ctx.arena.alloc_slice::<IrParam>(def.params.len());
        for i in 0usize..def.params.len() {
            let param_ty = self.resolve_type(def.params[i].ty);
            params[i] = IrParam {
                id: def.params[i].id,
                ty: param_ty,
                name: def.params[i].name,
            };
            self.local_types.insert(def.params[i].id._value, param_ty);
        }

        // Resolve return type
        self.return_type = self.resolve_type(def.return_type);

        // Determine mangled name. Precedence:
        // 1. #[link_name("foo")] always wins — overrides every other choice.
        // 2. extern functions keep their declared name (looked up by that name at link time).
        // 3. #[export] or #[main] keeps the declared name.
        // 4. Otherwise, run name-mangling.
        let link_name: Option<&[u8]> = Option::none();
        let keep_name = false;
        for attr in def.attributes {
            if attr.tag == AttrTag::LinkName {
                link_name = Option::some(attr.str_val());
            } else if attr.tag == AttrTag::Export {
                keep_name = true;
            } else if attr.tag == AttrTag::Main {
                keep_name = true;
            } else if attr.tag == AttrTag::NoMangle {
                keep_name = true;
            }
        }
        let mangled = if link_name.is_some() {
            link_name.unwrap()
        } else if def.abi.is_some() {
            def.name
        } else if keep_name {
            def.name
        } else {
            self.ctx.mangle_name(def.name)
        };

        // Reserve index and cache it BEFORE lowering the body
        // to handle recursive functions
        let idx = self.ctx.ir_functions.len();
        let placeholder = IrFunction {
            id: def.id,
            name: def.name,
            mangled_name: mangled,
            params: params,
            return_type: self.return_type,
            body: Option::none(),
            local_defs: &[],
            attributes: def.attributes,
            is_variadic: def.is_variadic,
            abi: def.abi,
            span: def.span,
            type_args: type_args,
        };
        self.ctx.ir_functions.push(placeholder);
        self.ctx.fn_cache.insert(cache_key, idx);

        // Update the mono-context fingerprint so nested fns we encounter
        // while lowering the body key their cache against this mono.
        let prev_mono_key = self.current_mono_key;
        self.current_mono_key = cache_key;

        // Lower body (may recursively call mono_function)
        let body: Option<&IrExpr> = if def.body.is_some() {
            let body_ir = self.lower_expr_coerced(def.body.unwrap(), self.return_type);
            let body_ir = self.check_and_coerce(body_ir, self.return_type, def.body.unwrap().span);
            Option::some(body_ir)
        } else {
            Option::none()
        };

        self.current_mono_key = prev_mono_key;

        // Restore the *previously-bound* type_map entries.
        for gi in 0usize..def.generic_params.len() {
            if had_gp[gi] {
                self.type_map.insert(def.generic_params[gi].id._value, saved_gp[gi]);
            }
        }
        for k in 0usize..proto_ids.len() {
            if proto_save_had[k] {
                self.type_map.insert(proto_ids[k], proto_save_vals[k]);
            }
        }
        if self_id_have && self_id_had {
            self.type_map.insert(self_id_v, self_id_val);
        }

        // Collect local defs
        let local_defs_slice = self.ctx.arena.alloc_slice_copy::<IrLocalDef>(self.local_defs.as_slice());

        // Update the placeholder with the actual body and local defs
        self.ctx.ir_functions[idx].body = body;
        self.ctx.ir_functions[idx].local_defs = local_defs_slice;

        // Restore saved state
        self.return_type = prev_return_type;
        self.local_types = prev_local_types;
        self.local_defs = prev_local_defs;
        self.current_fn_name = prev_fn_name;
        self.ctx.pop_mono_frame();
        idx
    }

    // Lower an AST expression to IR, stamping the source span onto the result
    fn lower_expr(self: &mut Mono, expr: &Expr) -> &IrExpr {
        let result = self.lower_expr_inner(expr);
        // Stamp the AST span onto the IR expression
        if expr.span.start != 0u32 || expr.span.end != 0u32 {
            let m = result as &void as &mut IrExpr;
            m.span = expr.span;
        }
        result
    }

    // Lower an AST expression to IR (dispatcher)
    fn lower_expr_inner(self: &mut Mono, expr: &Expr) -> &IrExpr {
        switch expr.tag {
            ExprTag::IntLit, ExprTag::FloatLit, ExprTag::BoolLit,
            ExprTag::StringLit, ExprTag::NullLit, ExprTag::CharLit =>
                self.lower_literal(expr),
            ExprTag::Local, ExprTag::Param, ExprTag::FnRef,
            ExprTag::EnumRef, ExprTag::StaticRef =>
                self.lower_variable(expr),
            ExprTag::Binary, ExprTag::Unary, ExprTag::Assign =>
                self.lower_binop(expr),
            ExprTag::When => self.lower_when(expr),
            ExprTag::If, ExprTag::While, ExprTag::Loop, ExprTag::For,
            ExprTag::Switch, ExprTag::Break, ExprTag::Continue, ExprTag::Return =>
                self.lower_control_flow(expr),
            ExprTag::Ref, ExprTag::Deref, ExprTag::FieldAccess,
            ExprTag::TupleIndex, ExprTag::Index, ExprTag::Cast, ExprTag::TypeCheck =>
                self.lower_memory(expr),
            ExprTag::Call, ExprTag::StructLit, ExprTag::TurbofishValue =>
                self.lower_call(expr),
            ExprTag::Block, ExprTag::Let, ExprTag::Defer =>
                self.lower_block(expr),
            ExprTag::TupleLit => {
                let ir_elems = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args().len());
                let elem_types = self.ctx.arena.alloc_slice::<&IrTy>(expr.args().len());
                // Propagate expected element types into the per-component
                // lowering so that integer / float literals pick up the right
                // type (e.g. `(u32_val, 1)` returning `(u32, usize)` should
                // see the second arm as usize, not the i32 default).
                let expected_tuple: &IrTy = self.expected_type;
                let n = expr.args().len();
                let has_tuple_hint = expected_tuple as &void as usize != 0usize
                    && expected_tuple.tag == IrTyTag::Tuple
                    && expected_tuple.elems().len() == n;
                for i in 0usize..n {
                    ir_elems[i] = if has_tuple_hint {
                        self.lower_expr_coerced(expr.args()[i], expected_tuple.elems()[i])
                    } else {
                        self.lower_expr(expr.args()[i])
                    };
                    elem_types[i] = ir_elems[i].ty;
                }
                let tuple_ty = self.ctx.make_tuple_ty(elem_types);
                let result = IrExpr::void_expr(tuple_ty);
                result.tag = IrTag::TupleLit;
                result._data.block.items = ir_elems;
                self.ctx.arena.alloc(result)
            }
            ExprTag::ArrayLit => {
                // Propagate the expected element type into per-element
                // lowering so call inference can solve generics from the
                // expected dyn / struct shape (e.g. an array of
                // `&dyn Formattable<Self, F>` infers F at each call site).
                // Also handle the common shape `&[T]` (pointer-to-slice)
                // since `&[arr_lit]` coerces from `*[T; N]` to `&[T]`.
                let expected_elem_ty: &IrTy = self.ctx.void_ty;
                if self.expected_type.tag == IrTyTag::Array {
                    expected_elem_ty = self.expected_type.inner();
                } else if self.expected_type.tag == IrTyTag::Slice {
                    expected_elem_ty = self.expected_type.inner();
                } else if self.expected_type.tag == IrTyTag::Pointer
                    && self.expected_type.inner().tag == IrTyTag::Slice {
                    expected_elem_ty = self.expected_type.inner().inner();
                } else if self.expected_type.tag == IrTyTag::Pointer
                    && self.expected_type.inner().tag == IrTyTag::Array {
                    expected_elem_ty = self.expected_type.inner().inner();
                }
                let ir_elems = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args().len());
                let elem_ty = self.ctx.void_ty;
                for i in 0usize..expr.args().len() {
                    if !expected_elem_ty.is_void() {
                        ir_elems[i] = self.lower_expr_coerced(expr.args()[i], expected_elem_ty);
                    } else {
                        ir_elems[i] = self.lower_expr(expr.args()[i]);
                    }
                    if i == 0 { elem_ty = ir_elems[i].ty; }
                }
                let arr_ty = self.ctx.make_array_ty(elem_ty, expr.args().len());
                let result = IrExpr::void_expr(arr_ty);
                result.tag = IrTag::ArrayLit;
                result._data.block.items = ir_elems;
                self.ctx.arena.alloc(result)
            }
            ExprTag::Lambda => self.lower_lambda(expr),
            ExprTag::BoundValue => self.lower_bound_value(expr),
            ExprTag::Void => {
                let result = IrExpr::void_expr(self.ctx.void_ty);
                self.ctx.arena.alloc(result)
            }
            ExprTag::Zeroed => {
                if expr.ty() as &void as usize == 0usize {
                    let result = IrExpr::void_expr(self.ctx.void_ty);
                    result.tag = IrTag::Zeroed;
                    self.ctx.arena.alloc(result)
                } else {
                    let ir_ty = self.resolve_type(expr.ty());
                    let result = IrExpr::void_expr(ir_ty);
                    result.tag = IrTag::Zeroed;
                    self.ctx.arena.alloc(result)
                }
            }
            ExprTag::Range => {
                // Lower range literals to one of six structs based on which
                // endpoints are present and inclusivity:
                //
                //   ..       -> RangeFull<T>          (lang item: range_full)
                //   a..      -> RangeFrom<T>          (lang item: range_from)
                //   ..b      -> RangeTo<T>            (lang item: range_to)
                //   ..=b     -> RangeToInclusive<T>   (lang item: range_to_inclusive)
                //   a..b     -> Range<T>              (lang item: range)
                //   a..=b    -> RangeInclusive<T>     (lang item: range_inclusive)
                //
                // The element type T is inferred from the present operand. When
                // both are present they must agree (else fallback to usize); when
                // neither is present (RangeFull), T defaults to usize.
                let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);

                let has_lower = expr.lhs() as &void as usize != 0;
                let has_upper = expr.rhs() as &void as usize != 0;
                let is_inclusive = expr.flag();

                let raw_lower = if has_lower { self.lower_expr(expr.lhs()) } else { null as &IrExpr };
                let raw_upper = if has_upper { self.lower_expr(expr.rhs()) } else { null as &IrExpr };

                let elem_ty: &IrTy = if has_lower && has_upper {
                    if raw_lower.ty as &void == raw_upper.ty as &void {
                        raw_lower.ty
                    } else {
                        usize_ty
                    }
                } else if has_lower {
                    raw_lower.ty
                } else if has_upper {
                    raw_upper.ty
                } else {
                    usize_ty
                };

                let lang_name: &[u8] = if has_lower && has_upper {
                    if is_inclusive { "range_inclusive" } else { "range" }
                } else if has_lower {
                    "range_from"
                } else if has_upper {
                    if is_inclusive { "range_to_inclusive" } else { "range_to" }
                } else {
                    "range_full"
                };

                let lang_id = self.ctx.get_lang_item(lang_name);
                let sd_opt = if lang_id.is_some() {
                    self.ctx.struct_defs.get(&lang_id.unwrap())
                } else {
                    Option::none()
                };

                // Fallback: lang item missing (sysroot doesn't define this
                // range variant yet, e.g. sysroot-aluminac without RangeFull).
                // Synthesize as Range<elem_ty>{0, max} matching the prior
                // behavior so existing aluminac sysroot stays compatible.
                if sd_opt.is_none() {
                    let fallback_id = self.ctx.get_lang_item(if is_inclusive { "range_inclusive" } else { "range" });
                    if fallback_id.is_none() {
                        let r = IrExpr::void_expr(self.ctx.void_ty);
                        return self.ctx.arena.alloc(r);
                    }
                    let fallback_sd = self.ctx.struct_defs.get(&fallback_id.unwrap());
                    if fallback_sd.is_none() {
                        let r = IrExpr::void_expr(self.ctx.void_ty);
                        return self.ctx.arena.alloc(r);
                    }
                    let ir_lower = if has_lower {
                        self.mk_cast(raw_lower, elem_ty)
                    } else {
                        self.mk_int_lit(elem_ty, 0u64)
                    };
                    let ir_upper = if has_upper {
                        self.mk_cast(raw_upper, elem_ty)
                    } else {
                        self.mk_int_lit(elem_ty, 18446744073709551615u64)
                    };
                    let type_args = self.ctx.arena.alloc_slice::<&IrTy>(1);
                    type_args[0] = elem_ty;
                    let range_ty = self.mono_struct(fallback_sd.unwrap(), type_args);
                    let fields = self.ctx.arena.alloc_slice::<&IrExpr>(if is_inclusive { 3usize } else { 2usize });
                    fields[0] = ir_lower;
                    fields[1] = ir_upper;
                    if is_inclusive {
                        fields[2] = self.mk_bool_lit(false);
                    }
                    let result = IrExpr::void_expr(range_ty);
                    result.tag = IrTag::StructLit;
                    result._data.struct_lit.ir_ty = range_ty;
                    result._data.struct_lit.items = fields;
                    return self.ctx.arena.alloc(result);
                }

                let sd = sd_opt.unwrap();
                let type_args = self.ctx.arena.alloc_slice::<&IrTy>(1);
                type_args[0] = elem_ty;
                let range_ty = self.mono_struct(sd, type_args);

                // Determine field count by lang variant. RangeFull = 0 fields,
                // RangeInclusive = 3 (lower, upper, _exhausted), others vary.
                let field_count: usize = if has_lower && has_upper {
                    if is_inclusive { 3usize } else { 2usize }
                } else if has_lower || has_upper {
                    1usize
                } else {
                    0usize
                };

                let fields = self.ctx.arena.alloc_slice::<&IrExpr>(field_count);
                let fi: usize = 0;
                if has_lower {
                    fields[fi] = self.mk_cast(raw_lower, elem_ty);
                    fi = fi + 1;
                }
                if has_upper {
                    fields[fi] = self.mk_cast(raw_upper, elem_ty);
                    fi = fi + 1;
                }
                if is_inclusive && has_lower && has_upper {
                    fields[fi] = self.mk_bool_lit(false);
                }
                let result = IrExpr::void_expr(range_ty);
                result.tag = IrTag::StructLit;
                result._data.struct_lit.ir_ty = range_ty;
                result._data.struct_lit.items = fields;
                self.ctx.arena.alloc(result)
            }
            ExprTag::StaticFor => self.lower_static_for(expr),
            _ => {
                // Unhandled expression tag — may be an unexpanded macro
                // invocation (`MacroInvocation`) that fell through parser
                // resolution. The cleaner fix is for the parser to either
                // expand or diagnose; today we silently produce `()` and
                // a number of sysroot-aluminac call sites rely on this for
                // unreachable `else when { compile_fail!(...) }` arms and
                // for not-yet-ported helpers like `test::assert_panics!`.
                // Promoting this to an error surfaces real silent bugs
                // (e.g. `errno_try!(libc::poll(...))` vanishing when the
                // macro isn't in scope, which is what was breaking the
                // io/mod.alu swap) — track it in PORTING_STATUS rather
                // than fixing here in one slice.
                let r = IrExpr::void_expr(self.ctx.void_ty);
                self.ctx.arena.alloc(r)
            }
        }
    }

    // Lower an expression with a type hint for unsuffixed literals
    fn lower_expr_coerced(self: &mut Mono, expr: &Expr, expected_ty: &IrTy) -> &IrExpr {
        // For unsuffixed integer literals, use the expected type directly
        if expr.tag == ExprTag::IntLit && expr.type_suffix().is_none() && expected_ty.tag == IrTyTag::Builtin {
            let r = self.mk_int_lit(expected_ty, expr.int_val());
            let m = r as &void as &mut IrExpr;
            m.span = expr.span;
            return r;
        }
        // Unsuffixed float literal being coerced to f32: re-parse via strtof
        // to avoid double-rounding (strtod-then-fptrunc gives a different
        // bit pattern from strtof for some values, breaking ryu's shortest-
        // decimal output). The raw text is stashed on the lit's str_val by
        // parse_float_literal for exactly this case.
        if expr.tag == ExprTag::FloatLit
            && expr.type_suffix().is_none()
            && expected_ty.tag == IrTyTag::Builtin
            && expected_ty.builtin() == BuiltinType::F32
            && expr.str_val().len() > 0
        {
            let v32 = aluminac::parser::parse_float_as_f32(expr.str_val());
            let result = IrExpr::void_expr(expected_ty);
            result.tag = IrTag::FloatLit;
            result._data.lit.float_val = v32 as f64;
            result.span = expr.span;
            return self.ctx.arena.alloc(result);
        }
        // Char literals default to u32 (Unicode codepoint) but coerce to the
        // expected integer builtin when one is supplied — e.g. `Option::some('\n')`
        // matched against `Option<u8>` should produce u8(10), not u32(10).
        // Without this, the `Option<u8>` comparison fails type-check at runtime
        // (different IR types) and downstream code paths silently use a
        // not-equal result — which is how `io::LineIterator::next` failed to
        // strip trailing newlines and test_lines blew up.
        if expr.tag == ExprTag::CharLit && expected_ty.tag == IrTyTag::Builtin {
            let r = self.mk_int_lit(expected_ty, expr.int_val());
            let m = r as &void as &mut IrExpr;
            m.span = expr.span;
            return r;
        }
        // For null literals, adopt the expected pointer type
        if expr.tag == ExprTag::NullLit && expected_ty.tag == IrTyTag::Pointer {
            let result = IrExpr::void_expr(expected_ty);
            result.tag = IrTag::NullLit;
            result.span = expr.span;
            return self.ctx.arena.alloc(result);
        }
        // Set expected_type hint for type inference in function calls.
        // Also clear `inside_arg_inference`: this call site has an
        // explicit, intentional hint (not leakage from an outer arg-walk),
        // so the direct-Placeholder return-type-from-hint branch should
        // fire normally inside. Without this, calls like
        // `Option { _inner: mem::uninitialized() }` lowered through a
        // struct-lit field would see the flag still true (the parent's
        // arg-walk left it set) and refuse to bind mem::uninitialized's T
        // from the field's type — instead it'd default to void.
        let saved_expected = self.expected_type;
        let saved_in_arg_inf = self.inside_arg_inference;
        self.expected_type = expected_ty;
        self.inside_arg_inference = false;
        let lowered = self.lower_expr(expr);
        self.expected_type = saved_expected;
        self.inside_arg_inference = saved_in_arg_inf;
        let coerced = self.coerce_int(lowered, expected_ty);
        self.coerce_to_type(coerced, expected_ty)
    }

    // Wrap an IR expression in an implicit cast if types differ
    fn coerce_int(self: &mut Mono, ir: &IrExpr, expected: &IrTy) -> &IrExpr {
        if ir.ty.tag == IrTyTag::Builtin && expected.tag == IrTyTag::Builtin && ir.ty != expected {
            // Both are builtin types but differ - insert an implicit cast
            return self.mk_cast(ir, expected);
        }
        // Coerce null literal to expected pointer type
        if ir.tag == IrTag::NullLit && expected.tag == IrTyTag::Pointer && ir.ty != expected {
            let result = IrExpr::void_expr(expected);
            result.tag = IrTag::NullLit;
            return self.ctx.arena.alloc(result);
        }
        ir
    }

    // Lower literal expressions: ExprTag::IntLit, ExprTag::FloatLit, ExprTag::BoolLit, ExprTag::StringLit, ExprTag::NullLit, ExprTag::CharLit
    fn lower_literal(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == ExprTag::IntLit {
            let ty = if expr.type_suffix().is_some() {
                self.ctx.intern_builtin_ty(expr.type_suffix().unwrap())
            } else {
                self.ctx.intern_builtin_ty(BuiltinType::I32) // default int type
            };
            self.mk_int_lit(ty, expr.int_val())
        } else if expr.tag == ExprTag::FloatLit {
            let ty = if expr.type_suffix().is_some() {
                self.ctx.intern_builtin_ty(expr.type_suffix().unwrap())
            } else {
                self.ctx.intern_builtin_ty(BuiltinType::F64)
            };
            let result = IrExpr::void_expr(ty);
            result.tag = IrTag::FloatLit;
            result._data.lit.float_val = expr.float_val();
            self.ctx.arena.alloc(result)
        } else if expr.tag == ExprTag::BoolLit {
            self.mk_bool_lit(expr.bool_val())
        } else if expr.tag == ExprTag::StringLit {
            // String literals are &[u8] - use IrTyTag::Slice type
            let u8_ty = self.ctx.intern_builtin_ty(BuiltinType::U8);
            let slice_ty = self.ctx.make_slice_ty(u8_ty, true);
            let result = IrExpr::void_expr(slice_ty);
            result.tag = IrTag::StringLit;
            result._data.lit.str_val = expr.str_val();
            self.ctx.arena.alloc(result)
        } else if expr.tag == ExprTag::NullLit {
            let void_ty = self.ctx.void_ty;
            let ptr_ty = self.ctx.make_ptr_ty(void_ty, false);
            let result = IrExpr::void_expr(ptr_ty);
            result.tag = IrTag::NullLit;
            self.ctx.arena.alloc(result)
        } else if expr.tag == ExprTag::CharLit {
            self.mk_int_lit(self.ctx.intern_builtin_ty(BuiltinType::U32), expr.int_val())
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower variable references: ExprTag::Local, ExprTag::Param, ExprTag::FnRef
    fn lower_variable(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == ExprTag::Local {
            // Check for compile-time constant replacement (static for loop variables)
            let const_val = self.const_replacements.get(&expr.id()._value);
            if const_val.is_some() {
                return self.constvalue_to_ir(const_val.unwrap(), self.ctx.void_ty);
            }
            let ty = self.local_types.get(&expr.id()._value);
            let local_ty = if ty.is_some() { ty.unwrap() } else {
                // HashMap miss - fall back to scanning local_defs vector
                let fallback_ty = self.ctx.void_ty;
                let found_in_defs = false;
                for scan_i in 0usize..self.local_defs.len() {
                    if self.local_defs[scan_i].id._value == expr.id()._value {
                        fallback_ty = self.local_defs[scan_i].ty;
                        found_in_defs = true;
                    }
                }
                fallback_ty
            };
            self.mk_local(expr.id(), local_ty)
        } else if expr.tag == ExprTag::Param {
            let ty = self.local_types.get(&expr.id()._value);
            let param_ty = if ty.is_some() { ty.unwrap() } else {
                self.ctx.void_ty
            };
            self.mk_local(expr.id(), param_ty)
        } else if expr.tag == ExprTag::FnRef {
            // Look up the function and get its type
            let fn_def = self.ctx.fn_defs.get(&expr.id()._value);
            if fn_def.is_some() {
                let def = fn_def.unwrap();
                let fn_idx = self.mono_function(def, &[]);
                let ir_fn = &self.ctx.ir_functions[fn_idx];

                // Build Fn type (ZST representing this specific function)
                let fn_ref = IrFnRef {
                    id: ir_fn.id,
                    mangled_name: ir_fn.mangled_name,
                };
                let fn_ty = self.ctx.make_fn_ty(fn_ref);

                let result = IrExpr::void_expr(fn_ty);
                result.tag = IrTag::FnRef;
                result._data.fn_ref = fn_ref;
                self.ctx.arena.alloc(result)
            } else {
                let name = if expr.str_val().len() > 0usize { expr.str_val() } else { "<unknown>" };
                if expr.str_val().len() > 0usize || expr.id()._value != 0usize {
                    self.emit_diag(diagnostics::CodeDiagnostic::unresolved_function(expr.span, name));
                }
                let result = IrExpr::void_expr(self.ctx.void_ty);
                result.tag = IrTag::NullLit;
                self.ctx.arena.alloc(result)
            }
        } else if expr.tag == ExprTag::StaticRef {
            // Look up the static/const definition
            let sd = self.ctx.static_defs.get(&expr.id()._value);
            if sd.is_some() {
                let def = sd.unwrap();
                // Emit as a global reference (both consts and statics)
                let ty = if def.ty.is_some() {
                    self.resolve_type(def.ty.unwrap())
                } else {
                    self.ctx.void_ty
                };

                // Ensure the global is emitted (non-extern statics are lazy)
                if !self.ctx.emitted_globals.contains(&def.id._value) {
                    self.ctx.emitted_globals.insert(def.id._value);
                    let init: Option<&IrExpr> = if def.init.is_some() {
                        let init_ir = if !ty.is_void() {
                            self.lower_expr_coerced(def.init.unwrap(), ty)
                        } else {
                            self.lower_expr(def.init.unwrap())
                        };
                        // If no explicit type, infer from init
                        if ty.is_void() {
                            ty = init_ir.ty;
                        }
                        // For consts, const-evaluate the init so codegen
                        // gets simple literals instead of arbitrary IR.
                        if def.is_const {
                            let (cv, panic_msg, warn_msg, note_msg) = self.try_const_eval_with_diags(init_ir);
                            let span = def.init.unwrap().span;
                            if warn_msg.len() > 0 {
                                self.emit_diag(diagnostics::CodeDiagnostic::generic_warning(span, warn_msg));
                            }
                            if note_msg.len() > 0 {
                                self.emit_diag(diagnostics::CodeDiagnostic::generic_note(span, note_msg));
                            }
                            if panic_msg.len() > 0 {
                                self.emit_diag(diagnostics::CodeDiagnostic::generic_error(span, panic_msg));
                            }
                            if cv.is_some() {
                                self.ctx.const_values.insert(def.id._value, cv.unwrap());
                                Option::some(self.constvalue_to_ir(cv.unwrap(), ty))
                            } else {
                                Option::some(init_ir)
                            }
                        } else {
                            Option::some(init_ir)
                        }
                    } else {
                        Option::none()
                    };
                    let is_extern = false;
                    let link_name: Option<&[u8]> = Option::none();
                    let keep_name = false;
                    for attr in def.attributes {
                        if attr.tag == AttrTag::Extern {
                            is_extern = true;
                        } else if attr.tag == AttrTag::LinkName {
                            link_name = Option::some(attr.str_val());
                        } else if attr.tag == AttrTag::Export {
                            keep_name = true;
                        } else if attr.tag == AttrTag::NoMangle {
                            keep_name = true;
                        }
                    }
                    let mangled = if link_name.is_some() {
                        link_name.unwrap()
                    } else if is_extern {
                        def.name
                    } else if keep_name {
                        def.name
                    } else {
                        // Per-def mangling — two fn-local `const X` in
                        // different fns would otherwise collide on def.name.
                        self.ctx.mangle_global_name(def.name, def.id._value)
                    };
                    self.ctx.ir_globals.push(IrGlobal {
                        id: def.id,
                        name: def.name,
                        mangled_name: mangled,
                        ty: ty,
                        init: init,
                        is_const: def.is_const,
                        is_extern: is_extern,
                        attributes: def.attributes,
                    });
                } else if ty.is_void() {
                    // Already emitted — look up the resolved type
                    for gi in 0usize..self.ctx.ir_globals.len() {
                        if self.ctx.ir_globals[gi].id._value == def.id._value {
                            ty = self.ctx.ir_globals[gi].ty;
                            break;
                        }
                    }
                }

                // Look up the IrGlobal's mangled_name from the cache so the
                // GlobalRef matches whatever the emit branch above produced.
                let global_mangled = def.name;
                for gi in 0usize..self.ctx.ir_globals.len() {
                    if self.ctx.ir_globals[gi].id._value == def.id._value {
                        global_mangled = self.ctx.ir_globals[gi].mangled_name;
                        break;
                    }
                }

                let result = IrExpr::void_expr(ty);
                result.tag = IrTag::GlobalRef;
                result._data.global_ref = IrGlobalRef {
                    id: def.id,
                    mangled_name: global_mangled,
                };
                self.ctx.arena.alloc(result)
            } else {
                let r = IrExpr::void_expr(self.ctx.void_ty);
                self.ctx.arena.alloc(r)
            }
        } else if expr.tag == ExprTag::EnumRef {
            // Look up enum and variant
            let enum_def = self.ctx.enum_defs.get(&expr.id()._value);
            if enum_def.is_some() {
                let def = enum_def.unwrap();
                let enum_ty = self.mono_enum(def, &[]);
                // Find variant value by matching variant id
                let variant_val: u64 = 0;
                for i in 0usize..def.variants.len() {
                    if def.variants[i].id._value == expr.id2()._value {
                        // Use the monomorphized variant value from IrEnumRef
                        variant_val = enum_ty.enum_ref().variants[i].value;
                        break;
                    }
                }
                // Use the underlying type for the literal
                self.mk_int_lit(enum_ty, variant_val)
            } else {
                let r = IrExpr::void_expr(self.ctx.void_ty);
                self.ctx.arena.alloc(r)
            }
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Map binary operator to its lang item name for operator overloading
    // Map builtin type to lang item name for method resolution
    fn builtin_lang_name(bt: BuiltinType) -> &[u8] {
        switch bt {
            BuiltinType::Bool => "builtin_bool",
            BuiltinType::U8 => "builtin_u8",
            BuiltinType::U16 => "builtin_u16",
            BuiltinType::U32 => "builtin_u32",
            BuiltinType::U64 => "builtin_u64",
            BuiltinType::U128 => "builtin_u128",
            BuiltinType::USize => "builtin_usize",
            BuiltinType::I8 => "builtin_i8",
            BuiltinType::I16 => "builtin_i16",
            BuiltinType::I32 => "builtin_i32",
            BuiltinType::I64 => "builtin_i64",
            BuiltinType::I128 => "builtin_i128",
            BuiltinType::ISize => "builtin_isize",
            BuiltinType::F32 => "builtin_f32",
            BuiltinType::F64 => "builtin_f64",
            _ => "",
        }
    }

    // Map lang item name to builtin type (reverse of builtin_lang_name)
    fn lang_name_to_builtin(name: &[u8]) -> BuiltinType {
        if name == "builtin_bool" { BuiltinType::Bool }
        else if name == "builtin_u8" { BuiltinType::U8 }
        else if name == "builtin_u16" { BuiltinType::U16 }
        else if name == "builtin_u32" { BuiltinType::U32 }
        else if name == "builtin_u64" { BuiltinType::U64 }
        else if name == "builtin_u128" { BuiltinType::U128 }
        else if name == "builtin_usize" { BuiltinType::USize }
        else if name == "builtin_i8" { BuiltinType::I8 }
        else if name == "builtin_i16" { BuiltinType::I16 }
        else if name == "builtin_i32" { BuiltinType::I32 }
        else if name == "builtin_i64" { BuiltinType::I64 }
        else if name == "builtin_i128" { BuiltinType::I128 }
        else if name == "builtin_isize" { BuiltinType::ISize }
        else if name == "builtin_f32" { BuiltinType::F32 }
        else if name == "builtin_f64" { BuiltinType::F64 }
        else if name == "builtin_never" { BuiltinType::Never }
        else { BuiltinType::Void } // sentinel: not a builtin
    }

    fn binop_lang_name(op: BinOp) -> &[u8] {
        switch op {
            BinOp::Eq => "operator_eq",
            BinOp::Ne => "operator_neq",
            BinOp::Lt => "operator_lt",
            BinOp::Le => "operator_lte",
            BinOp::Gt => "operator_gt",
            BinOp::Ge => "operator_gte",
            _ => "",
        }
    }

    // Map binary comparison operator to the method name to look up on the type.
    // These match the sysroot's Equatable/Comparable protocol methods.
    fn binop_method_name(op: BinOp) -> &[u8] {
        switch op {
            BinOp::Eq => "equals",
            BinOp::Ne => "not_equals",
            BinOp::Lt => "less_than",
            BinOp::Le => "less_than_or_equal",
            BinOp::Gt => "greater_than",
            BinOp::Ge => "greater_than_or_equal",
            _ => "",
        }
    }

    // Bind a protocol method's protocol-generic params (Self + others, in
    // declaration order) into `type_map` from a slice of concrete IR types.
    // The list of ids comes from `proto_method_proto_gp_ids` and was set when
    // the protocol was registered in `MonoCtx::build_lookup_tables`.
    //
    // Returns the number of `args` consumed (= the number of proto generics
    // bound). Callers should treat `args[returned_count..]` as remaining
    // method-own type args to forward to `mono_function`.
    //
    // For non-protocol-method FnDefs (impl methods), this is a no-op and
    // returns 0; the call flow proceeds as before.
    fn bind_proto_generics(self: &mut Mono, def: &FnDef, args: &[&IrTy]) -> usize {
        let ids_opt = self.ctx.proto_method_proto_gp_ids.get(&def.id._value);
        if !ids_opt.is_some() {
            return 0usize;
        }
        let ids = ids_opt.unwrap();
        let n = std::cmp::min(ids.len(), args.len());
        for i in 0usize..n {
            let id = ids[i];
            let arg = args[i];
            // Skip null slots only — those are "unknown slot" sentinels
            // (used by the dyn-vtable build path for placeholders the
            // dispatcher fills in elsewhere). DO bind to Void: it's the
            // actual concrete unit type `()` in aluminac (`make_tuple_ty(&[])`
            // returns `void_ty`). Skipping void here was the root cause of
            // test_fuse's "Option<()> rendered as Option<integer>" symptom:
            // for `from_fn(closure_returning_Option<()>).fuse()`, the
            // mixin-args resolution produced `[FromFnIterator<...>, void]`,
            // bind_proto_generics skipped the second slot, IteratorExt's T
            // stayed bound to whatever a prior test's mono had left
            // (e.g. i32 from `iter.next()` returning `Option<i32>`), and
            // `fuse()`'s return type `FusedIterator<Self, T>` came out as
            // `FusedIterator<FromFnIterator<...>, i32>` — propagating the
            // wrong T through `next()` and into the assert_eq mono.
            if arg as &void as usize == 0usize { continue; }
            self.type_map.insert(id, arg);
        }
        n
    }

    // Infer protocol-generic bindings (Self + protocol's other generics)
    // from the actual call's receiver and argument types, binding them into
    // `type_map`. Complementary to `bind_proto_generics`:
    //
    //   - `bind_proto_generics` binds from an explicit array (the mixin's
    //     `<...>` args, or the dyn type's proto args). It's used when the
    //     bindings are statically known from the dispatch context.
    //
    //   - This function fills in bindings the explicit arrays didn't supply,
    //     by unifying the protocol method's parameter types against the
    //     call's actual argument types — the same way `infer_type_args`
    //     does for a function's own generics. Mirrors alumina-boot's model
    //     where the protocol's generics aren't on the FnDef and have to
    //     come from the call site somehow.
    //
    // No-op for non-protocol-method FnDefs.
    fn infer_proto_generics_from_call(
        self: &mut Mono,
        def: &FnDef,
        receiver_ty: &IrTy,
        args: &[&Expr],
    ) {
        let ids_opt = self.ctx.proto_method_proto_gp_ids.get(&def.id._value);
        if !ids_opt.is_some() { return; }
        let ids = ids_opt.unwrap();
        if ids.len() == 0 { return; }

        // Synthesize a GenericParam slice keyed on the proto ids so we can
        // reuse the existing `unify_type_for_inference` machinery (which
        // matches placeholder ids against `generic_params[i].id`).
        let synthetic = self.ctx.arena.alloc_slice::<GenericParam>(ids.len());
        for i in 0usize..ids.len() {
            synthetic[i] = GenericParam {
                id: Id { _value: ids[i] },
                name: "_proto",
                bounds: &[],
                default_ty: Option::none(),
            };
        }
        let inferred = self.ctx.arena.alloc_slice::<&IrTy>(ids.len());
        let found = self.ctx.arena.alloc_slice::<bool>(ids.len());
        for i in 0usize..ids.len() {
            inferred[i] = self.ctx.void_ty;
            found[i] = false;
        }

        // Infer from receiver vs self param type.
        if def.params.len() > 0 {
            let self_param_ty = def.params[0].ty;
            let self_arg_ty = receiver_ty;
            if self_param_ty.tag == TyTag::Pointer {
                self_param_ty = self_param_ty.inner();
                if self_arg_ty.tag == IrTyTag::Pointer {
                    self_arg_ty = self_arg_ty.inner();
                }
            }
            self.unify_type_for_inference(self_param_ty, self_arg_ty, inferred, found, synthetic);
        }

        // Infer from explicit args (skipping self).
        let num_explicit = if def.params.len() > 0 { def.params.len() - 1 } else { 0usize };
        for p in 0usize..num_explicit {
            if p >= args.len() { break; }
            let param_ty = def.params[p + 1].ty;
            let arg_ty = self.lower_expr(args[p]).ty;
            self.unify_type_for_inference(param_ty, arg_ty, inferred, found, synthetic);
        }

        // Bind successful, non-void inferences. Skip void or unfound slots so
        // bindings the caller (e.g. `bind_proto_generics` from a mixin path)
        // may have already established are preserved.
        for i in 0usize..ids.len() {
            if found[i] && !inferred[i].is_void() {
                self.type_map.insert(ids[i], inferred[i]);
            }
        }
    }

    // Try to call an operator overload for a binary comparison on struct types.
    // Looks up the appropriate method (equals, less_than, etc.) directly on the type's scope,
    // creates references to both operands, and emits a call.
    // Look up a method by name in a type's scope and return its FnDef if found.
    fn find_method_in_scope(self: &mut Mono, ty: &IrTy, method_name: &[u8]) -> Option<&FnDef> {
        let scope_idx: u32 = 0u32;
        if ty.tag == IrTyTag::Struct {
            scope_idx = ty.struct_ref().scope_idx;
        } else if ty.tag == IrTyTag::Enum {
            scope_idx = ty.enum_ref().scope_idx;
        } else if ty.tag == IrTyTag::Slice {
            let lang_id = self.ctx.get_lang_item("slice");
            if lang_id.is_some() {
                let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                if sd.is_some() {
                    scope_idx = sd.unwrap().scope_idx;
                }
            }
        } else if ty.tag == IrTyTag::Tuple {
            let lang_id = self.ctx.get_lang_item("builtin_tuple");
            if lang_id.is_some() {
                let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                if sd.is_some() {
                    scope_idx = sd.unwrap().scope_idx;
                }
            }
        } else if ty.tag == IrTyTag::Builtin {
            // `T::method()` where T resolves to a builtin (i32 / u32 / …) —
            // look up the `#[lang(builtin_X)]` struct's scope so its methods
            // (`max_value`, `min_value`, …) are visible to lower_defered_call.
            // Surfaced by sysroot's `parse_integer<T: Integer>` body's
            // `T::max_value()`.
            let lang_name = Mono::builtin_lang_name(ty.builtin());
            if lang_name.len() > 0 {
                let lang_id = self.ctx.get_lang_item(lang_name);
                if lang_id.is_some() {
                    let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                    if sd.is_some() {
                        scope_idx = sd.unwrap().scope_idx;
                    }
                }
            }
        }
        if scope_idx == 0u32 {
            return Option::none();
        }

        let method_item = self.ctx.scopes.get(scope_idx).items.get(&method_name);
        if method_item.is_none() {
            return Option::none();
        }

        let item = method_item.unwrap();
        let fn_id_val = if item.kind.tag == scope::NamedItemTag::Method {
            item.kind.id2()._value
        } else if item.kind.tag == scope::NamedItemTag::Function {
            item.kind.id()._value
        } else {
            return Option::none();
        };

        self.ctx.fn_defs.get(&fn_id_val)
    }

    // Call a method on a type, monomorphizing it with the type's type args.
    fn call_method_on_type(self: &mut Mono, def: &FnDef, ty: &IrTy, ir_lhs: &IrExpr, ir_rhs: &IrExpr, ret_ty: &IrTy) -> &IrExpr {
        // Find the type's scope to consult mixin info.
        let scope_idx: u32 = 0u32;
        if ty.tag == IrTyTag::Struct {
            scope_idx = ty.struct_ref().scope_idx;
        } else if ty.tag == IrTyTag::Enum {
            scope_idx = ty.enum_ref().scope_idx;
        } else if ty.tag == IrTyTag::Slice {
            let lang_id = self.ctx.get_lang_item("slice");
            if lang_id.is_some() {
                let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                if sd.is_some() {
                    scope_idx = sd.unwrap().scope_idx;
                }
            }
        } else if ty.tag == IrTyTag::Tuple {
            let lang_id = self.ctx.get_lang_item("builtin_tuple");
            if lang_id.is_some() {
                let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                if sd.is_some() {
                    scope_idx = sd.unwrap().scope_idx;
                }
            }
        }

        // Mixin'd protocol methods (e.g. Equatable's `not_equals` reached via
        // `mixin Equatable<RangeFull<T>>`) take the protocol's generic args,
        // not the impl struct's own type args. Resolve them from the mixin
        // AST args, mapping the impl's generic-param ids to the struct's
        // concrete type args.
        let mixin_args_opt: Option<&[&Ty]> = if scope_idx != 0u32 {
            self.ctx.scopes.get_mixin_type_args(scope_idx, def.id._value)
        } else {
            Option::none()
        };

        let type_args: &[&IrTy] = if mixin_args_opt.is_some() {
            let ast_args = mixin_args_opt.unwrap();
            let impl_gp_ids = self.ctx.scopes.get_mixin_impl_generic_ids(scope_idx, def.id._value);
            if impl_gp_ids.is_some() {
                let ids = impl_gp_ids.unwrap();
                if ty.tag == IrTyTag::Struct {
                    let n_gp = std::cmp::min(ids.len(), ty.struct_ref().type_args.len());
                    for gi in 0usize..n_gp {
                        self.type_map.insert(ids[gi]._value, ty.struct_ref().type_args[gi]);
                    }
                } else if ty.tag == IrTyTag::Tuple && ids.len() == 1 {
                    // Tuple's impl is `impl tuple<Tup: Tuple>` — the single
                    // impl-generic Tup binds to the whole tuple type.
                    self.type_map.insert(ids[0]._value, ty);
                }
            }
            let resolved = self.ctx.arena.alloc_slice::<&IrTy>(ast_args.len());
            for i in 0usize..ast_args.len() {
                resolved[i] = self.resolve_type(ast_args[i]);
            }
            // Bind protocol generics (Self + others) via type_map; the
            // remaining slots after that are the method's own generics that
            // mono_function will assign positionally to def.generic_params.
            let consumed = self.bind_proto_generics(def, resolved);
            resolved[consumed..] as &[&IrTy]
        } else if ty.tag == IrTyTag::Slice {
            // Slice methods take Ptr as their type-arg (e.g. impl slice<Ptr>).
            // Variants:
            //   1 generic  -> [Ptr]            (e.g. fn len<Ptr>)
            //   2 generics -> [T, Ptr]         (e.g. fn equals<T, Ptr>)
            //   3 generics -> [T, Ptr, *void*] (e.g. fn hash<T, Ptr, H>:
            //                  H is method-only, can't be derived from
            //                  receiver — leave a void slot for inference
            //                  to fill in from the hasher arg).
            let elem_ty = self.slice_elem_ty(ty);
            let ptr_ty = self.ctx.make_ptr_ty(elem_ty, ty.is_const());
            if def.generic_params.len() == 3 {
                let ta = self.ctx.arena.alloc_slice::<&IrTy>(3);
                ta[0] = elem_ty;
                ta[1] = ptr_ty;
                ta[2] = self.ctx.void_ty;
                ta as &[&IrTy]
            } else if def.generic_params.len() == 2 {
                let ta = self.ctx.arena.alloc_slice::<&IrTy>(2);
                ta[0] = elem_ty;
                ta[1] = ptr_ty;
                ta as &[&IrTy]
            } else {
                let ta = self.ctx.arena.alloc_slice::<&IrTy>(1);
                ta[0] = ptr_ty;
                ta as &[&IrTy]
            }
        } else if ty.tag == IrTyTag::Struct && ty.struct_ref().type_args.len() > 0 && def.generic_params.len() == ty.struct_ref().type_args.len() {
            ty.struct_ref().type_args
        } else {
            // Fallback for non-generic structs, enums, etc: pass the whole type
            let ta = self.ctx.arena.alloc_slice::<&IrTy>(1);
            ta[0] = ty;
            ta as &[&IrTy]
        };

        // For protocol methods, also bind Self in type_map to the underlying type
        // so calls like `Self::equals(...)` inside default method bodies resolve.
        let self_id_opt = self.ctx.proto_method_self_id.get(&def.id._value);
        if self_id_opt.is_some() {
            self.type_map.insert(self_id_opt.unwrap(), ty);
        }

        let fn_idx = self.mono_function(def, type_args);
        let ir_fn = &self.ctx.ir_functions[fn_idx];

        let args = self.ctx.arena.alloc_slice::<&IrExpr>(2);
        args[0] = self.mk_ref(ir_lhs, true);
        args[1] = self.mk_ref(ir_rhs, true);
        let fn_ref = IrFnRef { id: ir_fn.id, mangled_name: ir_fn.mangled_name };
        self.mk_call(fn_ref, args, ret_ty)
    }

    // Lower a deferred call: T::method(args) where T was a generic type param or type alias.
    // At mono time, T has been resolved to a concrete type via type_map or type_aliases.
    fn lower_defered_call(self: &mut Mono, expr: &Expr) -> Option<&IrExpr> {
        let defered = expr.lhs();
        let method_name = defered.str_val();

        // Look up the concrete type: first try generic type params, then type aliases
        let concrete_ty: &IrTy = self.ctx.void_ty;
        let resolved = self.type_map.get(&defered.id()._value);
        if resolved.is_some() {
            concrete_ty = resolved.unwrap();
        } else {
            // Try type alias
            let ta = self.ctx.type_aliases.get(&defered.id()._value);
            if ta.is_some() {
                let alias = ta.unwrap();
                // Save and clear the alias's generic params from type_map so resolve
                // produces void slots for type inference. Without this, stale type_map
                // entries from prior monomorphizations would pollute the resolution
                // (e.g. Result<T> resolving T to usize instead of u8).
                let saved_params = self.ctx.arena.alloc_slice::<&IrTy>(alias.generic_params.len());
                let had_params = self.ctx.arena.alloc_slice::<bool>(alias.generic_params.len());
                for gi in 0usize..alias.generic_params.len() {
                    let gp_id = alias.generic_params[gi].id._value;
                    let old = self.type_map.get(&gp_id);
                    if old.is_some() {
                        saved_params[gi] = old.unwrap();
                        had_params[gi] = true;
                        self.type_map.remove(&gp_id);
                    } else {
                        had_params[gi] = false;
                    }
                }
                concrete_ty = self.resolve_type(alias.target);
                // Restore saved type_map entries
                for gi in 0usize..alias.generic_params.len() {
                    if had_params[gi] {
                        self.type_map.insert(alias.generic_params[gi].id._value, saved_params[gi]);
                    }
                }
            } else {
                return Option::none();
            }
        }

        // Find the method on the concrete type
        let method_def = self.find_method_in_scope(concrete_ty, method_name);
        if method_def.is_none() {
            return Option::none();
        }
        let def = method_def.unwrap();

        // Build type args from the concrete type's struct type args.
        // Only use them when the count matches the method's generic params,
        // indicating the method's generics correspond to the struct's type params
        // (e.g. `impl Option<T> { fn foo(self: &Option<T>) }`).
        // When counts differ, the method has its own generic params independent
        // of the struct (e.g. `impl Option { fn transpose<T, E>(...) }`).
        let method_type_args: &[&IrTy] = &[];
        if concrete_ty.tag == IrTyTag::Struct
            && concrete_ty.struct_ref().type_args.len() == def.generic_params.len() {
            method_type_args = concrete_ty.struct_ref().type_args;
        } else if concrete_ty.tag == IrTyTag::Slice {
            // Self=slice<Ptr>. Mirror call_method_on_type's Slice branch:
            // methods taking <Ptr> get [&elem]; methods taking <T, Ptr>
            // get [elem, &elem]; methods taking <T, Ptr, H> (e.g. hash)
            // get [elem, &elem, void] with the last slot left for
            // argument inference. Without this, deferred-call mono of
            // slice methods like `Self::equals(...)` in mem.alu's
            // protocol-method bodies left T/Ptr unbound and downstream
            // `*lhs._ptr` -> void.
            let elem_ty = self.slice_elem_ty(concrete_ty);
            let ptr_ty = self.ctx.make_ptr_ty(elem_ty, concrete_ty.is_const());
            if def.generic_params.len() == 3 {
                let ta = self.ctx.arena.alloc_slice::<&IrTy>(3);
                ta[0] = elem_ty;
                ta[1] = ptr_ty;
                ta[2] = self.ctx.void_ty;
                method_type_args = ta;
            } else if def.generic_params.len() == 2 {
                let ta = self.ctx.arena.alloc_slice::<&IrTy>(2);
                ta[0] = elem_ty;
                ta[1] = ptr_ty;
                method_type_args = ta;
            } else if def.generic_params.len() == 1 {
                let ta = self.ctx.arena.alloc_slice::<&IrTy>(1);
                ta[0] = ptr_ty;
                method_type_args = ta;
            }
        }

        // Handle turbofish type args on the call itself (e.g. T::method::<U>(args))
        if expr.type_args().len() > 0 {
            let extra = self.ctx.arena.alloc_slice::<&IrTy>(method_type_args.len() + expr.type_args().len());
            for i in 0usize..method_type_args.len() {
                extra[i] = method_type_args[i];
            }
            for i in 0usize..expr.type_args().len() {
                extra[method_type_args.len() + i] = self.resolve_type(expr.type_args()[i]);
            }
            method_type_args = extra;
        }

        // Pad method_type_args with void if shorter than needed, so inference
        // can fill in the missing generic params.
        if method_type_args.len() < def.generic_params.len() {
            let padded = self.ctx.arena.alloc_slice::<&IrTy>(def.generic_params.len());
            for i in 0usize..method_type_args.len() {
                padded[i] = method_type_args[i];
            }
            for i in method_type_args.len()..def.generic_params.len() {
                padded[i] = self.ctx.void_ty;
            }
            method_type_args = padded as &[&IrTy];
        }

        // If any type args are void (unresolved from type alias generic params
        // or from padding above), use argument type inference to fill them in.
        if def.generic_params.len() > 0 {
            let has_unresolved = false;
            for i in 0usize..method_type_args.len() {
                if method_type_args[i].is_void() {
                    has_unresolved = true;
                }
            }
            if has_unresolved {
                // First try expected return-type shape — this beats arg
                // inference for cases like `Option::some('\n')` matched to
                // `Option<u8>`, where the bare char literal naively infers
                // T=u32 and shadows the correct T=u8 from the expected type.
                // Mirrors the FnRef-call branch in lower_call (~line 5934)
                // which does the same lookup; without it, `lower_expr_coerced`
                // on a CharLit can't propagate the expected type through.
                if self.expected_type != self.ctx.void_ty {
                    let exp = self.expected_type;
                    if exp.tag == IrTyTag::Struct && exp.struct_ref().type_args.len() == def.generic_params.len() {
                        // Map declared return type's placeholders to exp's
                        // concrete args. Only fills generic_params that
                        // appear directly in the return type as
                        // Placeholder(gp.id) — the common case for
                        // Option::some / Result::ok / etc.
                        let ret = def.return_type;
                        if ret.tag == TyTag::Generic && ret.elems().len() == def.generic_params.len() {
                            let merged0 = self.ctx.arena.alloc_slice::<&IrTy>(method_type_args.len());
                            for i in 0usize..method_type_args.len() {
                                merged0[i] = method_type_args[i];
                            }
                            for ri in 0usize..ret.elems().len() {
                                if ret.elems()[ri].tag == TyTag::Placeholder {
                                    let target_gp = ret.elems()[ri].id()._value;
                                    for gi in 0usize..def.generic_params.len() {
                                        if def.generic_params[gi].id._value == target_gp
                                            && merged0[gi].is_void() {
                                            merged0[gi] = exp.struct_ref().type_args[ri];
                                        }
                                    }
                                }
                            }
                            method_type_args = merged0;
                            has_unresolved = false;
                            for i in 0usize..method_type_args.len() {
                                if method_type_args[i].is_void() {
                                    has_unresolved = true;
                                }
                            }
                        }
                    }
                }
            }
            if has_unresolved {
                let inferred = self.infer_type_args(def, expr.args());
                if inferred.len() == method_type_args.len() {
                    let merged = self.ctx.arena.alloc_slice::<&IrTy>(method_type_args.len());
                    for i in 0usize..method_type_args.len() {
                        if method_type_args[i].is_void() && !inferred[i].is_void() {
                            merged[i] = inferred[i];
                        } else {
                            merged[i] = method_type_args[i];
                        }
                    }
                    method_type_args = merged;
                }
            }
        }

        // For mixin'd protocol methods on a known receiver type (e.g.
        // `T::infinity()` where T resolves to f64), bind the protocol's
        // generics from the receiver's scope's mixin args. Without this,
        // static calls with no args (no receiver to infer Self from) leave
        // Self unbound and the body lowers to void. Mirrors the cfg(boot)-side
        // dispatch in lower_call's non-generic-fn branch.
        let proto_gp_ids_opt = self.ctx.proto_method_proto_gp_ids.get(&def.id._value);
        if proto_gp_ids_opt.is_some() {
            let receiver_scope_idx: u32 = 0u32;
            if concrete_ty.tag == IrTyTag::Struct {
                receiver_scope_idx = concrete_ty.struct_ref().scope_idx;
            } else if concrete_ty.tag == IrTyTag::Enum {
                receiver_scope_idx = concrete_ty.enum_ref().scope_idx;
            } else if concrete_ty.tag == IrTyTag::Builtin {
                let lang_name = Mono::builtin_lang_name(concrete_ty.builtin());
                if lang_name.len() > 0 {
                    let lang_id = self.ctx.get_lang_item(lang_name);
                    if lang_id.is_some() {
                        let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                        if sd.is_some() {
                            receiver_scope_idx = sd.unwrap().scope_idx;
                        }
                    }
                }
            }
            if receiver_scope_idx != 0u32 {
                let mixin_ast_args = self.ctx.scopes.get_mixin_type_args(receiver_scope_idx, def.id._value);
                if mixin_ast_args.is_some() {
                    let ast_args = mixin_ast_args.unwrap();
                    // Walk the mixin's first AST arg against the receiver
                    // type and bind every placeholder encountered. See
                    // `bind_placeholders_from_ast_vs_ir` for why this is
                    // more robust than looking up impl_generic_param_ids:
                    // the parser creates fresh placeholder ids while
                    // parsing the mixin's protocol type-args, so those
                    // ids don't always match the impl block's gp ids.
                    if ast_args.len() > 0 {
                        self.bind_placeholders_from_ast_vs_ir(ast_args[0], concrete_ty);
                    }
                    let resolved = self.ctx.arena.alloc_slice::<&IrTy>(ast_args.len());
                    for i in 0usize..ast_args.len() {
                        resolved[i] = self.resolve_type(ast_args[i]);
                    }
                    let _ = self.bind_proto_generics(def, resolved);
                }
            }
        }

        let fn_idx = self.mono_function(def, method_type_args);
        let ir_fn = &self.ctx.ir_functions[fn_idx];

        // Lower call arguments, coercing to parameter types
        let call_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args().len());
        for i in 0usize..expr.args().len() {
            if i < ir_fn.params.len() {
                let arg = self.lower_expr_coerced(expr.args()[i], ir_fn.params[i].ty);
                call_args[i] = self.check_and_coerce(arg, ir_fn.params[i].ty, expr.args()[i].span);
            } else {
                call_args[i] = self.lower_expr(expr.args()[i]);
            }
        }

        let fn_ref = IrFnRef {
            id: ir_fn.id,
            mangled_name: ir_fn.mangled_name,
        };
        Option::some(self.mk_call(fn_ref, call_args, ir_fn.return_type))
    }

    fn try_operator_overload(self: &mut Mono, op: BinOp, ir_lhs: &IrExpr, ir_rhs: &IrExpr) -> Option<&IrExpr> {
        // Try direct method lookup first (e.g. equals, compare on the type's scope)
        let method_name = Mono::binop_method_name(op);
        if method_name.len() > 0 {
            let direct_def = self.find_method_in_scope(ir_lhs.ty, method_name);
            if direct_def.is_some() {
                let result = self.call_method_on_type(direct_def.unwrap(), ir_lhs.ty, ir_lhs, ir_rhs, self.ctx.bool_ty);
                return Option::some(result);
            }
        }

        // For != (not_equals): fall back to negating equals
        if op == BinOp::Ne {
            let equals_def = self.find_method_in_scope(ir_lhs.ty, "equals");
            if equals_def.is_some() {
                let eq_result = self.call_method_on_type(equals_def.unwrap(), ir_lhs.ty, ir_lhs, ir_rhs, self.ctx.bool_ty);
                // Negate: !equals(lhs, rhs)
                let not_expr = IrExpr::void_expr(self.ctx.bool_ty);
                not_expr.tag = IrTag::Unary;
                not_expr._data.un.un_op = UnOp::Not;
                not_expr._data.un.lhs = eq_result;
                return Option::some(self.ctx.arena.alloc(not_expr) as &IrExpr);
            }
        }

        // For <, <=, >, >=: fall back to calling compare and comparing the Ordering result
        if op == BinOp::Lt || op == BinOp::Le || op == BinOp::Gt || op == BinOp::Ge {
            let compare_def = self.find_method_in_scope(ir_lhs.ty, "compare");
            if compare_def.is_some() {
                // compare returns Ordering enum (i8: -1=Less, 0=Equal, 1=Greater)
                let type_args = self.ctx.arena.alloc_slice::<&IrTy>(1);
                type_args[0] = ir_lhs.ty;
                let fn_idx = self.mono_function(compare_def.unwrap(), type_args);
                let ir_fn = &self.ctx.ir_functions[fn_idx];
                let ordering_ty = ir_fn.return_type;

                let args = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                args[0] = self.mk_ref(ir_lhs, true);
                args[1] = self.mk_ref(ir_rhs, true);
                let fn_ref = IrFnRef { id: ir_fn.id, mangled_name: ir_fn.mangled_name };
                let ordering_val = self.mk_call(fn_ref, args, ordering_ty);

                // Compare the ordering value with the appropriate variant
                let cmp_variant: u64 = switch op {
                    BinOp::Lt => (-1i8) as u64,     // compare with Less
                    BinOp::Gt => 1u64,              // compare with Greater
                    BinOp::Le => 1u64,              // compare with Greater (then !=)
                    BinOp::Ge => (-1i8) as u64,     // compare with Less (then !=)
                    _ => 0u64,
                };
                let cmp_op = if op == BinOp::Le || op == BinOp::Ge {
                    BinOp::Ne
                } else {
                    BinOp::Eq
                };
                let variant_val = self.mk_int_lit(ordering_ty, cmp_variant);
                return Option::some(self.mk_binary(cmp_op, ordering_val, variant_val, self.ctx.bool_ty));
            }
        }

        // No overload found - fall through to default comparison
        Option::none()
    }

    // Desugar a switch on a non-integer type into an if-else chain with == comparisons.
    // This is used for types like strings, structs, etc. that can't use LLVM's switch instruction.
    // Produces: { let __tmp = value; if __tmp == pat1 || __tmp == pat2 { body1 } else if ... else { default } }
    fn lower_switch_as_if_else(self: &mut Mono, ir_value: &IrExpr, arms: &[SwitchArm]) -> &IrExpr {
        // Create a temp variable to evaluate the discriminant once
        let tmp_id = self.ctx.id_gen.next_id();
        self.local_defs.push(IrLocalDef { id: tmp_id, ty: ir_value.ty, name: "_switch", span: Span::empty() });
        let ir_let = self.mk_let(tmp_id, ir_value.ty, ir_value);
        let tmp_read = self.mk_local(tmp_id, ir_value.ty);

        // Separate default arm from non-default arms.
        //
        // Per alumina-boot's semantics (src/alumina-boot/src/ast/expressions.rs's
        // visit_switch_expression, around line 1250), a missing default arm
        // desugars to an implicit `ExprKind::Void` — i.e. the unit value `()`.
        // Type unification of arm bodies with `()` is what produces alumina-boot's
        // "branches have incompatible types (i32, ())" error when the user
        // omits a default on a value-producing switch. So we always pass a
        // concrete `else_expr` down the chain: either the user's default body
        // or a synthesized Void IrExpr.
        // If the switch is in an rvalue position with a known expected_type
        // (e.g. `let p: &dyn Foo = switch i { 0 => &Quux{}, 1 => &Frob{}, ... }`),
        // propagate it to each arm so coercion (notably dyn vtable build) runs
        // per-arm. Mirrors the same fix in the If branch above.
        let outer_expected = self.expected_type;
        let propagate_to_arms = !outer_expected.is_void()
            && !outer_expected.is_never()
            && outer_expected.tag == IrTyTag::Struct
            && {
                let dyn_id = self.ctx.get_lang_item("dyn");
                dyn_id.is_some() && outer_expected.struct_ref().id._value == dyn_id.unwrap()
            };

        // Pre-pass: lower the first non-default arm's body to determine the
        // arms' unified result type. Subsequent arms get this type propagated
        // as expected_type so e.g. a `Kind::Inherit => (Option::none(), Option::none())`
        // arm doesn't mono `Option::none<void>()` and bitcast-blast the
        // pad bits when paired with a `Kind::Piped => (Option::some(7i32), ...)`
        // arm — the bug that gated `std/process` unification at runtime.
        // Mirrors the if-arm expected_type propagation a few lines above.
        let unified_arm_ty: &IrTy = self.ctx.void_ty;
        for i in 0usize..arms.len() {
            if arms[i].pattern.len() > 0 {
                // Probe the first arm's type (without committing to its IR —
                // we re-lower below for ordering / propagation reasons).
                let probe = self.lower_expr(arms[i].body);
                if !probe.ty.is_void() && !probe.ty.is_never() {
                    unified_arm_ty = probe.ty;
                }
                break;
            }
        }

        let default_body: &IrExpr = self.ctx.arena.alloc(IrExpr::void_expr(self.ctx.void_ty));
        for i in 0usize..arms.len() {
            if arms[i].pattern.len() == 0 {
                default_body = if propagate_to_arms {
                    self.lower_expr_coerced(arms[i].body, outer_expected)
                } else if !unified_arm_ty.is_void() {
                    self.lower_expr_coerced(arms[i].body, unified_arm_ty)
                } else {
                    self.lower_expr(arms[i].body)
                };
            }
        }

        // Count non-default arms
        let non_default_count: usize = 0;
        for i in 0usize..arms.len() {
            if arms[i].pattern.len() > 0 {
                non_default_count = non_default_count + 1;
            }
        }

        // Process arms in reverse order to build nested if-else with
        // `default_body` as the deepest else.
        let else_expr: Option<&IrExpr> = Option::some(default_body);
        let arm_idx: usize = non_default_count;
        while arm_idx > 0 {
            arm_idx = arm_idx - 1;

            // Find the arm_idx'th non-default arm
            let actual_i: usize = 0;
            let count: usize = 0;
            for i in 0usize..arms.len() {
                if arms[i].pattern.len() > 0 {
                    if count == arm_idx {
                        actual_i = i;
                    }
                    count = count + 1;
                }
            }

            let arm = &arms[actual_i];
            let arm_body = if propagate_to_arms {
                self.lower_expr_coerced(arm.body, outer_expected)
            } else if !unified_arm_ty.is_void() {
                self.lower_expr_coerced(arm.body, unified_arm_ty)
            } else {
                self.lower_expr(arm.body)
            };

            // Build condition: tmp == pat[0] || tmp == pat[1] || ...
            let cond: &IrExpr = null;
            for j in 0usize..arm.pattern.len() {
                let pat_val = self.lower_expr(arm.pattern[j]);

                // Build the == comparison, using operator overload for non-primitive types
                let eq_expr: &IrExpr = if ir_value.ty.tag == IrTyTag::Struct || ir_value.ty.tag == IrTyTag::Slice {
                    let overload = self.try_operator_overload(BinOp::Eq, tmp_read, pat_val);
                    if overload.is_some() {
                        overload.unwrap()
                    } else {
                        self.mk_binary(BinOp::Eq, tmp_read, pat_val, self.ctx.bool_ty)
                    }
                } else {
                    self.mk_binary(BinOp::Eq, tmp_read, pat_val, self.ctx.bool_ty)
                };

                if j == 0 {
                    cond = eq_expr;
                } else {
                    cond = self.mk_binary(BinOp::Or, cond, eq_expr, self.ctx.bool_ty);
                }
            }

            else_expr = Option::some(self.mk_if(cond, arm_body, else_expr));
        }

        // Wrap in block: { let __tmp = value; <if-else chain> }
        let chain = if else_expr.is_some() {
            else_expr.unwrap()
        } else {
            let v = IrExpr::void_expr(self.ctx.void_ty);
            v.tag = IrTag::Void;
            self.ctx.arena.alloc(v) as &IrExpr
        };

        let block_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(2);
        block_stmts[0] = ir_let;
        block_stmts[1] = chain;
        self.mk_block(block_stmts)
    }

    // Lower binary/unary/assignment ops: ExprTag::Binary, ExprTag::Unary, ExprTag::Assign, EXPR_COMPOUND_ASSIGN
    fn lower_binop(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == ExprTag::Binary {
            // If the LHS is an unsuffixed integer literal and the RHS is a typed
            // expression, lower the RHS first so we can coerce the literal to the
            // RHS's type. Otherwise `10 * m` where m: u64 defaults `10` to i32 and
            // then casts m down to i32, truncating values beyond i32::MAX.
            // Surfaced by ryu's parse64 mantissa accumulation
            // (`m10 = 10 * m10 + ...`).
            let lhs_is_untyped_int = expr.lhs().tag == ExprTag::IntLit
                && expr.lhs().type_suffix().is_none();
            let rhs_is_untyped_int = expr.rhs().tag == ExprTag::IntLit
                && expr.rhs().type_suffix().is_none();
            let ir_lhs: &IrExpr;
            let ir_rhs: &IrExpr;
            if lhs_is_untyped_int && !rhs_is_untyped_int {
                ir_rhs = self.lower_expr(expr.rhs());
                ir_lhs = self.lower_expr_coerced(expr.lhs(), ir_rhs.ty);
            } else {
                ir_lhs = self.lower_expr(expr.lhs());
                ir_rhs = self.lower_expr_coerced(expr.rhs(), ir_lhs.ty);
            }

            // For comparison operators on struct types, try operator overloading
            let is_comparison = expr.bin_op() == BinOp::Eq
                || expr.bin_op() == BinOp::Ne
                || expr.bin_op() == BinOp::Lt
                || expr.bin_op() == BinOp::Le
                || expr.bin_op() == BinOp::Gt
                || expr.bin_op() == BinOp::Ge;
            // Tuples dispatch via the lang `tuple` impl (sysroot mixes in
            // Comparable<Tup>); Eq/Ne falls back to the codegen unrolling at
            // gen_binary if no `equals` / `not_equals` is mixed in.
            if is_comparison && (ir_lhs.ty.tag == IrTyTag::Struct || ir_lhs.ty.tag == IrTyTag::Slice || ir_lhs.ty.tag == IrTyTag::Tuple) {
                let overload = self.try_operator_overload(expr.bin_op(), ir_lhs, ir_rhs);
                if overload.is_some() {
                    return overload.unwrap();
                }
            }

            let result_ty = switch expr.bin_op() {
                BinOp::Eq => self.ctx.bool_ty,
                BinOp::Ne => self.ctx.bool_ty,
                BinOp::Lt => self.ctx.bool_ty,
                BinOp::Le => self.ctx.bool_ty,
                BinOp::Gt => self.ctx.bool_ty,
                BinOp::Ge => self.ctx.bool_ty,
                BinOp::And => self.ctx.bool_ty,
                BinOp::Or => self.ctx.bool_ty,
                _ => ir_lhs.ty,
            };
            self.mk_binary(expr.bin_op(), ir_lhs, ir_rhs, result_ty)
        } else if expr.tag == ExprTag::Unary {
            let ir_operand = self.lower_expr(expr.lhs());
            let result_ty = switch expr.un_op() {
                UnOp::Not => self.ctx.bool_ty,
                _ => ir_operand.ty,
            };
            let result = IrExpr::void_expr(result_ty);
            result.tag = IrTag::Unary;
            result._data.un.un_op = expr.un_op();
            result._data.un.lhs = ir_operand;
            self.ctx.arena.alloc(result)
        } else if expr.tag == ExprTag::Assign {
            let ir_lhs = self.lower_expr(expr.lhs());
            // For compound assignment, desugar to binary + assign (RHS type differs from LHS)
            if expr.assign_op() as i32 != AssignOp::Assign as i32 {
                let ir_rhs = self.lower_expr(expr.rhs());
                let bin_op = switch expr.assign_op() {
                    AssignOp::AddAssign => BinOp::Add,
                    AssignOp::SubAssign => BinOp::Sub,
                    AssignOp::MulAssign => BinOp::Mul,
                    AssignOp::DivAssign => BinOp::Div,
                    AssignOp::RemAssign => BinOp::Rem,
                    AssignOp::BitAndAssign => BinOp::BitAnd,
                    AssignOp::BitOrAssign => BinOp::BitOr,
                    AssignOp::BitXorAssign => BinOp::BitXor,
                    AssignOp::ShlAssign => BinOp::Shl,
                    AssignOp::ShrAssign => BinOp::Shr,
                    _ => BinOp::Add,
                };
                let binop_expr = self.mk_binary(bin_op, ir_lhs, ir_rhs, ir_lhs.ty);
                return self.mk_assign(ir_lhs, binop_expr);
            }
            // Plain assignment: coerce and typecheck
            let ir_rhs = self.lower_expr_coerced(expr.rhs(), ir_lhs.ty);
            let ir_rhs = self.check_and_coerce(ir_rhs, ir_lhs.ty, expr.rhs().span);
            self.mk_assign(ir_lhs, ir_rhs)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower control flow: ExprTag::If, ExprTag::While, ExprTag::Loop, ExprTag::For, ExprTag::Switch, ExprTag::Break, ExprTag::Continue, ExprTag::Return
    fn lower_control_flow(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == ExprTag::If {
            let ir_cond = self.lower_expr(expr.cond());

            // If the if is in an rvalue position with a known expected_type
            // (e.g. `let p: &dyn Foo = if cond { &Quux{} } else { &Frob{} };`),
            // propagate that expectation into both arms so each arm's value
            // gets coerced individually. Without this, the arms unify on the
            // "most structured" type (often the first arm's, e.g. `&Quux`),
            // and the else-arm's `&Frob` gets misdispatched. Particularly
            // load-bearing for dyn coercion where each arm needs its own
            // vtable.
            let outer_expected = self.expected_type;
            let propagate = !outer_expected.is_void()
                && !outer_expected.is_never()
                && outer_expected.tag == IrTyTag::Struct
                && {
                    let dyn_id = self.ctx.get_lang_item("dyn");
                    dyn_id.is_some() && outer_expected.struct_ref().id._value == dyn_id.unwrap()
                };

            let ir_then = if propagate {
                self.lower_expr_coerced(expr.lhs(), outer_expected)
            } else {
                self.lower_expr(expr.lhs())
            };
            let ir_else: Option<&IrExpr> = if expr.opt_expr().is_some() {
                let else_result = if propagate {
                    self.lower_expr_coerced(expr.opt_expr().unwrap(), outer_expected)
                } else {
                    // Set expected_type hint from then branch for else branch inference.
                    let saved_expected = self.expected_type;
                    if !ir_then.ty.is_void() && !ir_then.ty.is_never() {
                        self.expected_type = ir_then.ty;
                    }
                    let r = self.lower_expr(expr.opt_expr().unwrap());
                    self.expected_type = saved_expected;
                    r
                };
                Option::some(else_result)
            } else {
                Option::none()
            };
            // Use the larger/more complete type from the branches
            // (e.g., Option::some(T) is the full type, Option::none() may be smaller)
            let result_ty = if ir_else.is_some() && !ir_else.unwrap().ty.is_void() && !ir_else.unwrap().ty.is_never() {
                // If else branch has a non-void type, prefer the one with more structure
                let then_ty = ir_then.ty;
                let else_ty = ir_else.unwrap().ty;
                if then_ty.is_void() || then_ty.is_never() {
                    else_ty
                } else if then_ty.tag == IrTyTag::Struct && else_ty.tag == IrTyTag::Struct {
                    // Prefer the type with the same or larger struct
                    // Both should be the same generic type, but may differ if
                    // one is a degenerate case (e.g., Option::none() vs Option::some(T))
                    if else_ty.struct_ref().fields.len() >= then_ty.struct_ref().fields.len() {
                        else_ty
                    } else {
                        then_ty
                    }
                } else {
                    then_ty
                }
            } else {
                ir_then.ty
            };
            let result = IrExpr::void_expr(result_ty);
            result.tag = IrTag::If;
            result._data.if_data.cond = ir_cond;
            result._data.if_data.lhs = ir_then;
            result._data.if_data.opt_expr = ir_else;
            self.ctx.arena.alloc(result)
        } else if expr.tag == ExprTag::While {
            let ir_cond = self.lower_expr(expr.cond());
            let ir_body = self.lower_expr(expr.lhs());
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IrTag::While;
            result._data.if_data.cond = ir_cond;
            result._data.if_data.lhs = ir_body;
            self.ctx.arena.alloc(result)
        } else if expr.tag == ExprTag::Loop {
            // `loop { break value; }` produces `value` as the loop's
            // result. To support that without restructuring the IR's
            // Loop node, we allocate a fresh local that each `break
            // value;` assigns into, then wrap the loop in a block whose
            // trailing expression loads that local. Mirrors alumina-boot's
            // `lower_loop` (src/alumina-boot/src/ir/mono/mod.rs:4523) —
            // it uses `local_types` keyed on a synthesized `loop_result`
            // id and reads the slot after the break label.
            //
            // The break-value type is committed on the FIRST break-with-
            // value seen during body lowering; subsequent breaks must
            // match (they typically do — same fn writing the same shape).
            // A loop with no break-value lowers to the existing void Loop.
            let slot_id = self.ctx.id_gen.next_id();
            self.loop_contexts.push(LoopContext {
                result_slot_id: slot_id,
                break_value_ty: self.ctx.void_ty,
                has_value: false,
            });
            let ir_body = self.lower_expr(expr.lhs());
            let ctx_popped = self.loop_contexts.pop().unwrap();

            let loop_expr = IrExpr::void_expr(self.ctx.void_ty);
            loop_expr.tag = IrTag::Loop;
            loop_expr._data.single.lhs = ir_body;
            let loop_alloc = self.ctx.arena.alloc(loop_expr) as &IrExpr;

            if !ctx_popped.has_value {
                loop_alloc
            } else {
                let break_ty = ctx_popped.break_value_ty;
                // Register the result slot as a local of the break type.
                self.local_types.insert(slot_id._value, break_ty);
                self.local_defs.push(IrLocalDef {
                    id: slot_id,
                    ty: break_ty,
                    name: "",
                    span: Span::empty(),
                });
                // { Let _slot; Loop { body }; _slot }
                let let_slot = self.mk_let_uninit(slot_id, break_ty);
                let load_slot = self.mk_local(slot_id, break_ty);
                let stmts = self.ctx.arena.alloc_slice::<&IrExpr>(3);
                stmts[0] = let_slot;
                stmts[1] = loop_alloc;
                stmts[2] = load_slot;
                let block = IrExpr::void_expr(break_ty);
                block.tag = IrTag::Block;
                block._data.block.items = stmts;
                self.ctx.arena.alloc(block) as &IrExpr
            }
        } else if expr.tag == ExprTag::For {
            // Desugar: for i in start..end { body }
            // Into: let i = start; let _end = end; while i < _end { body; i = i + 1; }
            let range_expr = expr.lhs();
            if range_expr.tag != ExprTag::Range {
                // Iterator-based for loop: for item in iterator { body }
                // Desugar into: let _iter = expr; loop { let _opt = _iter.next(); if _opt.is_none() { break; } let item = _opt.unwrap(); body }
                return self.lower_for_iterator(expr);
            }

            let ir_start = self.lower_expr(range_expr.lhs());
            let ir_end = self.lower_expr(range_expr.rhs());
            let iter_ty = ir_start.ty;

            // Register loop variable type
            let loop_var_id = expr.id();
            self.local_types.insert(loop_var_id._value, iter_ty);
            self.local_defs.push(IrLocalDef {
                id: loop_var_id,
                ty: iter_ty,
                name: "",
                span: Span::empty(),
            });

            // Register end variable
            let end_var_id = self.ctx.id_gen.next_id();
            self.local_types.insert(end_var_id._value, iter_ty);
            self.local_defs.push(IrLocalDef {
                id: end_var_id,
                ty: iter_ty,
                name: "",
                span: Span::empty(),
            });

            // let i = start; let _end = end
            let ir_let_start = self.mk_let(loop_var_id, iter_ty, ir_start);
            let ir_let_end = self.mk_let(end_var_id, iter_ty, ir_end);

            // i < _end (or i <= _end for inclusive)
            let cmp_op = if range_expr.flag() { BinOp::Le } else { BinOp::Lt };
            let ir_cond = self.mk_binary(cmp_op, self.mk_local(loop_var_id, iter_ty), self.mk_local(end_var_id, iter_ty), self.ctx.bool_ty);

            // Lower body
            let ir_body = self.lower_expr(expr.rhs());

            // i = i + 1
            let ir_read_i2 = self.mk_local(loop_var_id, iter_ty);
            let ir_add = self.mk_binary(BinOp::Add, ir_read_i2, self.mk_int_lit(iter_ty, 1), iter_ty);
            let ir_incr = self.mk_assign(ir_read_i2, ir_add);

            // while i < _end { body } with continue -> increment
            let while_expr = IrExpr::void_expr(self.ctx.void_ty);
            while_expr.tag = IrTag::While;
            while_expr._data.if_data.cond = ir_cond;
            while_expr._data.if_data.lhs = ir_body;
            while_expr._data.if_data.opt_expr = Option::some(ir_incr);
            let ir_while = self.ctx.arena.alloc(while_expr) as &IrExpr;

            // Full block: { let i = start; let _end = end; while ... }
            let block_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(3);
            block_stmts[0] = ir_let_start;
            block_stmts[1] = ir_let_end;
            block_stmts[2] = ir_while;
            self.mk_block_void(block_stmts)
        } else if expr.tag == ExprTag::Switch {
            // Always desugar to an if-else chain with `==` comparisons.
            // Matches alumina-boot's semantics: switch is sugar for an
            // ordered series of equality tests. LLVM's optimizer recognises
            // the pattern and converts to a jump table when beneficial, so
            // we don't lose codegen quality vs an explicit LLVM switch.
            //
            // The earlier integer-switch fast path extracted pattern values
            // into a u64 table and silently zeroed any pattern shape it
            // didn't recognise (const-references, enum variants in some
            // contexts, etc.). That meant `switch x { libc::DT_DIR => Dir,
            // libc::DT_REG => Reg }` collapsed both const-ref arms onto
            // case 0 and the real `d_type=4` fell to the default — the
            // root cause of the self-host bootstrap regression on the
            // fs/mod.alu swap. Unifying through if-else removes the table
            // extraction entirely and patterns just get compared as values.
            let ir_value = self.lower_expr(expr.lhs());
            self.lower_switch_as_if_else(ir_value, expr.switch_arms())
        } else if expr.tag == ExprTag::Break {
            // `break value;` flows the value through the enclosing loop's
            // result slot. Without this, the value is evaluated for side
            // effects and discarded — the codegen-side Break path drops
            // its argument because gen_loop doesn't return a value. We
            // lower to { _slot = value; break; } so the slot read after
            // the loop sees the right value. Mirrors alumina-boot's
            // `lower_break` (src/alumina-boot/src/ir/mono/mod.rs:4572).
            if expr.opt_expr().is_some() && self.loop_contexts.len() > 0 {
                let ctx_idx = self.loop_contexts.len() - 1usize;
                // Determine the break value type by lowering with the
                // already-committed type as expected_type if available,
                // else fall back to the outer expected_type so the very
                // first break can pick up a hint from `let x: Option<…> =
                // loop { break Option::none() … }` shaped contexts.
                let preview_ty = self.loop_contexts[ctx_idx].break_value_ty;
                let ir_val = if !preview_ty.is_void() {
                    self.lower_expr_coerced(expr.opt_expr().unwrap(), preview_ty)
                } else {
                    self.lower_expr(expr.opt_expr().unwrap())
                };
                if !self.loop_contexts[ctx_idx].has_value && !ir_val.ty.is_void() {
                    self.loop_contexts[ctx_idx].break_value_ty = ir_val.ty;
                    self.loop_contexts[ctx_idx].has_value = true;
                }
                let slot_id = self.loop_contexts[ctx_idx].result_slot_id;
                let slot_ty = self.loop_contexts[ctx_idx].break_value_ty;
                let slot_local = self.mk_local(slot_id, slot_ty);
                let assign = self.mk_assign(slot_local, ir_val);
                let break_only = IrExpr::void_expr(self.ctx.never_ty);
                break_only.tag = IrTag::Break;
                break_only._data.ret.opt_expr = Option::none();
                let break_alloc = self.ctx.arena.alloc(break_only) as &IrExpr;
                let stmts = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                stmts[0] = assign;
                stmts[1] = break_alloc;
                self.mk_block(stmts)
            } else {
                let ir_val: Option<&IrExpr> = if expr.opt_expr().is_some() {
                    Option::some(self.lower_expr(expr.opt_expr().unwrap()))
                } else {
                    Option::none()
                };
                let result = IrExpr::void_expr(self.ctx.never_ty);
                result.tag = IrTag::Break;
                result._data.ret.opt_expr = ir_val;
                self.ctx.arena.alloc(result)
            }
        } else if expr.tag == ExprTag::Continue {
            let result = IrExpr::void_expr(self.ctx.never_ty);
            result.tag = IrTag::Continue;
            self.ctx.arena.alloc(result)
        } else if expr.tag == ExprTag::Return {
            if expr.opt_expr().is_some() {
                let ir_val = self.lower_expr_coerced(expr.opt_expr().unwrap(), self.return_type);
                let ir_val = self.check_and_coerce(ir_val, self.return_type, expr.opt_expr().unwrap().span);
                let result = IrExpr::void_expr(self.ctx.never_ty);
                result.tag = IrTag::Return;
                result._data.ret.opt_expr = Option::some(ir_val);
                self.ctx.arena.alloc(result)
            } else {
                let result = IrExpr::void_expr(self.ctx.never_ty);
                result.tag = IrTag::Return;
                self.ctx.arena.alloc(result)
            }
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower iterator-based for loop:
    //   for item in iterator_expr { body }
    // Desugars to:
    //   { let _iter = iterator_expr;
    //     loop { let _opt = _iter.next();
    //            if _opt.is_none() { break; }
    //            let item = _opt.unwrap();
    //            body } }
    fn lower_for_iterator(self: &mut Mono, expr: &Expr) -> &IrExpr {
        let iterable_ir = self.lower_expr(expr.lhs());
        let iterable_ty = iterable_ir.ty;

        if iterable_ty.is_void() {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }

        // Try calling .iter() on the iterable to get an iterator.
        let iter_ir = iterable_ir;
        let iter_ty = iterable_ty;
        let iter_let_stmt: Option<&IrExpr> = Option::none();

        {
            // Store iterable in a local so we can take a reference for .iter() call
            let iterable_var_id = self.ctx.id_gen.next_id();
            self.local_types.insert(iterable_var_id._value, iterable_ty);
            self.local_defs.push(IrLocalDef {
                id: iterable_var_id,
                ty: iterable_ty,
                name: "_iterable",
                span: Span::empty(),
            });

            // &_iterable for method call
            let ir_iterable_local = self.mk_local(iterable_var_id, iterable_ty);
            let ir_iterable_ref = self.mk_ref(ir_iterable_local, false);

            let iter_call = self.resolve_method_call_on_type(iterable_ty, "iter", ir_iterable_ref, &[]);
            if iter_call.is_some() {
                // let _iterable = iterable_expr;
                iter_let_stmt = Option::some(self.mk_let(iterable_var_id, iterable_ty, iterable_ir));

                let iter_result = iter_call.unwrap();
                iter_ir = iter_result;
                iter_ty = iter_result.ty;

                // If .iter() returned a slice, call .iter() on the slice to get a SliceIterator
                if iter_ty.tag == IrTyTag::Slice {
                    let slice_var_id = self.ctx.id_gen.next_id();
                    self.local_types.insert(slice_var_id._value, iter_ty);
                    self.local_defs.push(IrLocalDef {
                        id: slice_var_id,
                        ty: iter_ty,
                        name: "_iter_slice",
                        span: Span::empty(),
                    });
                    let slice_let = self.mk_let(slice_var_id, iter_ty, iter_ir);
                    let slice_local = self.mk_local(slice_var_id, iter_ty);
                    let slice_ref = self.mk_ref(slice_local, false);
                    let slice_iter_call = self.resolve_method_call_on_type(iter_ty, "iter", slice_ref, &[]);
                    if slice_iter_call.is_some() {
                        // Chain: let _iter_slice = iterable.iter(); let _iter = _iter_slice.iter();
                        iter_ir = slice_iter_call.unwrap();
                        iter_ty = iter_ir.ty;
                        // We need to emit the slice let in the preamble too
                        // Wrap iter_let_stmt and slice_let into a block
                        let block_items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                        block_items[0] = iter_let_stmt.unwrap();
                        block_items[1] = slice_let;
                        let block = IrExpr::void_expr(self.ctx.void_ty);
                        block.tag = IrTag::Block;
                        block._data.block.items = block_items;
                        iter_let_stmt = Option::some(self.ctx.arena.alloc(block) as &IrExpr);
                    }
                }
            }
        }

        // Create local for the iterator (mutable so .next() works)
        let iter_var_id = self.ctx.id_gen.next_id();
        self.local_types.insert(iter_var_id._value, iter_ty);
        self.local_defs.push(IrLocalDef {
            id: iter_var_id,
            ty: iter_ty,
            name: "_iter",
            span: Span::empty(),
        });

        // let _iter = iterator_expr
        let ir_let_iter = self.mk_let(iter_var_id, iter_ty, iter_ir);

        // Reference to the iterator for method calls.
        // If iter_ty is already a pointer (e.g. &mut Counter from .iter()), use it directly.
        // Otherwise, take a reference (&_iter) for the method call.
        let ir_iter_ref = if iter_ty.tag == IrTyTag::Pointer {
            self.mk_local(iter_var_id, iter_ty)
        } else {
            self.mk_ref(self.mk_local(iter_var_id, iter_ty), false)
        };

        // _iter.next() - resolve via method call on the iterator type
        let next_result = self.resolve_method_call_on_type(iter_ty, "next", ir_iter_ref, &[]);

        if next_result.is_none() {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }
        let ir_next_call = next_result.unwrap();
        let opt_ty = ir_next_call.ty; // Option<T>

        // Create local for the option
        let opt_var_id = self.ctx.id_gen.next_id();
        self.local_types.insert(opt_var_id._value, opt_ty);
        self.local_defs.push(IrLocalDef {
            id: opt_var_id,
            ty: opt_ty,
            name: "_opt",
            span: Span::empty(),
        });

        // let _opt = _iter.next()
        let ir_let_opt = self.mk_let(opt_var_id, opt_ty, ir_next_call);

        // &_opt (for method calls)
        let ir_opt_ref = self.mk_ref(self.mk_local(opt_var_id, opt_ty), true);

        // _opt.is_none()
        let is_none_result = self.resolve_method_call_on_type(opt_ty, "is_none", ir_opt_ref, &[]);
        let ir_is_none = if is_none_result.is_some() {
            is_none_result.unwrap()
        } else {
            // Fallback: check _is_some field == false
            let bool_ty = self.ctx.intern_builtin_ty(BuiltinType::Bool);
            let field0_val = self.mk_field(self.mk_local(opt_var_id, opt_ty), 0u32, bool_ty);
            let not_expr = IrExpr::void_expr(bool_ty);
            not_expr.tag = IrTag::Unary;
            not_expr._data.un.un_op = UnOp::Not;
            not_expr._data.un.lhs = field0_val;
            self.ctx.arena.alloc(not_expr) as &IrExpr
        };

        // break
        let ir_break = IrExpr::void_expr(self.ctx.void_ty);
        ir_break.tag = IrTag::Break;
        let ir_break_val = self.ctx.arena.alloc(ir_break) as &IrExpr;

        // if _opt.is_none() { break; }
        let if_break = IrExpr::void_expr(self.ctx.void_ty);
        if_break.tag = IrTag::If;
        if_break._data.if_data.cond = ir_is_none;
        if_break._data.if_data.lhs = ir_break_val;
        let ir_if_break = self.ctx.arena.alloc(if_break) as &IrExpr;

        // _opt.unwrap() - get the inner value (field 1 of Option)
        // Since Option<T> = { _is_some: bool, _inner: T }, just access field 1
        let elem_ty = if opt_ty.tag == IrTyTag::Struct && opt_ty.struct_ref().fields.len() > 1 {
            opt_ty.struct_ref().fields[1].ty
        } else {
            self.ctx.void_ty
        };
        let ir_unwrap = self.mk_field(self.mk_local(opt_var_id, opt_ty), 1u32, elem_ty);

        // let item = _opt.unwrap()  (or tuple unpacking bindings)
        let binding_stmts = self.make_for_loop_bindings(expr, ir_unwrap, elem_ty);

        // Lower the body
        let ir_body = self.lower_expr(expr.rhs());

        // Loop body: { let _opt = _iter.next(); if is_none break; [bindings...]; body }
        let body_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(2 + binding_stmts.len() + 1);
        body_stmts[0] = ir_let_opt;
        body_stmts[1] = ir_if_break;
        for j in 0usize..binding_stmts.len() {
            body_stmts[2 + j] = binding_stmts[j];
        }
        body_stmts[2 + binding_stmts.len()] = ir_body;
        let ir_loop_body = self.mk_block_void(body_stmts);

        // loop { ... }
        let loop_expr = IrExpr::void_expr(self.ctx.void_ty);
        loop_expr.tag = IrTag::Loop;
        loop_expr._data.single.lhs = ir_loop_body;
        let ir_loop = self.ctx.arena.alloc(loop_expr) as &IrExpr;

        // Full block: { [let _iterable = ...;] let _iter = ...; loop { ... } }
        if iter_let_stmt.is_some() {
            let block_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(3);
            block_stmts[0] = iter_let_stmt.unwrap();
            block_stmts[1] = ir_let_iter;
            block_stmts[2] = ir_loop;
            self.mk_block_void(block_stmts)
        } else {
            let block_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(2);
            block_stmts[0] = ir_let_iter;
            block_stmts[1] = ir_loop;
            self.mk_block_void(block_stmts)
        }
    }

    // ========== Const Evaluator ==========
    // Delegates to the full const evaluator in const_eval.alu

    fn try_const_eval_u64(self: &mut Mono, expr: &IrExpr) -> Option<u64> {
        const_eval::try_eval_u64(
            self.ctx.arena,
            self.ctx.id_gen,
            self.ctx.ir_functions.as_slice(),
            self.ctx.ir_globals.as_slice(),
            &self.ctx.const_values,
            self.ctx.pointer_size,
            expr,
        )
    }

    fn try_const_eval_bool(self: &mut Mono, expr: &IrExpr) -> Option<bool> {
        const_eval::try_eval_bool(
            self.ctx.arena,
            self.ctx.id_gen,
            self.ctx.ir_functions.as_slice(),
            self.ctx.ir_globals.as_slice(),
            &self.ctx.const_values,
            self.ctx.pointer_size,
            expr,
        )
    }

    fn try_const_eval(self: &mut Mono, expr: &IrExpr) -> Option<ConstValue> {
        const_eval::try_eval(
            self.ctx.arena,
            self.ctx.id_gen,
            self.ctx.ir_functions.as_slice(),
            self.ctx.ir_globals.as_slice(),
            &self.ctx.const_values,
            self.ctx.pointer_size,
            expr,
        )
    }

    fn try_const_eval_with_diags(self: &mut Mono, expr: &IrExpr) -> (Option<ConstValue>, &[u8], &[u8], &[u8]) {
        const_eval::try_eval_with_diags(
            self.ctx.arena,
            self.ctx.id_gen,
            self.ctx.ir_functions.as_slice(),
            self.ctx.ir_globals.as_slice(),
            &self.ctx.const_values,
            self.ctx.pointer_size,
            expr,
        )
    }

    // Convert a ConstValue to an IR literal expression.
    fn constvalue_to_ir(self: &mut Mono, val: ConstValue, ty: &IrTy) -> &IrExpr {
        if val.tag == CValTag::Int {
            let ir_ty = if !ty.is_void() { ty } else { self.ctx.intern_builtin_ty(val.builtin_type()) };
            self.mk_int_lit(ir_ty, val.int_val())
        } else if val.tag == CValTag::Bool {
            self.mk_bool_lit(val.int_val() != 0)
        } else if val.tag == CValTag::Float {
            let ir_ty = if !ty.is_void() { ty } else { self.ctx.intern_builtin_ty(val.builtin_type()) };
            let e = IrExpr::void_expr(ir_ty);
            e.tag = IrTag::FloatLit;
            e._data.lit.float_val = val.float_val();
            self.ctx.arena.alloc(e) as &IrExpr
        } else if val.tag == CValTag::Bytes {
            let ir_ty = if !ty.is_void() { ty } else {
                self.ctx.make_slice_ty(self.ctx.intern_builtin_ty(BuiltinType::U8), true)
            };
            let e = IrExpr::void_expr(ir_ty);
            e.tag = IrTag::StringLit;
            e._data.lit.str_val = val.bytes();
            self.ctx.arena.alloc(e) as &IrExpr
        } else if val.tag == CValTag::Array {
            let elem_ty = ty.inner();
            let items = self.ctx.arena.alloc_slice::<&IrExpr>(val.elems().len());
            for i in 0usize..val.elems().len() {
                items[i] = self.constvalue_to_ir(val.elems()[i], elem_ty);
            }
            let e = IrExpr::void_expr(ty);
            e.tag = IrTag::ArrayLit;
            e._data.block.items = items;
            self.ctx.arena.alloc(e) as &IrExpr
        } else if val.tag == CValTag::Tuple {
            let field_tys = ty.elems();
            let items = self.ctx.arena.alloc_slice::<&IrExpr>(val.elems().len());
            for i in 0usize..val.elems().len() {
                items[i] = self.constvalue_to_ir(val.elems()[i], field_tys[i]);
            }
            let e = IrExpr::void_expr(ty);
            e.tag = IrTag::TupleLit;
            e._data.block.items = items;
            self.ctx.arena.alloc(e) as &IrExpr
        } else if val.tag == CValTag::Struct {
            let sr = ty.struct_ref();
            let items = self.ctx.arena.alloc_slice::<&IrExpr>(sr.fields.len());
            for i in 0usize..sr.fields.len() {
                // Find the ConstField matching this field index
                let field_val = ConstValue::make_void();
                for j in 0usize..val.fields().len() {
                    if val.fields()[j].field_idx == i as u32 {
                        field_val = val.fields()[j].value;
                    }
                }
                if field_val.tag == CValTag::Void {
                    // Field not set — use zeroed
                    let z = IrExpr::void_expr(sr.fields[i].ty);
                    z.tag = IrTag::Zeroed;
                    items[i] = self.ctx.arena.alloc(z) as &IrExpr;
                } else {
                    items[i] = self.constvalue_to_ir(field_val, sr.fields[i].ty);
                }
            }
            let e = IrExpr::void_expr(ty);
            e.tag = IrTag::StructLit;
            e._data.struct_lit = _IrStructLitData { items: items, ir_ty: ty };
            self.ctx.arena.alloc(e) as &IrExpr
        } else if val.tag == CValTag::FnPtr {
            if ty.tag == IrTyTag::Fn {
                // Fn type is a ZST — no runtime value needed
                let e = IrExpr::void_expr(ty);
                e.tag = IrTag::Zeroed;
                self.ctx.arena.alloc(e) as &IrExpr
            } else {
                // Function pointer — emit as FnRef cast to fn pointer
                let fn_ty = self.ctx.make_fn_ty(val.fn_ref());
                let e = IrExpr::void_expr(fn_ty);
                e.tag = IrTag::FnRef;
                e._data.fn_ref = val.fn_ref();
                let fn_ref = self.ctx.arena.alloc(e) as &IrExpr;
                if ty.tag == IrTyTag::FnPointer {
                    self.mk_cast(fn_ref, ty)
                } else {
                    fn_ref
                }
            }
        } else if val.tag == CValTag::Void || val.tag == CValTag::Uninitialized {
            let e = IrExpr::void_expr(ty);
            e.tag = IrTag::Zeroed;
            self.ctx.arena.alloc(e) as &IrExpr
        } else {
            // Unsupported const value type - produce zeroed
            let e = IrExpr::void_expr(ty);
            e.tag = IrTag::Zeroed;
            self.ctx.arena.alloc(e) as &IrExpr
        }
    }

    // Walk an IR expression tree and remap local variable IDs.
    // Used to deduplicate locals across static for iterations.
    fn remap_ir_locals(self: &Mono, expr_: &IrExpr, remap: &HashMap<usize, usize>) {
        // Cast away const - safe because all IrExpr are arena-allocated and owned by us
        let expr = expr_ as &mut IrExpr;
        switch expr.tag {
            IrTag::Local, IrTag::Param => {
                let r = remap.get(&expr._data.var.id._value);
                if r.is_some() {
                    expr._data.var.id._value = r.unwrap();
                }
            }
            IrTag::Let => {
                let r = remap.get(&expr._data.let_data.id._value);
                if r.is_some() {
                    expr._data.let_data.id._value = r.unwrap();
                }
                if expr.opt_expr().is_some() {
                    self.remap_ir_locals(expr.opt_expr().unwrap(), remap);
                }
            }
            IrTag::Block, IrTag::TupleLit, IrTag::ArrayLit => {
                for i in 0usize..expr.items().len() {
                    self.remap_ir_locals(expr.items()[i], remap);
                }
            }
            IrTag::StructLit => {
                for i in 0usize..expr.items().len() {
                    self.remap_ir_locals(expr.items()[i], remap);
                }
            }
            IrTag::Binary => {
                self.remap_ir_locals(expr.lhs(), remap);
                self.remap_ir_locals(expr.rhs(), remap);
            }
            IrTag::Unary, IrTag::Ref, IrTag::Deref, IrTag::Defer, IrTag::Loop => {
                self.remap_ir_locals(expr.lhs(), remap);
            }
            IrTag::Assign => {
                self.remap_ir_locals(expr.lhs(), remap);
                self.remap_ir_locals(expr.rhs(), remap);
            }
            IrTag::Index => {
                self.remap_ir_locals(expr.lhs(), remap);
                self.remap_ir_locals(expr.rhs(), remap);
            }
            IrTag::FieldAccess => {
                self.remap_ir_locals(expr.lhs(), remap);
            }
            IrTag::Cast, IrTag::Transmute => {
                self.remap_ir_locals(expr.lhs(), remap);
            }
            IrTag::If, IrTag::While => {
                self.remap_ir_locals(expr.cond(), remap);
                self.remap_ir_locals(expr.lhs(), remap);
                if expr.opt_expr().is_some() {
                    self.remap_ir_locals(expr.opt_expr().unwrap(), remap);
                }
            }
            IrTag::Switch => {
                self.remap_ir_locals(expr.lhs(), remap);
                for i in 0usize..expr.switch_arms().len() {
                    self.remap_ir_locals(expr.switch_arms()[i].body, remap);
                }
            }
            IrTag::Call => {
                for i in 0usize..expr.items().len() {
                    self.remap_ir_locals(expr.items()[i], remap);
                }
                if expr.call_target().tag == CallKind::Indirect {
                    self.remap_ir_locals(expr.call_target().callee, remap);
                }
            }
            IrTag::Return, IrTag::Break => {
                if expr.opt_expr().is_some() {
                    self.remap_ir_locals(expr.opt_expr().unwrap(), remap);
                }
            }
            _ => {
                // Literals, Void, Zeroed, etc. - no children to remap
            }
        }
    }

    // Try to redirect a bodyless protocol method call to the concrete type's impl.
    // For example, when Equatable::not_equals<Point> calls Equatable::equals,
    // we redirect to Point::equals.
    fn try_protocol_redirect(self: &mut Mono, def: &FnDef, type_args: &[&IrTy]) -> Option<usize> {
        // The type args should contain the concrete type (Self parameter of the protocol)
        // Usually the first type arg is the Self type
        if type_args.len() == 0 {
            return Option::none();
        }

        let self_ty = type_args[0];
        let scope_idx: u32 = 0u32;

        // Find the scope for the concrete type
        if self_ty.tag == IrTyTag::Struct {
            scope_idx = self_ty.struct_ref().scope_idx;
        } else if self_ty.tag == IrTyTag::Enum {
            scope_idx = self_ty.enum_ref().scope_idx;
        }

        if scope_idx == 0u32 {
            return Option::none();
        }

        // Look up the method name in the concrete type's scope
        let method_item = self.ctx.scopes.get(scope_idx).items.get(&def.name);
        if method_item.is_none() {
            return Option::none();
        }

        let item = method_item.unwrap();
        if item.kind.tag != scope::NamedItemTag::Function && item.kind.tag != scope::NamedItemTag::Method {
            return Option::none();
        }

        // Found a concrete method - use it instead
        // NamedItemTag::Method has fn_id in id2, NamedItemTag::Function has it in id
        let fn_id_val = if item.kind.tag == scope::NamedItemTag::Method {
            item.kind.id2()._value
        } else {
            item.kind.id()._value
        };
        let concrete_def = self.ctx.fn_defs.get(&fn_id_val);
        if concrete_def.is_none() {
            return Option::none();
        }

        // Don't redirect to ourselves (same function)
        if concrete_def.unwrap().id._value == def.id._value {
            return Option::none();
        }

        // Snapshot the protocol's proto-generic bindings (Self + protocol's
        // other generics) around the concrete-impl mono call. The dispatcher
        // bound these before reaching here, but the concrete impl method
        // doesn't have `proto_method_proto_gp_ids` of its own — so
        // `mono_function`'s own snapshot/restore on entry doesn't cover them.
        // Without this, the bindings leak into the concrete method's body
        // lowering (and from there into any nested mono triggered by it),
        // mis-resolving Placeholders that happen to share an id. See the
        // chars-map dispatch entry in PORTING_STATUS for the trigger shape:
        // `Outer::new().map(Result::unwrap)` returns 0 instead of the
        // unwrapped value when there's no prior direct call to warm the cache.
        // Gather all proto-related ids that might have bindings: the
        // proto_method_proto_gp_ids (Self + protocol's others, in order) and
        // proto_method_self_id (just Self, sometimes set independently).
        let proto_gp_ids_opt = self.ctx.proto_method_proto_gp_ids.get(&def.id._value);
        let self_id_opt = self.ctx.proto_method_self_id.get(&def.id._value);
        let n_ids: usize = 0;
        if proto_gp_ids_opt.is_some() { n_ids = proto_gp_ids_opt.unwrap().len(); }
        if self_id_opt.is_some() { n_ids = n_ids + 1; }
        let collected_ids = self.ctx.arena.alloc_slice::<usize>(n_ids);
        let idx: usize = 0;
        if proto_gp_ids_opt.is_some() {
            let pg = proto_gp_ids_opt.unwrap();
            for k in 0usize..pg.len() {
                collected_ids[idx] = pg[k];
                idx = idx + 1;
            }
        }
        if self_id_opt.is_some() {
            collected_ids[idx] = self_id_opt.unwrap();
            idx = idx + 1;
        }
        let saved_vals = self.ctx.arena.alloc_slice::<&IrTy>(n_ids);
        let saved_had = self.ctx.arena.alloc_slice::<bool>(n_ids);
        for k in 0usize..n_ids {
            let prev = self.type_map.get(&collected_ids[k]);
            if prev.is_some() {
                saved_vals[k] = prev.unwrap();
                saved_had[k] = true;
            } else {
                saved_had[k] = false;
            }
            self.type_map.remove(&collected_ids[k]);
        }

        let result = self.mono_function(concrete_def.unwrap(), type_args);

        // Restore the bindings the dispatcher had set, so the caller's
        // context isn't disturbed by the redirect.
        for k in 0usize..n_ids {
            if saved_had[k] {
                self.type_map.insert(collected_ids[k], saved_vals[k]);
            }
        }

        Option::some(result)
    }

    // Check if a type conforms to a user-defined protocol.
    // A type conforms if it has all the required methods from the protocol.
    fn check_protocol_conformance(self: &mut Mono, ty: &IrTy, proto: &ProtocolDef) -> bool {
        // Get the scope for the type (where its methods live)
        let scope_idx: u32 = 0u32;
        if ty.tag == IrTyTag::Struct {
            scope_idx = ty.struct_ref().scope_idx;
        } else if ty.tag == IrTyTag::Enum {
            scope_idx = ty.enum_ref().scope_idx;
        } else if ty.tag == IrTyTag::Builtin {
            // Builtins (i32, u8, ...) declare their methods on the
            // lang-item-tagged struct (e.g. `#[lang(builtin_i32)] struct i32 {}`).
            // Look up that struct's scope so user-defined protocols (Formattable,
            // Hashable, etc.) recognise the builtin's fmt/hash/equals methods.
            let lang_name = Mono::builtin_lang_name(ty.builtin());
            if lang_name.len() > 0 {
                let lang_id = self.ctx.get_lang_item(lang_name);
                if lang_id.is_some() {
                    let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                    if sd.is_some() {
                        scope_idx = sd.unwrap().scope_idx;
                    }
                }
            }
        }
        if scope_idx == 0u32 {
            // No scope means no methods - can't conform unless protocol has no methods
            return proto.methods.len() == 0;
        }

        // Check each protocol method exists in the type's scope, AND that the
        // type's method's generic-bounds are satisfiable for this receiver. The
        // bound check matters for cases like `Option<()> is Formattable`:
        // Option's `fmt<T: Formattable<T, F>, F>` body calls `T.fmt(...)` which
        // fails to mono for T=(). Without the bound check, conformance would be
        // true (fmt found by name) and downstream code (panic chain via
        // dyn_format_arg, iter::test_fuse, ...) tries to mono Option<()>::fmt
        // and crashes mid-mono with a confusing diagnostic.
        for i in 0usize..proto.methods.len() {
            let method = &proto.methods[i];
            let found = self.ctx.scopes.get(scope_idx).items.get(&method.name);
            if found.is_none() {
                return false;
            }
            let item = found.unwrap();
            let fn_id_val = if item.kind.tag == scope::NamedItemTag::Method {
                item.kind.id2()._value
            } else if item.kind.tag == scope::NamedItemTag::Function {
                item.kind.id()._value
            } else {
                continue;
            };
            let m_def = self.ctx.fn_defs.get(&fn_id_val);
            if m_def.is_none() { continue; }
            if !self.check_method_bounds_satisfied(m_def.unwrap(), ty) {
                return false;
            }
        }
        true
    }

    /// Verify that `m_def`'s generic-parameter bounds (if any) are satisfiable
    /// when `m_def`'s self-parameter is bound to `receiver_ty`. Used by
    /// `check_protocol_conformance` to make the by-name check stricter — a
    /// method with a `T: Formattable<T, F>` bound only counts toward conformance
    /// if the receiver's type-arg actually conforms.
    ///
    /// Caps recursion depth to prevent unbounded chains (cycle protection).
    fn check_method_bounds_satisfied(self: &mut Mono, m_def: &FnDef, receiver_ty: &IrTy) -> bool {
        if m_def.generic_params.len() == 0 { return true; }
        if m_def.params.len() == 0 { return true; }

        // Cycle / depth guard: bound-check recursion shouldn't run away on
        // pathologically nested types (e.g. Option<Option<...>>). 16 is deeper
        // than any sane sysroot type and well below stack-overflow risk.
        if self.bound_check_depth >= 16usize { return true; }
        self.bound_check_depth = self.bound_check_depth + 1usize;

        // Match self_param against receiver_ty to bind method generics.
        let self_param_ty = m_def.params[0].ty;
        let self_arg_ty = receiver_ty;
        if self_param_ty.tag == TyTag::Pointer {
            self_param_ty = self_param_ty.inner();
            if self_arg_ty.tag == IrTyTag::Pointer {
                self_arg_ty = self_arg_ty.inner();
            }
        }

        let n = m_def.generic_params.len();
        let inferred = self.ctx.arena.alloc_slice::<&IrTy>(n);
        let found = self.ctx.arena.alloc_slice::<bool>(n);
        for i in 0usize..n {
            inferred[i] = self.ctx.void_ty;
            found[i] = false;
        }
        self.unify_type_for_inference(self_param_ty, self_arg_ty, inferred, found, m_def.generic_params);

        // Snapshot any prior bindings on the method's generics, install the
        // newly-inferred ones, then check bounds.
        let saved_vals = self.ctx.arena.alloc_slice::<&IrTy>(n);
        let saved_had = self.ctx.arena.alloc_slice::<bool>(n);
        for i in 0usize..n {
            let gp_id = m_def.generic_params[i].id._value;
            let prev = self.type_map.get(&gp_id);
            if prev.is_some() {
                saved_vals[i] = prev.unwrap();
                saved_had[i] = true;
            } else {
                saved_had[i] = false;
            }
            if found[i] {
                self.type_map.insert(gp_id, inferred[i]);
            }
        }

        let result = true;
        for i in 0usize..n {
            if !found[i] { continue; }
            let gp = &m_def.generic_params[i];
            for b in 0usize..gp.bounds.len() {
                let bound_ty = gp.bounds[b];
                let bound_ir = self.resolve_type(bound_ty);
                // Only check Protocol bounds for now; non-Protocol bounds
                // (e.g. concrete-type equality bounds) are out of scope here.
                if bound_ir.tag == IrTyTag::Protocol {
                    let proto_def = self.ctx.protocol_defs.get(&bound_ir.proto_id());
                    if proto_def.is_some() {
                        // Skip lang-item Any/None/etc. — those are handled in
                        // the call-site `is`-check, not via methods.
                        if !self.check_protocol_conformance(inferred[i], proto_def.unwrap()) {
                            result = false;
                            break;
                        }
                    }
                }
            }
            if !result { break; }
        }

        // Restore bindings.
        for i in 0usize..n {
            let gp_id = m_def.generic_params[i].id._value;
            if saved_had[i] {
                self.type_map.insert(gp_id, saved_vals[i]);
            } else {
                self.type_map.remove(&gp_id);
            }
        }

        self.bound_check_depth = self.bound_check_depth - 1usize;
        result
    }

    // Compute the size of a type in bytes (for const evaluation of size_of)
    fn compute_type_size(self: &mut Mono, ty: &IrTy) -> usize {
        layout::compute_type_size(ty, self.ctx.pointer_size)
    }

    fn compute_type_align(self: &mut Mono, ty: &IrTy) -> usize {
        layout::compute_type_align(ty, self.ctx.pointer_size)
    }

    // Convert an IR type to a human-readable name string
    fn ir_type_name(self: &mut Mono, ty: &IrTy) -> &[u8] {
        if ty.tag == IrTyTag::Builtin {
            switch ty.builtin() {
                BuiltinType::Void => "()",
                BuiltinType::Never => "!",
                BuiltinType::Bool => "bool",
                BuiltinType::U8 => "u8",
                BuiltinType::U16 => "u16",
                BuiltinType::U32 => "u32",
                BuiltinType::U64 => "u64",
                BuiltinType::U128 => "u128",
                BuiltinType::I8 => "i8",
                BuiltinType::I16 => "i16",
                BuiltinType::I32 => "i32",
                BuiltinType::I64 => "i64",
                BuiltinType::I128 => "i128",
                BuiltinType::USize => "usize",
                BuiltinType::ISize => "isize",
                BuiltinType::F32 => "f32",
                BuiltinType::F64 => "f64",
                _ => "<unknown>",
            }
        } else if ty.tag == IrTyTag::Pointer {
            let inner_name = self.ir_type_name(ty.inner());
            let is_const = ty.is_const();
            let prefix: &[u8] = if is_const { "&" } else { "&mut " };
            let total = prefix.len() + inner_name.len();
            let buf = self.ctx.arena.alloc_slice::<u8>(total);
            prefix.copy_to_nonoverlapping(&buf[0]);
            inner_name.copy_to_nonoverlapping(&buf[prefix.len()]);
            buf as &[u8]
        } else if ty.tag == IrTyTag::Slice {
            let elem_ty = if ty.elems().len() > 0 && ty.elems()[0].tag == IrTyTag::Pointer {
                ty.elems()[0].inner()
            } else { self.ctx.void_ty };
            let inner_name = self.ir_type_name(elem_ty);
            let prefix = "&[";
            let suffix = "]";
            let total = prefix.len() + inner_name.len() + suffix.len();
            let buf = self.ctx.arena.alloc_slice::<u8>(total);
            prefix.copy_to_nonoverlapping(&buf[0]);
            inner_name.copy_to_nonoverlapping(&buf[prefix.len()]);
            suffix.copy_to_nonoverlapping(&buf[prefix.len() + inner_name.len()]);
            buf as &[u8]
        } else if ty.tag == IrTyTag::Array {
            let inner_name = self.ir_type_name(ty.inner());
            let size_str = format_usize(ty.array_size(), self.ctx.arena);
            // "[T; N]"
            let total = 1usize + inner_name.len() + 2usize + size_str.len() + 1usize;
            let buf = self.ctx.arena.alloc_slice::<u8>(total);
            buf[0] = '[';
            inner_name.copy_to_nonoverlapping(&buf[1]);
            buf[1 + inner_name.len()] = ';';
            buf[2 + inner_name.len()] = ' ';
            size_str.copy_to_nonoverlapping(&buf[3 + inner_name.len()]);
            buf[3 + inner_name.len() + size_str.len()] = ']';
            buf as &[u8]
        } else if ty.tag == IrTyTag::Struct {
            ty.struct_ref().name
        } else if ty.tag == IrTyTag::Enum {
            ty.enum_ref().name
        } else if ty.tag == IrTyTag::Tuple {
            // Just return "(...)"; full tuple formatting is complex
            "(...)"
        } else if ty.tag == IrTyTag::FnPointer {
            "fn(...)"
        } else if ty.tag == IrTyTag::Fn {
            // Render `name<arg1, arg2, ...>` source-readably for the source
            // type printer (`std::typing::type_name<f<u32>>()` should yield
            // "f<u32>", not the mangled `_ALfNNN` form). Look up the IrFunction
            // by (id, mangled_name) to recover the type_args this fn was mono'd
            // with — multiple monos of the same source `id` share the IrFnRef's
            // id, so the mangled_name disambiguates which mono we want.
            let fn_ref = ty.fn_item_ref();
            let src_name: &[u8] = fn_ref.mangled_name;
            let src_type_args: &[&IrTy] = &[];
            for i in 0usize..self.ctx.ir_functions.len() {
                if self.ctx.ir_functions[i].id._value == fn_ref.id._value
                    && self.ctx.ir_functions[i].mangled_name == fn_ref.mangled_name {
                    src_name = self.ctx.ir_functions[i].name;
                    src_type_args = self.ctx.ir_functions[i].type_args;
                    break;
                }
            }
            if src_type_args.len() == 0 {
                src_name
            } else {
                // Build "name<arg1, arg2, ...>".
                let arg_names = self.ctx.arena.alloc_slice::<&[u8]>(src_type_args.len());
                let total = src_name.len() + 2usize; // "name<>"
                for i in 0usize..src_type_args.len() {
                    arg_names[i] = self.ir_type_name(src_type_args[i]);
                    total = total + arg_names[i].len();
                    if i > 0 { total = total + 2usize; } // ", "
                }
                let buf = self.ctx.arena.alloc_slice::<u8>(total);
                src_name.copy_to_nonoverlapping(&buf[0]);
                buf[src_name.len()] = '<';
                let off = src_name.len() + 1usize;
                for i in 0usize..arg_names.len() {
                    if i > 0 {
                        buf[off] = ',';
                        buf[off + 1usize] = ' ';
                        off = off + 2usize;
                    }
                    arg_names[i].copy_to_nonoverlapping(&buf[off]);
                    off = off + arg_names[i].len();
                }
                buf[off] = '>';
                buf as &[u8]
            }
        } else if ty.tag == IrTyTag::Void {
            "()"
        } else {
            "<unknown>"
        }
    }

    // Lower "when" (static if) expression: evaluate condition at compile time
    fn lower_when(self: &mut Mono, expr: &Expr) -> &IrExpr {
        // Lower the condition expression
        let ir_cond = self.lower_expr(expr.cond());

        // Try to const-evaluate the condition
        let cond_result = self.try_const_eval_bool(ir_cond);
        let cond_val = if cond_result.is_some() {
            cond_result.unwrap()
        } else {
            // Cannot evaluate at compile time - default to false
            false
        };

        if cond_val {
            self.lower_expr(expr.lhs())
        } else {
            if expr.opt_expr().is_some() {
                self.lower_expr(expr.opt_expr().unwrap())
            } else {
                let r = IrExpr::void_expr(self.ctx.void_ty);
                self.ctx.arena.alloc(r)
            }
        }
    }

    // Lower static for: compile-time loop unrolling driven by const-evaluating
    // the iterator protocol (.iter() / .next()), same as a regular for loop but
    // with the loop variable available as a compile-time constant.
    fn lower_static_for(self: &mut Mono, expr: &Expr) -> &IrExpr {
        // 1. Lower the iterable
        let iterable_ir = self.lower_expr(expr.lhs());
        let iterable_ty = iterable_ir.ty;

        if iterable_ty.is_void() {
            return self.ctx.arena.alloc(IrExpr::void_expr(self.ctx.void_ty));
        }

        // 2. Store iterable in a local, call .iter() — same as lower_for_iterator
        let iterable_var_id = self.ctx.id_gen.next_id();
        self.local_types.insert(iterable_var_id._value, iterable_ty);
        self.local_defs.push(IrLocalDef { id: iterable_var_id, ty: iterable_ty, name: "_sf_iterable", span: Span::empty() });
        let ir_let_iterable = self.mk_let(iterable_var_id, iterable_ty, iterable_ir);

        let ir_iterable_ref = self.mk_ref(self.mk_local(iterable_var_id, iterable_ty), false);
        let iter_call = self.resolve_method_call_on_type(iterable_ty, "iter", ir_iterable_ref, &[]);
        let iter_ir: &IrExpr;
        let iter_ty: &IrTy;
        if iter_call.is_some() {
            iter_ir = iter_call.unwrap();
            iter_ty = iter_ir.ty;
        } else {
            // No .iter() — use the value directly (e.g. it IS the iterator)
            iter_ir = self.mk_local(iterable_var_id, iterable_ty);
            iter_ty = iterable_ty;
        }

        // 3. Store iterator in a local
        let iter_var_id = self.ctx.id_gen.next_id();
        self.local_types.insert(iter_var_id._value, iter_ty);
        self.local_defs.push(IrLocalDef { id: iter_var_id, ty: iter_ty, name: "_sf_iter", span: Span::empty() });
        let ir_let_iter = self.mk_let(iter_var_id, iter_ty, iter_ir);

        // 4. Build .next() call IR (will be const-evaluated repeatedly)
        let ir_iter_ref = if iter_ty.tag == IrTyTag::Pointer {
            self.mk_local(iter_var_id, iter_ty)
        } else {
            self.mk_ref(self.mk_local(iter_var_id, iter_ty), false)
        };
        let next_call = self.resolve_method_call_on_type(iter_ty, "next", ir_iter_ref, &[]);
        if next_call.is_none() {
            // Report against the receiver type so the user sees which iterator
            // shape lacks .next() — not just "could not resolve 'next'".
            let unwrapped_iter_ty = iter_ty;
            while unwrapped_iter_ty.tag == IrTyTag::Pointer {
                unwrapped_iter_ty = unwrapped_iter_ty.inner();
            }
            let ty_name = self.ir_type_name(unwrapped_iter_ty);
            self.emit_diag(diagnostics::CodeDiagnostic::unresolved_method(expr.span, "next", ty_name));
            return self.ctx.arena.alloc(IrExpr::void_expr(self.ctx.void_ty));
        }
        let ir_next_call = next_call.unwrap();

        // 5. Build initialization block and const-evaluate it
        let init_block_items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
        init_block_items[0] = ir_let_iterable;
        init_block_items[1] = ir_let_iter;
        let init_block = self.mk_block_void(init_block_items);

        let sf_vars: HashMap<usize, ConstValue> = HashMap::new();
        let evaluator = const_eval::ConstEvaluator::new(
            self.ctx.arena,
            &sf_vars,
            self.ctx.id_gen,
            self.ctx.ir_functions.as_slice(),
            self.ctx.ir_globals.as_slice(),
            &self.ctx.const_values,
            self.ctx.pointer_size,
        );
        let init_result = evaluator.eval(init_block);
        if !init_result.ok {
            return self.ctx.arena.alloc(IrExpr::void_expr(self.ctx.void_ty));
        }

        // 6. Drive iteration: const-eval .next() repeatedly, lower body per value
        let stmts: Vector<&IrExpr> = Vector::new();
        let loop_var_id = expr.id()._value;

        loop {
            let next_result = evaluator.eval(ir_next_call);
            if !next_result.ok { break; }

            // Result is Option<T> struct: { _is_some: bool, _inner: T }
            let opt_val = next_result.value;
            if opt_val.tag != CValTag::Struct { break; }

            // Check _is_some (field index 0)
            let is_some = false;
            for fi in 0usize..opt_val.fields().len() {
                if opt_val.fields()[fi].field_idx == 0u32 {
                    is_some = opt_val.fields()[fi].value.int_val() != 0;
                    break;
                }
            }
            if !is_some { break; }

            // Extract _inner (field index 1)
            let inner_val = ConstValue::make_void();
            for fi in 0usize..opt_val.fields().len() {
                if opt_val.fields()[fi].field_idx == 1u32 {
                    inner_val = opt_val.fields()[fi].value;
                    break;
                }
            }

            // Set the loop variable as a compile-time constant
            self.const_replacements.insert(loop_var_id, inner_val);

            // Track local_defs before this iteration
            let iter_defs_start = self.local_defs.len();

            // Lower the body
            let body_ir = self.lower_expr(expr.rhs());

            // Remap new locals to fresh IDs so iterations don't collide
            if stmts.len() > 0 {
                let remap: HashMap<usize, usize> = HashMap::new();
                for di in iter_defs_start..self.local_defs.len() {
                    let old_id = self.local_defs[di].id._value;
                    let new_id = self.ctx.id_gen.next_id();
                    remap.insert(old_id, new_id._value);
                    self.local_defs[di].id = new_id;
                    self.local_types.insert(new_id._value, self.local_defs[di].ty);
                }
                if remap.len() > 0 {
                    self.remap_ir_locals(body_ir, &remap);
                }
            }

            stmts.push(body_ir);
        }

        // Clean up const replacement
        self.const_replacements.remove(&loop_var_id);

        if stmts.len() == 0 {
            return self.ctx.arena.alloc(IrExpr::void_expr(self.ctx.void_ty));
        }

        let result_items = self.ctx.arena.alloc_slice::<&IrExpr>(stmts.len());
        for i in 0usize..stmts.len() {
            result_items[i] = stmts[i];
        }
        self.mk_block_void(result_items)
    }

    // Generate tuple unpacking let-bindings for `for (a, b, ...) in iterable` loops.
    // Returns a slice of IR statements: [let _tuple = elem_ir, let a = _tuple.(0), let b = _tuple.(1), ...]
    // For non-tuple loops (expr.args is empty), returns [let item = elem_ir].
    fn make_for_loop_bindings(self: &mut Mono, expr: &Expr, elem_ir: &IrExpr, elem_ty: &IrTy) -> &[&IrExpr] {
        let loop_var_id = expr.id();

        if expr.args().len() == 0 {
            // Simple case: for item in iterable
            self.local_types.insert(loop_var_id._value, elem_ty);
            self.local_defs.push(IrLocalDef { id: loop_var_id, ty: elem_ty, name: "", span: Span::empty() });
            let stmts = self.ctx.arena.alloc_slice::<&IrExpr>(1);
            stmts[0] = self.mk_let(loop_var_id, elem_ty, elem_ir);
            return stmts;
        }

        // Tuple unpacking: for (a, b, ...) in iterable
        // let _tuple = elem_ir;
        self.local_types.insert(loop_var_id._value, elem_ty);
        self.local_defs.push(IrLocalDef { id: loop_var_id, ty: elem_ty, name: "_tuple", span: Span::empty() });

        let n = expr.args().len();
        let stmts = self.ctx.arena.alloc_slice::<&IrExpr>(1 + n);
        stmts[0] = self.mk_let(loop_var_id, elem_ty, elem_ir);

        // For each tuple element: let a = _tuple.(idx)
        for i in 0usize..n {
            let elem_arg = expr.args()[i];
            let elem_id = elem_arg.id();

            // Get the tuple element type
            let field_ty = if elem_ty.tag == IrTyTag::Tuple && i < elem_ty.elems().len() {
                elem_ty.elems()[i]
            } else if elem_ty.tag == IrTyTag::Struct && i < elem_ty.struct_ref().fields.len() {
                elem_ty.struct_ref().fields[i].ty
            } else {
                self.ctx.void_ty
            };

            self.local_types.insert(elem_id._value, field_ty);
            self.local_defs.push(IrLocalDef { id: elem_id, ty: field_ty, name: "", span: Span::empty() });

            let ir_field = self.mk_field(self.mk_local(loop_var_id, elem_ty), i as u32, field_ty);
            stmts[1 + i] = self.mk_let(elem_id, field_ty, ir_field);
        }

        stmts
    }

    // Resolve a method call on a known IR type, returning the call result
    fn resolve_lang_scope(self: &mut Mono, lang_name: &[u8]) -> u32 {
        let lang_id = self.ctx.get_lang_item(lang_name);
        if lang_id.is_some() {
            let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
            if sd.is_some() {
                return sd.unwrap().scope_idx;
            }
        }
        0u32
    }

    fn resolve_method_call_on_type(self: &mut Mono, ty: &IrTy, method_name: &[u8], self_arg: &IrExpr, args: &[&IrExpr]) -> Option<&IrExpr> {
        let resolved_ty = ty;
        if resolved_ty.tag == IrTyTag::Pointer {
            resolved_ty = resolved_ty.inner();
        }
        let scope_idx: u32 = 0u32;
        let method_type_args: &[&IrTy] = &[];
        if resolved_ty.tag == IrTyTag::Struct {
            scope_idx = resolved_ty.struct_ref().scope_idx;
            method_type_args = resolved_ty.struct_ref().type_args;
        } else if resolved_ty.tag == IrTyTag::Enum {
            scope_idx = resolved_ty.enum_ref().scope_idx;
        } else if resolved_ty.tag == IrTyTag::Slice {
            scope_idx = self.resolve_lang_scope("slice");
            if scope_idx != 0u32 {
                let elem_ty = self.slice_elem_ty(resolved_ty);
                let ptr_ty = self.ctx.make_ptr_ty(elem_ty, false);
                let ta = self.ctx.arena.alloc_slice::<&IrTy>(1);
                ta[0] = ptr_ty;
                method_type_args = ta;
            }
        } else if resolved_ty.tag == IrTyTag::Array {
            scope_idx = self.resolve_lang_scope("builtin_array");
        } else if resolved_ty.tag == IrTyTag::Tuple {
            scope_idx = self.resolve_lang_scope("builtin_tuple");
        } else if resolved_ty.tag == IrTyTag::Fn || resolved_ty.tag == IrTyTag::FnPointer || resolved_ty.tag == IrTyTag::Closure {
            scope_idx = self.resolve_lang_scope("builtin_callable");
        } else if resolved_ty.tag == IrTyTag::Builtin {
            let lang_name = Mono::builtin_lang_name(resolved_ty.builtin());
            if lang_name.len() > 0 {
                scope_idx = self.resolve_lang_scope(lang_name);
            }
        }
        if scope_idx == 0u32 {
            return Option::none();
        }

        let method_item = self.ctx.scopes.get(scope_idx).items.get(&method_name);
        if method_item.is_none() {
            return Option::none();
        }
        let item = method_item.unwrap();

        let fn_id = if item.kind.tag == NamedItemTag::Function {
            item.kind.id()
        } else if item.kind.tag == NamedItemTag::Method {
            item.kind.id2()
        } else {
            return Option::none();
        };

        let fn_def = self.ctx.fn_defs.get(&fn_id._value);
        if fn_def.is_none() {
            return Option::none();
        }
        let def = fn_def.unwrap();

        // For mixin'd methods, resolve the mixin's type args.
        // The mixin type args contain Placeholder refs to the IMPL's generic params,
        // so we must map those impl param IDs to concrete types from the struct's type_args.
        let mixin_args = self.ctx.scopes.get_mixin_type_args(scope_idx, fn_id._value);
        if mixin_args.is_some() {
            let ast_args = mixin_args.unwrap();
            // Same AST-vs-IR placeholder binding as in try_lower_method_call —
            // the impl-gp-ids fallback doesn't reliably catch the placeholder
            // ids the mixin AST actually uses (see bind_placeholders_from_ast_vs_ir).
            if ast_args.len() > 0 {
                self.bind_placeholders_from_ast_vs_ir(ast_args[0], resolved_ty);
            }
            let impl_gp_ids = self.ctx.scopes.get_mixin_impl_generic_ids(scope_idx, fn_id._value);
            if impl_gp_ids.is_some() && resolved_ty.tag == IrTyTag::Struct {
                let ids = impl_gp_ids.unwrap();
                let n_gp = std::cmp::min(ids.len(), resolved_ty.struct_ref().type_args.len());
                for gi in 0usize..n_gp {
                    self.type_map.insert(ids[gi]._value, resolved_ty.struct_ref().type_args[gi]);
                }
            }
            let resolved = self.ctx.arena.alloc_slice::<&IrTy>(ast_args.len());
            for i in 0usize..ast_args.len() {
                resolved[i] = self.resolve_type(ast_args[i]);
            }
            // Bind protocol generics (Self + others) from the mixin's args via
            // type_map; what remains is the method's own.
            let consumed = self.bind_proto_generics(def, resolved);
            method_type_args = resolved[consumed..];
        }

        // For protocol methods, also set Self type from resolved_ty (covers
        // direct-call paths where there is no mixin info recording Self).
        let self_id_opt = self.ctx.proto_method_self_id.get(&fn_id._value);
        if self_id_opt.is_some() {
            self.type_map.insert(self_id_opt.unwrap(), resolved_ty);
        }

        // Infer type args from self parameter if the method has its own generics
        let all_type_args = method_type_args;
        if def.generic_params.len() > 0 {
            let num_generics = def.generic_params.len();
            let inferred = self.ctx.arena.alloc_slice::<&IrTy>(num_generics);
            let found = self.ctx.arena.alloc_slice::<bool>(num_generics);
            for i in 0usize..num_generics {
                inferred[i] = self.ctx.void_ty;
                found[i] = false;
            }
            // Infer from self parameter
            if def.params.len() > 0 {
                let self_param_ty = def.params[0].ty;
                let self_arg_ty = self_arg.ty;
                // Strip matching pointer/ref layers for unification
                while self_param_ty.tag == TyTag::Pointer && self_arg_ty.tag == IrTyTag::Pointer {
                    self_param_ty = self_param_ty.inner();
                    self_arg_ty = self_arg_ty.inner();
                }
                // Also strip IR pointer if AST is not a pointer (autoref will handle it)
                while self_param_ty.tag != TyTag::Pointer && self_arg_ty.tag == IrTyTag::Pointer {
                    self_arg_ty = self_arg_ty.inner();
                }
                self.unify_type_for_inference(self_param_ty, self_arg_ty, inferred, found, def.generic_params);
            }
            // Infer from explicit args
            for p in 0usize..args.len() {
                if (p + 1) >= def.params.len() { break; }
                self.unify_type_for_inference(def.params[p + 1].ty, args[p].ty, inferred, found, def.generic_params);
            }
            // Fill remaining from method_type_args
            for i in 0usize..num_generics {
                if !found[i] && i < method_type_args.len() {
                    inferred[i] = method_type_args[i];
                }
            }
            all_type_args = inferred;
        }

        let fn_idx = self.mono_function(def, all_type_args);
        let ir_fn = &self.ctx.ir_functions[fn_idx];

        // Build call args: self_arg + args
        let call_args = self.ctx.arena.alloc_slice::<&IrExpr>(1 + args.len());
        // Autoref/autoderef self_arg to match method's self parameter
        let self_param_ty = if ir_fn.params.len() > 0 { ir_fn.params[0].ty } else { self_arg.ty };
        call_args[0] = self.autoref(self_arg, self_param_ty);
        for i in 0usize..args.len() {
            call_args[1 + i] = args[i];
        }

        let fn_ref = IrFnRef {
            id: ir_fn.id,
            mangled_name: ir_fn.mangled_name,
        };
        Option::some(self.mk_call(fn_ref, call_args, ir_fn.return_type))
    }

    // Lower memory operations: ExprTag::Ref, ExprTag::Deref, ExprTag::FieldAccess, ExprTag::TupleIndex, ExprTag::Index, ExprTag::Cast, ExprTag::TypeCheck
    fn lower_memory(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == ExprTag::Ref {
            let ir_inner = self.lower_expr(expr.lhs());
            self.mk_ref(ir_inner, !expr.flag())
        } else if expr.tag == ExprTag::Deref {
            let ir_inner = self.lower_expr(expr.lhs());
            let pointee_ty = if ir_inner.ty.tag == IrTyTag::Pointer {
                ir_inner.ty.inner()
            } else {
                self.emit_diag(diagnostics::CodeDiagnostic::invalid_deref(expr.span));
                self.ctx.void_ty
            };
            self.mk_deref(ir_inner, pointee_ty)
        } else if expr.tag == ExprTag::FieldAccess {
            let ir_obj = self.lower_expr(expr.lhs());
            // Auto-deref through pointers for field access
            let actual_obj = ir_obj;
            loop {
                if actual_obj.ty.tag != IrTyTag::Pointer {
                    break;
                }
                actual_obj = self.mk_deref(actual_obj, actual_obj.ty.inner());
            }
            // Find field index on the dereferenced struct type
            let (field_idx, field_ty, field_found) = self.resolve_field(actual_obj.ty, expr.str_val());
            if !field_found && expr.str_val().len() > 0usize && !self.suppress_field_error {
                let ty_name = self.ir_type_name(actual_obj.ty);
                self.emit_diag(diagnostics::CodeDiagnostic::unresolved_field(expr.span, expr.str_val(), ty_name));
            }
            self.mk_field(actual_obj, field_idx, field_ty)
        } else if expr.tag == ExprTag::TupleIndex {
            let ir_obj = self.lower_expr(expr.lhs());
            // Auto-deref through pointer layers — `t.0` / `t.(i)` on a `&T`
            // should reach into the pointee tuple, mirroring FieldAccess.
            while ir_obj.ty.tag == IrTyTag::Pointer {
                ir_obj = self.mk_deref(ir_obj, ir_obj.ty.inner());
            }
            // Resolve index: either from literal index_val or from const-evaluated expression
            let idx: usize = if expr.opt_expr().is_some() {
                let ir_idx = self.lower_expr(expr.opt_expr().unwrap());
                let val = self.try_const_eval_u64(ir_idx);
                if val.is_some() { val.unwrap() as usize } else { expr.index_val() }
            } else {
                expr.index_val()
            };
            let elem_ty = if ir_obj.ty.tag == IrTyTag::Tuple {
                if idx < ir_obj.ty.elems().len() {
                    ir_obj.ty.elems()[idx]
                } else {
                    self.emit_diag(diagnostics::CodeDiagnostic::tuple_index_oob(expr.span));
                    self.ctx.void_ty
                }
            } else if ir_obj.ty.tag == IrTyTag::Struct && !ir_obj.ty.struct_ref().is_zero_sized {
                // Tuples of non-trivial types may be lowered as anonymous structs
                if idx < ir_obj.ty.struct_ref().fields.len() {
                    ir_obj.ty.struct_ref().fields[idx].ty
                } else {
                    self.emit_diag(diagnostics::CodeDiagnostic::tuple_index_oob(expr.span));
                    self.ctx.void_ty
                }
            } else {
                self.ctx.void_ty
            };
            self.mk_field(ir_obj, idx as u32, elem_ty)
        } else if expr.tag == ExprTag::Index {
            let ir_base = self.lower_expr(expr.lhs());

            // Auto-deref through pointer layers to find the underlying type.
            // Pointers cannot be directly indexed in Alumina (use *(ptr + i) instead).
            let derefed = ir_base;
            while derefed.ty.tag == IrTyTag::Pointer {
                derefed = self.mk_deref(derefed, derefed.ty.inner());
            }

            // Lower the index expression and determine whether it's a range
            // (sub-slicing) or a scalar (element access).
            let ir_index = self.lower_expr(expr.rhs());

            // Coerce to indexable type (slice/array) via as_slice() if needed
            let indexee = self.coerce_to_indexable(derefed);

            if self.is_range_ty(ir_index.ty) {
                // Range indexing (sub-slicing): extract lower/upper bounds from
                // the appropriate fields of each range variant.
                let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
                let range_struct_id = ir_index.ty.struct_ref().id._value;
                let len_expr = self.get_indexee_len(indexee);
                let zero_lit = self.mk_int_lit(usize_ty, 0u64);

                let ir_start: &IrExpr = zero_lit;
                let ir_end: &IrExpr = len_expr;

                if self.ctx.is_lang_item(range_struct_id, "range_full") {
                    // .. — full slice. start = 0, end = len.
                } else if self.ctx.is_lang_item(range_struct_id, "range_from") {
                    // a.. — start = lower, end = len.
                    ir_start = self.mk_cast(self.mk_field(ir_index, 0u32, ir_index.ty.struct_ref().fields[0].ty), usize_ty);
                } else if self.ctx.is_lang_item(range_struct_id, "range_to") {
                    // ..b — start = 0, end = upper.
                    ir_end = self.mk_cast(self.mk_field(ir_index, 0u32, ir_index.ty.struct_ref().fields[0].ty), usize_ty);
                } else if self.ctx.is_lang_item(range_struct_id, "range_to_inclusive") {
                    // ..=b — start = 0, end = upper + 1.
                    let upper = self.mk_cast(self.mk_field(ir_index, 0u32, ir_index.ty.struct_ref().fields[0].ty), usize_ty);
                    let one_lit = self.mk_int_lit(usize_ty, 1u64);
                    ir_end = self.mk_binary(BinOp::Add, upper, one_lit, usize_ty);
                } else if self.ctx.is_lang_item(range_struct_id, "range_inclusive") {
                    // a..=b — start = lower, end = upper + 1.
                    ir_start = self.mk_cast(self.mk_field(ir_index, 0u32, ir_index.ty.struct_ref().fields[0].ty), usize_ty);
                    let upper = self.mk_cast(self.mk_field(ir_index, 1u32, ir_index.ty.struct_ref().fields[1].ty), usize_ty);
                    let one_lit = self.mk_int_lit(usize_ty, 1u64);
                    ir_end = self.mk_binary(BinOp::Add, upper, one_lit, usize_ty);
                } else {
                    // Fallback: legacy Range<T> { lower, upper } shape.
                    // Aluminac sysroot uses this for `..` (no RangeFull lang item),
                    // emitting Range<usize>{0, MAX_USIZE} as a sentinel. Detect the
                    // sentinel and use the indexee's length.
                    ir_start = self.mk_cast(self.mk_field(ir_index, 0u32, ir_index.ty.struct_ref().fields[0].ty), usize_ty);
                    if ir_index.ty.struct_ref().fields.len() > 1 {
                        let is_sentinel = false;
                        if ir_index.tag == IrTag::StructLit {
                            let upper_item = ir_index._data.struct_lit.items[1];
                            if upper_item.tag == IrTag::IntLit && upper_item.int_val() == 18446744073709551615u64 {
                                is_sentinel = true;
                            }
                        }
                        if is_sentinel {
                            ir_end = len_expr;
                        } else {
                            ir_end = self.mk_cast(self.mk_field(ir_index, 1u32, ir_index.ty.struct_ref().fields[1].ty), usize_ty);
                        }
                    }
                }
                return self.lower_subslice_ir(indexee, ir_start, ir_end);
            }

            if indexee.ty.tag == IrTyTag::Slice {
                let elem_ty = self.slice_elem_ty(indexee.ty);
                let data_ptr_ty = self.ctx.make_ptr_ty(elem_ty, false);
                let data_ptr_ref = self.mk_field(indexee, SLICE_DATA_FIELD, data_ptr_ty);
                return self.mk_index(data_ptr_ref, ir_index, elem_ty);
            }

            if indexee.ty.tag == IrTyTag::Array {
                return self.mk_index(indexee, ir_index, indexee.ty.inner());
            }

            self.emit_diag(diagnostics::CodeDiagnostic::generic_error(expr.span, "cannot index into this type"));
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IrTag::Undef;
            self.ctx.arena.alloc(result) as &IrExpr
        } else if expr.tag == ExprTag::Cast {
            let ir_inner = self.lower_expr(expr.lhs());
            let ir_ty = self.resolve_type(expr.ty());
            // Fn item (ZST) → fn pointer: emit a FnRef so codegen can take
            // the function's address. Otherwise gen_cast falls through to
            // `coerce_value` on a ZST source and produces a broken pointer
            // (segfaults at call time). Mirrors the implicit-coerce path in
            // `try_coerce`. Required by `callable::as_callback`'s
            // `util::unit::<u<F>>() as fn(...)` pattern.
            if ir_inner.ty.tag == IrTyTag::Fn && ir_ty.tag == IrTyTag::FnPointer {
                let fn_ref = ir_inner.ty.fn_item_ref();
                let result = IrExpr::void_expr(ir_ty);
                result.tag = IrTag::FnRef;
                result._data.fn_ref = fn_ref;
                return self.ctx.arena.alloc(result);
            }
            self.mk_cast(ir_inner, ir_ty)
        } else if expr.tag == ExprTag::TypeCheck {
            // "expr is Protocol" - protocol conformance check
            // Evaluate at compile time when possible
            let ir_val = self.lower_expr(expr.lhs());
            let val_ty = ir_val.ty;

            // Check for ZeroSized protocol: type is ZST if it has no runtime representation
            let check_ty = expr.ty(); // The protocol type (TyTag::Named)
            let is_match = false;

            // Follow non-generic TypeAlias indirections so that
            // `type AnyOption = SameBaseAs<Option<()>>;` followed by
            // `value is AnyOption` routes through the SameBaseAs branch
            // below. Generic aliases (those with their own type-args) need
            // substitution and are left to resolve_type.
            let alias_steps: usize = 0;
            loop {
                if alias_steps >= 8 { break; }
                let named: &Ty = if check_ty.tag == TyTag::Named {
                    check_ty
                } else {
                    null as &Ty
                };
                if named as &void == null { break; }
                let alias_opt = self.ctx.type_aliases.get(&named.id()._value);
                if alias_opt.is_none() { break; }
                let alias = alias_opt.unwrap();
                if alias.generic_params.len() > 0 { break; }
                check_ty = alias.target;
                alias_steps = alias_steps + 1;
            }

            // Resolve the protocol name to check specific protocols.
            // Extract protocol ID from TyTag::Named, TyTag::Generic(TyTag::Named),
            // or TyTag::Placeholder when the placeholder substitutes to a
            // Protocol IrTy (carries proto_id).
            let proto_id_value: usize = 0usize;
            let has_proto_id = false;
            if check_ty.tag == TyTag::Named {
                proto_id_value = check_ty.id()._value;
                has_proto_id = true;
            } else if check_ty.tag == TyTag::Generic && check_ty.inner().tag == TyTag::Named {
                proto_id_value = check_ty.inner().id()._value;
                has_proto_id = true;
            } else if check_ty.tag == TyTag::Placeholder {
                // Generic-call-site substitution: the AST-level type-arg may have
                // been a protocol. resolve_named_type wraps protocols as
                // IrTyTag::Protocol carrying the proto_id; recover it here.
                let resolved = self.type_map.get(&check_ty.id()._value);
                if resolved.is_some() {
                    let r = resolved.unwrap();
                    if r.tag == IrTyTag::Protocol {
                        proto_id_value = r.proto_id();
                        has_proto_id = true;
                    }
                }
            }
            if has_proto_id {
                let protocol = self.ctx.protocol_defs.get(&proto_id_value);
                if protocol.is_some() {
                    let proto = protocol.unwrap();
                    if self.ctx.is_lang_item(proto_id_value, "proto_zero_sized") {
                        is_match = val_ty.is_zero_sized();
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_pointer") {
                        is_match = val_ty.tag == IrTyTag::Pointer;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_primitive") {
                        is_match = val_ty.tag == IrTyTag::Builtin;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_numeric") {
                        if val_ty.tag == IrTyTag::Builtin {
                            is_match = val_ty.builtin() != BuiltinType::Bool && val_ty.builtin() != BuiltinType::Void;
                        }
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_integer") {
                        if val_ty.tag == IrTyTag::Builtin {
                            is_match = val_ty.builtin() != BuiltinType::Bool && val_ty.builtin() != BuiltinType::Void && val_ty.builtin() != BuiltinType::F32 && val_ty.builtin() != BuiltinType::F64;
                        }
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_floating_point") {
                        if val_ty.tag == IrTyTag::Builtin {
                            is_match = val_ty.builtin() == BuiltinType::F32 || val_ty.builtin() == BuiltinType::F64;
                        }
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_signed") {
                        if val_ty.tag == IrTyTag::Builtin {
                            is_match = val_ty.builtin() == BuiltinType::I8 || val_ty.builtin() == BuiltinType::I16 || val_ty.builtin() == BuiltinType::I32 || val_ty.builtin() == BuiltinType::I64 || val_ty.builtin() == BuiltinType::I128 || val_ty.builtin() == BuiltinType::ISize;
                        }
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_unsigned") {
                        if val_ty.tag == IrTyTag::Builtin {
                            is_match = val_ty.builtin() == BuiltinType::U8 || val_ty.builtin() == BuiltinType::U16 || val_ty.builtin() == BuiltinType::U32 || val_ty.builtin() == BuiltinType::U64 || val_ty.builtin() == BuiltinType::U128 || val_ty.builtin() == BuiltinType::USize;
                        }
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_struct") {
                        is_match = val_ty.tag == IrTyTag::Struct && !val_ty.struct_ref().is_union;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_union") {
                        is_match = val_ty.tag == IrTyTag::Struct && val_ty.struct_ref().is_union;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_enum") {
                        is_match = val_ty.tag == IrTyTag::Enum;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_array") {
                        is_match = val_ty.tag == IrTyTag::Array;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_tuple") {
                        // `()` collapses to void_ty in make_tuple_ty; treat
                        // Void as the zero-tuple for protocol-conformance too.
                        is_match = val_ty.tag == IrTyTag::Tuple || val_ty.tag == IrTyTag::Void;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_closure") {
                        is_match = val_ty.tag == IrTyTag::Closure;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_function_pointer") {
                        is_match = val_ty.tag == IrTyTag::FnPointer;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_named_function") {
                        is_match = val_ty.tag == IrTyTag::Fn;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_callable") {
                        is_match = val_ty.tag == IrTyTag::Fn || val_ty.tag == IrTyTag::FnPointer || val_ty.tag == IrTyTag::Closure;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_range") {
                        is_match = self.is_range_ty(val_ty);
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_any") {
                        is_match = true;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_none") {
                        is_match = false;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_array_of") {
                        // ArrayOf<T>: val_ty is an array whose element type is T.
                        if val_ty.tag == IrTyTag::Array && check_ty.tag == TyTag::Generic && check_ty.elems().len() >= 1 {
                            let arg_ty = self.resolve_type(check_ty.elems()[0]);
                            is_match = val_ty.inner() as &void == arg_ty as &void;
                        }
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_pointer_of") {
                        // PointerOf<T>: val_ty is a pointer (any mutability) whose pointee is T.
                        if val_ty.tag == IrTyTag::Pointer && check_ty.tag == TyTag::Generic && check_ty.elems().len() >= 1 {
                            let arg_ty = self.resolve_type(check_ty.elems()[0]);
                            is_match = val_ty.inner() as &void == arg_ty as &void;
                        }
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_same_layout_as") {
                        // SameLayoutAs<T>: val_ty has the same size and alignment as T.
                        if check_ty.tag == TyTag::Generic && check_ty.elems().len() >= 1 {
                            let arg_ty = self.resolve_type(check_ty.elems()[0]);
                            let val_size = layout::compute_type_size(val_ty, self.ctx.pointer_size);
                            let arg_size = layout::compute_type_size(arg_ty, self.ctx.pointer_size);
                            let val_align = layout::compute_type_align(val_ty, self.ctx.pointer_size);
                            let arg_align = layout::compute_type_align(arg_ty, self.ctx.pointer_size);
                            is_match = val_size == arg_size && val_align == arg_align;
                        }
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_same_base_as") {
                        // SameBaseAs<T>: val_ty and T are both struct/enum monomorphizations
                        // of the same base generic def. Compare def-ids.
                        if check_ty.tag == TyTag::Generic && check_ty.elems().len() >= 1 {
                            let arg_ty = self.resolve_type(check_ty.elems()[0]);
                            if val_ty.tag == IrTyTag::Struct && arg_ty.tag == IrTyTag::Struct {
                                is_match = val_ty.struct_ref().id._value == arg_ty.struct_ref().id._value;
                            } else if val_ty.tag == IrTyTag::Enum && arg_ty.tag == IrTyTag::Enum {
                                is_match = val_ty.enum_ref().id._value == arg_ty.enum_ref().id._value;
                            }
                        }
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_meta") {
                        // Meta: val_ty is itself a protocol (declared as such in source).
                        // Aluminac wraps protocols as IrTyTag::Protocol so the check is direct.
                        is_match = val_ty.tag == IrTyTag::Protocol;
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_range_of") {
                        // RangeOf<T>: val_ty is a Range<T> / RangeInclusive<T> / etc.
                        // RangeFull has no type parameter and never matches.
                        if self.is_range_ty(val_ty) && check_ty.tag == TyTag::Generic && check_ty.elems().len() >= 1 {
                            let arg_ty = self.resolve_type(check_ty.elems()[0]);
                            let ta = val_ty.struct_ref().type_args;
                            if ta.len() >= 1 {
                                is_match = ta[0] as &void == arg_ty as &void;
                            }
                        }
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_const") {
                        // Const: val_ty is an ItemRef whose underlying item is a const.
                        is_match = val_ty.tag == IrTyTag::ItemRef && val_ty.item_ref_is_const();
                    } else if self.ctx.is_lang_item(proto_id_value, "proto_static") {
                        // Static: val_ty is an ItemRef whose underlying item is a static.
                        is_match = val_ty.tag == IrTyTag::ItemRef && !val_ty.item_ref_is_const();
                    } else {
                        // User-defined protocol: check if type has all required methods
                        is_match = self.check_protocol_conformance(val_ty, proto);
                    }
                } else {
                    // Not a protocol - concrete type comparison
                    let check_ir_ty = self.resolve_type(check_ty);
                    is_match = val_ty as &void == check_ir_ty as &void;
                }
            } else {
                // Non-named type: resolve and compare
                let check_ir_ty = self.resolve_type(check_ty);
                is_match = val_ty as &void == check_ir_ty as &void;
            }

            self.mk_bool_lit(is_match)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    /// Lower a method call on a `dyn Proto` value to vtable dispatch.
    ///
    /// `ir_obj` is the dyn struct value (the call's receiver). Builds:
    ///   - a typed fn-pointer for `dyn_val._ptr` + `dyn_val._vtable[idx]`,
    ///   - a Call with (data_ptr, args...) where data_ptr = dyn_val._ptr.
    ///
    /// Returns None if the method isn't found in any of the dyn's protocols
    /// (caller falls back to the historical Unreachable lowering).
    fn lower_dyn_method_call(self: &mut Mono, expr: &Expr, ir_obj: &IrExpr,
                              dyn_struct_ty: &IrTy, method_name: &[u8]) -> Option<&IrExpr> {
        let type_args = dyn_struct_ty.struct_ref().type_args;
        if type_args.len() < 1 {
            return Option::none();
        }
        let protos_tuple = type_args[0];
        if protos_tuple.tag != IrTyTag::Tuple {
            return Option::none();
        }

        // Find the method's index in the concatenated method list across protos,
        // and recover the protocol method's FnDef for its signature.
        let method_idx: usize = 0;
        let proto_method_def: Option<&FnDef> = Option::none();
        let cumulative: usize = 0;
        let elems = protos_tuple.elems();
        for pi in 0usize..elems.len() {
            let proto_ty = elems[pi];
            if proto_ty.tag != IrTyTag::Protocol { continue; }
            let pdef = self.ctx.protocol_defs.get(&proto_ty.proto_id());
            if pdef.is_none() { continue; }
            let proto = pdef.unwrap();
            for mi in 0usize..proto.methods.len() {
                if proto.methods[mi].name == method_name {
                    method_idx = cumulative + mi;
                    proto_method_def = Option::some(&proto.methods[mi]);
                    break;
                }
            }
            if proto_method_def.is_some() { break; }
            cumulative = cumulative + proto.methods.len();
        }
        if proto_method_def.is_none() {
            return Option::none();
        }
        let proto_method = proto_method_def.unwrap();

        // The dyn struct value: deref if ir_obj is a pointer.
        let dyn_val = if ir_obj.ty.tag == IrTyTag::Pointer {
            self.mk_deref(ir_obj, dyn_struct_ty)
        } else {
            ir_obj
        };

        // Field 0 = _ptr (void pointer); field 1 = _vtable (&fn()).
        let void_ty = self.ctx.void_ty;
        let void_ptr_ty = self.ctx.make_ptr_ty(void_ty, true);
        let opaque_fn_ty = self.ctx.make_fn_ptr_ty(&[], void_ty);
        let opaque_fn_ptr_ty = self.ctx.make_ptr_ty(opaque_fn_ty, true);

        let data_ptr = self.mk_field(dyn_val, 0u32, void_ptr_ty);
        let vtable_ptr = self.mk_field(dyn_val, 1u32, opaque_fn_ptr_ty);

        // Index into vtable: `vtable_ptr[method_idx]` — the fn pointer slot.
        let idx_lit = self.mk_int_lit(self.ctx.usize_ty, method_idx as u64);
        let fn_at_idx = self.mk_index(vtable_ptr, idx_lit, opaque_fn_ty);

        // Build the typed fn pointer signature for the call. proto_method
        // has self: &Self + extra params. Substitute Self → &void at the
        // type level by using void_ptr_ty for the first param.
        let n_call_args = expr.args().len();
        let n_params: usize = 1usize + n_call_args;
        let typed_param_tys = self.ctx.arena.alloc_slice::<&IrTy>(n_params);
        typed_param_tys[0] = void_ptr_ty;
        // Resolve the proto method's tail params using the current type_map.
        // proto_method.params[0] is `self: &Self` — skip; resolve the rest.
        for ai in 0usize..n_call_args {
            let param_idx = 1usize + ai;
            if param_idx < proto_method.params.len() {
                typed_param_tys[param_idx] = self.resolve_type(proto_method.params[param_idx].ty);
            } else {
                typed_param_tys[param_idx] = void_ty;
            }
        }
        let ret_ty = self.resolve_type(proto_method.return_type);
        let typed_fn_ty = self.ctx.make_fn_ptr_ty(typed_param_tys, ret_ty);

        // Cast the opaque fn ptr to the typed signature.
        let typed_fn = self.mk_cast(fn_at_idx, typed_fn_ty);

        // Build call args: [data_ptr, lowered_args...].
        let call_args = self.ctx.arena.alloc_slice::<&IrExpr>(n_params);
        call_args[0] = data_ptr;
        for ai in 0usize..n_call_args {
            let arg = self.lower_expr(expr.args()[ai]);
            let dst_idx: usize = 1usize + ai;
            if dst_idx < typed_param_tys.len() {
                call_args[dst_idx] = self.coerce_to_type(arg, typed_param_tys[dst_idx]);
            } else {
                call_args[dst_idx] = arg;
            }
        }

        // Build IrTag::Call with an indirect call target (callee = typed_fn).
        let call_e = IrExpr::void_expr(ret_ty);
        call_e.tag = IrTag::Call;
        call_e._data.call.call_target = IrCallTarget {
            tag: CallKind::Indirect,
            fn_ref: IrFnRef::empty(),
            callee: typed_fn,
        };
        call_e._data.call.items = call_args;
        Option::some(self.ctx.arena.alloc(call_e) as &IrExpr)
    }

    /// Build a vtable for `impl_ty` against the protocols in `protos_tuple`,
    /// emit it as a private const global, and return an IrExpr that evaluates
    /// to `&VTABLE[0]` (the start of the array) cast to `&fn()`. Caches by
    /// (protos_tuple ptr, impl_ty ptr) so repeated coercions reuse the same
    /// vtable global.
    ///
    /// The vtable is laid out as `[fn(); total_methods]` where the methods
    /// from each protocol appear in the order they're declared in the
    /// protocol, concatenated in the order of the protos tuple. Each entry
    /// is the impl's typed function pointer, bitcast to opaque `fn()`.
    ///
    /// Returns null (as &IrExpr) if the protos tuple has no recognisable
    /// protocol entries (caller should fall back to null vtable).
    fn build_dyn_vtable_ref(self: &mut Mono, impl_ty: &IrTy, protos_tuple: &IrTy) -> &IrExpr {
        if protos_tuple.tag != IrTyTag::Tuple {
            return 0usize as &IrExpr;
        }
        // Cache key: pointer-identity of protos_tuple + impl_ty.
        let cache_key: u64 = (protos_tuple as &void as usize as u64)
            ^ ((impl_ty as &void as usize as u64) * 0x9e3779b97f4a7c15u64);
        let cached = self.ctx.dyn_vtable_cache.get(&cache_key);
        if cached.is_some() {
            return cached.unwrap();
        }

        // Resolve impl scope so we can look up method implementations.
        // For Slice impl_ty, dispatch lands on the `#[lang(slice)]` struct's
        // methods with the slice's element-pointer type as the Ptr generic.
        let impl_scope_idx: u32 = 0u32;
        let slice_ptr_ty: &IrTy = self.ctx.void_ty;
        let slice_lang_struct_id: usize = 0usize;
        if impl_ty.tag == IrTyTag::Struct {
            impl_scope_idx = impl_ty.struct_ref().scope_idx;
        } else if impl_ty.tag == IrTyTag::Enum {
            impl_scope_idx = impl_ty.enum_ref().scope_idx;
        } else if impl_ty.tag == IrTyTag::Slice {
            let lang_id = self.ctx.get_lang_item("slice");
            if lang_id.is_some() {
                let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                if sd.is_some() {
                    impl_scope_idx = sd.unwrap().scope_idx;
                    slice_lang_struct_id = lang_id.unwrap();
                    let elem_ty = self.slice_elem_ty(impl_ty);
                    slice_ptr_ty = self.ctx.make_ptr_ty(elem_ty, impl_ty.is_const());
                }
            }
        } else if impl_ty.tag == IrTyTag::Builtin {
            let lang_name = Mono::builtin_lang_name(impl_ty.builtin());
            if lang_name.len() > 0 {
                let lid = self.ctx.get_lang_item(lang_name);
                if lid.is_some() {
                    let sd = self.ctx.struct_defs.get(&lid.unwrap());
                    if sd.is_some() {
                        impl_scope_idx = sd.unwrap().scope_idx;
                    }
                }
            }
        }
        if impl_scope_idx == 0u32 {
            return 0usize as &IrExpr;
        }

        // Opaque `fn()` element type for the vtable array.
        let opaque_fn_ty = self.ctx.make_fn_ptr_ty(&[], self.ctx.void_ty);

        // Collect a fn pointer for each method in each protocol of the tuple.
        let entries: Vector<&IrExpr> = Vector::new();
        defer entries.free();

        for pi in 0usize..protos_tuple.elems().len() {
            let proto_ty = protos_tuple.elems()[pi];
            if proto_ty.tag != IrTyTag::Protocol {
                continue;
            }
            let proto_id = proto_ty.proto_id();
            let proto_def_opt = self.ctx.protocol_defs.get(&proto_id);
            if proto_def_opt.is_none() {
                continue;
            }
            let proto = proto_def_opt.unwrap();

            for mi in 0usize..proto.methods.len() {
                let proto_method = &proto.methods[mi];
                // Find the impl's method by name.
                let item_opt = self.ctx.scopes.get(impl_scope_idx).items.get(&proto_method.name);
                if item_opt.is_none() {
                    // Method missing — push a null pointer so the slot exists.
                    let null_e = IrExpr::void_expr(opaque_fn_ty);
                    null_e.tag = IrTag::NullLit;
                    entries.push(self.ctx.arena.alloc(null_e) as &IrExpr);
                    continue;
                }
                let item = item_opt.unwrap();
                let fn_id_val = if item.kind.tag == scope::NamedItemTag::Method {
                    item.kind.id2()._value
                } else if item.kind.tag == scope::NamedItemTag::Function {
                    item.kind.id()._value
                } else {
                    0usize
                };
                if fn_id_val == 0usize {
                    let null_e = IrExpr::void_expr(opaque_fn_ty);
                    null_e.tag = IrTag::NullLit;
                    entries.push(self.ctx.arena.alloc(null_e) as &IrExpr);
                    continue;
                }
                let fn_def_opt = self.ctx.fn_defs.get(&fn_id_val);
                if fn_def_opt.is_none() {
                    let null_e = IrExpr::void_expr(opaque_fn_ty);
                    null_e.tag = IrTag::NullLit;
                    entries.push(self.ctx.arena.alloc(null_e) as &IrExpr);
                    continue;
                }
                let fn_def = fn_def_opt.unwrap();

                // Bind the impl method's generic context. There are two cases
                // and they're now distinguished structurally — by whether the
                // method came from a protocol mixin — rather than by length-
                // matching arithmetic on `impl_args.len() + proto_non_self_count`
                // (which was four branches and never closed cleanly; see the
                // 2026-05-11 retrospective in PORTING.md).
                //
                //   - impl method: `fn_def.generic_params` is `[impl's, own]`.
                //     Pass `[impl_args..., proto_non_self_args...]` so the
                //     method's own slots line up with proto's non-Self.
                //   - protocol method (mixin'd into this impl): now uniform
                //     with impl methods — `fn_def.generic_params` is just the
                //     method's own. The protocol's generics (Self + others)
                //     are bound via `bind_proto_generics` from the dyn
                //     protocol's args, with `impl_ty` overriding Self.
                let proto_args = proto_ty.proto_type_args();
                let impl_args: &[&IrTy] = if impl_ty.tag == IrTyTag::Struct {
                    impl_ty.struct_ref().type_args
                } else if impl_ty.tag == IrTyTag::Slice {
                    let buf = self.ctx.arena.alloc_slice::<&IrTy>(1);
                    buf[0] = slice_ptr_ty;
                    buf
                } else {
                    &[]
                };

                // Bind impl-struct generics in type_map (e.g. `impl Foo<T>`'s
                // T → impl_ty.struct_ref().type_args[0]) so the method body
                // resolves them when it references types like `&Foo<T>` or
                // calls associated fns whose param types use T.
                if impl_ty.tag == IrTyTag::Struct {
                    let impl_struct_def_opt = self.ctx.struct_defs.get(&impl_ty.struct_ref().id._value);
                    if impl_struct_def_opt.is_some() {
                        let impl_struct_def = impl_struct_def_opt.unwrap();
                        let n = std::cmp::min(impl_struct_def.generic_params.len(), impl_ty.struct_ref().type_args.len());
                        for gi in 0usize..n {
                            self.type_map.insert(impl_struct_def.generic_params[gi].id._value, impl_ty.struct_ref().type_args[gi]);
                        }
                    }
                } else if impl_ty.tag == IrTyTag::Slice && slice_lang_struct_id != 0usize {
                    let slice_struct_def_opt = self.ctx.struct_defs.get(&slice_lang_struct_id);
                    if slice_struct_def_opt.is_some() {
                        let slice_struct_def = slice_struct_def_opt.unwrap();
                        if slice_struct_def.generic_params.len() >= 1 {
                            self.type_map.insert(slice_struct_def.generic_params[0].id._value, slice_ptr_ty);
                        }
                    }
                }

                let method_type_args: &[&IrTy] = &[];
                let is_proto_method = self.ctx.proto_method_proto_gp_ids.get(&fn_def.id._value).is_some();
                if is_proto_method {
                    // Build proto-generic args = [impl_ty, proto_args[1..]] so
                    // Self → impl_ty and the protocol's other generics map
                    // through positionally. Pass any leftover slots (= the
                    // method's own) as method_type_args.
                    let proto_arg_buf = self.ctx.arena.alloc_slice::<&IrTy>(std::cmp::max(proto_args.len(), 1usize));
                    proto_arg_buf[0] = impl_ty;
                    for i in 1usize..proto_args.len() {
                        let a = proto_args[i];
                        proto_arg_buf[i] = if a as &void as usize == 0usize { self.ctx.void_ty } else { a };
                    }
                    let _ = self.bind_proto_generics(fn_def, proto_arg_buf);
                    // Methods with their own generics are not currently
                    // dispatchable via a vtable entry without inference (the
                    // entry would have to be specialised per call site, not
                    // per impl). Leave method_type_args empty for now; the
                    // method body still mono's correctly when its own
                    // generics aren't actually used (typical for protocol
                    // methods like `fmt`, `equals`, `hash`, etc.).
                } else {
                    // Plain impl method — its `generic_params` already
                    // includes impl's placeholders, so pass [impl_args...,
                    // proto_non_self_args...] padded to its length.
                    let proto_non_self_count = if proto_args.len() >= 1 { proto_args.len() - 1 } else { 0 };
                    let combined_total = impl_args.len() + proto_non_self_count;
                    if fn_def.generic_params.len() == combined_total && combined_total > 0 {
                        let buf = self.ctx.arena.alloc_slice::<&IrTy>(combined_total);
                        for i in 0usize..impl_args.len() {
                            let a = impl_args[i];
                            buf[i] = if a as &void as usize == 0usize { self.ctx.void_ty } else { a };
                        }
                        for i in 0usize..proto_non_self_count {
                            let a = proto_args[i + 1];
                            buf[impl_args.len() + i] = if a as &void as usize == 0usize { self.ctx.void_ty } else { a };
                        }
                        method_type_args = buf;
                    } else if proto_non_self_count == fn_def.generic_params.len() && fn_def.generic_params.len() > 0 {
                        let nargs = proto_non_self_count;
                        let buf = self.ctx.arena.alloc_slice::<&IrTy>(nargs);
                        for i in 0usize..nargs {
                            let a = proto_args[i + 1];
                            buf[i] = if a as &void as usize == 0usize { self.ctx.void_ty } else { a };
                        }
                        method_type_args = buf;
                    } else if impl_args.len() == fn_def.generic_params.len() && fn_def.generic_params.len() > 0 {
                        let buf = self.ctx.arena.alloc_slice::<&IrTy>(impl_args.len());
                        for i in 0usize..impl_args.len() {
                            let a = impl_args[i];
                            buf[i] = if a as &void as usize == 0usize { self.ctx.void_ty } else { a };
                        }
                        method_type_args = buf;
                    }
                }

                // Self may be referenced indirectly by the impl's method body
                // (e.g. `Self::foo(...)`). The proto-method case binds it via
                // `bind_proto_generics`; for plain impl methods, also wire it
                // up so legacy default-body code keeps resolving.
                let self_id_opt = self.ctx.proto_method_self_id.get(&fn_def.id._value);
                if self_id_opt.is_some() {
                    self.type_map.insert(self_id_opt.unwrap(), impl_ty);
                }

                let fn_idx = self.mono_function(fn_def, method_type_args);
                let ir_fn = &self.ctx.ir_functions[fn_idx];
                let fn_ref = IrFnRef { id: ir_fn.id, mangled_name: ir_fn.mangled_name };

                // Build a typed FnRef expr, then cast to opaque fn().
                // Compute the typed FnPointer type from ir_fn's params + return.
                let typed_param_tys = self.ctx.arena.alloc_slice::<&IrTy>(ir_fn.params.len());
                for pp in 0usize..ir_fn.params.len() {
                    typed_param_tys[pp] = ir_fn.params[pp].ty;
                }
                let typed_fn_ty = self.ctx.make_fn_ptr_ty(typed_param_tys, ir_fn.return_type);

                let fn_ref_e = IrExpr::void_expr(typed_fn_ty);
                fn_ref_e.tag = IrTag::FnRef;
                fn_ref_e._data.fn_ref = fn_ref;
                let fn_ref_expr = self.ctx.arena.alloc(fn_ref_e) as &IrExpr;

                // Cast to opaque fn() and push.
                entries.push(self.mk_cast(fn_ref_expr, opaque_fn_ty));
            }
        }

        if entries.len() == 0usize {
            return 0usize as &IrExpr;
        }

        // Build the array literal initializer.
        let arr_items = self.ctx.arena.alloc_slice_copy::<&IrExpr>(entries.as_slice());
        let arr_ty = self.ctx.arena.alloc(IrTy::mk_array(opaque_fn_ty, arr_items.len())) as &IrTy;
        let arr_lit = IrExpr::void_expr(arr_ty);
        arr_lit.tag = IrTag::ArrayLit;
        arr_lit._data.block.items = arr_items;
        let arr_lit_expr = self.ctx.arena.alloc(arr_lit) as &IrExpr;

        // Mangle a unique name for this vtable.
        let base_name: &[u8] = "_dyn_vtable";
        let mangled = self.ctx.mangle_name(base_name);
        let global_id = self.ctx.id_gen.next_id();

        self.ctx.ir_globals.push(IrGlobal {
            id: global_id,
            name: base_name,
            mangled_name: mangled,
            ty: arr_ty,
            init: Option::some(arr_lit_expr),
            is_const: true,
            is_extern: false,
            attributes: &[],
        });

        // Build IrTag::GlobalRef referring to the just-emitted global, then
        // take its address. The address of the array (which is also the
        // address of element 0) is what dyn._vtable should hold; cast to
        // &fn() so callers can do pointer arithmetic.
        let global_ref_expr = IrExpr::void_expr(arr_ty);
        global_ref_expr.tag = IrTag::GlobalRef;
        global_ref_expr._data.global_ref = IrGlobalRef { id: global_id, mangled_name: mangled };
        let global_ref = self.ctx.arena.alloc(global_ref_expr) as &IrExpr;

        let arr_addr = self.mk_ref(global_ref, true);
        let opaque_fn_ptr_ty = self.ctx.make_ptr_ty(opaque_fn_ty, true);
        let result = self.mk_cast(arr_addr, opaque_fn_ptr_ty);

        self.ctx.dyn_vtable_cache.insert(cache_key, result);
        result
    }

    /// Check if the init type is clearly incompatible with the declared type.
    /// This catches specific mismatches like Pointer(Slice) vs Slice (from &a[..]).
    /// Returns true if there is a clear type tag mismatch.
    /// Try to coerce `val` to `expected_ty`. Returns the coerced expression on success.
    /// Returns null (as &IrExpr) if the types are incompatible.
    fn try_coerce(self: &mut Mono, val: &IrExpr, expected_ty: &IrTy) -> &IrExpr {
        // Exact match
        if val.ty as &void == expected_ty as &void { return val; }

        // Bottom type matches anything
        if val.ty.tag == IrTyTag::Never { return val; }

        // Void on either side = unknown/error, don't report further
        if val.ty.is_void() || expected_ty.is_void() { return val; }

        // Same tag, assume compatible (struct identity etc. checked elsewhere)
        if val.ty.tag == expected_ty.tag && val.ty.tag != IrTyTag::Pointer && val.ty.tag != IrTyTag::Slice {
            return val;
        }

        // Coerce &[T; N] to &[T] (pointer to array → slice fat pointer)
        if expected_ty.tag == IrTyTag::Slice && val.ty.tag == IrTyTag::Pointer && val.ty.inner().tag == IrTyTag::Array {
            let array_ty = val.ty.inner();
            let elem_ty = array_ty.inner();
            let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
            let data_ptr_ty = self.ctx.make_ptr_ty(elem_ty, false);
            let data_ptr_ref = self.mk_cast(val, data_ptr_ty);
            let len_ref = self.mk_int_lit(usize_ty, array_ty.array_size() as u64);
            let items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
            items[0] = data_ptr_ref;
            items[1] = len_ref;
            let tuple_result = IrExpr::void_expr(expected_ty);
            tuple_result.tag = IrTag::TupleLit;
            tuple_result._data.block.items = items;
            return self.ctx.arena.alloc(tuple_result);
        }

        // Coerce &mut T -> &T (mutable pointer to const pointer)
        if expected_ty.tag == IrTyTag::Pointer && val.ty.tag == IrTyTag::Pointer
            && expected_ty.is_const() && !val.ty.is_const()
            && expected_ty.inner() == val.ty.inner() {
            return self.mk_cast(val, expected_ty);
        }

        // Coerce &mut [T] -> &[T] (mutable slice to const slice)
        if expected_ty.tag == IrTyTag::Slice && val.ty.tag == IrTyTag::Slice {
            let target_elem = self.slice_elem_ty(expected_ty);
            let val_elem = self.slice_elem_ty(val.ty);
            if target_elem == val_elem && expected_ty != val.ty {
                return self.mk_cast(val, expected_ty);
            }
        }

        // Same-tag pointers/slices that didn't match above
        if val.ty.tag == expected_ty.tag {
            return val;
        }

        // Coerce Fn (function item ZST) to fn pointer
        if expected_ty.tag == IrTyTag::FnPointer && val.ty.tag == IrTyTag::Fn {
            let fn_ref = val.ty.fn_item_ref();
            let result = IrExpr::void_expr(expected_ty);
            result.tag = IrTag::FnRef;
            result._data.fn_ref = fn_ref;
            return self.ctx.arena.alloc(result);
        }

        // Coerce &T (or any pointer) to a dyn struct (`&dyn Proto` resolved
        // to the lang(dyn) struct). Builds a real vtable for T's
        // implementation of Proto's methods and threads its address into
        // the dyn fat pointer's `_vtable` slot. If vtable construction fails
        // (e.g. unknown protocol), falls back to a null vtable so the
        // coercion still type-checks (matching prior behaviour).
        if expected_ty.tag == IrTyTag::Struct && val.ty.tag == IrTyTag::Pointer {
            let dyn_lang_id = self.ctx.get_lang_item("dyn");
            if dyn_lang_id.is_some() && expected_ty.struct_ref().id._value == dyn_lang_id.unwrap() {
                // Build dyn fat pointer: { _ptr: val (cast to &void), _vtable: &VTABLE[0] }
                let void_ty = self.ctx.void_ty;
                let void_ptr_ty = self.ctx.make_ptr_ty(void_ty, val.ty.is_const());
                let data_cast = self.mk_cast(val, void_ptr_ty);
                // _vtable field type: per sysroot, `&fn()` (a fn pointer to
                // a no-arg function). The make_ptr_ty here pairs with the
                // const opaque-fn-pointer type built by build_dyn_vtable_ref.
                let opaque_fn_ty = self.ctx.make_fn_ptr_ty(&[], self.ctx.void_ty);
                let opaque_fn_ptr_ty = self.ctx.make_ptr_ty(opaque_fn_ty, true);

                let impl_ty = val.ty.inner();
                let protos_tuple = if expected_ty.struct_ref().type_args.len() > 0 {
                    expected_ty.struct_ref().type_args[0]
                } else {
                    self.ctx.void_ty
                };

                let vtable_expr = self.build_dyn_vtable_ref(impl_ty, protos_tuple);
                let vtable_cast: &IrExpr = if vtable_expr as &void as usize != 0usize {
                    self.mk_cast(vtable_expr, opaque_fn_ptr_ty)
                } else {
                    let null_vtable = IrExpr::void_expr(opaque_fn_ptr_ty);
                    null_vtable.tag = IrTag::NullLit;
                    self.ctx.arena.alloc(null_vtable) as &IrExpr
                };

                let items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                items[0] = data_cast;
                items[1] = vtable_cast;
                let result = IrExpr::void_expr(expected_ty);
                result.tag = IrTag::StructLit;
                result._data.struct_lit.ir_ty = expected_ty;
                result._data.struct_lit.items = items;
                return self.ctx.arena.alloc(result);
            }
        }

        // Incompatible
        0usize as &IrExpr
    }

    /// Coerce `val` to `expected_ty`, emitting a diagnostic on type mismatch.
    /// On failure, returns an expression with the expected type (to allow continued compilation).
    fn check_and_coerce(self: &mut Mono, val: &IrExpr, expected_ty: &IrTy, span: Span) -> &IrExpr {
        let result = self.try_coerce(val, expected_ty);
        if result as &void as usize != 0 {
            return result;
        }

        // Auto-take-ref before erroring: callee expects `&T` / `&mut T`,
        // caller passed a value of T. Sysroot relies on this (e.g.
        // `slice.copy_to_nonoverlapping(deque._data[0])` — same shape that
        // alumina-boot accepts implicitly). Lives in check_and_coerce
        // (call-site arg coercion) rather than the generic try_coerce
        // path so it doesn't fire in arbitrary IR-equality contexts where
        // taking address of a value would change semantics. Only fires
        // when val is an lvalue we can address.
        if expected_ty.tag == IrTyTag::Pointer && val.ty.tag != IrTyTag::Pointer
            && expected_ty.inner() == val.ty {
            if val.tag == IrTag::Local || val.tag == IrTag::Param
                || val.tag == IrTag::FieldAccess || val.tag == IrTag::Index
                || val.tag == IrTag::Deref {
                return self.mk_ref(val, expected_ty.is_const());
            }
        }

        let expected_name = self.ir_type_name(expected_ty);
        let got_name = self.ir_type_name(val.ty);
        self.emit_diag(diagnostics::CodeDiagnostic::type_mismatch(
            span, expected_name, got_name));
        // Return a dummy expression with expected type so compilation can continue
        let dummy = IrExpr::void_expr(expected_ty);
        self.ctx.arena.alloc(dummy)
    }

    /// Coerce without error reporting (for contexts where mismatch is not an error).
    fn coerce_to_type(self: &mut Mono, val: &IrExpr, target_ty: &IrTy) -> &IrExpr {
        let result = self.try_coerce(val, target_ty);
        if result as &void as usize != 0 {
            return result;
        }
        val
    }

    // Check if a type is a range (std::range::Range*, etc.)
    fn is_range_ty(self: &Mono, ty: &IrTy) -> bool {
        if ty.tag != IrTyTag::Struct { return false; }
        let id = ty.struct_ref().id._value;
        self.ctx.is_lang_item(id, "range")
            || self.ctx.is_lang_item(id, "range_inclusive")
            || self.ctx.is_lang_item(id, "range_full")
            || self.ctx.is_lang_item(id, "range_from")
            || self.ctx.is_lang_item(id, "range_to")
            || self.ctx.is_lang_item(id, "range_to_inclusive")
            || {
                // Fallback to name-based check for range types not yet lang-item'd
                let name = ty.struct_ref().name;
                name == "RangeFrom" || name == "RangeTo" || name == "RangeToInclusive" || name == "RangeFull"
            }
    }

    // Get the element type of a slice
    fn slice_elem_ty(self: &Mono, ty: &IrTy) -> &IrTy {
        ty.inner()
    }

    // Bound-derived inference for `RangeOf<T>`. A signature like
    // `fn next<T: Integer, R: RangeOf<T>>(rng, range: R) -> T` can't infer
    // T from any parameter (only `R` is a param, carrying the whole range);
    // T is the range's *element* type. After arg unification has bound R to
    // a concrete range struct (e.g. Range<i32>), derive T = R's element
    // type-arg. Independent of expected_type, so it works in any call
    // context (`let i: T = ...`, `assert!(next(x..) >= 10)`, etc.).
    // Returns true if it bound at least one previously-unbound generic.
    fn infer_from_range_of_bounds(
        self: &mut Mono,
        def: &FnDef,
        inferred: &mut [&IrTy],
        found: &mut [bool]
    ) -> bool {
        let n = def.generic_params.len();
        let any = false;
        for h in 0usize..n {
            if !found[h] { continue; }
            let range_ty = inferred[h];
            if !self.is_range_ty(range_ty) { continue; }
            let ta = range_ty.struct_ref().type_args;
            if ta.len() < 1 { continue; }
            for b in 0usize..def.generic_params[h].bounds.len() {
                let bound_ty = def.generic_params[h].bounds[b];
                if bound_ty.tag != TyTag::Generic { continue; }
                if bound_ty.elems().len() < 1 { continue; }
                let elem_arg = bound_ty.elems()[0];
                if elem_arg.tag != TyTag::Placeholder { continue; }
                let bound_ir = self.resolve_type(bound_ty);
                if bound_ir.tag != IrTyTag::Protocol { continue; }
                if !self.ctx.is_lang_item(bound_ir.proto_id(), "proto_range_of") { continue; }
                let elem_gp_id = elem_arg.id()._value;
                for g in 0usize..n {
                    // A `RangeOf<g>` bound on a concrete range struct
                    // unambiguously determines g = the range's element
                    // type. Treat a prior void binding as "not found":
                    // unify_type_for_inference can wrongly bind g to void
                    // when g also appears nested in another type-arg whose
                    // own bound references g (e.g. `&Uniform<T, Rg>` with
                    // `struct Uniform<T, Rg: RangeOf<T>>` unified against a
                    // concrete `Uniform<i32, Range<i32>>` binds T=void,
                    // found=true). RangeOf-derivation is authoritative here.
                    if found[g] && !inferred[g].is_void() { continue; }
                    if def.generic_params[g].id._value == elem_gp_id {
                        inferred[g] = ta[0];
                        found[g] = true;
                        any = true;
                    }
                }
            }
        }
        any
    }

    /// Coerce a value to an indexable type (slice or array).
    /// If already a slice or array, returns as-is.
    /// Otherwise, tries to call as_slice() on the type.
    fn coerce_to_indexable(self: &mut Mono, val: &IrExpr) -> &IrExpr {
        if val.ty.tag == IrTyTag::Slice || val.ty.tag == IrTyTag::Array {
            return val;
        }
        // Try to find as_slice() method on this type
        let as_slice_def = self.find_method_in_scope(val.ty, "as_slice");
        if as_slice_def.is_some() {
            let def = as_slice_def.unwrap();
            let type_args: &[&IrTy] = if val.ty.tag == IrTyTag::Struct && val.ty.struct_ref().type_args.len() > 0 && def.generic_params.len() == val.ty.struct_ref().type_args.len() {
                val.ty.struct_ref().type_args
            } else {
                let ta = self.ctx.arena.alloc_slice::<&IrTy>(1);
                ta[0] = val.ty;
                ta as &[&IrTy]
            };
            let fn_idx = self.mono_function(def, type_args);
            let ir_fn = &self.ctx.ir_functions[fn_idx];
            let args = self.ctx.arena.alloc_slice::<&IrExpr>(1);
            args[0] = self.mk_ref(val, true);
            let fn_ref = IrFnRef { id: ir_fn.id, mangled_name: ir_fn.mangled_name };
            return self.mk_call(fn_ref, args, ir_fn.return_type);
        }
        val
    }

    // Lower sub-slice indexing: data[a..b], data[n..], data[..m]
    // Lower ptr[a..b] on a raw pointer - creates a new slice {ptr+a, b-a}
    /// Get the length of an indexee (slice or array) as an IR expression.
    fn get_indexee_len(self: &mut Mono, base: &IrExpr) -> &IrExpr {
        let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
        if base.ty.tag == IrTyTag::Slice {
            self.mk_field(base, SLICE_LEN_FIELD, usize_ty)
        } else if base.ty.tag == IrTyTag::Array {
            self.mk_int_lit(usize_ty, base.ty.array_size() as u64)
        } else {
            self.mk_int_lit(usize_ty, 0u64)
        }
    }

    /// Subslice: base[start..end] → new slice {ptr+start, end-start}
    /// Works for both slice and array bases. start/end are already-lowered IR usize expressions.
    fn lower_subslice_ir(self: &mut Mono, base: &IrExpr, ir_start: &IrExpr, ir_end: &IrExpr) -> &IrExpr {
        let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);

        if base.ty.tag == IrTyTag::Array {
            let elem_ty = base.ty.inner();
            let elem_ptr_ty = self.ctx.make_ptr_ty(elem_ty, false);
            let slice_ty = self.ctx.make_slice_ty(elem_ty, false);

            let arr_ref = self.mk_ref(base, false);
            let elem_ptr = self.mk_cast(arr_ref, elem_ptr_ty);

            let ir_new_ptr_idx = self.mk_index(elem_ptr, ir_start, elem_ty);
            let ir_new_ptr = self.mk_ref(ir_new_ptr_idx, false);
            let ir_new_len = self.mk_binary(BinOp::Sub, ir_end, ir_start, usize_ty);

            let items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
            items[0] = ir_new_ptr;
            items[1] = ir_new_len;
            let result = IrExpr::void_expr(slice_ty);
            result.tag = IrTag::TupleLit;
            result._data.block.items = items;
            return self.ctx.arena.alloc(result);
        }

        if base.ty.tag != IrTyTag::Slice {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }

        let elem_ty = self.slice_elem_ty(base.ty);
        let data_ptr_ty = self.ctx.make_ptr_ty(elem_ty, false);
        let ir_data_ptr = self.mk_field(base, SLICE_DATA_FIELD, data_ptr_ty);

        let ir_new_ptr_idx = self.mk_index(ir_data_ptr, ir_start, data_ptr_ty.inner());
        let ir_new_ptr = self.mk_ref(ir_new_ptr_idx, data_ptr_ty.is_const());
        let ir_new_len = self.mk_binary(BinOp::Sub, ir_end, ir_start, usize_ty);

        let elems = self.ctx.arena.alloc_slice::<&IrExpr>(2);
        elems[0] = ir_new_ptr;
        elems[1] = ir_new_len;
        let result = IrExpr::void_expr(base.ty);
        result.tag = IrTag::TupleLit;
        result._data.block.items = elems;
        self.ctx.arena.alloc(result)
    }

    // Get the struct type from an IrTy, auto-dereffing through pointers
    fn get_struct_ty(self: &Mono, ty: &IrTy) -> Option<&IrTy> {
        if ty.tag == IrTyTag::Struct {
            Option::some(ty)
        } else if ty.tag == IrTyTag::Pointer {
            self.get_struct_ty(ty.inner())
        } else {
            Option::none()
        }
    }

    // Recursively unify a parameter type pattern against a concrete IR type to extract
    // placeholder bindings for generic inference.
    // Walk an AST `Ty` in parallel with an IR `IrTy`, binding any
    // Placeholder encountered in the AST to the matching IR sub-type.
    // Writes go directly into `self.type_map`.
    //
    // Used by mixin-dispatch paths to bind the placeholders the mixin's
    // protocol type-arg AST uses against the concrete receiver type — the
    // impl block's generic-param ids stored at PendingMixin time aren't
    // always the same ids the mixin AST uses for placeholders, so writing
    // via those ids alone misses the AST's placeholders. Walking the AST
    // directly is robust to that mismatch.
    fn bind_placeholders_from_ast_vs_ir(self: &mut Mono, ast_ty: &Ty, ir_ty: &IrTy) {
        if ast_ty as &void as usize == 0usize { return; }
        if ir_ty as &void as usize == 0usize { return; }
        if ast_ty.tag == TyTag::Placeholder {
            self.type_map.insert(ast_ty.id()._value, ir_ty);
            return;
        }
        if ast_ty.tag == TyTag::Pointer && ir_ty.tag == IrTyTag::Pointer {
            self.bind_placeholders_from_ast_vs_ir(ast_ty.inner(), ir_ty.inner());
            return;
        }
        if ast_ty.tag == TyTag::Slice && ir_ty.tag == IrTyTag::Slice {
            self.bind_placeholders_from_ast_vs_ir(ast_ty.inner(), ir_ty.inner());
            return;
        }
        if ast_ty.tag == TyTag::Array && ir_ty.tag == IrTyTag::Array {
            self.bind_placeholders_from_ast_vs_ir(ast_ty.inner(), ir_ty.inner());
            return;
        }
        if ast_ty.tag == TyTag::Tuple && ir_ty.tag == IrTyTag::Tuple {
            let n = std::cmp::min(ast_ty.elems().len(), ir_ty.elems().len());
            for i in 0usize..n {
                self.bind_placeholders_from_ast_vs_ir(ast_ty.elems()[i], ir_ty.elems()[i]);
            }
            return;
        }
        if ast_ty.tag == TyTag::Generic && ir_ty.tag == IrTyTag::Struct {
            let s_args = ir_ty.struct_ref().type_args;
            let n = std::cmp::min(ast_ty.elems().len(), s_args.len());
            for i in 0usize..n {
                self.bind_placeholders_from_ast_vs_ir(ast_ty.elems()[i], s_args[i]);
            }
            return;
        }
        if ast_ty.tag == TyTag::Generic && ir_ty.tag == IrTyTag::Slice && ast_ty.elems().len() == 1 {
            // AST `slice<Ptr>` (Generic over lang(slice) struct) vs IR Slice.
            // Reconstruct Ptr = &elem and unify against the single AST arg.
            let ptr_ty = self.ctx.make_ptr_ty(ir_ty.inner(), ir_ty.is_const());
            self.bind_placeholders_from_ast_vs_ir(ast_ty.elems()[0], ptr_ty);
            return;
        }
        // Other AST/IR shape mismatches: nothing to bind here — either the
        // AST has no placeholders to bind, or the unification context isn't
        // structural (e.g. a typeop / dyn target). Leave for resolve_type's
        // own fallbacks.
    }

    fn unify_type_for_inference(
        self: &mut Mono,
        param_ty: &Ty,
        arg_ty: &IrTy,
        inferred: &mut [&IrTy],
        found: &mut [bool],
        generic_params: &[GenericParam],
    ) {
        if param_ty.tag == TyTag::Placeholder {
            for g in 0usize..generic_params.len() {
                if generic_params[g].id._value == param_ty.id()._value && !found[g] {
                    inferred[g] = arg_ty;
                    found[g] = true;
                    break;
                }
            }
        } else if param_ty.tag == TyTag::Pointer {
            if arg_ty.tag == IrTyTag::Pointer {
                self.unify_type_for_inference(param_ty.inner(), arg_ty.inner(), inferred, found, generic_params);
            } else {
                // UFCS auto-take-ref: when the callee expects &T but the
                // user passed a value of T (e.g. `value.method()` where the
                // free function's first param is &T), match the inner T
                // against the value's type. The actual ref-take happens in
                // try_ufcs_call. Without this, T stays as void and the
                // dispatch picks the wrong instantiation.
                self.unify_type_for_inference(param_ty.inner(), arg_ty, inferred, found, generic_params);
            }
        } else if param_ty.tag == TyTag::Slice {
            if arg_ty.tag == IrTyTag::Tuple && arg_ty.elems().len() == 2 && arg_ty.elems()[0].tag == IrTyTag::Pointer {
                self.unify_type_for_inference(param_ty.inner(), arg_ty.elems()[0].inner(), inferred, found, generic_params);
            } else if arg_ty.tag == IrTyTag::Slice {
                self.unify_type_for_inference(param_ty.inner(), arg_ty.inner(), inferred, found, generic_params);
            } else if arg_ty.tag == IrTyTag::Pointer && arg_ty.inner().tag == IrTyTag::Array {
                // `&[T]` parameter (AST `TyTag::Slice`) vs `&[T; N]` argument
                // (IR `Pointer<Array<T, N>>`). Array-to-slice coerces at the
                // call site, but the type-arg inference still needs to look
                // through to bind T. Without this, calls like
                // `f::<T>(&[1, 2, 3])` leave T unbound and mono with T=void.
                self.unify_type_for_inference(param_ty.inner(), arg_ty.inner().inner(), inferred, found, generic_params);
            }
        } else if param_ty.tag == TyTag::Generic && param_ty.elems().len() > 0 {
            if arg_ty.tag == IrTyTag::Struct && arg_ty.struct_ref().type_args.len() >= param_ty.elems().len() {
                for i in 0usize..param_ty.elems().len() {
                    self.unify_type_for_inference(param_ty.elems()[i], arg_ty.struct_ref().type_args[i], inferred, found, generic_params);
                }
            } else if arg_ty.tag == IrTyTag::Slice
                && param_ty.inner().tag == TyTag::Named
                && param_ty.elems().len() == 1 {
                // AST `slice<Ptr>` (Generic over the #[lang(slice)] struct)
                // vs IR `IrTyTag::Slice`. The IR slice doesn't store the Ptr
                // type-arg directly — only the pointee — so reconstruct
                // `Ptr = make_ptr_ty(arg.inner(), arg.is_const())` and unify
                // it with the AST's single Placeholder. Without this, a
                // 2- or 3-generic `slice::method<.., Ptr, ..>` left Ptr
                // unbound, the slice body re-resolved to a struct slice<void>,
                // and `self._ptr` failed to find the pseudo-field.
                let slice_lang = self.ctx.get_lang_item("slice");
                if slice_lang.is_some() && param_ty.inner().id()._value == slice_lang.unwrap() {
                    let ptr_ty = self.ctx.make_ptr_ty(arg_ty.inner(), arg_ty.is_const());
                    self.unify_type_for_inference(param_ty.elems()[0], ptr_ty, inferred, found, generic_params);
                }
            }
        } else if param_ty.tag == TyTag::Tuple && param_ty.elems().len() > 0 {
            if arg_ty.tag == IrTyTag::Tuple && arg_ty.elems().len() >= param_ty.elems().len() {
                for i in 0usize..param_ty.elems().len() {
                    self.unify_type_for_inference(param_ty.elems()[i], arg_ty.elems()[i], inferred, found, generic_params);
                }
            }
        } else if param_ty.tag == TyTag::Dyn {
            // AST: `&dyn Proto<...>`. The IR side is the lang(dyn) struct
            // whose first type-arg is the protos tuple. Walk the AST
            // protocol's type-args alongside the IR Protocol's type_args,
            // solving any AST-side Placeholder against the matching IR
            // type. Direct-Placeholder only — full recursion through
            // unify_type_for_inference here regressed the panic-chain
            // mono with a segfault whose root cause is unclear.
            if arg_ty.tag != IrTyTag::Struct { return; }
            let s_args = arg_ty.struct_ref().type_args;
            if s_args.len() < 1 { return; }
            let protos_tuple_ir = s_args[0];
            if protos_tuple_ir.tag != IrTyTag::Tuple { return; }
            let ir_protos = protos_tuple_ir.elems();
            if ir_protos.len() == 0 { return; }
            let inner_ast = param_ty.inner();
            if inner_ast as &void as usize == 0usize { return; }
            // Only handle the single-proto case for now (multi-proto
            // bounds keep working through explicit turbofish or per-arg
            // inference; structural unification of multi-proto in this
            // path is gated on the segfault investigation).
            if inner_ast.tag != TyTag::Generic { return; }
            let ir_proto = ir_protos[0];
            if ir_proto.tag != IrTyTag::Protocol { return; }
            let ast_pargs = inner_ast.elems();
            let ir_pargs = ir_proto.proto_type_args();
            let pn = std::cmp::min(ast_pargs.len(), ir_pargs.len());
            // Skip position 0 — that's the protocol's Self placeholder,
            // and Self in the dyn return type usually refers to the
            // outer dyn's erased Self, not the function's generic.
            for ai in 1usize..pn {
                let ast_a = ast_pargs[ai];
                let ir_a = ir_pargs[ai];
                if ast_a as &void as usize == 0usize { continue; }
                if ast_a.tag != TyTag::Placeholder { continue; }
                for g in 0usize..generic_params.len() {
                    if generic_params[g].id._value == ast_a.id()._value && !found[g] {
                        inferred[g] = ir_a;
                        found[g] = true;
                        break;
                    }
                }
            }
        }
    }

    // Infer type arguments for a generic function call from the argument types.
    // Recursively unifies parameter types against argument types to extract
    // placeholder bindings, supporting arbitrarily nested generic types.
    fn infer_type_args(self: &mut Mono, def: &FnDef, args: &[&Expr]) -> &[&IrTy] {
        let num_generics = def.generic_params.len();
        let inferred = self.ctx.arena.alloc_slice::<&IrTy>(num_generics);
        let found = self.ctx.arena.alloc_slice::<bool>(num_generics);
        for i in 0usize..num_generics {
            inferred[i] = self.ctx.void_ty;
            found[i] = false;
        }

        // Match each parameter against the corresponding argument.
        // Lower each arg with NO expected_type / return_type hint — the
        // arg's type should come from its own context (its own subterms),
        // not from the OUTER call's expected return type. Otherwise an
        // inner call whose return type is a direct Placeholder (e.g.
        // `util::cast<T1,T2>(t:T1) -> T2`) picks up the OUTER caller's
        // expected_type / return_type as its own return-type hint (see
        // the "direct placeholder in return type" branch at line ~5500),
        // mis-binding T2 to the outer caller's expected return type.
        // Mirrors alumina-boot's tentative arg lowering in
        // `lower_function_call` (`child.lower_expr(e, None)` at
        // src/alumina-boot/src/ir/mono/mod.rs:3035) — boot passes None
        // for both hint and outer return context during inference.
        //
        // The `inside_arg_inference` flag additionally guards the
        // direct-Placeholder return-type-from-hint branch in nested
        // `infer_type_args` calls (e.g. `util::cast`'s own inference run
        // while walking `Option::some`'s args). Without the flag, that
        // branch would still fire on `self.return_type` (the outer's,
        // still set), since clearing only fires at the *call we
        // arrived from*. The flag stays sticky through arbitrary
        // recursion depth.
        let num_params = def.params.len();
        let saved_expected = self.expected_type;
        let saved_return = self.return_type;
        let saved_in_arg_inf = self.inside_arg_inference;
        self.expected_type = self.ctx.void_ty;
        self.return_type = self.ctx.void_ty;
        self.inside_arg_inference = true;
        for p in 0usize..num_params {
            if p >= args.len() { break; }
            let param_ty = def.params[p].ty;
            let arg_expr = args[p];
            let arg_ty = self.lower_expr(arg_expr).ty;
            // When the arg comes back as Void from a Call-like expression,
            // skip unification: aluminac eagerly mono's the inner call
            // with any-unresolved-slot=void during tentative inference,
            // and the resulting void return is "inference failed" — not a
            // real unit value. Binding the outer's generic to that void
            // would lock it in before the call-site's expected-type
            // fallback can fill it from the surrounding context. A unit
            // literal `()` (ExprTag::TupleLit with 0 args), an empty
            // block, or any non-Call expression that legitimately
            // evaluates to () keeps the existing behavior so
            // `assert_eq!((), ())` still binds T=void.
            if arg_ty.tag == IrTyTag::Void
                && (arg_expr.tag == ExprTag::Call
                    || arg_expr.tag == ExprTag::MethodCall
                    || arg_expr.tag == ExprTag::TurbofishValue
                    || arg_expr.tag == ExprTag::Defered) {
                continue;
            }
            self.unify_type_for_inference(param_ty, arg_ty, inferred, found, def.generic_params);
        }
        self.expected_type = saved_expected;
        self.return_type = saved_return;
        self.inside_arg_inference = saved_in_arg_inf;

        // Try to infer remaining generics from Fn bounds.
        // For F: Fn(A) -> R, if the actual argument for F is a lambda or function,
        // extract the return type to infer R.
        for g in 0usize..num_generics {
            if found[g] { continue; }
            // Check all generic params for Fn bounds that reference this one
            for h in 0usize..num_generics {
                if h == g { continue; }
                // Check bounds of param h
                for b in 0usize..def.generic_params[h].bounds.len() {
                    let bound = def.generic_params[h].bounds[b];
                    // Fn bound is TyTag::FnPointer: Fn(params) -> ret_ty
                    if bound.tag == TyTag::FnPointer {
                        // Find which parameter position corresponds to generic h
                        let param_idx: i32 = -1i32;
                        for pp in 0usize..num_params {
                            if def.params[pp].ty.tag == TyTag::Placeholder && def.params[pp].ty.id()._value == def.generic_params[h].id._value {
                                param_idx = pp as i32;
                                break;
                            }
                        }
                        if param_idx < 0i32 || param_idx as usize >= args.len() { continue; }
                        let arg_expr = args[param_idx as usize];

                        // Check if ret_ty is a placeholder matching our target generic
                        if bound.ret_ty().tag == TyTag::Placeholder && bound.ret_ty().id()._value == def.generic_params[g].id._value {
                            // Extract return type from the lambda/fn's AST return type
                            if arg_expr.tag == ExprTag::Lambda && arg_expr.opt_ty().is_some() {
                                let ret_ty = self.resolve_type(arg_expr.opt_ty().unwrap());
                                inferred[g] = ret_ty;
                                found[g] = true;
                            } else if arg_expr.tag == ExprTag::FnRef {
                                // Function reference: look up the function def's return type
                                let fn_def = self.ctx.fn_defs.get(&arg_expr.id()._value);
                                if fn_def.is_some() {
                                    let ret_ty = self.resolve_type(fn_def.unwrap().return_type);
                                    inferred[g] = ret_ty;
                                    found[g] = true;
                                }
                            } else if arg_expr.tag == ExprTag::Local || arg_expr.tag == ExprTag::Param || arg_expr.tag == ExprTag::FieldAccess {
                                // Closure / fn-pointer / fn-item value referenced
                                // through a local, parameter, or struct field
                                // (e.g. `MapIterator::next` calls
                                // `option.map(self._fun)`). Lower the arg to
                                // recover its IR type, then dig out the return.
                                // Without this, Tm in `Fn(T) -> Tm` stays
                                // unbound and Option::map mono's Tm=void —
                                // truncating the closure's pointer return into
                                // a 1-byte Option payload, the bug behind
                                // `xs.iter().map(closure).to_vector()`
                                // returning garbage addresses.
                                let arg_ir_ty = self.lower_expr(arg_expr).ty;
                                let ret_ty: &IrTy = self.ctx.void_ty;
                                if arg_ir_ty.tag == IrTyTag::Closure {
                                    let cfn = arg_ir_ty.closure_fn();
                                    for fi in 0usize..self.ctx.ir_functions.len() {
                                        if self.ctx.ir_functions[fi].id._value == cfn.id._value
                                            && self.ctx.ir_functions[fi].mangled_name == cfn.mangled_name {
                                            ret_ty = self.ctx.ir_functions[fi].return_type;
                                            break;
                                        }
                                    }
                                } else if arg_ir_ty.tag == IrTyTag::Fn {
                                    let fnref = arg_ir_ty.fn_item_ref();
                                    for fi in 0usize..self.ctx.ir_functions.len() {
                                        if self.ctx.ir_functions[fi].id._value == fnref.id._value
                                            && self.ctx.ir_functions[fi].mangled_name == fnref.mangled_name {
                                            ret_ty = self.ctx.ir_functions[fi].return_type;
                                            break;
                                        }
                                    }
                                } else if arg_ir_ty.tag == IrTyTag::FnPointer {
                                    ret_ty = arg_ir_ty.ret_ty();
                                }
                                if !ret_ty.is_void() {
                                    inferred[g] = ret_ty;
                                    found[g] = true;
                                }
                            } else if arg_expr.tag == ExprTag::TurbofishValue && arg_expr.lhs().tag == ExprTag::FnRef {
                                // Turbofish-applied function reference: e.g.
                                // `Result::unwrap::<u32, Error>` passed as a value.
                                // Bind the function's generic params from the
                                // explicit type args, resolve the return type,
                                // then restore type_map. Without this branch the
                                // explicit args would be ignored and the return
                                // type would resolve under whatever stale
                                // bindings happened to be in type_map.
                                let fn_def = self.ctx.fn_defs.get(&arg_expr.lhs().id()._value);
                                if fn_def.is_some() {
                                    let inner_def = fn_def.unwrap();
                                    let n_ta = arg_expr.type_args().len();
                                    let n_bind = if n_ta < inner_def.generic_params.len() { n_ta } else { inner_def.generic_params.len() };
                                    let saved_vals = self.ctx.arena.alloc_slice::<&IrTy>(n_bind);
                                    let saved_had = self.ctx.arena.alloc_slice::<bool>(n_bind);
                                    for k in 0usize..n_bind {
                                        let prev = self.type_map.get(&inner_def.generic_params[k].id._value);
                                        if prev.is_some() {
                                            saved_vals[k] = prev.unwrap();
                                            saved_had[k] = true;
                                        } else {
                                            saved_had[k] = false;
                                        }
                                        let resolved = self.resolve_type(arg_expr.type_args()[k]);
                                        self.type_map.insert(inner_def.generic_params[k].id._value, resolved);
                                    }
                                    let ret_ty = self.resolve_type(inner_def.return_type);
                                    for k in 0usize..n_bind {
                                        if saved_had[k] {
                                            self.type_map.insert(inner_def.generic_params[k].id._value, saved_vals[k]);
                                        } else {
                                            self.type_map.remove(&inner_def.generic_params[k].id._value);
                                        }
                                    }
                                    inferred[g] = ret_ty;
                                    found[g] = true;
                                }
                            }
                        }
                        // Check if Fn bound return type is Generic containing our placeholder
                        // e.g. F: Fn(T) -> Option<Tm>
                        if !found[g] && bound.ret_ty().tag == TyTag::Generic && bound.ret_ty().elems().len() > 0 {
                            for re in 0usize..bound.ret_ty().elems().len() {
                                if found[g] { break; }
                                if bound.ret_ty().elems()[re].tag == TyTag::Placeholder && bound.ret_ty().elems()[re].id()._value == def.generic_params[g].id._value {
                                    if arg_expr.tag == ExprTag::Lambda && arg_expr.opt_ty().is_some() {
                                        let ret_ty = self.resolve_type(arg_expr.opt_ty().unwrap());
                                        if ret_ty.tag == IrTyTag::Struct && ret_ty.struct_ref().type_args.len() > re {
                                            inferred[g] = ret_ty.struct_ref().type_args[re];
                                            found[g] = true;
                                        }
                                    }
                                }
                            }
                        }
                        // Also check Fn bound params for placeholder matches
                        for bp in 0usize..bound.elems().len() {
                            if found[g] { break; }
                            if bound.elems()[bp].tag == TyTag::Placeholder && bound.elems()[bp].id()._value == def.generic_params[g].id._value {
                                if arg_expr.tag == ExprTag::Lambda && bp < arg_expr.lambda_params().len() {
                                    // Get the lambda parameter type
                                    let lp_ty = arg_expr.lambda_params()[bp].ty;
                                    if lp_ty.is_some() {
                                        let param_ty = self.resolve_type(lp_ty.unwrap());
                                        inferred[g] = param_ty;
                                        found[g] = true;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Bound-derived: `R: RangeOf<T>` ⟹ T = R's element type. Mirrors the
        // mixin-path (try_lower_method_call) so direct calls like
        // `internal::gen_integer(rng, 0i32..10i32)` and the recursive
        // `rng.next(T::min_value()..range.upper)` inside gen_integer bind T
        // without relying on the call-site expected type.
        self.infer_from_range_of_bounds(def, inferred, found);

        // If we haven't inferred all generics from args, try return type inference.
        // If the function's return type is a named type with generic placeholders,
        // and we have an expected_type or return_type that's a concrete struct,
        // try to match placeholders against the struct's type args.
        let all_found = true;
        for i in 0usize..num_generics {
            if !found[i] { all_found = false; }
        }
        if !all_found {
            // Try inferring from return type context
            let ret_ty_ast = def.return_type;
            let hint_ty = if !self.expected_type.is_void() {
                self.expected_type
            } else {
                self.return_type
            };
            // Match: fn returns GenericType<T> (TyTag::Generic) and hint is a struct with type_args
            if ret_ty_ast.tag == TyTag::Generic && hint_ty.tag == IrTyTag::Struct && hint_ty.struct_ref().type_args.len() > 0 {
                // TyTag::Generic has inner (base type) and elems (type args as AST types)
                let ret_type_args = ret_ty_ast.elems();
                let hint_type_args = hint_ty.struct_ref().type_args;
                let min_len = if ret_type_args.len() < hint_type_args.len() { ret_type_args.len() } else { hint_type_args.len() };
                for ta in 0usize..min_len {
                    if ret_type_args[ta].tag == TyTag::Placeholder {
                        for g in 0usize..num_generics {
                            if !found[g] && def.generic_params[g].id._value == ret_type_args[ta].id()._value {
                                inferred[g] = hint_type_args[ta];
                                found[g] = true;
                                break;
                            }
                        }
                    }
                }
            }
            // Match: fn returns GenericType<T> (TyTag::Generic) and hint is a tuple
            // This handles cases like slice<Ptr> where slice is a struct but the hint
            // is the tuple representation {Ptr, usize}
            if ret_ty_ast.tag == TyTag::Generic && hint_ty.tag == IrTyTag::Tuple && hint_ty.elems().len() > 0 {
                let ret_type_args = ret_ty_ast.elems();
                let min_len = if ret_type_args.len() < hint_ty.elems().len() { ret_type_args.len() } else { hint_ty.elems().len() };
                for ta in 0usize..min_len {
                    if ret_type_args[ta].tag == TyTag::Placeholder {
                        for g in 0usize..num_generics {
                            if !found[g] && def.generic_params[g].id._value == ret_type_args[ta].id()._value {
                                inferred[g] = hint_ty.elems()[ta];
                                found[g] = true;
                                break;
                            }
                        }
                    }
                }
            }
            // Match: fn returns a tuple of placeholders (e.g. `fn make_pair<T>() -> (T, T)`)
            // and hint is a concrete tuple. Walk the declared tuple's elems in
            // parallel with the hint's elems and bind any direct-Placeholder
            // slot to the corresponding hint elem.
            if ret_ty_ast.tag == TyTag::Tuple && hint_ty.tag == IrTyTag::Tuple
                && ret_ty_ast.elems().len() == hint_ty.elems().len() {
                let ret_elems = ret_ty_ast.elems();
                let hint_elems = hint_ty.elems();
                for ti in 0usize..ret_elems.len() {
                    if ret_elems[ti].tag == TyTag::Placeholder {
                        for g in 0usize..num_generics {
                            if !found[g] && def.generic_params[g].id._value == ret_elems[ti].id()._value {
                                inferred[g] = hint_elems[ti];
                                found[g] = true;
                                break;
                            }
                        }
                    }
                }
            }
            // Direct placeholder in return type: fn foo<T>() -> T.
            // Skipped when we're inside arg-inference for an OUTER call —
            // otherwise an inner call like `util::cast(x)` (return type
            // direct-Placeholder T2) would bind T2 to the *outer*
            // call's expected_type / return_type. The arg-inference
            // path's `expected_type` clearing zeros the current frame's
            // hint, but a nested `infer_type_args` for the inner call
            // could still see a stale return_type from outside arg-walking
            // unless the flag guards this branch too.
            if ret_ty_ast.tag == TyTag::Placeholder
                && !hint_ty.is_void()
                && !self.inside_arg_inference {
                for g in 0usize..num_generics {
                    if !found[g] && def.generic_params[g].id._value == ret_ty_ast.id()._value {
                        inferred[g] = hint_ty;
                        found[g] = true;
                        break;
                    }
                }
            }

            // Dyn return-type unification. Aluminac parses `&dyn Proto`
            // as a single `TyTag::Dyn` AST node (the `&` is implicit in
            // the dyn syntax), so the AST side is Dyn directly. The IR
            // side is the lang(dyn) struct, fronted by a Pointer if the
            // caller's expected type is `&dyn …`.
            if !hint_ty.is_void()
                && ret_ty_ast.tag == TyTag::Dyn {
                let ir_target = if hint_ty.tag == IrTyTag::Pointer {
                    hint_ty.inner()
                } else {
                    hint_ty
                };
                if ir_target.tag == IrTyTag::Struct {
                    self.unify_type_for_inference(ret_ty_ast, ir_target, inferred, found, def.generic_params);
                }
            }
        }

        // Check if at least one generic was inferred (enough to differentiate)
        let any_found = false;
        for i in 0usize..num_generics {
            if found[i] {
                any_found = true;
            }
        }

        if any_found {
            inferred as &[&IrTy]
        } else {
            // Return empty - couldn't infer any types
            // Note: use alloc_slice(0) instead of &[] because &[] in an if-else branch
            // generates a broken bitcast that reads garbage for the slice length
            self.ctx.arena.alloc_slice::<&IrTy>(0usize)
        }
    }

    // UFCS fallback: try calling a free function with the object as first argument.
    // obj.func(args) -> func(obj, args) or func(&obj, args)
    fn try_ufcs_call(self: &mut Mono, expr: &Expr, ir_obj: &IrExpr, fn_id: Id) -> Option<&IrExpr> {
        let fn_def = self.ctx.fn_defs.get(&fn_id._value);
        if fn_def.is_none() {
            return Option::none();
        }
        let def = fn_def.unwrap();

        let total_args = 1usize + expr.args().len();

        // Resolve type args from explicit turbofish
        let type_args: &[&IrTy] = &[];
        if expr.type_args().len() > 0 {
            let resolved = self.ctx.arena.alloc_slice::<&IrTy>(expr.type_args().len());
            for i in 0usize..expr.type_args().len() {
                resolved[i] = self.resolve_type(expr.type_args()[i]);
            }
            type_args = resolved;
        }

        // Infer type args if needed using AST-level args
        if def.generic_params.len() > 0 && type_args.len() == 0 {
            let ast_args = self.ctx.arena.alloc_slice::<&Expr>(total_args);
            ast_args[0] = expr.lhs().lhs();  // Original object expression from FieldAccess
            for i in 0usize..expr.args().len() {
                ast_args[1 + i] = expr.args()[i];
            }
            type_args = self.infer_type_args(def, ast_args);
        }

        // Build IR args: use already-lowered ir_obj, lower remaining args
        let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(total_args);

        // Check if the function expects a reference for the first param.
        // Only auto-take-ref when the receiver isn't already a pointer —
        // otherwise (1..5).hash_of() and (&r).hash_of() would produce
        // different IR (& vs &&) and dispatch via different mono paths.
        if def.params.len() > 0 && def.params[0].ty.tag == TyTag::Pointer && ir_obj.ty.tag != IrTyTag::Pointer {
            ir_args[0] = self.mk_ref(ir_obj, false);
        } else {
            ir_args[0] = ir_obj;
        }

        for i in 0usize..expr.args().len() {
            ir_args[1 + i] = self.lower_expr(expr.args()[i]);
        }

        // Monomorphize and call. Use `ir_fn.return_type` rather than
        // re-resolving `def.return_type` here: `mono_function`
        // snapshot/restores `type_map` bindings on the def's generic params,
        // so by this point a prior instantiation's binding may have been
        // restored. The mono'd function's `return_type` was computed under
        // *this* call's bindings, so it's the right thing to put on the
        // call's IR node. Without this, `read_volatile<()>` called via
        // UFCS after a prior `read_volatile<i32>` mono'd the body with
        // void-return but kept the i32 binding on the call site — codegen
        // then named the void call's result and the verifier rejected it.
        let fn_idx = self.mono_function(def, type_args);
        let ir_fn = &self.ctx.ir_functions[fn_idx];
        let fn_ref = IrFnRef { id: ir_fn.id, mangled_name: ir_fn.mangled_name };
        Option::some(self.mk_call(fn_ref, ir_args, ir_fn.return_type))
    }

    // Try to resolve a method call: obj.method(args) -> Type::method(&obj, args)
    fn try_lower_method_call(self: &mut Mono, expr: &Expr) -> Option<&IrExpr> {
        // expr is ExprTag::Call, expr.lhs is ExprTag::FieldAccess
        let field_expr = expr.lhs();
        let ir_obj = self.lower_expr(field_expr.lhs());
        let method_name = field_expr.str_val();

        // Get the struct or enum type (auto-deref)
        let scope_idx: u32 = 0u32;
        let method_type_args: &[&IrTy] = &[];
        let resolved_ty = ir_obj.ty;
        if resolved_ty.tag == IrTyTag::Pointer {
            resolved_ty = resolved_ty.inner();
        }


        if resolved_ty.tag == IrTyTag::Struct {
            // Detect a `&dyn Proto` value: the resolved struct is the lang(dyn)
            // struct. Lower to real vtable dispatch — load the fn pointer at
            // the method's protocol-declared index, cast to the typed fn
            // pointer (with Self → &void), and call with (dyn._ptr, args...).
            // Falls through to Unreachable if the method can't be located in
            // the protocol (defensive — shouldn't happen on a typed dyn).
            let dyn_lang_id = self.ctx.get_lang_item("dyn");
            if dyn_lang_id.is_some() && resolved_ty.struct_ref().id._value == dyn_lang_id.unwrap() {
                let dispatch = self.lower_dyn_method_call(expr, ir_obj, resolved_ty, method_name);
                if dispatch.is_some() {
                    return dispatch;
                }
                for i in 0usize..expr.args().len() {
                    self.lower_expr(expr.args()[i]);
                }
                let unreach = IrExpr::void_expr(self.ctx.never_ty);
                unreach.tag = IrTag::Unreachable;
                return Option::some(self.ctx.arena.alloc(unreach) as &IrExpr);
            }
            scope_idx = resolved_ty.struct_ref().scope_idx;
            method_type_args = resolved_ty.struct_ref().type_args;
        } else if resolved_ty.tag == IrTyTag::Enum {
            scope_idx = resolved_ty.enum_ref().scope_idx;
        } else if resolved_ty.tag == IrTyTag::Slice {
            // Look up #[lang(slice)] struct for methods on slice types
            // slice<Ptr> where Ptr is the pointer-to-element type
            let lang_id = self.ctx.get_lang_item("slice");
            if lang_id.is_some() {
                let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                if sd.is_some() {
                    scope_idx = sd.unwrap().scope_idx;
                    // Set up type arg: Ptr = &elem_type (or &mut elem_type)
                    let elem_ty = self.slice_elem_ty(resolved_ty);
                    let ptr_ty = self.ctx.make_ptr_ty(elem_ty, false);
                    let type_args = self.ctx.arena.alloc_slice::<&IrTy>(1);
                    type_args[0] = ptr_ty;
                    method_type_args = type_args;
                }
            }
            if scope_idx == 0 {
                if field_expr.id2()._value != 0 {
                    return self.try_ufcs_call(expr, ir_obj, Id { _value: field_expr.id2()._value - 1usize });
                }
                return Option::none();
            }
        } else if resolved_ty.tag == IrTyTag::Array {
            let lang_id = self.ctx.get_lang_item("builtin_array");
            if lang_id.is_some() {
                let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                if sd.is_some() {
                    scope_idx = sd.unwrap().scope_idx;
                }
            }
            if scope_idx == 0 {
                if field_expr.id2()._value != 0 {
                    return self.try_ufcs_call(expr, ir_obj, Id { _value: field_expr.id2()._value - 1usize });
                }
                return Option::none();
            }
        } else if resolved_ty.tag == IrTyTag::Tuple {
            let lang_id = self.ctx.get_lang_item("builtin_tuple");
            if lang_id.is_some() {
                let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                if sd.is_some() {
                    scope_idx = sd.unwrap().scope_idx;
                }
            }
            if scope_idx == 0 {
                if field_expr.id2()._value != 0 {
                    return self.try_ufcs_call(expr, ir_obj, Id { _value: field_expr.id2()._value - 1usize });
                }
                return Option::none();
            }
        } else if resolved_ty.tag == IrTyTag::Fn || resolved_ty.tag == IrTyTag::FnPointer || resolved_ty.tag == IrTyTag::Closure {
            let lang_id = self.ctx.get_lang_item("builtin_callable");
            if lang_id.is_some() {
                let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                if sd.is_some() {
                    scope_idx = sd.unwrap().scope_idx;
                }
            }
            if scope_idx == 0 {
                if field_expr.id2()._value != 0 {
                    return self.try_ufcs_call(expr, ir_obj, Id { _value: field_expr.id2()._value - 1usize });
                }
                return Option::none();
            }
        } else if resolved_ty.tag == IrTyTag::Builtin {
            // Look up #[lang(builtin_X)] struct to find methods on builtin types
            let lang_name = Mono::builtin_lang_name(resolved_ty.builtin());
            if lang_name.len() > 0 {
                let lang_id = self.ctx.get_lang_item(lang_name);
                if lang_id.is_some() {
                    let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                    if sd.is_some() {
                        scope_idx = sd.unwrap().scope_idx;
                    }
                }
            }
            if scope_idx == 0 {
                if field_expr.id2()._value != 0 {
                    return self.try_ufcs_call(expr, ir_obj, Id { _value: field_expr.id2()._value - 1usize });
                }
                return Option::none();
            }
        } else if resolved_ty.tag == IrTyTag::Void {
            // The unit type `()` collapses to void_ty in `make_tuple_ty`.
            // Treat it as a zero-tuple for method-dispatch so e.g. `().len()`
            // routes to builtin_tuple's impl.
            let lang_id = self.ctx.get_lang_item("builtin_tuple");
            if lang_id.is_some() {
                let sd = self.ctx.struct_defs.get(&lang_id.unwrap());
                if sd.is_some() {
                    scope_idx = sd.unwrap().scope_idx;
                }
            }
            if scope_idx == 0 {
                if field_expr.id2()._value != 0 {
                    return self.try_ufcs_call(expr, ir_obj, Id { _value: field_expr.id2()._value - 1usize });
                }
                return Option::none();
            }
        } else {
            if field_expr.id2()._value != 0 {
                return self.try_ufcs_call(expr, ir_obj, Id { _value: field_expr.id2()._value - 1usize });
            }
            return Option::none();
        }
        if scope_idx == 0 {
            if field_expr.id2()._value != 0 {
                return self.try_ufcs_call(expr, ir_obj, Id { _value: field_expr.id2()._value - 1usize });
            }
            return Option::none();
        }

        // Look up method in type's scope
        let method_item = self.ctx.scopes.get(scope_idx).items.get(&method_name);
        if method_item.is_none() {
            // UFCS fallback: if the FieldAccess has a hint (id2), try calling as free function
            if field_expr.id2()._value != 0 {
                return self.try_ufcs_call(expr, ir_obj, Id { _value: field_expr.id2()._value - 1usize });
            }
            return Option::none();
        }
        let item = method_item.unwrap();

        // Get the function id
        let fn_id = if item.kind.tag == NamedItemTag::Function {
            item.kind.id()
        } else if item.kind.tag == NamedItemTag::Method {
            item.kind.id2()
        } else {
            return Option::none();
        };

        // Look up the FnDef
        let fn_def = self.ctx.fn_defs.get(&fn_id._value);
        if fn_def.is_none() {
            return Option::none();
        }
        let def = fn_def.unwrap();

        // For Slice receivers, the earlier setup of `method_type_args`
        // (line ~5210) only knew `Ptr`, so it set `method_type_args = [Ptr]`.
        // Now that we have `def`, mirror `call_method_on_type`'s and
        // `lower_defered_call`'s Slice branches: methods declared
        // `<T, Ptr>` get `[elem_ty, ptr_ty]`, and methods declared
        // `<T, Ptr, H>` get `[elem_ty, ptr_ty, void]`. Without this,
        // `slice::equals<T, Ptr>` was being mono'd with `T` bound to the
        // pointer type (since `method_type_args[0]` slot fell through to
        // the single Ptr value), and the body's `size_of::<T>()` returned
        // pointer size (8) instead of element size (1). The
        // resulting `memcmp(p, q, len * 8)` read past the slice end and
        // returned non-zero for "Lorem" vs "Lorem" — which is what
        // `s1.equals(&s2)` was failing on after the io/mod.alu swap.
        if resolved_ty.tag == IrTyTag::Slice && method_type_args.len() == 1
            && def.generic_params.len() > 1 {
            let elem_ty = self.slice_elem_ty(resolved_ty);
            let ptr_ty = method_type_args[0];
            if def.generic_params.len() == 3 {
                let ta = self.ctx.arena.alloc_slice::<&IrTy>(3);
                ta[0] = elem_ty;
                ta[1] = ptr_ty;
                ta[2] = self.ctx.void_ty;
                method_type_args = ta;
            } else if def.generic_params.len() == 2 {
                let ta = self.ctx.arena.alloc_slice::<&IrTy>(2);
                ta[0] = elem_ty;
                ta[1] = ptr_ty;
                method_type_args = ta;
            }
        }

        // For mixin'd methods, resolve the mixin's type args. The mixin
        // records `proto_args` for the protocol it injects (Self + protocol's
        // other generics, in declaration order). Bind those into `type_map`
        // via `bind_proto_generics` and forward whatever remains as the
        // method's own type args.
        //
        // The mixin type args contain Placeholder refs to the IMPL's generic
        // params (and to the mixin's own generic params). We must first map
        // those impl param IDs to concrete types from the struct's type_args
        // so subsequent `resolve_type` calls produce concrete IR types.
        let mixin_args = self.ctx.scopes.get_mixin_type_args(scope_idx, fn_id._value);
        if mixin_args.is_some() {
            let ast_args = mixin_args.unwrap();
            // Unify the mixin's first AST arg (which conventionally is the
            // shape of the impl type, e.g. `MapIterator<It,F,T,U>`) against
            // the actual receiver IR type to bind the placeholders directly
            // from the receiver's concrete type-args. This is more robust
            // than `get_mixin_impl_generic_ids` because the impl block's
            // generic-param ids stored at parse time don't always match
            // the ids the mixin AST actually uses for placeholders (the
            // parser creates fresh placeholder ids while parsing the
            // mixin's protocol type-args).
            if ast_args.len() > 0 {
                self.bind_placeholders_from_ast_vs_ir(ast_args[0], resolved_ty);
            }
            // Legacy: also bind the impl_generic_param_ids list directly to
            // the receiver's struct type_args, in case some other path
            // depends on the same ids being bound. Cheap (4 inserts) and
            // strictly additive.
            let impl_gp_ids = self.ctx.scopes.get_mixin_impl_generic_ids(scope_idx, fn_id._value);
            if impl_gp_ids.is_some() && resolved_ty.tag == IrTyTag::Struct {
                let ids = impl_gp_ids.unwrap();
                let n_gp = std::cmp::min(ids.len(), resolved_ty.struct_ref().type_args.len());
                for gi in 0usize..n_gp {
                    self.type_map.insert(ids[gi]._value, resolved_ty.struct_ref().type_args[gi]);
                }
            }
            let resolved = self.ctx.arena.alloc_slice::<&IrTy>(ast_args.len());
            for i in 0usize..ast_args.len() {
                resolved[i] = self.resolve_type(ast_args[i]);
            }
            let consumed = self.bind_proto_generics(def, resolved);
            method_type_args = resolved[consumed..];
        }

        // Combine struct type args with method turbofish type args
        // e.g. for Container<i32>.transform::<String>(), struct args=[i32], turbofish=[String]
        // The function's generic_params are [K, V], so combined = [i32, String]
        let combined_type_args = method_type_args;
        if expr.type_args().len() > 0 {
            let resolved_turbofish = self.ctx.arena.alloc_slice::<&IrTy>(expr.type_args().len());
            for i in 0usize..expr.type_args().len() {
                resolved_turbofish[i] = self.resolve_type(expr.type_args()[i]);
            }
            if method_type_args.len() > 0 {
                // Combine: struct type args first, then turbofish type args
                let total = method_type_args.len() + expr.type_args().len();
                let merged = self.ctx.arena.alloc_slice::<&IrTy>(total);
                for j in 0usize..method_type_args.len() {
                    merged[j] = method_type_args[j];
                }
                for k in 0usize..expr.type_args().len() {
                    merged[method_type_args.len() + k] = resolved_turbofish[k];
                }
                combined_type_args = merged;
            } else {
                combined_type_args = resolved_turbofish;
            }
        }

        // Infer type args from the actual call arguments (including self).
        // For methods in non-generic impl blocks (e.g. `impl Option { fn transpose<T, E>(...) }`),
        // the struct's type_args don't correspond to the method's generic params, so we must
        // infer from the self parameter via recursive type unification.
        if def.generic_params.len() > 0 {
            let num_generics = def.generic_params.len();
            let inferred = self.ctx.arena.alloc_slice::<&IrTy>(num_generics);
            let found = self.ctx.arena.alloc_slice::<bool>(num_generics);
            let found_count = 0usize;
            for i in 0usize..num_generics {
                inferred[i] = self.ctx.void_ty;
                found[i] = false;
            }

            // Infer from the self parameter using recursive unification.
            if def.params.len() > 0 {
                let self_param_ty = def.params[0].ty;
                let self_arg_ty = ir_obj.ty;
                // Unwrap pointer for &self / &mut self
                if self_param_ty.tag == TyTag::Pointer {
                    self_param_ty = self_param_ty.inner();
                    if self_arg_ty.tag == IrTyTag::Pointer {
                        self_arg_ty = self_arg_ty.inner();
                    }
                }
                self.unify_type_for_inference(self_param_ty, self_arg_ty, inferred, found, def.generic_params);
            }

            // Then infer from explicit args (skipping self)
            let num_explicit_params = if def.params.len() > 0 { def.params.len() - 1 } else { 0usize };
            for p in 0usize..num_explicit_params {
                if p >= expr.args().len() { break; }
                let param_ty = def.params[p + 1].ty;  // +1 to skip self
                let arg_ty = self.lower_expr(expr.args()[p]).ty;
                self.unify_type_for_inference(param_ty, arg_ty, inferred, found, def.generic_params);
            }

            // Fill remaining from combined_type_args where inference didn't produce a result
            for i in 0usize..num_generics {
                if found[i] {
                    found_count = found_count + 1usize;
                } else if i < combined_type_args.len() {
                    inferred[i] = combined_type_args[i];
                    found_count = found_count + 1usize;
                }
            }
            // Infer generics from Fn bounds (e.g. F: Fn(T) -> Tm => infer Tm from lambda return type)
            for g in 0usize..num_generics {
                if !inferred[g].is_void() { continue; }
                for h in 0usize..num_generics {
                    if h == g { continue; }
                    for b in 0usize..def.generic_params[h].bounds.len() {
                        let bound = def.generic_params[h].bounds[b];
                        if bound.tag != TyTag::FnPointer { continue; }
                        // Find which explicit parameter (skipping self) corresponds to generic h
                        let param_idx: i32 = -1i32;
                        for pp in 1usize..def.params.len() {
                            if def.params[pp].ty.tag == TyTag::Placeholder && def.params[pp].ty.id()._value == def.generic_params[h].id._value {
                                param_idx = (pp - 1) as i32;  // index into expr.args() (0-based, skip self)
                                break;
                            }
                        }
                        if param_idx < 0i32 || param_idx as usize >= expr.args().len() { continue; }
                        let arg_expr = expr.args()[param_idx as usize];
                        // Check if Fn bound return type is a placeholder matching our target generic
                        if bound.ret_ty().tag == TyTag::Placeholder && bound.ret_ty().id()._value == def.generic_params[g].id._value {
                            if arg_expr.tag == ExprTag::Lambda && arg_expr.opt_ty().is_some() {
                                let ret_ty = self.resolve_type(arg_expr.opt_ty().unwrap());
                                inferred[g] = ret_ty;
                                found_count = found_count + 1usize;
                            } else if arg_expr.tag == ExprTag::FnRef {
                                // For named function refs, infer from the function's return type
                                let fn_ref_def = self.ctx.fn_defs.get(&arg_expr.id()._value);
                                if fn_ref_def.is_some() {
                                    let ret_ty = self.resolve_type(fn_ref_def.unwrap().return_type);
                                    inferred[g] = ret_ty;
                                    found_count = found_count + 1usize;
                                }
                            } else {
                                // General case: lower the arg and check if it's a function pointer, Fn item, or closure
                                let arg_ir = self.lower_expr(arg_expr);
                                if arg_ir.ty.tag == IrTyTag::FnPointer {
                                    inferred[g] = arg_ir.ty.ret_ty();
                                    found_count = found_count + 1usize;
                                } else if arg_ir.ty.tag == IrTyTag::Fn {
                                    // Match on (id, mangled_name) and break: multiple
                                    // monos of the same source function share `id`,
                                    // so id-only matching would let the LAST matching
                                    // mono's return_type win — and pick up an
                                    // unrelated mono (e.g. Result::unwrap<()> from
                                    // the panic chain) when the caller meant a
                                    // specific one (Result::unwrap<u32, Error>).
                                    let fn_ref = arg_ir.ty.fn_item_ref();
                                    for fi in 0usize..self.ctx.ir_functions.len() {
                                        if self.ctx.ir_functions[fi].id._value == fn_ref.id._value
                                            && self.ctx.ir_functions[fi].mangled_name == fn_ref.mangled_name {
                                            inferred[g] = self.ctx.ir_functions[fi].return_type;
                                            found_count = found_count + 1usize;
                                            break;
                                        }
                                    }
                                } else if arg_ir.ty.tag == IrTyTag::Closure {
                                    // Closure value (e.g. `MapIterator::next` calls
                                    // `option.map(self._fun)` — self._fun's IR type
                                    // is Closure). Look up the underlying fn's
                                    // mono'd return type. Without this, Tm in
                                    // `Fn(T) -> Tm` stays unbound and Option::map
                                    // mono's Tm=void — truncating the closure's
                                    // pointer return into a 1-byte Option payload.
                                    // Surfaced as the `iter().map(closure).next()`
                                    // returning garbage addresses bug.
                                    let cfn = arg_ir.ty.closure_fn();
                                    for fi in 0usize..self.ctx.ir_functions.len() {
                                        if self.ctx.ir_functions[fi].id._value == cfn.id._value
                                            && self.ctx.ir_functions[fi].mangled_name == cfn.mangled_name {
                                            inferred[g] = self.ctx.ir_functions[fi].return_type;
                                            found_count = found_count + 1usize;
                                            break;
                                        }
                                    }
                                }
                            }
                        }
                        // Check if Fn bound return type is a Generic containing our placeholder
                        // e.g. F: Fn(T) -> Option<Tm> where Tm is what we're inferring
                        if bound.ret_ty().tag == TyTag::Generic && bound.ret_ty().elems().len() > 0 {
                            for re in 0usize..bound.ret_ty().elems().len() {
                                if !inferred[g].is_void() { break; }
                                if bound.ret_ty().elems()[re].tag == TyTag::Placeholder && bound.ret_ty().elems()[re].id()._value == def.generic_params[g].id._value {
                                    // Resolve the callable's return type and extract the type arg
                                    let resolved_ret: &IrTy = self.ctx.void_ty;
                                    if arg_expr.tag == ExprTag::Lambda && arg_expr.opt_ty().is_some() {
                                        resolved_ret = self.resolve_type(arg_expr.opt_ty().unwrap());
                                    } else if arg_expr.tag == ExprTag::FnRef {
                                        let fn_ref_def2 = self.ctx.fn_defs.get(&arg_expr.id()._value);
                                        if fn_ref_def2.is_some() {
                                            resolved_ret = self.resolve_type(fn_ref_def2.unwrap().return_type);
                                        }
                                    } else {
                                        let arg_ir2 = self.lower_expr(arg_expr);
                                        if arg_ir2.ty.tag == IrTyTag::FnPointer {
                                            resolved_ret = arg_ir2.ty.ret_ty();
                                        } else if arg_ir2.ty.tag == IrTyTag::Fn {
                                            // Same (id, mangled_name) + break rule as above.
                                            let fn_ref2 = arg_ir2.ty.fn_item_ref();
                                            for fi in 0usize..self.ctx.ir_functions.len() {
                                                if self.ctx.ir_functions[fi].id._value == fn_ref2.id._value
                                                    && self.ctx.ir_functions[fi].mangled_name == fn_ref2.mangled_name {
                                                    resolved_ret = self.ctx.ir_functions[fi].return_type;
                                                    break;
                                                }
                                            }
                                        } else if arg_ir2.ty.tag == IrTyTag::Closure {
                                            let cfn2 = arg_ir2.ty.closure_fn();
                                            for fi in 0usize..self.ctx.ir_functions.len() {
                                                if self.ctx.ir_functions[fi].id._value == cfn2.id._value
                                                    && self.ctx.ir_functions[fi].mangled_name == cfn2.mangled_name {
                                                    resolved_ret = self.ctx.ir_functions[fi].return_type;
                                                    break;
                                                }
                                            }
                                        }
                                    }
                                    if resolved_ret.tag == IrTyTag::Struct && resolved_ret.struct_ref().type_args.len() > re {
                                        inferred[g] = resolved_ret.struct_ref().type_args[re];
                                        found_count = found_count + 1usize;
                                    }
                                }
                            }
                        }
                        // Check Fn bound params for placeholder matches
                        for bp in 0usize..bound.elems().len() {
                            if !inferred[g].is_void() { break; }
                            if bound.elems()[bp].tag == TyTag::Placeholder && bound.elems()[bp].id()._value == def.generic_params[g].id._value {
                                if arg_expr.tag == ExprTag::Lambda && bp < arg_expr.lambda_params().len() {
                                    let lp_ty = arg_expr.lambda_params()[bp].ty;
                                    if lp_ty.is_some() {
                                        let param_ty = self.resolve_type(lp_ty.unwrap());
                                        inferred[g] = param_ty;
                                        found_count = found_count + 1usize;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Bound-derived: `R: RangeOf<T>` ⟹ T = R's element type. A
            // signature like `fn next<T: Integer, R: RangeOf<T>>(.., R) -> T`
            // carries T in no parameter (only R, the whole range). Through
            // the mixin'd-method dispatch, T would otherwise stay void —
            // collapsing `when range is Range<T>` and hanging gen_uniform's
            // rejection loop. Independent of expected_type so it's correct
            // in any call context; an expected-return-type fallback was
            // tried and reverted (it leaked `assert!`'s bool through `>=`
            // into T, regressing io's `assert_eq!(read_exact(..), ok(()))`).
            if self.infer_from_range_of_bounds(def, inferred, found) {
                found_count = found_count + 1usize;
            }

            // Expected-return-type inference for a mixin'd method whose own
            // generic is a bare Placeholder in return position and has at
            // least one protocol bound (e.g. `fn next_float<T: FloatingPoint>
            // (rng) -> T`). Such a `T` is in no parameter and has no
            // RangeOf-style bound to derive it from — it can only come from
            // the call's expected type (`let uf: f64 = rng.next_float()`).
            // Through the mixin dispatch this otherwise stays void and the
            // body computes `x as void` = 0.
            //
            // The earlier *unguarded* version of this branch leaked
            // `assert!(... >= ...)`'s `bool` (propagated through the `>=`
            // operand) into an unrelated mixin method's T, regressing io's
            // `assert_eq!(read_exact(..), Result::ok(()))`. Guard: bind only
            // if the generic has >=1 protocol bound AND `expected_type`
            // *satisfies* every such bound. `bool` does not conform to
            // `FloatingPoint`/`Integer`/etc., so a leaked bool is rejected
            // here; `f64` conforms to `FloatingPoint`, so `next_float`'s T
            // binds correctly. Generics with no bound get no expected-type
            // inference (conservative — the leak risk outweighs the rare
            // unbounded return-only-generic case).
            if def.return_type.tag == TyTag::Placeholder
                && !self.expected_type.is_void()
                && !self.inside_arg_inference {
                for g in 0usize..num_generics {
                    if !inferred[g].is_void() { continue; }
                    if def.return_type.id()._value != def.generic_params[g].id._value { continue; }
                    let gp = &def.generic_params[g];
                    if gp.bounds.len() == 0 { continue; }
                    let all_ok = true;
                    for b in 0usize..gp.bounds.len() {
                        let bound_ir = self.resolve_type(gp.bounds[b]);
                        if bound_ir.tag == IrTyTag::Protocol {
                            let pd = self.ctx.protocol_defs.get(&bound_ir.proto_id());
                            if pd.is_some() && !self.check_protocol_conformance(self.expected_type, pd.unwrap()) {
                                all_ok = false;
                                break;
                            }
                        }
                    }
                    if all_ok {
                        inferred[g] = self.expected_type;
                        found[g] = true;
                        found_count = found_count + 1usize;
                    }
                }
            }

            if found_count > 0 {
                combined_type_args = inferred;
            }
        }

        // For protocol methods (from mixins), set up Self type substitution
        let self_id_opt = self.ctx.proto_method_self_id.get(&fn_id._value);
        if self_id_opt.is_some() {
            self.type_map.insert(self_id_opt.unwrap(), resolved_ty);
        }

        // For protocol methods, also infer the protocol's other generics
        // (e.g. `F` in `Formattable<Self, F>`) from the call's actual
        // receiver and arg types. The mixin's `<...>` args may have left
        // them unbound — see `infer_proto_generics_from_call`.
        self.infer_proto_generics_from_call(def, ir_obj.ty, expr.args());

        // Monomorphize the method with type args (for generic impls + turbofish)
        let fn_idx = self.mono_function(def, combined_type_args);
        let ir_fn = &self.ctx.ir_functions[fn_idx];

        // Build args: &obj as first arg, then the call args
        let total_args = 1usize + expr.args().len();
        let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(total_args);

        // Autoref/autoderef: match receiver indirection level to method's self parameter
        let self_param_ty = if ir_fn.params.len() > 0 { ir_fn.params[0].ty } else { ir_obj.ty };
        ir_args[0] = self.autoref(ir_obj, self_param_ty);

        // Rest of the args
        for i in 0usize..expr.args().len() {
            // Propagate the parameter type as expected_type so nested call
            // inference can solve free generics from context (e.g.
            // `slice::empty()` infers `Ptr` from `&mut [u8]`).
            if (1usize + i) < ir_fn.params.len() {
                let pty = ir_fn.params[1usize + i].ty;
                ir_args[1 + i] = self.lower_expr_coerced(expr.args()[i], pty);
                ir_args[1usize + i] = self.check_and_coerce(ir_args[1usize + i], pty, expr.args()[i].span);
            } else {
                ir_args[1 + i] = self.lower_expr(expr.args()[i]);
            }
        }

        // Build direct call
        let fn_ref = IrFnRef { id: ir_fn.id, mangled_name: ir_fn.mangled_name };
        Option::some(self.mk_call(fn_ref, ir_args, ir_fn.return_type))
    }

    // Lower call expressions: ExprTag::Call, ExprTag::StructLit
    fn lower_lambda(self: &mut Mono, expr: &Expr) -> &IrExpr {
        let has_captures = expr.closure_bindings().len() > 0;

        // Create an anonymous function for the lambda
        let lambda_id = self.ctx.id_gen.next_id();
        let mangled = self.ctx.mangle_name(if has_captures { "closure" } else { "lambda" });

        // First, lower the captured values (before switching to lambda's local scope)
        let bound_values = self.ctx.arena.alloc_slice::<&IrExpr>(expr.closure_bindings().len());
        for i in 0usize..expr.closure_bindings().len() {
            let binding = &expr.closure_bindings()[i];
            let val = self.lower_expr(binding.value);
            if binding.bound_type == BoundType::ByValue {
                bound_values[i] = val;
            } else {
                // By reference: take a reference to the original variable
                bound_values[i] = self.mk_ref(val, false);
            }
        }

        // Build closure struct fields from captured values
        let closure_fields = self.ctx.arena.alloc_slice::<IrField>(expr.closure_bindings().len());
        let is_closure_zst = true;
        for i in 0usize..expr.closure_bindings().len() {
            closure_fields[i] = IrField {
                name: expr.closure_bindings()[i].name,
                ty: bound_values[i].ty,
            };
            if !bound_values[i].ty.is_zero_sized() {
                is_closure_zst = false;
            }
        }

        // Create the closure struct type
        let closure_struct_ref = IrStructRef {
            id: lambda_id,
            name: mangled,
            fields: closure_fields,
            is_union: false,
            is_zero_sized: is_closure_zst,
            scope_idx: 0,
            type_args: &[],
            is_packed: false,
            attributes: &[],
        };
        let closure_fn_ref = IrFnRef { id: lambda_id, mangled_name: mangled };

        // Resolve parameter types - for closures, add self param at index 0
        let total_params = if has_captures { expr.lambda_params().len() + 1usize } else { expr.lambda_params().len() };
        let params = self.ctx.arena.alloc_slice::<IrParam>(total_params);
        let param_types = self.ctx.arena.alloc_slice::<&IrTy>(expr.lambda_params().len());

        // Save current mono state
        let saved_local_types = self.local_types;
        let saved_local_defs = self.local_defs;
        let saved_return_type = self.return_type;
        self.local_types = HashMap::new();
        self.local_defs = Vector::new();

        let closure_ty: &IrTy = self.ctx.void_ty;
        if has_captures {
            // Create closure type and self parameter
            closure_ty = self.ctx.arena.alloc(IrTy::mk_closure(closure_struct_ref, closure_fn_ref));
            let self_ptr_ty = self.ctx.make_ptr_ty(closure_ty, false);
            let self_param_id = expr.id(); // stored by parser
            params[0] = IrParam {
                id: self_param_id,
                ty: self_ptr_ty,
                name: "__self",
            };
            self.local_types.insert(self_param_id._value, self_ptr_ty);
        }

        let param_offset = if has_captures { 1usize } else { 0usize };
        for i in 0usize..expr.lambda_params().len() {
            let lp = &expr.lambda_params()[i];
            let param_ty = if lp.ty.is_some() {
                self.resolve_type(lp.ty.unwrap())
            } else {
                self.ctx.void_ty
            };
            params[i + param_offset] = IrParam {
                id: lp.id,
                ty: param_ty,
                name: lp.name,
            };
            param_types[i] = param_ty;
            self.local_types.insert(lp.id._value, param_ty);
        }

        // Resolve return type
        let ret_ty = if expr.opt_ty().is_some() {
            self.resolve_type(expr.opt_ty().unwrap())
        } else {
            self.ctx.void_ty
        };
        self.return_type = ret_ty;

        // Reserve index
        let idx = self.ctx.ir_functions.len();
        let placeholder = IrFunction {
            id: lambda_id,
            name: if has_captures { "closure" } else { "lambda" },
            mangled_name: mangled,
            params: params,
            return_type: ret_ty,
            body: Option::none(),
            local_defs: &[],
            attributes: &[],
            is_variadic: false,
            abi: Option::none(),
            span: expr.span,
            type_args: &[],
        };
        self.ctx.ir_functions.push(placeholder);

        // Lower body
        let body = self.lower_expr(expr.lhs());

        // Collect local defs
        let local_defs_slice = self.ctx.arena.alloc_slice_copy::<IrLocalDef>(self.local_defs.as_slice());

        self.ctx.ir_functions[idx].body = Option::some(body);
        self.ctx.ir_functions[idx].local_defs = local_defs_slice;

        // Restore mono state
        self.local_types.free();
        self.local_defs.free();
        self.local_types = saved_local_types;
        self.local_defs = saved_local_defs;
        self.return_type = saved_return_type;

        if has_captures {
            // Build a struct literal with the captured values
            let items = self.ctx.arena.alloc_slice_copy::<&IrExpr>(bound_values);
            let result = IrExpr::void_expr(closure_ty);
            result.tag = IrTag::StructLit;
            result._data.struct_lit.ir_ty = closure_ty;
            result._data.struct_lit.items = items;
            self.ctx.arena.alloc(result)
        } else {
            // No captures: return Fn type (ZST representing this lambda)
            let fn_ref = IrFnRef {
                id: lambda_id,
                mangled_name: mangled,
            };
            let fn_ty = self.ctx.make_fn_ty(fn_ref);
            let result = IrExpr::void_expr(fn_ty);
            result.tag = IrTag::FnRef;
            result._data.fn_ref = fn_ref;
            self.ctx.arena.alloc(result)
        }
    }

    fn lower_bound_value(self: &mut Mono, expr: &Expr) -> &IrExpr {
        // Access a captured variable in a closure body.
        // expr.id = binding id (used for name matching)
        // expr.id2 = self_param id (the closure struct pointer)
        // expr.str_val = binding name
        // expr.flag = is by_reference
        let self_param_id = expr.id2();

        // Get the self param type (should be &ClosureStruct)
        let self_ty_opt = self.local_types.get(&self_param_id._value);
        if !self_ty_opt.is_some() {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }
        let self_ptr_ty = self_ty_opt.unwrap();

        // Dereference: self_ptr_ty is &ClosureStruct, get the struct type
        let closure_ty = if self_ptr_ty.tag == IrTyTag::Pointer {
            self_ptr_ty.inner()
        } else {
            self_ptr_ty
        };

        if closure_ty.tag != IrTyTag::Closure {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }

        // Find the field by name
        let fields = closure_ty.struct_ref().fields;
        let field_idx = 0u32;
        let field_ty = self.ctx.void_ty;
        let found = false;
        for i in 0usize..fields.len() {
            if fields[i].name == expr.str_val() {
                field_idx = i as u32;
                field_ty = fields[i].ty;
                found = true;
            }
        }

        if !found {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            return self.ctx.arena.alloc(r);
        }

        // Build: (*self_param).field[field_idx]
        let self_local = self.mk_local(self_param_id, self_ptr_ty);
        let deref_expr = self.mk_deref(self_local, closure_ty);
        let field_expr = self.mk_field(deref_expr, field_idx, field_ty);

        if expr.flag() {
            // By reference: the field is a pointer, dereference it
            let inner_ty = if field_ty.tag == IrTyTag::Pointer {
                field_ty.inner()
            } else {
                field_ty
            };
            self.mk_deref(field_expr, inner_ty)
        } else {
            // By value: return the field directly
            field_expr
        }
    }

    fn lower_intrinsic(self: &mut Mono, name: &[u8], type_args: &[&Ty], ir_type_args: &[&IrTy], expr: &Expr) -> &IrExpr {
        mono::intrinsics::lower_intrinsic(self, name, type_args, ir_type_args, expr)
    }

    // Instantiate a generic const at a turbofish-value site: `NAME::<T1, T2, ...>`.
    // Binds the const's generic_params to the resolved type args, lowers the init
    // expression with those bindings, and for consts inlines the const-evaluated
    // value. Snapshot/restore mirrors mono_function's so nested instantiations
    // don't leak bindings into the caller.
    fn instantiate_generic_const(self: &mut Mono, def: &StaticDef, expr: &Expr) -> &IrExpr {
        // Resolve type args (with defaults for missing slots).
        let resolved = self.ctx.arena.alloc_slice::<&IrTy>(def.generic_params.len());
        for i in 0usize..def.generic_params.len() {
            if i < expr.type_args().len() {
                resolved[i] = self.resolve_type(expr.type_args()[i]);
            } else if def.generic_params[i].default_ty.is_some() {
                resolved[i] = self.resolve_type(def.generic_params[i].default_ty.unwrap());
            } else {
                resolved[i] = self.ctx.void_ty;
            }
        }

        // Snapshot the generic-param bindings we're about to overwrite so nested
        // calls in the init expr don't leave stale bindings on exit.
        let saved_vals = self.ctx.arena.alloc_slice::<&IrTy>(def.generic_params.len());
        let saved_had = self.ctx.arena.alloc_slice::<bool>(def.generic_params.len());
        for i in 0usize..def.generic_params.len() {
            let key = def.generic_params[i].id._value;
            let prev = self.type_map.get(&key);
            if prev.is_some() {
                saved_vals[i] = prev.unwrap();
                saved_had[i] = true;
            } else {
                saved_had[i] = false;
            }
            self.type_map.insert(key, resolved[i]);
        }

        // Lower the init expression. For consts, also try const-eval so the value
        // is inlined at every use site (no per-instantiation global).
        let ty = if def.ty.is_some() {
            self.resolve_type(def.ty.unwrap())
        } else {
            self.ctx.void_ty
        };
        let init_ir = if !ty.is_void() {
            self.lower_expr_coerced(def.init.unwrap(), ty)
        } else {
            self.lower_expr(def.init.unwrap())
        };
        let result = if def.is_const {
            let (cv, _panic, _warn, _note) = self.try_const_eval_with_diags(init_ir);
            if cv.is_some() {
                self.constvalue_to_ir(cv.unwrap(), init_ir.ty)
            } else {
                init_ir
            }
        } else {
            init_ir
        };

        // Restore type_map.
        for i in 0usize..def.generic_params.len() {
            let key = def.generic_params[i].id._value;
            if saved_had[i] {
                self.type_map.insert(key, saved_vals[i]);
            } else {
                self.type_map.remove(&key);
            }
        }

        result
    }

    fn lower_call(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == ExprTag::Call || expr.tag == ExprTag::TurbofishValue {
            // Check for intrinsic calls first
            if expr.lhs().tag == ExprTag::FnRef {
                let fn_def = self.ctx.fn_defs.get(&expr.lhs().id()._value);
                if fn_def.is_some() {
                    let def = fn_def.unwrap();
                    if def.abi.is_some() && def.abi.unwrap() == "intrinsic" {
                        // Resolve type args for intrinsics
                        let ir_type_args = self.ctx.arena.alloc_slice::<&IrTy>(expr.type_args().len());
                        for i in 0usize..expr.type_args().len() {
                            ir_type_args[i] = self.resolve_type(expr.type_args()[i]);
                        }
                        return self.lower_intrinsic(def.name, expr.type_args(), ir_type_args, expr);
                    }
                }
            }

            // Check for deferred call: T::method(args) where T is a generic type param
            if expr.lhs().tag == ExprTag::Defered {
                let defered_result = self.lower_defered_call(expr);
                if defered_result.is_some() {
                    return defered_result.unwrap();
                }
            }

            // Check for method call: obj.method(args)
            if expr.lhs().tag == ExprTag::FieldAccess {
                let method_result = self.try_lower_method_call(expr);
                if method_result.is_some() {
                    return method_result.unwrap();
                }
                // Fall through to normal field access (function pointer in struct field)
                // Suppress field error since method error will be reported if this also fails
                self.suppress_field_error = true;
            }

            // Turbofish-value reference to a generic const/static: `MY_CONST::<T>`.
            // Bind the const's generic_params to the resolved type args, lower
            // the init expression with those bindings, and (for consts) inline
            // the const-evaluated value. For non-generic statics the normal
            // StaticRef path handles it; we only intercept when there are
            // generic params to substitute.
            if expr.tag == ExprTag::TurbofishValue && expr.lhs().tag == ExprTag::StaticRef {
                let sd_opt = self.ctx.static_defs.get(&expr.lhs().id()._value);
                if sd_opt.is_some() && sd_opt.unwrap().generic_params.len() > 0 {
                    return self.instantiate_generic_const(sd_opt.unwrap(), expr);
                }
            }

            // Check for turbofish generic calls: func::<T>(args)
            if expr.type_args().len() > 0 && expr.lhs().tag == ExprTag::FnRef {
                // Resolve type args
                let resolved_type_args = self.ctx.arena.alloc_slice::<&IrTy>(expr.type_args().len());
                for i in 0usize..expr.type_args().len() {
                    resolved_type_args[i] = self.resolve_type(expr.type_args()[i]);
                }

                // Look up the function definition
                let fn_def = self.ctx.fn_defs.get(&expr.lhs().id()._value);
                if fn_def.is_some() {
                    let def = fn_def.unwrap();

                    // Check for #[lang(slice_new)] intrinsic
                    let is_slice_new = false;
                    for attr in def.attributes {
                        if attr.tag == AttrTag::Lang && attr.str_val() == "slice_new" {
                            is_slice_new = true;
                        }
                    }

                    if is_slice_new && expr.args().len() == 2 {
                        // #[lang(slice_new)] intrinsic: construct slice from (ptr, len)
                        let ir_ptr = self.lower_expr(expr.args()[0]);
                        let ir_len = self.lower_expr(expr.args()[1]);

                        // Build proper IrTyTag::Slice type from the pointer's element type
                        let elem_ty = if ir_ptr.ty.tag == IrTyTag::Pointer {
                            ir_ptr.ty.inner()
                        } else {
                            self.ctx.intern_builtin_ty(BuiltinType::U8)
                        };
                        let is_const = ir_ptr.ty.is_const();
                        let slice_ty = self.ctx.make_slice_ty(elem_ty, is_const);

                        let items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                        items[0] = ir_ptr;
                        items[1] = ir_len;

                        let result = IrExpr::void_expr(slice_ty);
                        result.tag = IrTag::TupleLit;
                        result._data.block.items = items;
                        return self.ctx.arena.alloc(result);
                    }

                    // If fewer explicit type args than generic params, infer the rest
                    let call_ta = resolved_type_args;
                    if resolved_type_args.len() < def.generic_params.len() {
                        let full_ta = self.ctx.arena.alloc_slice::<&IrTy>(def.generic_params.len());
                        for i in 0usize..resolved_type_args.len() {
                            full_ta[i] = resolved_type_args[i];
                        }
                        // Set up partial type map so we can resolve param types for inference
                        for i in 0usize..resolved_type_args.len() {
                            self.type_map.insert(def.generic_params[i].id._value, resolved_type_args[i]);
                        }
                        // Infer remaining from arguments
                        let inferred = self.infer_type_args(def, expr.args());
                        for i in resolved_type_args.len()..def.generic_params.len() {
                            let inf_idx = i;
                            if inf_idx < inferred.len() && !inferred[inf_idx].is_void() {
                                full_ta[i] = inferred[inf_idx];
                            } else {
                                full_ta[i] = self.ctx.void_ty;
                            }
                        }
                        call_ta = full_ta;
                    }

                    // Monomorphize the function with type args
                    let fn_idx = self.mono_function(def, call_ta);
                    let ir_fn = &self.ctx.ir_functions[fn_idx];

                    // Turbofish value (func::<T> as value): produce Fn type, not a call
                    if expr.tag == ExprTag::TurbofishValue {
                        let fn_ref = IrFnRef {
                            id: ir_fn.id,
                            mangled_name: ir_fn.mangled_name,
                        };
                        let fn_ty = self.ctx.make_fn_ty(fn_ref);
                        let result = IrExpr::void_expr(fn_ty);
                        result.tag = IrTag::FnRef;
                        result._data.fn_ref = fn_ref;
                        return self.ctx.arena.alloc(result);
                    }

                    // Lower arguments
                    let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args().len());
                    for i in 0usize..expr.args().len() {
                        if i < ir_fn.params.len() {
                            let arg = self.lower_expr_coerced(expr.args()[i], ir_fn.params[i].ty);
                            ir_args[i] = self.check_and_coerce(arg, ir_fn.params[i].ty, expr.args()[i].span);
                        } else {
                            ir_args[i] = self.lower_expr(expr.args()[i]);
                        }
                    }

                    let fn_ref = IrFnRef {
                        id: ir_fn.id,
                        mangled_name: ir_fn.mangled_name,
                    };
                    return self.mk_call(fn_ref, ir_args, ir_fn.return_type);
                }
            }

            // Handle function calls by name (ExprTag::FnRef)
            if expr.type_args().len() == 0 && expr.lhs().tag == ExprTag::FnRef {
                let fn_def = self.ctx.fn_defs.get(&expr.lhs().id()._value);
                if fn_def.is_some() {
                    let def = fn_def.unwrap();
                    if def.generic_params.len() > 0 {
                        // Check for #[lang(slice_new)] intrinsic (inferred type args path)
                        let is_slice_new = false;
                        for attr in def.attributes {
                            if attr.tag == AttrTag::Lang && attr.str_val() == "slice_new" {
                                is_slice_new = true;
                            }
                        }
                        if is_slice_new && expr.args().len() == 2 {
                            let ir_ptr = self.lower_expr(expr.args()[0]);
                            let ir_len = self.lower_expr(expr.args()[1]);
                            let elem_ty = if ir_ptr.ty.tag == IrTyTag::Pointer {
                                ir_ptr.ty.inner()
                            } else {
                                self.ctx.intern_builtin_ty(BuiltinType::U8)
                            };
                            let is_const = ir_ptr.ty.is_const();
                            let slice_ty = self.ctx.make_slice_ty(elem_ty, is_const);
                            let items = self.ctx.arena.alloc_slice::<&IrExpr>(2);
                            items[0] = ir_ptr;
                            items[1] = ir_len;
                            let result = IrExpr::void_expr(slice_ty);
                            result.tag = IrTag::TupleLit;
                            result._data.block.items = items;
                            return self.ctx.arena.alloc(result);
                        }

                        // Infer type args from argument types
                        let inferred = self.infer_type_args(def, expr.args());
                        // If the expected return type structurally matches the
                        // function's declared return type AND the call has any
                        // unsuffixed integer-style literal arg (`IntLit` /
                        // `CharLit`), prefer the expected_type's type-args
                        // over the arg-inferred ones. Without this, a bare
                        // char literal arg like `Option::some('\n')` infers
                        // T=u32 (the CharLit default), shadowing the correct
                        // T=u8 from the surrounding comparison — which is
                        // how `LineIterator::next`'s newline check silently
                        // produced "not equal" and the test_lines test
                        // looped forever / crashed. The literal-arg guard
                        // keeps the existing behavior for ordinary fn calls
                        // (e.g. `from_fn(|&i| ...)` whose closure-arg
                        // inference of `F`/`T` shouldn't be overridden by
                        // a maybe-misleading expected type).
                        let prefer_expected = false;
                        if self.expected_type != self.ctx.void_ty
                            && self.expected_type.tag == IrTyTag::Struct
                            && self.expected_type.struct_ref().type_args.len() == def.generic_params.len()
                            && def.return_type.tag == TyTag::Generic
                            && def.return_type.elems().len() == def.generic_params.len() {
                            // Check the return is a Placeholder over the same
                            // generic_param ids in the same order. Bails on
                            // anything more complex (e.g. Result<E, T>-style
                            // reordering) — those keep falling through to
                            // arg inference.
                            let shapes_match = true;
                            for ri in 0usize..def.return_type.elems().len() {
                                let el = def.return_type.elems()[ri];
                                if el.tag != TyTag::Placeholder
                                    || el.id()._value != def.generic_params[ri].id._value {
                                    shapes_match = false;
                                    break;
                                }
                            }
                            if shapes_match {
                                // Restrict to CharLit only — IntLit's existing
                                // path through lower_expr_coerced already
                                // honors expected_type for unsuffixed
                                // integers. Triggering prefer_expected for
                                // IntLit shifted from_fn's `T`-inference in
                                // ways that broke `test_from_fn`; keep that
                                // path on arg inference until needed.
                                for ai in 0usize..expr.args().len() {
                                    if expr.args()[ai].tag == ExprTag::CharLit {
                                        prefer_expected = true;
                                        break;
                                    }
                                }
                            }
                        }
                        let call_ta: &[&IrTy] = if prefer_expected {
                            self.expected_type.struct_ref().type_args
                        } else {
                            inferred
                        };
                        if call_ta.len() == 0usize && self.expected_type != self.ctx.void_ty {
                            // Try to extract type args from expected_type (e.g. Option<usize>)
                            if self.expected_type.tag == IrTyTag::Struct && self.expected_type.struct_ref().type_args.len() == def.generic_params.len() {
                                call_ta = self.expected_type.struct_ref().type_args;
                            } else if self.expected_type.tag == IrTyTag::Struct && def.generic_params.len() == 1usize {
                                // For single-generic functions returning a wrapper struct,
                                // the expected type's first type arg is probably the generic param
                                if self.expected_type.struct_ref().type_args.len() > 0usize {
                                    let ctx_ta = self.ctx.arena.alloc_slice::<&IrTy>(1usize);
                                    ctx_ta[0] = self.expected_type.struct_ref().type_args[0];
                                    call_ta = ctx_ta;
                                }
                            } else if self.expected_type.tag == IrTyTag::Slice && def.generic_params.len() == 1usize {
                                // Single-generic fns returning a slice. The placeholder
                                // can appear either as the *element* type (declared
                                // `-> &[T]` / `-> &mut [T]`, AST `TyTag::Slice` over a
                                // Placeholder) or as the *pointer* type-arg (declared
                                // `-> slice<Ptr>`, AST `TyTag::Generic` over the
                                // lang(slice) struct with Ptr as the single arg). Pick
                                // the right substitution by inspecting `def.return_type`.
                                let ctx_ta = self.ctx.arena.alloc_slice::<&IrTy>(1usize);
                                if def.return_type.tag == TyTag::Slice
                                    && def.return_type.inner().tag == TyTag::Placeholder
                                    && def.return_type.inner().id()._value == def.generic_params[0].id._value {
                                    // Declared `-> &[T]`: T is the element type.
                                    ctx_ta[0] = self.expected_type.inner();
                                } else {
                                    // Declared `-> slice<Ptr>`: Ptr = `&{const?}elem`.
                                    ctx_ta[0] = self.ctx.make_ptr_ty(self.expected_type.inner(), self.expected_type.is_const());
                                }
                                call_ta = ctx_ta;
                            }
                        }
                        if call_ta.len() > 0usize {
                            let fn_idx = self.mono_function(def, call_ta);
                            let ir_fn = &self.ctx.ir_functions[fn_idx];

                            let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args().len());
                            for i in 0usize..expr.args().len() {
                                if i < ir_fn.params.len() {
                                    let arg = self.lower_expr_coerced(expr.args()[i], ir_fn.params[i].ty);
                                    ir_args[i] = self.check_and_coerce(arg, ir_fn.params[i].ty, expr.args()[i].span);
                                } else {
                                    ir_args[i] = self.lower_expr(expr.args()[i]);
                                }
                            }

                            let fn_ref = IrFnRef {
                                id: ir_fn.id,
                                mangled_name: ir_fn.mangled_name,
                            };
                            return self.mk_call(fn_ref, ir_args, ir_fn.return_type);
                        }
                    } else {
                        // Non-generic function call: emit as CallKind::Direct
                        // For protocol methods, set up Self type from first argument
                        let self_param_opt = self.ctx.proto_method_self_id.get(&def.id._value);
                        if self_param_opt.is_some() && expr.args().len() > 0 {
                            let first_arg_ir = self.lower_expr(expr.args()[0]);
                            let self_ty = if first_arg_ir.ty.tag == IrTyTag::Pointer {
                                first_arg_ir.ty.inner()
                            } else {
                                first_arg_ir.ty
                            };
                            self.type_map.insert(self_param_opt.unwrap(), self_ty);
                        } else if self.ctx.proto_method_proto_gp_ids.get(&def.id._value).is_some()
                            && expr.lhs().tag == ExprTag::FnRef
                            && expr.lhs().id2()._value != 0usize {
                            // Static call to a mixin'd protocol method like
                            // `f64::nan()` — no receiver / first arg to infer
                            // Self from. The path resolver stashed the
                            // impl_scope_idx in id2 (set in process_mixins);
                            // look up the mixin's type-args from that scope
                            // and bind the protocol's generics.
                            let impl_scope_idx = expr.lhs().id2()._value as u32;
                            let mixin_ast_args = self.ctx.scopes.get_mixin_type_args(impl_scope_idx, def.id._value);
                            if mixin_ast_args.is_some() {
                                let ast_args = mixin_ast_args.unwrap();
                                let resolved = self.ctx.arena.alloc_slice::<&IrTy>(ast_args.len());
                                for i in 0usize..ast_args.len() {
                                    resolved[i] = self.resolve_type(ast_args[i]);
                                }
                                let _ = self.bind_proto_generics(def, resolved);
                            }
                        }
                        let fn_idx = self.mono_function(def, &[]);
                        let ir_fn = &self.ctx.ir_functions[fn_idx];

                        let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args().len());
                        for i in 0usize..expr.args().len() {
                            if i < ir_fn.params.len() {
                                let arg = self.lower_expr_coerced(expr.args()[i], ir_fn.params[i].ty);
                                ir_args[i] = self.check_and_coerce(arg, ir_fn.params[i].ty, expr.args()[i].span);
                            } else {
                                ir_args[i] = self.lower_expr(expr.args()[i]);
                            }
                        }

                        let fn_ref = IrFnRef {
                            id: ir_fn.id,
                            mangled_name: ir_fn.mangled_name,
                        };
                        return self.mk_call(fn_ref, ir_args, ir_fn.return_type);
                    }
                }
            }

            let ir_callee = self.lower_expr(expr.lhs());
            self.suppress_field_error = false;
            let ir_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args().len());
            for i in 0usize..expr.args().len() {
                ir_args[i] = self.lower_expr(expr.args()[i]);
            }

            // Determine return type from callee
            if ir_callee.ty.tag == IrTyTag::Fn {
                // Direct call through Fn type (ZST function item).
                // Match on (id, mangled_name) and break: multiple monos of the
                // same source function share `id`, so id-only matching can pick
                // up an unrelated mono's return_type.
                let fn_ref = ir_callee.ty.fn_item_ref();
                let ret_ty = self.ctx.void_ty;
                for i in 0usize..self.ctx.ir_functions.len() {
                    if self.ctx.ir_functions[i].id._value == fn_ref.id._value
                        && self.ctx.ir_functions[i].mangled_name == fn_ref.mangled_name {
                        ret_ty = self.ctx.ir_functions[i].return_type;
                        break;
                    }
                }
                self.mk_call(fn_ref, ir_args, ret_ty)
            } else if ir_callee.ty.tag == IrTyTag::FnPointer {
                // Indirect call through function pointer
                let ret_ty = ir_callee.ty.ret_ty();
                let result = IrExpr::void_expr(ret_ty);
                result.tag = IrTag::Call;
                result._data.call.call_target = IrCallTarget { tag: CallKind::Indirect, fn_ref: IrFnRef::empty(), callee: ir_callee };
                result._data.call.items = ir_args;
                self.ctx.arena.alloc(result)
            } else if ir_callee.ty.tag == IrTyTag::Closure {
                // Closure call: take &callee, get fn from closure type, prepend self arg
                let closure_ty = ir_callee.ty;
                let fn_ref = closure_ty.closure_fn();

                // Same (id, mangled_name) + break rule as above.
                let ret_ty = self.ctx.void_ty;
                for i in 0usize..self.ctx.ir_functions.len() {
                    if self.ctx.ir_functions[i].id._value == fn_ref.id._value
                        && self.ctx.ir_functions[i].mangled_name == fn_ref.mangled_name {
                        ret_ty = self.ctx.ir_functions[i].return_type;
                        break;
                    }
                }

                // Take a reference to the closure struct
                let ref_expr = self.mk_ref(ir_callee, false);

                // Build args: [&closure, arg0, arg1, ...]
                let all_args = self.ctx.arena.alloc_slice::<&IrExpr>(expr.args().len() + 1usize);
                all_args[0] = ref_expr;
                for i in 0usize..expr.args().len() {
                    all_args[i + 1usize] = ir_args[i];
                }

                self.mk_call(fn_ref, all_args, ret_ty)
            } else {
                // Not a function pointer or closure - method resolution failed
                if expr.lhs().tag == ExprTag::FieldAccess && expr.lhs().str_val().len() > 0usize {
                    // Recover the receiver's type for the error message. The
                    // FieldAccess was already lowered (into ir_callee, which
                    // is now void / not-callable); re-lower the receiver with
                    // suppress_field_error set so we don't double-emit. After
                    // auto-deref through pointer layers we have the type the
                    // method was actually looked up on.
                    let prev_suppress = self.suppress_field_error;
                    self.suppress_field_error = true;
                    let recv = self.lower_expr(expr.lhs().lhs());
                    self.suppress_field_error = prev_suppress;
                    let recv_ty = recv.ty;
                    while recv_ty.tag == IrTyTag::Pointer {
                        recv_ty = recv_ty.inner();
                    }
                    let ty_name = self.ir_type_name(recv_ty);
                    self.emit_diag(diagnostics::CodeDiagnostic::unresolved_method(expr.span, expr.lhs().str_val(), ty_name));
                } else {
                    self.emit_diag(diagnostics::CodeDiagnostic::not_callable(expr.span));
                }
                let r = IrExpr::void_expr(self.ctx.void_ty);
                self.ctx.arena.alloc(r)
            }
        } else if expr.tag == ExprTag::StructLit {
            let ir_ty = self.resolve_struct_lit_type(expr);

            if ir_ty.tag == IrTyTag::Struct && ir_ty.struct_ref().is_union {
                // Union: only lower the single initialized field
                if expr.field_inits().len() != 1 {
                    self.emit_diag(diagnostics::CodeDiagnostic::generic_error(expr.span, "union literal must initialize exactly one field"));
                    return self.ctx.arena.alloc(IrExpr::void_expr(ir_ty));
                }
                let fi = &expr.field_inits()[0];
                // Find the field type in the struct def
                let field_ty = self.ctx.void_ty;
                for j in 0usize..ir_ty.struct_ref().fields.len() {
                    if ir_ty.struct_ref().fields[j].name == fi.name {
                        field_ty = ir_ty.struct_ref().fields[j].ty;
                        break;
                    }
                }
                let ir_fields = self.ctx.arena.alloc_slice::<&IrExpr>(1);
                let field_val = self.lower_expr_coerced(fi.value, field_ty);
                ir_fields[0] = self.check_and_coerce(field_val, field_ty, fi.value.span);
                let result = IrExpr::void_expr(ir_ty);
                result.tag = IrTag::StructLit;
                result._data.struct_lit.ir_ty = ir_ty;
                result._data.struct_lit.items = ir_fields;
                return self.ctx.arena.alloc(result);
            }

            // Reorder field_inits to match struct definition order
            let num_fields = if ir_ty.tag == IrTyTag::Struct { ir_ty.struct_ref().fields.len() } else { expr.field_inits().len() };
            let ir_fields = self.ctx.arena.alloc_slice::<&IrExpr>(num_fields);
            for i in 0usize..num_fields {
                if ir_ty.tag == IrTyTag::Struct {
                    // Find the field_init matching this struct field by name
                    let def_name = ir_ty.struct_ref().fields[i].name;
                    let field_ty = ir_ty.struct_ref().fields[i].ty;
                    let found = false;
                    for j in 0usize..expr.field_inits().len() {
                        if expr.field_inits()[j].name == def_name {
                            let fv = self.lower_expr_coerced(expr.field_inits()[j].value, field_ty);
                            ir_fields[i] = self.check_and_coerce(fv, field_ty, expr.field_inits()[j].value.span);
                            found = true;
                            break;
                        }
                    }
                    if !found {
                        let fv = self.lower_expr_coerced(expr.field_inits()[i].value, field_ty);
                        ir_fields[i] = self.check_and_coerce(fv, field_ty, expr.field_inits()[i].value.span);
                    }
                } else {
                    ir_fields[i] = self.lower_expr(expr.field_inits()[i].value);
                }
            }
            let result = IrExpr::void_expr(ir_ty);
            result.tag = IrTag::StructLit;
            result._data.struct_lit.ir_ty = ir_ty;
            result._data.struct_lit.items = ir_fields;
            self.ctx.arena.alloc(result)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Lower block-like expressions: ExprTag::Block, ExprTag::Let, ExprTag::Defer
    fn check_must_use_dropped(self: &mut Mono, ir_expr: &IrExpr, span: Span) {
        if ir_expr.tag != IrTag::Call { return; }
        if ir_expr.ty.is_void() || ir_expr.ty.is_never() { return; }
        if ir_expr._data.call.call_target.tag != CallKind::Direct { return; }
        let fn_ref = ir_expr._data.call.call_target.fn_ref;
        let def_opt = self.ctx.fn_defs.get(&fn_ref.id._value);
        if def_opt.is_none() { return; }
        let def = def_opt.unwrap();
        for j in 0usize..def.attributes.len() {
            if def.attributes[j].tag == AttrTag::MustUse {
                self.emit_diag(diagnostics::CodeDiagnostic::generic_warning(
                    span, "result of #[must_use] function is dropped"));
                return;
            }
        }
    }

    fn lower_block(self: &mut Mono, expr: &Expr) -> &IrExpr {
        if expr.tag == ExprTag::Block {
            let n = expr.args().len();
            let ir_stmts = self.ctx.arena.alloc_slice::<&IrExpr>(n);
            for i in 0usize..n {
                ir_stmts[i] = self.lower_expr(expr.args()[i]);
                if i + 1 < n {
                    self.check_must_use_dropped(ir_stmts[i], expr.args()[i].span);
                }
            }
            self.mk_block(ir_stmts)
        } else if expr.tag == ExprTag::Let {
            let var_ty = if expr.opt_ty().is_some() {
                let resolved = self.resolve_type(expr.opt_ty().unwrap());
                resolved
            } else if expr.opt_expr().is_some() {
                let ir_init = self.lower_expr(expr.opt_expr().unwrap());
                let inferred = ir_init.ty;
                self.local_types.insert(expr.id()._value, inferred);
                self.local_defs.push(IrLocalDef {
                    id: expr.id(),
                    ty: inferred,
                    name: expr.str_val(),
                    span: expr.span,
                });
                return self.mk_let(expr.id(), inferred, ir_init);
            } else {
                self.ctx.void_ty
            };

            self.local_types.insert(expr.id()._value, var_ty);
            self.local_defs.push(IrLocalDef {
                id: expr.id(),
                ty: var_ty,
                name: expr.str_val(),
                span: expr.span,
            });

            if expr.opt_expr().is_some() {
                let init_val = self.lower_expr_coerced(expr.opt_expr().unwrap(), var_ty);
                let init_val = self.check_and_coerce(init_val, var_ty, expr.span);
                self.mk_let(expr.id(), var_ty, init_val)
            } else {
                self.mk_let_uninit(expr.id(), var_ty)
            }
        } else if expr.tag == ExprTag::Defer {
            let ir_inner = self.lower_expr(expr.lhs());
            let result = IrExpr::void_expr(self.ctx.void_ty);
            result.tag = IrTag::Defer;
            result._data.single.lhs = ir_inner;
            self.ctx.arena.alloc(result)
        } else {
            let r = IrExpr::void_expr(self.ctx.void_ty);
            self.ctx.arena.alloc(r)
        }
    }

    // Returns (field_idx, field_ty, found)
    fn resolve_field(self: &mut Mono, ty: &IrTy, field_name: &[u8]) -> (u32, &IrTy, bool) {
        if ty.tag == IrTyTag::Struct {
            let nf = ty.struct_ref().fields.len();
            for i in 0usize..nf {
                let fname = ty.struct_ref().fields[i].name;
                if fname.len() == field_name.len() {
                    if fname.len() == 0usize || libc::memcmp(&fname[0] as &libc::c_void, &field_name[0] as &libc::c_void, fname.len()) == 0i32 {
                        return (i as u32, ty.struct_ref().fields[i].ty, true);
                    }
                }
            }
            (0u32, self.ctx.void_ty, false)
        } else if ty.tag == IrTyTag::Pointer {
            // Auto-deref
            self.resolve_field(ty.inner(), field_name)
        } else if ty.tag == IrTyTag::Slice {
            // Slices have pseudo-fields `_ptr` and `_len` matching the names
            // used by sysroot/std/mem.alu's `slice<Ptr>` definition. The IR
            // representation is a fat pointer with SLICE_DATA_FIELD/SLICE_LEN_FIELD
            // indices.
            let usize_ty = self.ctx.intern_builtin_ty(BuiltinType::USize);
            if field_name == "_len" {
                return (SLICE_LEN_FIELD, usize_ty, true);
            }
            if field_name == "_ptr" {
                let data_ptr_ty = self.ctx.make_ptr_ty(ty.inner(), ty.is_const());
                return (SLICE_DATA_FIELD, data_ptr_ty, true);
            }
            (0u32, self.ctx.void_ty, false)
        } else {
            (0u32, self.ctx.void_ty, false)
        }
    }

    /// Autoref/autoderef: add or remove pointer indirections to match a target type.
    /// Counts pointer depth of both actual and target, then adds refs or derefs as needed.
    fn autoref(self: &mut Mono, expr: &IrExpr, target_ty: &IrTy) -> &IrExpr {
        // Count pointer depth of actual expression type
        let a: i32 = 0;
        let a_ty = expr.ty;
        while a_ty.tag == IrTyTag::Pointer {
            a = a + 1;
            a_ty = a_ty.inner();
        }
        // Count pointer depth of target type
        let b: i32 = 0;
        let b_ty = target_ty;
        while b_ty.tag == IrTyTag::Pointer {
            b = b + 1;
            b_ty = b_ty.inner();
        }
        let diff = a - b;
        if diff == 0 {
            return expr;
        }
        let result = expr;
        if diff < 0 {
            // Need to add refs
            let i = 0;
            while i < (0 - diff) {
                result = self.mk_ref(result, false);
                i = i + 1;
            }
        } else {
            // Need to deref
            let i = 0;
            while i < diff {
                result = self.mk_deref(result, result.ty.inner());
                i = i + 1;
            }
        }
        result
    }

    fn free(self: &mut Mono) {
        self.type_map.free();
        self.local_types.free();
        self.local_defs.free();
    }
}
