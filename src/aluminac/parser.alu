// Parser: converts tree-sitter parse tree to AST
//
// Two-pass approach:
// Pass 1: Walk the tree to build scopes and register all named items
// Pass 2: Walk again to fill in function bodies, type definitions, etc.

use ast::*;
use scope::*;
use diagnostics::DiagnosticContext;
use aluminac_common::arena::Arena;
use aluminac_common::node_kinds::{NodeKind, FieldKind, NODE_KINDS, NodeVisitor};
use aluminac_common::common::{child_by, children_by, NodeVisitorExt};
use tree_sitter::{Node, TSFieldId, TSTreeCursor};

use std::collections::{HashMap, Vector};
use std::option::Option;
use std::result::Result;

struct ParseError {
    message: &[u8],
    span: Span,
}

// Sentinel value for "no variadic parameter" / "not in et cetera expansion"
const NO_VARIADIC: i32 = -1i32;

struct MacroEntry {
    params: &[&[u8]],
    body: &Expr,              // Pre-parsed AST body (parsed in definition-site scope)
    source: &[u8],            // Source text for error reporting
    is_builtin: bool,
    variadic_param_idx: i32,  // NO_VARIADIC if no variadic param, otherwise index into params
    scope_idx: u32,           // Definition-site scope for nested macro resolution
}

struct ParseContext {
    arena: &mut Arena,
    scopes: &mut ScopeArena,
    id_gen: &mut IdGen,
    diag: &mut DiagnosticContext,
    source: &[u8],
    file_id: u32,
    cfg_flags: &[&[u8]],

    // Items collected during pass 1, processed in pass 2
    pending_functions: Vector<PendingFunction>,
    pending_structs: Vector<PendingStruct>,
    pending_enums: Vector<PendingEnum>,
    pending_protocols: Vector<PendingProtocol>,
    pending_type_aliases: Vector<PendingTypeAlias>,
    pending_statics: Vector<PendingStatic>,
    pending_impls: Vector<PendingImpl>,
    pending_mixins: Vector<PendingMixin>,
    pending_macros: Vector<PendingMacro>,

    // Macro definitions: name -> MacroEntry
    macro_defs: HashMap<&[u8], MacroEntry>,

    // Current macro expansion arguments (for $param substitution in old code paths)
    macro_args: HashMap<&[u8], &Expr>,

    // Variadic (et cetera) macro expansion state
    macro_variadic_name: &[u8],       // name of the variadic param (empty if none)
    macro_variadic_args: &[&Expr],    // the variadic arguments
    macro_et_cetera_idx: i32,         // -1 if not in et cetera expansion, otherwise current index

    // Macro body pre-parsing state
    in_macro_body: bool,              // true when pre-parsing a macro body
    macro_param_names: &[&[u8]],      // param names for current macro being pre-parsed
    macro_variadic_param_idx: i32,    // variadic param index during pre-parse

    // Items ready for compilation
    items: Vector<Item>,
}

struct PendingFunction {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    attributes: &[Attribute],
    is_method: bool,
    impl_generic_param_ids: &[Id],
}

struct PendingStruct {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    attributes: &[Attribute],
    is_union: bool,
}

struct PendingEnum {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    attributes: &[Attribute],
}

struct PendingProtocol {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    attributes: &[Attribute],
}

struct PendingTypeAlias {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
}

struct PendingStatic {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    attributes: &[Attribute],
    is_const: bool,
}

struct PendingMixin {
    node_start: u32,
    node_end: u32,
    impl_scope_idx: u32,     // the impl block's scope
    type_scope_idx: u32,     // the scope for resolving the protocol type ref
}

struct PendingImpl {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    target_type_scope: u32,
}

struct PendingMacro {
    node_start: u32,
    node_end: u32,
    scope_idx: u32,
    id: Id,
    name: &[u8],
    is_builtin: bool,
}

impl ParseContext {
    fn new(
        arena: &mut Arena,
        scopes: &mut ScopeArena,
        id_gen: &mut IdGen,
        diag: &mut DiagnosticContext,
        source: &[u8],
        file_id: u32,
        cfg_flags: &[&[u8]],
    ) -> ParseContext {
        ParseContext {
            arena: arena,
            scopes: scopes,
            id_gen: id_gen,
            diag: diag,
            source: source,
            file_id: file_id,
            cfg_flags: cfg_flags,
            pending_functions: Vector::new(),
            pending_structs: Vector::new(),
            pending_enums: Vector::new(),
            pending_protocols: Vector::new(),
            pending_type_aliases: Vector::new(),
            pending_statics: Vector::new(),
            pending_impls: Vector::new(),
            pending_mixins: Vector::new(),
            pending_macros: Vector::new(),
            macro_defs: HashMap::new(),
            macro_args: HashMap::new(),
            macro_variadic_name: "",
            macro_variadic_args: &[],
            macro_et_cetera_idx: NO_VARIADIC,
            in_macro_body: false,
            macro_param_names: &[],
            macro_variadic_param_idx: NO_VARIADIC,
            items: Vector::new(),
        }
    }

    fn node_text(self: &ParseContext, node: Node) -> &[u8] {
        self.source[node.start_byte() as usize..node.end_byte() as usize]
    }

    fn make_span(self: &ParseContext, node: Node) -> Span {
        Span {
            file_id: self.file_id,
            start: node.start_byte() as u32,
            end: node.end_byte() as u32,
        }
    }

    fn next_id(self: &mut ParseContext) -> Id {
        self.id_gen.next_id()
    }

    fn alloc_ty(self: &mut ParseContext, ty: Ty) -> &Ty {
        self.arena.alloc(ty) as &Ty
    }

    fn alloc_expr(self: &mut ParseContext, e: Expr) -> &Expr {
        self.arena.alloc(e) as &Expr
    }

    fn intern_str(self: &mut ParseContext, s: &[u8]) -> &[u8] {
        let buf = self.arena.alloc_slice::<u8>(s.len());
        s.copy_to_nonoverlapping(&buf[0]);
        buf
    }

    fn has_cfg(self: &ParseContext, flag: &[u8]) -> bool {
        for i in 0usize..self.cfg_flags.len() {
            let s = self.cfg_flags[i];
            if s.len() == flag.len() {
                let found = true;
                for j in 0usize..s.len() {
                    if s[j] != flag[j] {
                        found = false;
                        break;
                    }
                }
                if found {
                    return true;
                }
            }
        }
        false
    }

    fn error(self: &mut ParseContext, node: Node, message: &[u8]) {
        self.diag.error(self.make_span(node), message);
    }

    fn free(self: &mut ParseContext) {
        self.pending_functions.free();
        self.pending_structs.free();
        self.pending_enums.free();
        self.pending_protocols.free();
        self.pending_type_aliases.free();
        self.pending_statics.free();
        self.pending_impls.free();
        self.pending_mixins.free();
        self.pending_macros.free();
        self.macro_defs.free();
        self.macro_args.free();
        self.items.free();
    }
    fn collect_macro_entries(self: &mut ParseContext, names: &mut Vector<&[u8]>, entries: &mut Vector<MacroEntry>) {
        let iter = self.macro_defs.iter();
        loop {
            let item = iter.next();
            if item.is_none() { break; }
            let pair = item.unwrap();
            names.push(pair.0);
            entries.push(pair.1);
        }
    }
}

// ============================================================
// Pass 1: Scope building
// ============================================================

struct Pass1 {
    ctx: &mut ParseContext,
    current_scope: u32,
    in_container: bool,   // inside struct/enum/protocol/impl
    current_enum_id: Option<Id>,
    impl_generic_param_ids: &[Id],
    skip_item: bool,      // set by parse_attributes when #[cfg] evaluates to false
}

impl Pass1 {
    fn new(ctx: &mut ParseContext, root_scope: u32) -> Pass1 {
        Pass1 {
            ctx: ctx,
            current_scope: root_scope,
            in_container: false,
            current_enum_id: Option::none(),
            impl_generic_param_ids: &[],
            skip_item: false,
        }
    }

    fn run(self: &mut Pass1, root: Node) {
        self.visit_node(root);
    }

    fn visit_node(self: &mut Pass1, node: Node) {
        let sym = node.symbol() as usize;
        let kind = NODE_KINDS[sym];
        switch kind {
            NodeKind::SourceFile => self.visit_source_file_p1(node),
            NodeKind::ModDefinition => self.visit_mod_p1(node),
            NodeKind::FunctionDefinition => self.visit_function_p1(node),
            NodeKind::StructDefinition => self.visit_struct_p1(node),
            NodeKind::EnumDefinition => self.visit_enum_p1(node),
            NodeKind::EnumItem => self.visit_enum_item_p1(node),
            NodeKind::ProtocolDefinition => self.visit_protocol_p1(node),
            NodeKind::TypeDefinition => self.visit_type_def_p1(node),
            NodeKind::ImplBlock => self.visit_impl_p1(node),
            NodeKind::UseDeclaration => self.visit_use_p1(node),
            NodeKind::StaticDeclaration => self.visit_static_p1(node),
            NodeKind::ConstDeclaration => self.visit_const_p1(node),
            NodeKind::MacroDefinition => self.visit_macro_def_p1(node),
            NodeKind::StructField => self.visit_struct_field_p1(node),
            NodeKind::Parameter => self.visit_parameter_p1(node),
            NodeKind::GenericArgumentList => self.visit_generic_args_p1(node),
            NodeKind::ParameterList => self.visit_parameter_list_p1(node),
            NodeKind::MacroParameterList => self.visit_macro_param_list_p1(node),
            NodeKind::MacroParameter => self.visit_macro_param_p1(node),
            NodeKind::TopLevelBlock => self.visit_top_level_block_p1(node),
            NodeKind::TopLevelAttributes => {},
            NodeKind::Mixin => self.visit_mixin_p1(node),
            NodeKind::DocComment => {},
            NodeKind::FileDocComment => {},
            NodeKind::LineComment => {},
            NodeKind::BlockComment => {},
            _ => {
                // For unknown nodes, visit children
                self.visit_children(node);
            },
        }
    }

    fn visit_children(self: &mut Pass1, node: Node) {
        let cursor = node.walk();
        defer cursor.free();
        for child in node.children(&cursor) {
            self.visit_node(child);
        }
    }

    fn visit_children_by_field(self: &mut Pass1, node: Node, field: FieldKind) {
        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, field, &cursor) {
            self.visit_node(child);
        }
    }

    fn get_name(self: &mut Pass1, node: Node) -> &[u8] {
        let name_node = child_by!(node, FieldKind::Name);
        if name_node.is_none() {
            return "";
        }
        self.ctx.intern_str(self.ctx.node_text(name_node.unwrap()))
    }

    fn parse_attributes(self: &mut Pass1, node: Node) -> &[Attribute] {
        let attr_node = child_by!(node, FieldKind::Attributes);
        if attr_node.is_none() {
            return &[];
        }
        self.parse_attribute_list(attr_node.unwrap())
    }

    fn parse_attribute_list(self: &mut Pass1, node: Node) -> &[Attribute] {
        let attrs: Vector<Attribute> = Vector::new();
        defer attrs.free();

        let cursor = node.walk();
        defer cursor.free();
        for child in node.children(&cursor) {
            let kind = NODE_KINDS[child.symbol() as usize];
            if kind == NodeKind::AttributeItem {
                // attribute_item -> inner: meta_item -> name, arguments
                let inner_node = child_by!(child, FieldKind::Inner);
                if inner_node.is_none() {
                    continue;
                }
                let meta = inner_node.unwrap();
                let name_node = child_by!(meta, FieldKind::Name);
                if !name_node.is_none() {
                    let name = self.ctx.node_text(name_node.unwrap());
                    switch name {
                        "inline" => attrs.push(Attribute::inline_attr()),
                        "cold" => attrs.push(Attribute::cold()),
                        "export" => attrs.push(Attribute::export()),
                        "test" => attrs.push(Attribute::test()),
                        "thread_local" => attrs.push(Attribute::thread_local()),
                        "static_ctor" => attrs.push(Attribute::static_ctor()),
                        "always_inline" => attrs.push(Attribute::always_inline()),
                        "no_return" => attrs.push(Attribute::no_return()),
                        "builtin" => attrs.push(Attribute::builtin()),
                        "cfg" => {
                            if !self.eval_cfg_meta_item(meta) {
                                self.skip_item = true;
                            }
                        }
                        "align" => {
                            let args_node = child_by!(meta, FieldKind::Arguments);
                            if !args_node.is_none() {
                                let val_text = self.ctx.node_text(args_node.unwrap());
                                let val = parse_usize(val_text);
                                attrs.push(Attribute::align(val));
                            }
                        }
                        "link_name" => {
                            let args_node = child_by!(meta, FieldKind::Arguments);
                            if !args_node.is_none() {
                                let link_name = self.ctx.node_text(args_node.unwrap());
                                if link_name.len() >= 2 && link_name[0] == '"' as u8 {
                                    attrs.push(Attribute::extern_attr(
                                        self.ctx.intern_str(link_name[1..link_name.len()-1])
                                    ));
                                }
                            }
                        }
                        "lang" => {
                            let args_node = child_by!(meta, FieldKind::Arguments);
                            if !args_node.is_none() {
                                let lang_name = self.ctx.node_text(args_node.unwrap());
                                if lang_name.len() >= 2 && lang_name[0] == '(' as u8 && lang_name[lang_name.len() - 1] == ')' as u8 {
                                    lang_name = lang_name[1..lang_name.len() - 1];
                                }
                                attrs.push(Attribute::lang(self.ctx.intern_str(lang_name)));
                            }
                        }
                        _ => {}
                    }
                }
            }
        }

        if attrs.len() == 0 {
            return &[];
        }
        self.ctx.arena.alloc_slice_copy::<Attribute>(attrs.as_slice())
    }

    // Evaluate a cfg condition from a meta_item node.
    // For #[cfg(condition)], this is called on the inner meta_item (the one with name="cfg").
    // Returns true if the condition is satisfied.
    fn eval_cfg_meta_item(self: &mut Pass1, node: Node) -> bool {
        let kind = NODE_KINDS[node.symbol() as usize];

        // If it's a string literal (inside meta_arguments), this shouldn't happen
        // at the top level, but guard against it.
        if kind != NodeKind::MetaItem {
            return false;
        }

        let name_node = child_by!(node, FieldKind::Name);
        if name_node.is_none() {
            return false;
        }
        let name = self.ctx.node_text(name_node.unwrap());

        let args_node = child_by!(node, FieldKind::Arguments);

        // Check for key = "value" form
        let value_node = child_by!(node, FieldKind::Value);
        if !value_node.is_none() {
            // key = "value" form: check if cfg flag matches the value
            let value_text = self.ctx.node_text(value_node.unwrap());
            // Strip quotes from string literal
            if value_text.len() >= 2 && value_text[0] == '"' as u8 {
                value_text = value_text[1..value_text.len() - 1];
            }
            // Look for a cfg flag of the form "key=value"
            // Build "key=value" string and check against has_cfg
            let match_buf = self.ctx.arena.alloc_slice::<u8>(name.len() + 1 + value_text.len());
            name.copy_to_nonoverlapping(&match_buf[0]);
            match_buf[name.len()] = '=' as u8;
            value_text.copy_to_nonoverlapping(&match_buf[name.len() + 1]);
            return self.ctx.has_cfg(match_buf as &[u8]);
        }

        // Compound forms: cfg(...), not(...), all(...), any(...)
        if name == "cfg" {
            if args_node.is_none() { return false; }
            return self.eval_cfg_arguments_single(args_node.unwrap());
        } else if name == "not" {
            if args_node.is_none() { return false; }
            return !self.eval_cfg_arguments_single(args_node.unwrap());
        } else if name == "all" {
            if args_node.is_none() { return true; } // empty all() = true
            return self.eval_cfg_arguments_all(args_node.unwrap());
        } else if name == "any" {
            if args_node.is_none() { return false; } // empty any() = false
            return self.eval_cfg_arguments_any(args_node.unwrap());
        }

        // Simple flag: check presence
        if !args_node.is_none() {
            // Unknown compound form, treat as false
            return false;
        }
        self.ctx.has_cfg(name)
    }

    // Evaluate a meta_arguments node expecting exactly one argument (for cfg() and not())
    fn eval_cfg_arguments_single(self: &mut Pass1, node: Node) -> bool {
        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Argument, &cursor) {
            let kind = NODE_KINDS[child.symbol() as usize];
            if kind == NodeKind::MetaItem {
                return self.eval_cfg_meta_item(child);
            }
        }
        false
    }

    // Evaluate a meta_arguments node with AND semantics (for all())
    fn eval_cfg_arguments_all(self: &mut Pass1, node: Node) -> bool {
        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Argument, &cursor) {
            let kind = NODE_KINDS[child.symbol() as usize];
            if kind == NodeKind::MetaItem {
                if !self.eval_cfg_meta_item(child) {
                    return false;
                }
            }
        }
        true
    }

    // Evaluate a meta_arguments node with OR semantics (for any())
    fn eval_cfg_arguments_any(self: &mut Pass1, node: Node) -> bool {
        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Argument, &cursor) {
            let kind = NODE_KINDS[child.symbol() as usize];
            if kind == NodeKind::MetaItem {
                if self.eval_cfg_meta_item(child) {
                    return true;
                }
            }
        }
        false
    }

    fn visit_source_file_p1(self: &mut Pass1, node: Node) {
        self.visit_children_by_field(node, FieldKind::Body);
    }

    fn visit_top_level_block_p1(self: &mut Pass1, node: Node) {
        // Check cfg attributes on top-level blocks
        let attr_node = child_by!(node, FieldKind::Attributes);
        if !attr_node.is_none() {
            let _ = self.parse_attribute_list(attr_node.unwrap());
            if self.skip_item {
                self.skip_item = false;
                return;
            }
        }
        self.visit_children_by_field(node, FieldKind::Items);
    }

    fn visit_mod_p1(self: &mut Pass1, node: Node) {
        let name = self.get_name(node);
        let child_scope = self.ctx.scopes.create_scope(ScopeKind::Module, Option::some(self.current_scope));

        self.ctx.scopes.add_item(self.current_scope, NamedItem {
            name: name,
            kind: NamedItemKind::module(child_scope),
            span: self.ctx.make_span(node),
        });

        let prev = self.current_scope;
        self.current_scope = child_scope;
        self.visit_children_by_field(node, FieldKind::Body);
        self.current_scope = prev;
    }

    fn visit_function_p1(self: &mut Pass1, node: Node) {
        let name = self.get_name(node);
        let id = self.ctx.next_id();
        let attributes = self.parse_attributes(node);
        if self.skip_item { self.skip_item = false; return; }
        let child_scope = self.ctx.scopes.create_scope(ScopeKind::Function, Option::some(self.current_scope));

        let item_kind = if self.in_container {
            NamedItemKind::method(id, id) // simplified: both type and fn ids are the same
        } else {
            NamedItemKind::function(id)
        };

        self.ctx.scopes.add_item(self.current_scope, NamedItem {
            name: name,
            kind: item_kind,
            span: self.ctx.make_span(node),
        });

        self.ctx.pending_functions.push(PendingFunction {
            node_start: node.start_byte() as u32,
            node_end: node.end_byte() as u32,
            scope_idx: child_scope,
            id: id,
            name: name,
            attributes: attributes,
            is_method: self.in_container,
            impl_generic_param_ids: self.impl_generic_param_ids,
        });

        // Visit generic params and parameters in child scope
        let prev = self.current_scope;
        self.current_scope = child_scope;

        let type_args = child_by!(node, FieldKind::TypeArguments);
        if !type_args.is_none() {
            self.visit_node(type_args.unwrap());
        }
        self.visit_children_by_field(node, FieldKind::Parameters);

        self.current_scope = prev;
    }

    fn visit_struct_p1(self: &mut Pass1, node: Node) {
        let name = self.get_name(node);
        let id = self.ctx.next_id();
        let attributes = self.parse_attributes(node);
        if self.skip_item { self.skip_item = false; return; }

        // Check if it's a union
        let kind_node = child_by!(node, FieldKind::Kind);
        let is_union = !kind_node.is_none() && self.ctx.node_text(kind_node.unwrap()) == "union";

        let child_scope = self.ctx.scopes.create_scope(ScopeKind::Module, Option::some(self.current_scope));

        self.ctx.scopes.add_item(self.current_scope, NamedItem {
            name: name,
            kind: NamedItemKind::struct_kind_with_scope(id, child_scope),
            span: self.ctx.make_span(node),
        });

        self.ctx.pending_structs.push(PendingStruct {
            node_start: node.start_byte() as u32,
            node_end: node.end_byte() as u32,
            scope_idx: child_scope,
            id: id,
            name: name,
            attributes: attributes,
            is_union: is_union,
        });

        let prev = self.current_scope;
        self.current_scope = child_scope;

        let type_args = child_by!(node, FieldKind::TypeArguments);
        if !type_args.is_none() {
            self.visit_node(type_args.unwrap());
        }
        self.visit_children_by_field(node, FieldKind::Body);

        self.current_scope = prev;
    }

    fn visit_enum_p1(self: &mut Pass1, node: Node) {
        let name = self.get_name(node);
        let id = self.ctx.next_id();
        let attributes = self.parse_attributes(node);
        if self.skip_item { self.skip_item = false; return; }

        let child_scope = self.ctx.scopes.create_scope(ScopeKind::Module, Option::some(self.current_scope));

        self.ctx.scopes.add_item(self.current_scope, NamedItem {
            name: name,
            kind: NamedItemKind::enum_kind_with_scope(id, child_scope),
            span: self.ctx.make_span(node),
        });

        self.ctx.pending_enums.push(PendingEnum {
            node_start: node.start_byte() as u32,
            node_end: node.end_byte() as u32,
            scope_idx: child_scope,
            id: id,
            name: name,
            attributes: attributes,
        });

        let prev = self.current_scope;
        let prev_enum = self.current_enum_id;
        self.current_scope = child_scope;
        self.current_enum_id = Option::some(id);
        self.visit_children_by_field(node, FieldKind::Body);
        self.current_scope = prev;
        self.current_enum_id = prev_enum;
    }

    fn visit_enum_item_p1(self: &mut Pass1, node: Node) {
        let name = self.get_name(node);
        let variant_id = self.ctx.next_id();

        if self.current_enum_id.is_some() {
            self.ctx.scopes.add_item(self.current_scope, NamedItem {
                name: name,
                kind: NamedItemKind::enum_variant(self.current_enum_id.unwrap(), variant_id),
                span: self.ctx.make_span(node),
            });
        }
    }

    fn visit_struct_field_p1(self: &mut Pass1, node: Node) {
        // Fields are collected during pass 2
    }

    fn visit_protocol_p1(self: &mut Pass1, node: Node) {
        let name = self.get_name(node);
        let id = self.ctx.next_id();
        let attributes = self.parse_attributes(node);
        if self.skip_item { self.skip_item = false; return; }
        let child_scope = self.ctx.scopes.create_scope(ScopeKind::Protocol, Option::some(self.current_scope));

        self.ctx.scopes.add_item(self.current_scope, NamedItem {
            name: name,
            kind: NamedItemKind::protocol_with_scope(id, child_scope),
            span: self.ctx.make_span(node),
        });

        self.ctx.pending_protocols.push(PendingProtocol {
            node_start: node.start_byte() as u32,
            node_end: node.end_byte() as u32,
            scope_idx: child_scope,
            id: id,
            name: name,
            attributes: attributes,
        });

        let prev = self.current_scope;
        let prev_container = self.in_container;
        self.current_scope = child_scope;
        self.in_container = true;

        let type_args = child_by!(node, FieldKind::TypeArguments);
        if !type_args.is_none() {
            self.visit_node(type_args.unwrap());
        }
        self.visit_children_by_field(node, FieldKind::Body);

        self.current_scope = prev;
        self.in_container = prev_container;
    }

    fn visit_impl_p1(self: &mut Pass1, node: Node) {
        let _ = self.parse_attributes(node);
        if self.skip_item { self.skip_item = false; return; }
        let name = self.get_name(node);

        // Try to resolve the type to find its scope
        let resolved = self.ctx.scopes.resolve(self.current_scope, name);
        let child_scope = if resolved.is_some() {
            let item = resolved.unwrap();
            if (item.kind.tag == scope::NamedItemTag::Struct || item.kind.tag == scope::NamedItemTag::Enum) && item.kind.scope_idx != 0 {
                // Use the type's existing scope
                item.kind.scope_idx
            } else {
                self.ctx.scopes.create_scope(ScopeKind::Impl, Option::some(self.current_scope))
            }
        } else {
            self.ctx.scopes.create_scope(ScopeKind::Impl, Option::some(self.current_scope))
        };

        self.ctx.pending_impls.push(PendingImpl {
            node_start: node.start_byte() as u32,
            node_end: node.end_byte() as u32,
            scope_idx: child_scope,
            target_type_scope: self.current_scope,
        });

        let prev = self.current_scope;
        let prev_container = self.in_container;
        let prev_impl_gp = self.impl_generic_param_ids;
        self.current_scope = child_scope;
        self.in_container = true;

        let type_args = child_by!(node, FieldKind::TypeArguments);
        if !type_args.is_none() {
            // Visit to register generic params in scope
            self.visit_node(type_args.unwrap());
            // Collect the IDs of the generic params we just registered
            self.impl_generic_param_ids = self.collect_generic_param_ids(type_args.unwrap());
        } else {
            self.impl_generic_param_ids = &[];
        }
        self.visit_children_by_field(node, FieldKind::Body);

        self.current_scope = prev;
        self.in_container = prev_container;
        self.impl_generic_param_ids = prev_impl_gp;
    }

    fn visit_type_def_p1(self: &mut Pass1, node: Node) {
        let _ = self.parse_attributes(node);
        if self.skip_item { self.skip_item = false; return; }
        let name = self.get_name(node);
        let id = self.ctx.next_id();
        let child_scope = self.ctx.scopes.create_scope(ScopeKind::Function, Option::some(self.current_scope));

        self.ctx.scopes.add_item(self.current_scope, NamedItem {
            name: name,
            kind: NamedItemKind::type_alias(id),
            span: self.ctx.make_span(node),
        });

        self.ctx.pending_type_aliases.push(PendingTypeAlias {
            node_start: node.start_byte() as u32,
            node_end: node.end_byte() as u32,
            scope_idx: child_scope,
            id: id,
            name: name,
        });

        let prev = self.current_scope;
        self.current_scope = child_scope;
        let type_args = child_by!(node, FieldKind::TypeArguments);
        if !type_args.is_none() {
            self.visit_node(type_args.unwrap());
        }
        self.current_scope = prev;
    }

    fn visit_use_p1(self: &mut Pass1, node: Node) {
        let _ = self.parse_attributes(node);
        if self.skip_item { self.skip_item = false; return; }
        let arg = child_by!(node, FieldKind::Argument);
        if arg.is_none() {
            return;
        }
        self.process_use(arg.unwrap(), &[]);
    }

    fn process_use(self: &mut Pass1, node: Node, prefix: &[&[u8]]) {
        let kind = NODE_KINDS[node.symbol() as usize];
        switch kind {
            NodeKind::ScopedIdentifier => {
                // use a::b::c; - import c from path a::b
                let segments = self.collect_path_segments(node);
                if segments.len() > 0 {
                    let name = segments[segments.len() - 1];
                    self.ctx.scopes.add_item(self.current_scope, NamedItem {
                        name: name,
                        kind: NamedItemKind::use_alias(self.current_scope, segments),
                        span: self.ctx.make_span(node),
                    });
                }
            },
            NodeKind::Identifier => {
                let name = self.ctx.intern_str(self.ctx.node_text(node));
                let full_path = self.ctx.arena.alloc_slice::<&[u8]>(prefix.len() + 1);
                for i in 0usize..prefix.len() {
                    full_path[i] = prefix[i];
                }
                full_path[prefix.len()] = name;
                self.ctx.scopes.add_item(self.current_scope, NamedItem {
                    name: name,
                    kind: NamedItemKind::use_alias(self.current_scope, full_path),
                    span: self.ctx.make_span(node),
                });
            },
            NodeKind::UseWildcard => {
                // use a::*; - star import
                let path_node = child_by!(node, FieldKind::Path);
                if !path_node.is_none() {
                    let segments = self.collect_path_segments(path_node.unwrap());
                    // Resolve the module path to get its scope
                    let resolved = self.ctx.scopes.resolve_path(self.current_scope, segments);
                    if resolved.is_some() {
                        let item = resolved.unwrap();
                        if item.kind.tag == scope::NamedItemTag::Module && item.kind.scope_idx != 0 {
                            self.ctx.scopes.add_star_import(self.current_scope, item.kind.scope_idx, self.ctx.arena);
                        }
                    }
                }
            },
            NodeKind::UseAsClause => {
                let path_node = child_by!(node, FieldKind::Path);
                let alias_node = child_by!(node, FieldKind::Alias);
                if !path_node.is_none() && !alias_node.is_none() {
                    let segments = self.collect_path_segments(path_node.unwrap());
                    let alias = self.ctx.intern_str(self.ctx.node_text(alias_node.unwrap()));
                    self.ctx.scopes.add_item(self.current_scope, NamedItem {
                        name: alias,
                        kind: NamedItemKind::use_alias(self.current_scope, segments),
                        span: self.ctx.make_span(node),
                    });
                }
            },
            NodeKind::ScopedUseList => {
                let path_node = child_by!(node, FieldKind::Path);
                let new_prefix = if !path_node.is_none() {
                    self.collect_path_segments(path_node.unwrap())
                } else {
                    prefix
                };
                let list_node = child_by!(node, FieldKind::List);
                if !list_node.is_none() {
                    let cursor = list_node.unwrap().walk();
                    defer cursor.free();
                    for child in list_node.unwrap().children(&cursor) {
                        if child.is_named() {
                            self.process_use(child, new_prefix);
                        }
                    }
                }
            },
            NodeKind::UseList => {
                let cursor = node.walk();
                defer cursor.free();
                for child in node.children(&cursor) {
                    if child.is_named() {
                        self.process_use(child, prefix);
                    }
                }
            },
            _ => {},
        }
    }

    fn collect_path_segments(self: &mut Pass1, node: Node) -> &[&[u8]] {
        let segments: Vector<&[u8]> = Vector::new();
        defer segments.free();
        self.collect_path_segments_inner(node, &segments);
        self.ctx.arena.alloc_slice_copy::<&[u8]>(segments.as_slice())
    }

    fn collect_path_segments_inner(self: &mut Pass1, node: Node, segments: &mut Vector<&[u8]>) {
        let kind = NODE_KINDS[node.symbol() as usize];
        switch kind {
            NodeKind::Identifier => {
                segments.push(self.ctx.intern_str(self.ctx.node_text(node)));
            },
            NodeKind::TypeIdentifier => {
                segments.push(self.ctx.intern_str(self.ctx.node_text(node)));
            },
            NodeKind::ScopedIdentifier => {
                let path = child_by!(node, FieldKind::Path);
                if !path.is_none() {
                    self.collect_path_segments_inner(path.unwrap(), segments);
                }
                let name = child_by!(node, FieldKind::Name);
                if !name.is_none() {
                    segments.push(self.ctx.intern_str(self.ctx.node_text(name.unwrap())));
                }
            },
            NodeKind::ScopedTypeIdentifier => {
                let path = child_by!(node, FieldKind::Path);
                if !path.is_none() {
                    self.collect_path_segments_inner(path.unwrap(), segments);
                }
                let name = child_by!(node, FieldKind::Name);
                if !name.is_none() {
                    segments.push(self.ctx.intern_str(self.ctx.node_text(name.unwrap())));
                }
            },
            _ => {
                segments.push(self.ctx.intern_str(self.ctx.node_text(node)));
            },
        }
    }

    fn visit_static_p1(self: &mut Pass1, node: Node) {
        let name = self.get_name(node);
        let id = self.ctx.next_id();
        let attributes = self.parse_attributes(node);
        if self.skip_item { self.skip_item = false; return; }

        self.ctx.scopes.add_item(self.current_scope, NamedItem {
            name: name,
            kind: NamedItemKind::static_kind(id),
            span: self.ctx.make_span(node),
        });

        self.ctx.pending_statics.push(PendingStatic {
            node_start: node.start_byte() as u32,
            node_end: node.end_byte() as u32,
            scope_idx: self.current_scope,
            id: id,
            name: name,
            attributes: attributes,
            is_const: false,
        });
    }

    fn visit_const_p1(self: &mut Pass1, node: Node) {
        let name = self.get_name(node);
        let id = self.ctx.next_id();
        let attributes = self.parse_attributes(node);
        if self.skip_item { self.skip_item = false; return; }

        self.ctx.scopes.add_item(self.current_scope, NamedItem {
            name: name,
            kind: NamedItemKind::const_kind(id),
            span: self.ctx.make_span(node),
        });

        self.ctx.pending_statics.push(PendingStatic {
            node_start: node.start_byte() as u32,
            node_end: node.end_byte() as u32,
            scope_idx: self.current_scope,
            id: id,
            name: name,
            attributes: attributes,
            is_const: true,
        });
    }

    fn visit_macro_def_p1(self: &mut Pass1, node: Node) {
        let attrs = self.parse_attributes(node);
        if self.skip_item { self.skip_item = false; return; }
        let name = self.get_name(node);
        let id = self.ctx.next_id();
        let child_scope = self.ctx.scopes.create_scope(ScopeKind::Function, Option::some(self.current_scope));

        // Check for #[builtin] attribute
        let is_builtin = false;
        for i in 0usize..attrs.len() {
            if attrs[i].tag == AttrTag::Builtin {
                is_builtin = true;
            }
        }

        self.ctx.scopes.add_item(self.current_scope, NamedItem {
            name: name,
            kind: NamedItemKind::macro_kind(id),
            span: self.ctx.make_span(node),
        });

        self.ctx.pending_macros.push(PendingMacro {
            node_start: node.start_byte() as u32,
            node_end: node.end_byte() as u32,
            scope_idx: child_scope,
            id: id,
            name: name,
            is_builtin: is_builtin,
        });

        let prev = self.current_scope;
        self.current_scope = child_scope;
        self.visit_children_by_field(node, FieldKind::Parameters);
        self.current_scope = prev;
    }

    fn visit_generic_args_p1(self: &mut Pass1, node: Node) {
        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Argument, &cursor) {
            let kind = NODE_KINDS[child.symbol() as usize];
            if kind == NodeKind::GenericArgument {
                let placeholder = child_by!(child, FieldKind::Placeholder);
                if !placeholder.is_none() {
                    let name = self.ctx.intern_str(self.ctx.node_text(placeholder.unwrap()));
                    let id = self.ctx.next_id();
                    self.ctx.scopes.add_item(self.current_scope, NamedItem {
                        name: name,
                        kind: NamedItemKind::generic_param(id),
                        span: self.ctx.make_span(child),
                    });
                }
            }
        }
    }

    fn collect_generic_param_ids(self: &mut Pass1, type_args_node: Node) -> &[Id] {
        let ids: Vector<Id> = Vector::new();
        defer ids.free();

        let cursor = type_args_node.walk();
        defer cursor.free();
        for child in children_by!(type_args_node, FieldKind::Argument, &cursor) {
            let kind = NODE_KINDS[child.symbol() as usize];
            if kind == NodeKind::GenericArgument {
                let placeholder = child_by!(child, FieldKind::Placeholder);
                if !placeholder.is_none() {
                    let name = self.ctx.intern_str(self.ctx.node_text(placeholder.unwrap()));
                    let resolved = self.ctx.scopes.resolve(self.current_scope, name);
                    if resolved.is_some() && resolved.unwrap().kind.tag == scope::NamedItemTag::GenericParam {
                        ids.push(resolved.unwrap().kind.id);
                    }
                }
            }
        }

        if ids.len() == 0 {
            return &[];
        }
        self.ctx.arena.alloc_slice_copy::<Id>(ids.as_slice())
    }

    fn visit_parameter_p1(self: &mut Pass1, node: Node) {
        let name = self.get_name(node);
        let id = self.ctx.next_id();
        self.ctx.scopes.add_item(self.current_scope, NamedItem {
            name: name,
            kind: NamedItemKind::param(id),
            span: self.ctx.make_span(node),
        });
    }

    fn visit_parameter_list_p1(self: &mut Pass1, node: Node) {
        self.visit_children_by_field(node, FieldKind::Parameter);
    }

    fn visit_macro_param_list_p1(self: &mut Pass1, node: Node) {
        self.visit_children_by_field(node, FieldKind::Parameter);
    }

    fn visit_macro_param_p1(self: &mut Pass1, node: Node) {
        let name = self.get_name(node);
        let id = self.ctx.next_id();
        self.ctx.scopes.add_item(self.current_scope, NamedItem {
            name: name,
            kind: NamedItemKind::param(id),
            span: self.ctx.make_span(node),
        });
    }

    fn visit_mixin_p1(self: &mut Pass1, node: Node) {
        // Store mixin info for later expansion during mono
        self.ctx.pending_mixins.push(PendingMixin {
            node_start: node.start_byte() as u32,
            node_end: node.end_byte() as u32,
            impl_scope_idx: self.current_scope,
            type_scope_idx: self.current_scope,
        });
    }
}

// ============================================================
// Pass 2: AST construction
// ============================================================

struct Pass2 {
    ctx: &mut ParseContext,
}

impl Pass2 {
    fn new(ctx: &mut ParseContext) -> Pass2 {
        Pass2 { ctx: ctx }
    }

    fn run(self: &mut Pass2, root: Node) {
        // Process all pending items
        // For each pending function, re-find the node and parse the body
        // We store byte offsets and walk the tree to find matching nodes

        // Note: macros are collected separately via collect_macros()
        self.process_structs(root);
        self.process_enums(root);
        self.process_protocols(root);
        self.process_mixins(root);
        self.process_functions(root);
        self.process_type_aliases(root);
        self.process_statics(root);
    }

    fn process_macros(self: &mut Pass2, root: Node) {
        let mac_len = self.ctx.pending_macros.len();
        if mac_len == 0usize {
            return;
        }
        for i in 0usize..mac_len {
            let pending = &self.ctx.pending_macros[i];
            let node = self.find_node_at(root, pending.node_start, pending.node_end);

            // Parse parameter names
            let params_node = child_by!(node, FieldKind::Parameters);
            let param_names: Vector<&[u8]> = Vector::new();
            defer param_names.free();

            let variadic_idx: i32 = NO_VARIADIC;
            if !params_node.is_none() {
                let cursor = params_node.unwrap().walk();
                defer cursor.free();
                let param_idx: i32 = 0i32;
                for param in children_by!(params_node.unwrap(), FieldKind::Parameter, &cursor) {
                    let name_node = child_by!(param, FieldKind::Name);
                    if !name_node.is_none() {
                        let name_text = self.ctx.node_text(name_node.unwrap());
                        // Strip the $ prefix
                        let name = if name_text.len() > 0 && name_text[0] == '$' as u8 {
                            self.ctx.intern_str(name_text[1..])
                        } else {
                            self.ctx.intern_str(name_text)
                        };
                        param_names.push(name);
                        // Check if this param is variadic (has EtCetera child)
                        let etc = child_by!(param, FieldKind::EtCetera);
                        if !etc.is_none() {
                            variadic_idx = param_idx;
                        }
                        param_idx = param_idx + 1i32;
                    }
                }
            }

            // Get body node position
            let body_node = child_by!(node, FieldKind::Body);
            if !body_node.is_none() {
                let body = body_node.unwrap();
                let params_slice = self.ctx.arena.alloc_slice_copy::<&[u8]>(param_names.as_slice());

                // Pre-parse the macro body in definition-site scope
                let body_expr: &Expr = if !pending.is_builtin {
                    // Set up macro body pre-parsing state
                    let prev_in_macro_body = self.ctx.in_macro_body;
                    let prev_param_names = self.ctx.macro_param_names;
                    let prev_variadic_idx = self.ctx.macro_variadic_param_idx;
                    self.ctx.in_macro_body = true;
                    self.ctx.macro_param_names = params_slice;
                    self.ctx.macro_variadic_param_idx = variadic_idx;

                    let expr_parser = ExprParser::new(self.ctx, pending.scope_idx);
                    let parsed = expr_parser.parse_expr(body);

                    // Restore state
                    self.ctx.in_macro_body = prev_in_macro_body;
                    self.ctx.macro_param_names = prev_param_names;
                    self.ctx.macro_variadic_param_idx = prev_variadic_idx;
                    parsed
                } else {
                    // Builtin macros don't need pre-parsed bodies
                    std::mem::zeroed::<&Expr>()
                };

                let entry = MacroEntry {
                    params: params_slice,
                    body: body_expr,
                    source: self.ctx.source,
                    is_builtin: pending.is_builtin,
                    variadic_param_idx: variadic_idx,
                    scope_idx: pending.scope_idx,
                };
                self.ctx.macro_defs.insert(pending.name, entry);
            }
        }
    }

    fn find_node_at(self: &Pass2, root: Node, start: u32, end: u32) -> Node {
        // Find a node by its byte range
        let cursor = root.walk();
        defer cursor.free();
        // Try to navigate to the right position
        if cursor.goto_first_child_for_byte(start as usize).is_some() {
            let node = cursor.node();
            if node.start_byte() as u32 == start && node.end_byte() as u32 == end {
                return node;
            }
            // Try children
            return self.find_node_at(node, start, end);
        }
        root
    }

    fn process_functions(self: &mut Pass2, root: Node) {
        for i in 0usize..self.ctx.pending_functions.len() {
            let pending = &self.ctx.pending_functions[i];
            let node = self.find_node_at(root, pending.node_start, pending.node_end);
            self.build_function(node, pending);
        }
    }

    fn build_function(self: &mut Pass2, node: Node, pending: &PendingFunction) {
        // Parse generic parameters
        let fn_generic_params = self.parse_generic_params(node, pending.scope_idx);

        // Prepend impl generic params if this is a method in a generic impl
        let generic_params = if pending.impl_generic_param_ids.len() > 0 {
            let impl_count = pending.impl_generic_param_ids.len();
            let total = impl_count + fn_generic_params.len();
            let combined = self.ctx.arena.alloc_slice::<GenericParam>(total);
            for i in 0usize..impl_count {
                combined[i] = GenericParam {
                    id: pending.impl_generic_param_ids[i],
                    name: "_impl_generic",
                    bounds: &[],
                    default_ty: Option::none(),
                };
            }
            for i in 0usize..fn_generic_params.len() {
                combined[impl_count + i] = fn_generic_params[i];
            }
            combined as &[GenericParam]
        } else {
            fn_generic_params
        };

        // Parse parameters
        let params = self.parse_fn_params(node, pending.scope_idx);

        // Parse return type
        let return_type = self.parse_return_type(node, pending.scope_idx);

        // Parse ABI
        let extern_node = child_by!(node, FieldKind::Extern);
        let abi: Option<&[u8]> = if !extern_node.is_none() {
            // Check for explicit ABI string (e.g., extern "C", extern "intrinsic")
            let abi_node = child_by!(node, FieldKind::Abi);
            if !abi_node.is_none() {
                let abi_text = self.ctx.node_text(abi_node.unwrap());
                // Strip quotes from string literal
                if abi_text.len() >= 2 && abi_text[0] == '"' as u8 {
                    Option::some(self.ctx.intern_str(abi_text[1..abi_text.len()-1]))
                } else {
                    Option::some("C")
                }
            } else {
                // Just `extern fn` with no ABI string - default to "C"
                Option::some("C")
            }
        } else {
            Option::none()
        };

        // Check variadic
        let is_variadic = !child_by!(node, FieldKind::EtCetera).is_none();

        // Parse body
        let body_node = child_by!(node, FieldKind::Body);
        let body: Option<&Expr> = if !body_node.is_none() {
            let expr_parser = ExprParser::new(self.ctx, pending.scope_idx);
            Option::some(expr_parser.parse_expr(body_node.unwrap()))
        } else {
            Option::none()
        };

        // Tag "main" functions with AttrTag::Main
        let attributes = if pending.name == "main" && body.is_some() {
            let new_attrs = self.ctx.arena.alloc_slice::<Attribute>(pending.attributes.len() + 1);
            for ai in 0usize..pending.attributes.len() {
                new_attrs[ai] = pending.attributes[ai];
            }
            new_attrs[pending.attributes.len()] = Attribute::main_attr();
            new_attrs as &[Attribute]
        } else {
            pending.attributes
        };

        let fn_def = FnDef {
            id: pending.id,
            name: pending.name,
            generic_params: generic_params,
            params: params,
            return_type: return_type,
            body: body,
            attributes: attributes,
            is_variadic: is_variadic,
            abi: abi,
        };

        let item = std::mem::zeroed::<Item>();
        item.tag = ItemTag::Function;
        item.span = Span { file_id: self.ctx.file_id, start: node.start_byte() as u32, end: node.end_byte() as u32 };
        item.fn_def = fn_def;
        self.ctx.items.push(item);
    }

    fn parse_generic_params(self: &mut Pass2, node: Node, scope_idx: u32) -> &[GenericParam] {
        let type_args = child_by!(node, FieldKind::TypeArguments);
        if type_args.is_none() {
            return &[];
        }

        let params: Vector<GenericParam> = Vector::new();
        defer params.free();

        let cursor = type_args.unwrap().walk();
        defer cursor.free();
        for arg in children_by!(type_args.unwrap(), FieldKind::Argument, &cursor) {
            let kind = NODE_KINDS[arg.symbol() as usize];
            if kind == NodeKind::GenericArgument {
                let placeholder = child_by!(arg, FieldKind::Placeholder);
                if !placeholder.is_none() {
                    let name = self.ctx.intern_str(self.ctx.node_text(placeholder.unwrap()));
                    // Reuse the ID from Pass1's scope registration
                    let resolved = self.ctx.scopes.resolve(scope_idx, name);
                    let id = if resolved.is_some() && resolved.unwrap().kind.tag == scope::NamedItemTag::GenericParam {
                        resolved.unwrap().kind.id
                    } else {
                        self.ctx.next_id()
                    };

                    // Parse bounds
                    let bounds = self.parse_generic_bounds(arg, scope_idx);

                    // Parse default
                    let default_node = child_by!(arg, FieldKind::Default);
                    let default_ty: Option<&Ty> = if !default_node.is_none() {
                        Option::some(self.parse_type(default_node.unwrap(), scope_idx))
                    } else {
                        Option::none()
                    };

                    params.push(GenericParam {
                        id: id,
                        name: name,
                        bounds: bounds,
                        default_ty: default_ty,
                    });
                }
            }
        }

        if params.len() == 0 {
            return &[];
        }
        self.ctx.arena.alloc_slice_copy::<GenericParam>(params.as_slice())
    }

    fn parse_generic_bounds(self: &mut Pass2, node: Node, scope_idx: u32) -> &[&Ty] {
        let bound_node = child_by!(node, FieldKind::Bound);
        if bound_node.is_none() {
            return &[];
        }

        let bounds: Vector<&Ty> = Vector::new();
        defer bounds.free();

        // A bound can be a single protocol or multiple with +
        let cursor = bound_node.unwrap().walk();
        defer cursor.free();
        for child in bound_node.unwrap().children(&cursor) {
            if child.is_named() {
                bounds.push(self.parse_type(child, scope_idx));
            }
        }

        if bounds.len() == 0 {
            // Single bound
            bounds.push(self.parse_type(bound_node.unwrap(), scope_idx));
        }

        self.ctx.arena.alloc_slice_copy::<&Ty>(bounds.as_slice())
    }

    fn parse_fn_params(self: &mut Pass2, node: Node, scope_idx: u32) -> &[FnParam] {
        let params_node = child_by!(node, FieldKind::Parameters);
        if params_node.is_none() {
            return &[];
        }

        let params: Vector<FnParam> = Vector::new();
        defer params.free();

        let cursor = params_node.unwrap().walk();
        defer cursor.free();
        for param in children_by!(params_node.unwrap(), FieldKind::Parameter, &cursor) {
            let name = self.ctx.intern_str(self.ctx.node_text(child_by!(param, FieldKind::Name).unwrap()));
            let type_node = child_by!(param, FieldKind::Type);
            let ty = if !type_node.is_none() {
                self.parse_type(type_node.unwrap(), scope_idx)
            } else {
                self.ctx.alloc_ty(Ty::unresolved())
            };

            // Look up the param ID from scope (registered in Pass1)
            let scope_item = self.ctx.scopes.resolve(scope_idx, name);
            let param_id = if scope_item.is_some() {
                scope_item.unwrap().kind.id
            } else {
                self.ctx.next_id()
            };

            params.push(FnParam {
                id: param_id,
                name: name,
                ty: ty,
            });
        }

        self.ctx.arena.alloc_slice_copy::<FnParam>(params.as_slice())
    }

    fn parse_return_type(self: &mut Pass2, node: Node, scope_idx: u32) -> &Ty {
        let ret_node = child_by!(node, FieldKind::ReturnType);
        if ret_node.is_none() {
            return self.ctx.alloc_ty(Ty::void_ty());
        }
        let unwrapped = ret_node.unwrap();
        let result = self.parse_type(unwrapped, scope_idx);
        result
    }

    fn parse_type(self: &mut Pass2, node: Node, scope_idx: u32) -> &Ty {
        let kind = NODE_KINDS[node.symbol() as usize];
        switch kind {
            NodeKind::PrimitiveType => {
                let text = self.ctx.node_text(node);
                let builtin = parse_builtin_type(text);
                if builtin.is_some() {
                    let ty = Ty::builtin_ty(builtin.unwrap());
                    let result = self.ctx.alloc_ty(ty);
                    return result;
                }
                // Unknown primitive
                self.ctx.alloc_ty(Ty::unresolved())
            },
            NodeKind::TypeIdentifier => {
                let name = self.ctx.node_text(node);
                // Try to resolve as builtin first
                let builtin = parse_builtin_type(name);
                if builtin.is_some() {
                    return self.ctx.alloc_ty(Ty::builtin_ty(builtin.unwrap()));
                }
                // Look up in scope
                let resolved = self.ctx.scopes.resolve(scope_idx, name);
                if resolved.is_some() {
                    let item = resolved.unwrap();
                    if item.kind.tag == scope::NamedItemTag::Struct {
                        let id = item.kind.id;
                        return self.ctx.alloc_ty(Ty::named(id));
                    } else if item.kind.tag == scope::NamedItemTag::Enum {
                        let id = item.kind.id;
                        return self.ctx.alloc_ty(Ty::named(id));
                    } else if item.kind.tag == scope::NamedItemTag::Protocol {
                        let id = item.kind.id;
                        return self.ctx.alloc_ty(Ty::named(id));
                    } else if item.kind.tag == scope::NamedItemTag::TypeAlias {
                        let id = item.kind.id;
                        return self.ctx.alloc_ty(Ty::named(id));
                    } else if item.kind.tag == scope::NamedItemTag::GenericParam {
                        let id = item.kind.id;
                        return self.ctx.alloc_ty(Ty::placeholder(id));
                    } else if item.kind.tag == scope::NamedItemTag::BuiltinType {
                        let bt = item.kind.builtin;
                        return self.ctx.alloc_ty(Ty::builtin_ty(bt));
                    }
                }
                self.ctx.alloc_ty(Ty::unresolved())
            },
            NodeKind::PointerOf => {
                let inner = child_by!(node, FieldKind::Inner);
                let is_mut = !child_by!(node, FieldKind::Mut).is_none();
                if !inner.is_none() {
                    let inner_ty = self.parse_type(inner.unwrap(), scope_idx);
                    return self.ctx.alloc_ty(Ty::pointer_ty(inner_ty, !is_mut));
                }
                self.ctx.alloc_ty(Ty::unresolved())
            },
            NodeKind::SliceOf => {
                let inner = child_by!(node, FieldKind::Inner);
                let is_mut = !child_by!(node, FieldKind::Mut).is_none();
                if !inner.is_none() {
                    let inner_ty = self.parse_type(inner.unwrap(), scope_idx);
                    return self.ctx.alloc_ty(Ty::slice_ty(inner_ty, !is_mut));
                }
                self.ctx.alloc_ty(Ty::unresolved())
            },
            NodeKind::ArrayOf => {
                let inner = child_by!(node, FieldKind::Inner);
                let size_node = child_by!(node, FieldKind::Size);
                if !inner.is_none() && !size_node.is_none() {
                    let inner_ty = self.parse_type(inner.unwrap(), scope_idx);
                    // Parse size as expression for const evaluation
                    let expr_parser = ExprParser::new(self.ctx, scope_idx);
                    let size_expr = expr_parser.parse_expr(size_node.unwrap());
                    let ty = Ty::default();
                    ty.tag = TyTag::Array;
                    ty.inner = inner_ty;
                    ty.typeof_expr = size_expr;
                    return self.ctx.alloc_ty(ty);
                }
                self.ctx.alloc_ty(Ty::unresolved())
            },
            NodeKind::TupleType => {
                let elems: Vector<&Ty> = Vector::new();
                defer elems.free();
                let cursor = node.walk();
                defer cursor.free();
                for child in children_by!(node, FieldKind::Element, &cursor) {
                    elems.push(self.parse_type(child, scope_idx));
                }
                self.ctx.alloc_ty(Ty::tuple_ty(self.ctx.arena.alloc_slice_copy::<&Ty>(elems.as_slice())))
            },
            NodeKind::NeverType => {
                self.ctx.alloc_ty(Ty::never_ty())
            },
            NodeKind::FunctionPointer => {
                let params_node = child_by!(node, FieldKind::Parameters);
                let ret_node = child_by!(node, FieldKind::ReturnType);

                let param_types: Vector<&Ty> = Vector::new();
                defer param_types.free();
                if !params_node.is_none() {
                    let cursor = params_node.unwrap().walk();
                    defer cursor.free();
                    for child in params_node.unwrap().children(&cursor) {
                        if child.is_named() {
                            param_types.push(self.parse_type(child, scope_idx));
                        }
                    }
                }
                let ret: &Ty = if !ret_node.is_none() {
                    self.parse_type(ret_node.unwrap(), scope_idx)
                } else {
                    self.ctx.alloc_ty(Ty::void_ty()) as &Ty
                };

                self.ctx.alloc_ty(Ty::fn_pointer_ty(self.ctx.arena.alloc_slice_copy::<&Ty>(param_types.as_slice()), ret))
            },
            NodeKind::GenericType => {
                let base_node = child_by!(node, FieldKind::Type);
                let args_node = child_by!(node, FieldKind::TypeArguments);
                if !base_node.is_none() && !args_node.is_none() {
                    let base = self.parse_type(base_node.unwrap(), scope_idx);
                    let type_args = self.parse_type_args(args_node.unwrap(), scope_idx);
                    return self.ctx.alloc_ty(Ty::generic_ty(base, type_args));
                }
                self.ctx.alloc_ty(Ty::unresolved())
            },
            NodeKind::ScopedTypeIdentifier => {
                // Qualified type like std::io::File
                let segments = self.collect_type_path_segments(node);
                let resolved = self.ctx.scopes.resolve_path(scope_idx, segments);
                if resolved.is_some() {
                    let item = resolved.unwrap();
                    if item.kind.tag == scope::NamedItemTag::Struct {
                        let id = item.kind.id;
                        return self.ctx.alloc_ty(Ty::named(id));
                    } else if item.kind.tag == scope::NamedItemTag::Enum {
                        let id = item.kind.id;
                        return self.ctx.alloc_ty(Ty::named(id));
                    } else if item.kind.tag == scope::NamedItemTag::Protocol {
                        let id = item.kind.id;
                        return self.ctx.alloc_ty(Ty::named(id));
                    } else if item.kind.tag == scope::NamedItemTag::TypeAlias {
                        let id = item.kind.id;
                        return self.ctx.alloc_ty(Ty::named(id));
                    }
                }
                self.ctx.alloc_ty(Ty::unresolved())
            },
            NodeKind::GenericTypeWithTurbofish => {
                // Pair::<A, B> syntax - same as GenericType but with ::
                let base_node = child_by!(node, FieldKind::Type);
                let args_node = child_by!(node, FieldKind::TypeArguments);
                if !base_node.is_none() && !args_node.is_none() {
                    let base = self.parse_type(base_node.unwrap(), scope_idx);
                    let type_args = self.parse_type_args(args_node.unwrap(), scope_idx);
                    return self.ctx.alloc_ty(Ty::generic_ty(base, type_args));
                }
                self.ctx.alloc_ty(Ty::unresolved())
            },
            NodeKind::TypeOf => {
                // typeof(expr)
                let inner = child_by!(node, FieldKind::Inner);
                if !inner.is_none() {
                    let expr_parser = ExprParser::new(self.ctx, scope_idx);
                    let expr = expr_parser.parse_expr(inner.unwrap());
                    let ty = Ty::default();
                    ty.tag = TyTag::Typeof;
                    ty.typeof_expr = expr;
                    return self.ctx.alloc_ty(ty);
                }
                self.ctx.alloc_ty(Ty::unresolved())
            },
            NodeKind::WhenType => {
                // when cond { TypeA } else { TypeB }
                let cond_node = child_by!(node, FieldKind::Condition);
                let then_node = child_by!(node, FieldKind::Consequence);
                let else_node = child_by!(node, FieldKind::Alternative);
                if !cond_node.is_none() && !then_node.is_none() && !else_node.is_none() {
                    let expr_parser = ExprParser::new(self.ctx, scope_idx);
                    let cond_expr = expr_parser.parse_expr(cond_node.unwrap());
                    let then_ty = self.parse_type(then_node.unwrap(), scope_idx);
                    let else_ty = self.parse_type(else_node.unwrap(), scope_idx);
                    return self.ctx.alloc_ty(Ty::when_ty(cond_expr, then_ty, else_ty));
                }
                self.ctx.alloc_ty(Ty::unresolved())
            },
            NodeKind::MacroIdentifier => {
                // $T in macro body - look up in macro_args as a type
                let text = self.ctx.node_text(node);
                let name = if text.len() > 0 && text[0] == '$' as u8 {
                    self.ctx.intern_str(text[1..])
                } else {
                    self.ctx.intern_str(text)
                };

                // When pre-parsing macro body, create TyTag::Typeof(ExprTag::MacroParam)
                if self.ctx.in_macro_body {
                    let param_idx: i32 = -1i32;
                    for pi in 0usize..self.ctx.macro_param_names.len() {
                        if self.ctx.macro_param_names[pi] == name {
                            param_idx = pi as i32;
                            break;
                        }
                    }
                    if param_idx >= 0i32 {
                        let param_expr = Expr::void_expr();
                        param_expr.tag = ExprTag::MacroParam;
                        param_expr.str_val = name;
                        param_expr.int_val = param_idx as u64;
                        param_expr.flag = (param_idx == self.ctx.macro_variadic_param_idx);
                        let ty = Ty::default();
                        ty.tag = TyTag::Typeof;
                        ty.typeof_expr = self.ctx.alloc_expr(param_expr);
                        return self.ctx.alloc_ty(ty);
                    }
                    return self.ctx.alloc_ty(Ty::unresolved());
                }

                let arg = self.ctx.macro_args.get(&name);
                if arg.is_some() {
                    // The macro arg is an Expr, but we need a Ty
                    // If it's a named ref, extract the type
                    let expr = arg.unwrap();
                    if expr.ty as &void as usize != 0usize {
                        return expr.ty;
                    }
                }
                self.ctx.alloc_ty(Ty::unresolved())
            },
            NodeKind::Identifier => {
                // Plain identifier used as a type (e.g. in macro expansion)
                let name = self.ctx.node_text(node);
                let builtin = parse_builtin_type(name);
                if builtin.is_some() {
                    return self.ctx.alloc_ty(Ty::builtin_ty(builtin.unwrap()));
                }
                let resolved = self.ctx.scopes.resolve(scope_idx, name);
                if resolved.is_some() {
                    let item = resolved.unwrap();
                    if item.kind.tag == scope::NamedItemTag::Struct {
                        return self.ctx.alloc_ty(Ty::named(item.kind.id));
                    } else if item.kind.tag == scope::NamedItemTag::Enum {
                        return self.ctx.alloc_ty(Ty::named(item.kind.id));
                    } else if item.kind.tag == scope::NamedItemTag::GenericParam {
                        return self.ctx.alloc_ty(Ty::placeholder(item.kind.id));
                    } else if item.kind.tag == scope::NamedItemTag::BuiltinType {
                        return self.ctx.alloc_ty(Ty::builtin_ty(item.kind.builtin));
                    } else if item.kind.tag == scope::NamedItemTag::TypeAlias {
                        return self.ctx.alloc_ty(Ty::named(item.kind.id));
                    }
                }
                self.ctx.alloc_ty(Ty::unresolved())
            },
            _ => {
                // Fall back: unhandled type node kind
                self.ctx.alloc_ty(Ty::unresolved())
            },
        }
    }

    fn parse_type_args(self: &mut Pass2, node: Node, scope_idx: u32) -> &[&Ty] {
        let args: Vector<&Ty> = Vector::new();
        defer args.free();

        let cursor = node.walk();
        defer cursor.free();
        for child in node.children(&cursor) {
            if child.is_named() {
                args.push(self.parse_type(child, scope_idx));
            }
        }

        self.ctx.arena.alloc_slice_copy::<&Ty>(args.as_slice())
    }

    fn collect_type_path_segments(self: &mut Pass2, node: Node) -> &[&[u8]] {
        let segments: Vector<&[u8]> = Vector::new();
        defer segments.free();
        self.collect_type_path_inner(node, &segments);
        self.ctx.arena.alloc_slice_copy::<&[u8]>(segments.as_slice())
    }

    fn collect_type_path_inner(self: &mut Pass2, node: Node, segments: &mut Vector<&[u8]>) {
        let kind = NODE_KINDS[node.symbol() as usize];
        switch kind {
            NodeKind::Identifier => {
                segments.push(self.ctx.intern_str(self.ctx.node_text(node)));
            },
            NodeKind::TypeIdentifier => {
                segments.push(self.ctx.intern_str(self.ctx.node_text(node)));
            },
            NodeKind::ScopedTypeIdentifier => {
                let path = child_by!(node, FieldKind::Path);
                if !path.is_none() {
                    self.collect_type_path_inner(path.unwrap(), segments);
                }
                let name = child_by!(node, FieldKind::Name);
                if !name.is_none() {
                    segments.push(self.ctx.intern_str(self.ctx.node_text(name.unwrap())));
                }
            },
            NodeKind::ScopedIdentifier => {
                let path = child_by!(node, FieldKind::Path);
                if !path.is_none() {
                    self.collect_type_path_inner(path.unwrap(), segments);
                }
                let name = child_by!(node, FieldKind::Name);
                if !name.is_none() {
                    segments.push(self.ctx.intern_str(self.ctx.node_text(name.unwrap())));
                }
            },
            NodeKind::GenericTypeWithTurbofish => {
                // Extract just the type name, ignoring type arguments
                let inner_type = child_by!(node, FieldKind::Type);
                if !inner_type.is_none() {
                    self.collect_type_path_inner(inner_type.unwrap(), segments);
                }
            },
            NodeKind::GenericType => {
                // GenericType can be aliased from GenericTypeWithTurbofish
                let inner_type = child_by!(node, FieldKind::Type);
                if !inner_type.is_none() {
                    self.collect_type_path_inner(inner_type.unwrap(), segments);
                }
            },
            NodeKind::Turbofish => {
                // Extract just the function name, ignoring type arguments
                let inner_fn = child_by!(node, FieldKind::Function);
                if !inner_fn.is_none() {
                    self.collect_type_path_inner(inner_fn.unwrap(), segments);
                }
            },
            _ => {
                segments.push(self.ctx.intern_str(self.ctx.node_text(node)));
            },
        }
    }

    fn process_structs(self: &mut Pass2, root: Node) {
        for i in 0usize..self.ctx.pending_structs.len() {
            let pending = &self.ctx.pending_structs[i];
            let node = self.find_node_at(root, pending.node_start, pending.node_end);
            self.build_struct(node, pending);
        }
    }

    fn build_struct(self: &mut Pass2, node: Node, pending: &PendingStruct) {
        let generic_params = self.parse_generic_params(node, pending.scope_idx);

        // Parse fields
        let fields: Vector<StructField> = Vector::new();
        defer fields.free();

        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Body, &cursor) {
            let kind = NODE_KINDS[child.symbol() as usize];
            if kind == NodeKind::StructField {
                let name = self.ctx.intern_str(self.ctx.node_text(child_by!(child, FieldKind::Name).unwrap()));
                let type_node = child_by!(child, FieldKind::Type);
                let ty = if !type_node.is_none() {
                    self.parse_type(type_node.unwrap(), pending.scope_idx)
                } else {
                    self.ctx.alloc_ty(Ty::unresolved())
                };
                fields.push(StructField {
                    id: self.ctx.next_id(),
                    name: name,
                    ty: ty,
                });
            }
        }

        let fields_slice = self.ctx.arena.alloc_slice_copy::<StructField>(fields.as_slice());

        let item = std::mem::zeroed::<Item>();
        item.tag = ItemTag::Struct;
        item.span = Span { file_id: self.ctx.file_id, start: node.start_byte() as u32, end: node.end_byte() as u32 };
        item.struct_def = StructDef {
            id: pending.id,
            name: pending.name,
            generic_params: generic_params,
            fields: fields_slice,
            attributes: pending.attributes,
            is_union: pending.is_union,
            scope_idx: pending.scope_idx,
        };
        self.ctx.items.push(item);
    }

    fn process_enums(self: &mut Pass2, root: Node) {
        for i in 0usize..self.ctx.pending_enums.len() {
            let pending = &self.ctx.pending_enums[i];
            let node = self.find_node_at(root, pending.node_start, pending.node_end);
            self.build_enum(node, pending);
        }
    }

    fn build_enum(self: &mut Pass2, node: Node, pending: &PendingEnum) {
        let variants: Vector<EnumVariant> = Vector::new();
        defer variants.free();

        // Check for underlying type
        let type_node = child_by!(node, FieldKind::Type);
        let underlying: Option<&Ty> = if !type_node.is_none() {
            Option::some(self.parse_type(type_node.unwrap(), pending.scope_idx))
        } else {
            Option::none()
        };

        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Body, &cursor) {
            let kind = NODE_KINDS[child.symbol() as usize];
            if kind == NodeKind::EnumItem {
                let name = self.ctx.intern_str(self.ctx.node_text(child_by!(child, FieldKind::Name).unwrap()));
                let value_node = child_by!(child, FieldKind::Value);
                let value: Option<&Expr> = if !value_node.is_none() {
                    let expr_parser = ExprParser::new(self.ctx, pending.scope_idx);
                    Option::some(expr_parser.parse_expr(value_node.unwrap()))
                } else {
                    Option::none()
                };
                // Look up the variant ID from scope (registered in pass1)
                let scope_item = self.ctx.scopes.resolve(pending.scope_idx, name);
                let variant_id = if scope_item.is_some() && scope_item.unwrap().kind.tag == scope::NamedItemTag::EnumVariant {
                    scope_item.unwrap().kind.id2
                } else {
                    self.ctx.next_id()
                };
                variants.push(EnumVariant {
                    id: variant_id,
                    name: name,
                    value: value,
                });
            }
        }

        let variants_slice = self.ctx.arena.alloc_slice_copy::<EnumVariant>(variants.as_slice());

        let item = std::mem::zeroed::<Item>();
        item.tag = ItemTag::Enum;
        item.span = Span { file_id: self.ctx.file_id, start: node.start_byte() as u32, end: node.end_byte() as u32 };
        item.enum_def = EnumDef {
            id: pending.id,
            name: pending.name,
            underlying_type: underlying,
            variants: variants_slice,
            attributes: pending.attributes,
            scope_idx: pending.scope_idx,
        };
        self.ctx.items.push(item);
    }

    fn process_protocols(self: &mut Pass2, root: Node) {
        for i in 0usize..self.ctx.pending_protocols.len() {
            let pending = &self.ctx.pending_protocols[i];
            let node = self.find_node_at(root, pending.node_start, pending.node_end);
            self.build_protocol(node, pending);
        }
    }

    fn build_protocol(self: &mut Pass2, node: Node, pending: &PendingProtocol) {
        let generic_params = self.parse_generic_params(node, pending.scope_idx);

        // Protocol methods are accessible via the protocol's scope.
        // We collect them by walking the node body and parsing function signatures.
        let methods: Vector<FnDef> = Vector::new();
        defer methods.free();

        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Body, &cursor) {
            let kind = NODE_KINDS[child.symbol() as usize];
            if kind == NodeKind::FunctionDefinition {
                let fn_name_node = child_by!(child, FieldKind::Name);
                if fn_name_node.is_none() { continue; }
                let fn_name = self.ctx.intern_str(self.ctx.node_text(fn_name_node.unwrap()));
                let fn_generic_params = self.parse_generic_params(child, pending.scope_idx);
                let fn_params = self.parse_fn_params(child, pending.scope_idx);
                let fn_ret = self.parse_return_type(child, pending.scope_idx);

                // Look up the fn ID from the protocol's scope
                let scope_item = self.ctx.scopes.resolve(pending.scope_idx, fn_name);
                let fn_id = if scope_item.is_some() {
                    scope_item.unwrap().kind.id
                } else {
                    self.ctx.next_id()
                };

                // Parse optional body (default method implementation)
                let fn_body_node = child_by!(child, FieldKind::Body);
                let fn_body: Option<&Expr> = if !fn_body_node.is_none() {
                    let expr_parser = ExprParser::new(self.ctx, pending.scope_idx);
                    Option::some(expr_parser.parse_expr(fn_body_node.unwrap()))
                } else {
                    Option::none()
                };

                methods.push(FnDef {
                    id: fn_id,
                    name: fn_name,
                    generic_params: fn_generic_params,
                    params: fn_params,
                    return_type: fn_ret,
                    body: fn_body,
                    attributes: &[],
                    is_variadic: false,
                    abi: Option::none(),
                });
            }
        }

        let methods_slice = self.ctx.arena.alloc_slice_copy::<FnDef>(methods.as_slice());

        let item = std::mem::zeroed::<Item>();
        item.tag = ItemTag::Protocol;
        item.span = Span { file_id: self.ctx.file_id, start: node.start_byte() as u32, end: node.end_byte() as u32 };
        item.protocol_def = ProtocolDef {
            id: pending.id,
            name: pending.name,
            generic_params: generic_params,
            methods: methods_slice,
            mixins: &[],
            scope_idx: pending.scope_idx,
        };
        self.ctx.items.push(item);
    }

    fn process_mixins(self: &mut Pass2, root: Node) {
        for i in 0usize..self.ctx.pending_mixins.len() {
            let pending = &self.ctx.pending_mixins[i];
            let node = self.find_node_at(root, pending.node_start, pending.node_end);

            // Get the protocol type from the mixin node
            let proto_node = child_by!(node, FieldKind::Protocol);
            if proto_node.is_none() {
                continue;
            }

            // Parse the protocol type reference
            let proto_ty = self.parse_type(proto_node.unwrap(), pending.type_scope_idx);

            // Extract the protocol ID from the type
            // It could be TyTag::Named (simple) or TyTag::Generic (with type args)
            let proto_id_val: usize = 0usize;
            let has_proto_id = false;
            if proto_ty.tag == TyTag::Named {
                proto_id_val = proto_ty.id._value;
                has_proto_id = true;
            } else if proto_ty.tag == TyTag::Generic && proto_ty.inner.tag == TyTag::Named {
                proto_id_val = proto_ty.inner.id._value;
                has_proto_id = true;
            }

            if !has_proto_id {
                continue;
            }

            // Find the ProtocolDef by its ID
            let impl_scope_idx = pending.impl_scope_idx;
            for j in 0usize..self.ctx.items.len() {
                if self.ctx.items[j].tag == ItemTag::Protocol && self.ctx.items[j].protocol_def.id._value == proto_id_val {
                    let proto_def = &self.ctx.items[j].protocol_def;
                    for k in 0usize..proto_def.methods.len() {
                        let method = &proto_def.methods[k];
                        // Register this method in the impl scope
                        // Only add if not already present (direct methods take priority)
                        let existing = self.ctx.scopes.get(impl_scope_idx).items.get(&method.name);
                        if existing.is_none() {
                            self.ctx.scopes.add_item(impl_scope_idx, NamedItem {
                                name: method.name,
                                kind: NamedItemKind::function(method.id),
                                span: Span { file_id: 0u32, start: 0u32, end: 0u32 },
                            });
                        }
                    }
                    break;
                }
            }
        }
    }

    fn process_type_aliases(self: &mut Pass2, root: Node) {
        for i in 0usize..self.ctx.pending_type_aliases.len() {
            let pending = &self.ctx.pending_type_aliases[i];
            let node = self.find_node_at(root, pending.node_start, pending.node_end);
            self.build_type_alias(node, pending);
        }
    }

    fn build_type_alias(self: &mut Pass2, node: Node, pending: &PendingTypeAlias) {
        let generic_params = self.parse_generic_params(node, pending.scope_idx);

        let inner_node = child_by!(node, FieldKind::Inner);
        let target = if !inner_node.is_none() {
            self.parse_type(inner_node.unwrap(), pending.scope_idx)
        } else {
            // Opaque type alias (no = ...) - treat as void
            let ty = Ty::void_ty();
            self.ctx.arena.alloc(ty) as &Ty
        };

        let alias = TypeAlias {
            id: pending.id,
            name: pending.name,
            generic_params: generic_params,
            target: target,
        };

        let item = std::mem::zeroed::<Item>();
        item.tag = ItemTag::TypeAlias;
        item.span = Span { file_id: self.ctx.file_id, start: pending.node_start, end: pending.node_end };
        item.type_alias = alias;
        self.ctx.items.push(item);
    }

    fn process_statics(self: &mut Pass2, root: Node) {
        for i in 0usize..self.ctx.pending_statics.len() {
            let pending = &self.ctx.pending_statics[i];
            let node = self.find_node_at(root, pending.node_start, pending.node_end);
            self.build_static(node, pending);
        }
    }

    fn build_static(self: &mut Pass2, node: Node, pending: &PendingStatic) {
        let type_node = child_by!(node, FieldKind::Type);
        let ty: Option<&Ty> = if !type_node.is_none() {
            Option::some(self.parse_type(type_node.unwrap(), pending.scope_idx))
        } else {
            Option::none()
        };

        let value_node = child_by!(node, FieldKind::Init);
        let init: Option<&Expr> = if !value_node.is_none() {
            let expr_parser = ExprParser::new(self.ctx, pending.scope_idx);
            Option::some(expr_parser.parse_expr(value_node.unwrap()))
        } else {
            Option::none()
        };

        let item = std::mem::zeroed::<Item>();
        item.tag = ItemTag::Static;
        item.span = Span { file_id: self.ctx.file_id, start: node.start_byte() as u32, end: node.end_byte() as u32 };
        item.static_def = StaticDef {
            id: pending.id,
            name: pending.name,
            ty: ty,
            init: init,
            attributes: pending.attributes,
            is_const: pending.is_const,
        };
        self.ctx.items.push(item);
    }
}

// ============================================================
// Expression parser
// ============================================================

struct ExprParser {
    ctx: &mut ParseContext,
    scope_idx: u32,
}

impl ExprParser {
    fn new(ctx: &mut ParseContext, scope_idx: u32) -> ExprParser {
        ExprParser { ctx: ctx, scope_idx: scope_idx }
    }

    fn make_expr(self: &ExprParser, tag: ExprTag, span: Span) -> Expr {
        let e = Expr::void_expr();
        e.tag = tag;
        e.span = span;
        e
    }

    fn alloc_void(self: &ExprParser, span: Span) -> &Expr {
        let e = Expr::void_expr();
        e.span = span;
        self.ctx.alloc_expr(e)
    }

    fn parse_expr(self: &ExprParser, node: Node) -> &Expr {
        let kind = NODE_KINDS[node.symbol() as usize];
        let span = self.ctx.make_span(node);

        switch kind {
            NodeKind::Block => self.parse_block(node, span),
            NodeKind::IntegerLiteral => self.parse_int_literal(node, span),
            NodeKind::FloatLiteral => self.parse_float_literal(node, span),
            NodeKind::BooleanLiteral => self.parse_bool_literal(node, span),
            NodeKind::StringLiteral => self.parse_string_literal(node, span),
            NodeKind::CharLiteral => self.parse_char_literal(node, span),
            NodeKind::PtrLiteral => {
                let e = self.make_expr(ExprTag::NullLit, span);
                self.ctx.alloc_expr(e)
            },
            NodeKind::Identifier => self.parse_identifier(node, span),
            NodeKind::ScopedIdentifier => self.parse_scoped_identifier(node, span),
            NodeKind::BinaryExpression => self.parse_binary(node, span),
            NodeKind::UnaryExpression => self.parse_unary(node, span),
            NodeKind::AssignmentExpression => self.parse_assignment(node, span),
            NodeKind::CompoundAssignmentExpr => self.parse_compound_assignment(node, span),
            NodeKind::CallExpression => self.parse_call(node, span),
            NodeKind::FieldExpression => self.parse_field(node, span),
            NodeKind::TupleIndexExpression => self.parse_tuple_index(node, span),
            NodeKind::IndexExpression => self.parse_index(node, span),
            NodeKind::ReferenceExpression => self.parse_ref(node, span),
            NodeKind::DereferenceExpression => self.parse_deref(node, span),
            NodeKind::TypeCastExpression => self.parse_cast(node, span),
            NodeKind::TypeCheckExpression => self.parse_type_check(node, span),
            NodeKind::IfExpression => self.parse_if(node, span),
            NodeKind::SwitchExpression => self.parse_switch(node, span),
            NodeKind::WhileExpression => self.parse_while(node, span),
            NodeKind::ForExpression => self.parse_for(node, span),
            NodeKind::LoopExpression => self.parse_loop(node, span),
            NodeKind::BreakExpression => self.parse_break(node, span),
            NodeKind::ContinueExpression => {
                let e = self.make_expr(ExprTag::Continue, span);
                self.ctx.alloc_expr(e)
            },
            NodeKind::ReturnExpression => self.parse_return(node, span),
            NodeKind::LetDeclaration => self.parse_let(node, span),
            NodeKind::StructExpression => self.parse_struct_lit(node, span),
            NodeKind::TupleExpression => self.parse_tuple_lit(node, span),
            NodeKind::ArrayExpression => self.parse_array_lit(node, span),
            NodeKind::LambdaExpression => self.parse_lambda(node, span),
            NodeKind::DeferExpression => self.parse_defer(node, span),
            NodeKind::TryExpression => self.parse_try(node, span),
            NodeKind::RangeExpression => self.parse_range(node, span),
            NodeKind::ParenthesizedExpression => {
                let inner = child_by!(node, FieldKind::Inner);
                if !inner.is_none() {
                    return self.parse_expr(inner.unwrap());
                }
                self.alloc_void(span)
            },
            NodeKind::ExpressionStatement => {
                let cursor = node.walk();
                defer cursor.free();
                for child in node.children(&cursor) {
                    if child.is_named() {
                        return self.parse_expr(child);
                    }
                }
                self.alloc_void(span)
            },
            NodeKind::Statement => {
                let cursor = node.walk();
                defer cursor.free();
                for child in node.children(&cursor) {
                    if child.is_named() {
                        return self.parse_expr(child);
                    }
                }
                self.alloc_void(span)
            },
            NodeKind::MacroInvocation => self.parse_macro_invocation(node, span),
            NodeKind::UniversalMacroInvocation => self.parse_universal_macro(node, span),
            NodeKind::MacroIdentifier => {
                // $param reference
                let text = self.ctx.node_text(node);
                let name = if text.len() > 0 && text[0] == '$' as u8 {
                    self.ctx.intern_str(text[1..])
                } else {
                    self.ctx.intern_str(text)
                };

                // When pre-parsing a macro body, produce ExprTag::MacroParam
                if self.ctx.in_macro_body {
                    // Find param index
                    let param_idx: i32 = -1i32;
                    for pi in 0usize..self.ctx.macro_param_names.len() {
                        if self.ctx.macro_param_names[pi] == name {
                            param_idx = pi as i32;
                            break;
                        }
                    }
                    if param_idx >= 0i32 {
                        let e = self.make_expr(ExprTag::MacroParam, span);
                        e.str_val = name;
                        e.int_val = param_idx as u64;
                        e.flag = (param_idx == self.ctx.macro_variadic_param_idx);
                        return self.ctx.alloc_expr(e);
                    }
                    return self.alloc_void(span);
                }

                // Normal expansion: look up in macro_args
                let arg = self.ctx.macro_args.get(&name);
                if arg.is_some() {
                    return arg.unwrap();
                }
                // Check if this is the variadic param being expanded
                if self.ctx.macro_variadic_name.len() > 0usize && name == self.ctx.macro_variadic_name {
                    if self.ctx.macro_et_cetera_idx != NO_VARIADIC {
                        let idx = self.ctx.macro_et_cetera_idx as usize;
                        if idx < self.ctx.macro_variadic_args.len() {
                            return self.ctx.macro_variadic_args[idx];
                        }
                    }
                }
                self.alloc_void(span)
            },
            NodeKind::StaticForExpression => self.parse_static_for(node, span),
            NodeKind::EtCeteraExpression => self.parse_et_cetera(node, span),
            NodeKind::EmptyStatement => self.alloc_void(span),
            NodeKind::LineComment => self.alloc_void(span),
            NodeKind::BlockComment => self.alloc_void(span),
            NodeKind::DocComment => self.alloc_void(span),
            _ => {
                // For unhandled nodes, try to parse children
                self.alloc_void(span)
            },
        }
    }

    fn parse_block(self: &ExprParser, node: Node, span: Span) -> &Expr {
        // Create a child scope for this block to properly handle variable shadowing.
        // Inner `let` declarations will be in the child scope and won't overwrite
        // outer variables in the parent scope.
        let block_scope = self.ctx.scopes.create_scope(ScopeKind::Block, Option::some(self.scope_idx));
        let block_parser = ExprParser::new(self.ctx, block_scope);

        let stmts: Vector<&Expr> = Vector::new();
        defer stmts.free();

        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Statements, &cursor) {
            if child.is_named() {
                let expr = block_parser.parse_expr(child);
                stmts.push(expr);
            }
        }

        // Also check for a result expression
        let result_node = child_by!(node, FieldKind::Result);
        if !result_node.is_none() {
            stmts.push(block_parser.parse_expr(result_node.unwrap()));
        }

        let result = self.ctx.arena.alloc_slice_copy::<&Expr>(stmts.as_slice());

        let e = self.make_expr(ExprTag::Block, span);
        e.args = result;
        self.ctx.alloc_expr(e)
    }

    fn parse_int_literal(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let text = self.ctx.node_text(node);
        let (value, suffix) = parse_int_with_suffix(text);
        let e = self.make_expr(ExprTag::IntLit, span);
        e.int_val = value;
        e.type_suffix = suffix;
        self.ctx.alloc_expr(e)
    }

    fn parse_float_literal(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let text = self.ctx.node_text(node);
        let value = parse_float(text);
        let e = self.make_expr(ExprTag::FloatLit, span);
        e.float_val = value;
        self.ctx.alloc_expr(e)
    }

    fn parse_bool_literal(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let text = self.ctx.node_text(node);
        let e = self.make_expr(ExprTag::BoolLit, span);
        e.bool_val = text == "true";
        self.ctx.alloc_expr(e)
    }

    fn parse_string_literal(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let text = self.ctx.node_text(node);
        // Strip quotes and handle escape sequences
        let content = if text.len() >= 2 {
            unescape_string(text[1..text.len()-1], self.ctx.arena)
        } else {
            ""
        };
        let e = self.make_expr(ExprTag::StringLit, span);
        e.str_val = content;
        self.ctx.alloc_expr(e)
    }

    fn parse_char_literal(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let text = self.ctx.node_text(node);
        // Strip quotes
        let ch: u32 = if text.len() >= 3 {
            if text[1] == '\\' as u8 && text.len() >= 4 {
                // Escape sequence
                switch text[2] {
                    'n' as u8 => '\n' as u32,
                    'r' as u8 => '\r' as u32,
                    't' as u8 => '\t' as u32,
                    '\\' as u8 => '\\' as u32,
                    '\'' as u8 => '\'' as u32,
                    '0' as u8 => 0u32,
                    _ => text[2] as u32,
                }
            } else {
                text[1] as u32
            }
        } else {
            0u32
        };
        let e = self.make_expr(ExprTag::CharLit, span);
        e.int_val = ch as u64;
        self.ctx.alloc_expr(e)
    }

    fn parse_identifier(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let name = self.ctx.node_text(node);
        let resolved = self.ctx.scopes.resolve(self.scope_idx, name);
        if resolved.is_some() {
            let item = resolved.unwrap();
            if item.kind.tag == scope::NamedItemTag::Local {
                let id = item.kind.id;
                let e = self.make_expr(ExprTag::Local, span);
                e.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Param {
                let id = item.kind.id;
                let e = self.make_expr(ExprTag::Param, span);
                e.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Function {
                let id = item.kind.id;
                let e = self.make_expr(ExprTag::FnRef, span);
                e.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Method {
                let fn_id = item.kind.id2;
                let e = self.make_expr(ExprTag::FnRef, span);
                e.id = fn_id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Static {
                let id = item.kind.id;
                let e = self.make_expr(ExprTag::StaticRef, span);
                e.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Const {
                let id = item.kind.id;
                let e = self.make_expr(ExprTag::StaticRef, span);
                e.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::BoundValue {
                let e = self.make_expr(ExprTag::BoundValue, span);
                e.id = item.kind.id;       // binding id
                e.id2 = item.kind.id2;     // self_param id
                e.str_val = item.name;     // binding name (for field lookup)
                e.flag = item.kind.scope_idx == BoundType::ByReference as u32;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::EnumVariant {
                let enum_id = item.kind.id;
                let variant_id = item.kind.id2;
                let e = self.make_expr(ExprTag::EnumRef, span);
                e.id = enum_id;
                e.id2 = variant_id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Macro {
                // Macro used in expression context (e.g. as argument to bind!)
                let e = self.make_expr(ExprTag::MacroInvocation, span);
                e.str_val = self.ctx.intern_str(name);
                e.args = &[];
                return self.ctx.alloc_expr(e);
            } else {
                let e = self.make_expr(ExprTag::Local, span);
                e.id = Id { _value: 0 };
                return self.ctx.alloc_expr(e);
            }
        } else {
            // Unresolved - may be resolved later during monomorphization
            let e = self.make_expr(ExprTag::Local, span);
            e.id = Id { _value: 0 };
            self.ctx.alloc_expr(e)
        }
    }

    fn parse_scoped_identifier(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let pass2 = Pass2 { ctx: self.ctx };
        let segments = pass2.collect_type_path_segments(node);
        let resolved = self.ctx.scopes.resolve_path(self.scope_idx, segments);
        if resolved.is_some() {
            let item = resolved.unwrap();
            if item.kind.tag == scope::NamedItemTag::Function {
                let id = item.kind.id;
                let e = self.make_expr(ExprTag::FnRef, span);
                e.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Method {
                let fn_id = item.kind.id2;
                let e = self.make_expr(ExprTag::FnRef, span);
                e.id = fn_id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Static {
                let id = item.kind.id;
                let e = self.make_expr(ExprTag::StaticRef, span);
                e.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Const {
                let id = item.kind.id;
                let e = self.make_expr(ExprTag::StaticRef, span);
                e.id = id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::EnumVariant {
                let enum_id = item.kind.id;
                let variant_id = item.kind.id2;
                let e = self.make_expr(ExprTag::EnumRef, span);
                e.id = enum_id;
                e.id2 = variant_id;
                return self.ctx.alloc_expr(e);
            } else if item.kind.tag == scope::NamedItemTag::Macro {
                // Macro used in expression context (e.g. as argument to bind!)
                let e = self.make_expr(ExprTag::MacroInvocation, span);
                e.str_val = item.name;
                e.args = &[];
                return self.ctx.alloc_expr(e);
            } else {
                let e = self.make_expr(ExprTag::Local, span);
                e.id = Id { _value: 0 };
                return self.ctx.alloc_expr(e);
            }
        } else {
            let e = self.make_expr(ExprTag::Local, span);
            e.id = Id { _value: 0 };
            self.ctx.alloc_expr(e)
        }
    }

    fn parse_binary(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let left = child_by!(node, FieldKind::Left);
        let right = child_by!(node, FieldKind::Right);
        let op_node = child_by!(node, FieldKind::Operator);

        if left.is_none() || right.is_none() || op_node.is_none() {
            return self.alloc_void(span);
        }

        let op_text = self.ctx.node_text(op_node.unwrap());
        let op = parse_binop(op_text);

        let lhs = self.parse_expr(left.unwrap());
        let rhs = self.parse_expr(right.unwrap());

        let e = self.make_expr(ExprTag::Binary, span);
        e.bin_op = op;
        e.lhs = lhs;
        e.rhs = rhs;
        self.ctx.alloc_expr(e)
    }

    fn parse_unary(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let operand_node = child_by!(node, FieldKind::Value);
        let op_node = child_by!(node, FieldKind::Operator);

        if operand_node.is_none() || op_node.is_none() {
            return self.alloc_void(span);
        }

        let op_text = self.ctx.node_text(op_node.unwrap());
        let op = if op_text == "-" { UnOp::Neg }
                 else if op_text == "!" { UnOp::Not }
                 else if op_text == "~" { UnOp::BitNot }
                 else { UnOp::Neg };

        let operand = self.parse_expr(operand_node.unwrap());

        let e = self.make_expr(ExprTag::Unary, span);
        e.un_op = op;
        e.lhs = operand;
        self.ctx.alloc_expr(e)
    }

    fn parse_assignment(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let left = child_by!(node, FieldKind::Left);
        let right = child_by!(node, FieldKind::Right);
        if left.is_none() || right.is_none() {
            return self.alloc_void(span);
        }
        let lhs = self.parse_expr(left.unwrap());
        let rhs = self.parse_expr(right.unwrap());

        let e = self.make_expr(ExprTag::Assign, span);
        e.assign_op = AssignOp::Assign;
        e.lhs = lhs;
        e.rhs = rhs;
        self.ctx.alloc_expr(e)
    }

    fn parse_compound_assignment(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let left = child_by!(node, FieldKind::Left);
        let right = child_by!(node, FieldKind::Right);
        let op_node = child_by!(node, FieldKind::Operator);
        if left.is_none() || right.is_none() || op_node.is_none() {
            return self.alloc_void(span);
        }

        let op_text = self.ctx.node_text(op_node.unwrap());
        let op = parse_assign_op(op_text);

        let lhs = self.parse_expr(left.unwrap());
        let rhs = self.parse_expr(right.unwrap());

        let e = self.make_expr(ExprTag::Assign, span);
        e.assign_op = op;
        e.lhs = lhs;
        e.rhs = rhs;
        self.ctx.alloc_expr(e)
    }

    fn parse_call(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let func = child_by!(node, FieldKind::Function);
        let args_node = child_by!(node, FieldKind::Arguments);

        if func.is_none() {
            return self.alloc_void(span);
        }

        // Check for turbofish calls like zeroed::<T>() or identity::<i32>()
        let func_node = func.unwrap();
        let func_kind = NODE_KINDS[func_node.symbol() as usize];
        if func_kind == NodeKind::Turbofish || func_kind == NodeKind::GenericTypeWithTurbofish {
            let result = self.try_parse_intrinsic_call(func_node, span);
            if result.tag != ExprTag::Void {
                // Intrinsic call (e.g., zeroed::<T>())
                return self.ctx.alloc_expr(result);
            }
            // Non-intrinsic turbofish: parse as generic call with type args
            let turbofish_result = self.parse_turbofish_call(node, func_node, span);
            if turbofish_result.tag != ExprTag::Void {
                return self.ctx.alloc_expr(turbofish_result);
            }
        }

        // Check for ScopedIdentifier with turbofish in path, e.g. Wrapper::<i32>::new(args)
        if func_kind == NodeKind::ScopedIdentifier {
            let path_child = child_by!(func_node, FieldKind::Path);
            if !path_child.is_none() {
                let path_kind = NODE_KINDS[path_child.unwrap().symbol() as usize];
                if path_kind == NodeKind::GenericTypeWithTurbofish || path_kind == NodeKind::Turbofish || path_kind == NodeKind::GenericType {
                    // Extract type arguments from the turbofish in the path
                    let turbo_node = path_child.unwrap();
                    let type_args_node = child_by!(turbo_node, FieldKind::TypeArguments);
                    let pass2 = Pass2 { ctx: self.ctx };
                    let type_args = if !type_args_node.is_none() {
                        pass2.parse_type_args(type_args_node.unwrap(), self.scope_idx)
                    } else {
                        let empty: &[&Ty] = &[];
                        empty
                    };

                    // Resolve the scoped identifier (which finds the method)
                    let callee = self.parse_scoped_identifier(func_node, span);

                    let call_args = if !args_node.is_none() {
                        self.parse_arg_list(args_node.unwrap())
                    } else {
                        let empty: &[&Expr] = &[];
                        empty
                    };

                    let e = self.make_expr(ExprTag::Call, span);
                    e.lhs = callee;
                    e.args = call_args;
                    e.type_args = type_args;
                    return self.ctx.alloc_expr(e);
                }
            }
        }

        let callee = self.parse_expr(func_node);
        let args = if !args_node.is_none() {
            self.parse_arg_list(args_node.unwrap())
        } else {
            let empty: &[&Expr] = &[];
            empty
        };

        let e = self.make_expr(ExprTag::Call, span);
        e.lhs = callee;
        e.args = args;
        self.ctx.alloc_expr(e)
    }

    fn try_parse_intrinsic_call(self: &ExprParser, func_node: Node, span: Span) -> Expr {
        // Turbofish has field("function", ...) and field("type_arguments", ...)
        // GenericTypeWithTurbofish has field("type", ...) and field("type_arguments", ...)
        let path_node = child_by!(func_node, FieldKind::Function);
        let path_node2 = if path_node.is_none() { child_by!(func_node, FieldKind::Type) } else { path_node };
        let type_args_node = child_by!(func_node, FieldKind::TypeArguments);

        if path_node2.is_none() || type_args_node.is_none() {
            return Expr::void_expr();
        }

        // Get the function path text
        let pass2 = Pass2 { ctx: self.ctx };
        let segments = pass2.collect_type_path_segments(path_node2.unwrap());
        if segments.len() == 0 {
            return Expr::void_expr();
        }

        let last_seg = segments[segments.len() - 1];

        // Check for std::mem::zeroed::<T>()
        if last_seg == "zeroed" {
            let type_args = pass2.parse_type_args(type_args_node.unwrap(), self.scope_idx);
            if type_args.len() >= 1 {
                let e = self.make_expr(ExprTag::Zeroed, span);
                e.ty = type_args[0];
                return e;
            }
        }

        Expr::void_expr()
    }

    fn parse_turbofish_call(self: &ExprParser, call_node: Node, func_node: Node, span: Span) -> Expr {
        // Parse the function path from the turbofish
        let path_node = child_by!(func_node, FieldKind::Function);
        let path_node2 = if path_node.is_none() { child_by!(func_node, FieldKind::Type) } else { path_node };
        let type_args_node = child_by!(func_node, FieldKind::TypeArguments);

        if path_node2.is_none() {
            return Expr::void_expr();
        }

        // Resolve the function
        let callee = self.parse_expr(path_node2.unwrap());

        // Parse type arguments
        let pass2 = Pass2 { ctx: self.ctx };
        let type_args = if !type_args_node.is_none() {
            pass2.parse_type_args(type_args_node.unwrap(), self.scope_idx)
        } else {
            let empty: &[&Ty] = &[];
            empty
        };

        // Parse call arguments from the outer call node
        let args_node = child_by!(call_node, FieldKind::Arguments);
        let args = if !args_node.is_none() {
            self.parse_arg_list(args_node.unwrap())
        } else {
            let empty: &[&Expr] = &[];
            empty
        };

        let e = self.make_expr(ExprTag::Call, span);
        e.lhs = callee;
        e.args = args;
        e.type_args = type_args;
        e
    }

    fn parse_arg_list(self: &ExprParser, node: Node) -> &[&Expr] {
        let args: Vector<&Expr> = Vector::new();
        defer args.free();

        let cursor = node.walk();
        defer cursor.free();
        for child in node.children(&cursor) {
            if child.is_named() {
                let kind = NODE_KINDS[child.symbol() as usize];
                if kind == NodeKind::EtCeteraExpression {
                    if self.ctx.in_macro_body {
                        // During pre-parse, store as ExprTag::EtCetera
                        args.push(self.parse_expr(child));
                    } else {
                        // Expand et cetera: re-parse inner expression for each variadic arg
                        let inner = child_by!(child, FieldKind::Inner);
                        if !inner.is_none() && self.ctx.macro_variadic_args.len() > 0usize {
                            let inner_node = inner.unwrap();
                            for vi in 0usize..self.ctx.macro_variadic_args.len() {
                                self.ctx.macro_et_cetera_idx = vi as i32;
                                args.push(self.parse_expr(inner_node));
                            }
                            self.ctx.macro_et_cetera_idx = NO_VARIADIC;
                        }
                    }
                } else if kind != NodeKind::LineComment && kind != NodeKind::BlockComment {
                    args.push(self.parse_expr(child));
                }
            }
        }

        self.ctx.arena.alloc_slice_copy::<&Expr>(args.as_slice())
    }

    fn parse_field(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let obj = child_by!(node, FieldKind::Value);
        let field = child_by!(node, FieldKind::Field);
        if obj.is_none() || field.is_none() {
            return self.alloc_void(span);
        }

        // Check if the field child is a tuple_index_expression (e.g. t.0 or t.(expr))
        let field_node = field.unwrap();
        let field_kind = NODE_KINDS[field_node.symbol() as usize];
        if field_kind == NodeKind::TupleIndexExpression {
            let obj_expr = self.parse_expr(obj.unwrap());
            // TupleIndexExpression has a single "field" child containing the index
            let idx_node = child_by!(field_node, FieldKind::Field);
            if !idx_node.is_none() {
                let idx_inner = idx_node.unwrap();
                let idx_kind = NODE_KINDS[idx_inner.symbol() as usize];
                if idx_kind == NodeKind::IntegerLiteral {
                    // Simple literal index: t.0, t.1, etc.
                    let idx = parse_usize(self.ctx.node_text(idx_inner));
                    let e = self.make_expr(ExprTag::TupleIndex, span);
                    e.lhs = obj_expr;
                    e.index_val = idx;
                    return self.ctx.alloc_expr(e);
                }
                // Expression index: t.(expr) - parse and const-eval later
                let idx_expr = self.parse_expr(idx_inner);
                let e = self.make_expr(ExprTag::TupleIndex, span);
                e.lhs = obj_expr;
                e.opt_expr = Option::some(idx_expr);
                return self.ctx.alloc_expr(e);
            }
            // Fallback: try parsing the whole text as a number
            let idx = parse_usize(self.ctx.node_text(field_node));
            let e = self.make_expr(ExprTag::TupleIndex, span);
            e.lhs = obj_expr;
            e.index_val = idx;
            return self.ctx.alloc_expr(e);
        }

        let obj_expr = self.parse_expr(obj.unwrap());
        let field_name = self.ctx.intern_str(self.ctx.node_text(field_node));

        let e = self.make_expr(ExprTag::FieldAccess, span);
        e.lhs = obj_expr;
        e.str_val = field_name;
        self.ctx.alloc_expr(e)
    }

    fn parse_tuple_index(self: &ExprParser, node: Node, span: Span) -> &Expr {
        // TupleIndexExpression as top-level (shouldn't normally happen,
        // as it's typically inside FieldExpression, but handle gracefully)
        let field = child_by!(node, FieldKind::Field);
        if !field.is_none() {
            return self.parse_expr(field.unwrap());
        }
        self.alloc_void(span)
    }

    fn parse_index(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let obj = child_by!(node, FieldKind::Value);
        let index = child_by!(node, FieldKind::Index);
        if obj.is_none() || index.is_none() {
            return self.alloc_void(span);
        }
        let obj_expr = self.parse_expr(obj.unwrap());
        let idx_expr = self.parse_expr(index.unwrap());

        let e = self.make_expr(ExprTag::Index, span);
        e.lhs = obj_expr;
        e.rhs = idx_expr;
        self.ctx.alloc_expr(e)
    }

    fn parse_ref(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let inner = child_by!(node, FieldKind::Value);
        let is_mut = !child_by!(node, FieldKind::Mut).is_none();
        if inner.is_none() {
            return self.alloc_void(span);
        }

        let e = self.make_expr(ExprTag::Ref, span);
        e.lhs = self.parse_expr(inner.unwrap());
        e.flag = is_mut;
        self.ctx.alloc_expr(e)
    }

    fn parse_deref(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let inner = child_by!(node, FieldKind::Value);
        if inner.is_none() {
            return self.alloc_void(span);
        }

        let e = self.make_expr(ExprTag::Deref, span);
        e.lhs = self.parse_expr(inner.unwrap());
        self.ctx.alloc_expr(e)
    }

    fn parse_cast(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let value = child_by!(node, FieldKind::Value);
        let type_node = child_by!(node, FieldKind::Type);
        if value.is_none() || type_node.is_none() {
            return self.alloc_void(span);
        }

        let pass2 = Pass2 { ctx: self.ctx };
        let ty = pass2.parse_type(type_node.unwrap(), self.scope_idx);

        let e = self.make_expr(ExprTag::Cast, span);
        e.lhs = self.parse_expr(value.unwrap());
        e.ty = ty;
        self.ctx.alloc_expr(e)
    }

    fn parse_type_check(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let value = child_by!(node, FieldKind::Value);
        let type_node = child_by!(node, FieldKind::Type);
        if value.is_none() || type_node.is_none() {
            return self.alloc_void(span);
        }

        let pass2 = Pass2 { ctx: self.ctx };
        let ty = pass2.parse_type(type_node.unwrap(), self.scope_idx);

        let e = self.make_expr(ExprTag::TypeCheck, span);
        e.lhs = self.parse_expr(value.unwrap());
        e.ty = ty;
        self.ctx.alloc_expr(e)
    }

    fn parse_if(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let cond = child_by!(node, FieldKind::Condition);
        let then_node = child_by!(node, FieldKind::Consequence);
        let else_node = child_by!(node, FieldKind::Alternative);

        if cond.is_none() || then_node.is_none() {
            return self.alloc_void(span);
        }

        let cond_expr = self.parse_expr(cond.unwrap());
        let then_expr = self.parse_expr(then_node.unwrap());
        let else_expr: Option<&Expr> = if !else_node.is_none() {
            // Else clause wraps its content
            let inner = child_by!(else_node.unwrap(), FieldKind::Inner);
            if !inner.is_none() {
                Option::some(self.parse_expr(inner.unwrap()))
            } else {
                // Direct else body
                Option::some(self.parse_expr(else_node.unwrap()))
            }
        } else {
            Option::none()
        };

        // Check if this is "when" (static if) vs "if"
        let kind_node = child_by!(node, FieldKind::Kind);
        let is_when = if !kind_node.is_none() {
            self.ctx.node_text(kind_node.unwrap()) == "when"
        } else {
            false
        };

        let tag = if is_when { ExprTag::When } else { ExprTag::If };
        let e = self.make_expr(tag, span);
        e.cond = cond_expr;
        e.lhs = then_expr;
        e.opt_expr = else_expr;
        self.ctx.alloc_expr(e)
    }

    fn parse_switch(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let value = child_by!(node, FieldKind::Value);
        if value.is_none() {
            return self.alloc_void(span);
        }

        let value_expr = self.parse_expr(value.unwrap());
        let arms: Vector<SwitchArm> = Vector::new();
        defer arms.free();

        let body = child_by!(node, FieldKind::Body);
        if !body.is_none() {
            let cursor = body.unwrap().walk();
            defer cursor.free();
            for child in children_by!(body.unwrap(), FieldKind::Arm, &cursor) {
                let kind = NODE_KINDS[child.symbol() as usize];
                if kind == NodeKind::SwitchArm {
                    let pattern_node = child_by!(child, FieldKind::Pattern);
                    let body_node = child_by!(child, FieldKind::Value);

                    let patterns: Vector<&Expr> = Vector::new();
                    defer patterns.free();

                    if !pattern_node.is_none() {
                        // Check for wildcard/default pattern "_"
                        let pat_text = self.ctx.node_text(pattern_node.unwrap());
                        let is_wildcard = pat_text.len() == 1 && pat_text[0] == '_';
                        if !is_wildcard {
                            // Parse pattern values
                            let cursor2 = pattern_node.unwrap().walk();
                            defer cursor2.free();
                            for pat_child in pattern_node.unwrap().children(&cursor2) {
                                if pat_child.is_named() {
                                    patterns.push(self.parse_expr(pat_child));
                                }
                            }
                            // If pattern node itself is a value
                            if patterns.len() == 0 {
                                patterns.push(self.parse_expr(pattern_node.unwrap()));
                            }
                        }
                    }

                    let body_expr = if !body_node.is_none() {
                        self.parse_expr(body_node.unwrap())
                    } else {
                        self.alloc_void(Span::empty())
                    };

                    arms.push(SwitchArm {
                        pattern: self.ctx.arena.alloc_slice_copy::<&Expr>(patterns.as_slice()),
                        body: body_expr,
                    });
                }
            }
        }

        let e = self.make_expr(ExprTag::Switch, span);
        e.lhs = value_expr;
        e.switch_arms = self.ctx.arena.alloc_slice_copy::<SwitchArm>(arms.as_slice());
        self.ctx.alloc_expr(e)
    }

    fn parse_while(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let cond = child_by!(node, FieldKind::Condition);
        let body = child_by!(node, FieldKind::Body);
        if cond.is_none() || body.is_none() {
            return self.alloc_void(span);
        }

        let e = self.make_expr(ExprTag::While, span);
        e.cond = self.parse_expr(cond.unwrap());
        e.lhs = self.parse_expr(body.unwrap());
        self.ctx.alloc_expr(e)
    }

    fn parse_for(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let name_node = child_by!(node, FieldKind::Name);
        let iter_node = child_by!(node, FieldKind::Value);
        let body = child_by!(node, FieldKind::Body);

        if iter_node.is_none() || body.is_none() {
            return self.alloc_void(span);
        }

        // Create a child scope for the loop so the loop variable doesn't pollute the parent scope
        let loop_scope = self.ctx.scopes.create_scope(ScopeKind::Block, Option::some(self.scope_idx));
        let loop_parser = ExprParser::new(self.ctx, loop_scope);

        let e = self.make_expr(ExprTag::For, span);

        if name_node.is_some() {
            // Simple case: for item in iterable { body }
            let var_id = self.ctx.next_id();
            let var_name = self.ctx.intern_str(self.ctx.node_text(name_node.unwrap()));

            self.ctx.scopes.add_item(loop_scope, NamedItem {
                name: var_name,
                kind: NamedItemKind::local(var_id),
                span: self.ctx.make_span(name_node.unwrap()),
            });

            e.id = var_id;
            e.args = &[];
        } else {
            // Tuple unpacking: for (a, b, ...) in iterable { body }
            // Collect element names from tree-sitter Element children
            let cursor = node.walk();
            defer cursor.free();

            let elem_exprs: Vector<&Expr> = Vector::new();
            defer elem_exprs.free();
            for elem_node in children_by!(node, FieldKind::Element, &cursor) {
                let elem_id = self.ctx.next_id();
                let elem_name = self.ctx.intern_str(self.ctx.node_text(elem_node));

                self.ctx.scopes.add_item(loop_scope, NamedItem {
                    name: elem_name,
                    kind: NamedItemKind::local(elem_id),
                    span: self.ctx.make_span(elem_node),
                });

                // Store element ID and name in an ExprTag::Local node
                let elem_expr = self.make_expr(ExprTag::Local, self.ctx.make_span(elem_node));
                elem_expr.id = elem_id;
                elem_expr.str_val = elem_name;
                elem_exprs.push(self.ctx.alloc_expr(elem_expr));
            }

            // Use a hidden temporary for the whole tuple value
            let var_id = self.ctx.next_id();
            e.id = var_id;
            e.args = self.ctx.arena.alloc_slice_copy::<&Expr>(elem_exprs.as_slice());
        }

        e.lhs = self.parse_expr(iter_node.unwrap()); // iter parsed in parent scope
        e.rhs = loop_parser.parse_expr(body.unwrap()); // body parsed in child scope
        self.ctx.alloc_expr(e)
    }

    fn parse_loop(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let body = child_by!(node, FieldKind::Body);
        if body.is_none() {
            return self.alloc_void(span);
        }

        let e = self.make_expr(ExprTag::Loop, span);
        e.lhs = self.parse_expr(body.unwrap());
        self.ctx.alloc_expr(e)
    }

    fn parse_break(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let value = child_by!(node, FieldKind::Inner);
        let e = self.make_expr(ExprTag::Break, span);
        if !value.is_none() {
            e.opt_expr = Option::some(self.parse_expr(value.unwrap()));
        }
        self.ctx.alloc_expr(e)
    }

    fn parse_return(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let value = child_by!(node, FieldKind::Inner);
        let e = self.make_expr(ExprTag::Return, span);
        if !value.is_none() {
            e.opt_expr = Option::some(self.parse_expr(value.unwrap()));
        }
        self.ctx.alloc_expr(e)
    }

    fn parse_let(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let name_node = child_by!(node, FieldKind::Name);
        let type_node = child_by!(node, FieldKind::Type);
        let value_node = child_by!(node, FieldKind::Value);

        if !name_node.is_none() {
            // Simple let: let x = expr;
            let var_id = self.ctx.next_id();
            let var_name = self.ctx.intern_str(self.ctx.node_text(name_node.unwrap()));

            let pass2 = Pass2 { ctx: self.ctx };
            let ty: Option<&Ty> = if !type_node.is_none() {
                Option::some(pass2.parse_type(type_node.unwrap(), self.scope_idx))
            } else {
                Option::none()
            };

            let init: Option<&Expr> = if !value_node.is_none() {
                Option::some(self.parse_expr(value_node.unwrap()))
            } else {
                Option::none()
            };

            // Register in scope AFTER parsing the initializer
            // This ensures the initializer can reference shadowed variables
            // (e.g., `let x = x.method()` where x in the initializer refers
            // to the previously defined x, not the one being defined)
            self.ctx.scopes.add_item(self.scope_idx, NamedItem {
                name: var_name,
                kind: NamedItemKind::local(var_id),
                span: self.ctx.make_span(name_node.unwrap()),
            });

            let e = self.make_expr(ExprTag::Let, span);
            e.id = var_id;
            e.opt_ty = ty;
            e.opt_expr = init;
            return self.ctx.alloc_expr(e);
        }

        // Tuple destructuring: let (a, b) = expr;
        let elements: Vector<Node> = Vector::new();
        defer elements.free();
        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Element, &cursor) {
            elements.push(child);
        }

        if elements.len() == 0 || value_node.is_none() {
            return self.alloc_void(span);
        }

        // Desugar: let (a, b) = expr;
        // Into: { let _tmp = expr; let a = _tmp.0; let b = _tmp.1; }
        let tmp_id = self.ctx.next_id();
        let init_expr = self.parse_expr(value_node.unwrap());

        // let _tmp = expr
        let tmp_let = self.make_expr(ExprTag::Let, span);
        tmp_let.id = tmp_id;
        tmp_let.opt_expr = Option::some(init_expr);
        let ir_tmp_let = self.ctx.alloc_expr(tmp_let);

        // Build block: _tmp_let, then each element let
        let stmts = self.ctx.arena.alloc_slice::<&Expr>(elements.len() + 1);
        stmts[0] = ir_tmp_let;

        for i in 0usize..elements.len() {
            let elem_node = elements[i];
            let elem_id = self.ctx.next_id();
            let elem_name = self.ctx.intern_str(self.ctx.node_text(elem_node));

            self.ctx.scopes.add_item(self.scope_idx, NamedItem {
                name: elem_name,
                kind: NamedItemKind::local(elem_id),
                span: self.ctx.make_span(elem_node),
            });

            // _tmp reference
            let tmp_ref = self.make_expr(ExprTag::Local, span);
            tmp_ref.id = tmp_id;
            let ir_tmp_ref = self.ctx.alloc_expr(tmp_ref);

            // _tmp.i (tuple index)
            let idx_expr = self.make_expr(ExprTag::TupleIndex, span);
            idx_expr.lhs = ir_tmp_ref;
            idx_expr.index_val = i;
            let ir_idx = self.ctx.alloc_expr(idx_expr);

            // let elem = _tmp.i
            let elem_let = self.make_expr(ExprTag::Let, span);
            elem_let.id = elem_id;
            elem_let.opt_expr = Option::some(ir_idx);
            stmts[i + 1] = self.ctx.alloc_expr(elem_let);
        }

        let block = self.make_expr(ExprTag::Block, span);
        block.args = stmts;
        self.ctx.alloc_expr(block)
    }

    fn parse_struct_lit(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let type_node = child_by!(node, FieldKind::Name);
        let init_node = child_by!(node, FieldKind::Arguments);

        if type_node.is_none() {
            return self.alloc_void(span);
        }

        let pass2 = Pass2 { ctx: self.ctx };
        let ty = pass2.parse_type(type_node.unwrap(), self.scope_idx);

        let fields: Vector<FieldInit> = Vector::new();
        defer fields.free();

        if !init_node.is_none() {
            let cursor = init_node.unwrap().walk();
            defer cursor.free();
            for child in init_node.unwrap().children(&cursor) {
                let kind = NODE_KINDS[child.symbol() as usize];
                if kind == NodeKind::StructInitializerItem {
                    let name_node = child_by!(child, FieldKind::Field);
                    let value_node = child_by!(child, FieldKind::Value);
                    if !name_node.is_none() && !value_node.is_none() {
                        fields.push(FieldInit {
                            name: self.ctx.intern_str(self.ctx.node_text(name_node.unwrap())),
                            value: self.parse_expr(value_node.unwrap()),
                        });
                    }
                }
            }
        }

        let e = self.make_expr(ExprTag::StructLit, span);
        e.ty = ty;
        e.field_inits = self.ctx.arena.alloc_slice_copy::<FieldInit>(fields.as_slice());
        self.ctx.alloc_expr(e)
    }

    fn parse_tuple_lit(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let elems: Vector<&Expr> = Vector::new();
        defer elems.free();

        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Element, &cursor) {
            elems.push(self.parse_expr(child));
        }

        let e = self.make_expr(ExprTag::TupleLit, span);
        e.args = self.ctx.arena.alloc_slice_copy::<&Expr>(elems.as_slice());
        self.ctx.alloc_expr(e)
    }

    fn parse_array_lit(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let elems: Vector<&Expr> = Vector::new();
        defer elems.free();

        let cursor = node.walk();
        defer cursor.free();
        for child in children_by!(node, FieldKind::Element, &cursor) {
            elems.push(self.parse_expr(child));
        }

        let e = self.make_expr(ExprTag::ArrayLit, span);
        e.args = self.ctx.arena.alloc_slice_copy::<&Expr>(elems.as_slice());
        self.ctx.alloc_expr(e)
    }

    fn parse_lambda(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let params_node = child_by!(node, FieldKind::Parameters);
        let body_node = child_by!(node, FieldKind::Body);

        if body_node.is_none() {
            return self.alloc_void(span);
        }

        // Create a child scope for the lambda (captures and params live here)
        let lambda_scope = self.ctx.scopes.create_scope(scope::ScopeKind::Block, Option::some(self.scope_idx));

        let params: Vector<LambdaParam> = Vector::new();
        defer params.free();

        let bindings: Vector<ClosureBinding> = Vector::new();
        defer bindings.free();

        // Generate a self_param id for closure struct access (only used if there are captures)
        let self_param_id = self.ctx.next_id();

        if !params_node.is_none() {
            let cursor = params_node.unwrap().walk();
            defer cursor.free();
            let pass2 = Pass2 { ctx: self.ctx };
            for child in params_node.unwrap().children(&cursor) {
                if child.is_named() {
                    let kind = NODE_KINDS[child.symbol() as usize];
                    let id = self.ctx.next_id();

                    if kind == NodeKind::BoundIdentifier {
                        // Closure capture: =name (by value) or &name (by reference)
                        let name_node = child_by!(child, FieldKind::Name);
                        let name = self.ctx.intern_str(self.ctx.node_text(name_node.unwrap()));

                        let by_ref_node = child_by!(child, FieldKind::ByReference);
                        let bound_type = if !by_ref_node.is_none() {
                            BoundType::ByReference
                        } else {
                            BoundType::ByValue
                        };

                        // Resolve the original variable in the parent scope (self.scope_idx)
                        let value_expr: &Expr = {
                            let resolved = self.ctx.scopes.resolve(self.scope_idx, name);
                            if resolved.is_some() {
                                let item = resolved.unwrap();
                                if item.kind.tag == scope::NamedItemTag::Local {
                                    let ve = self.make_expr(ExprTag::Local, span);
                                    ve.id = item.kind.id;
                                    self.ctx.alloc_expr(ve)
                                } else if item.kind.tag == scope::NamedItemTag::Param {
                                    let ve = self.make_expr(ExprTag::Param, span);
                                    ve.id = item.kind.id;
                                    self.ctx.alloc_expr(ve)
                                } else if item.kind.tag == scope::NamedItemTag::BoundValue {
                                    // Nested closure: capture from enclosing closure
                                    let ve = self.make_expr(ExprTag::BoundValue, span);
                                    ve.id = item.kind.id;
                                    ve.id2 = item.kind.id2;
                                    ve.str_val = item.name;
                                    ve.flag = item.kind.scope_idx == BoundType::ByReference as u32;
                                    self.ctx.alloc_expr(ve)
                                } else {
                                    self.alloc_void(span) // Can only close over locals
                                }
                            } else {
                                self.alloc_void(span)
                            }
                        };

                        // Register the bound value in the lambda scope
                        self.ctx.scopes.add_item(lambda_scope, NamedItem {
                            name: name,
                            kind: NamedItemKind::bound_value(id, self_param_id, bound_type),
                            span: self.ctx.make_span(child),
                        });

                        bindings.push(ClosureBinding {
                            id: id,
                            name: name,
                            value: value_expr,
                            bound_type: bound_type,
                        });
                    } else {
                        // Regular parameter
                        let name: &[u8] = "";
                        let ty: Option<&Ty> = Option::none();

                        if kind == NodeKind::Parameter {
                            let name_node = child_by!(child, FieldKind::Name);
                            let type_node = child_by!(child, FieldKind::Type);
                            if !name_node.is_none() {
                                name = self.ctx.intern_str(self.ctx.node_text(name_node.unwrap()));
                            }
                            if !type_node.is_none() {
                                ty = Option::some(pass2.parse_type(type_node.unwrap(), lambda_scope));
                            }
                        } else {
                            name = self.ctx.intern_str(self.ctx.node_text(child));
                        }

                        // Register lambda param in the lambda scope
                        self.ctx.scopes.add_item(lambda_scope, NamedItem {
                            name: name,
                            kind: NamedItemKind::local(id),
                            span: self.ctx.make_span(child),
                        });

                        params.push(LambdaParam {
                            id: id,
                            name: name,
                            ty: ty,
                        });
                    }
                }
            }
        }

        let pass2 = Pass2 { ctx: self.ctx };
        let ret_node = child_by!(node, FieldKind::ReturnType);
        let ret_ty: Option<&Ty> = if !ret_node.is_none() {
            Option::some(pass2.parse_type(ret_node.unwrap(), lambda_scope))
        } else {
            Option::none()
        };

        // Parse body in the lambda scope
        let lambda_parser = ExprParser::new(self.ctx, lambda_scope);
        let body = lambda_parser.parse_expr(body_node.unwrap());

        let e = self.make_expr(ExprTag::Lambda, span);
        e.lambda_params = self.ctx.arena.alloc_slice_copy::<LambdaParam>(params.as_slice());
        e.closure_bindings = self.ctx.arena.alloc_slice_copy::<ClosureBinding>(bindings.as_slice());
        e.opt_ty = ret_ty;
        e.lhs = body;
        // Store the self_param_id for use in mono
        e.id = self_param_id;
        self.ctx.alloc_expr(e)
    }

    fn parse_defer(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let inner = child_by!(node, FieldKind::Inner);
        if inner.is_none() {
            return self.alloc_void(span);
        }

        let e = self.make_expr(ExprTag::Defer, span);
        e.lhs = self.parse_expr(inner.unwrap());
        self.ctx.alloc_expr(e)
    }

    fn parse_try(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let inner = child_by!(node, FieldKind::Inner);
        if inner.is_none() {
            return self.alloc_void(span);
        }

        let inner_expr = self.parse_expr(inner.unwrap());

        // Desugar expr? to try!(expr) macro invocation, matching alumina-boot.
        // Look up the "try" macro in scope.
        let name = self.ctx.intern_str("try");
        let macro_entry = self.ctx.macro_defs.get(&name);
        if macro_entry.is_some() {
            let entry = macro_entry.unwrap();

            let try_args = self.ctx.arena.alloc_slice::<&Expr>(1usize);
            try_args[0] = inner_expr;
            return self.do_expand_macro(entry, try_args, span);
        }

        // Fallback: no try macro in scope, use hardcoded IR lowering
        let e = self.make_expr(ExprTag::Try, span);
        e.lhs = inner_expr;
        self.ctx.alloc_expr(e)
    }

    fn parse_range(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let lower = child_by!(node, FieldKind::Lower);
        let upper = child_by!(node, FieldKind::Upper);
        let inclusive_node = child_by!(node, FieldKind::Inclusive);

        let e = self.make_expr(ExprTag::Range, span);
        e.flag = if !inclusive_node.is_none() {
            let text = self.ctx.node_text(inclusive_node.unwrap());
            text.len() == 3  // "..=" is 3 bytes, ".." is 2 bytes
        } else {
            false
        };

        if !lower.is_none() {
            e.lhs = self.parse_expr(lower.unwrap());
        }
        if !upper.is_none() {
            e.rhs = self.parse_expr(upper.unwrap());
        }
        self.ctx.alloc_expr(e)
    }

    fn parse_macro_invocation(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let name_node = child_by!(node, FieldKind::Macro);
        let args_node = child_by!(node, FieldKind::Arguments);

        if name_node.is_none() {
            return self.alloc_void(span);
        }

        let name = self.ctx.intern_str(self.ctx.node_text(name_node.unwrap()));
        let args = if !args_node.is_none() {
            self.parse_arg_list(args_node.unwrap())
        } else {
            let empty: &[&Expr] = &[];
            empty
        };

        // When pre-parsing a macro body, store as ExprTag::MacroInvocation without expanding
        if self.ctx.in_macro_body {
            let e = self.make_expr(ExprTag::MacroInvocation, span);
            e.str_val = name;
            e.args = args;
            e.flag = true;  // Mark as actual invocation (not bare macro reference)
            return self.ctx.alloc_expr(e);
        }

        // Try to expand the macro
        let macro_entry = self.ctx.macro_defs.get(&name);
        if macro_entry.is_some() {
            let entry = macro_entry.unwrap();

            // Handle builtin macros with special compiler logic
            if entry.is_builtin {
                return self.expand_builtin_macro(name, args, span);
            }

            // Expand using pre-parsed body
            return self.do_expand_macro(entry, args, span);
        }

        // Fallback: unresolved macro invocation
        let e = self.make_expr(ExprTag::MacroInvocation, span);
        e.str_val = name;
        e.args = args;
        self.ctx.alloc_expr(e)
    }

    // Expand a builtin macro (one with the #[builtin] attribute).
    // Dispatches to specialized logic based on macro name.
    fn expand_builtin_macro(self: &ExprParser, name: &[u8], args: &[&Expr], span: Span) -> &Expr {
        switch name {
        "cfg" => {
            // cfg!(flag) -> bool literal
            if args.len() > 0usize && args[0].tag == ExprTag::StringLit {
                let flag = args[0].str_val;
                let e = self.make_expr(ExprTag::BoolLit, span);
                e.bool_val = self.ctx.has_cfg(flag);
                return self.ctx.alloc_expr(e);
            }
            let e = self.make_expr(ExprTag::BoolLit, span);
            e.bool_val = false;
            self.ctx.alloc_expr(e)
        }
        "line" => {
            let line: u64 = 0;
            if span.file_id < self.ctx.diag.files.len() as u32 {
                let file = &self.ctx.diag.files[span.file_id as usize];
                let (l, _c) = file.line_col(span.start);
                line = l as u64;
            }
            let e = self.make_expr(ExprTag::IntLit, span);
            e.int_val = line;
            self.ctx.alloc_expr(e)
        }
        "column" => {
            let col: u64 = 0;
            if span.file_id < self.ctx.diag.files.len() as u32 {
                let file = &self.ctx.diag.files[span.file_id as usize];
                let (_l, c) = file.line_col(span.start);
                col = c as u64;
            }
            let e = self.make_expr(ExprTag::IntLit, span);
            e.int_val = col;
            self.ctx.alloc_expr(e)
        }
        "file" => {
            let path: &[u8] = "";
            if span.file_id < self.ctx.diag.files.len() as u32 {
                let file = &self.ctx.diag.files[span.file_id as usize];
                path = file.path;
            }
            let e = self.make_expr(ExprTag::StringLit, span);
            e.str_val = path;
            self.ctx.alloc_expr(e)
        }
        "stringify" => {
            let text: &[u8] = "";
            if args.len() > 0usize {
                let arg = args[0];
                if arg.span.start < arg.span.end {
                    if arg.span.file_id < self.ctx.diag.files.len() as u32 {
                        let file = &self.ctx.diag.files[arg.span.file_id as usize];
                        let start = arg.span.start as usize;
                        let end = arg.span.end as usize;
                        if end <= file.contents.len() {
                            text = self.ctx.intern_str(file.contents[start..end]);
                        }
                    }
                }
            }
            let e = self.make_expr(ExprTag::StringLit, span);
            e.str_val = text;
            self.ctx.alloc_expr(e)
        }
        "env" => {
            let value: &[u8] = "";
            if args.len() > 0usize && args[0].tag == ExprTag::StringLit {
                let var_name = args[0].str_val;
                let buf = self.ctx.arena.alloc_slice::<u8>(var_name.len() + 1);
                var_name.copy_to_nonoverlapping(&buf[0]);
                buf[var_name.len()] = 0u8;
                let result = libc::getenv(&buf[0] as &libc::c_char);
                if result as usize != 0usize {
                    let len: usize = 0;
                    while *((result as usize + len) as &u8) != 0u8 {
                        len = len + 1;
                    }
                    let val_buf = self.ctx.arena.alloc_slice::<u8>(len);
                    for i in 0usize..len {
                        val_buf[i] = *((result as usize + i) as &u8);
                    }
                    value = val_buf;
                }
            }
            let e = self.make_expr(ExprTag::StringLit, span);
            e.str_val = value;
            self.ctx.alloc_expr(e)
        }
        "concat" => {
            let total_len: usize = 0;
            for i in 0usize..args.len() {
                if args[i].tag == ExprTag::StringLit {
                    total_len = total_len + args[i].str_val.len();
                }
            }
            let buf = self.ctx.arena.alloc_slice::<u8>(total_len);
            let offset: usize = 0;
            for i in 0usize..args.len() {
                if args[i].tag == ExprTag::StringLit {
                    let s = args[i].str_val;
                    for j in 0usize..s.len() {
                        buf[offset + j] = s[j];
                    }
                    offset = offset + s.len();
                }
            }
            let e = self.make_expr(ExprTag::StringLit, span);
            e.str_val = buf;
            self.ctx.alloc_expr(e)
        }
        "include_bytes" => {
            if args.len() > 0usize && args[0].tag == ExprTag::StringLit {
                let path = args[0].str_val;
                let path_buf = self.ctx.arena.alloc_slice::<u8>(path.len() + 1);
                path.copy_to_nonoverlapping(&path_buf[0]);
                path_buf[path.len()] = 0u8;
                let fp = libc::fopen(&path_buf[0] as &libc::c_char, &"rb\0"[0] as &libc::c_char);
                if fp as usize != 0usize {
                    libc::fseek(fp, 0i64, 2i32); // SEEK_END
                    let size = libc::ftell(fp) as usize;
                    libc::fseek(fp, 0i64, 0i32); // SEEK_SET
                    let data = self.ctx.arena.alloc_slice::<u8>(size);
                    libc::fread(&data[0] as &mut libc::c_void, 1usize, size, fp);
                    libc::fclose(fp);
                    let e = self.make_expr(ExprTag::StringLit, span);
                    e.str_val = data;
                    return self.ctx.alloc_expr(e);
                }
            }
            let e = self.make_expr(ExprTag::StringLit, span);
            e.str_val = "";
            self.ctx.alloc_expr(e)
        }
        "format_args" => self.expand_format_args(args, span),
        "bind" => {
            if args.len() == 0usize {
                return self.alloc_void(span);
            }
            let macro_ref = args[0];
            let macro_name: &[u8] = "";
            let prev_bound: &[&Expr] = &[];
            if macro_ref.tag == ExprTag::MacroInvocation {
                macro_name = macro_ref.str_val;
                prev_bound = macro_ref.args;
            }
            let new_bound_count = prev_bound.len() + args.len() - 1;
            let bound_args = self.ctx.arena.alloc_slice::<&Expr>(new_bound_count);
            for i in 0usize..prev_bound.len() {
                bound_args[i] = prev_bound[i];
            }
            for i in 1usize..args.len() {
                bound_args[prev_bound.len() + i - 1] = args[i];
            }
            let e = self.make_expr(ExprTag::MacroInvocation, span);
            e.str_val = macro_name;
            e.args = bound_args;
            self.ctx.alloc_expr(e)
        }
        "reduce" => {
            if args.len() < 2usize {
                return self.alloc_void(span);
            }
            let macro_ref = args[0];
            let macro_name: &[u8] = "";
            let prev_bound: &[&Expr] = &[];
            if macro_ref.tag == ExprTag::MacroInvocation {
                macro_name = macro_ref.str_val;
                prev_bound = macro_ref.args;
            }
            let accumulator: &Expr = args[1];
            for i in 2usize..args.len() {
                let total = prev_bound.len() + 2;
                let call_args = self.ctx.arena.alloc_slice::<&Expr>(total);
                for j in 0usize..prev_bound.len() {
                    call_args[j] = prev_bound[j];
                }
                call_args[prev_bound.len()] = accumulator;
                call_args[prev_bound.len() + 1] = args[i];
                let macro_entry = self.ctx.macro_defs.get(&macro_name);
                if macro_entry.is_some() {
                    let entry = macro_entry.unwrap();
                    accumulator = self.do_expand_macro(entry, call_args, span);
                }
            }
            accumulator
        }
        "count" => {
            let e = self.make_expr(ExprTag::IntLit, span);
            e.int_val = args.len() as u64;
            self.ctx.alloc_expr(e)
        }
        _ => self.alloc_void(span),
        }
    }

    // Expand format_args!(wrapper_macro, fmt_string, args...)
    // Parses the format string, generates interleaved string pieces and argument
    // references, then calls the wrapper macro with all pieces.
    fn expand_format_args(self: &ExprParser, args: &[&Expr], span: Span) -> &Expr {
        if args.len() < 2usize {
            return self.alloc_void(span);
        }

        // First arg should be a macro reference (ExprTag::MacroInvocation with no args,
        // or a bound macro). We need to find the macro name.
        let wrapper_expr = args[0];
        let fmt_str_expr = args[1];

        // Format string must be a string literal
        if fmt_str_expr.tag != ExprTag::StringLit {
            return self.alloc_void(span);
        }
        let fmt_str = fmt_str_expr.str_val;

        // Parse the format string into pieces
        let pieces: Vector<&Expr> = Vector::new();
        defer pieces.free();

        // Collect bound args from wrapper (if it's a bound macro / ExprTag::MacroInvocation)
        // In practice, wrapper is passed as a macro parameter ($fmt) which is just an Expr.
        // We need to figure out the wrapper macro name and any bound args.
        // For now, collect interleaved pieces.

        let num_format_args = args.len() - 2;
        let string_part: Vector<u8> = Vector::new();
        defer string_part.free();
        let next_arg_idx: usize = 0;
        let parse_ok = true;

        let i: usize = 0;
        while i < fmt_str.len() {
            if fmt_str[i] == '{' as u8 {
                if i + 1 < fmt_str.len() && fmt_str[i + 1] == '{' as u8 {
                    // Escaped brace: {{ -> {
                    string_part.push('{' as u8);
                    i = i + 2;
                } else {
                    // Start of format placeholder
                    // Flush current string part
                    if string_part.len() > 0usize {
                        let e = self.make_expr(ExprTag::StringLit, span);
                        e.str_val = self.ctx.arena.alloc_slice_copy::<u8>(string_part.as_slice());
                        pieces.push(self.ctx.alloc_expr(e));
                        string_part.clear();
                    }

                    // Parse the placeholder: {}, {0}, {1}, etc.
                    i = i + 1;
                    let arg_idx = next_arg_idx;
                    let has_explicit_idx = false;
                    let explicit_idx: usize = 0;

                    while i < fmt_str.len() && fmt_str[i] != '}' as u8 {
                        if fmt_str[i] >= '0' as u8 && fmt_str[i] <= '9' as u8 {
                            has_explicit_idx = true;
                            explicit_idx = explicit_idx * 10 + (fmt_str[i] - '0' as u8) as usize;
                        }
                        i = i + 1;
                    }

                    if has_explicit_idx {
                        arg_idx = explicit_idx;
                    } else {
                        next_arg_idx = next_arg_idx + 1;
                    }

                    // Add the argument reference
                    if arg_idx < num_format_args {
                        pieces.push(args[arg_idx + 2]);
                    }

                    if i < fmt_str.len() {
                        i = i + 1; // skip closing }
                    }
                }
            } else if fmt_str[i] == '}' as u8 {
                if i + 1 < fmt_str.len() && fmt_str[i + 1] == '}' as u8 {
                    // Escaped brace: }} -> }
                    string_part.push('}' as u8);
                    i = i + 2;
                } else {
                    // Stray }
                    i = i + 1;
                }
            } else {
                string_part.push(fmt_str[i]);
                i = i + 1;
            }
        }

        // Flush remaining string part
        if string_part.len() > 0usize {
            let e = self.make_expr(ExprTag::StringLit, span);
            e.str_val = self.ctx.arena.alloc_slice_copy::<u8>(string_part.as_slice());
            pieces.push(self.ctx.alloc_expr(e));
        }

        // Now invoke the wrapper macro with the pieces.
        // The wrapper is args[0], which should be a macro reference.
        // We need to expand: wrapper_macro(pieces...)
        // The wrapper is typically passed as bind!(static_format_args, fmt),
        // which means args[0] is an ExprTag::MacroInvocation.
        //
        // However, in aluminac's macro system, bound macros are tricky since
        // we don't have first-class macro values. The wrapper is passed as a $param
        // which is whatever expression was substituted.
        //
        // For now, if wrapper is an ExprTag::MacroInvocation, invoke that macro with
        // the collected pieces as args.
        if wrapper_expr.tag == ExprTag::MacroInvocation {
            let wrapper_name = wrapper_expr.str_val;
            // Combine wrapper's existing args with format pieces
            let wrapper_args = wrapper_expr.args;
            let total_args = wrapper_args.len() + pieces.len();
            let all_args = self.ctx.arena.alloc_slice::<&Expr>(total_args);
            for j in 0usize..wrapper_args.len() {
                all_args[j] = wrapper_args[j];
            }
            for j in 0usize..pieces.len() {
                all_args[wrapper_args.len() + j] = pieces[j];
            }

            // Look up and expand the macro using pre-parsed body
            let macro_entry = self.ctx.macro_defs.get(&wrapper_name);
            if macro_entry.is_some() {
                let entry = macro_entry.unwrap();
                return self.do_expand_macro(entry, all_args, span);
            }
        }

        // Fallback: return void
        self.alloc_void(span)
    }

    fn parse_universal_macro(self: &ExprParser, node: Node, span: Span) -> &Expr {
        // obj.macro!(args)
        let value = child_by!(node, FieldKind::Value);
        let macro_node = child_by!(node, FieldKind::Macro);
        let args_node = child_by!(node, FieldKind::Arguments);

        if value.is_none() || macro_node.is_none() {
            return self.alloc_void(span);
        }

        let obj = self.parse_expr(value.unwrap());
        let name = self.ctx.intern_str(self.ctx.node_text(macro_node.unwrap()));

        let all_args: Vector<&Expr> = Vector::new();
        defer all_args.free();
        all_args.push(obj);

        if !args_node.is_none() {
            let extra_args = self.parse_arg_list(args_node.unwrap());
            for i in 0usize..extra_args.len() {
                all_args.push(extra_args[i]);
            }
        }

        let args_slice = self.ctx.arena.alloc_slice_copy::<&Expr>(all_args.as_slice());

        // Try to expand the macro
        let macro_entry = self.ctx.macro_defs.get(&name);
        if macro_entry.is_some() {
            let entry = macro_entry.unwrap();

            if entry.is_builtin {
                return self.expand_builtin_macro(name, args_slice, span);
            }

            return self.do_expand_macro(entry, args_slice, span);
        }

        let e = self.make_expr(ExprTag::MacroInvocation, span);
        e.str_val = name;
        e.args = args_slice;
        self.ctx.alloc_expr(e)
    }

    fn parse_static_for(self: &ExprParser, node: Node, span: Span) -> &Expr {
        // Grammar: for const name in value { body }
        // Fields: name (identifier), value (expression), body (block)
        let name_node = child_by!(node, FieldKind::Name);
        let iter_node = child_by!(node, FieldKind::Value);
        let body = child_by!(node, FieldKind::Body);

        if name_node.is_none() || iter_node.is_none() || body.is_none() {
            return self.alloc_void(span);
        }

        let var_id = self.ctx.next_id();
        let var_name = self.ctx.intern_str(self.ctx.node_text(name_node.unwrap()));

        // Create a child scope for the loop so the loop variable is accessible in the body
        let loop_scope = self.ctx.scopes.create_scope(ScopeKind::Block, Option::some(self.scope_idx));
        let loop_parser = ExprParser::new(self.ctx, loop_scope);

        // Register the loop variable in the child scope
        self.ctx.scopes.add_item(loop_scope, NamedItem {
            name: var_name,
            kind: NamedItemKind::local(var_id),
            span: self.ctx.make_span(name_node.unwrap()),
        });

        let e = self.make_expr(ExprTag::StaticFor, span);
        e.id = var_id;
        e.lhs = self.parse_expr(iter_node.unwrap()); // iter parsed in parent scope
        e.rhs = loop_parser.parse_expr(body.unwrap()); // body parsed in child scope
        self.ctx.alloc_expr(e)
    }

    fn parse_et_cetera(self: &ExprParser, node: Node, span: Span) -> &Expr {
        let inner = child_by!(node, FieldKind::Inner);
        if inner.is_none() {
            return self.alloc_void(span);
        }

        let e = self.make_expr(ExprTag::EtCetera, span);
        e.lhs = self.parse_expr(inner.unwrap());
        self.ctx.alloc_expr(e)
    }

    // === AST-based macro expansion ===

    // Entry point: expand a macro with pre-parsed body.
    // Sets up param_args and variadic_args, then calls expand_macro_expr.
    fn do_expand_macro(self: &ExprParser, entry: MacroEntry, call_args: &[&Expr], span: Span) -> &Expr {
        let param_count = entry.params.len();
        let param_args = self.ctx.arena.alloc_slice::<&Expr>(param_count);
        let variadic_args: &[&Expr] = &[];

        if entry.variadic_param_idx != NO_VARIADIC {
            let vi = entry.variadic_param_idx as usize;
            // Non-variadic params before variadic
            for i in 0usize..vi {
                if i < call_args.len() {
                    param_args[i] = call_args[i];
                } else {
                    param_args[i] = self.alloc_void(span);
                }
            }
            // Variadic args: everything between non-variadic params
            let non_variadic_count = param_count - 1; // exclude the variadic param itself
            let etc_count = if call_args.len() > non_variadic_count {
                call_args.len() - non_variadic_count
            } else {
                0usize
            };
            let etc_args = self.ctx.arena.alloc_slice::<&Expr>(etc_count);
            for i in 0usize..etc_count {
                etc_args[i] = call_args[vi + i];
            }
            variadic_args = etc_args;
            // Placeholder for variadic param slot
            param_args[vi] = self.alloc_void(span);
            // Non-variadic params after variadic
            for i in vi + 1..param_count {
                let arg_idx = i + etc_count - 1;
                if arg_idx < call_args.len() {
                    param_args[i] = call_args[arg_idx];
                } else {
                    param_args[i] = self.alloc_void(span);
                }
            }
        } else {
            for i in 0usize..param_count {
                if i < call_args.len() {
                    param_args[i] = call_args[i];
                } else {
                    param_args[i] = self.alloc_void(span);
                }
            }
        }

        // Create ID replacement map for hygiene
        let id_map: HashMap<usize, Id> = HashMap::new();
        defer id_map.free();

        let result = self.expand_macro_expr(
            entry.body,
            param_args,
            variadic_args,
            entry.variadic_param_idx,
            NO_VARIADIC,  // not in et cetera
            &id_map,
        );
        result
    }

    // Recursively expand a pre-parsed macro body expression.
    // Substitutes ExprTag::MacroParam with args, expands ExprTag::EtCetera,
    // and recursively expands nested ExprTag::MacroInvocation.
    fn expand_macro_expr(
        self: &ExprParser,
        expr: &Expr,
        param_args: &[&Expr],
        variadic_args: &[&Expr],
        variadic_param_idx: i32,
        et_cetera_idx: i32,
        id_map: &mut HashMap<usize, Id>,
    ) -> &Expr {
        // Substitute macro parameter
        if expr.tag == ExprTag::MacroParam {
            let idx = expr.int_val as i32;
            if expr.flag && et_cetera_idx != NO_VARIADIC {
                // Variadic param in et cetera context
                let vi = et_cetera_idx as usize;
                if vi < variadic_args.len() {
                    return variadic_args[vi];
                }
                return self.alloc_void(expr.span);
            }
            if idx >= 0i32 && (idx as usize) < param_args.len() {
                return param_args[idx as usize];
            }
            return self.alloc_void(expr.span);
        }

        // Expand nested macro invocation (only actual invocations, not bare references)
        if expr.tag == ExprTag::MacroInvocation && expr.flag {
            // First expand the args
            let expanded_args = self.expand_macro_args_list(
                expr.args, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map
            );
            // Look up the macro
            let macro_entry = self.ctx.macro_defs.get(&expr.str_val);
            if macro_entry.is_some() {
                let entry = macro_entry.unwrap();
                if entry.is_builtin {
                    return self.expand_builtin_macro(expr.str_val, expanded_args, expr.span);
                }
                return self.do_expand_macro(entry, expanded_args, expr.span);
            }
            // Unresolved macro - keep with expanded args
            let e = *expr;
            e.args = expanded_args;
            return self.ctx.alloc_expr(e);
        }

        // Leaf expressions that don't need expansion
        if expr.tag == ExprTag::IntLit || expr.tag == ExprTag::FloatLit ||
           expr.tag == ExprTag::BoolLit || expr.tag == ExprTag::StringLit ||
           expr.tag == ExprTag::CharLit || expr.tag == ExprTag::NullLit ||
           expr.tag == ExprTag::Void || expr.tag == ExprTag::Zeroed {
            return expr;
        }

        // For non-macro identifiers (resolved at pre-parse time), just return as-is
        if expr.tag == ExprTag::Local || expr.tag == ExprTag::Param ||
           expr.tag == ExprTag::StaticRef || expr.tag == ExprTag::FnRef ||
           expr.tag == ExprTag::EnumRef || expr.tag == ExprTag::BoundValue {
            // Check if this local needs ID remapping (hygiene)
            if expr.tag == ExprTag::Local {
                let mapped = id_map.get(&expr.id._value);
                if mapped.is_some() {
                    let e = *expr;
                    e.id = mapped.unwrap();
                    return self.ctx.alloc_expr(e);
                }
            }
            return expr;
        }

        // Clone the expression and recursively expand children
        let e = *expr;

        // Generate fresh ID for let bindings (hygiene)
        if e.tag == ExprTag::Let {
            let new_id = self.ctx.next_id();
            id_map.insert(e.id._value, new_id);
            e.id = new_id;
            // Register the new local in scope so it can be referenced
            self.ctx.scopes.add_item(self.scope_idx, NamedItem {
                name: e.str_val,
                kind: NamedItemKind::local(new_id),
                span: e.span,
            });
        }

        // Expand sub-expressions
        if e.lhs as &void as usize != 0usize {
            e.lhs = self.expand_macro_expr(e.lhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
        }
        if e.rhs as &void as usize != 0usize {
            e.rhs = self.expand_macro_expr(e.rhs, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
        }
        if e.cond as &void as usize != 0usize {
            e.cond = self.expand_macro_expr(e.cond, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
        }

        // Expand arg lists (handling et cetera)
        if e.args.len() > 0usize {
            e.args = self.expand_macro_args_list(e.args, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
        }

        // Expand optional expression
        if e.opt_expr.is_some() {
            e.opt_expr = Option::some(self.expand_macro_expr(e.opt_expr.unwrap(), param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map));
        }

        // Expand switch arms
        if e.switch_arms.len() > 0usize {
            let new_arms = self.ctx.arena.alloc_slice::<SwitchArm>(e.switch_arms.len());
            for i in 0usize..e.switch_arms.len() {
                let arm = e.switch_arms[i];
                let new_patterns = self.ctx.arena.alloc_slice::<&Expr>(arm.pattern.len());
                for j in 0usize..arm.pattern.len() {
                    new_patterns[j] = self.expand_macro_expr(arm.pattern[j], param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map);
                }
                new_arms[i] = SwitchArm {
                    pattern: new_patterns,
                    body: self.expand_macro_expr(arm.body, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map),
                };
            }
            e.switch_arms = new_arms;
        }

        // Expand field inits
        if e.field_inits.len() > 0usize {
            let new_inits = self.ctx.arena.alloc_slice::<FieldInit>(e.field_inits.len());
            for i in 0usize..e.field_inits.len() {
                new_inits[i] = FieldInit {
                    name: e.field_inits[i].name,
                    value: self.expand_macro_expr(e.field_inits[i].value, param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map),
                };
            }
            e.field_inits = new_inits;
        }

        // Expand lambda params (their types use Ty, not Expr - skip for now)
        // Lambda bodies are in lhs, already handled above

        self.ctx.alloc_expr(e)
    }

    // Expand an argument list, handling ExprTag::EtCetera by unrolling variadic args.
    fn expand_macro_args_list(
        self: &ExprParser,
        args: &[&Expr],
        param_args: &[&Expr],
        variadic_args: &[&Expr],
        variadic_param_idx: i32,
        et_cetera_idx: i32,
        id_map: &mut HashMap<usize, Id>,
    ) -> &[&Expr] {
        let result: Vector<&Expr> = Vector::new();
        defer result.free();

        for i in 0usize..args.len() {
            if args[i].tag == ExprTag::EtCetera {
                // Expand inner expression for each variadic arg
                let inner = args[i].lhs;
                for vi in 0usize..variadic_args.len() {
                    result.push(self.expand_macro_expr(
                        inner, param_args, variadic_args, variadic_param_idx, vi as i32, id_map
                    ));
                }
            } else {
                result.push(self.expand_macro_expr(
                    args[i], param_args, variadic_args, variadic_param_idx, et_cetera_idx, id_map
                ));
            }
        }

        self.ctx.arena.alloc_slice_copy::<&Expr>(result.as_slice())
    }
}

// ============================================================
// Utility functions
// ============================================================

fn parse_usize(text: &[u8]) -> usize {
    let result: usize = 0;
    for i in 0usize..text.len() {
        let c = text[i];
        if c >= '0' as u8 && c <= '9' as u8 {
            result = result * 10 + (c - '0' as u8) as usize;
        } else if c == '_' as u8 {
            // Skip underscores in numeric literals
        } else {
            break;
        }
    }
    result
}

fn parse_int_with_suffix(text: &[u8]) -> (u64, Option<BuiltinType>) {
    let value: u64 = 0;
    let base: u64 = 10;
    let i: usize = 0;
    let negative: bool = false;

    // Check for leading negative sign
    if text.len() > 0 && text[0] == '-' as u8 {
        negative = true;
        i = 1;
    }

    // Check for hex/octal/binary prefix
    if text.len() >= i + 2 && text[i] == '0' as u8 {
        if text[i + 1] == 'x' as u8 || text[i + 1] == 'X' as u8 {
            base = 16;
            i = i + 2;
        } else if text[i + 1] == 'o' as u8 || text[i + 1] == 'O' as u8 {
            base = 8;
            i = i + 2;
        } else if text[i + 1] == 'b' as u8 || text[i + 1] == 'B' as u8 {
            base = 2;
            i = i + 2;
        }
    }

    let suffix_start: usize = text.len();
    while i < text.len() {
        let c = text[i];
        if c == '_' as u8 {
            i = i + 1;
        } else if base == 16 && ((c >= 'a' as u8 && c <= 'f' as u8) || (c >= 'A' as u8 && c <= 'F' as u8)) {
            let digit: u64 = if c >= 'a' as u8 { (c - 'a' as u8 + 10) as u64 } else { (c - 'A' as u8 + 10) as u64 };
            value = value * base + digit;
            i = i + 1;
        } else if c >= '0' as u8 && c <= '9' as u8 {
            value = value * base + (c - '0' as u8) as u64;
            i = i + 1;
        } else {
            suffix_start = i;
            break;
        }
    }

    let suffix = if suffix_start < text.len() {
        let suffix_text = text[suffix_start..];
        parse_builtin_type(suffix_text)
    } else {
        Option::none()
    };

    if negative {
        value = (0u64 - value);
    }

    (value, suffix)
}

fn parse_float(text: &[u8]) -> f64 {
    // Simple float parser - we'll use libc strtod for accuracy
    let cstr = std::ffi::CString::from_slice(text);
    defer cstr.free();

    let end: &mut libc::c_char = null;
    libc::strtod(cstr.ptr, &end)
}

fn parse_binop(text: &[u8]) -> BinOp {
    switch text {
        "+" => BinOp::Add,
        "-" => BinOp::Sub,
        "*" => BinOp::Mul,
        "/" => BinOp::Div,
        "%" => BinOp::Rem,
        "&" => BinOp::BitAnd,
        "|" => BinOp::BitOr,
        "^" => BinOp::BitXor,
        "<<" => BinOp::Shl,
        ">>" => BinOp::Shr,
        "==" => BinOp::Eq,
        "!=" => BinOp::Ne,
        "<" => BinOp::Lt,
        "<=" => BinOp::Le,
        ">" => BinOp::Gt,
        ">=" => BinOp::Ge,
        "&&" => BinOp::And,
        "||" => BinOp::Or,
        _ => BinOp::Add,
    }
}

fn parse_assign_op(text: &[u8]) -> AssignOp {
    switch text {
        "+=" => AssignOp::AddAssign,
        "-=" => AssignOp::SubAssign,
        "*=" => AssignOp::MulAssign,
        "/=" => AssignOp::DivAssign,
        "%=" => AssignOp::RemAssign,
        "&=" => AssignOp::BitAndAssign,
        "|=" => AssignOp::BitOrAssign,
        "^=" => AssignOp::BitXorAssign,
        "<<=" => AssignOp::ShlAssign,
        ">>=" => AssignOp::ShrAssign,
        _ => AssignOp::Assign,
    }
}

fn unescape_string(text: &[u8], arena: &mut Arena) -> &[u8] {
    // Count output length first
    let out_len: usize = 0;
    let i: usize = 0;
    while i < text.len() {
        if text[i] == '\\' as u8 && i + 1 < text.len() {
            i = i + 2;
            if text[i - 1] == 'x' as u8 && i + 1 < text.len() {
                i = i + 2;  // \xNN
            }
        } else {
            i = i + 1;
        }
        out_len = out_len + 1;
    }

    let buf = arena.alloc_slice::<u8>(out_len);
    let j: usize = 0;
    i = 0;
    while i < text.len() {
        if text[i] == '\\' as u8 && i + 1 < text.len() {
            switch text[i + 1] {
                'n' as u8 => { buf[j] = '\n' as u8; },
                'r' as u8 => { buf[j] = '\r' as u8; },
                't' as u8 => { buf[j] = '\t' as u8; },
                '\\' as u8 => { buf[j] = '\\' as u8; },
                '"' as u8 => { buf[j] = '"' as u8; },
                '0' as u8 => { buf[j] = 0u8; },
                'x' as u8 => {
                    if i + 3 < text.len() {
                        let hi = hex_digit(text[i + 2]);
                        let lo = hex_digit(text[i + 3]);
                        buf[j] = ((hi << 4) | lo) as u8;
                        i = i + 2;
                    }
                },
                _ => { buf[j] = text[i + 1]; },
            }
            i = i + 2;
        } else {
            buf[j] = text[i];
            i = i + 1;
        }
        j = j + 1;
    }

    buf[0..j]
}

fn hex_digit(c: u8) -> u8 {
    if c >= '0' as u8 && c <= '9' as u8 { c - '0' as u8 }
    else if c >= 'a' as u8 && c <= 'f' as u8 { c - 'a' as u8 + 10 }
    else if c >= 'A' as u8 && c <= 'F' as u8 { c - 'A' as u8 + 10 }
    else { 0u8 }
}

// ============================================================
// Main entry point for parsing
// ============================================================

fn parse_file(
    root: Node,
    source: &[u8],
    file_id: u32,
    arena: &mut Arena,
    scopes: &mut ScopeArena,
    id_gen: &mut IdGen,
    diag: &mut DiagnosticContext,
    root_scope: u32,
    cfg_flags: &[&[u8]],
) -> &[Item] {
    let ctx = ParseContext::new(arena, scopes, id_gen, diag, source, file_id, cfg_flags);
    defer ctx.free();

    // Pass 1: build scopes
    let pass1 = Pass1::new(&ctx, root_scope);
    pass1.run(root);

    // Pass 2: construct AST
    let pass2 = Pass2::new(&ctx);
    pass2.run(root);

    arena.alloc_slice_copy::<Item>(ctx.items.as_slice())
}

// Two-phase parsing: run all Pass1s across all files first to register all names
// in scopes, then run all Pass2s to parse bodies (which may reference any name).
// This fixes cross-module references where file B references a name defined in file A
// but file A hasn't been parsed yet.

fn parse_file_pass1(
    root: Node,
    source: &[u8],
    file_id: u32,
    arena: &mut Arena,
    scopes: &mut ScopeArena,
    id_gen: &mut IdGen,
    diag: &mut DiagnosticContext,
    root_scope: u32,
    cfg_flags: &[&[u8]],
) -> ParseContext {
    let ctx = ParseContext::new(arena, scopes, id_gen, diag, source, file_id, cfg_flags);

    // Pass 1: build scopes and register all names
    let pass1 = Pass1::new(&ctx, root_scope);
    pass1.run(root);

    ctx
}

fn collect_macros(ctx: &mut ParseContext, root: Node) {
    let pass2 = Pass2::new(ctx);
    pass2.process_macros(root);
}

fn share_macros(contexts: &mut [ParseContext]) {
    // Collect all macro names+entries from all contexts
    let all_names: Vector<&[u8]> = Vector::new();
    let all_entries: Vector<MacroEntry> = Vector::new();
    defer all_names.free();
    defer all_entries.free();

    for i in 0usize..contexts.len() {
        contexts[i].collect_macro_entries(&all_names, &all_entries);
    }
    // Note: &all_names and &all_entries auto-coerce to &mut since they're local vars

    // Inject all macros into every context
    for i in 0usize..contexts.len() {
        for j in 0usize..all_names.len() {
            if contexts[i].macro_defs.get(&all_names[j]).is_none() {
                contexts[i].macro_defs.insert(all_names[j], all_entries[j]);
            }
        }
    }
}

fn parse_file_pass2(
    ctx: &mut ParseContext,
    root: Node,
) -> &[Item] {
    // Pass 2: construct AST (all names are now registered across all files)
    let pass2 = Pass2::new(ctx);
    pass2.run(root);

    ctx.arena.alloc_slice_copy::<Item>(ctx.items.as_slice())
}

fn format_num_small(n: usize) -> &[u8] {
    if n == 0usize { return "0"; }
    if n == 1usize { return "1"; }
    if n == 2usize { return "2"; }
    if n == 3usize { return "3"; }
    if n == 4usize { return "4"; }
    if n == 5usize { return "5"; }
    if n == 6usize { return "6"; }
    if n == 7usize { return "7"; }
    if n == 8usize { return "8"; }
    if n == 9usize { return "9"; }
    if n < 20usize { return "1X"; }
    if n < 50usize { return "2X-4X"; }
    if n < 100usize { return "5X-9X"; }
    "100++"
}
