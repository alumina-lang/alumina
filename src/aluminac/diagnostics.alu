// Diagnostics and error reporting for the self-hosted compiler

use ast::Span;
use std::collections::Vector;

enum DiagLevel {
    Error,
    Warning,
    Note,
}

struct Diagnostic {
    level: DiagLevel,
    message: &[u8],
    span: Span,
}

struct SourceFile {
    path: &[u8],
    contents: &[u8],
    // Line start offsets for line number lookup
    line_starts: &[u32],
}

impl SourceFile {
    fn line_col(self: &SourceFile, offset: u32) -> (u32, u32) {
        // Binary search for line number
        let lo: usize = 0;
        let hi: usize = self.line_starts.len();
        while lo < hi {
            let mid = lo + (hi - lo) / 2;
            if self.line_starts[mid] <= offset {
                lo = mid + 1;
            } else {
                hi = mid;
            }
        }
        let line = lo as u32; // 1-based
        let col = offset - self.line_starts[lo - 1] + 1; // 1-based
        (line, col)
    }
}

fn compute_line_starts(contents: &[u8], arena: &mut aluminac_common::arena::Arena) -> &[u32] {
    // Count lines first
    let count: usize = 1;
    for i in 0usize..contents.len() {
        if contents[i] == '\n' as u8 {
            count = count + 1;
        }
    }
    let starts = arena.alloc_slice::<u32>(count);
    starts[0] = 0;
    let idx: usize = 1;
    for i in 0usize..contents.len() {
        if contents[i] == '\n' as u8 {
            if idx < count {
                starts[idx] = (i + 1) as u32;
                idx = idx + 1;
            }
        }
    }
    starts[0..idx]
}

struct DiagnosticContext {
    files: std::collections::Vector<SourceFile>,
    errors: std::collections::Vector<Diagnostic>,
    has_errors: bool,
}

impl DiagnosticContext {
    fn new() -> DiagnosticContext {
        DiagnosticContext {
            files: std::collections::Vector::new(),
            errors: std::collections::Vector::new(),
            has_errors: false,
        }
    }

    fn add_file(self: &mut DiagnosticContext, path: &[u8], contents: &[u8], arena: &mut aluminac_common::arena::Arena) -> u32 {
        let id = self.files.len() as u32;
        let line_starts = compute_line_starts(contents, arena);
        self.files.push(SourceFile {
            path: path,
            contents: contents,
            line_starts: line_starts,
        });
        id
    }

    fn error(self: &mut DiagnosticContext, span: Span, message: &[u8]) {
        self.has_errors = true;
        self.errors.push(Diagnostic {
            level: DiagLevel::Error,
            message: message,
            span: span,
        });
    }

    fn warning(self: &mut DiagnosticContext, span: Span, message: &[u8]) {
        self.errors.push(Diagnostic {
            level: DiagLevel::Warning,
            message: message,
            span: span,
        });
    }

    fn _write_stderr(s: &[u8]) {
        if s.len() > 0usize {
            libc::write(2i32, &s[0] as &libc::c_void, s.len());
        }
    }

    fn _write_u32(n: u32) {
        if n == 0u32 {
            DiagnosticContext::_write_stderr("0");
            return;
        }
        let buf: [u8; 16];
        let pos: usize = 15usize;
        let val = n;
        while val > 0u32 {
            pos = pos - 1usize;
            buf[pos] = (val % 10u32) as u8 + '0' as u8;
            val = val / 10u32;
        }
        DiagnosticContext::_write_stderr(buf[pos..15usize]);
    }

    fn emit_all(self: &DiagnosticContext) {
        for i in 0usize..self.errors.len() {
            let diag = self.errors[i];
            let level_str: &[u8] = switch diag.level {
                DiagLevel::Error => "error",
                DiagLevel::Warning => "warning",
                _ => "note",
            };

            DiagnosticContext::_write_stderr(level_str);
            DiagnosticContext::_write_stderr(": ");
            DiagnosticContext::_write_stderr(diag.message);

            if diag.span.file_id < self.files.len() as u32 {
                let file = &self.files[diag.span.file_id as usize];
                let (line, col) = file.line_col(diag.span.start);
                DiagnosticContext::_write_stderr("\n  --> ");
                DiagnosticContext::_write_stderr(file.path);
                DiagnosticContext::_write_stderr(":");
                DiagnosticContext::_write_u32(line);
                DiagnosticContext::_write_stderr(":");
                DiagnosticContext::_write_u32(col);
            }
            DiagnosticContext::_write_stderr("\n");
        }
    }

    // Format an error message with up to 3 parts: prefix + name + suffix
    // e.g. format_msg(arena, "could not resolve field '", "foo", "' on type")
    fn format_msg(arena: &mut aluminac_common::arena::Arena, a: &[u8], b: &[u8], c: &[u8]) -> &[u8] {
        let total = a.len() + b.len() + c.len();
        let buf = arena.alloc_slice::<u8>(total);
        let pos: usize = 0;
        for i in 0usize..a.len() { buf[pos + i] = a[i]; }
        pos = pos + a.len();
        for i in 0usize..b.len() { buf[pos + i] = b[i]; }
        pos = pos + b.len();
        for i in 0usize..c.len() { buf[pos + i] = c[i]; }
        buf as &[u8]
    }

    fn note(self: &mut DiagnosticContext, span: Span, message: &[u8]) {
        self.errors.push(Diagnostic {
            level: DiagLevel::Note,
            message: message,
            span: span,
        });
    }

    // Concatenate an arbitrary number of string parts into a single arena-allocated string
    fn concat_parts(arena: &mut aluminac_common::arena::Arena, parts: &[&[u8]]) -> &[u8] {
        let total: usize = 0;
        for i in 0usize..parts.len() {
            total = total + parts[i].len();
        }
        let buf = arena.alloc_slice::<u8>(total);
        let pos: usize = 0;
        for i in 0usize..parts.len() {
            for j in 0usize..parts[i].len() {
                buf[pos + j] = parts[i][j];
            }
            pos = pos + parts[i].len();
        }
        buf as &[u8]
    }

    fn format_msg4(arena: &mut aluminac_common::arena::Arena, a: &[u8], b: &[u8], c: &[u8], d: &[u8]) -> &[u8] {
        let parts = arena.alloc_slice::<&[u8]>(4);
        parts[0] = a; parts[1] = b; parts[2] = c; parts[3] = d;
        DiagnosticContext::concat_parts(arena, parts)
    }

    fn format_msg5(arena: &mut aluminac_common::arena::Arena, a: &[u8], b: &[u8], c: &[u8], d: &[u8], e: &[u8]) -> &[u8] {
        let parts = arena.alloc_slice::<&[u8]>(5);
        parts[0] = a; parts[1] = b; parts[2] = c; parts[3] = d; parts[4] = e;
        DiagnosticContext::concat_parts(arena, parts)
    }

    fn free(self: &mut DiagnosticContext) {
        self.files.free();
        self.errors.free();
    }
}
