// Const evaluator: an IR interpreter for constant expressions.
//
// Evaluates IrExpr nodes at compile time, producing ConstValue results.
// Used for enum variant values, `when` conditions, const items, array lengths,
// and `const_eval`/`const_bake` intrinsics.

use ast::*;
use ir::*;
use layout::{compute_type_size, compute_type_align, layout_of, AggregateLayout};
use aluminac_common::arena::Arena;
use std::collections::HashMap;
use std::option::Option;
use std::result::try;
use std::fmt::write;

const MAX_RECURSION_DEPTH: usize = 100;
const MAX_ITERATIONS: usize = 1000000;

/// Why an evaluation stopped short of a value: a failure, or control flow
/// passing through the evaluation of enclosing expressions (`break`,
/// `continue`, `return`, the end of an iteration).
enum EvalError {
    Unsupported = 1i32,
    Overflow = 2i32,
    DivZero = 3i32,
    IndexOob = 4i32,
    TooDeep = 5i32,
    TooManyIters = 6i32,
    Break = 7i32,
    Continue = 8i32,
    Return = 9i32,
    StopIter = 10i32,
    ConstPanic = 11i32,
    Unreachable = 12i32,
    UseAfterFree = 13i32,
    InvalidFree = 14i32,
    HeapInResult = 15i32,
}

impl EvalError {
    /// Whether this is a failure (not control flow such as `break`).
    fn is_failure(self: &EvalError) -> bool {
        switch *self {
            EvalError::Break, EvalError::Continue, EvalError::Return, EvalError::StopIter => false,
            _ => true,
        }
    }

    /// Why an evaluation failed, in alumina-boot's words.
    fn reason(self: &EvalError) -> &[u8] {
        switch *self {
            EvalError::Overflow => "arithmetic overflow",
            EvalError::DivZero => "division by zero",
            EvalError::IndexOob => "index out of bounds",
            EvalError::TooDeep => "max recursion depth exceeded",
            EvalError::TooManyIters => "max iterations exceeded",
            EvalError::Unreachable => "reached unreachable code",
            EvalError::ConstPanic => "panic during constant evaluation",
            EvalError::UseAfterFree => "dynamically allocated memory used after being freed",
            EvalError::InvalidFree => "invalid pointer used to free memory",
            EvalError::HeapInResult => "contains dynamically allocated memory during constant evaluation (hint: use std::runtime::bake to bake the value into rodata)",
            _ => "not constant or unsupported expression",
        }
    }

    // (For Result::unwrap's panic message.)
    fn fmt<F: std::fmt::Formatter<F>>(self: &EvalError, f: &mut F) -> std::fmt::Result {
        write!(f, "EvalError({})", *self as i32)
    }
}

/// Where the evaluator first gave up on an expression it cannot evaluate,
/// so that "cannot evaluate at compile time" can point at the culprit.
struct ConstEvalFailure {
    /// Why the evaluation failed.
    code: EvalError,
    /// The innermost enclosing source span (synthesized IR has none).
    span: Span,
    /// The kind of IR node that could not be evaluated.
    what: &[u8],
    /// The function being evaluated when it happened ("" at the top level).
    function: &[u8],
    /// The calls it happened in, innermost first.
    calls: &[ConstEvalCall],
}

/// A call made during a constant evaluation.
struct ConstEvalCall {
    /// The call (its span is empty in synthesized code).
    span: Span,
    function: &[u8],
}

/// An allocation of the evaluator's heap (`const_alloc`).
struct HeapAlloc {
    /// The elements (an array).
    value: ConstValue,
    elem_ty: &IrTy,
    live: bool,
    /// Whether it is to be kept as a constant (`const_bake`).
    baked: bool,
}

/// Everything a constant evaluation produced.
struct ConstEvalOutcome {
    value: Option<ConstValue>,
    /// The allocations the value may point to.
    heap: &HashMap<usize, HeapAlloc>,
    panic_msg: &[u8],
    warning_msg: &[u8],
    note_msg: &[u8],
    failure: Option<ConstEvalFailure>,
}

struct ConstEvaluator {
    arena: &mut Arena,
    // Variable storage: shared across call frames via pointer
    variables: &mut HashMap<usize, ConstValue>,
    // Variable remapping for THIS call frame: original_id -> fresh_id
    remapped: HashMap<usize, usize>,
    // Fresh ID generation for remapping
    id_gen: &mut IdGen,
    // Function lookup (already monomorphized)
    ir_functions: &[IrFunction],
    // Global variable lookup (for const globals)
    ir_globals: &[IrGlobal],
    // Cached const-evaluated values for const globals
    const_values: &HashMap<usize, ConstValue>,
    // Return slot for function calls
    return_slot: ConstValue,
    has_return: bool,
    // Limits
    remaining_depth: usize,
    steps_remaining: usize,
    // Type layout
    pointer_size: usize,
    // Last const_panic message, if one fired during eval. Empty otherwise.
    panic_msg: &[u8],
    // First const_warning / const_note message captured during eval. Single-
    // slot design surfaces only the first of each — adequate for the sysroot's
    // current `if in_const_context()`-gated usage.
    warning_msg: &[u8],
    note_msg: &[u8],
    failure: Option<ConstEvalFailure>,
    current_fn: &[u8],
    // The heap (shared across call frames).
    heap: &mut HashMap<usize, HeapAlloc>,
    // Whether values are as at run time (`in_const_context()` is false),
    // for code that is decided when compiling (as alumina-boot's
    // `ConstEvaluator::for_codegen`).
    run_time: bool,
}

impl ConstEvaluator {
    fn new(
        arena: &mut Arena,
        variables: &mut HashMap<usize, ConstValue>,
        id_gen: &mut IdGen,
        ir_functions: &[IrFunction],
        ir_globals: &[IrGlobal],
        const_values: &HashMap<usize, ConstValue>,
        pointer_size: usize,
    ) -> ConstEvaluator {
        ConstEvaluator {
            arena: arena,
            variables: variables,
            remapped: HashMap::new(),
            id_gen: id_gen,
            ir_functions: ir_functions,
            ir_globals: ir_globals,
            const_values: const_values,
            return_slot: ConstValue::make_void(),
            has_return: false,
            remaining_depth: MAX_RECURSION_DEPTH,
            steps_remaining: MAX_ITERATIONS,
            pointer_size: pointer_size,
            panic_msg: "",
            warning_msg: "",
            note_msg: "",
            failure: Option::none(),
            current_fn: "",
            heap: arena.alloc(HashMap::new::<usize, HeapAlloc>()),
            run_time: false,
        }
    }

    fn step(self: &mut ConstEvaluator) -> bool {
        if self.steps_remaining == 0 {
            return false;
        }
        self.steps_remaining -= 1;
        true
    }

    fn var_id(self: &ConstEvaluator, id: Id) -> usize {
        let remapped = self.remapped.get(&id._value);
        remapped.unwrap_or(id._value)
    }

    fn store_var(self: &mut ConstEvaluator, id: Id, val: ConstValue) {
        let vid = self.var_id(id);
        self.variables.insert(vid, val);
    }

    // Main entry point: evaluate an expression to an rvalue
    fn eval(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let r = self.eval_inner(expr)?;
        // Materialize lvalues
        if r.tag == CValTag::Lvalue {
            let loaded = self.materialize_lvalue(r.lvalue());
            if loaded.is_err() && loaded.unwrap_err().is_failure() {
                self.note_failure(expr, loaded.unwrap_err());
            }
            return loaded;
        }
        Result::ok(r)
    }

    /// The live allocation `id`.
    fn live_alloc(self: &ConstEvaluator, id: Id) -> Result<HeapAlloc, EvalError> {
        let alloc = self.heap.get(&id._value);
        if alloc.is_none() { return Result::err(EvalError::Unsupported); }
        if !alloc.unwrap().live { return Result::err(EvalError::UseAfterFree); }
        Result::ok(alloc.unwrap())
    }

    fn materialize_lvalue(self: &mut ConstEvaluator, lv: &ConstLValue) -> Result<ConstValue, EvalError> {
        if lv.tag == CLVTag::Variable {
            // (A variable of the code around the evaluation has no value to
            // compute with, but can be passed on, e.g. to a method that
            // only needs its type.)
            let v = self.variables.get(&self.var_id(Id { _value: lv.id()._value }));
            Result::ok(v.unwrap_or(ConstValue::make_uninitialized()))
        } else if lv.tag == CLVTag::Alloc {
            self.live_alloc(lv.id()).map(|a: HeapAlloc| -> ConstValue { a.value })
        } else if lv.tag == CLVTag::Field {
            let base = self.materialize_lvalue(lv.inner())?;
            self.access_field(base, lv.field_idx())
        } else if lv.tag == CLVTag::Index {
            let base = self.materialize_lvalue(lv.inner())?;
            self.access_index(base, lv.index())
        } else if lv.tag == CLVTag::TupleIndex {
            let base = self.materialize_lvalue(lv.inner())?;
            self.access_tuple_index(base, lv.index())
        } else {
            Result::err(EvalError::Unsupported)
        }
    }

    fn access_field(self: &ConstEvaluator, val: ConstValue, field_idx: u32) -> Result<ConstValue, EvalError> {
        if val.tag == CValTag::Struct {
            for i in 0usize..val.fields().len() {
                if val.fields()[i].field_idx == field_idx {
                    return Result::ok(val.fields()[i].value);
                }
            }
            Result::ok(ConstValue::make_uninitialized())
        } else if val.tag == CValTag::Tuple {
            // Tuples, and slices (a (pointer, length) pair).
            self.access_tuple_index(val, field_idx as usize)
        } else if val.tag == CValTag::Bytes {
            // The fat-pointer fields of a string/byte-string slice: the data
            // pointer (a Bytes value doubles as a pointer into the bytes)
            // and the length.
            switch field_idx {
                0 => Result::ok(val),
                1 => Result::ok(ConstValue::make_int((val.bytes().len() - val.bytes_offset()) as u64, BuiltinType::USize)),
                _ => Result::err(EvalError::Unsupported),
            }
        } else {
            Result::err(EvalError::Unsupported)
        }
    }

    fn access_index(self: &ConstEvaluator, val: ConstValue, idx: usize) -> Result<ConstValue, EvalError> {
        if val.tag == CValTag::Array {
            if idx < val.elems().len() {
                Result::ok(val.elems()[idx])
            } else {
                Result::err(EvalError::IndexOob)
            }
        } else if val.tag == CValTag::Bytes {
            // String / byte-string literal: bytes-buffer with running offset.
            // Indexing reads the byte at offset+idx; usize::MAX (from a wrapping
            // 0usize-1) trips the OOB check via the >= len comparison.
            let off = val.bytes_offset() + idx;
            if off >= val.bytes().len() {
                Result::err(EvalError::IndexOob)
            } else {
                Result::ok(ConstValue::make_int(val.bytes()[off] as u64, BuiltinType::U8))
            }
        } else {
            Result::err(EvalError::Unsupported)
        }
    }

    /// Keep the live allocations the value reaches as constants.
    fn bake(self: &mut ConstEvaluator, val: ConstValue) {
        switch val.tag {
            CValTag::Pointer => {
                let root = val.lvalue().root();
                if root.tag == CLVTag::Alloc {
                    let alloc = self.heap.get(&root.id()._value);
                    if alloc.is_some() && alloc.unwrap().live && !alloc.unwrap().baked {
                        let baked = alloc.unwrap();
                        baked.baked = true;
                        self.heap.insert(root.id()._value, baked);
                        self.bake(baked.value);
                    }
                }
            }
            CValTag::Tuple, CValTag::Array => for elem in val.elems() { self.bake(elem); },
            CValTag::Struct => for field in val.fields() { self.bake(field.value); },
            _ => {}
        }
    }

    /// Whether the value reaches an allocation that is not baked.
    fn reaches_unbaked(self: &ConstEvaluator, val: ConstValue) -> bool {
        switch val.tag {
            CValTag::Pointer => {
                let root = val.lvalue().root();
                if root.tag != CLVTag::Alloc { return false; }
                let alloc = self.heap.get(&root.id()._value);
                alloc.is_none() || !alloc.unwrap().baked
            }
            CValTag::Tuple, CValTag::Array => val.elems().iter().any(|=self, e: ConstValue| -> bool { self.reaches_unbaked(e) }),
            CValTag::Struct => val.fields().iter().any(|=self, f: ConstField| -> bool { self.reaches_unbaked(f.value) }),
            _ => false,
        }
    }

    /// The result of evaluating `expr` at the top level: it must not point
    /// into the heap other than into baked allocations.
    fn eval_top(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let result = self.eval(expr);
        if result.is_ok() && self.reaches_unbaked(result.unwrap()) {
            if self.failure.is_none() {
                self.failure = Option::some(ConstEvalFailure {
                    code: EvalError::HeapInResult, span: expr.span, what: "expression", function: "", calls: &[],
                });
            }
            return Result::err(EvalError::HeapInResult);
        }
        result
    }

    /// Evaluate an expression at the top level: its value (see `eval_top`),
    /// and what else the evaluation produced.
    fn outcome(self: &mut ConstEvaluator, expr: &IrExpr) -> ConstEvalOutcome {
        let result = self.eval_top(expr);
        ConstEvalOutcome {
            value: result.get(),
            heap: self.heap,
            panic_msg: self.panic_msg,
            warning_msg: self.warning_msg,
            note_msg: self.note_msg,
            failure: self.failure,
        }
    }

    /// The bytes of a constant string (a `&[u8]` value).
    fn extract_string(self: &mut ConstEvaluator, val: ConstValue) -> Option<&[u8]> {
        if val.tag == CValTag::Bytes {
            return Option::some(val.bytes()[val.bytes_offset()..]);
        }
        if val.tag != CValTag::Tuple || val.elems().len() != 2 {
            return Option::none();
        }
        let len = val.elems()[1].as_usize();
        if len.is_none() { return Option::none(); }
        let ptr = val.elems()[0];
        if ptr.tag == CValTag::Bytes {
            let start = ptr.bytes_offset();
            if start + len.unwrap() > ptr.bytes().len() { return Option::none(); }
            return Option::some(ptr.bytes()[start..start + len.unwrap()]);
        }
        if ptr.tag != CValTag::Pointer { return Option::none(); }
        let text = self.arena.alloc_slice::<u8>(len.unwrap());
        for i in 0usize..len.unwrap() {
            let lv = ptr.lvalue();
            let elem = if lv.tag == CLVTag::Index {
                self.arena.alloc(ConstLValue::mk_index(lv.inner(), lv.index() + i)) as &ConstLValue
            } else if i == 0 {
                lv
            } else {
                return Option::none();
            };
            let byte = self.materialize_lvalue(elem);
            if byte.is_err() || byte.unwrap().tag != CValTag::Int { return Option::none(); }
            text[i] = byte.unwrap().int_val() as u8;
        }
        Option::some(text as &[u8])
    }

    fn access_tuple_index(self: &ConstEvaluator, val: ConstValue, idx: usize) -> Result<ConstValue, EvalError> {
        if val.tag == CValTag::Tuple {
            if idx < val.elems().len() {
                Result::ok(val.elems()[idx])
            } else {
                Result::ok(ConstValue::make_uninitialized())
            }
        } else {
            Result::err(EvalError::Unsupported)
        }
    }

    fn eval_inner(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let result = self.eval_node(expr);
        if result.is_err() && result.unwrap_err().is_failure() {
            self.note_failure(expr, result.unwrap_err());
        }
        result
    }

    /// Record the innermost expression whose evaluation failed, and the
    /// innermost source span around it.
    fn note_failure(self: &mut ConstEvaluator, expr: &IrExpr, code: EvalError) {
        if self.failure.is_none() {
            self.failure = Option::some(ConstEvalFailure {
                code: code,
                span: expr.span,
                what: std::typing::Type::new::<IrTag>().variant_name(expr.tag).unwrap_or("expression"),
                function: self.current_fn,
                calls: &[],
            });
        } else if self.failure.unwrap().span.is_empty() && !expr.span.is_empty() {
            let failure = self.failure.unwrap();
            failure.span = expr.span;
            self.failure = Option::some(failure);
        }
    }

    fn eval_node(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        if !self.step() {
            return Result::err(EvalError::TooManyIters);
        }

        switch expr.tag {
        IrTag::IntLit => {
            let bt = self.irty_to_builtin(expr.ty);
            // (Values are 64 bits wide: 128-bit arithmetic is not supported.)
            if bt.bit_width() > 64 {
                return Result::err(EvalError::Unsupported);
            }
            Result::ok(ConstValue::make_int(expr.int_val(), bt))
        }
        IrTag::FloatLit => {
            let bt = self.irty_to_builtin(expr.ty);
            Result::ok(ConstValue::make_float(expr.float_val(), bt))
        }
        IrTag::BoolLit => Result::ok(ConstValue::make_bool(expr.bool_val())),
        IrTag::StringLit => Result::ok(ConstValue::make_bytes(expr.str_val(), 0)),
        IrTag::Void => Result::ok(ConstValue::make_void()),
        IrTag::NullLit => Result::ok(ConstValue::make_int(0u64, BuiltinType::USize)),

        IrTag::Cast => self.eval_cast(expr),
        IrTag::Binary => self.eval_binary(expr),
        IrTag::Unary => self.eval_unary(expr),
        IrTag::Local, IrTag::Param => {
            let lv = self.arena.alloc(ConstLValue::variable(Id { _value: self.var_id(expr.id()) }));
            Result::ok(ConstValue::make_lvalue(lv))
        }
        IrTag::Block => self.eval_block(expr),
        IrTag::If => self.eval_if(expr),
        IrTag::Let => self.eval_let(expr),
        IrTag::Assign => self.eval_assign(expr),
        IrTag::Return => {
            if expr.opt_expr().is_some() {
                let val = self.eval(expr.opt_expr().unwrap())?;
                self.return_slot = val;
            } else {
                self.return_slot = ConstValue::make_void();
            }
            self.has_return = true;
            Result::err(EvalError::Return)
        }
        IrTag::Call => self.eval_call(expr),
        IrTag::FieldAccess => self.eval_field_access(expr),
        IrTag::Index => self.eval_index(expr),
        IrTag::TupleLit => self.eval_tuple_lit(expr),
        IrTag::ArrayLit => self.eval_array_lit(expr),
        IrTag::StructLit => self.eval_struct_lit(expr),
        IrTag::Ref => self.eval_ref(expr),
        IrTag::Deref => self.eval_deref(expr),
        IrTag::Unreachable, IrTag::Trap => Result::err(EvalError::Unreachable),
        IrTag::ConstPanic, IrTag::ConstWarning, IrTag::ConstNote => {
            let msg = expr.str_val();
            if !expr.items().is_empty() {
                let value = self.eval(expr.items()[0])?;
                let text = self.extract_string(value);
                if text.is_none() { return Result::err(EvalError::Unsupported); }
                msg = text.unwrap();
            }
            // (Only the first warning and note are kept.)
            switch expr.tag {
                IrTag::ConstPanic => {
                    self.panic_msg = msg;
                    return Result::err(EvalError::ConstPanic);
                }
                IrTag::ConstWarning => if self.warning_msg.is_empty() { self.warning_msg = msg; },
                _ => if self.note_msg.is_empty() { self.note_msg = msg; },
            }
            Result::ok(ConstValue::make_void())
        }
        IrTag::ConstAlloc => {
            let len_r = self.eval(expr.items()[0])?;
            let len = len_r.as_usize();
            if len.is_none() { return Result::err(EvalError::Unsupported); }
            let elem_ty = expr.ty.inner();
            let elems = self.arena.alloc_slice::<ConstValue>(len.unwrap());
            let elem = self.make_uninitialized(elem_ty);
            for i in 0usize..len.unwrap() {
                elems[i] = elem;
            }
            let id = self.id_gen.next_id();
            self.heap.insert(id._value, HeapAlloc {
                value: ConstValue::make_array(elems), elem_ty: elem_ty, live: true, baked: false,
            });
            let first = self.arena.alloc(ConstLValue::mk_index(self.arena.alloc(ConstLValue::alloc(id)), 0));
            Result::ok(ConstValue::make_pointer(first, elem_ty))
        }
        IrTag::ConstFree => {
            let ptr = self.eval(expr.items()[0])?;
            if ptr.tag == CValTag::Int && ptr.int_val() == 0 {
                return Result::ok(ConstValue::make_void());  // (null)
            }
            // A pointer to the start of a live allocation.
            if ptr.tag != CValTag::Pointer || ptr.lvalue().tag != CLVTag::Index || ptr.lvalue().index() != 0
                || ptr.lvalue().inner().tag != CLVTag::Alloc {
                return Result::err(EvalError::InvalidFree);
            }
            let id = ptr.lvalue().inner().id();
            let alloc = self.heap.get(&id._value);
            if alloc.is_none() || !alloc.unwrap().live {
                return Result::err(EvalError::InvalidFree);
            }
            let freed = alloc.unwrap();
            freed.live = false;
            self.heap.insert(id._value, freed);
            Result::ok(ConstValue::make_void())
        }
        IrTag::ConstBake => {
            let value = self.eval(expr.items()[0]);
            if value.is_ok() { self.bake(value.unwrap()); }
            value
        }
        IrTag::InConstContext => Result::ok(ConstValue::make_bool(!self.run_time)),
        IrTag::Undef => Result::ok(ConstValue::make_uninitialized()),
        IrTag::Zeroed => Result::ok(self.make_zeroed(expr.ty)),
        IrTag::FnRef => Result::ok(ConstValue::make_fn_ptr(*expr.fn_ref())),
        IrTag::GlobalRef => self.eval_global_ref(expr),
        IrTag::While => self.eval_while(expr),
        IrTag::Loop => self.eval_loop(expr),
        IrTag::Break => Result::err(EvalError::Break),
        IrTag::Continue => Result::err(EvalError::Continue),
        IrTag::Switch => self.eval_switch(expr),
        IrTag::Transmute => self.eval_transmute(expr),
        IrTag::LlvmIntrinsic => self.eval_llvm_intrinsic(expr),
        _ => Result::err(EvalError::Unsupported),
        }
    }

    fn eval_global_ref(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let target_id = expr.global_ref().id._value;
        // Check cached const values first
        let cached = self.const_values.get(&target_id);
        if cached.is_some() {
            return Result::ok(cached.unwrap());
        }
        // Fall back to evaluating the global's init expression (of a
        // constant: a static's value is not its initial one)
        for i in 0usize..self.ir_globals.len() {
            if self.ir_globals[i].id._value == target_id {
                if self.ir_globals[i].init.is_some() && self.ir_globals[i].is_const {
                    return self.eval(self.ir_globals[i].init.unwrap());
                }
                break;
            }
        }
        Result::err(EvalError::Unsupported)
    }

    fn irty_to_builtin(self: &ConstEvaluator, ty: &IrTy) -> BuiltinType {
        switch ty.tag {
        IrTyTag::Builtin => ty.builtin(),
        IrTyTag::Enum => {
            if ty.enum_ref().underlying.tag == IrTyTag::Builtin {
                ty.enum_ref().underlying.builtin()
            } else {
                BuiltinType::I32 // default
            }
        }
        IrTyTag::Pointer, IrTyTag::FnPointer => BuiltinType::USize,
        _ => BuiltinType::Void,
        }
    }

    // ========== Binary operations ==========

    fn eval_binary(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let lhs_r = self.eval(expr.lhs())?;

        // Short-circuit for && and ||
        if expr.bin_op() == BinOp::And {
            if lhs_r.tag == CValTag::Bool {
                if !lhs_r.is_truthy() {
                    return Result::ok(ConstValue::make_bool(false));
                }
                let rhs_r = self.eval(expr.rhs())?;
                return Result::ok(ConstValue::make_bool(rhs_r.is_truthy()));
            }
        } else if expr.bin_op() == BinOp::Or {
            if lhs_r.tag == CValTag::Bool {
                if lhs_r.is_truthy() {
                    return Result::ok(ConstValue::make_bool(true));
                }
                let rhs_r = self.eval(expr.rhs())?;
                return Result::ok(ConstValue::make_bool(rhs_r.is_truthy()));
            }
        }

        let rhs_r = self.eval(expr.rhs())?;

        let lhs = lhs_r;
        let rhs = rhs_r;

        // Integer binary ops
        if lhs.tag == CValTag::Int && rhs.tag == CValTag::Int {
            return self.int_bin_op(lhs, rhs, expr.bin_op());
        }
        // Float binary ops
        if lhs.tag == CValTag::Float && rhs.tag == CValTag::Float {
            return self.float_bin_op(lhs, rhs, expr.bin_op());
        }
        // Bool comparisons
        if lhs.tag == CValTag::Bool && rhs.tag == CValTag::Bool {
            return self.bool_bin_op(lhs, rhs, expr.bin_op());
        }
        // Pointer arithmetic
        if lhs.tag == CValTag::Bytes {
            return self.bytes_bin_op(lhs, rhs, expr.bin_op());
        }
        if lhs.tag == CValTag::Pointer && rhs.tag == CValTag::Int {
            return self.pointer_int_bin_op(lhs, rhs, expr.bin_op());
        }
        // The difference of (and comparisons between) pointers to the same
        // place or to elements of the same array.
        if lhs.tag == CValTag::Pointer && rhs.tag == CValTag::Pointer {
            let (a, b) = (lhs.lvalue(), rhs.lvalue());
            let positions: Option<(u64, u64)> = if self.same_lvalue(a, b) {
                Option::some((0u64, 0u64))
            } else if a.tag == CLVTag::Index && b.tag == CLVTag::Index && self.same_lvalue(a.inner(), b.inner()) {
                Option::some((a.index() as u64, b.index() as u64))
            } else {
                Option::none()
            };
            if positions.is_some() {
                let (i, j) = positions.unwrap();
                return switch expr.bin_op() {
                    BinOp::Sub => Result::ok(ConstValue::make_int(i - j, BuiltinType::ISize)),
                    _ => self.int_bin_op(ConstValue::make_int(i, BuiltinType::USize), ConstValue::make_int(j, BuiltinType::USize), expr.bin_op()),
                };
            }
            // (Pointers into different places differ, but are not ordered.)
            switch expr.bin_op() {
                BinOp::Eq => return Result::ok(ConstValue::make_bool(false)),
                BinOp::Ne => return Result::ok(ConstValue::make_bool(true)),
                _ => {}
            }
        }
        // Functions are equal if they are the same function.
        if lhs.tag == CValTag::FnPtr && rhs.tag == CValTag::FnPtr {
            let same = lhs.fn_ref().mangled_name == rhs.fn_ref().mangled_name;
            switch expr.bin_op() {
                BinOp::Eq => return Result::ok(ConstValue::make_bool(same)),
                BinOp::Ne => return Result::ok(ConstValue::make_bool(!same)),
                _ => {}
            }
        }

        Result::err(EvalError::Unsupported)
    }

    fn int_bin_op(self: &ConstEvaluator, lhs: ConstValue, rhs: ConstValue, op: BinOp) -> Result<ConstValue, EvalError> {
        let a = lhs.int_val();
        let b = rhs.int_val();
        let bt = lhs.builtin_type();
        let is_signed = bt.is_signed();
        let width = bt.bit_width();

        // For comparisons, handle signed/unsigned properly (on the values
        // as of the type's width: a negative value may be stored
        // sign-extended to 64 bits or not).
        switch op {
        BinOp::Eq, BinOp::Ne, BinOp::Lt, BinOp::Le, BinOp::Gt, BinOp::Ge => {
            let (x, y) = (self.mask_to_width(a, width), self.mask_to_width(b, width));
            let (sx, sy) = (self.sign_extend(x, width), self.sign_extend(y, width));
            return Result::ok(ConstValue::make_bool(switch op {
                BinOp::Eq => x == y,
                BinOp::Ne => x != y,
                BinOp::Lt => if is_signed { sx < sy } else { x < y },
                BinOp::Le => if is_signed { sx <= sy } else { x <= y },
                BinOp::Gt => if is_signed { sx > sy } else { x > y },
                _ => if is_signed { sx >= sy } else { x >= y },
            }));
        }
        _ => {}
        }

        // Arithmetic - compute then mask to width.
        //
        // For signed Add / Sub / Mul we detect overflow at this point and bail
        // with EvalError::Overflow so callers fall back to runtime
        // emission. Matches alumina-boot which rejects const-time signed
        // overflow (UB at runtime) rather than silently wrapping.
        let result: u64 = 0;

        switch op {
        BinOp::Add => {
            if is_signed && self.detect_signed_add_overflow(a, b, width) {
                return Result::err(EvalError::Overflow);
            }
            result = a + b;
        },
        BinOp::Sub => {
            if is_signed && self.detect_signed_sub_overflow(a, b, width) {
                return Result::err(EvalError::Overflow);
            }
            result = a - b;
        },
        BinOp::Mul => {
            if is_signed && self.detect_signed_mul_overflow(a, b, width) {
                return Result::err(EvalError::Overflow);
            }
            result = a * b;
        },
        BinOp::Div => {
            if b == 0u64 { return Result::err(EvalError::DivZero); }
            // Signed INT_MIN / -1 overflows.
            if is_signed && self.detect_signed_div_overflow(a, b, width) {
                return Result::err(EvalError::Overflow);
            }
            result = if is_signed { (self.sign_extend(a, width) / self.sign_extend(b, width)) as u64 } else { a / b };
        }
        BinOp::Rem => {
            if b == 0u64 { return Result::err(EvalError::DivZero); }
            // Signed INT_MIN % -1 also overflows in C / LLVM-UB terms.
            if is_signed && self.detect_signed_div_overflow(a, b, width) {
                return Result::err(EvalError::Overflow);
            }
            result = if is_signed { (self.sign_extend(a, width) % self.sign_extend(b, width)) as u64 } else { a % b };
        }
        BinOp::BitAnd => result = a & b,
        BinOp::BitOr => result = a | b,
        BinOp::BitXor => result = a ^ b,
        BinOp::Shl => {
            let shift = b as u32;
            if shift >= width { return Result::err(EvalError::Overflow); }
            result = a << shift;
        }
        BinOp::Shr => {
            let shift = b as u32;
            if shift >= width { return Result::err(EvalError::Overflow); }
            result = if is_signed { ((a as i64) >> shift) as u64 } else { a >> shift };
        }
        BinOp::And => return Result::ok(ConstValue::make_bool(a != 0u64 && b != 0u64)),
        BinOp::Or => return Result::ok(ConstValue::make_bool(a != 0u64 || b != 0u64)),
        _ => return Result::err(EvalError::Unsupported),
        }

        // Mask to width
        result = self.mask_to_width(result, width);

        Result::ok(ConstValue::make_int(result, bt))
    }

    fn detect_signed_add_overflow(self: &ConstEvaluator, a: u64, b: u64, width: u32) -> bool {
        // Signed addition overflows iff inputs share a sign bit but the
        // truncated result has the opposite sign bit. Operates on the bit-width
        // of the source type — for width == 64 we use the full u64.
        if width < 1 || width > 64 { return false; }
        let sign_bit_mask = if width >= 64 { 1u64 << 63 } else { 1u64 << (width - 1) };
        let mask = self.mask_to_width(0xFFFFFFFFFFFFFFFFu64, width);
        let result = (a + b) & mask;
        let a_sign = (a & sign_bit_mask) != 0u64;
        let b_sign = (b & sign_bit_mask) != 0u64;
        let r_sign = (result & sign_bit_mask) != 0u64;
        a_sign == b_sign && a_sign != r_sign
    }

    fn detect_signed_sub_overflow(self: &ConstEvaluator, a: u64, b: u64, width: u32) -> bool {
        // Signed subtraction overflows iff the operands have different sign
        // bits AND the result's sign bit differs from the minuend's.
        if width < 1 || width > 64 { return false; }
        let sign_bit_mask = if width >= 64 { 1u64 << 63 } else { 1u64 << (width - 1) };
        let mask = self.mask_to_width(0xFFFFFFFFFFFFFFFFu64, width);
        let result = (a - b) & mask;
        let a_sign = (a & sign_bit_mask) != 0u64;
        let b_sign = (b & sign_bit_mask) != 0u64;
        let r_sign = (result & sign_bit_mask) != 0u64;
        a_sign != b_sign && r_sign != a_sign
    }

    fn detect_signed_div_overflow(self: &ConstEvaluator, a: u64, b: u64, width: u32) -> bool {
        // INT_MIN / -1 overflows: the result is +(1<<(width-1)) which is
        // outside the signed range.
        if width < 1 || width > 64 { return false; }
        let sign_bit = if width >= 64 { 1u64 << 63 } else { 1u64 << (width - 1) };
        let mask = self.mask_to_width(0xFFFFFFFFFFFFFFFFu64, width);
        (a & mask) == sign_bit && (b & mask) == mask
    }

    fn detect_signed_mul_overflow(self: &ConstEvaluator, a: u64, b: u64, width: u32) -> bool {
        // Sign-extend a and b to i64, multiply in i64 (which can overflow for
        // i64 inputs but not for narrower), and verify the result fits in
        // [-(1<<(width-1)), (1<<(width-1)) - 1]. For i64 inputs, we fall back
        // to dividing and comparing — this is correctness-preserving.
        if width < 1 || width > 64 { return false; }
        let sa = self.sign_extend(a, width);
        let sb = self.sign_extend(b, width);
        if sa == 0i64 || sb == 0i64 { return false; }
        if width < 64 {
            let prod = sa * sb;
            let signed_max = (1i64 << (width - 1)) - 1i64;
            let signed_min = -(1i64 << (width - 1));
            return prod < signed_min || prod > signed_max;
        }
        // 64-bit: detect via division round-trip.
        let prod = sa * sb;
        if prod / sa != sb { return true; }
        false
    }

    fn mask_to_width(self: &ConstEvaluator, val: u64, width: u32) -> u64 {
        if width >= 64 { return val; }
        if width == 0 { return 0u64; }
        val & ((1u64 << width) - 1u64)
    }

    fn float_bin_op(self: &ConstEvaluator, lhs: ConstValue, rhs: ConstValue, op: BinOp) -> Result<ConstValue, EvalError> {
        let a = lhs.float_val();
        let b = rhs.float_val();
        let bt = lhs.builtin_type();

        switch op {
        BinOp::Add => Result::ok(ConstValue::make_float(a + b, bt)),
        BinOp::Sub => Result::ok(ConstValue::make_float(a - b, bt)),
        BinOp::Mul => Result::ok(ConstValue::make_float(a * b, bt)),
        BinOp::Div => Result::ok(ConstValue::make_float(a / b, bt)),
        BinOp::Eq => Result::ok(ConstValue::make_bool(a == b)),
        BinOp::Ne => Result::ok(ConstValue::make_bool(a != b)),
        BinOp::Lt => Result::ok(ConstValue::make_bool(a < b)),
        BinOp::Le => Result::ok(ConstValue::make_bool(a <= b)),
        BinOp::Gt => Result::ok(ConstValue::make_bool(a > b)),
        BinOp::Ge => Result::ok(ConstValue::make_bool(a >= b)),
        _ => Result::err(EvalError::Unsupported),
        }
    }

    fn bool_bin_op(self: &ConstEvaluator, lhs: ConstValue, rhs: ConstValue, op: BinOp) -> Result<ConstValue, EvalError> {
        let a = lhs.int_val() != 0u64;
        let b = rhs.int_val() != 0u64;

        switch op {
        BinOp::Eq => Result::ok(ConstValue::make_bool(a == b)),
        BinOp::Ne => Result::ok(ConstValue::make_bool(a != b)),
        BinOp::And, BinOp::BitAnd => Result::ok(ConstValue::make_bool(a && b)),
        BinOp::Or, BinOp::BitOr => Result::ok(ConstValue::make_bool(a || b)),
        BinOp::BitXor => Result::ok(ConstValue::make_bool(a != b)),
        _ => Result::err(EvalError::Unsupported),
        }
    }

    fn bytes_bin_op(self: &ConstEvaluator, lhs: ConstValue, rhs: ConstValue, op: BinOp) -> Result<ConstValue, EvalError> {
        // Byte pointer + integer offset
        if rhs.tag == CValTag::Int {
            if op == BinOp::Add {
                let new_off = lhs.bytes_offset() + (rhs.int_val() as usize);
                if new_off > lhs.bytes().len() {
                    return Result::err(EvalError::IndexOob);
                }
                return Result::ok(ConstValue::make_bytes(lhs.bytes(), new_off));
            } else if op == BinOp::Sub {
                let offset = rhs.int_val() as usize;
                if offset > lhs.bytes_offset() {
                    return Result::err(EvalError::IndexOob);
                }
                return Result::ok(ConstValue::make_bytes(lhs.bytes(), lhs.bytes_offset() - offset));
            }
        }
        // Byte pointer - byte pointer, and comparisons (into the same
        // string, which, as in alumina-boot, is decided by value).
        if rhs.tag == CValTag::Bytes && lhs.bytes() == rhs.bytes() {
            let (a, b) = (lhs.bytes_offset() as u64, rhs.bytes_offset() as u64);
            return switch op {
                BinOp::Sub => Result::ok(ConstValue::make_int(a - b, BuiltinType::ISize)),
                _ => self.int_bin_op(ConstValue::make_int(a, BuiltinType::USize), ConstValue::make_int(b, BuiltinType::USize), op),
            };
        }
        Result::err(EvalError::Unsupported)
    }

    /// Whether two lvalues denote the same place.
    fn same_lvalue(self: &ConstEvaluator, a: &ConstLValue, b: &ConstLValue) -> bool {
        if a.tag != b.tag {
            return false;
        }
        switch a.tag {
            CLVTag::Variable, CLVTag::Alloc, CLVTag::ConstItem => a.id()._value == b.id()._value,
            CLVTag::Field => a.field_idx() == b.field_idx() && self.same_lvalue(a.inner(), b.inner()),
            CLVTag::Index, CLVTag::TupleIndex => a.index() == b.index() && self.same_lvalue(a.inner(), b.inner()),
            _ => false,
        }
    }

    fn pointer_int_bin_op(self: &ConstEvaluator, lhs: ConstValue, rhs: ConstValue, op: BinOp) -> Result<ConstValue, EvalError> {
        if lhs.lvalue().tag == CLVTag::Index {
            let offset = lhs.lvalue().index();
            let new_offset: usize = 0;
            if op == BinOp::Add {
                new_offset = offset + (rhs.int_val() as usize);
            } else if op == BinOp::Sub {
                if (rhs.int_val() as usize) > offset {
                    return Result::err(EvalError::IndexOob);
                }
                new_offset = offset - (rhs.int_val() as usize);
            } else {
                return Result::err(EvalError::Unsupported);
            }
            let new_lv = self.arena.alloc(ConstLValue::mk_index(lhs.lvalue().inner(), new_offset));
            return Result::ok(ConstValue::make_pointer(new_lv, lhs.pointee_ty()));
        }
        Result::err(EvalError::Unsupported)
    }

    // ========== Unary operations ==========

    fn eval_unary(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let inner = self.eval(expr.lhs())?;

        if inner.tag == CValTag::Bool {
            if expr.un_op() == UnOp::Not {
                return Result::ok(ConstValue::make_bool(!inner.is_truthy()));
            }
        } else if inner.tag == CValTag::Int {
            if expr.un_op() == UnOp::Neg {
                let bt = inner.builtin_type();
                let width = bt.bit_width();
                // Signed: negating INT_MIN overflows (2's complement asymmetry).
                if bt.is_signed() && width >= 1u32 && width <= 64u32 {
                    let sign_bit = if width >= 64u32 { 1u64 << 63 } else { 1u64 << (width - 1u32) };
                    let mask = self.mask_to_width(0xFFFFFFFFFFFFFFFFu64, width);
                    if (inner.int_val() & mask) == sign_bit {
                        return Result::err(EvalError::Overflow);
                    }
                }
                let result = (0u64 - inner.int_val());
                let result = self.mask_to_width(result, width);
                return Result::ok(ConstValue::make_int(result, bt));
            } else if expr.un_op() == UnOp::BitNot {
                let result = ~inner.int_val();
                let result = self.mask_to_width(result, inner.builtin_type().bit_width());
                return Result::ok(ConstValue::make_int(result, inner.builtin_type()));
            } else if expr.un_op() == UnOp::Not {
                // logical not on integer (shouldn't happen but handle it)
                return Result::ok(ConstValue::make_bool(inner.int_val() == 0u64));
            }
        } else if inner.tag == CValTag::Float {
            if expr.un_op() == UnOp::Neg {
                return Result::ok(ConstValue::make_float(-inner.float_val(), inner.builtin_type()));
            }
        }
        Result::err(EvalError::Unsupported)
    }

    // ========== Cast ==========

    fn eval_cast(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let inner = self.eval(expr.lhs())?;
        let target_bt = self.irty_to_builtin(expr.ir_ty());
        if target_bt.bit_width() > 64 {
            return Result::err(EvalError::Unsupported);  // (see IntLit)
        }

        // Same type - no-op
        if inner.tag == CValTag::Int && target_bt == inner.builtin_type() {
            return Result::ok(inner);
        }

        // Int -> Int
        if inner.tag == CValTag::Int && target_bt.is_integer() {
            let val = inner.int_val();
            // Sign-extend if source is signed
            let promoted: i64 = 0;
            if inner.builtin_type().is_signed() {
                let width = inner.builtin_type().bit_width();
                // Sign extend to i64
                promoted = self.sign_extend(val, width);
            } else {
                promoted = val as i64;
            }
            // Truncate to target width
            let result: u64 = promoted as u64;
            result = self.mask_to_width(result, target_bt.bit_width());
            return Result::ok(ConstValue::make_int(result, target_bt));
        }

        // Bool -> Int
        if inner.tag == CValTag::Bool && target_bt.is_integer() {
            return Result::ok(ConstValue::make_int(inner.int_val(), target_bt));
        }

        // Int -> Bool
        if inner.tag == CValTag::Int && target_bt == BuiltinType::Bool {
            return Result::ok(ConstValue::make_bool(inner.int_val() != 0u64));
        }

        // Int -> Float
        if inner.tag == CValTag::Int && target_bt.is_float() {
            let fval: f64 = 0.0;
            if inner.builtin_type().is_signed() {
                fval = self.sign_extend(inner.int_val(), inner.builtin_type().bit_width()) as f64;
            } else {
                fval = inner.int_val() as f64;
            }
            if target_bt == BuiltinType::F32 {
                fval = (fval as f32) as f64;
            }
            return Result::ok(ConstValue::make_float(fval, target_bt));
        }

        // Float -> Int
        if inner.tag == CValTag::Float && target_bt.is_integer() {
            let ival: u64 = 0;
            if target_bt.is_signed() {
                ival = (inner.float_val() as i64) as u64;
            } else {
                ival = inner.float_val() as u64;
            }
            ival = self.mask_to_width(ival, target_bt.bit_width());
            return Result::ok(ConstValue::make_int(ival, target_bt));
        }

        // Float -> Float (f64 -> f32 or f32 -> f64)
        if inner.tag == CValTag::Float && target_bt.is_float() {
            let fval = inner.float_val();
            if target_bt == BuiltinType::F32 {
                fval = (fval as f32) as f64;
            }
            return Result::ok(ConstValue::make_float(fval, target_bt));
        }

        // Pointer casts (ptr -> ptr, fn -> fn_ptr, int -> ptr, ptr -> int).
        // (`irty_to_builtin` gives usize for a pointer type, so check the
        // target type itself.)
        let to_pointer = expr.ir_ty().tag == IrTyTag::Pointer || expr.ir_ty().tag == IrTyTag::FnPointer;
        if inner.tag == CValTag::Pointer {
            if !to_pointer && target_bt.is_integer() {
                // ptr -> int: unsupported in general
                return Result::err(EvalError::Unsupported);
            }
            // A pointer to an array cast to a pointer to its elements (as in
            // an array-to-slice coercion) points to the first element.
            let from = inner.pointee_ty();
            if to_pointer && expr.ir_ty().tag == IrTyTag::Pointer && from.tag == IrTyTag::Array
                && from.inner().same_as(expr.ir_ty().inner()) {
                let first = self.arena.alloc(ConstLValue::mk_index(inner.lvalue(), 0));
                return Result::ok(ConstValue::make_pointer(first, expr.ir_ty().inner()));
            }
            // Otherwise, ptr -> ptr only changes the type.
            let pointee = if expr.ir_ty().tag == IrTyTag::Pointer { expr.ir_ty().inner() } else { from };
            return Result::ok(ConstValue::make_pointer(inner.lvalue(), pointee));
        }
        if inner.tag == CValTag::FnPtr {
            return Result::ok(inner);
        }
        // (An uninitialized value stays one.)
        if inner.tag == CValTag::Uninitialized {
            return Result::ok(inner);
        }
        // Slice to slice (`&mut [T]` to `&[T]`) only changes the type.
        if expr.ir_ty().tag == IrTyTag::Slice && (inner.tag == CValTag::Tuple || inner.tag == CValTag::Bytes) {
            return Result::ok(inner);
        }

        // Int -> Pointer (e.g. dangling pointer from align value)
        if inner.tag == CValTag::Int && (expr.ty.tag == IrTyTag::Pointer || expr.ty.tag == IrTyTag::FnPointer) {
            // Store as int, will work for dangling pointers
            return Result::ok(inner);
        }

        Result::err(EvalError::Unsupported)
    }

    fn sign_extend(self: &ConstEvaluator, val: u64, width: u32) -> i64 {
        if width == 0 || width >= 64 { return val as i64; }
        let sign_bit = 1u64 << (width - 1u32);
        if val & sign_bit != 0u64 {
            // Negative: extend with 1s
            let mask = ~((1u64 << width) - 1u64);
            (val | mask) as i64
        } else {
            val as i64
        }
    }

    // ========== Block ==========

    fn eval_block(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        // Items are the block's statements + trailing expression
        // Last item is the block's value
        if expr.items().is_empty() {
            return Result::ok(ConstValue::make_void());
        }

        // Build label index for goto support
        // (We don't have IR labels in aluminac's IR, but we handle break/continue via
        // the structured control flow in eval_while/eval_loop)

        for i in 0usize..expr.items().len() - 1 {
            let r = self.eval(expr.items()[i])?;
        }

        // Last item is the value
        self.eval(expr.items()[expr.items().len() - 1])
    }

    // ========== If ==========

    fn eval_if(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let cond_r = self.eval(expr.cond())?;

        if cond_r.is_truthy() {
            self.eval(expr.lhs())
        } else if expr.opt_expr().is_some() {
            self.eval(expr.opt_expr().unwrap())
        } else {
            Result::ok(ConstValue::make_void())
        }
    }

    // ========== Let ==========

    fn eval_let(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        // IrTag::Let: id, opt_expr = initializer, ir_ty = type
        if expr.opt_expr().is_some() {
            let init_r = self.eval(expr.opt_expr().unwrap())?;
            self.store_var(expr.id(), init_r);
        } else {
            // (As alumina-boot, reading it before it is assigned fails.)
            self.store_var(expr.id(), self.make_uninitialized(expr.ir_ty()));
        }
        Result::ok(ConstValue::make_void())
    }

    // ========== Assign ==========

    fn eval_assign(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        // lhs is the target (lvalue), rhs is the value
        let target_r = self.eval_inner(expr.lhs())?;
        let val_r = self.eval(expr.rhs())?;

        let target = target_r;
        if target.tag == CValTag::Lvalue {
            self.assign_to_lvalue(target.lvalue(), val_r)
        } else {
            Result::err(EvalError::Unsupported)
        }
    }

    fn assign_to_lvalue(self: &mut ConstEvaluator, lv: &ConstLValue, val: ConstValue) -> Result<ConstValue, EvalError> {
        if lv.tag == CLVTag::Variable {
            self.variables.insert(lv.id()._value, val);
            return Result::ok(ConstValue::make_void());
        } else if lv.tag == CLVTag::Alloc {
            let live = self.live_alloc(lv.id());
            if live.is_err() { return Result::err(live.unwrap_err()); }
            let alloc = live.unwrap();
            alloc.value = val;
            self.heap.insert(lv.id()._value, alloc);
            return Result::ok(ConstValue::make_void());
        } else if lv.tag == CLVTag::Field {
            // Read base, update field, write back
            let base = self.materialize_lvalue(lv.inner())?;
            if base.tag == CValTag::Struct {
                // Create new fields array with updated field
                let new_fields = self.arena.alloc_slice::<ConstField>(base.fields().len());
                let found = false;
                for i in 0usize..base.fields().len() {
                    if base.fields()[i].field_idx == lv.field_idx() {
                        new_fields[i] = ConstField { field_idx: lv.field_idx(), value: val };
                        found = true;
                    } else {
                        new_fields[i] = base.fields()[i];
                    }
                }
                if !found {
                    // Add new field - need to grow
                    let grown = self.arena.alloc_slice::<ConstField>(base.fields().len() + 1);
                    for i in 0usize..base.fields().len() {
                        grown[i] = new_fields[i];
                    }
                    grown[base.fields().len()] = ConstField { field_idx: lv.field_idx(), value: val };
                    return self.assign_to_lvalue(lv.inner(), ConstValue::make_struct(grown));
                }
                return self.assign_to_lvalue(lv.inner(), ConstValue::make_struct(new_fields));
            }
            // A field of a tuple or a slice (a (pointer, length) pair; the
            // pair of a string's bytes becomes a tuple once its fields
            // change separately).
            let elems: Option<&[ConstValue]> = if base.tag == CValTag::Tuple {
                Option::some(base.elems())
            } else if base.tag == CValTag::Bytes {
                let pair = self.arena.alloc_slice::<ConstValue>(2);
                pair[0] = base;
                pair[1] = ConstValue::make_int((base.bytes().len() - base.bytes_offset()) as u64, BuiltinType::USize);
                Option::some(pair as &[ConstValue])
            } else {
                Option::none()
            };
            if elems.is_some() && (lv.field_idx() as usize) < elems.unwrap().len() {
                let new_elems = self.arena.alloc_slice::<ConstValue>(elems.unwrap().len());
                elems.unwrap().copy_to(&new_elems[0]);
                new_elems[lv.field_idx() as usize] = val;
                return self.assign_to_lvalue(lv.inner(), ConstValue::make_tuple(new_elems));
            }
            return Result::err(EvalError::Unsupported);
        } else if lv.tag == CLVTag::Index {
            let base = self.materialize_lvalue(lv.inner())?;
            if base.tag == CValTag::Array {
                if lv.index() >= base.elems().len() {
                    return Result::err(EvalError::IndexOob);
                }
                let new_elems = self.arena.alloc_slice::<ConstValue>(base.elems().len());
                for i in 0usize..base.elems().len() {
                    if i == lv.index() {
                        new_elems[i] = val;
                    } else {
                        new_elems[i] = base.elems()[i];
                    }
                }
                return self.assign_to_lvalue(lv.inner(), ConstValue::make_array(new_elems));
            }
            return Result::err(EvalError::Unsupported);
        } else if lv.tag == CLVTag::TupleIndex {
            let base = self.materialize_lvalue(lv.inner())?;
            if base.tag == CValTag::Tuple {
                if lv.index() >= base.elems().len() {
                    return Result::err(EvalError::IndexOob);
                }
                let new_elems = self.arena.alloc_slice::<ConstValue>(base.elems().len());
                for i in 0usize..base.elems().len() {
                    if i == lv.index() {
                        new_elems[i] = val;
                    } else {
                        new_elems[i] = base.elems()[i];
                    }
                }
                return self.assign_to_lvalue(lv.inner(), ConstValue::make_tuple(new_elems));
            }
            return Result::err(EvalError::Unsupported);
        }
        Result::err(EvalError::Unsupported)
    }

    // ========== Field access ==========

    fn eval_field_access(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let base = self.eval_inner(expr.lhs())?;

        if base.tag == CValTag::Lvalue {
            let new_lv = self.arena.alloc(ConstLValue::mk_field(base.lvalue(), expr.field_idx()));
            return Result::ok(ConstValue::make_lvalue(new_lv));
        }

        // Tuple field access (field_idx used as index)
        if base.tag == CValTag::Tuple {
            return self.access_tuple_index(base, expr.field_idx() as usize);
        }
        self.access_field(base, expr.field_idx())
    }

    // ========== Index ==========

    fn eval_index(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        // (A pointer is indexed through its value, an array in place.)
        let base_r = if expr.lhs().ty.tag == IrTyTag::Pointer { self.eval(expr.lhs()) } else { self.eval_inner(expr.lhs()) }?;
        let idx_r = self.eval(expr.rhs())?;

        let idx = idx_r.as_usize();
        if idx.is_none() { return Result::err(EvalError::Unsupported); }
        let idx_val = idx.unwrap();

        let base = base_r;
        if base.tag == CValTag::Lvalue {
            let new_lv = self.arena.alloc(ConstLValue::mk_index(base.lvalue(), idx_val));
            return Result::ok(ConstValue::make_lvalue(new_lv));
        }
        if base.tag == CValTag::Array || base.tag == CValTag::Bytes {
            return self.access_index(base, idx_val);
        }
        if base.tag == CValTag::Pointer {
            // `ptr[i]`: the element `i` places after the one `ptr` points to.
            let lv = base.lvalue();
            if lv.tag == CLVTag::Index {
                let new_lv = self.arena.alloc(ConstLValue::mk_index(lv.inner(), lv.index() + idx_val));
                return Result::ok(ConstValue::make_lvalue(new_lv));
            }
            if idx_val == 0 {
                return Result::ok(ConstValue::make_lvalue(lv));
            }
        }
        Result::err(EvalError::Unsupported)
    }

    // ========== Composite literals ==========

    fn eval_tuple_lit(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let elems = self.arena.alloc_slice::<ConstValue>(expr.items().len());
        for i in 0usize..expr.items().len() {
            let r = self.eval(expr.items()[i])?;
            elems[i] = r;
        }
        Result::ok(ConstValue::make_tuple(elems))
    }

    fn eval_array_lit(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let elems = self.arena.alloc_slice::<ConstValue>(expr.items().len());
        for i in 0usize..expr.items().len() {
            let r = self.eval(expr.items()[i])?;
            elems[i] = r;
        }
        Result::ok(ConstValue::make_array(elems))
    }

    fn eval_struct_lit(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        // IrTag::StructLit: items are field value exprs, ordered by struct field position
        let fields = self.arena.alloc_slice::<ConstField>(expr.items().len());
        for i in 0usize..expr.items().len() {
            let r = self.eval(expr.items()[i])?;
            fields[i] = ConstField {
                field_idx: i as u32,
                value: r,
            };
        }
        if expr.ty.tag == IrTyTag::Slice && fields.len() == 2 {
            // A slice is a (pointer, length) pair.
            let elems = self.arena.alloc_slice::<ConstValue>(2);
            elems[0] = fields[0].value;
            elems[1] = fields[1].value;
            return Result::ok(ConstValue::make_tuple(elems));
        }
        Result::ok(ConstValue::make_struct(fields))
    }

    // ========== Ref/Deref ==========

    fn eval_ref(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        // `&*p` is `p` (which may point into a string's bytes, which are
        // not places of their own).
        if expr.lhs().tag == IrTag::Deref {
            return self.eval(expr.lhs().lhs());
        }
        let inner = self.eval_inner(expr.lhs())?;

        if inner.tag == CValTag::Lvalue {
            return Result::ok(ConstValue::make_pointer(inner.lvalue(), expr.lhs().ty));
        }
        // For non-lvalue values (e.g. inline tuple/struct literals), store in a
        // temporary variable so we can take a reference to it.
        let tmp_id = self.id_gen.next_id();
        self.variables.insert(tmp_id._value, inner);
        let lv = self.arena.alloc(ConstLValue::variable(tmp_id));
        Result::ok(ConstValue::make_pointer(lv, expr.lhs().ty))
    }

    fn eval_deref(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let inner = self.eval(expr.lhs())?;

        if inner.tag == CValTag::Pointer {
            return Result::ok(ConstValue::make_lvalue(inner.lvalue()));
        }
        if inner.tag == CValTag::Bytes {
            if inner.bytes_offset() >= inner.bytes().len() {
                return Result::err(EvalError::IndexOob);
            }
            return Result::ok(ConstValue::make_int(inner.bytes()[inner.bytes_offset()] as u64, BuiltinType::U8));
        }
        Result::err(EvalError::Unsupported)
    }

    // ========== While loop ==========

    fn eval_while(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        // cond = condition, lhs = body, opt_expr = continue action (for for-loops)
        loop {
            let cond_r = self.eval(expr.cond())?;
            if !cond_r.is_truthy() {
                break;
            }
            let body_r = self.eval(expr.lhs());
            if body_r.is_err() {
                if body_r.unwrap_err() == EvalError::Break {
                    break;
                }
                if body_r.unwrap_err() == EvalError::Continue {
                    if expr.opt_expr().is_some() {
                        let cont_r = self.eval(expr.opt_expr().unwrap())?;
                    }
                    continue;
                }
                return body_r;
            }
            if expr.opt_expr().is_some() {
                let cont_r = self.eval(expr.opt_expr().unwrap())?;
            }
        }
        Result::ok(ConstValue::make_void())
    }

    // ========== Loop ==========

    fn eval_loop(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        // lhs = body
        loop {
            let body_r = self.eval(expr.lhs());
            if body_r.is_err() {
                if body_r.unwrap_err() == EvalError::Break {
                    break;
                }
                if body_r.unwrap_err() == EvalError::Continue {
                    continue;
                }
                return body_r;
            }
        }
        Result::ok(ConstValue::make_void())
    }

    // ========== Switch ==========

    fn eval_switch(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let disc_r = self.eval(expr.lhs())?;
        let disc_val = disc_r.as_u64();
        if disc_val.is_none() { return Result::err(EvalError::Unsupported); }
        let disc = disc_val.unwrap();

        let default_body: Option<&IrExpr> = Option::none();

        for i in 0usize..expr.switch_arms().len() {
            let arm = expr.switch_arms()[i];
            if arm.is_default {
                default_body = Option::some(arm.body);
                continue;
            }
            for j in 0usize..arm.values.len() {
                if arm.values[j] == disc {
                    return self.eval(arm.body);
                }
            }
        }

        if default_body.is_some() {
            return self.eval(default_body.unwrap());
        }

        Result::ok(ConstValue::make_void())
    }

    // ========== Function call ==========

    fn eval_call(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        if self.remaining_depth == 0 {
            return Result::err(EvalError::TooDeep);
        }

        // Find the function to call
        let target_name: &[u8] = "";
        if expr.call_target().tag == CallKind::Direct {
            target_name = expr.call_target().fn_ref.mangled_name;
        } else {
            // Indirect call: try to eval the callee
            let callee_r = self.eval(expr.call_target().callee)?;
            if callee_r.tag == CValTag::FnPtr {
                target_name = callee_r.fn_ref().mangled_name;
            } else {
                return Result::err(EvalError::Unsupported);
            }
        }

        // Find function body in already-monomorphized IR
        let func = self.ir_functions.iter_ref().find(|=target_name, e: &IrFunction| -> bool {
            e.mangled_name == target_name
        });
        if func.is_none() { return Result::err(EvalError::Unsupported); }
        let f = func.unwrap();
        if f.body.is_none() { return Result::err(EvalError::Unsupported); }

        // Evaluate arguments
        let arg_values = self.arena.alloc_slice::<ConstValue>(expr.items().len());
        for i in 0usize..expr.items().len() {
            let r = self.eval(expr.items()[i])?;
            arg_values[i] = r;
        }

        // Create child evaluator sharing the same variable store.
        // Remap all param/local IDs to fresh ones so recursive calls don't collide,
        // while pointer-based mutations (&mut self) go through to the shared store.
        let child_remapped: HashMap<usize, usize> = HashMap::new();

        // Remap and bind parameters
        for i in 0usize..f.params.len() {
            let fresh = self.id_gen.next_id();
            child_remapped.insert(f.params[i].id._value, fresh._value);
            if i < arg_values.len() {
                self.variables.insert(fresh._value, arg_values[i]);
            }
        }

        // Remap and initialize local variables
        for i in 0usize..f.local_defs.len() {
            let fresh = self.id_gen.next_id();
            child_remapped.insert(f.local_defs[i].id._value, fresh._value);
            self.variables.insert(fresh._value, ConstValue::make_uninitialized());
        }

        let child = ConstEvaluator {
            arena: self.arena,
            variables: self.variables,
            remapped: child_remapped,
            id_gen: self.id_gen,
            ir_functions: self.ir_functions,
            ir_globals: self.ir_globals,
            const_values: self.const_values,
            return_slot: ConstValue::make_void(),
            has_return: false,
            remaining_depth: self.remaining_depth - 1,
            steps_remaining: self.steps_remaining,
            pointer_size: self.pointer_size,
            panic_msg: "",
            warning_msg: "",
            note_msg: "",
            failure: Option::none(),
            current_fn: f.name,
            heap: self.heap,
            run_time: self.run_time,
        };

        // Evaluate function body
        let result = child.eval(f.body.unwrap());
        if self.failure.is_none() && child.failure.is_some() {
            // (In this call.)
            let failure = child.failure.unwrap();
            let calls = self.arena.alloc_slice::<ConstEvalCall>(failure.calls.len() + 1);
            failure.calls.copy_to(&calls[0]);
            calls[failure.calls.len()] = ConstEvalCall { span: expr.span, function: f.name };
            failure.calls = calls;
            self.failure = Option::some(failure);
        }

        // Propagate remaining steps back
        self.steps_remaining = child.steps_remaining;
        // Propagate panic / warning / note messages — anything captured in
        // the callee should reach the outermost try_const_eval caller.
        if !child.panic_msg.is_empty() {
            self.panic_msg = child.panic_msg;
        }
        if self.warning_msg.is_empty() && !child.warning_msg.is_empty() {
            self.warning_msg = child.warning_msg;
        }
        if self.note_msg.is_empty() && !child.note_msg.is_empty() {
            self.note_msg = child.note_msg;
        }

        if result.is_ok() {
            return result;
        }

        // Handle return
        if result.unwrap_err() == EvalError::Return && child.has_return {
            return Result::ok(child.return_slot);
        }

        // Propagate other errors
        result
    }

    // ========== Transmute ==========

    fn eval_transmute(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        // For simple cases: int-to-int of same size, float-to-int, int-to-float
        let inner = self.eval(expr.lhs())?;
        if inner.tag == CValTag::Uninitialized {
            // (No value, e.g. a variable of the code around the evaluation.)
            return Result::err(EvalError::Unsupported);
        }
        let target_bt = self.irty_to_builtin(expr.ir_ty());

        // Int -> Float (reinterpret bits via pointer cast)
        if inner.tag == CValTag::Int && target_bt == BuiltinType::F32 {
            let bits = inner.int_val() as u32;
            let f = *(&bits as &f32);
            return Result::ok(ConstValue::make_float(f as f64, BuiltinType::F32));
        }
        if inner.tag == CValTag::Int && target_bt == BuiltinType::F64 {
            let bits = inner.int_val();
            let f = *(&bits as &f64);
            return Result::ok(ConstValue::make_float(f, BuiltinType::F64));
        }

        // Float -> Int (reinterpret bits via pointer cast)
        if inner.tag == CValTag::Float && target_bt.is_integer() {
            if inner.builtin_type() == BuiltinType::F32 {
                let f32_val = inner.float_val() as f32;
                let bits = *(&f32_val as &u32);
                return Result::ok(ConstValue::make_int(bits as u64, target_bt));
            } else {
                let fval = inner.float_val();
                let bits = *(&fval as &u64);
                return Result::ok(ConstValue::make_int(bits, target_bt));
            }
        }

        // Int -> Int of same size: just reinterpret
        if inner.tag == CValTag::Int && target_bt.is_integer() {
            let result = self.mask_to_width(inner.int_val(), target_bt.bit_width());
            return Result::ok(ConstValue::make_int(result, target_bt));
        }

        // Otherwise, through the value's bytes (e.g. `[u8; 4]` <-> `u32`).
        let from_ty = expr.lhs().ty;
        let to_ty = expr.ir_ty();
        let size = compute_type_size(from_ty, self.pointer_size);
        if size != compute_type_size(to_ty, self.pointer_size) {
            return Result::err(EvalError::Unsupported);
        }
        let bytes = self.arena.alloc_slice::<u8>(size);
        for i in 0usize..size {
            bytes[i] = 0;
        }
        if !self.to_bytes(inner, from_ty, bytes) {
            return Result::err(EvalError::Unsupported);
        }
        self.from_bytes(bytes, to_ty).ok_or(EvalError::Unsupported)
    }

    /// The field offsets of a struct or tuple type.
    fn field_offsets(self: &ConstEvaluator, ty: &IrTy) -> &[usize] {
        let is_struct = ty.tag == IrTyTag::Struct;
        let n = if is_struct { ty.struct_ref().fields.len() } else { ty.elems().len() };
        let offsets = self.arena.alloc_slice::<usize>(n);
        let aggregate = if is_struct { AggregateLayout::of_struct(&ty.struct_ref()) } else { AggregateLayout::new(false, false, 1) };
        for i in 0usize..n {
            let field_ty = if is_struct { ty.struct_ref().fields[i].ty } else { ty.elems()[i] };
            offsets[i] = aggregate.add(layout_of(field_ty, self.pointer_size));
        }
        offsets
    }

    /// Write a value's in-memory representation (little-endian) into `out`,
    /// if it is one of plain data: numbers, booleans, and arrays, tuples and
    /// structs of them. (Unset parts stay zero.)
    fn to_bytes(self: &ConstEvaluator, value: ConstValue, ty: &IrTy, out: &mut [u8]) -> bool {
        switch value.tag {
            CValTag::Uninitialized, CValTag::Void => true,
            CValTag::Int, CValTag::Bool => {
                let bits = value.int_val();
                for i in 0usize..std::cmp::min(out.len(), 8) {
                    out[i] = (bits >> (8 * i)) as u8;
                }
                true
            }
            CValTag::Float => {
                let bits: u64 = if value.builtin_type() == BuiltinType::F32 {
                    let f = value.float_val() as f32;
                    *(&f as &u32) as u64
                } else {
                    let f = value.float_val();
                    *(&f as &u64)
                };
                for i in 0usize..std::cmp::min(out.len(), 8) {
                    out[i] = (bits >> (8 * i)) as u8;
                }
                true
            }
            CValTag::Array => {
                if ty.tag != IrTyTag::Array { return false; }
                let elem_size = compute_type_size(ty.inner(), self.pointer_size);
                for (i, elem) in value.elems().iter().enumerate() {
                    if !self.to_bytes(elem, ty.inner(), out[i * elem_size..(i + 1) * elem_size]) {
                        return false;
                    }
                }
                true
            }
            CValTag::Tuple => {
                if ty.tag != IrTyTag::Tuple { return false; }
                let offsets = self.field_offsets(ty);
                for (i, elem) in value.elems().iter().enumerate() {
                    let elem_ty = ty.elems()[i];
                    let size = compute_type_size(elem_ty, self.pointer_size);
                    if !self.to_bytes(elem, elem_ty, out[offsets[i]..offsets[i] + size]) {
                        return false;
                    }
                }
                true
            }
            CValTag::Struct => {
                if ty.tag != IrTyTag::Struct || ty.struct_ref().is_union { return false; }
                let offsets = self.field_offsets(ty);
                for field in value.fields() {
                    let field_ty = ty.struct_ref().fields[field.field_idx as usize].ty;
                    let offset = offsets[field.field_idx as usize];
                    let size = compute_type_size(field_ty, self.pointer_size);
                    if !self.to_bytes(field.value, field_ty, out[offset..offset + size]) {
                        return false;
                    }
                }
                true
            }
            _ => false,
        }
    }

    /// The value of type `ty` whose in-memory representation is `bytes`.
    fn from_bytes(self: &ConstEvaluator, bytes: &[u8], ty: &IrTy) -> Option<ConstValue> {
        switch ty.tag {
            IrTyTag::Builtin => {
                let bits: u64 = 0;
                for i in 0usize..std::cmp::min(bytes.len(), 8) {
                    bits |= (bytes[i] as u64) << (8 * i);
                }
                let bt = ty.builtin();
                if bt == BuiltinType::Bool {
                    Option::some(ConstValue::make_bool(bits != 0))
                } else if bt == BuiltinType::F32 {
                    let b = bits as u32;
                    Option::some(ConstValue::make_float(*(&b as &f32) as f64, bt))
                } else if bt == BuiltinType::F64 {
                    Option::some(ConstValue::make_float(*(&bits as &f64), bt))
                } else if bt.is_integer() && bytes.len() <= 8 {
                    Option::some(ConstValue::make_int(bits, bt))
                } else {
                    Option::none()
                }
            }
            IrTyTag::Array => {
                let elem_size = compute_type_size(ty.inner(), self.pointer_size);
                let elems = self.arena.alloc_slice::<ConstValue>(ty.array_size());
                for i in 0usize..ty.array_size() {
                    elems[i] = std::option::try!(self.from_bytes(bytes[i * elem_size..(i + 1) * elem_size], ty.inner()));
                }
                Option::some(ConstValue::make_array(elems))
            }
            IrTyTag::Tuple => {
                let offsets = self.field_offsets(ty);
                let elems = self.arena.alloc_slice::<ConstValue>(ty.elems().len());
                for (i, elem_ty) in ty.elems().iter().enumerate() {
                    let size = compute_type_size(elem_ty, self.pointer_size);
                    elems[i] = std::option::try!(self.from_bytes(bytes[offsets[i]..offsets[i] + size], elem_ty));
                }
                Option::some(ConstValue::make_tuple(elems))
            }
            IrTyTag::Struct => {
                if ty.struct_ref().is_union { return Option::none(); }
                let offsets = self.field_offsets(ty);
                let fields = self.arena.alloc_slice::<ConstField>(ty.struct_ref().fields.len());
                for (i, field) in ty.struct_ref().fields.iter().enumerate() {
                    let size = compute_type_size(field.ty, self.pointer_size);
                    fields[i] = ConstField { field_idx: i as u32, value: std::option::try!(self.from_bytes(bytes[offsets[i]..offsets[i] + size], field.ty)) };
                }
                Option::some(ConstValue::make_struct(fields))
            }
            _ => Option::none(),
        }
    }

    // ========== LLVM intrinsic interpretation ==========
    //
    // Folds `intrinsics::llvm("llvm.{ctpop,ctlz,cttz,bswap}", ...)` calls at
    // const time so the bit-twiddling methods on integer types compose with
    // const items and array sizes. Anything else falls through to Unsupported
    // and the caller (e.g. const-item lowering) keeps the runtime IR.
    fn eval_llvm_intrinsic(self: &mut ConstEvaluator, expr: &IrExpr) -> Result<ConstValue, EvalError> {
        let name = expr.str_val();
        let items = expr.items();
        if items.is_empty() {
            return Result::err(EvalError::Unsupported);
        }
        let arg_r = self.eval(items[0])?;
        // expect.i1 is the only bool-typed hint; the bit-twiddlers all need int.
        if arg_r.tag == CValTag::Bool && name == "llvm.expect.i1" {
            return Result::ok(arg_r);
        }
        if arg_r.tag != CValTag::Int {
            return Result::err(EvalError::Unsupported);
        }
        let bt = arg_r.builtin_type();
        let width = bt.bit_width();
        let val = self.mask_to_width(arg_r.int_val(), width);
        if name == "llvm.ctpop" {
            let count: u64 = 0;
            let v = val;
            while v != 0u64 {
                count += (v & 1u64);
                v = v >> 1u64;
            }
            // ctpop returns iN matching input; the caller's `as u32` cast
            // narrows it. We return the same width here.
            return Result::ok(ConstValue::make_int(count, bt));
        } else if name == "llvm.ctlz" {
            // Second arg is is_zero_undef i1; we ignore it (alumina's
            // leading_zeros wrapper always passes false → defined for zero).
            if val == 0u64 {
                return Result::ok(ConstValue::make_int(width as u64, bt));
            }
            let count: u64 = 0;
            let mask = 1u64 << ((width - 1) as u64);
            while (val & mask) == 0u64 && count < width as u64 {
                count += 1u64;
                mask = mask >> 1u64;
            }
            return Result::ok(ConstValue::make_int(count, bt));
        } else if name == "llvm.cttz" {
            if val == 0u64 {
                return Result::ok(ConstValue::make_int(width as u64, bt));
            }
            let count: u64 = 0;
            let v = val;
            while (v & 1u64) == 0u64 && count < width as u64 {
                count += 1u64;
                v = v >> 1u64;
            }
            return Result::ok(ConstValue::make_int(count, bt));
        } else if name == "llvm.bswap" {
            // Reverse byte order within `width` bits. width is a multiple of 16
            // for valid bswap calls; an 8-bit caller would have been lowered
            // as identity by the sysroot wrapper, not as bswap.
            let bytes = (width / 8) as u64;
            let result: u64 = 0;
            let v = val;
            for _i in 0u64..bytes {
                result = (result << 8u64) | (v & 0xFFu64);
                v = v >> 8u64;
            }
            return Result::ok(ConstValue::make_int(result, bt));
        }
        Result::err(EvalError::Unsupported)
    }

    // ========== Zeroed value construction ==========

    /// An uninitialized value of type `ty` (an aggregate of uninitialized
    /// elements, so that they can be assigned one by one).
    fn make_uninitialized(self: &mut ConstEvaluator, ty: &IrTy) -> ConstValue {
        switch ty.tag {
            IrTyTag::Array => {
                let elems = self.arena.alloc_slice::<ConstValue>(ty.array_size());
                let elem = self.make_uninitialized(ty.inner());
                for i in 0usize..ty.array_size() {
                    elems[i] = elem;
                }
                ConstValue::make_array(elems)
            }
            IrTyTag::Tuple => {
                let elems = self.arena.alloc_slice::<ConstValue>(ty.elems().len());
                for (i, elem) in ty.elems().iter().enumerate() {
                    elems[i] = self.make_uninitialized(elem);
                }
                ConstValue::make_tuple(elems)
            }
            IrTyTag::Struct, IrTyTag::Closure => {
                let fields = self.arena.alloc_slice::<ConstField>(ty.struct_ref().fields.len());
                for (i, field) in ty.struct_ref().fields.iter().enumerate() {
                    fields[i] = ConstField { field_idx: i as u32, value: self.make_uninitialized(field.ty) };
                }
                ConstValue::make_struct(fields)
            }
            _ => if ty.is_zero_sized() { self.make_zeroed(ty) } else { ConstValue::make_uninitialized() },
        }
    }

    fn make_zeroed(self: &mut ConstEvaluator, ty: &IrTy) -> ConstValue {
        if ty.tag == IrTyTag::Builtin {
            if ty.builtin() == BuiltinType::Bool {
                ConstValue::make_bool(false)
            } else if ty.builtin().is_integer() {
                ConstValue::make_int(0u64, ty.builtin())
            } else if ty.builtin().is_float() {
                ConstValue::make_float(0.0, ty.builtin())
            } else {
                ConstValue::make_void()
            }
        } else if ty.tag == IrTyTag::Pointer || ty.tag == IrTyTag::FnPointer {
            ConstValue::make_int(0u64, BuiltinType::USize)
        } else if ty.tag == IrTyTag::Slice {
            // (pointer, length)
            let elems = self.arena.alloc_slice::<ConstValue>(2);
            elems[0] = ConstValue::make_int(0u64, BuiltinType::USize);
            elems[1] = ConstValue::make_int(0u64, BuiltinType::USize);
            ConstValue::make_tuple(elems)
        } else if ty.tag == IrTyTag::Array {
            let elems = self.arena.alloc_slice::<ConstValue>(ty.array_size());
            let zero = self.make_zeroed(ty.inner());
            for i in 0usize..ty.array_size() {
                elems[i] = zero;
            }
            ConstValue::make_array(elems)
        } else if ty.tag == IrTyTag::Tuple {
            let elems = self.arena.alloc_slice::<ConstValue>(ty.elems().len());
            for i in 0usize..ty.elems().len() {
                elems[i] = self.make_zeroed(ty.elems()[i]);
            }
            ConstValue::make_tuple(elems)
        } else if ty.tag == IrTyTag::Struct || ty.tag == IrTyTag::Closure {
            let fields = self.arena.alloc_slice::<ConstField>(ty.struct_ref().fields.len());
            for i in 0usize..ty.struct_ref().fields.len() {
                fields[i] = ConstField {
                    field_idx: i as u32,
                    value: self.make_zeroed(ty.struct_ref().fields[i].ty),
                };
            }
            ConstValue::make_struct(fields)
        } else if ty.tag == IrTyTag::Enum {
            let underlying_bt = if ty.enum_ref().underlying.tag == IrTyTag::Builtin {
                ty.enum_ref().underlying.builtin()
            } else {
                BuiltinType::I32
            };
            ConstValue::make_int(0u64, underlying_bt)
        } else {
            ConstValue::make_void()
        }
    }
}
