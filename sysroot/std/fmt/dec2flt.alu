//! Correctly-rounded decimal string to binary floating point conversion.
//!
//! This is the high-level parser behind [std::string::parse_float] (and hence
//! [f64::parse] / [f32::parse]). Unlike the mechanical Ryu port in
//! [std::fmt::ryu] (whose `s2d`/`s2f` only accept up to 17 significant mantissa
//! digits), this handles decimal strings of arbitrary length and is
//! round-to-nearest, ties-to-even correct for every input.
//!
//! The algorithm is the "simple decimal conversion": the decimal is held as an
//! exact big-decimal of digits and repeatedly multiplied/divided by two to
//! extract the binary mantissa and exponent. This is the same approach Go's
//! `strconv` and Rust's `dec2flt` use as their correctness fallback; it needs no
//! large precomputed power-of-ten table. A faster path (Eisel-Lemire) can be
//! layered on top later as a pure optimisation behind the same tests.

use std::option::Option;

/// Per-format layout: mantissa bits, exponent bits, and the exponent bias used
/// by the conversion (Go's `floatInfo` convention: `bias = -(2^(expbits-1) - 2)`).
struct FloatInfo {
    mantbits: u64,
    expbits: u32,
    bias: i32,
}

const F64_INFO: FloatInfo = FloatInfo { mantbits: 52, expbits: 11, bias: -1023 };
const F32_INFO: FloatInfo = FloatInfo { mantbits: 23, expbits: 8, bias: -127 };

// Maximum digits retained. A double's value is determined by far fewer, but we
// keep enough that no rounding-relevant digit is dropped before the shifts run.
const MAX_DIGITS: usize = 800;
// Largest power-of-two shift applied in one step (keeps intermediate carries in u64).
const MAX_SHIFT: i32 = 60;
// Per-`dp` power-of-two step sizes; index by min(|dp|, 8), else use 27.
const POWTAB: [u32; 9] = [1, 3, 6, 9, 13, 16, 19, 23, 26];

/// An exact decimal value: digits `d[0..nd]` with the decimal point `dp` digits
/// from the left, i.e. value = d[0..nd] (as an integer) * 10^(dp - nd).
struct Decimal {
    d: [u8; MAX_DIGITS],
    nd: usize,
    dp: i32,
    neg: bool,
    truncated: bool,
}

impl Decimal {
    /// Parse `s` into the decimal. Returns false if `s` is not a well-formed
    /// decimal number (the whole string must be consumed).
    fn set(self: &mut Decimal, s: &[u8]) -> bool {
        self.nd = 0;
        self.dp = 0;
        self.neg = false;
        self.truncated = false;

        let i: usize = 0;
        if i >= s.len() {
            return false;
        }
        if s[i] == '+' {
            i += 1;
        } else if s[i] == '-' {
            self.neg = true;
            i += 1;
        }

        let saw_dot = false;
        let saw_digits = false;
        while i < s.len() {
            let c = s[i];
            if c == '.' {
                if saw_dot {
                    return false;
                }
                saw_dot = true;
                self.dp = self.nd as i32;
                i += 1;
                continue;
            }
            if c >= '0' && c <= '9' {
                saw_digits = true;
                if c == '0' && self.nd == 0 {
                    // Ignore leading zeros (in the integer or fractional part).
                    self.dp -= 1;
                    i += 1;
                    continue;
                }
                if self.nd < MAX_DIGITS {
                    self.d[self.nd] = c;
                    self.nd += 1;
                } else if c != '0' {
                    self.truncated = true;
                }
                i += 1;
                continue;
            }
            break;
        }
        if !saw_digits {
            return false;
        }
        if !saw_dot {
            self.dp = self.nd as i32;
        }

        // Optional decimal exponent.
        if i < s.len() && (s[i] == 'e' || s[i] == 'E') {
            i += 1;
            if i >= s.len() {
                return false;
            }
            let esign: i32 = 1;
            if s[i] == '+' {
                i += 1;
            } else if s[i] == '-' {
                i += 1;
                esign = -1;
            }
            if i >= s.len() || s[i] < '0' || s[i] > '9' {
                return false;
            }
            let e: i32 = 0;
            while i < s.len() && s[i] >= '0' && s[i] <= '9' {
                if e < 100000 {
                    e = e * 10 + (s[i] - '0') as i32;
                }
                i += 1;
            }
            self.dp += e * esign;
        }

        if i != s.len() {
            return false;
        }
        true
    }

    /// Drop trailing zero digits.
    fn trim(self: &mut Decimal) {
        while self.nd > 0 && self.d[self.nd - 1] == '0' {
            self.nd -= 1;
        }
        if self.nd == 0 {
            self.dp = 0;
        }
    }

    /// Divide the value by 2^k (0 < k <= MAX_SHIFT).
    fn right_shift(self: &mut Decimal, k: u32) {
        let r: usize = 0; // read index
        let w: usize = 0; // write index
        let n: u64 = 0;

        // Collect enough leading digits to produce the first output digit.
        while (n >> k) == 0 {
            if r >= self.nd {
                if n == 0 {
                    self.nd = 0;
                    return;
                }
                while (n >> k) == 0 {
                    n = n * 10;
                    r += 1;
                }
                break;
            }
            n = n * 10 + (self.d[r] - '0') as u64;
            r += 1;
        }
        self.dp -= (r as i32) - 1;

        let mask: u64 = (1u64 << k) - 1;
        while r < self.nd {
            let c = (self.d[r] - '0') as u64;
            let dig = n >> k;
            n = n & mask;
            self.d[w] = (dig as u8) + '0';
            w += 1;
            n = n * 10 + c;
            r += 1;
        }
        while n > 0 {
            let dig = n >> k;
            n = n & mask;
            if w < MAX_DIGITS {
                self.d[w] = (dig as u8) + '0';
                w += 1;
            } else if dig > 0 {
                self.truncated = true;
            }
            n = n * 10;
        }
        self.nd = w;
        self.trim();
    }

    /// Multiply the value by 2^k (0 < k <= MAX_SHIFT).
    fn left_shift(self: &mut Decimal, k: u32) {
        // Produce output digits right-to-left into a scratch buffer.
        let scratch: [u8; MAX_DIGITS];
        let w: usize = MAX_DIGITS; // exclusive write index, filled downward
        let n: u64 = 0;
        let trunc = false;

        let r = self.nd;
        while r > 0 {
            r -= 1;
            n = n + (((self.d[r] - '0') as u64) << k);
            let quo = n / 10;
            let rem = n - quo * 10;
            if w > 0 {
                w -= 1;
                scratch[w] = (rem as u8) + '0';
            } else if rem != 0 {
                trunc = true;
            }
            n = quo;
        }
        while n > 0 {
            let quo = n / 10;
            let rem = n - quo * 10;
            if w > 0 {
                w -= 1;
                scratch[w] = (rem as u8) + '0';
            } else if rem != 0 {
                trunc = true;
            }
            n = quo;
        }

        let new_nd = MAX_DIGITS - w;
        self.dp += (new_nd as i32) - (self.nd as i32);
        if trunc {
            self.truncated = true;
        }
        let len = if new_nd > MAX_DIGITS { MAX_DIGITS } else { new_nd };
        for i in 0usize..len {
            self.d[i] = scratch[w + i];
        }
        self.nd = len;
        self.trim();
    }

    /// Multiply by 2^k (k > 0) or divide by 2^(-k) (k < 0), in MAX_SHIFT chunks.
    fn shift(self: &mut Decimal, k: i32) {
        if self.nd == 0 {
            return;
        }
        if k > 0 {
            let kk = k;
            while kk > MAX_SHIFT {
                self.left_shift(MAX_SHIFT as u32);
                kk -= MAX_SHIFT;
            }
            self.left_shift(kk as u32);
        } else if k < 0 {
            let kk = k;
            while kk < -MAX_SHIFT {
                self.right_shift(MAX_SHIFT as u32);
                kk += MAX_SHIFT;
            }
            self.right_shift((-kk) as u32);
        }
    }

    /// Should the integer part (first `nd` digits) round up given the rest?
    fn should_round_up(self: &Decimal, nd: i32) -> bool {
        if nd < 0 || nd >= self.nd as i32 {
            return false;
        }
        let ndi = nd as usize;
        if self.d[ndi] == '5' && ndi + 1 == self.nd {
            // Exactly halfway: round to even unless truncated digits made it more.
            if self.truncated {
                return true;
            }
            return ndi > 0 && ((self.d[ndi - 1] - '0') % 2 != 0);
        }
        self.d[ndi] >= '5'
    }

    /// Read the integer part (first `dp` digits) as a u64, rounded.
    fn rounded_integer(self: &Decimal) -> u64 {
        if self.dp > 20 {
            return 0xFFFFFFFFFFFFFFFFu64;
        }
        let i: usize = 0;
        let n: u64 = 0;
        let dp = if self.dp < 0 { 0usize } else { self.dp as usize };
        while i < dp && i < self.nd {
            n = n * 10 + (self.d[i] - '0') as u64;
            i += 1;
        }
        while i < dp {
            n = n * 10;
            i += 1;
        }
        if self.should_round_up(self.dp) {
            n += 1;
        }
        n
    }

    /// Convert to the IEEE-754 bit pattern for the given format.
    fn float_bits(self: &mut Decimal, info: FloatInfo) -> u64 {
        let exp: i32 = 0;
        let mant: u64 = 0;
        let overflow = false;

        if self.nd == 0 {
            mant = 0;
            exp = info.bias; // zero
        } else if self.dp > 310 {
            overflow = true;
        } else if self.dp < -330 {
            mant = 0;
            exp = info.bias; // underflow to zero
        } else {
            // Scale by powers of two until in [0.5, 1).
            while self.dp > 0 {
                let n: i32 = if self.dp >= 9 { 27 } else { POWTAB[self.dp as usize] as i32 };
                self.shift(-n);
                exp += n;
            }
            while self.dp < 0 || (self.dp == 0 && self.d[0] < '5') {
                let idx = -self.dp;
                let n: i32 = if idx >= 9 { 27 } else { POWTAB[idx as usize] as i32 };
                self.shift(n);
                exp -= n;
            }
            // [0.5, 1) -> [1, 2)
            exp -= 1;

            let minexp = info.bias + 1;
            if exp < minexp {
                let n = minexp - exp;
                self.shift(-n);
                exp += n;
            }

            let maxexp: i32 = (1i32 << info.expbits) - 1;
            if exp - info.bias >= maxexp {
                overflow = true;
            } else {
                // Extract mantbits+1 bits.
                self.shift((info.mantbits as i32) + 1);
                mant = self.rounded_integer();

                // Rounding may have carried into an extra bit.
                if mant == (2u64 << info.mantbits) {
                    mant = mant >> 1;
                    exp += 1;
                    if exp - info.bias >= maxexp {
                        overflow = true;
                    }
                }
                // Denormalised: leading bit not set.
                if !overflow && (mant & (1u64 << info.mantbits)) == 0 {
                    exp = info.bias;
                }
            }
        }

        if overflow {
            mant = 0;
            exp = (1i32 << info.expbits) - 1 + info.bias;
        }

        let mantmask: u64 = (1u64 << info.mantbits) - 1;
        let expmask: i32 = (1i32 << info.expbits) - 1;
        let bits: u64 = mant & mantmask;
        bits = bits | ((((exp - info.bias) & expmask) as u64) << info.mantbits);
        if self.neg {
            bits = bits | (1u64 << (info.mantbits + info.expbits as u64));
        }
        bits
    }
}

/// Parse a decimal string as a correctly-rounded `f64`. Returns `none` for
/// malformed input (callers handle `inf`/`nan` separately).
fn parse_f64(s: &[u8]) -> Option<f64> {
    let dec: Decimal;
    if !dec.set(s) {
        return Option::none();
    }
    Option::some(f64::from_bits(dec.float_bits(F64_INFO)))
}

/// Parse a decimal string as a correctly-rounded `f32`. Returns `none` for
/// malformed input (callers handle `inf`/`nan` separately).
fn parse_f32(s: &[u8]) -> Option<f32> {
    let dec: Decimal;
    if !dec.set(s) {
        return Option::none();
    }
    Option::some(f32::from_bits(dec.float_bits(F32_INFO) as u32))
}

#[cfg(all(test, test_std))]
#[docs(hide)]
mod tests {
    macro check_bits($s, $expected) {
        assert_eq!(parse_f64($s).unwrap().to_bits(), ($expected).to_bits());
    }

    #[test]
    fn parse_basic() {
        assert_eq!(parse_f64("0.0").unwrap(), 0.0);
        assert_eq!(parse_f64("1.0").unwrap(), 1.0);
        assert_eq!(parse_f64("1.5").unwrap(), 1.5);
        assert_eq!(parse_f64("-2.25").unwrap(), -2.25);
        assert_eq!(parse_f64("100").unwrap(), 100.0);
        assert_eq!(parse_f64("0.5").unwrap(), 0.5);
        assert_eq!(parse_f64(".5").unwrap(), 0.5);
        assert_eq!(parse_f64("3.14159").unwrap(), 3.14159);
    }

    #[test]
    fn parse_exponents() {
        assert_eq!(parse_f64("1.0e10").unwrap(), 1.0e10);
        assert_eq!(parse_f64("1.5e-10").unwrap(), 1.5e-10);
        assert_eq!(parse_f64("1.0E3").unwrap(), 1000.0);
        assert_eq!(parse_f64("2.5e+2").unwrap(), 250.0);
    }

    #[test]
    fn parse_long_mantissa() {
        // More than 17 significant digits: must still round correctly.
        check_bits!("3.1415926535897932384626433", 3.141592653589793f64);
        check_bits!("2.7182818284590452353602874713527", 2.718281828459045f64);
        check_bits!("0.1000000000000000055511151231257827021181", 0.1f64);
    }

    #[test]
    fn parse_round_to_even() {
        // Exact halfway between two doubles rounds to even.
        assert_eq!(parse_f64("1.0").unwrap().to_bits(), 1.0f64.to_bits());
        // Smallest subnormal and zero boundaries.
        assert_eq!(parse_f64("5e-324").unwrap(), 5.0e-324);
        assert_eq!(parse_f64("0.0").unwrap().to_bits(), 0u64);
        assert_eq!(parse_f64("-0.0").unwrap().to_bits(), 0x8000000000000000u64);
    }

    #[test]
    fn parse_overflow_underflow() {
        assert!(parse_f64("1e400").unwrap() == f64::infinity());
        assert!(parse_f64("-1e400").unwrap() == f64::neg_infinity());
        assert_eq!(parse_f64("1e-400").unwrap(), 0.0);
    }

    #[test]
    fn parse_malformed() {
        assert!(parse_f64("").is_none());
        assert!(parse_f64("abc").is_none());
        assert!(parse_f64("1.2.3").is_none());
        assert!(parse_f64("1.0e").is_none());
        assert!(parse_f64("1.0x").is_none());
    }

    #[test]
    fn parse_f32_basic() {
        // Hardcoded correctly-rounded bit patterns (verified by exact rational
        // arithmetic), so the test does not depend on the host's literal parser.
        assert_eq!(parse_f32("1.5").unwrap().to_bits(), 1069547520u32);  // 1.5 (exact)
        assert_eq!(parse_f32("0.1").unwrap().to_bits(), 1036831949u32);  // round-nearest 0.1
        // 7.038531e-26 is the canonical double-rounding case: parsing as f64 then
        // rounding to f32 (and some libc strtof) gives 363742206, but the
        // correctly-rounded f32 — straight from the decimal — is 363742205.
        assert_eq!(parse_f32("7.038531e-26").unwrap().to_bits(), 363742205u32);
    }
}
